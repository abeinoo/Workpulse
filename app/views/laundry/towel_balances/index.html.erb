<% content_for :title, t("laundry.balances.title") %>

<div class="admin-page">
  <div class="page-header">
    <h1 class="page-title"><%= t("laundry.balances.title") %></h1>
  </div>

  <% if @towel_types.blank? %>
    <div class="empty-state"><p class="empty-state__title"><%= t("laundry.common.no_towel_types") %></p></div>
  <% else %>
    <% current_rows = @selected_towel_type ? @rows : @rows_by_towel_type.values.flatten(1) %>

    <%# ── Summary cards ───────────────────────────────────────────────────── %>
    <div class="stats-grid">
      <div class="stat-card">
        <span class="stat-card__label"><%= t("laundry.balances.summary_total_towels") %></span>
        <span class="stat-card__value"><%= number_with_precision(towel_balance_total_quantity(current_rows), precision: 0) %></span>
      </div>
      <div class="stat-card">
        <span class="stat-card__label"><%= t("laundry.balances.summary_in_transit") %></span>
        <span class="stat-card__value"><%= number_with_precision(towel_balance_total_in_transit(current_rows), precision: 0) %></span>
      </div>
      <% branches_with_issues = towel_balance_branches_with_issues(current_rows) %>
      <div class="stat-card <%= "stat-card--warning" if branches_with_issues.positive? %>">
        <span class="stat-card__label"><%= t("laundry.balances.summary_branches_with_issues") %></span>
        <span class="stat-card__value"><%= branches_with_issues %></span>
      </div>
      <div class="stat-card">
        <span class="stat-card__label"><%= t("laundry.balances.summary_towel_types") %></span>
        <span class="stat-card__value"><%= @towel_types.size %></span>
      </div>
    </div>

    <%# ── Towel type tabs/chips — "All" first, then one per towel type ─────── %>
    <div class="filter-tabs" style="flex-wrap: wrap; width: auto; margin: var(--space-5) 0;">
      <%= link_to laundry_towel_balances_path,
            class: "filter-tab #{"filter-tab--active" if @selected_towel_type.nil?}" do %>
        <%= t("laundry.balances.all_towel_types") %>
        <span class="badge badge-neutral badge-xs"><%= number_with_precision(towel_balance_total_quantity(current_rows), precision: 0) %></span>
      <% end %>
      <% @towel_types.each do |towel_type| %>
        <%
          type_rows = if @rows_by_towel_type
                        @rows_by_towel_type[towel_type]
                      elsif @selected_towel_type == towel_type
                        @rows
                      end
        %>
        <%= link_to laundry_towel_balances_path(towel_type_id: towel_type.id),
              class: "filter-tab #{"filter-tab--active" if @selected_towel_type == towel_type}" do %>
          <%= towel_type.name %>
          <% if type_rows %>
            <span class="badge badge-neutral badge-xs"><%= number_with_precision(towel_balance_total_quantity(type_rows), precision: 0) %></span>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <% if @selected_towel_type %>
      <%# ── Single towel type selected — one table ──────────────────────────── %>
      <%= render "balances_table", rows: @rows, can_view_details: @can_view_details %>
    <% else %>
      <%# ── "All" — compact overview, one accordion section per towel type ──── %>
      <div style="display: flex; flex-direction: column; gap: var(--space-3);">
        <% @rows_by_towel_type.each do |towel_type, rows| %>
          <% overview_status = towel_balance_overview_status(rows) %>
          <div data-controller="collapsible" class="recon-disclosure"
               style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden;">
            <button type="button" data-collapsible-target="trigger" data-action="click->collapsible#toggle"
                    class="recon-disclosure__trigger" aria-expanded="false" style="width: 100%;">
              <span style="font-size: var(--text-base); font-weight: 700; color: var(--text-1);">
                <%= towel_type.name %>
              </span>
              <span style="display: flex; align-items: center; gap: var(--space-3);">
                <span style="font-size: var(--text-sm); color: var(--text-2);">
                  <%= t("laundry.balances.overview_total_quantity") %>:
                  <strong style="color: var(--text-1);"><%= number_with_precision(towel_balance_total_quantity(rows), precision: 0) %></strong>
                </span>
                <span class="badge <%= towel_balance_status_badge_class(overview_status) %>">
                  <%= towel_balance_status_label(overview_status) %>
                </span>
                <svg class="recon-disclosure__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                </svg>
              </span>
            </button>
            <div data-collapsible-target="content" hidden style="border-top: 1px solid var(--border); padding: var(--space-4);">
              <%= render "balances_table", rows: rows, can_view_details: @can_view_details %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
