<% content_for :title, "#{t('shift_assignments.edit.title')} — WorkPulse" %>

<div class="form-page">
  <%= link_to shift_assignments_path, class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    <%= t("shift_assignments.edit.back") %>
  <% end %>

  <h1 class="page-title mb-6"><%= t("shift_assignments.edit.title") %></h1>
  <p class="page-subtitle">
    <%= @assignment.user.full_name %> &mdash; <%= @assignment.shift.name %> &mdash; <%= @assignment.branch.name %>
  </p>

  <%= render "form", editing: true %>
</div>
