<% content_for :title, t("shift_assignments.index.page_title") %>

<%#
  i18n strings used by the Stimulus bulk controller via document.querySelector('meta[name=...]').
  This avoids embedding Rails translations in JS or using a gon gem.
%>
<% content_for :head do %>
  <meta name="sa-bulk-i18n-preview_loading"        content="<%= t("shift_assignments.bulk.preview_loading") %>">
  <meta name="sa-bulk-i18n-preview_valid_one"      content="<%= t("shift_assignments.bulk.preview_valid_one") %>">
  <meta name="sa-bulk-i18n-preview_valid_other"    content="<%= t("shift_assignments.bulk.preview_valid_other") %>">
  <meta name="sa-bulk-i18n-preview_conflict_one"   content="<%= t("shift_assignments.bulk.preview_conflict_one") %>">
  <meta name="sa-bulk-i18n-preview_conflict_other" content="<%= t("shift_assignments.bulk.preview_conflict_other") %>">
<% end %>

<%#
  data-controller mounts the Stimulus bulk controller on the outermost wrapper
  so every nested element (checkboxes, modals, action bar) is inside its scope.
%>
<div class="admin-page" data-controller="shift-assignment-bulk">

  <%# ── Page header ─────────────────────────────────────────────────────────── %>
  <div class="page-header">
    <h1 class="page-title"><%= t("shift_assignments.index.title") %></h1>
    <% if policy(ShiftAssignment).create? || policy(ShiftTemplate).index? %>
      <div class="page-header__actions">
        <% if policy(ShiftTemplate).index? %>
          <%= link_to admin_shift_templates_path, class: "btn btn-ghost btn-sm" do %>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            <%= t("shift_assignments.index.apply_template") %>
          <% end %>
        <% end %>
        <% if policy(ShiftAssignment).create? %>
          <%= link_to new_shift_assignment_path, class: "btn btn-primary btn-sm" do %>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            <%= t("shift_assignments.new.title") %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# ── KPI summary cards ───────────────────────────────────────────────────── %>
  <div class="attn-kpi-grid">
    <div class="stat-card stat-card--success">
      <div class="stat-card__label"><%= t("shift_assignments.kpi.active") %></div>
      <div class="stat-card__value"><%= @stats[:active] %></div>
      <div class="stat-card__sub"><%= t("shift_assignments.kpi.employees") %></div>
    </div>
    <div class="stat-card stat-card--accent">
      <div class="stat-card__label"><%= t("shift_assignments.kpi.upcoming") %></div>
      <div class="stat-card__value"><%= @stats[:upcoming] %></div>
      <div class="stat-card__sub"><%= t("shift_assignments.kpi.employees") %></div>
    </div>
    <div class="stat-card">
      <div class="stat-card__label"><%= t("shift_assignments.kpi.expired") %></div>
      <div class="stat-card__value"><%= @stats[:expired] %></div>
      <div class="stat-card__sub"><%= t("shift_assignments.kpi.employees") %></div>
    </div>
    <div class="stat-card">
      <div class="stat-card__label"><%= t("shift_assignments.kpi.total") %></div>
      <div class="stat-card__value"><%= @stats[:total] %></div>
      <div class="stat-card__sub"><%= t("shift_assignments.kpi.employees") %></div>
    </div>
  </div>

  <%# ── Tabs ───────────────────────────────────────────────────────────────── %>
  <div class="filter-tabs">
    <% %w[active upcoming expired all].each do |tab| %>
      <%= link_to t("shift_assignments.tabs.#{tab}"),
            shift_assignments_path(request.query_parameters.merge(tab: tab, page: nil)),
            class: "filter-tab #{"filter-tab--active" if @tab == tab}" %>
    <% end %>
  </div>

  <%# ── Quick type filter chips ────────────────────────────────────────────── %>
  <div class="sa-quick-filters" role="group" aria-label="<%= t("shift_assignments.quick_filters.label") %>">
    <%
      at_none = params[:assignment_type].blank? && params[:source].blank? && params[:template_id].blank?
    %>
    <%= link_to t("shift_assignments.quick_filters.all"),
          shift_assignments_path(request.query_parameters
            .except("assignment_type", "source", "template_id")
            .merge(page: nil)),
          class: "sa-quick-filter #{at_none ? 'sa-quick-filter--active' : ''}" %>

    <%= link_to t("shift_assignments.quick_filters.permanent"),
          shift_assignments_path(request.query_parameters
            .merge(assignment_type: "permanent", source: nil, template_id: nil, page: nil)),
          class: "sa-quick-filter #{params[:assignment_type] == 'permanent' ? 'sa-quick-filter--active' : ''}" %>

    <%= link_to t("shift_assignments.quick_filters.temporary"),
          shift_assignments_path(request.query_parameters
            .merge(assignment_type: "temporary", source: nil, template_id: nil, page: nil)),
          class: "sa-quick-filter sa-quick-filter--amber #{params[:assignment_type] == 'temporary' ? 'sa-quick-filter--active' : ''}" %>

    <% if @filter_templates.any? %>
      <span class="sa-quick-filters__sep" aria-hidden="true"></span>
      <% @filter_templates.each do |tmpl| %>
        <%= link_to tmpl.name,
              shift_assignments_path(request.query_parameters
                .merge(template_id: tmpl.id, source: "template", assignment_type: nil, page: nil)),
              class: "sa-quick-filter sa-quick-filter--named #{params[:template_id].to_s == tmpl.id.to_s ? 'sa-quick-filter--active' : ''}" %>
      <% end %>
    <% end %>
  </div>

  <%# ── Filter section (collapsible) ──────────────────────────────────────── %>
  <div class="adj-filter-section"
       data-controller="collapsible"
       data-collapsible-open-value="<%= @active_filter_count > 0 ? 'true' : 'false' %>">

    <div class="adj-filter-header"
         data-action="click->collapsible#toggle"
         data-collapsible-target="trigger">
      <span class="adj-filter-header__title">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
        </svg>
        <%= t("shift_assignments.index.filter_title") %>
        <% if @active_filter_count > 0 %>
          <span class="attn-filter-count"><%= @active_filter_count %></span>
        <% end %>
      </span>
      <button type="button" class="adj-filter-toggle btn btn-ghost btn-sm"
              aria-expanded="<%= @active_filter_count > 0 ? 'true' : 'false' %>"
              aria-label="<%= t("forms.toggle_filters") %>">
        <svg class="adj-filter-toggle__chevron" width="14" height="14" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"/>
        </svg>
      </button>
    </div>

    <div class="adj-filter-body" data-collapsible-target="content">
      <%= form_with url: shift_assignments_path, method: :get, local: true,
            class: "attn-filter-form" do |f| %>

        <%# Preserve the active tab across filter submissions %>
        <%= hidden_field_tag :tab, @tab %>

        <div class="adj-filter-grid">

          <%# Search %>
          <div class="form-group adj-filter-search">
            <%= f.label :q, t("shift_assignments.index.search_label"), class: "form-label" %>
            <div class="search-input-wrap">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                   class="search-input-wrap__icon" aria-hidden="true">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
              </svg>
              <%= f.search_field :q, value: params[:q],
                    placeholder: t("shift_assignments.index.search_placeholder"),
                    class: "filter-bar__input search-input-wrap__input" %>
            </div>
          </div>

          <%# Branch %>
          <% if @filter_branches.any? %>
            <div class="form-group">
              <%= f.label :branch_id, t("shift_assignments.branch"), class: "form-label" %>
              <%= f.select :branch_id,
                    options_for_select(
                      [[t("shift_assignments.index.all_branches"), ""]] +
                        @filter_branches.map { |b| [b.name, b.id] },
                      params[:branch_id]
                    ),
                    {},
                    class: "filter-bar__select" %>
            </div>
          <% end %>

          <%# Shift type %>
          <div class="form-group">
            <%= f.label :shift_type, t("shift_assignments.shift"), class: "form-label" %>
            <%= f.select :shift_type,
                  options_for_select(
                    [[t("shift_assignments.index.all_shift_types"), ""]] +
                      Shift::SHIFT_TYPES.map { |st| [t("shifts.types.#{st}"), st] },
                    params[:shift_type]
                  ),
                  {},
                  class: "filter-bar__select" %>
          </div>

          <%# From date %>
          <div class="form-group">
            <%= f.label :from, t("shift_assignments.index.from_label"), class: "form-label" %>
            <%= f.date_field :from, value: params[:from], class: "filter-bar__input" %>
          </div>

          <%# To date %>
          <div class="form-group">
            <%= f.label :to, t("shift_assignments.index.to_label"), class: "form-label" %>
            <%= f.date_field :to, value: params[:to], class: "filter-bar__input" %>
          </div>

          <%# Source %>
          <div class="form-group">
            <%= f.label :source, t("shift_assignments.index.source_label"), class: "form-label" %>
            <%= f.select :source,
                  options_for_select(
                    [[t("shift_assignments.source.all"), ""],
                     [t("shift_assignments.source.manual"), "manual"],
                     [t("shift_assignments.source.template"), "template"]],
                    params[:source]
                  ),
                  {},
                  class: "filter-bar__select" %>
          </div>

          <%# Template %>
          <% if @filter_templates.any? %>
            <div class="form-group">
              <%= f.label :template_id, t("shift_assignments.index.template_label"), class: "form-label" %>
              <%= f.select :template_id,
                    options_for_select(
                      [[t("shift_assignments.index.all_templates"), ""]] +
                        @filter_templates.map { |tmpl| [tmpl.name, tmpl.id] },
                      params[:template_id]
                    ),
                    {},
                    class: "filter-bar__select" %>
            </div>
          <% end %>

        </div>

        <div class="adj-filter-actions">
          <%= f.submit t("forms.apply_filters"), class: "btn btn-primary btn-sm" %>
          <%= link_to t("shift_assignments.index.clear_filters"),
                shift_assignments_path(tab: @tab),
                class: "btn btn-ghost btn-sm" %>
        </div>

      <% end %>
    </div>
  </div>

  <%# ============================================================
      BULK ACTION BAR
      Sticky, revealed only when ≥1 checkbox is checked.
      data-shift-assignment-bulk-target attributes wire it to the
      Stimulus controller defined on the outer wrapper div.
      ============================================================ %>
  <% can_bulk = policy(ShiftAssignment).bulk_assign? ||
                policy(ShiftAssignment).bulk_end?    ||
                policy(ShiftAssignment).bulk_delete? %>
  <% if can_bulk %>

    <div class="bulk-action-bar"
         data-shift-assignment-bulk-target="actionBar"
         style="display:none"
         role="toolbar"
         aria-label="<%= t("shift_assignments.bulk.none_selected") %>">

      <%# Selected-count badge %>
      <span class="bulk-action-bar__badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span data-shift-assignment-bulk-target="countBadge">0</span>
        <%= t("shift_assignments.bulk.selected_other", count: "").strip %>
      </span>

      <span class="bulk-action-bar__sep"></span>

      <%# Bulk Assign %>
      <% if policy(ShiftAssignment).bulk_assign? %>
        <button type="button"
                class="btn btn-ghost btn-sm"
                data-shift-assignment-bulk-target="bulkAssignBtn"
                data-action="click->shift-assignment-bulk#openBulkAssignModal"
                aria-disabled="true">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          <%= t("shift_assignments.bulk.action_assign") %>
        </button>
      <% end %>

      <%# Bulk End %>
      <% if policy(ShiftAssignment).bulk_end? %>
        <button type="button"
                class="btn btn-ghost btn-sm"
                data-shift-assignment-bulk-target="bulkEndBtn"
                data-action="click->shift-assignment-bulk#openBulkEndModal"
                aria-disabled="true">
          <%= t("shift_assignments.bulk.action_end") %>
        </button>
      <% end %>

      <%# Bulk Delete %>
      <% if policy(ShiftAssignment).bulk_delete? %>
        <button type="button"
                class="btn btn-ghost btn-sm text-danger"
                data-shift-assignment-bulk-target="bulkDeleteBtn"
                data-action="click->shift-assignment-bulk#bulkDelete"
                data-confirm-template="<%= t("shift_assignments.bulk.delete_confirm", count: 0) %>"
                aria-disabled="true">
          <%= t("shift_assignments.bulk.action_delete") %>
        </button>
      <% end %>

    </div>

    <%# ── Bulk Assign modal (with conflict-preview step) ─────────────────── %>
    <%#
      The modal has two states controlled by the Stimulus controller:
        state=form   → user fills in shift / branch / date, then clicks "Check"
        state=result → preview shows valid + conflicting employees; user confirms
      The JS fetches bulk_assign_preview_shift_assignments_path (GET, JSON) on
      "Check Conflicts" click, renders the result inline, then reveals the
      final submit button.
    %>
    <% if policy(ShiftAssignment).bulk_assign? %>
      <div class="modal-overlay"
           style="display:none"
           data-shift-assignment-bulk-target="bulkAssignModal"
           data-action="click->shift-assignment-bulk#bulkAssignOverlayClick"
           data-bulk-assign-preview-url="<%= bulk_assign_preview_shift_assignments_path %>">
        <div class="modal-card" role="dialog"
             aria-labelledby="bulk-assign-title" aria-modal="true">
          <h3 class="modal-card__title" id="bulk-assign-title">
            <%= t("shift_assignments.bulk.assign_title") %>
          </h3>

          <%# ── Step 1: form fields ── %>
          <div data-shift-assignment-bulk-target="bulkAssignForm">

            <%= form_with url: bulk_assign_shift_assignments_path, method: :post,
                  local: true,
                  data: { "shift-assignment-bulk-target": "bulkAssignSubmitForm" } do |f| %>

              <%# employee_ids injected by JS on open %>
              <div data-shift-assignment-bulk-target="bulkAssignIds"></div>

              <div class="form-grid">

                <div class="form-group">
                  <%= f.label :shift_id,
                        t("shift_assignments.bulk.assign_shift_label"),
                        class: "form-label form-label--required" %>
                  <%= f.select :shift_id,
                        @filter_shifts.map { |s|
                          detail = s.fixed_time? ?
                            "#{s.start_time.strftime('%H:%M')}–#{s.end_time.strftime('%H:%M')}" :
                            "#{s.required_hours}h"
                          ["#{s.name} (#{detail})", s.id]
                        },
                        { include_blank: t("shift_assignments.form.select_shift") },
                        { name: "shift_assignment[shift_id]",
                          class: "form-control",
                          data: { "shift-assignment-bulk-target": "bulkAssignShiftSelect" } } %>
                </div>

                <div class="form-group">
                  <%= f.label :branch_id,
                        t("shift_assignments.bulk.assign_branch_label"),
                        class: "form-label" %>
                  <%= f.select :branch_id,
                        @filter_branches.map { |b| [b.name, b.id] },
                        { include_blank: t("shift_assignments.form.select_branch") },
                        { name: "shift_assignment[branch_id]", class: "form-control" } %>
                </div>

                <div class="form-group">
                  <%= f.label :effective_from,
                        t("shift_assignments.bulk.assign_from_label"),
                        class: "form-label form-label--required" %>
                  <%= f.date_field :effective_from,
                        name: "shift_assignment[effective_from]",
                        value: Date.current,
                        class: "form-control",
                        data: { controller: "datepicker",
                                "shift-assignment-bulk-target": "bulkAssignDateField" } %>
                  <p class="form-hint"><%= t("shift_assignments.bulk.assign_from_hint") %></p>
                </div>

              </div>

              <%# ── Conflict preview result area (populated by JS) ── %>
              <div data-shift-assignment-bulk-target="conflictPreview"
                   style="display:none"></div>

              <div class="form-actions">
                <%# "Check conflicts" button — triggers the preview fetch %>
                <button type="button"
                        class="btn btn-secondary"
                        data-action="click->shift-assignment-bulk#checkConflicts"
                        data-shift-assignment-bulk-target="checkConflictsBtn">
                  <%= t("shift_assignments.bulk.check_conflicts_btn") %>
                </button>

                <%# Final submit — only shown after preview confirms ≥1 valid %>
                <%= f.submit t("shift_assignments.bulk.confirm_assign_btn"),
                      class: "btn btn-primary",
                      data: { "shift-assignment-bulk-target": "bulkAssignConfirmBtn" },
                      style: "display:none" %>

                <button type="button" class="btn btn-ghost"
                        data-action="click->shift-assignment-bulk#closeBulkAssignModal">
                  <%= t("forms.cancel") %>
                </button>
              </div>

            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%# ── Bulk End modal ────────────────────────────────────────────────── %>
    <% if policy(ShiftAssignment).bulk_end? %>
      <div class="modal-overlay"
           style="display:none"
           data-shift-assignment-bulk-target="bulkEndModal"
           data-action="click->shift-assignment-bulk#bulkEndOverlayClick">
        <div class="modal-card" role="dialog"
             aria-labelledby="bulk-end-title" aria-modal="true">
          <h3 class="modal-card__title" id="bulk-end-title">
            <%= t("shift_assignments.bulk.end_title") %>
          </h3>

          <%= form_with url: bulk_end_shift_assignments_path, method: :patch,
                local: true do |f| %>

            <div data-shift-assignment-bulk-target="bulkEndIds"></div>

            <div class="form-group">
              <%= f.label :ended_on,
                    t("shift_assignments.bulk.end_date_label"),
                    class: "form-label form-label--required" %>
              <%= f.date_field :ended_on,
                    name: "shift_assignment[ended_on]",
                    value: Date.current,
                    class: "form-control",
                    data: { controller: "datepicker" } %>
              <p class="form-hint"><%= t("shift_assignments.bulk.end_date_hint") %></p>
            </div>

            <div class="form-actions">
              <%= f.submit t("shift_assignments.bulk.confirm_end_btn"),
                    class: "btn btn-primary" %>
              <button type="button" class="btn btn-ghost"
                      data-action="click->shift-assignment-bulk#closeBulkEndModal">
                <%= t("forms.cancel") %>
              </button>
            </div>

          <% end %>
        </div>
      </div>
    <% end %>

    <%# ── Bulk Delete hidden form (submitted by JS) ─────────────────────── %>
    <% if policy(ShiftAssignment).bulk_delete? %>
      <%= form_with url: bulk_delete_shift_assignments_path, method: :delete,
            local: true,
            data: { shift_assignment_bulk_target: "bulkDeleteForm" } do |f| %>
        <div data-shift-assignment-bulk-target="bulkDeleteIds"></div>
      <% end %>
    <% end %>

  <% end %>

  <%# ── Assignments table ───────────────────────────────────────────────────── %>
  <%# timeline_pct is provided by ShiftAssignmentHelper (takes one assignment arg) %>

  <div class="table-wrap table-wrap--cards">
    <% col_count = can_bulk ? 11 : 10 %>
    <table>
      <thead>
        <tr>
          <% if can_bulk %>
            <th class="td-check">
              <input type="checkbox"
                     class="bulk-check-all"
                     data-action="change->shift-assignment-bulk#toggleAll"
                     aria-label="<%= t("shift_assignments.bulk.select_all") %>">
            </th>
          <% end %>
          <th><%= t("shift_assignments.employee") %></th>
          <th><%= t("shift_assignments.shift") %></th>
          <th><%= t("shift_assignments.type.column_header") %></th>
          <th><%= t("shift_assignments.branch") %></th>
          <th><%= t("shift_assignments.status") %></th>
          <th><%= t("shift_assignments.from_date") %></th>
          <th><%= t("shift_assignments.to_date") %></th>
          <th><%= t("shift_assignments.index.timeline_header") %></th>
          <th><%= t("shift_assignments.created_by") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @assignments.each do |a| %>
          <%
            shift      = a.shift
            overnight  = shift.respond_to?(:overnight?) && shift.overnight?
            status_key = a.future? ? "upcoming" : (a.current? ? "active" : "ended")
            fill_cls   = a.future? ? "upcoming" : (a.current? ? (a.effective_to.nil? ? "open" : "active") : "ended")
            pct        = timeline_pct(a)
          %>
          <tr class="<%= "sa-row--temporary" if a.temporary? %>">
            <% if can_bulk %>
              <td class="td-check">
                <%#
                  data-employee-id  → used by Bulk Assign to collect users
                  data-deletable    → used by Bulk Delete smart-disable
                  data-future       → used by Bulk End smart-disable (skip future)
                  value (checkbox)  → assignment id for Bulk End / Bulk Delete
                %>
                <input type="checkbox"
                       class="bulk-check-row"
                       value="<%= a.id %>"
                       data-action="change->shift-assignment-bulk#rowChanged"
                       data-employee-id="<%= a.user_id %>"
                       data-deletable="<%= a.deletable? %>"
                       data-future="<%= a.future? %>"
                       aria-label="<%= a.user.full_name %>">
              </td>
            <% end %>

            <%# Employee cell with avatar %>
            <td data-label="<%= t("shift_assignments.employee") %>">
              <div class="employee-cell">
                <%= user_avatar_tag(a.user, size: :thumb) %>
                <div>
                  <div class="employee-cell__name"><%= a.user.full_name %></div>
                  <div class="employee-cell__sub"><%= a.user.employee_code %></div>
                </div>
              </div>
            </td>

            <%# Shift with overnight badge + template sub-line %>
            <td class="td-secondary" data-label="<%= t("shift_assignments.shift") %>">
              <div>
                <%= link_to shift.name, shift_path(shift), class: "link-muted" %>
                <% if overnight %>
                  <span class="badge badge-warning badge--xs">
                    <%= t("shifts.overnight_badge") %>
                  </span>
                <% end %>
                <% if a.source_template %>
                  <div class="sa-shift-template-name">
                    <%= a.source_template.name %>
                  </div>
                <% end %>
              </div>
            </td>

            <%# Assignment type cell: badge + expiry line %>
            <td data-label="<%= t("shift_assignments.type.column_header") %>">
              <div class="sa-type-cell">
                <span class="badge <%= assignment_type_badge_class(a) %> badge--xs">
                  <%= assignment_type_label(a) %>
                </span>
                <% if a.effective_to.present? %>
                  <div class="sa-type-expiry <%= "sa-type-expiry--urgent" if a.expiring_soon? %>">
                    <%= temporary_expiry_label(a) %>
                  </div>
                <% end %>
              </div>
            </td>

            <td class="td-secondary" data-label="<%= t("shift_assignments.branch") %>">
              <%= a.branch_name || "—" %>
            </td>

            <%# Status badge %>
            <td data-label="<%= t("shift_assignments.status") %>">
              <% badge_cls = { "active" => "badge-success",
                               "upcoming" => "badge-accent",
                               "ended"   => "badge-neutral" }[status_key] %>
              <span class="badge <%= badge_cls %>">
                <%= t("shift_assignments.#{status_key}") %>
              </span>
              <% if a.temporary? %>
                <div class="temp-indicator">
                  <span class="badge <%= a.expiring_soon? ? "badge-expiring" : "badge-temporary" %> badge--xs">
                    <%= a.expiring_soon? ?
                          t("shift_assignments.temporary.expiring_badge") :
                          t("shift_assignments.temporary.badge") %>
                  </span>
                  <% if a.effective_to.present? %>
                    <span class="temp-expiry-text <%= "temp-expiry-text--urgent" if a.expiring_soon? %>">
                      <%= temporary_expiry_label(a) %>
                    </span>
                  <% end %>
                </div>
              <% end %>
            </td>

            <td class="td-secondary" data-label="<%= t("shift_assignments.from_date") %>">
              <%= local_date(a.effective_from) %>
            </td>

            <td class="td-secondary" data-label="<%= t("shift_assignments.to_date") %>">
              <%= a.effective_to ? local_date(a.effective_to) : "—" %>
            </td>

            <%# Timeline bar %>
            <td data-label="<%= t("shift_assignments.index.timeline_header") %>">
              <div class="sa-timeline" aria-hidden="true">
                <div class="sa-timeline__track">
                  <div class="sa-timeline__fill sa-timeline__fill--<%= fill_cls %>"
                       style="width:<%= a.effective_to.nil? ? 100 : pct %>%"></div>
                </div>
                <span class="sa-timeline__label">
                  <% if a.effective_to.nil? %>
                    <%= t("shift_assignments.open_ended") %>
                  <% elsif a.future? %>
                    <%= t("shift_assignments.index.starts_in",
                          days: (a.effective_from - Date.current).to_i) %>
                  <% elsif a.current? %>
                    <%= t("shift_assignments.index.progress_pct", pct: pct) %>
                  <% else %>
                    <%= t("shift_assignments.index.ended_days_ago",
                          days: (Date.current - a.effective_to).to_i) %>
                  <% end %>
                </span>
              </div>
            </td>

            <%# Audit: who created %>
            <td class="td-secondary" data-label="<%= t("shift_assignments.created_by") %>">
              <% if a.created_by %>
                <span title="<%= local_date(a.created_at) %>">
                  <%= a.created_by.full_name %>
                </span>
              <% else %>
                <span class="text-muted">—</span>
              <% end %>
              <% if a.source_template %>
                <div class="sa-template-origin">
                  <span class="badge badge-template badge--xs"
                        title="<%= t("shift_assignments.via_template", name: a.source_template.name) %>">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                      <line x1="16" y1="2" x2="16" y2="6"/>
                      <line x1="8" y1="2" x2="8" y2="6"/>
                      <line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                    <%= a.source_template.name %>
                  </span>
                </div>
              <% end %>
            </td>

            <%# Row actions %>
            <td class="td-actions">
              <% if policy(a).update? %>
                <%= link_to t("forms.edit"),
                      edit_shift_assignment_path(a),
                      class: "link-muted" %>
              <% end %>
              <% unless a.historical? %>
                <% if policy(a).end_assignment? %>
                  <%= link_to t("shift_assignments.end.action_btn"),
                        confirm_end_shift_assignment_path(a),
                        class: "link-muted text-danger" %>
                <% end %>
              <% end %>
              <% if policy(a).destroy? %>
                <%= link_to t("forms.delete"),
                      confirm_delete_shift_assignment_path(a, return_tab: @tab),
                      class: "link-muted text-danger" %>
              <% end %>
            </td>
          </tr>
        <% end %>

        <% if @assignments.empty? %>
          <tr>
            <td colspan="<%= col_count %>">
              <% if @active_filter_count > 0 %>
                <%# ── Empty: filters active but nothing found ── %>
                <div class="sa-empty-state sa-empty-state--no-results">
                  <svg class="sa-empty-state__icon" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="1.5"
                       stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"/>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    <line x1="8" y1="11" x2="14" y2="11"/>
                  </svg>
                  <p class="sa-empty-state__title"><%= t("shift_assignments.empty.no_results_title") %></p>
                  <p class="sa-empty-state__sub"><%= t("shift_assignments.empty.no_results_sub") %></p>
                  <div class="sa-empty-state__actions">
                    <%= link_to t("shift_assignments.index.clear_filters"),
                          shift_assignments_path(tab: @tab),
                          class: "btn btn-ghost btn-sm" %>
                  </div>
                </div>
              <% elsif @tab == "expired" %>
                <%# ── Empty: expired tab, no ended assignments ── %>
                <div class="sa-empty-state sa-empty-state--all-expired">
                  <svg class="sa-empty-state__icon" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="1.5"
                       stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                  </svg>
                  <p class="sa-empty-state__title"><%= t("shift_assignments.empty.expired_title") %></p>
                  <p class="sa-empty-state__sub"><%= t("shift_assignments.empty.expired_sub") %></p>
                </div>
              <% elsif @stats[:total] == 0 %>
                <%# ── Empty: no assignments exist at all ── %>
                <div class="sa-empty-state">
                  <svg class="sa-empty-state__icon" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="1.5"
                       stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                    <line x1="10" y1="15" x2="14" y2="15"/>
                  </svg>
                  <p class="sa-empty-state__title"><%= t("shift_assignments.empty.virgin_title") %></p>
                  <p class="sa-empty-state__sub"><%= t("shift_assignments.empty.virgin_sub") %></p>
                  <% if policy(ShiftAssignment).create? %>
                    <div class="sa-empty-state__actions">
                      <%= link_to t("shift_assignments.new.title"),
                            new_shift_assignment_path,
                            class: "btn btn-primary btn-sm" %>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <%# ── Empty: tab-specific but some assignments exist elsewhere ── %>
                <div class="sa-empty-state">
                  <svg class="sa-empty-state__icon" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="1.5"
                       stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                  </svg>
                  <p class="sa-empty-state__title">
                    <%= t("shift_assignments.empty.tab_empty_title", tab: t("shift_assignments.tabs.#{@tab}")) %>
                  </p>
                  <p class="sa-empty-state__sub"><%= t("shift_assignments.empty.tab_empty_sub") %></p>
                  <div class="sa-empty-state__actions">
                    <%= link_to t("shift_assignments.tabs.all"),
                          shift_assignments_path(tab: "all"),
                          class: "btn btn-ghost btn-sm" %>
                  </div>
                </div>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# ── Pagination ──────────────────────────────────────────────────────────── %>
  <% if @total_pages > 1 %>
    <nav class="pagination" aria-label="<%= t("pagination.label") %>">
      <% if @page > 1 %>
        <%= link_to t("pagination.prev"),
              shift_assignments_path(request.query_parameters.merge(page: @page - 1)),
              class: "pagination__btn pagination__btn--prev" %>
      <% end %>

      <% start_page = [[@page - 2, 1].max, [@total_pages - 4, 1].max].min
         end_page   = [start_page + 4, @total_pages].min %>

      <% if start_page > 1 %>
        <%= link_to "1",
              shift_assignments_path(request.query_parameters.merge(page: 1)),
              class: "pagination__btn" %>
        <span class="pagination__ellipsis">…</span>
      <% end %>

      <% (start_page..end_page).each do |p| %>
        <%= link_to p.to_s,
              shift_assignments_path(request.query_parameters.merge(page: p)),
              class: "pagination__btn #{'pagination__btn--active' if p == @page}" %>
      <% end %>

      <% if end_page < @total_pages %>
        <span class="pagination__ellipsis">…</span>
        <%= link_to @total_pages.to_s,
              shift_assignments_path(request.query_parameters.merge(page: @total_pages)),
              class: "pagination__btn" %>
      <% end %>

      <% if @page < @total_pages %>
        <%= link_to t("pagination.next"),
              shift_assignments_path(request.query_parameters.merge(page: @page + 1)),
              class: "pagination__btn pagination__btn--next" %>
      <% end %>
    </nav>
  <% end %>

</div>
