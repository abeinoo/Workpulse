<% editing = local_assigns.fetch(:editing, false) %>

<%= form_with model: @assignment, class: "form-card" do |f| %>

  <%= render "shared/error_messages", object: @assignment %>

  <div class="form-grid" <%= tag.attributes(data: { controller: ("assignment-kind-fields" unless editing) }) %>>
    <% unless editing %>
      <%# Regular and temporary-coverage assignments each have their own employee
          and branch fields: regular picks from employees available for a new
          assignment and the manager's branches; coverage picks from the scoped
          employees and sends them to another branch. Only the active kind's
          fields are enabled (and therefore submitted). %>
      <% coverage = @assignment.temporary_coverage? %>
      <div class="form-group <%= "hidden" if coverage %>" data-assignment-kind-fields-target="regular">
        <%= f.label :user_id, t("shift_assignments.employee"), class: "form-label form-label--required" %>
        <%= f.select :user_id,
              regular_employee_options(@regular_candidates, @assignment.user_id),
              { include_blank: t("shift_assignments.form.select_employee") },
              class: "form-control", disabled: coverage %>
        <p class="form-hint"><%= t("shift_assignments.form.employee_availability_hint", count: @availability_window_days) %></p>
      </div>

      <div class="form-group <%= "hidden" unless coverage %>" data-assignment-kind-fields-target="coverage">
        <%= f.label :user_id, t("shift_assignments.employee"), class: "form-label form-label--required",
              for: "shift_assignment_user_id_coverage" %>
        <%= f.select :user_id,
              coverage_employee_options(@employees, @employee_current_branches, @assignment.user_id),
              { include_blank: t("shift_assignments.form.select_employee") },
              class: "form-control", id: "shift_assignment_user_id_coverage", disabled: !coverage,
              data: { assignment_kind_fields_target: "coverageEmployee",
                      action: "change->assignment-kind-fields#updateRoute" } %>
      </div>

      <div class="form-group">
        <%= f.label :shift_id, t("shift_assignments.shift"), class: "form-label form-label--required" %>
        <%= f.select :shift_id,
              @shifts.map { |s|
                detail = if s.fixed_time?
                  "#{s.start_time.strftime('%H:%M')}–#{s.end_time.strftime('%H:%M')}"
                else
                  "#{s.required_hours}h / #{t('shifts.types.hour_based')}"
                end
                ["#{s.name} (#{detail})", s.id]
              },
              { include_blank: t("shift_assignments.form.select_shift") },
              class: "form-control" %>
      </div>

      <div class="form-group <%= "hidden" if coverage %>" data-assignment-kind-fields-target="regular">
        <%= f.label :branch_id, t("shift_assignments.branch"), class: "form-label form-label--required" %>
        <%= f.select :branch_id,
              options_from_collection_for_select(@branches, :id, :name, (@assignment.branch_id unless coverage)),
              { include_blank: t("shift_assignments.form.select_branch") },
              class: "form-control", disabled: coverage %>
      </div>

      <div class="form-group <%= "hidden" unless coverage %>" data-assignment-kind-fields-target="coverage">
        <%= f.label :branch_id, t("shift_assignments.form.coverage_branch_label"),
              class: "form-label form-label--required", for: "shift_assignment_branch_id_coverage" %>
        <%= f.select :branch_id,
              options_from_collection_for_select(@coverage_branches, :id, :name, (@assignment.branch_id if coverage)),
              { include_blank: t("shift_assignments.form.select_coverage_branch") },
              class: "form-control", id: "shift_assignment_branch_id_coverage", disabled: !coverage,
              data: { assignment_kind_fields_target: "coverageBranch",
                      action: "change->assignment-kind-fields#updateRoute" } %>
        <p class="form-hint"><%= t("shift_assignments.form.coverage_branch_hint") %></p>
        <p class="form-hint hidden" data-assignment-kind-fields-target="route"
           data-template="<%= t("shift_assignments.form.coverage_route", from: "%{from}", to: "%{to}") %>"></p>
      </div>

      <div class="form-group">
        <%= f.label :effective_from, t("shift_assignments.start_date"), class: "form-label form-label--required" %>
        <%= f.date_field :effective_from, class: "form-control", data: { controller: "datepicker" } %>
      </div>

      <div class="form-group">
        <%= f.label :assignment_kind, t("shift_assignments.form.assignment_kind_label"), class: "form-label form-label--required" %>
        <%= f.select :assignment_kind,
              ShiftAssignment.assignment_kinds.keys.map { |k| [t("shift_assignments.form.assignment_kind_#{k}"), k] },
              {},
              class: "form-control",
              data: { assignment_kind_fields_target: "kind",
                      action: "change->assignment-kind-fields#toggle" } %>
        <p class="form-hint"><%= t("shift_assignments.form.assignment_kind_hint") %></p>
      </div>

      <div class="form-group">
        <%= f.label :reason, t("shift_assignments.form.reason_label"), class: "form-label" %>
        <%= f.text_area :reason, class: "form-control", rows: 2,
              placeholder: t("shift_assignments.form.reason_placeholder") %>
        <p class="form-hint"><%= t("shift_assignments.form.reason_hint") %></p>
      </div>
    <% end %>

    <div class="form-group <%= editing ? 'form-group--full' : '' %>">
      <%= f.label :effective_to, t("shift_assignments.end_date"), class: "form-label" %>
      <%= f.date_field :effective_to, class: "form-control", data: { controller: "datepicker" } %>
      <p class="form-hint"><%= t("shift_assignments.form.end_hint") %></p>
    </div>

    <% if @rule_profiles&.any? %>
      <div class="form-group">
        <%= f.label :shift_rule_profile_id, t("shift_assignments.form.rule_profile"), class: "form-label" %>
        <%= f.select :shift_rule_profile_id,
              @rule_profiles.map { |p| [p.name, p.id] },
              { include_blank: t("shift_assignments.form.no_rule_profile") },
              class: "form-control" %>
        <p class="form-hint"><%= t("shift_assignments.form.rule_profile_hint") %></p>
      </div>
    <% end %>
  </div>

  <div class="form-actions">
    <%= f.submit f.object.persisted? ? t("shift_assignments.edit.submit") : t("shift_assignments.new.submit"), class: "btn btn-primary" %>
    <%= link_to t("forms.cancel"), shift_assignments_path, class: "btn btn-ghost" %>
  </div>

<% end %>
