<% content_for :title, t("notifications.page_title") %>

<div class="admin-page">

  <div class="page-header">
    <div>
      <h1 class="page-title"><%= t("notifications.title") %></h1>
      <p class="page-subtitle">
        <%= @unread_count > 0 ?
            t("notifications.unread_count", count: @unread_count) :
            t("notifications.all_read") %>
      </p>
    </div>
    <div class="page-actions">
      <% if @unread_count > 0 %>
        <%= button_to t("notifications.mark_all_read"), mark_all_read_notifications_path,
              method: :patch, class: "btn btn-ghost btn-sm" %>
      <% end %>
    </div>
  </div>

  <%# ── Filters ─────────────────────────────────────────────────────────── %>
  <div class="notif-filters">
    <%= link_to t("notifications.filter_all"),
          notifications_path,
          class: "notif-filter-btn #{'is-active' unless @severity_filter || @unread_only}" %>
    <%= link_to t("notifications.filter_unread"),
          notifications_path(unread: "1"),
          class: "notif-filter-btn #{'is-active' if @unread_only}" %>
    <% Notification::SEVERITIES.each do |sev| %>
      <%= link_to t("notifications.filter_#{sev}"),
            notifications_path(severity: sev),
            class: "notif-filter-btn notif-filter-btn--#{sev} #{'is-active' if @severity_filter == sev}" %>
    <% end %>
  </div>

  <%# ── List ────────────────────────────────────────────────────────────── %>
  <div class="notif-list">
    <% if @notifications.empty? %>
      <div class="empty-state">
        <div class="empty-state__icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6 6 0 10-12 0v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
          </svg>
        </div>
        <p class="empty-state__text"><%= t("notifications.empty") %></p>
      </div>
    <% else %>
      <% @notifications.each do |notif| %>
        <div class="notif-item notif-item--<%= notif.severity %> <%= 'notif-item--unread' unless notif.read? %>"
             data-notification-id="<%= notif.id %>"
             data-mark-read-url="<%= mark_read_notification_path(notif) %>">

          <div class="notif-item__indicator notif-indicator--<%= notif.severity %>"></div>

          <div class="notif-item__body">
            <div class="notif-item__header">
              <span class="notif-item__title"><%= notif.title %></span>
              <span class="notif-item__time"><%= time_ago_in_words(notif.created_at) %> <%= t("common.ago") %></span>
            </div>
            <% if notif.body.present? %>
              <p class="notif-item__text"><%= notif.body %></p>
            <% end %>
            <div class="notif-item__meta">
              <span class="badge badge--<%= notif.severity %>">
                <%= t("notifications.severity.#{notif.severity}") %>
              </span>
              <span class="notif-item__event"><%= t("notifications.events.#{notif.event_type}", default: notif.event_type) %></span>
            </div>
          </div>

          <% unless notif.read? %>
            <button class="notif-item__read-btn"
                    data-action="click->notification#markRead"
                    title="<%= t('notifications.mark_read') %>">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </button>
          <% end %>

        </div>
      <% end %>
    <% end %>
  </div>

</div>
