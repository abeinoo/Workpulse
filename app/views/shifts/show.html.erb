<% content_for :title, t("shifts.show.page_title", name: @shift.name) %>

<div class="admin-page">

  <div class="page-header">
    <%= link_to shift_assignments_path, class: "back-link" do %>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      <%= t("shift_assignments.index.title") %>
    <% end %>
    <h1 class="page-title"><%= @shift.name %></h1>
  </div>

  <div class="info-card">
    <div class="info-card__row">
      <span class="info-card__label"><%= t("shifts.type") %></span>
      <span>
        <%= t("shifts.types.#{@shift.shift_type}") %>
        <% if @shift.overnight? %>
          <span class="badge badge-neutral" style="margin-inline-start: 0.4rem;"><%= t("shifts.overnight_badge") %></span>
        <% end %>
      </span>
    </div>
    <% if @shift.fixed_time? %>
      <div class="info-card__row">
        <span class="info-card__label"><%= t("shifts.working_hours") %></span>
        <span><%= @shift.start_time.strftime("%H:%M") %> &ndash; <%= @shift.end_time.strftime("%H:%M") %></span>
      </div>
    <% else %>
      <div class="info-card__row">
        <span class="info-card__label"><%= t("shifts.required_hours") %></span>
        <span><%= @shift.required_hours %>h</span>
      </div>
    <% end %>
    <% if @shift.overtime_rate_multiplier.present? %>
      <div class="info-card__row">
        <span class="info-card__label"><%= t("shifts.overtime_multiplier") %></span>
        <span><%= @shift.overtime_rate_multiplier %>x</span>
      </div>
    <% end %>
  </div>

  <h2 class="section-title mt-8"><%= t("shifts.penalty_rules") %></h2>

  <% if @penalty_rules.any? %>
    <div class="table-wrap table-wrap--cards">
      <table>
        <thead>
          <tr>
            <th><%= t("shifts.type") %></th>
            <th><%= t("penalty_rules.threshold_label") %></th>
            <th><%= t("shifts.deduction_percent") %></th>
          </tr>
        </thead>
        <tbody>
          <% @penalty_rules.each do |rule| %>
            <tr>
              <td>
                <% if @shift.hour_based? %>
                  <%= t("shifts.form.shortfall_label") %>
                <% else %>
                  <%= t("penalty_rules.rule_types.#{rule.rule_type}") %>
                <% end %>
              </td>
              <td class="td-secondary"><%= rule.threshold_minutes %> min</td>
              <td>
                <% if rule.fixed_amount? %>
                  <%= format_currency(rule.deduction_value) %>
                <% else %>
                  <%= rule.deduction_value %><%= t("shifts.deduction_percent") %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-muted"><%= t("shifts.show.no_rules") %></p>
  <% end %>

</div>
