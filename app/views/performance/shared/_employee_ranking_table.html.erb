<%#
  Locals: title, rows (Array<Performance::ReviewAnalytics::EmployeeRanking>), empty_text
%>
<div class="card" style="padding: var(--space-5);">
  <h3 class="section-title"><%= title %></h3>
  <% if rows.blank? %>
    <div class="empty-state empty-state--compact"><p class="empty-state__text"><%= empty_text %></p></div>
  <% else %>
    <table style="width: 100%;">
      <tbody>
        <% rows.each_with_index do |row, i| %>
          <tr>
            <td style="width: 28px;" class="td-secondary"><%= i + 1 %></td>
            <td><%= row.employee_name %></td>
            <td style="width: 40%;">
              <div class="rank-bar"><div class="rank-bar__fill" style="width: <%= ((row.average_rating || 0) / 5.0 * 100).round %>%;"></div></div>
            </td>
            <td style="width: 64px; text-align: end; font-weight: 600;"><%= row.average_rating %></td>
            <td class="td-secondary" style="width: 90px; text-align: end;"><%= row.review_count %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
