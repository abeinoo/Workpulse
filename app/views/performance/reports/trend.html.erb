<% content_for :title, t("performance.reports.employee_trend") %>

<div class="admin-page">
  <%= link_to performance_reports_path, class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    <%= t("forms.back") %>
  <% end %>

  <h1 class="page-title mb-6"><%= t("performance.reports.employee_trend") %></h1>

  <%= form_with url: performance_trend_report_path, method: :get, class: "form-card", style: "margin-bottom: var(--space-5);" do |f| %>
    <div class="form-grid">
      <div class="form-group">
        <%= f.label :employee_id, t("performance.reviews.employee"), class: "form-label" %>
        <%= f.collection_select :employee_id, @employees, :id, :full_name,
              { selected: params[:employee_id], prompt: t("performance.reviews.select_employee") },
              class: "form-control", onchange: "this.form.requestSubmit()" %>
      </div>
      <div class="form-group">
        <%= f.label :year, t("performance.reviews.year"), class: "form-label" %>
        <%= f.select :year, ((Date.current.year - 4)..Date.current.year).to_a.reverse,
              { selected: @year }, class: "form-control", onchange: "this.form.requestSubmit()" %>
      </div>
    </div>
  <% end %>

  <% if @employee %>
    <div class="card" style="padding: var(--space-5);">
      <h2 class="section-title"><%= t("performance.reports.trend_for", name: @employee.full_name) %></h2>
      <% if @trend.blank? %>
        <div class="empty-state empty-state--compact"><p class="empty-state__text"><%= t("performance.reports.no_data") %></p></div>
      <% else %>
        <%= render "performance/reports/trend_table", trend: @trend %>
      <% end %>
    </div>
  <% end %>
</div>
