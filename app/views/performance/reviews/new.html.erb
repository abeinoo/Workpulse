<% content_for :title, t("performance.reviews.new_title") %>

<div class="form-page">
  <%= link_to performance_reviews_path, class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    <%= t("forms.back") %>
  <% end %>
  <h1 class="page-title mb-6"><%= t("performance.reviews.new_title") %></h1>

  <%# Step 1 — pick employee + period (GET reloads with the scoring screen) %>
  <%= form_with url: new_performance_review_path, method: :get, class: "form-card", style: "margin-bottom: var(--space-5);" do |f| %>
    <div class="form-grid">
      <div class="form-group">
        <%= f.label :employee_id, t("performance.reviews.employee"), class: "form-label" %>
        <%= f.collection_select :employee_id, @employees, :id, :full_name,
              { selected: @review.employee_id, prompt: t("performance.reviews.select_employee") },
              class: "form-control" %>
      </div>
      <div class="form-group">
        <%= f.label :review_month, t("performance.reviews.month"), class: "form-label" %>
        <%= f.select :review_month, (1..12).map { |m| [t("date.month_names")[m], m] },
              { selected: @review.review_month }, class: "form-control" %>
      </div>
      <div class="form-group">
        <%= f.label :review_year, t("performance.reviews.year"), class: "form-label" %>
        <%= f.number_field :review_year, value: @review.review_year, class: "form-control" %>
      </div>
    </div>
    <div class="form-actions">
      <%= f.submit t("performance.reviews.load_screen"), class: "btn btn-secondary" %>
    </div>
  <% end %>

  <%# Step 2 — scoring screen (shown once an employee is chosen) %>
  <% if @review.employee_id.present? && @composer %>
    <div class="card" style="padding: var(--space-4); margin-bottom: var(--space-4);">
      <h2 class="section-title" style="margin: 0;"><%= @review.employee&.full_name %></h2>
      <p class="form-hint" style="margin: 0;">
        <%= @review.department&.name || t("performance.reviews.no_department") %> ·
        <%= "#{t('date.month_names')[@review.review_month]} #{@review.review_year}" %>
      </p>
    </div>
    <%= render "scoring_form", review: @review, composer: @composer %>
  <% end %>
</div>
