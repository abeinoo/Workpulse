<% content_for :title, t("performance.reviews.edit_title") %>

<div class="form-page">
  <%= link_to performance_review_path(@review), class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    <%= t("forms.back") %>
  <% end %>
  <h1 class="page-title mb-6"><%= t("performance.reviews.edit_title") %></h1>

  <div class="card" style="padding: var(--space-4); margin-bottom: var(--space-4);">
    <h2 class="section-title" style="margin: 0;"><%= @review.employee.full_name %></h2>
    <p class="form-hint" style="margin: 0;">
      <%= @review.department.name %> · <%= @review.period_label %>
    </p>
  </div>

  <%= render "scoring_form", review: @review, composer: @composer %>
</div>
