<% content_for :title, t("till_handovers.new.page_title") %>

<turbo-frame id="modal">
<div class="emp-dashboard" style="padding: var(--space-5) var(--space-5) var(--space-8);">

  <%# ── Modal close row ───────────────────────────────────────────────── %>
  <div style="display: flex; align-items: center; justify-content: space-between;">
    <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); margin: 0;">
      <%= t("till_handovers.new.step_label") %>
    </p>
    <button type="button"
            data-action="click->modal#close"
            style="border: none; background: none; cursor: pointer; color: var(--text-2); padding: var(--space-1); border-radius: var(--radius-sm);"
            aria-label="<%= t("common.close") %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <%# ── Page heading ──────────────────────────────────────────────────── %>
  <div>
    <h1 style="font-size: var(--text-xl); font-weight: 700; color: var(--text-1); margin: 0 0 var(--space-1); line-height: 1.2;">
      <%= t("till_handovers.new.page_title") %>
    </h1>
    <p style="font-size: var(--text-sm); color: var(--text-2); margin: 0;">
      <%= t("till_handovers.new.subtitle") %>
    </p>
  </div>

  <%= form_with url: till_handovers_path, scope: :till_handover, method: :post,
        style: "display: flex; flex-direction: column; gap: var(--space-4);",
        data: { controller: "till-closing", turbo_frame: "_top",
                action: "submit->till-closing#validateSubmit",
                "till-closing-error-title": t("till_handovers.errors.amounts_below_minimum_title"),
                "till-closing-depositor-required": t("till_handovers.errors.depositor_required"),
                "till-closing-no-amounts": t("till_handovers.errors.no_amounts_entered") } do |f| %>

    <%= hidden_field_tag :daily_reconciliation_id, @open_reconciliation&.id %>

    <%# ── Action selector: What would you like to do? ───────────────── %>
    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden;">
      <div style="padding: var(--space-4) var(--space-5); border-bottom: 1px solid var(--border); background: var(--surface-2);">
        <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); margin: 0;">
          <%= t("till_handovers.new.action_question") %>
        </p>
      </div>
      <div style="padding: var(--space-4) var(--space-5); display: flex; flex-direction: column; gap: var(--space-3);">

        <%# Option 1: Hand over to another employee %>
        <label style="display: flex; align-items: flex-start; gap: var(--space-4); padding: var(--space-4); background: var(--surface-2); border: 1.5px solid var(--border); border-radius: var(--radius); cursor: pointer; transition: border-color 0.15s;">
          <%= radio_button_tag "till_handover[self_deposit]", "0", true,
                style: "flex-shrink: 0; accent-color: var(--accent); width: 18px; height: 18px; margin-top: 2px;",
                data: { action: "change->till-closing#handoverTypeChanged" } %>
          <div>
            <p style="font-size: var(--text-base); font-weight: 700; color: var(--text-1); margin: 0 0 2px;">
              <%= t("till_handovers.new.hand_to_colleague") %>
            </p>
            <p style="font-size: var(--text-xs); color: var(--text-2); margin: 0;">
              <%= t("till_handovers.new.hand_to_colleague_hint") %>
            </p>
          </div>
        </label>

        <%# Option 2: Close today's till session %>
        <% close_disabled = !@can_close_session %>
        <label style="display: flex; align-items: flex-start; gap: var(--space-4); padding: var(--space-4); background: var(--surface-2); border: 1.5px solid var(--border); border-radius: var(--radius); <%= close_disabled ? 'opacity: 0.55; cursor: not-allowed;' : 'cursor: pointer;' %> transition: border-color 0.15s;">
          <%= radio_button_tag "till_handover[self_deposit]", "1", false,
                disabled: close_disabled,
                style: "flex-shrink: 0; accent-color: var(--accent); width: 18px; height: 18px; margin-top: 2px;",
                data: { action: "change->till-closing#handoverTypeChanged" } %>
          <div>
            <p style="font-size: var(--text-base); font-weight: 700; color: var(--text-1); margin: 0 0 2px;">
              <%= t("till_handovers.new.self_deposit_option") %>
            </p>
            <p style="font-size: var(--text-xs); color: var(--text-2); margin: 0;">
              <%= t("till_handovers.new.self_deposit_hint") %>
            </p>
            <% if close_disabled %>
              <p style="font-size: var(--text-xs); color: var(--warning); margin: var(--space-2) 0 0; display: flex; align-items: flex-start; gap: var(--space-1); line-height: 1.5;">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0; margin-top: 1px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <%= t("till_handovers.new.close_blocked") %>
              </p>
            <% end %>
          </div>
        </label>

      </div>
    </div>

    <%# ── Who are you handing to? (visible only for handover mode) ───── %>
    <div data-till-closing-target="recipientSection">
      <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden;">
        <div style="padding: var(--space-4) var(--space-5); border-bottom: 1px solid var(--border); background: var(--surface-2);">
          <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); margin: 0;">
            <%= t("till_handovers.new.recipient_question") %>
          </p>
        </div>
        <div style="padding: var(--space-4) var(--space-5);">
          <% if @colleagues.empty? %>
            <div style="padding: var(--space-4); text-align: center;">
              <p style="font-size: var(--text-sm); color: var(--text-2); margin: 0;">
                <%= t("till_handovers.new.no_colleagues") %>
              </p>
            </div>
          <% else %>
            <div style="display: flex; flex-direction: column; gap: var(--space-2);">
              <% @colleagues.each_with_index do |colleague, i| %>
                <label style="display: flex; align-items: center; gap: var(--space-4); padding: var(--space-4); background: var(--surface-2); border: 1.5px solid var(--border); border-radius: var(--radius); cursor: pointer; transition: border-color 0.15s, background 0.15s;">
                  <%= radio_button_tag "till_handover[to_user_id]", colleague.id, i == 0,
                        style: "flex-shrink: 0; accent-color: var(--accent); width: 18px; height: 18px;" %>
                  <span style="font-size: var(--text-base); font-weight: 600; color: var(--text-1);">
                    <%= colleague.full_name %>
                  </span>
                </label>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# ── Today's collected amounts ─────────────────────────────────── %>
    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden;">
      <div style="padding: var(--space-4) var(--space-5); border-bottom: 1px solid var(--border); background: var(--surface-2);">
        <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); margin: 0 0 2px;">
          <%= t("till_handovers.new.amounts_question") %>
        </p>
        <p style="font-size: var(--text-xs); color: var(--text-2); margin: 0;">
          <%= t("till_handovers.new.amounts_hint") %>
        </p>
      </div>
      <div style="padding: var(--space-4) var(--space-5); display: flex; flex-direction: column; gap: var(--space-4);">
        <% @payment_methods.each do |pm| %>
          <% min = @minimum_amounts[pm.id.to_s] %>
          <div data-pm-name="<%= pm.display_name %>">
            <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); margin: 0 0 var(--space-3); display: flex; align-items: center; gap: var(--space-2);">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
              <%= pm.display_name %>
            </p>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
              <div class="form-group" style="margin: 0;">
                <%= label_tag "till_handover[amounts][#{pm.id}][collected_amount]",
                      t("till_handovers.new.collected_label"), class: "form-label" %>
                <%= number_field_tag "till_handover[amounts][#{pm.id}][collected_amount]",
                      nil, step: 0.01, min: 0, class: "form-control", placeholder: "0.00",
                      data: { minimum: (min&.dig(:collected) || 0).to_f } %>
                <% if min && min[:collected].to_f > 0 %>
                  <p style="font-size: var(--text-xs); color: var(--text-2); margin: var(--space-1) 0 0;">
                    <%= t("till_handovers.new.minimum_hint", amount: number_with_precision(min[:collected], precision: 2, delimiter: ",")) %>
                  </p>
                <% end %>
              </div>
              <div class="form-group" style="margin: 0;">
                <%= label_tag "till_handover[amounts][#{pm.id}][refund_amount]",
                      t("till_handovers.new.refund_label"), class: "form-label" %>
                <%= number_field_tag "till_handover[amounts][#{pm.id}][refund_amount]",
                      nil, step: 0.01, min: 0, class: "form-control", placeholder: "0.00",
                      data: { minimum: (min&.dig(:refund) || 0).to_f } %>
                <% if min && min[:refund].to_f > 0 %>
                  <p style="font-size: var(--text-xs); color: var(--text-2); margin: var(--space-1) 0 0;">
                    <%= t("till_handovers.new.minimum_hint", amount: number_with_precision(min[:refund], precision: 2, delimiter: ",")) %>
                  </p>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <%# ── Depositor assignment (close-day only) ──────────────────────── %>
    <div data-till-closing-target="depositorWrapper" hidden>
      <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden;">
        <div style="padding: var(--space-4) var(--space-5); border-bottom: 1px solid var(--border); background: var(--surface-2);">
          <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); margin: 0 0 2px;">
            <%= t("till_handovers.new.depositor_question") %>
          </p>
          <p style="font-size: var(--text-xs); color: var(--text-2); margin: 0;">
            <%= t("till_handovers.new.depositor_description") %>
          </p>
        </div>
        <div style="padding: var(--space-4) var(--space-5); display: flex; flex-direction: column; gap: var(--space-3);">

          <label style="display: flex; align-items: center; gap: var(--space-4); padding: var(--space-4); background: var(--surface-2); border: 1.5px solid var(--border); border-radius: var(--radius); cursor: pointer; transition: border-color 0.15s;">
            <%= radio_button_tag "till_handover[depositor_type]", "self", true,
                  style: "flex-shrink: 0; accent-color: var(--accent); width: 18px; height: 18px;",
                  data: { action: "change->till-closing#depositorTypeChanged" } %>
            <span style="font-size: var(--text-base); font-weight: 600; color: var(--text-1);">
              <%= t("till_handovers.new.depositor_self") %>
            </span>
          </label>

          <label style="display: flex; align-items: center; gap: var(--space-4); padding: var(--space-4); background: var(--surface-2); border: 1.5px solid var(--border); border-radius: var(--radius); cursor: pointer; transition: border-color 0.15s;">
            <%= radio_button_tag "till_handover[depositor_type]", "other", false,
                  style: "flex-shrink: 0; accent-color: var(--accent); width: 18px; height: 18px;",
                  data: { action: "change->till-closing#depositorTypeChanged" } %>
            <span style="font-size: var(--text-base); font-weight: 600; color: var(--text-1);">
              <%= t("till_handovers.new.depositor_other") %>
            </span>
          </label>

          <div data-till-closing-target="depositorPickerSection" hidden>
            <% if @depositor_candidates.empty? %>
              <p style="font-size: var(--text-sm); color: var(--text-2); padding: var(--space-2) var(--space-1); margin: 0;">
                <%= t("till_handovers.new.depositor_no_candidates") %>
              </p>
            <% else %>
              <div style="display: flex; flex-direction: column; gap: var(--space-2);">
                <% @depositor_candidates.each do |candidate| %>
                  <label style="display: flex; align-items: center; gap: var(--space-4); padding: var(--space-3) var(--space-4); background: var(--surface-2); border: 1.5px solid var(--border); border-radius: var(--radius); cursor: pointer; transition: border-color 0.15s, background 0.15s;">
                    <%= radio_button_tag "till_handover[depositor_id]", candidate.id, false,
                          style: "flex-shrink: 0; accent-color: var(--accent); width: 18px; height: 18px;" %>
                    <span style="font-size: var(--text-base); font-weight: 600; color: var(--text-1);">
                      <%= candidate.full_name %>
                    </span>
                  </label>
                <% end %>
              </div>
            <% end %>
          </div>

        </div>
      </div>
    </div><%# /depositorWrapper %>

    <%# ── Notes (optional) ──────────────────────────────────────────── %>
    <div class="form-group" style="margin: 0;">
      <%= label_tag "till_handover[notes]", t("till_handovers.new.notes_label"), class: "form-label" %>
      <%= text_area_tag "till_handover[notes]",
            nil, class: "form-control", rows: 2,
            placeholder: t("till_handovers.new.notes_placeholder") %>
    </div>

    <%# ── Submit ────────────────────────────────────────────────────── %>
    <div class="emp-dashboard__cta">
      <%= f.submit t("till_handovers.new.submit"),
            class: "btn btn-checkin",
            style: "width: 100%; justify-content: center; font-size: var(--text-base); padding: var(--space-4);" %>
      <button type="button"
              data-action="click->modal#close"
              class="btn btn-checkout"
              style="width: 100%; justify-content: center; text-align: center;">
        <%= t("common.cancel") %>
      </button>
    </div>
  <% end %>

</div>
</turbo-frame>
