<% content_for :title, t("till_handovers.adjust.title") %>

<turbo-frame id="modal">
<div style="padding: var(--space-5);">

  <%# ── Header ────────────────────────────────────────────────────────── %>
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-4);">
    <div>
      <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); margin: 0 0 2px;">
        <%= t("till_handovers.adjust.modal_label") %>
      </p>
      <h2 style="font-size: var(--text-xl); font-weight: 700; color: var(--text-1); margin: 0; line-height: 1.2;">
        <%= t("till_handovers.adjust.title") %>
      </h2>
    </div>
    <button type="button"
            data-action="click->modal#close"
            style="border: none; background: none; cursor: pointer; color: var(--text-2); padding: var(--space-2); border-radius: var(--radius-sm);"
            aria-label="<%= t("common.close") %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <%# ── Informational notice ───────────────────────────────────────────── %>
  <div style="background: rgba(var(--accent-rgb), 0.07); border: 1px solid rgba(var(--accent-rgb), 0.25); border-radius: var(--radius-lg); padding: var(--space-3) var(--space-4); margin-bottom: var(--space-4);">
    <p style="font-size: var(--text-sm); color: var(--text-2); margin: 0; line-height: 1.6;">
      <%= t("till_handovers.adjust.documentary_notice") %>
    </p>
  </div>

  <%# ── Original amounts (read-only reference) ────────────────────────── %>
  <div style="margin-bottom: var(--space-4);">
    <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); margin: 0 0 var(--space-2);">
      <%= t("till_handovers.adjust.original_amounts") %>
      <span style="font-weight: 400; color: var(--text-3); font-size: var(--text-xs);">
        — <%= t("till_handovers.adjust.original_amounts_hint") %>
      </span>
    </p>
    <div style="background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden;">
      <% operational_amounts = @amounts.select { |a| a.kind == "operational" } %>
      <% if operational_amounts.any? %>
        <% operational_amounts.each do |amt| %>
          <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-2) var(--space-4); border-bottom: 1px solid var(--border);">
            <span style="font-size: var(--text-sm); color: var(--text-2);"><%= amt.payment_method_name %></span>
            <span style="font-size: var(--text-sm); font-weight: 600; color: var(--text-1);">
              <%= format_currency(amt.net_amount) %>
            </span>
          </div>
        <% end %>
      <% else %>
        <p style="padding: var(--space-3) var(--space-4); color: var(--text-3); font-size: var(--text-sm); margin: 0;">
          <%= t("till_handovers.adjust.no_amounts") %>
        </p>
      <% end %>
    </div>
  </div>

  <%# ── Adjustment form ────────────────────────────────────────────────── %>
  <%= form_with url: create_adjustment_till_handover_path(@handover), method: :post,
                data: { turbo_frame: "_top" } do |f| %>

    <%# What should the amounts have been? ──────────────────────────────── %>
    <div style="margin-bottom: var(--space-4);">
      <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); margin: 0 0 var(--space-2);">
        <%= t("till_handovers.adjust.after_amounts_label") %>
      </p>
      <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden;">
        <% @payment_methods.each do |pm| %>
          <div style="padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--border);">
            <p style="font-size: var(--text-sm); font-weight: 600; color: var(--text-2); margin: 0 0 var(--space-2);">
              <%= pm.name %>
            </p>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3);">
              <div class="form-group" style="margin: 0;">
                <%= label_tag "after_data[#{pm.id}][collected_amount]",
                      t("till_handovers.adjust.collected"), class: "form-label" %>
                <%= number_field_tag "after_data[#{pm.id}][collected_amount]",
                      nil,
                      class: "form-control", step: "0.01", min: "0",
                      placeholder: "0.00" %>
              </div>
              <div class="form-group" style="margin: 0;">
                <%= label_tag "after_data[#{pm.id}][refund_amount]",
                      t("till_handovers.adjust.refund"), class: "form-label" %>
                <%= number_field_tag "after_data[#{pm.id}][refund_amount]",
                      nil,
                      class: "form-control", step: "0.01", min: "0",
                      placeholder: "0.00" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="form-group" style="margin-bottom: var(--space-3);">
      <%= label_tag :reason_code, t("till_handovers.adjust.reason_code_label"), class: "form-label" %>
      <%= select_tag :reason_code,
            options_for_select(
              @reason_codes.map { |c| [t("till_handovers.adjustment_reasons.#{c}"), c] }
            ),
            class: "form-control",
            required: true %>
    </div>

    <div class="form-group" style="margin-bottom: var(--space-4);">
      <%= label_tag :notes, t("till_handovers.adjust.notes_label"), class: "form-label" %>
      <%= text_area_tag :notes, nil, class: "form-control", rows: 3,
            placeholder: t("till_handovers.adjust.notes_placeholder"),
            required: true %>
      <p style="font-size: var(--text-xs); color: var(--text-3); margin: var(--space-1) 0 0;">
        <%= t("till_handovers.adjust.notes_hint") %>
      </p>
    </div>

    <div style="display: flex; flex-direction: column; gap: var(--space-3);">
      <%= f.submit t("till_handovers.adjust.submit"),
            class: "btn btn-primary",
            style: "width: 100%; justify-content: center; font-size: var(--text-base); padding: var(--space-4);" %>
      <button type="button"
              data-action="click->modal#close"
              class="btn btn-ghost"
              style="width: 100%; justify-content: center;">
        <%= t("common.cancel") %>
      </button>
    </div>

  <% end %>

</div>
</turbo-frame>
