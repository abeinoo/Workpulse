<% content_for :title, t("till_handovers.reverse.title") %>

<turbo-frame id="modal">
<div style="padding: var(--space-5) var(--space-5) var(--space-8); display: flex; flex-direction: column; gap: var(--space-4);">

  <%# ── Header ────────────────────────────────────────────────────────── %>
  <div style="display: flex; align-items: center; justify-content: space-between;">
    <div>
      <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--danger); margin: 0 0 2px;">
        <%= t("till_handovers.reverse.modal_label") %>
      </p>
      <h2 style="font-size: var(--text-xl); font-weight: 700; color: var(--text-1); margin: 0; line-height: 1.2;">
        <%= t("till_handovers.reverse.title") %>
      </h2>
    </div>
    <button type="button"
            data-action="click->modal#close"
            style="border: none; background: none; cursor: pointer; color: var(--text-2); padding: var(--space-2); border-radius: var(--radius-sm);"
            aria-label="<%= t("common.close") %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <%# ── Warning banner ────────────────────────────────────────────────── %>
  <div style="background: rgba(var(--danger-rgb), 0.07); border: 1px solid rgba(var(--danger-rgb), 0.3); border-radius: var(--radius-lg); padding: var(--space-4);">
    <p style="font-size: var(--text-sm); color: var(--danger); font-weight: 600; margin: 0 0 var(--space-1);">
      <%= t("till_handovers.reverse.warning_title") %>
    </p>
    <p style="font-size: var(--text-sm); color: var(--text-2); margin: 0; line-height: 1.6;">
      <%= t("till_handovers.reverse.warning_body", from: @handover.from_user.full_name, to: @handover.to_user.full_name) %>
    </p>
  </div>

  <%# ── Original handover summary ─────────────────────────────────────── %>
  <div style="background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-3) var(--space-4);">
    <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); margin: 0 0 var(--space-2);">
      <%= t("till_handovers.reverse.original_handover") %>
    </p>
    <p style="font-size: var(--text-sm); color: var(--text-1); margin: 0;">
      <%= t("till_handovers.reverse.from_to", from: @handover.from_user.full_name, to: @handover.to_user.full_name) %>
    </p>
    <p style="font-size: var(--text-xs); color: var(--text-3); margin: var(--space-1) 0 0;">
      <%= l(@handover.accepted_at, format: :long) %>
    </p>
    <% operational_amounts = @amounts.select { |a| a.kind == "operational" } %>
    <% if operational_amounts.any? %>
      <div style="margin-top: var(--space-2); display: flex; flex-direction: column; gap: 2px;">
        <% operational_amounts.each do |amt| %>
          <div style="display: flex; justify-content: space-between;">
            <span style="font-size: var(--text-xs); color: var(--text-3);">
              <%= amt.payment_method_name %>
            </span>
            <span style="font-size: var(--text-xs); font-weight: 600; color: var(--text-2);">
              <%= format_currency(amt.net_amount) %>
            </span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# ── Reversal form ──────────────────────────────────────────────────── %>
  <%= form_with url: reverse_till_handover_path(@handover), method: :patch,
                data: { turbo_frame: "_top" },
                style: "display: flex; flex-direction: column; gap: var(--space-4);" do |f| %>

    <div class="form-group" style="margin: 0;">
      <%= label_tag :reason_code, t("till_handovers.reverse.reason_code_label"), class: "form-label" %>
      <%= select_tag :reason_code,
            options_for_select(
              @reason_codes.map { |c| [t("till_handovers.reversal_reasons.#{c}"), c] }
            ),
            class: "form-control",
            required: true %>
    </div>

    <div class="form-group" style="margin: 0;">
      <%= label_tag :reason_notes, t("till_handovers.reverse.reason_notes_label"), class: "form-label" %>
      <%= text_area_tag :reason_notes, nil, class: "form-control", rows: 3,
            placeholder: t("till_handovers.reverse.reason_notes_placeholder") %>
      <p style="font-size: var(--text-xs); color: var(--text-3); margin: var(--space-1) 0 0;">
        <%= t("till_handovers.reverse.reason_notes_hint") %>
      </p>
    </div>

    <div style="display: flex; flex-direction: column; gap: var(--space-3);">
      <%= f.submit t("till_handovers.reverse.submit"),
            class: "btn btn-danger",
            style: "width: 100%; justify-content: center; font-size: var(--text-base); padding: var(--space-4);" %>
      <button type="button"
              data-action="click->modal#close"
              class="btn btn-ghost"
              style="width: 100%; justify-content: center;">
        <%= t("common.cancel") %>
      </button>
    </div>

  <% end %>

</div>
</turbo-frame>
