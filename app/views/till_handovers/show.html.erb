<% content_for :title, t("till_handovers.show.title") %>

<turbo-frame id="modal">
<div style="padding: var(--space-5);">

  <%# ── Modal header row ──────────────────────────────────────────────── %>
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-4);">
    <div>
      <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); margin: 0 0 2px;">
        <%= t("till_handovers.show.modal_label") %>
      </p>
      <h2 style="font-size: var(--text-xl); font-weight: 700; color: var(--text-1); margin: 0; line-height: 1.2;">
        <%= t("till_handovers.show.title") %>
      </h2>
    </div>
    <button type="button"
            data-action="click->modal#close"
            style="border: none; background: none; cursor: pointer; color: var(--text-2); padding: var(--space-2); border-radius: var(--radius-sm);"
            aria-label="<%= t("common.close") %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <%# ── Transfer summary ──────────────────────────────────────────────── %>
  <div style="background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-4); margin-bottom: var(--space-4);">
    <div style="display: flex; align-items: center; gap: var(--space-3);">
      <div style="flex-shrink: 0; width: 40px; height: 40px; border-radius: 50%; background: rgba(var(--accent-rgb), 0.12); display: flex; align-items: center; justify-content: center; color: var(--accent);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
      </div>
      <div>
        <p style="font-size: var(--text-sm); color: var(--text-2); margin: 0 0 2px;">
          <%= t("till_handovers.show.from_label") %>
        </p>
        <p style="font-size: var(--text-base); font-weight: 700; color: var(--text-1); margin: 0;">
          <%= @handover.from_user.full_name %>
        </p>
        <p style="font-size: var(--text-xs); color: var(--text-3); margin: 2px 0 0;">
          <%= l(@handover.created_at, format: :time_only) %>
          <% if @handover.branch %>
            · <%= @handover.branch.name %>
          <% end %>
        </p>
      </div>
      <% if @handover.accepted? %>
        <span class="badge badge-accent" style="margin-inline-start: auto;">
          <%= t("my_shift.history.accepted") %>
        </span>
      <% end %>
    </div>
  </div>

  <%# ── Amounts ────────────────────────────────────────────────────────── %>
  <% operational_amounts = @amounts.select { |a| a.kind == "operational" } %>
  <% if operational_amounts.any? %>
    <div style="margin-bottom: var(--space-4);">
      <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); margin: 0 0 var(--space-2);">
        <%= t("till_handovers.show.amounts") %>
      </p>
      <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden;">
        <% operational_amounts.each do |amount| %>
          <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--border);">
            <span style="font-size: var(--text-sm); color: var(--text-2);"><%= amount.payment_method_name %></span>
            <div style="text-align: end;">
              <span style="font-size: var(--text-sm); font-weight: 600; color: var(--text-1);">
                <%= number_to_currency(amount.net_amount, unit: "", separator: ".", delimiter: ",") %>
              </span>
              <% if amount.refund_amount > 0 %>
                <span style="display: block; font-size: 11px; color: var(--danger);">
                  − <%= number_to_currency(amount.refund_amount, unit: "", separator: ".", delimiter: ",") %> <%= t("till_handovers.show.refund") %>
                </span>
              <% end %>
            </div>
          </div>
        <% end %>
        <div style="display: flex; justify-content: space-between; padding: var(--space-3) var(--space-4); background: var(--surface-2);">
          <span style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1);"><%= t("till_handovers.show.net_total") %></span>
          <span style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1);">
            <%= number_to_currency(operational_amounts.sum(&:net_amount), unit: "", separator: ".", delimiter: ",") %>
          </span>
        </div>
      </div>
    </div>
  <% end %>

  <%# ── From notes ─────────────────────────────────────────────────────── %>
  <% if @handover.from_notes.present? %>
    <div style="background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--space-3) var(--space-4); margin-bottom: var(--space-4);">
      <p style="font-size: var(--text-xs); font-weight: 600; color: var(--text-3); text-transform: uppercase; margin: 0 0 var(--space-1);">
        <%= t("common.notes") %>
      </p>
      <p style="font-size: var(--text-sm); color: var(--text-1); margin: 0; line-height: 1.6;">
        <%= @handover.from_notes %>
      </p>
    </div>
  <% end %>

  <%# ── Accept form (only if pending and I'm the recipient) ───────────── %>
  <% if @handover.pending? && @handover.to_user_id == current_user.id && policy(@handover).accept? %>
    <%= form_with url: accept_till_handover_path(@handover), method: :patch,
          data: { turbo_frame: "_top" } do |f| %>
      <div class="form-group" style="margin-bottom: var(--space-4);">
        <%= label_tag :accepted_notes, t("till_handovers.show.accepted_notes_label"), class: "form-label" %>
        <%= text_area_tag :accepted_notes, nil, class: "form-control", rows: 2,
              placeholder: t("till_handovers.show.accepted_notes_placeholder") %>
      </div>
      <div style="display: flex; flex-direction: column; gap: var(--space-3);">
        <%= f.submit t("till_handovers.show.accept_submit"),
              class: "btn btn-checkin",
              style: "width: 100%; justify-content: center; font-size: var(--text-base); padding: var(--space-4);" %>
        <button type="button"
                data-action="click->modal#close"
                class="btn btn-checkout"
                style="width: 100%; justify-content: center;">
          <%= t("common.cancel") %>
        </button>
      </div>
    <% end %>
  <% elsif @handover.accepted? %>
    <div style="display: flex; align-items: center; justify-content: center; gap: var(--space-2); padding: var(--space-3) 0; color: var(--success); font-size: var(--text-sm);">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
      <%= t("till_handovers.show.accepted_by", name: @handover.to_user&.full_name) %>
    </div>
    <div style="text-align: center; padding-bottom: var(--space-2);">
      <button type="button"
              data-action="click->modal#close"
              class="btn btn-ghost btn-sm">
        <%= t("common.close") %>
      </button>
    </div>
  <% end %>

</div>
</turbo-frame>
