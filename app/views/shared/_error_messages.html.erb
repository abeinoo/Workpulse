<% obj = local_assigns.fetch(:object) { resource } %>
<% if obj.errors.any? %>
  <div class="form-error" data-turbo-temporary>
    <p class="form-error__title">
      <%= t("flash.errors_#{obj.errors.count == 1 ? 'one' : 'other'}", count: obj.errors.count) %>
    </p>
    <ul>
      <% obj.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
