<% content_for :title, "#{t('adjustments.new.title')} — WorkPulse" %>

<div class="form-page">
  <%= link_to adjustments_path, class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="15 18 9 12 15 6"/>
    </svg>
    <%= t("adjustments.new.back") %>
  <% end %>

  <h1 class="page-title"><%= t("adjustments.new.title") %></h1>
  <p class="page-subtitle"><%= t("adjustments.subtitle") %></p>

  <% if @selectable_periods.empty? %>
    <div class="alert alert-warning" style="margin-top: var(--space-4);">
      <%= t("adjustments.new.no_periods") %>
    </div>
  <% end %>

  <%= form_with model: @adjustment, url: adjustments_path, local: true, class: "form-card",
        data: { controller: "payroll-adjustment-form" } do |f| %>
    <%= render "shared/error_messages", object: @adjustment %>

    <div class="form-grid">
      <div class="form-group form-group--full">
        <%= f.label :user_id, t("adjustments.new.employee_label"), class: "form-label form-label--required" %>
        <%= f.select :user_id,
              @employees.map { |u| [u.full_name, u.id] },
              { include_blank: t("forms.select") },
              class: "form-control" %>
      </div>

      <%# Target payroll period — explicit selection, never a silent current-month default %>
      <div class="form-group form-group--full">
        <%= f.label :period_key, t("adjustments.new.period_label"), class: "form-label form-label--required" %>
        <%= select_tag "payroll_adjustment[period_key]",
              options_for_select(@selectable_periods, @selected_period_key),
              { include_blank: t("forms.select"),
                class: "form-control",
                disabled: @selectable_periods.empty? } %>
        <p class="form-hint"><%= t("adjustments.new.period_hint") %></p>
      </div>

      <div class="form-group">
        <% selected_type = @adjustment.adjustment_type.presence || "cash_incentive" %>
        <%= f.label :adjustment_type, t("adjustments.new.type_label"), class: "form-label form-label--required" %>
        <%= f.select :adjustment_type,
              PayrollAdjustment::ADJUSTMENT_TYPES.map { |type| [t("adjustments.types.#{type}"), type] },
              { selected: selected_type },
              class: "form-control",
              data: { payroll_adjustment_form_target: "type",
                      action: "change->payroll-adjustment-form#onChange" } %>
        <p class="form-hint"><%= t("adjustments.new.type_hint") %></p>
      </div>

      <div class="form-group">
        <%= f.label :amount, t("adjustments.new.amount_label"), class: "form-label form-label--required" %>
        <%= f.number_field :amount,
              class: "form-control",
              min: 0.01,
              step: "0.01",
              placeholder: t("adjustments.new.amount_placeholder") %>
      </div>

      <div class="form-group form-group--full">
        <%= f.label :reason, t("adjustments.new.reason_label"), class: "form-label form-label--required" %>
        <%= f.text_area :reason,
              rows: 3,
              class: "form-control",
              placeholder: t("adjustments.new.reason_placeholder") %>
      </div>

    </div>

    <%# Already-paid section — only shown for cash_incentive ── %>
    <%= render "shared/adjustment_already_paid_section",
          f: f, adjustment: @adjustment, selected_type: selected_type %>

    <%# Every adjustment is submitted as Pending and requires a separate approver. %>
    <div class="alert alert-info" style="margin-top: var(--space-4);">
      <%= t("adjustments.new.hint") %>
    </div>

    <div class="form-actions">
      <%= f.submit t("adjustments.new.submit_review"),
            class: "btn btn-primary", disabled: @selectable_periods.empty? %>
      <%= link_to t("forms.cancel"), adjustments_path, class: "btn btn-ghost" %>
    </div>
  <% end %>
</div>
