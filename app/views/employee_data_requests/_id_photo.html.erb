<%# One ID card photo, streamed through the authorized document action (never a
    public Active Storage URL). Tapping opens a full-screen viewer with zoom and
    rotate so the card's text can be inspected on a phone.
    locals: request, revision, side (:front / :back) %>
<% label = t("employee_data_requests.fields.id_#{side}") %>
<% src   = document_employee_data_request_path(request, side: side, revision_id: revision.id) %>
<figure class="edr-photo" data-controller="id-photo-viewer">
  <button type="button" class="edr-photo__thumb" data-action="id-photo-viewer#open"
          aria-label="<%= t("employee_data_requests.show.enlarge", label: label) %>">
    <img src="<%= src %>" alt="<%= label %>" loading="lazy" class="edr-photo__img">
    <span class="edr-photo__zoom-hint" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
    </span>
  </button>
  <figcaption class="edr-photo__caption"><%= label %></figcaption>

  <dialog class="edr-viewer" data-id-photo-viewer-target="dialog" data-action="click->id-photo-viewer#backdrop"
          aria-label="<%= label %>">
    <div class="edr-viewer__bar">
      <span class="edr-viewer__title"><%= label %></span>
      <div class="edr-viewer__tools">
        <button type="button" class="btn btn-sm btn-secondary" data-action="id-photo-viewer#rotate"><%= t("employee_data_requests.show.rotate") %></button>
        <button type="button" class="btn btn-sm btn-secondary" data-action="id-photo-viewer#zoom"
                data-id-photo-viewer-target="zoomButton"
                data-zoom-in="<%= t("employee_data_requests.show.zoom_in") %>"
                data-zoom-out="<%= t("employee_data_requests.show.zoom_out") %>"><%= t("employee_data_requests.show.zoom_in") %></button>
        <%= link_to t("employee_data_requests.show.open_original"), src, target: "_blank", rel: "noopener noreferrer", class: "btn btn-sm btn-ghost" %>
        <button type="button" class="btn btn-sm btn-primary" data-action="id-photo-viewer#close"><%= t("employee_data_requests.show.close") %></button>
      </div>
    </div>
    <div class="edr-viewer__stage" data-id-photo-viewer-target="stage">
      <img src="<%= src %>" alt="<%= label %>" class="edr-viewer__img" data-id-photo-viewer-target="image">
    </div>
  </dialog>
</figure>
