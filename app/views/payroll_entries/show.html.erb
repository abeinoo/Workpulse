<div class="admin-page has-sticky-actions">

  <%# ── Page header ────────────────────────────────────────────────────────── %>
  <div class="page-header">
    <div>
      <%= link_to t("payroll.entry.back"), payroll_period_path(@period), class: "back-link" %>
      <% if current_user.owner? || current_user.manages_branch? || current_user.can?(:view_payroll) %>
        <h1 class="page-title"><%= @entry.user.full_name %></h1>
        <p class="page-subtitle"><%= @period.period_label %></p>
      <% else %>
        <h1 class="page-title"><%= @period.period_label %></h1>
        <p class="page-subtitle"><%= t("payroll.entry.payslip") %></p>
      <% end %>
    </div>
    <span class="badge <%= period_status_badge_class(@period) %>">
      <%= t("payroll.statuses.#{@period.status}") %>
    </span>
  </div>

  <%# ── Period lock notice ─────────────────────────────────────────────────── %>
  <% if @period.locked? %>
    <div class="payroll-lock-banner">
      <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true"><path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd"/></svg>
      <span><%= t("payroll.locked.#{@period.lock_reason}") %></span>
    </div>
  <% end %>

  <%# ── Mobile sticky action bar (approve/reject pending items) ───────────── %>
  <% can_manage = current_user.owner? || current_user.manages_branch? || current_user.can?(:view_payroll) %>
  <% if can_manage && @period.reviewable? %>
    <div class="page-actions page-actions--sticky">
      <% if can_manage %>
        <%= link_to t("payroll.entry.add_btn") + " " + t("payroll.entry.additions_bonuses"),
              new_payroll_period_payroll_entry_payroll_adjustment_path(@period, @entry, adjustment_type: :cash_incentive),
              class: "btn btn-sm btn-success" %>
        <%= link_to t("payroll.entry.add_btn") + " " + t("payroll.entry.manual_deductions"),
              new_payroll_period_payroll_entry_payroll_adjustment_path(@period, @entry, adjustment_type: :deduction),
              class: "btn btn-sm btn-danger btn-sm" %>
      <% end %>
    </div>
  <% end %>

  <%# ── Attendance summary stats ───────────────────────────────────────────── %>
  <% if @attendance_records.any? %>
    <div class="stats-grid" style="margin-bottom: 1.5rem;">
      <div class="stat-card">
        <div class="stat-card__label"><%= t("payroll.entry.days_worked") %></div>
        <div class="stat-card__value"><%= @attendance[:days_present] %></div>
        <div class="stat-card__sub"><%= t("payroll.entry.of_working_days", count: @entry.working_days) %></div>
      </div>
      <div class="stat-card <%= @attendance[:days_absent] > 0 ? 'stat-card--danger' : '' %>">
        <div class="stat-card__label"><%= t("payroll.entry.days_absent") %></div>
        <div class="stat-card__value"><%= @attendance[:days_absent] %></div>
      </div>
      <div class="stat-card <%= @attendance[:total_late_minutes] > 0 ? 'stat-card--warning' : '' %>">
        <div class="stat-card__label"><%= t("payroll.entry.late_minutes_label") %></div>
        <div class="stat-card__value"><%= @attendance[:total_late_minutes] %></div>
      </div>
      <div class="stat-card <%= @attendance[:overtime_minutes] > 0 ? 'stat-card--success' : '' %>">
        <div class="stat-card__label"><%= t("payroll.entry.overtime_col") %></div>
        <div class="stat-card__value"><%= format_minutes(@attendance[:overtime_minutes]) %></div>
      </div>
      <% if @attendance[:total_early_leave_minutes] > 0 %>
        <div class="stat-card stat-card--warning">
          <div class="stat-card__label"><%= t("payroll.entry.early_leave_col") %></div>
          <div class="stat-card__value"><%= @attendance[:total_early_leave_minutes] %> min</div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# ── Salary breakdown ───────────────────────────────────────────────────── %>
  <%
    already_paid_items = @additions.select(&:already_paid?)
    has_already_paid   = @entry.already_paid_total > 0
    gross_amount       = @entry.base_salary.to_f + @entry.total_overtime.to_f + @entry.total_bonuses.to_f -
                         @entry.total_deductions.to_f - @entry.advances_deducted.to_f - @entry.obligations_deducted.to_f
  %>
  <div class="payslip-breakdown" style="margin-bottom: 1.5rem;">
    <div class="payslip-breakdown__row">
      <span class="payslip-breakdown__label"><%= t("payroll.entry.base_salary") %></span>
      <span class="payslip-breakdown__value"><%= format_currency(@entry.base_salary) %></span>
    </div>
    <% if @entry.total_overtime > 0 %>
      <div class="payslip-breakdown__row">
        <span class="payslip-breakdown__label"><%= t("payroll.entry.overtime_pay") %></span>
        <span class="payslip-breakdown__value text-success">+ <%= format_currency(@entry.total_overtime) %></span>
      </div>
    <% end %>
    <% if @entry.total_bonuses > 0 %>
      <div class="payslip-breakdown__row">
        <span class="payslip-breakdown__label"><%= t("payroll.entry.bonuses") %></span>
        <span class="payslip-breakdown__value text-success">+ <%= format_currency(@entry.total_bonuses) %></span>
      </div>
    <% end %>
    <% if @entry.total_deductions > 0 %>
      <div class="payslip-breakdown__row">
        <span class="payslip-breakdown__label"><%= t("payroll.deductions") %></span>
        <span class="payslip-breakdown__value text-danger">− <%= format_currency(@entry.total_deductions) %></span>
      </div>
    <% end %>
    <% if @entry.advances_deducted > 0 %>
      <div class="payslip-breakdown__row">
        <span class="payslip-breakdown__label"><%= t("payroll.entry.advance_repayments") %></span>
        <span class="payslip-breakdown__value text-danger">− <%= format_currency(@entry.advances_deducted) %></span>
      </div>
    <% end %>
    <% if @entry.obligations_deducted > 0 %>
      <div class="payslip-breakdown__row">
        <span class="payslip-breakdown__label"><%= t("payroll.entry.obligations_deducted") %></span>
        <span class="payslip-breakdown__value text-danger">− <%= format_currency(@entry.obligations_deducted) %></span>
      </div>
    <% end %>

    <% if has_already_paid %>
      <div class="payslip-breakdown__row payslip-breakdown__row--subtotal">
        <span class="payslip-breakdown__label"><%= t("payroll.entry.gross_amount") %></span>
        <span class="payslip-breakdown__value"><%= format_currency(gross_amount) %></span>
      </div>
      <div class="payslip-breakdown__already-paid">
        <div class="payslip-breakdown__already-paid-header">
          <%= t("payroll.entry.already_paid_section") %>
        </div>
        <% already_paid_items.each do |li| %>
          <div class="payslip-breakdown__already-paid-row">
            <span class="payslip-breakdown__already-paid-label">
              <%= t("payroll.entry.item_types.#{li.item_type}") %>
              <% if li.source_type == "PayrollAdjustment" %>
                <% adj = @paid_adjustments[li.source_id] %>
                <% if adj&.paid_at %>
                  <span class="payslip-breakdown__already-paid-meta">
                    <%= local_short_date(adj.paid_at) %>
                    &middot; <%= t("payroll_adjustments.payment_methods.#{adj.payment_method}") if adj.payment_method %>
                  </span>
                <% end %>
              <% end %>
            </span>
            <span class="payslip-breakdown__already-paid-amount">− <%= format_currency(li.amount.abs) %></span>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="payslip-breakdown__row payslip-breakdown__row--total">
      <span class="payslip-breakdown__label">
        <%= has_already_paid ? t("payroll.entry.final_payable") : t("payroll.entry.net_salary") %>
      </span>
      <span class="payslip-breakdown__value"><%= format_currency(@entry.net_salary) %></span>
    </div>
  </div>

  <%# ── Deductions ─────────────────────────────────────────────────────────── %>
  <% if @deductions.any? %>
    <h2 class="section-heading"><%= t("payroll.deductions") %></h2>
    <div class="table-wrap table-wrap--cards" style="margin-bottom: 1.5rem;">
      <table>
        <thead>
          <tr>
            <th><%= t("payroll.entry.type_col") %></th>
            <th><%= t("payroll.entry.description_col") %></th>
            <th><%= t("payroll.entry.date_col") %></th>
            <th class="text-right"><%= t("requests.amount") %></th>
            <th><%= t("payroll.entry.review_status") %></th>
            <% if can_manage %>
              <th><%= t("attendance.actions") %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @deductions.each do |item| %>
            <%
              source_date = nil
              if item.source_type == "AttendanceRecord"
                source_date = @source_records[item.source_id]&.date
              end
              struck = item.waived? || item.rejected?
            %>
            <tr>
              <td data-label="<%= t('payroll.entry.type_col') %>">
                <%= t("payroll.entry.item_types.#{item.item_type}") %>
              </td>
              <td class="td-secondary" data-label="<%= t('payroll.entry.description_col') %>">
                <%= item.description.presence || "—" %>
              </td>
              <td class="td-secondary" data-label="<%= t('payroll.entry.date_col') %>">
                <%= local_short_date(source_date) %>
              </td>
              <td class="text-right<%= struck ? ' text-muted' : ' text-danger' %>"
                  style="<%= 'text-decoration: line-through;' if struck %>"
                  data-label="<%= t('requests.amount') %>">
                − <%= format_currency(item.amount.abs) %>
              </td>
              <td data-label="<%= t('payroll.entry.review_status') %>">
                <span class="badge <%= deduction_status_badge_class(item) %>">
                  <%= t("payroll.entry.review_statuses.#{item.review_status}") %>
                </span>
              </td>
              <% if can_manage %>
                <td class="td-actions" data-label="<%= t('attendance.actions') %>">
                  <% if @period.reviewable? %>
                    <% if item.pending_review? && policy(item).approve? %>
                      <%= button_to t("payroll.entry.approve"),
                            approve_payroll_period_payroll_entry_payroll_line_item_path(@period, @entry, item),
                            method: :patch, class: "btn btn-sm btn-success" %>
                      <%= button_to t("payroll.entry.reject"),
                            reject_payroll_period_payroll_entry_payroll_line_item_path(@period, @entry, item),
                            method: :patch, class: "btn btn-sm btn-danger" %>
                    <% end %>
                    <% if !item.waived? && !item.rejected? && !item.pending_review? && policy(item).waive? %>
                      <details style="display: inline-block; vertical-align: top;">
                        <summary class="btn btn-sm btn-warning" style="cursor: pointer; list-style: none;"><%= t("payroll.entry.waive") %></summary>
                        <div class="waive-popover">
                          <%= form_with url: waive_payroll_period_payroll_entry_payroll_line_item_path(@period, @entry, item),
                                        method: :patch do |f| %>
                            <p class="waive-popover__hint"><%= t("payroll.entry.waive_hint") %></p>
                            <%= f.text_area :notes, placeholder: t("payroll.entry.waive_placeholder"), required: true,
                                  rows: 2, class: "waive-popover__textarea" %>
                            <%= f.submit t("payroll.entry.confirm_waive"), class: "btn btn-sm btn-warning" %>
                          <% end %>
                        </div>
                      </details>
                    <% end %>
                  <% elsif item.reviewed_at %>
                    <span class="td-secondary" style="font-size: 0.75rem;"><%= local_short_date(item.reviewed_at) %></span>
                  <% end %>
                </td>
              <% end %>
            </tr>

            <%# Permission reduction note %>
            <% if %w[late_penalty early_leave_penalty].include?(item.item_type) && item.permission_minutes.to_i > 0 %>
              <tr class="permission-note-row">
                <td colspan="<%= can_manage ? 6 : 5 %>">
                  <span class="permission-note permission-note--covered">
                    ✓ <%= t("payroll.entry.permission_granted", minutes: item.permission_minutes) %>
                    &middot;
                    <%= t("payroll.entry.permission_original", minutes: item.original_minutes) %>
                    &middot;
                    <% effective = [ item.original_minutes.to_i - item.permission_minutes.to_i, 0 ].max %>
                    <%= t("payroll.entry.permission_penalized", minutes: effective) %>
                  </span>
                </td>
              </tr>
            <% end %>

            <%# Waive / rejection note %>
            <% if item.review_notes.present? %>
              <tr class="deduction-note-row">
                <td colspan="<%= can_manage ? 6 : 5 %>">
                  <span class="deduction-note">
                    <% if item.waived? %>
                      <%= t("payroll.entry.waived_by", name: item.reviewed_by&.full_name || t("forms.none")) %>
                      <%= "on #{local_short_date(item.reviewed_at)}" if item.reviewed_at %> —
                    <% elsif item.rejected? %>
                      <%= t("payroll.entry.rejected") %> —
                    <% end %>
                    <%= item.review_notes %>
                  </span>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <%# ── Additions / bonuses ────────────────────────────────────────────────── %>
  <% show_additions_section = @additions.any? || (can_manage && @period.reviewable?) %>
  <% if show_additions_section %>
    <div style="display: flex; align-items: baseline; justify-content: space-between; margin: 1.75rem 0 0.6rem;">
      <h2 class="section-heading" style="margin: 0;"><%= t("payroll.entry.additions_bonuses") %></h2>
      <% if can_manage && @period.reviewable? %>
        <%= link_to t("payroll.entry.add_btn"),
              new_payroll_period_payroll_entry_payroll_adjustment_path(@period, @entry, adjustment_type: :cash_incentive),
              class: "btn btn-sm btn-success" %>
      <% end %>
    </div>
    <% if @additions.any? %>
      <div class="table-wrap table-wrap--cards" style="margin-bottom: 1.5rem;">
        <table>
          <thead>
            <tr>
              <th><%= t("payroll.entry.type_col") %></th>
              <th><%= t("payroll.entry.description_col") %></th>
              <th class="text-right"><%= t("requests.amount") %></th>
              <th><%= t("payroll.entry.review_status") %></th>
              <% if current_user.owner? %><th><%= t("attendance.actions") %></th><% end %>
            </tr>
          </thead>
          <tbody>
            <% @additions.each do |item| %>
              <tr>
                <td data-label="<%= t('payroll.entry.type_col') %>">
                  <%= t("payroll.entry.item_types.#{item.item_type}") %>
                  <% if item.already_paid? %>
                    &nbsp;<span class="badge badge-warning" style="font-size:10px;vertical-align:middle;">
                      <%= t("payroll.entry.already_paid_badge") %>
                    </span>
                  <% end %>
                </td>
                <td class="td-secondary" data-label="<%= t('payroll.entry.description_col') %>">
                  <%= item.description.presence || "—" %>
                </td>
                <td class="text-right <%= item.pending_review? ? 'text-muted' : (item.already_paid? ? 'text-warning' : 'text-success') %>"
                    style="<%= 'text-decoration: line-through;' if item.rejected? %>"
                    data-label="<%= t('requests.amount') %>">
                  + <%= format_currency(item.amount) %>
                  <% if item.already_paid? %>
                    <span style="font-size:10px;color:var(--text-2);display:block;">
                      <%= t("payroll.entry.already_paid_note") %>
                    </span>
                  <% end %>
                </td>
                <td data-label="<%= t('payroll.entry.review_status') %>">
                  <span class="badge <%= line_item_review_badge_class(item) %>">
                    <%= t("payroll.entry.review_statuses.#{item.review_status}") %>
                  </span>
                </td>
                <% if current_user.owner? %>
                  <td class="td-actions" data-label="<%= t('attendance.actions') %>">
                    <% if item.pending_review? && @period.reviewable? %>
                      <%= button_to t("payroll.entry.approve"),
                            approve_payroll_period_payroll_entry_payroll_line_item_path(@period, @entry, item),
                            method: :patch, class: "btn btn-sm btn-success" %>
                      <%= button_to t("payroll.entry.reject"),
                            reject_payroll_period_payroll_entry_payroll_line_item_path(@period, @entry, item),
                            method: :patch, class: "btn btn-sm btn-danger" %>
                    <% elsif item.reviewed_at %>
                      <span class="td-secondary" style="font-size: 0.75rem;"><%= local_short_date(item.reviewed_at) %></span>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>

  <%# ── Manual deductions (manager-created) ───────────────────────────────── %>
  <% if can_manage && @period.reviewable? %>
    <div style="display: flex; align-items: baseline; justify-content: space-between; margin: 1.75rem 0 0.6rem;">
      <h2 class="section-heading" style="margin: 0;"><%= t("payroll.entry.manual_deductions") %></h2>
      <% if current_user.manages_branch? || current_user.owner? %>
        <%= link_to t("payroll.entry.add_btn"),
              new_payroll_period_payroll_entry_payroll_adjustment_path(@period, @entry, adjustment_type: :deduction),
              class: "btn btn-sm btn-danger" %>
      <% end %>
    </div>
    <% manual = @manual_deductions %>
    <% if manual.any? %>
      <div class="table-wrap table-wrap--cards" style="margin-bottom: 1.5rem;">
        <table>
          <thead>
            <tr>
              <th><%= t("payroll.entry.description_col") %></th>
              <th class="text-right"><%= t("requests.amount") %></th>
              <th><%= t("payroll.entry.review_status") %></th>
              <% if current_user.owner? %><th><%= t("attendance.actions") %></th><% end %>
            </tr>
          </thead>
          <tbody>
            <% manual.each do |item| %>
              <tr>
                <td class="td-secondary" data-label="<%= t('payroll.entry.description_col') %>">
                  <%= item.description.presence || "—" %>
                </td>
                <td class="text-right <%= item.approved? ? 'text-danger' : 'text-muted' %>"
                    style="<%= 'text-decoration: line-through;' if item.rejected? || item.waived? %>"
                    data-label="<%= t('requests.amount') %>">
                  − <%= format_currency(item.amount.abs) %>
                </td>
                <td data-label="<%= t('payroll.entry.review_status') %>">
                  <span class="badge <%= deduction_status_badge_class(item) %>">
                    <%= t("payroll.entry.review_statuses.#{item.review_status}") %>
                  </span>
                </td>
                <% if current_user.owner? %>
                  <td class="td-actions" data-label="<%= t('attendance.actions') %>">
                    <% if item.pending_review? && @period.reviewable? && policy(item).approve? %>
                      <%= button_to t("payroll.entry.approve"),
                            approve_payroll_period_payroll_entry_payroll_line_item_path(@period, @entry, item),
                            method: :patch, class: "btn btn-sm btn-success" %>
                      <%= button_to t("payroll.entry.reject"),
                            reject_payroll_period_payroll_entry_payroll_line_item_path(@period, @entry, item),
                            method: :patch, class: "btn btn-sm btn-danger" %>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p style="color: var(--text-2); font-size: var(--text-sm); margin-bottom: 1.5rem;">
        <%= t("payroll.entry.no_manual_deductions") %>
      </p>
    <% end %>
  <% end %>

  <% if @deductions.empty? && @additions.empty? && !can_manage %>
    <p style="text-align: center; color: var(--text-2); padding: 2rem 0;">
      <%= t("payroll.entry.no_deductions") %>
    </p>
  <% end %>

  <%# ── Detailed attendance records ────────────────────────────────────────── %>
  <% if @attendance_records.any? %>
    <h2 class="section-heading"><%= t("payroll.entry.attendance_records") %></h2>
    <div class="table-wrap table-wrap--cards">
      <table class="attendance-table">
        <thead>
          <tr>
            <th><%= t("payroll.entry.date_col") %></th>
            <th><%= t("payroll.entry.check_in") %></th>
            <th><%= t("payroll.entry.check_out") %></th>
            <th class="text-right"><%= t("payroll.entry.worked") %></th>
            <th class="text-right"><%= t("payroll.entry.overtime_col") %></th>
            <th class="text-right"><%= t("payroll.entry.late_col") %></th>
            <th class="text-right"><%= t("payroll.entry.early_leave_col") %></th>
            <th class="text-right"><%= t("payroll.entry.permission_col") %></th>
            <th><%= t("attendance.status") %></th>
          </tr>
        </thead>
        <tbody>
          <% @attendance_records.each do |rec| %>
            <%
              shift      = rec.shift_assignment&.shift
              ot_minutes = shift ? [ rec.worked_minutes.to_i - shift.duration_minutes, 0 ].max : 0
              late_perm  = @permission_lookup[["late_permission",  rec.work_date]].to_i
              early_perm = @permission_lookup[["early_leave",      rec.work_date]].to_i
              total_perm = late_perm + early_perm
            %>
            <tr class="<%= rec.absent? ? 'row-absent' : '' %>">
              <td class="attendance-date" data-label="<%= t('payroll.entry.date_col') %>">
                <%= local_short_date(rec.date) %>
              </td>
              <td class="td-secondary" data-label="<%= t('payroll.entry.check_in') %>">
                <%= local_time(rec.check_in_at) %>
              </td>
              <td class="td-secondary" data-label="<%= t('payroll.entry.check_out') %>">
                <%= local_time(rec.check_out_at) %>
              </td>
              <td class="text-right td-secondary" data-label="<%= t('payroll.entry.worked') %>">
                <%= rec.worked_minutes ? format_minutes(rec.worked_minutes) : "—" %>
              </td>
              <td class="text-right <%= ot_minutes > 0 ? 'text-success' : 'td-secondary' %>"
                  data-label="<%= t('payroll.entry.overtime_col') %>">
                <%= ot_minutes > 0 ? format_minutes(ot_minutes) : "—" %>
              </td>
              <td class="text-right <%= rec.late_minutes > 0 ? 'text-warning' : 'td-secondary' %>"
                  data-label="<%= t('payroll.entry.late_col') %>">
                <%= rec.late_minutes > 0 ? "#{rec.late_minutes} min" : "—" %>
              </td>
              <td class="text-right <%= rec.early_leave_minutes > 0 ? 'text-warning' : 'td-secondary' %>"
                  data-label="<%= t('payroll.entry.early_leave_col') %>">
                <%= rec.early_leave_minutes > 0 ? "#{rec.early_leave_minutes} min" : "—" %>
              </td>
              <td class="text-right <%= total_perm > 0 ? 'text-success' : 'td-secondary' %>"
                  data-label="<%= t('payroll.entry.permission_col') %>">
                <%= total_perm > 0 ? "#{total_perm} min" : "—" %>
              </td>
              <td data-label="<%= t('attendance.status') %>">
                <span class="badge <%= attendance_status_badge_class(rec) %>">
                  <%= t("attendance.statuses.#{rec.status}") %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

</div>

<style>
  /* Salary breakdown card */
  .payslip-breakdown {
    background: var(--surface);
