<% content_for :title, t("auth.sign_in.page_title") %>

<div class="auth-wrapper">

  <div class="auth-logo">
    <img src="/icon.svg" alt="WorkPulse" class="auth-logo__icon">
    <div class="auth-logo__wordmark">
      <span class="work">Work</span><span class="pulse">Pulse</span>
    </div>
    <p class="auth-logo__tagline"><%= t("app_tagline") %></p>
  </div>

  <div class="auth-lang">
    <%= render "shared/language_switcher", variant: :auth, url: set_locale_path %>
    <%= render "shared/theme_toggle", variant: :header %>
  </div>

  <div class="auth-card">
    <h1 class="auth-card__title"><%= t("auth.sign_in.title") %></h1>
    <p class="auth-card__subtitle"><%= t("auth.sign_in.subtitle") %></p>

    <%= render "users/shared/error_messages", resource: resource %>

    <%= form_for(resource, as: resource_name, url: user_session_path) do |f| %>

      <div class="form-group">
        <%= f.label :login, t("auth.fields.login"), class: "form-label" %>
        <%= f.text_field :login,
              autofocus: true,
              autocomplete: "username",
              class: "form-control",
              placeholder: t("auth.fields.login_placeholder") %>
      </div>

      <div class="form-group">
        <%= f.label :password, t("auth.fields.password"), class: "form-label" %>
        <%= f.password_field :password,
              autocomplete: "current-password",
              class: "form-control",
              placeholder: t("auth.fields.password_placeholder") %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="form-group">
          <label class="form-check">
            <%= f.check_box :remember_me %>
            <span class="form-check-label"><%= t("auth.fields.remember_me") %></span>
          </label>
        </div>
      <% end %>

      <%= f.submit t("auth.sign_in.submit"), class: "btn btn-primary btn-lg btn-block" %>

    <% end %>

    <div class="auth-links">
      <%= render "users/shared/links" %>
    </div>
  </div>

</div>
