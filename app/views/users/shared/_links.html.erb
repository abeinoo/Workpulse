<%- if controller_name != 'sessions' && respond_to?("new_#{resource_name}_session_path") %>
  <%= link_to t("auth.links.sign_in"), send("new_#{resource_name}_session_path") %>
<% end %>

<%- if devise_mapping.registerable? && controller_name != 'registrations' && respond_to?("new_#{resource_name}_registration_path") %>
  <%= link_to t("auth.links.create_account"), send("new_#{resource_name}_registration_path") %>
<% end %>

<%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' && respond_to?("new_#{resource_name}_password_path") %>
  <%= link_to t("auth.links.forgot_password"), new_password_path(resource_name) %>
<% end %>

<%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
  <%= link_to t("auth.links.resend_confirmation"), new_confirmation_path(resource_name) %>
<% end %>

<%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
  <%= link_to t("auth.links.resend_unlock"), new_unlock_path(resource_name) %>
<% end %>
