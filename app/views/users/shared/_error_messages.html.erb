<% if resource.errors.any? %>
  <div class="form-error" data-turbo-temporary>
    <p class="form-error__title">
      <%= t("flash.errors_#{resource.errors.count == 1 ? 'one' : 'other'}", count: resource.errors.count) %>
    </p>
    <ul>
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
