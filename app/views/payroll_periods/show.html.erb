<div class="admin-page has-sticky-actions">

  <div class="page-header">
    <div>
      <%= link_to t("payroll.show.back"), payroll_periods_path, class: "back-link" %>
      <h1 class="page-title"><%= @period.period_label %></h1>
      <p class="page-subtitle"><%= t("payroll.show.company_wide") %></p>
    </div>
    <div class="page-header__actions">
      <span class="badge <%= period_status_badge_class(@period) %>">
        <%= t("payroll.statuses.#{@period.status}") %>
      </span>

      <% if @total_pending > 0 %>
        <span class="badge badge-warning"><%= t("payroll.show.pending_count", count: @total_pending) %></span>
      <% end %>

      <%# Branch review complete badge (header only — no action needed) %>
      <% if @branch_reviews_for_manager&.any? && @period.under_review? && @branch_reviews_for_manager.all?(&:completed?) %>
        <span class="badge badge-success"><%= t("payroll.show.review_complete_badge") %></span>
      <% end %>
    </div>
  </div>

  <%# Sticky action bar (fixed on mobile, inline-row on desktop) %>
  <div class="page-actions page-actions--sticky">
    <%# Submit for review (payroll manager / owner, draft only) %>
    <% if policy(@period).submit_for_review? && @period.draft? %>
      <%= button_to t("payroll.submit_for_review"),
            submit_for_review_payroll_period_path(@period),
            method: :patch,
            class: "btn btn-secondary",
            data: { turbo_confirm: t("payroll.confirm.submit_for_review") } %>
    <% end %>

    <%# Branch manager: complete their branch review(s) %>
    <% if @branch_reviews_for_manager&.any? && @period.under_review? && !@branch_reviews_for_manager.all?(&:completed?) %>
      <%= button_to t("payroll.complete_branch_review"),
            complete_branch_review_payroll_period_path(@period),
            method: :patch,
            class: "btn btn-primary",
            data: { turbo_confirm: t("payroll.confirm.complete_branch_review") } %>
    <% end %>

    <%# Regenerate (owner only, draft only) %>
    <% if policy(@period).regenerate? && @period.draft? %>
      <%= button_to t("payroll.regenerate"),
            regenerate_payroll_period_path(@period),
            method: :patch,
            class: "btn btn-secondary btn-sm",
            data: { turbo_confirm: t("payroll.confirm.regenerate") } %>
    <% end %>

    <%# Finalize (owner / finalize_payroll role, after reviews complete) %>
    <% if policy(@period).finalize? && (@period.branch_review_completed? || @period.under_review?) %>
      <%= button_to t("payroll.finalize"),
            finalize_payroll_period_path(@period),
            method: :patch,
            class: "btn btn-accent",
            data: { turbo_confirm: @period.under_review? ? t("payroll.confirm.finalize_under_review") : t("payroll.confirm.finalize") } %>
    <% end %>

    <%# Mark as Paid (owner only, finalized only) %>
    <% if policy(@period).mark_paid? && @period.finalized? %>
      <%= button_to t("payroll.mark_paid"),
            mark_paid_payroll_period_path(@period),
            method: :patch,
            class: "btn btn-primary",
            data: { turbo_confirm: t("payroll.confirm.mark_paid") } %>
    <% end %>

    <%# Delete (owner only, draft only) %>
    <% if policy(@period).destroy? %>
      <%= button_to t("payroll.delete"),
            payroll_period_path(@period),
            method: :delete,
            class: "btn btn-danger btn-sm",
            data: { turbo_confirm: t("payroll.confirm.delete") } %>
    <% end %>
  </div>

  <%# Branch review status notice for branch managers (their branches only) %>
  <% if @branch_reviews_for_manager&.any? %>
    <% all_complete = @branch_reviews_for_manager.all?(&:completed?) %>
    <div class="alert <%= all_complete ? 'alert-success' : 'alert-warning' %>">
      <% if @branch_reviews_for_manager.size == 1 %>
        <%= all_complete ? t("payroll.show.area_all_reviewed") : t("payroll.show.branch_review_notice") %>
      <% else %>
        <div class="branch-review-list">
          <% @branch_reviews_for_manager.each do |br| %>
            <div class="branch-review-row">
              <span><%= br.branch.name %></span>
              <span class="badge <%= br.completed? ? 'badge-success' : 'badge-warning' %>">
                <%= t("payroll.branch_review_statuses.#{br.status}") %>
              </span>
            </div>
          <% end %>
        </div>
        <% unless all_complete %>
          <p class="mt-2 text-sm"><%= t("payroll.show.branch_review_notice") %></p>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%# Full branch review progress table (owner only) %>
  <% if current_user.owner? && @all_branch_reviews&.any? %>
    <div class="section-card">
      <h3 class="section-title"><%= t("payroll.show.branch_review_progress") %></h3>
      <div class="table-wrap table-wrap--cards">
        <table>
          <thead>
            <tr>
              <th><%= t("payroll.branch") %></th>
              <th><%= t("payroll.show.reviewer") %></th>
              <th><%= t("payroll.status") %></th>
              <th><%= t("payroll.show.completed") %></th>
              <th><%= t("payroll.show.notes") %></th>
            </tr>
          </thead>
          <tbody>
            <% @all_branch_reviews.each do |br| %>
              <tr>
                <td><%= br.branch.name %></td>
                <td><%= br.reviewer.full_name %></td>
                <td>
                  <span class="badge <%= br.completed? ? 'badge-success' : 'badge-warning' %>">
                    <%= t("payroll.branch_review_statuses.#{br.status}") %>
                  </span>
                </td>
                <td class="td-secondary"><%= br.completed_at&.strftime("%b %d, %Y %H:%M") || "—" %></td>
                <td class="td-secondary"><%= br.notes.presence || "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <%# Payroll entries table %>
  <div class="table-wrap table-wrap--cards">
    <table>
      <thead>
        <tr>
          <th><%= t("payroll.employee") %></th>
          <th class="text-right"><%= t("payroll.show.days_col") %></th>
          <th class="text-right"><%= t("payroll.base_salary") %></th>
          <th class="text-right"><%= t("payroll.deductions") %></th>
          <th class="text-right"><%= t("payroll.entries.net") %></th>
          <th><%= t("payroll.show.review_col") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @entries.each do |entry| %>
          <tr>
            <td><%= entry.user.full_name %></td>
            <td class="text-right td-secondary">
              <% if entry.days_worked < entry.working_days %>
                <span class="text-warning"><%= entry.days_worked %></span><span class="td-secondary"> / <%= entry.working_days %></span>
              <% else %>
                <span class="td-secondary"><%= entry.days_worked %> / <%= entry.working_days %></span>
              <% end %>
            </td>
            <td class="text-right td-secondary"><%= format_currency(entry.base_salary) %></td>
            <td class="text-right <%= entry.total_deductions > 0 ? 'text-danger' : 'td-secondary' %>"><%= format_currency(entry.total_deductions) %></td>
            <td class="text-right"><strong><%= format_currency(entry.net_salary) %></strong></td>
            <td>
              <% pending = @pending_counts[entry.id] %>
              <% if pending && pending > 0 %>
                <span class="badge badge-warning"><%= t("payroll.show.pending_badge", count: pending) %></span>
              <% else %>
                <span class="badge badge-success"><%= t("payroll.show.reviewed_badge") %></span>
              <% end %>
            </td>
            <td class="td-actions">
              <%= link_to t("payroll.view"), payroll_period_payroll_entry_path(@period, entry), class: "link-muted" %>
            </td>
          </tr>
        <% end %>
        <% if @entries.empty? %>
          <tr><td colspan="7" class="td-empty"><%= t("payroll.show.entries_empty") %></td></tr>
        <% end %>
      </tbody>
      <% unless @entries.empty? %>
        <tfoot>
          <tr class="totals-row">
            <td colspan="2"><strong><%= t("payroll.show.totals_label") %></strong></td>
            <td class="text-right td-secondary"><strong><%= format_currency(@entries.sum(&:base_salary)) %></strong></td>
            <td class="text-right text-danger"><strong><%= format_currency(@entries.sum(&:total_deductions)) %></strong></td>
            <td class="text-right"><strong><%= format_currency(@entries.sum(&:net_salary)) %></strong></td>
            <td colspan="2"></td>
          </tr>
        </tfoot>
      <% end %>
    </table>
  </div>

  <%# Audit log (owner only) %>
  <% if current_user.owner? && @audit_logs&.any? %>
    <div class="section-card section-card--top">
      <h3 class="section-title"><%= t("payroll.show.audit_history") %></h3>
      <div class="table-wrap table-wrap--cards">
        <table>
          <thead>
            <tr>
              <th><%= t("payroll.actions") %></th>
              <th><%= t("payroll.show.actor") %></th>
              <th><%= t("payroll.show.from_col") %></th>
              <th><%= t("payroll.show.to_col") %></th>
              <th><%= t("payroll.show.date_col") %></th>
            </tr>
          </thead>
          <tbody>
            <% @audit_logs.each do |log| %>
              <tr>
                <td><%= t("payroll.audit_log_action_types.#{log.action_type}") %></td>
                <td><%= log.actor.full_name %></td>
                <td class="td-secondary"><%= log.from_status ? t("payroll.statuses.#{log.from_status}") : "—" %></td>
                <td class="td-secondary"><%= log.to_status ? t("payroll.statuses.#{log.to_status}") : "—" %></td>
                <td class="td-secondary"><%= log.created_at.strftime("%b %d, %Y %H:%M") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

</div>
