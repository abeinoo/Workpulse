<div class="admin-page has-sticky-actions">

  <div class="page-header">
    <div>
      <%= link_to t("payroll.show.back"), payroll_periods_path, class: "back-link" %>
      <h1 class="page-title"><%= @period.period_label %></h1>
      <p class="page-subtitle"><%= t("payroll.show.company_wide") %></p>
    </div>
    <div class="page-header__actions">
      <span class="badge <%= period_status_badge_class(@period) %>">
        <%= t("payroll.statuses.#{@period.status}") %>
      </span>
      <% if @total_pending > 0 %>
        <span class="badge badge-warning"><%= t("payroll.show.pending_count", count: @total_pending) %></span>
      <% end %>
      <% if @branch_reviews_for_manager&.any? && @period.under_review? %>
        <% if @branch_reviews_for_manager.all?(&:completed?) %>
          <span class="badge badge-success"><%= t("payroll.show.review_complete_badge") %></span>
        <% elsif @branch_reviews_for_manager.any?(&:changes_requested?) %>
          <span class="badge badge-danger"><%= t("payroll.show.changes_requested_badge") %></span>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# ── Period metadata strip (generated by / last regenerated) ────────────── %>
  <% if @period.generated_by %>
    <div class="payroll-meta-strip">
      <div class="payroll-meta-strip__item">
        <span><%= t("payroll.show.generated_by") %>:</span>
        <strong><%= @period.generated_by.full_name %></strong>
      </div>
      <% if @last_regenerate %>
        <span class="payroll-meta-strip__dot">&middot;</span>
        <div class="payroll-meta-strip__item">
          <span><%= t("payroll.show.last_regenerated") %>:</span>
          <strong><%= @last_regenerate.actor.full_name %></strong>
          <span>&middot; <%= local_datetime(@last_regenerate.created_at) %></span>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# ── Action bar (sticky on mobile, inline on desktop) ───────────────────── %>
  <div class="page-actions page-actions--sticky">

    <%# ── Primary workflow: one action per status ────────────────────────── %>
    <% if policy(@period).submit_for_review? && @period.draft? %>
      <%= button_to t("payroll.submit_for_review"),
            submit_for_review_payroll_period_path(@period),
            method: :patch,
            class: "btn btn-secondary",
            data: { turbo_confirm: t("payroll.confirm.submit_for_review") } %>
    <% end %>

    <%# Branch manager: approve button (shown when manager has pending reviews) %>
    <% if @branch_reviews_for_manager&.any? && @period.under_review? &&
          @branch_reviews_for_manager.any?(&:pending?) %>
      <%= button_to t("payroll.approve_branch_review"),
            complete_branch_review_payroll_period_path(@period),
            method: :patch,
            class: "btn btn-primary",
            data: { turbo_confirm: t("payroll.confirm.complete_branch_review") } %>
    <% end %>

    <%# Accounting: resubmit after addressing changes requested by branch managers %>
    <% if policy(@period).resubmit_for_review? && @has_changes_requested_reviews %>
      <%= button_to t("payroll.resubmit_for_review"),
            resubmit_for_review_payroll_period_path(@period),
            method: :patch,
            class: "btn btn-secondary",
            data: { turbo_confirm: t("payroll.confirm.resubmit_for_review") } %>
    <% end %>

    <% if policy(@period).approve_all_pending? && @total_pending > 0 %>
      <%= button_to t("payroll.show.approve_all"),
            approve_all_pending_payroll_period_path(@period),
            method: :patch,
            class: "btn btn-accent btn-sm",
            data: { turbo_confirm: t("payroll.show.approve_all_confirm", count: @total_pending) } %>
    <% end %>

    <% if policy(@period).finalize? && (@period.branch_review_completed? || @period.under_review?) %>
      <%= button_to t("payroll.finalize"),
            finalize_payroll_period_path(@period),
            method: :patch,
            class: "btn btn-accent",
            data: { turbo_confirm: @period.under_review? ? t("payroll.confirm.finalize_under_review") : t("payroll.confirm.finalize") } %>
    <% end %>

    <% if policy(@period).mark_paid? && @period.finalized? %>
      <%= button_to t("payroll.mark_paid"),
            mark_paid_payroll_period_path(@period),
            method: :patch,
            class: "btn btn-success",
            data: { turbo_confirm: t("payroll.confirm.mark_paid") } %>
    <% end %>

    <%# ── Export (print) ────────────────────────────────────────────────── %>
    <% if current_user.can?(:view_payroll) && @entries.any? %>
      <div class="page-actions__sep"></div>
      <button onclick="window.print()" class="btn btn-secondary btn-sm" type="button">
        <%= t("payroll.show.export_print") %>
      </button>
    <% end %>

    <%# ── Bank transfer CSV (finalised/paid periods only) ────────────────── %>
    <% if policy(@period).export_payroll_bank_csv? %>
      <%= link_to t("payroll.bank_transfer.export"),
            export_bank_transfer_payroll_period_path(@period),
            class: "btn btn-primary btn-sm" %>
    <% end %>

    <%# ── Secondary: regenerate (only on draft periods) ─────────────────── %>
    <% if current_user.can?(:regenerate_payroll) %>
      <div class="page-actions__sep"></div>
      <% if policy(@period).regenerate? %>
        <%= button_to regenerate_payroll_period_path(@period),
              method: :patch,
              class: "btn btn-warning btn-sm",
              data: { turbo_confirm: t("payroll.confirm.regenerate") } do %>
          <svg class="btn-lock-icon" viewBox="0 0 20 20" fill="currentColor" width="13" height="13"><path d="M4.5 10.5a1 1 0 011-1h9a1 1 0 011 1v5a1 1 0 01-1 1h-9a1 1 0 01-1-1v-5zm4.5-5a3 3 0 116 0v1H9V5.5z"/></svg>
          <%= t("payroll.regenerate") %>
        <% end %>
      <% else %>
        <% lock_hint = @period.paid? ? t("payroll.show.regenerate_locked_paid") : t("payroll.show.regenerate_locked") %>
        <button class="btn btn-warning btn-sm" disabled title="<%= lock_hint %>">
          <svg class="btn-lock-icon" viewBox="0 0 20 20" fill="currentColor" width="13" height="13" aria-hidden="true"><path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd"/></svg>
          <%= t("payroll.regenerate") %>
        </button>
        <span class="page-actions__lock-hint"><%= lock_hint %></span>
      <% end %>
    <% end %>

    <%# ── Reopen: roll the period back one step (requires a reason) ─────── %>
    <% if policy(@period).reopen? %>
      <div class="page-actions__sep"></div>
      <%= form_with url: reopen_payroll_period_path(@period), method: :patch, local: true, class: "reopen-form" do |f| %>
        <%= f.text_field :reason,
              required: true,
              placeholder: t("payroll.show.reopen_reason_placeholder"),
              class: "form-control form-control-sm reopen-form__reason" %>
        <%= f.submit t("payroll.reopen"),
              class: "btn btn-warning btn-sm",
              data: { turbo_confirm: @period.paid? ?
                                       t("payroll.confirm.reopen_from_paid") :
                                       t("payroll.confirm.reopen_from_finalized") } %>
      <% end %>
    <% end %>

    <%# ── Destructive: delete ────────────────────────────────────────────── %>
    <% if policy(@period).destroy? %>
      <div class="page-actions__sep page-actions__sep--danger"></div>
      <%= button_to t("payroll.delete"),
            payroll_period_path(@period),
            method: :delete,
            class: "btn btn-danger btn-sm",
            data: { turbo_confirm: t("payroll.confirm.delete") } %>
    <% end %>

  </div>

  <%# ── Bank transfer export summary (finalised/paid periods only) ────────── %>
  <% if @bank_transfer_summary %>
    <div class="alert alert-info bank-transfer-banner">
      <div class="bank-transfer-banner__title"><%= t("payroll.bank_transfer.banner_title") %></div>
      <div class="bank-transfer-banner__stats">
        <span>
          <strong><%= @bank_transfer_summary[:total_employees] %></strong>
          <%= t("payroll.bank_transfer.total_employees") %>
        </span>
        <span>
          <strong><%= format_currency(@bank_transfer_summary[:total_amount]) %></strong>
          <%= t("payroll.bank_transfer.total_amount") %>
        </span>
        <span class="<%= 'text-danger' if @bank_transfer_summary[:missing_national_id].positive? %>">
          <strong><%= @bank_transfer_summary[:missing_national_id] %></strong>
          <%= t("payroll.bank_transfer.missing_national_id") %>
        </span>
      </div>
      <%= link_to t("payroll.bank_transfer.export"),
            export_bank_transfer_payroll_period_path(@period),
            class: "btn btn-primary btn-sm" %>
    </div>
  <% end %>

  <%# ── Branch review panel (branch/area managers only — isolated to own branches) ── %>
  <% if @branch_reviews_for_manager&.any? %>
    <% all_complete        = @branch_reviews_for_manager.all?(&:completed?) %>
    <% any_changes_req     = @branch_reviews_for_manager.any?(&:changes_requested?) %>
    <% any_pending         = @branch_reviews_for_manager.any?(&:pending?) %>
    <% alert_class = all_complete ? 'alert-success' : (any_changes_req ? 'alert-warning' : 'alert-info') %>
    <div class="alert <%= alert_class %>">
      <% if @branch_reviews_for_manager.size == 1 %>
        <% br = @branch_reviews_for_manager.first %>
        <% if br.completed? %>
          <p><%= t("payroll.show.area_all_reviewed") %></p>
        <% elsif br.changes_requested? %>
          <p><strong><%= t("payroll.show.changes_requested_notice") %></strong></p>
          <% if br.notes.present? %>
            <p class="mt-1 text-sm"><em><%= br.notes %></em></p>
          <% end %>
          <p class="mt-1 text-sm"><%= t("payroll.show.changes_requested_waiting") %></p>
        <% else %>
          <p><%= t("payroll.show.branch_review_notice") %></p>
        <% end %>
      <% else %>
        <div class="branch-review-list">
          <% @branch_reviews_for_manager.each do |br| %>
            <div class="branch-review-row">
              <span><%= br.branch.name %></span>
              <span class="badge <%= br.completed? ? 'badge-success' : (br.changes_requested? ? 'badge-warning' : 'badge-neutral') %>">
                <%= t("payroll.branch_review_statuses.#{br.status}") %>
              </span>
              <% if br.changes_requested? && br.notes.present? %>
                <span class="td-secondary text-sm"><em><%= br.notes %></em></span>
              <% end %>
            </div>
          <% end %>
        </div>
        <% if any_pending %>
          <p class="mt-2 text-sm"><%= t("payroll.show.branch_review_notice") %></p>
        <% elsif any_changes_req %>
          <p class="mt-2 text-sm"><%= t("payroll.show.changes_requested_waiting") %></p>
        <% end %>
      <% end %>
    </div>

    <%# Request Changes form — shown only when there are pending reviews %>
    <% if @period.under_review? && any_pending && policy(@period).request_changes? %>
      <div class="section-card section-card--compact">
        <h4 class="section-title section-title--sm"><%= t("payroll.show.request_changes_title") %></h4>
        <%= form_with url: request_changes_payroll_period_path(@period), method: :patch, local: true do |f| %>
          <%= f.text_area :comment,
                required: true,
                rows: 3,
                placeholder: t("payroll.show.request_changes_placeholder"),
                class: "form-control" %>
          <%= f.submit t("payroll.request_changes"),
                class: "btn btn-warning btn-sm mt-2",
                data: { turbo_confirm: t("payroll.confirm.request_changes") } %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%# ── Payroll overview (management only) ────────────────────────────────── %>
  <% if @overview && @entries.any? %>
    <div class="payroll-overview">
      <div class="payroll-overview__label"><%= t("payroll.show.overview_title") %></div>
      <div class="payroll-overview__metrics">
        <div class="payroll-overview__metric">
          <span class="payroll-overview__metric-label"><%= t("payroll.show.overview_employees") %></span>
          <span class="payroll-overview__metric-value"><%= @overview[:total_employees] %></span>
        </div>
        <div class="payroll-overview__metric">
          <span class="payroll-overview__metric-label"><%= t("payroll.show.overview_base") %></span>
          <span class="payroll-overview__metric-value"><%= format_currency(@overview[:total_base], precision: 0) %></span>
        </div>
        <div class="payroll-overview__metric">
          <span class="payroll-overview__metric-label"><%= t("payroll.show.overview_overtime") %></span>
          <span class="payroll-overview__metric-value <%= @overview[:total_overtime] > 0 ? 'payroll-overview__metric-value--success' : '' %>">
            <%= @overview[:total_overtime] > 0 ? format_currency(@overview[:total_overtime], precision: 0) : "—" %>
          </span>
        </div>
        <div class="payroll-overview__metric">
          <span class="payroll-overview__metric-label"><%= t("payroll.show.overview_bonuses") %></span>
          <span class="payroll-overview__metric-value <%= @overview[:total_bonuses] > 0 ? 'payroll-overview__metric-value--success' : '' %>">
            <%= @overview[:total_bonuses] > 0 ? format_currency(@overview[:total_bonuses], precision: 0) : "—" %>
          </span>
        </div>
        <div class="payroll-overview__metric">
          <span class="payroll-overview__metric-label"><%= t("payroll.show.overview_deductions") %></span>
          <span class="payroll-overview__metric-value <%= @overview[:total_deductions] > 0 ? 'payroll-overview__metric-value--danger' : '' %>">
            <%= @overview[:total_deductions] > 0 ? "− #{format_currency(@overview[:total_deductions], precision: 0)}" : "—" %>
          </span>
        </div>
        <div class="payroll-overview__metric">
          <span class="payroll-overview__metric-label"><%= t("payroll.show.overview_advances") %></span>
          <span class="payroll-overview__metric-value <%= @overview[:total_advances] > 0 ? 'payroll-overview__metric-value--danger' : '' %>">
            <%= @overview[:total_advances] > 0 ? "− #{format_currency(@overview[:total_advances], precision: 0)}" : "—" %>
          </span>
        </div>
      </div>
      <div class="payroll-overview__divider"></div>
      <div class="payroll-overview__net-row">
        <span class="payroll-overview__net-label"><%= t("payroll.show.overview_net") %></span>
        <span class="payroll-overview__net-value"><%= format_currency(@overview[:total_net], precision: 0) %></span>
      </div>
    </div>
  <% end %>

  <%# ── Anomaly alerts (AnomalyDetector) ──────────────────────────────────── %>
  <% if @anomalies&.any? %>
    <div class="payroll-alerts">
      <div class="payroll-alerts__header">
        <svg viewBox="0 0 20 20" fill="currentColor" style="color:var(--warning);width:16px;height:16px;flex-shrink:0;" aria-hidden="true">
          <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
        </svg>
        <span class="payroll-alerts__title"><%= t("payroll.show.alerts_title") %></span>
      </div>
      <% @anomalies.each do |anomaly| %>
        <div class="payroll-alert-item payroll-alert-item--<%= anomaly.severity %>">
          <span class="payroll-alert-item__icon">
            <%= anomaly.severity == :danger ? "⛔" : (anomaly.severity == :warning ? "⚠️" : "ℹ️") %>
          </span>
          <div class="payroll-alert-item__body">
            <div class="payroll-alert-item__msg"><%= anomaly.message %></div>
            <% if anomaly.affected.any? %>
              <div class="payroll-alert-item__names">
                <%= anomaly.affected.first(3).map { |e| e.user.full_name }.join(", ") %>
                <% if anomaly.affected.size > 3 %>…<% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# ── Insights (management only) ───────────────────────────────────────── %>
  <% if @insights && @entries.any? %>
    <%= render "insights" %>
    <%= render "comparison" %>
  <% end %>

  <%# ── Branch review progress (period overseers — accounting/area/admin) ───── %>
  <% if (current_user.can?(:finalize_payroll) || current_user.can?(:pay_payroll)) && @all_branch_reviews&.any? %>
    <%# Summary counts for at-a-glance status %>
    <% rev_counts = @all_branch_reviews.group_by(&:status) %>
    <div class="section-card">
      <div class="section-card__header">
        <h3 class="section-title"><%= t("payroll.show.branch_review_progress") %></h3>
        <div class="review-progress-summary">
          <% if rev_counts["completed"]&.any? %>
            <span class="badge badge-success">
              <%= t("payroll.show.review_summary_approved", count: rev_counts["completed"].size) %>
            </span>
          <% end %>
          <% if rev_counts["changes_requested"]&.any? %>
            <span class="badge badge-danger">
              <%= t("payroll.show.review_summary_changes", count: rev_counts["changes_requested"].size) %>
            </span>
          <% end %>
          <% if rev_counts["pending"]&.any? %>
            <span class="badge badge-neutral">
              <%= t("payroll.show.review_summary_pending", count: rev_counts["pending"].size) %>
            </span>
          <% end %>
        </div>
      </div>
      <div class="table-wrap table-wrap--cards">
        <table>
          <thead>
            <tr>
              <th><%= t("payroll.branch") %></th>
              <th><%= t("payroll.show.reviewer") %></th>
              <th><%= t("payroll.status") %></th>
              <th><%= t("payroll.show.reviewed_at") %></th>
              <th><%= t("payroll.show.notes") %></th>
            </tr>
          </thead>
          <tbody>
            <% @all_branch_reviews.each do |br| %>
              <% badge_class = case br.status
                               when "completed"         then "badge-success"
                               when "changes_requested" then "badge-danger"
                               else                          "badge-neutral"
                               end %>
              <tr class="<%= 'review-row--changes' if br.changes_requested? %>">
                <td data-label="<%= t('payroll.branch') %>"><%= br.branch.name %></td>
                <td data-label="<%= t('payroll.show.reviewer') %>">
                  <%= br.reviewer&.full_name || "—" %>
                </td>
                <td data-label="<%= t('payroll.status') %>">
                  <span class="badge <%= badge_class %>">
                    <%= t("payroll.branch_review_statuses.#{br.status}") %>
                  </span>
                </td>
                <td class="td-secondary" data-label="<%= t('payroll.show.reviewed_at') %>">
                  <%= br.completed_at ? local_datetime(br.completed_at) : "—" %>
                </td>
                <td class="td-secondary" data-label="<%= t('payroll.show.notes') %>">
                  <% if br.changes_requested? && br.notes.present? %>
                    <span class="text-danger"><%= br.notes %></span>
                  <% else %>
                    <%= br.notes.presence || "—" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <%# ── Employee payroll entries table ─────────────────────────────────────── %>
  <% can_bulk_ot    = current_user.can?(:manage_payroll_overrides) && @period.reviewable? %>
  <% can_bulk_waive = current_user.can?(:manage_payroll_deduction_waivers) && @period.reviewable? %>
  <% can_bulk       = can_bulk_ot || can_bulk_waive %>
  <div data-controller="payroll-overtime-bulk">
  <div class="table-wrap table-wrap--cards">
    <table>
      <thead>
        <tr>
          <% if can_bulk %>
            <th class="ot-bulk-cell">
              <input type="checkbox" class="ot-bulk-all"
                     data-action="change->payroll-overtime-bulk#toggleAll"
                     aria-label="<%= t('payroll.overtime_override.select_all') %>">
            </th>
          <% end %>
          <th><%= t("payroll.employee") %></th>
          <% if current_user.can?(:view_payroll) %>
            <th><%= t("payroll.show.branch_col") %></th>
          <% end %>
          <th class="text-right"><%= t("payroll.show.days_col") %></th>
          <th class="text-right"><%= t("payroll.base_salary") %></th>
          <th class="text-right"><%= t("payroll.show.overtime_col") %></th>
          <th class="text-right"><%= t("payroll.deductions") %></th>
          <th class="text-right"><%= t("payroll.show.bonuses_col") %></th>
          <th class="text-right"><%= t("payroll.entries.net") %></th>
          <th><%= t("payroll.show.review_col") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <%# Pre-compute warning sets once to avoid per-row N+1 %>
        <% if @insights %>
          <% abnormal_ot_entry_ids = @insights.abnormal_overtime_entries.map(&:id).to_set %>
          <% incomplete_checkout_user_ids = @insights.incomplete_checkout_user_ids %>
        <% end %>
        <% @entries.each do |entry| %>
          <%
            days_pct = entry.working_days > 0 ? (entry.days_worked.to_f / entry.working_days * 100).round : 0
            days_color = days_pct >= 90 ? "" : (days_pct >= 60 ? "payroll-days-cell__fill--warn" : "payroll-days-cell__fill--danger")
            pending = @pending_counts[entry.id].to_i
            branch_name = @user_branch_names&.dig(entry.user_id)
            if @insights
              badge_zero_days   = entry.days_worked.to_i.zero?
              badge_abnormal_ot = abnormal_ot_entry_ids.include?(entry.id)
              badge_high_ded    = entry.base_salary > 0 && entry.total_deductions > entry.base_salary * 0.4
              badge_no_checkout = incomplete_checkout_user_ids.include?(entry.user_id)
            end
          %>
          <tr>
            <% if can_bulk %>
              <td class="ot-bulk-cell" data-label="">
                <input type="checkbox" class="ot-bulk-row" value="<%= entry.id %>"
                       data-action="change->payroll-overtime-bulk#rowChanged"
                       aria-label="<%= entry.user.full_name %>">
              </td>
            <% end %>
            <td data-label="<%= t('payroll.employee') %>">
              <div class="employee-cell">
                <%= user_avatar_tag(entry.user, size: :thumb) %>
                <div class="employee-cell__info">
                  <div class="employee-cell__name"><%= entry.user.full_name %></div>
                  <% if entry.user.employee_code.present? %>
                    <div class="employee-cell__sub"><%= entry.user.employee_code %></div>
                  <% end %>
                  <% if @insights && (badge_zero_days || badge_abnormal_ot || badge_high_ded || badge_no_checkout) %>
                    <div class="payroll-entry-badges">
                      <% if badge_zero_days %>
                        <span class="payroll-entry-badge payroll-entry-badge--danger"><%= t("payroll.show.badge_zero_days") %></span>
                      <% end %>
                      <% if badge_abnormal_ot %>
                        <span class="payroll-entry-badge payroll-entry-badge--warning"><%= t("payroll.show.badge_abnormal_ot") %></span>
                      <% end %>
                      <% if badge_high_ded %>
                        <span class="payroll-entry-badge payroll-entry-badge--warning"><%= t("payroll.show.badge_high_ded") %></span>
                      <% end %>
                      <% if badge_no_checkout %>
                        <span class="payroll-entry-badge payroll-entry-badge--neutral"><%= t("payroll.show.badge_no_checkout") %></span>
                      <% end %>
                    </div>
                  <% end %>
                  <% if entry.overtime_overridden? %>
                    <div class="payroll-entry-badges"><%= overtime_override_badge(entry) %></div>
                  <% end %>
                </div>
              </div>
            </td>
            <% if current_user.can?(:view_payroll) %>
              <td class="td-secondary" data-label="<%= t('payroll.show.branch_col') %>">
                <%= branch_name.presence || "—" %>
              </td>
            <% end %>
            <td class="text-right" data-label="<%= t('payroll.show.days_col') %>">
              <div class="payroll-days-cell">
                <span class="payroll-days-cell__ratio <%= entry.days_worked < entry.working_days ? 'text-warning' : 'td-secondary' %>">
                  <%= entry.days_worked %> / <%= entry.working_days %>
                </span>
                <div class="payroll-days-cell__bar">
                  <div class="payroll-days-cell__fill <%= days_color %>" style="width: <%= days_pct %>%;"></div>
                </div>
              </div>
            </td>
            <td class="text-right td-secondary" data-label="<%= t('payroll.base_salary') %>">
              <%= format_currency(entry.base_salary, precision: 0) %>
            </td>
            <td class="text-right <%= entry.total_overtime > 0 ? 'text-success' : 'td-secondary' %>"
                data-label="<%= t('payroll.show.overtime_col') %>">
              <%= entry.total_overtime > 0 ? "+ #{format_currency(entry.total_overtime, precision: 0)}" : "—" %>
            </td>
            <td class="text-right <%= entry.total_deductions > 0 ? 'text-danger' : 'td-secondary' %>"
                data-label="<%= t('payroll.deductions') %>">
              <%= entry.total_deductions > 0 ? "− #{format_currency(entry.total_deductions, precision: 0)}" : "—" %>
            </td>
            <td class="text-right <%= entry.total_bonuses > 0 ? 'text-success' : 'td-secondary' %>"
                data-label="<%= t('payroll.show.bonuses_col') %>">
              <%= entry.total_bonuses > 0 ? "+ #{format_currency(entry.total_bonuses, precision: 0)}" : "—" %>
            </td>
            <td class="text-right" data-label="<%= t('payroll.entries.net') %>">
              <strong class="<%= entry.net_salary < 0 ? 'text-danger' : '' %>">
                <%= format_currency(entry.net_salary, precision: 0) %>
              </strong>
            </td>
            <td data-label="<%= t('payroll.show.review_col') %>">
              <% if pending > 0 %>
                <span class="badge badge-warning"><%= t("payroll.show.pending_badge", count: pending) %></span>
              <% else %>
                <span class="badge badge-success"><%= t("payroll.show.reviewed_badge") %></span>
              <% end %>
            </td>
            <td class="td-actions" data-label="">
              <%= link_to t("payroll.view"), payroll_period_payroll_entry_path(@period, entry), class: "link-muted" %>
            </td>
          </tr>
        <% end %>
        <% if @entries.empty? %>
          <tr>
            <td colspan="<%= (current_user.can?(:view_payroll) ? 10 : 9) + (can_bulk ? 1 : 0) %>" class="td-empty">
              <%= t("payroll.show.entries_empty") %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <%# Totals row is analytics — only renders when @overview was loaded %>
      <% if @overview && @entries.any? %>
        <tfoot>
          <tr class="totals-row">
            <td colspan="<%= (current_user.can?(:view_payroll) ? 3 : 2) + (can_bulk ? 1 : 0) %>">
              <strong><%= t("payroll.show.totals_label") %></strong>
            </td>
            <td class="text-right td-secondary">
              <strong><%= format_currency(@overview[:total_base], precision: 0) %></strong>
            </td>
            <td class="text-right text-success">
              <strong><%= @overview[:total_overtime] > 0 ? format_currency(@overview[:total_overtime], precision: 0) : "—" %></strong>
            </td>
            <td class="text-right text-danger">
              <strong><%= format_currency(@overview[:total_deductions], precision: 0) %></strong>
            </td>
            <td class="text-right text-success">
              <strong><%= @overview[:total_bonuses] > 0 ? format_currency(@overview[:total_bonuses], precision: 0) : "—" %></strong>
            </td>
            <td class="text-right">
              <strong><%= format_currency(@overview[:total_net], precision: 0) %></strong>
            </td>
            <td colspan="2"></td>
          </tr>
        </tfoot>
      <% end %>
    </table>
  </div>

  <% if can_bulk %>
    <%# Sticky bulk action bar — appears once entries are selected %>
    <div class="ot-bulk-bar" data-payroll-overtime-bulk-target="actionBar" style="display:none;">
      <span class="ot-bulk-bar__count">
        <strong data-payroll-overtime-bulk-target="countBadge">0</strong>
        <%= t("payroll.overtime_override.selected_suffix") %>
      </span>
      <% if can_bulk_ot %>
        <button type="button" class="btn btn-sm btn-warning"
                data-action="payroll-overtime-bulk#openModal">
          <%= t("payroll.overtime_override.bulk_btn") %>
        </button>
      <% end %>
      <% if can_bulk_waive %>
        <button type="button" class="btn btn-sm btn-secondary"
                data-action="payroll-overtime-bulk#openWaiverModal">
          <%= t("payroll.deduction_waiver.bulk_btn") %>
        </button>
      <% end %>
    </div>
  <% end %>

  <% if can_bulk_ot %>
    <%# Modal: choose mode + value + reason %>
    <div class="modal-overlay" data-payroll-overtime-bulk-target="modal" style="display:none;"
         data-action="click->payroll-overtime-bulk#overlayClick">
      <div class="modal-card">
        <h3 class="modal-card__title"><%= t("payroll.overtime_override.bulk_title") %></h3>
        <p class="modal-card__sub">
          <%= t("payroll.overtime_override.bulk_subtitle_html",
                 count: "<strong data-payroll-overtime-bulk-target='modalCount'>0</strong>").html_safe %>
        </p>
        <%= form_with url: adjust_overtime_payroll_period_path(@period), method: :patch do |f| %>
          <span data-payroll-overtime-bulk-target="ids"></span>
          <div class="form-group">
            <%= f.label :bulk_mode, t("payroll.overtime_override.mode_label"), class: "form-label" %>
            <%= f.select :bulk_mode,
                  [ [ t("payroll.overtime_override.bulk_zero"), "zero" ],
                    [ t("payroll.overtime_override.bulk_fixed_amount"), "fixed_amount" ],
                    [ t("payroll.overtime_override.bulk_fixed_minutes"), "fixed_minutes" ],
                    [ t("payroll.overtime_override.bulk_restore"), "restore" ] ],
                  {}, class: "form-control",
                  data: { action: "change->payroll-overtime-bulk#modeChanged" } %>
          </div>
          <div class="form-group" data-payroll-overtime-bulk-target="valueField" style="display:none;">
            <%= f.label :value, t("payroll.overtime_override.value_label"), class: "form-label" %>
            <%= f.number_field :value, step: "0.01", min: 0, class: "form-control",
                  data: { payroll_overtime_bulk_target: "value" } %>
          </div>
          <div class="form-group">
            <%= f.label :reason, t("payroll.overtime_override.reason_label"), class: "form-label" %>
            <%= f.text_area :reason, rows: 2, class: "form-control",
                  placeholder: t("payroll.overtime_override.reason_placeholder"),
                  data: { payroll_overtime_bulk_target: "reason" } %>
          </div>
          <div class="modal-card__actions">
            <button type="button" class="btn btn-secondary"
                    data-action="payroll-overtime-bulk#closeModal"><%= t("forms.cancel") %></button>
            <%= f.submit t("payroll.overtime_override.confirm"), class: "btn btn-warning" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if can_bulk_waive %>
    <%# Modal: waive or restore manual deductions for the selected employees %>
    <div class="modal-overlay" data-payroll-overtime-bulk-target="waiverModal" style="display:none;"
         data-action="click->payroll-overtime-bulk#waiverOverlayClick">
      <div class="modal-card">
        <h3 class="modal-card__title"><%= t("payroll.deduction_waiver.bulk_title") %></h3>
        <p class="modal-card__sub">
          <%= t("payroll.deduction_waiver.bulk_subtitle_html",
                 count: "<strong data-payroll-overtime-bulk-target='waiverModalCount'>0</strong>").html_safe %>
        </p>
        <%= form_with url: waive_deductions_payroll_period_path(@period), method: :patch do |f| %>
          <span data-payroll-overtime-bulk-target="waiverIds"></span>
          <div class="form-group">
            <%= f.label :waiver_action, t("payroll.deduction_waiver.bulk_action_label"), class: "form-label" %>
            <%= f.select :waiver_action,
                  [ [ t("payroll.deduction_waiver.bulk_waive"), "waive" ],
                    [ t("payroll.deduction_waiver.bulk_restore"), "restore" ] ],
                  {}, class: "form-control" %>
          </div>
          <div class="form-group">
            <%= f.label :reason, t("payroll.deduction_waiver.reason_label"), class: "form-label" %>
            <%= f.text_area :reason, rows: 2, class: "form-control", required: true,
                  placeholder: t("payroll.deduction_waiver.reason_placeholder") %>
          </div>
          <div class="modal-card__actions">
            <button type="button" class="btn btn-secondary"
                    data-action="payroll-overtime-bulk#closeWaiverModal"><%= t("forms.cancel") %></button>
            <%= f.submit t("payroll.deduction_waiver.confirm_waive"), class: "btn btn-warning" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
  </div>

  <%# ── Activity timeline (all management users) ───────────────────────────── %>
  <% if current_user.can?(:view_payroll_audit_log) && @audit_logs&.any? %>
    <%= render "activity_timeline" %>
  <% end %>

</div>
