<% content_for :title, "#{t('payroll.new.title')} — WorkPulse" %>

<div class="admin-page">

  <div class="page-header">
    <h1 class="page-title"><%= t("payroll.new.title") %></h1>
  </div>

  <%= form_with url: payroll_periods_path, method: :post, class: "form-card" do |f| %>

    <% if flash[:alert] %>
      <div class="form-error" data-turbo-temporary>
        <p class="form-error__title"><%= flash[:alert] %></p>
      </div>
    <% end %>

    <div class="form-grid">
      <div class="form-group">
        <%= label_tag "payroll_period[year]", t("payroll.new.year"), class: "form-label form-label--required" %>
        <%= number_field_tag "payroll_period[year]",
              Date.current.year,
              class: "form-control",
              min: 2020, max: 2099, step: 1 %>
      </div>

      <div class="form-group">
        <%= label_tag "payroll_period[month]", t("payroll.new.month"), class: "form-label form-label--required" %>
        <%= select_tag "payroll_period[month]",
              options_for_select(
                Date::MONTHNAMES.compact.each_with_index.map { |name, i| [name, i + 1] },
                Date.current.month
              ),
              class: "form-control" %>
      </div>
    </div>

    <p class="form-hint" style="margin-top: 0.5rem;">
      <%= t("payroll.new.company_hint") %>
    </p>

    <div class="form-actions">
      <%= submit_tag t("payroll.new.submit"), class: "btn btn-primary" %>
      <%= link_to t("forms.cancel"), payroll_periods_path, class: "btn btn-ghost" %>
    </div>

  <% end %>

</div>
