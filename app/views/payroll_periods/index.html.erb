<div class="admin-page">

  <div class="page-header">
    <h1 class="page-title"><%= t("nav.payroll") %></h1>
    <% if policy(PayrollPeriod).create? %>
      <%= link_to t("payroll.generate"), new_payroll_period_path, class: "btn btn-primary" %>
    <% end %>
  </div>

  <% unless current_user.management_access? %>

    <%# ── Employee view: one card per payroll period ─────────────────────── %>
    <% if @periods.empty? %>
      <div class="empty-state">
        <p class="empty-state__title"><%= t("payroll.index.no_records") %></p>
        <p class="empty-state__text"><%= t("payroll.index.empty_employee") %></p>
      </div>
    <% else %>
      <div class="payslip-list">
        <% @periods.each do |period| %>
          <% entry = @my_entries[period.id] %>
          <% next unless entry %>
          <%= link_to payroll_period_payroll_entry_path(period, entry), class: "payslip-card" do %>
            <div class="payslip-card__header">
              <div>
                <span class="payslip-card__month"><%= period.period_label %></span>
                <span class="badge <%= period.paid? ? 'badge-success' : 'badge-accent' %> ml-2">
                  <%= period.paid? ? t("payroll.statuses.paid") : t("payroll.statuses.finalized") %>
                </span>
              </div>
              <span class="payslip-card__arrow">›</span>
            </div>
            <div class="payslip-card__body">
              <div class="payslip-card__stat">
                <span class="payslip-card__stat-label"><%= t("payroll.index.base") %></span>
                <span class="payslip-card__stat-value"><%= format_currency(entry.base_salary, precision: 0) %></span>
              </div>
              <% if entry.total_deductions > 0 %>
                <div class="payslip-card__stat">
                  <span class="payslip-card__stat-label"><%= t("payroll.deductions") %></span>
                  <span class="payslip-card__stat-value" style="color: var(--danger);">
                    − <%= format_currency(entry.total_deductions, precision: 0) %>
                  </span>
                </div>
              <% end %>
              <% if entry.total_bonuses > 0 || entry.total_overtime > 0 %>
                <div class="payslip-card__stat">
                  <span class="payslip-card__stat-label"><%= t("payroll.index.additions_col") %></span>
                  <span class="payslip-card__stat-value" style="color: var(--success);">
                    + <%= format_currency(entry.total_bonuses + entry.total_overtime, precision: 0) %>
                  </span>
                </div>
              <% end %>
              <div class="payslip-card__net">
                <span><%= t("payroll.index.net_col") %></span>
                <strong><%= format_currency(entry.net_salary, precision: 0) %></strong>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>

  <% else %>

    <%# ── Manager / Admin view: table ────────────────────────────────────── %>
    <div class="table-wrap table-wrap--cards">
      <table>
        <thead>
          <tr>
            <th><%= t("payroll.period") %></th>
            <th><%= t("payroll.status") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @periods.each do |period| %>
            <tr>
              <td><%= link_to period.period_label, payroll_period_path(period), class: "link" %></td>
              <td>
                <span class="badge <%= period_status_badge_class(period) %>">
                  <%= t("payroll.statuses.#{period.status}") %>
                </span>
              </td>
              <td class="td-actions">
                <%= link_to t("payroll.view"), payroll_period_path(period), class: "link-muted" %>
              </td>
            </tr>
          <% end %>
          <% if @periods.empty? %>
            <tr><td colspan="3" class="td-empty"><%= t("payroll.no_periods") %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>

  <% end %>

</div>

<% unless current_user.management_access? %>
  <style>
    .payslip-list { display: flex; flex-direction: column; gap: 0.75rem; }

    .payslip-card {
      display: block;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      padding: 1rem 1.25rem;
      text-decoration: none;
      color: inherit;
      transition: box-shadow 0.15s, border-color 0.15s;
    }
    .payslip-card:hover { border-color: var(--primary); box-shadow: 0 2px 8px rgba(0,0,0,0.08); }

    .payslip-card__header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.875rem;
    }
    .payslip-card__month { font-weight: 600; font-size: var(--text-base); }
    .payslip-card__arrow { font-size: 1.4rem; color: var(--text-2); line-height: 1; }

    .payslip-card__body {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: 0.5rem 1rem;
      border-top: 1px solid var(--border);
      padding-top: 0.75rem;
    }
    .payslip-card__stat { display: flex; flex-direction: column; gap: 0.125rem; }
    .payslip-card__stat-label { font-size: 0.72rem; color: var(--text-2); text-transform: uppercase; letter-spacing: 0.04em; }
    .payslip-card__stat-value { font-size: var(--text-sm); font-weight: 500; }

    .payslip-card__net {
      grid-column: 1 / -1;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-top: 0.375rem;
      padding-top: 0.625rem;
      border-top: 1px solid var(--border);
      font-size: var(--text-sm);
      color: var(--text-2);
    }
    .payslip-card__net strong { font-size: var(--text-base); color: var(--text-1); }
  </style>
<% end %>
