<div class="section-card section-card--top">
  <h3 class="section-title"><%= t("payroll.show.activity_title") %></h3>
  <div class="payroll-timeline">
    <% @audit_logs.each do |log| %>
      <%
        dot_class = case log.action_type
                    when "finalized", "paid"
                      "payroll-timeline__dot--done"
                    when "submitted_for_review", "branch_review_completed", "resubmitted_for_review", "review_slot_completed"
                      "payroll-timeline__dot--live"
                    when "deleted", "adjustment_rejected", "adjustment_removed", "branch_changes_requested", "central_review_reopened"
                      "payroll-timeline__dot--warn"
                    else
                      ""
                    end
        meta = log.metadata_hash
      %>
      <div class="payroll-timeline__entry">
        <div class="payroll-timeline__dot <%= dot_class %>"></div>
        <div class="payroll-timeline__action">
          <%= t("payroll.audit_log_action_types.#{log.action_type}") %>
          <% if meta["count"].present? && meta["bulk_approved"] %>
            <span class="payroll-timeline__count-badge">×<%= meta["count"] %></span>
          <% end %>
        </div>
        <div class="payroll-timeline__meta">
          <span class="payroll-timeline__actor">
            <%= user_avatar_tag(log.actor, size: :thumb, class: "payroll-timeline__actor-avatar") %>
            <%= log.actor.full_name %>
          </span>
          &middot; <%= local_datetime(log.created_at) %>
          <% if log.from_status && log.to_status %>
            &middot;
            <span class="badge badge-neutral" style="font-size: 10px; padding: 1px 6px;">
              <%= t("payroll.statuses.#{log.from_status}") %>
            </span>
            →
            <span class="badge <%= period_status_badge_class(log.to_status) %>" style="font-size: 10px; padding: 1px 6px;">
              <%= t("payroll.statuses.#{log.to_status}") %>
            </span>
          <% end %>
          <% if log.action_type == "branch_changes_requested" && meta["branch_name"].present? %>
            &middot; <span class="td-secondary"><%= meta["branch_name"] %></span>
          <% elsif log.action_type == "branch_changes_requested" && meta["central"] %>
            &middot; <span class="td-secondary"><%= t("payroll.central_review.label") %></span>
          <% end %>
          <% if log.action_type == "review_slot_completed" %>
            &middot; <span class="td-secondary"><%= meta["central"] ? t("payroll.central_review.label") : meta["branch_name"] %></span>
          <% end %>
          <% if log.action_type == "central_review_reopened" && meta["reason"].present? %>
            <div class="payroll-timeline__reason"><%= t("payroll.central_review.reopen_reasons.#{meta['reason']}") %></div>
          <% end %>
          <% if log.action_type == "branch_changes_requested" && meta["comment"].present? %>
            <div class="payroll-timeline__reason"><em><%= meta["comment"] %></em></div>
          <% end %>
          <% if log.action_type == "reopened" && meta["reason"].present? %>
            <div class="payroll-timeline__reason"><em><%= meta["reason"] %></em></div>
          <% end %>
          <% if log.action_type == "recalculated" %>
            &middot; <span class="td-secondary"><%= t("payroll.period_recalculation.timeline_changed", count: meta["changed_employee_count"].to_i) %></span>
            <% if meta["added_employee_count"].to_i > 0 %>
              &middot; <span class="td-secondary"><%= t("payroll.period_recalculation.timeline_added", count: meta["added_employee_count"].to_i) %></span>
            <% end %>
            <% if Array(meta["review_slots_opened"]).any? %>
              <div class="payroll-timeline__reason"><%= t("payroll.period_recalculation.timeline_slots_opened", branches: Array(meta["review_slots_opened"]).map { |b| b["branch_name"] }.to_sentence) %></div>
            <% end %>
            <% if meta["reason"].present? %>
              <div class="payroll-timeline__reason"><em><%= meta["reason"] %></em></div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
