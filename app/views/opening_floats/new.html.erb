<% content_for :title, t("opening_floats.new.page_title") %>

<turbo-frame id="modal">
<div class="emp-dashboard">

  <%# ── Modal close row ───────────────────────────────────────────────── %>
  <div style="display: flex; align-items: center; justify-content: space-between;">
    <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); margin: 0;">
      <%= t("opening_floats.new.step_label") %>
    </p>
    <button type="button"
            data-action="click->modal#close"
            style="border: none; background: none; cursor: pointer; color: var(--text-2); padding: var(--space-1); border-radius: var(--radius-sm);"
            aria-label="<%= t("common.close") %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <%# ── Page heading ──────────────────────────────────────────────────── %>
  <div>
    <h1 style="font-size: var(--text-xl); font-weight: 700; color: var(--text-1); margin: 0 0 var(--space-1); line-height: 1.2;">
      <%= t("opening_floats.new.page_title") %>
    </h1>
    <p style="font-size: var(--text-sm); color: var(--text-2); margin: 0;">
      <%= t("opening_floats.new.subtitle") %>
    </p>
  </div>

  <%= form_with url: opening_floats_path, scope: :opening_float, method: :post,
        style: "display: flex; flex-direction: column; gap: var(--space-5);",
        data: { turbo_frame: "_top" } do |f| %>

    <%# ── Amount per payment method ──────────────────────────────────── %>
    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden;">
      <div style="padding: var(--space-4) var(--space-5); display: flex; flex-direction: column; gap: var(--space-5);">
        <% @payment_methods.each do |pm| %>
          <div class="form-group" style="margin: 0;">
            <%= label_tag "opening_float[amounts][#{pm.id}][collected_amount]",
                  pm.display_name, class: "form-label" %>
            <%= number_field_tag "opening_float[amounts][#{pm.id}][collected_amount]",
                  nil, step: 0.01, min: 0, class: "form-control", placeholder: "0.00" %>
          </div>
        <% end %>
      </div>
    </div>

    <%# ── Notes (optional) ──────────────────────────────────────────── %>
    <div class="form-group" style="margin: 0;">
      <%= label_tag "opening_float[notes]", t("opening_floats.new.notes_label"), class: "form-label" %>
      <%= text_area_tag "opening_float[notes]",
            nil, class: "form-control", rows: 2,
            placeholder: t("opening_floats.new.notes_placeholder") %>
    </div>

    <%# ── Submit ────────────────────────────────────────────────────── %>
    <div class="emp-dashboard__cta" style="gap: var(--space-4);">
      <%= f.submit t("opening_floats.new.submit"),
            class: "btn btn-checkin",
            style: "width: 100%; justify-content: center; font-size: var(--text-base); padding: var(--space-4);" %>
      <button type="button"
              data-action="click->modal#close"
              class="btn btn-checkout"
              style="width: 100%; justify-content: center; text-align: center;">
        <%= t("common.cancel") %>
      </button>
    </div>
  <% end %>

</div>
</turbo-frame>
