<% content_for :title, t("finance.daily_reconciliations.index.title") %>

<div class="admin-page">

  <%# ── Page header ──────────────────────────────────────────────────────── %>
  <div class="page-header">
    <div>
      <h1 class="page-title">
        <%= t("finance.daily_reconciliations.index.title") %>
        <span style="color: var(--text-3); font-weight: 500;">
          • <%= @selected_branch ? @selected_branch.name : t("finance.daily_reconciliations.index.filter_all_sales_branches") %>
        </span>
      </h1>
      <p class="page-subtitle"><%= t("finance.daily_reconciliations.index.subtitle") %></p>
    </div>
    <div style="display: flex; gap: var(--space-2); align-items: center; flex-wrap: wrap;">
      <%# ── Branch selector — the primary context selector for this page.
          Filters summary cards, the reconciliation list, all counters, and
          all derived statuses (reuses the same @filter_branch / branch_id
          param and accessible_branches_for_dr as before this change — pure
          UI relocation, no new filtering logic). Only sales branches are
          offered; warehouse/laundry/other operational units never run Daily
          Reconciliations. ── %>
      <% if @accessible_branches.size > 1 %>
        <%= form_with url: finance_daily_reconciliations_path, method: :get,
              data: { controller: "auto-submit" }, style: "display: inline-flex;" do %>
          <%= hidden_field_tag :status, @filter_status %>
          <%= hidden_field_tag :business_date, @filter_date %>
          <%= hidden_field_tag :verification_status, @filter_bank_status %>
          <%= select_tag :branch_id,
                options_for_select(
                  [[ t("finance.daily_reconciliations.index.filter_all_sales_branches"), "" ]] +
                    @accessible_branches.map { |b| [ b.name, b.id ] },
                  @filter_branch
                ),
                data: { action: "change->auto-submit#submit" },
                class: "form-control", style: "width: auto; font-weight: 600;" %>
        <% end %>
      <% end %>
      <% if current_user.can?(:view_deposit_verification) %>
        <%= link_to t("finance.daily_reconciliations.index.deposit_verification_link"),
              finance_deposit_verifications_path,
              class: "btn btn-ghost" %>
      <% end %>
      <% if current_user.can?(:manage_pos_import) %>
        <%= link_to t("finance.daily_reconciliations.index.pos_import_button"),
              new_finance_pos_import_path,
              class: "btn btn-ghost" %>
      <% end %>
      <% if current_user.can?(:manage_payment_methods) %>
        <%= link_to t("nav.finance_payment_methods"),
              finance_payment_methods_path,
              class: "btn btn-ghost" %>
      <% end %>
      <% if policy(:daily_reconciliation).create? %>
        <%= button_to t("finance.daily_reconciliations.index.create_button"),
              finance_daily_reconciliations_path,
              method: :post,
              class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>

  <%# ── POS Import info bar ────────────────────────────────────────────── %>
  <% if @latest_pos_import %>
    <div style="background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--space-3) var(--space-4); margin-bottom: var(--space-4); display: flex; align-items: center; gap: var(--space-5); flex-wrap: wrap; font-size: var(--text-xs);">
      <div style="display: flex; align-items: center; gap: var(--space-2);">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        <span style="color: var(--text-2); font-weight: 600;">
          <%= t("finance.daily_reconciliations.index.pos_last_import") %>
        </span>
      </div>
      <span style="color: var(--text-3);">
        <%= @latest_pos_import.file_name %>
      </span>
      <span style="color: var(--text-3);">
        <%= t("finance.pos_imports.index.matched_rows_summary",
               matched: @latest_pos_import.matched_rows,
               dr_count: @latest_pos_import.dr_count) %>
      </span>
      <span style="color: var(--text-3);">
        <%= t("finance.daily_reconciliations.index.pos_imported_by",
               name: @latest_pos_import.imported_by.full_name,
               time: l(@latest_pos_import.updated_at, format: :short)) %>
      </span>
      <div style="margin-inline-start: auto; display: flex; gap: var(--space-2);">
        <%= link_to t("finance.daily_reconciliations.index.pos_import_history"),
              finance_pos_imports_path,
              style: "font-size: var(--text-xs); color: var(--accent); text-decoration: underline; text-decoration-style: dotted;" %>
        <%= link_to t("finance.daily_reconciliations.index.pos_reimport"),
              new_finance_pos_import_path,
              style: "font-size: var(--text-xs); color: var(--accent); text-decoration: underline; text-decoration-style: dotted;" %>
      </div>
    </div>
  <% end %>

  <%# ── Status filter tabs ──────────────────────────────────────────────── %>
  <div style="display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-4); border-bottom: 1px solid var(--border); padding-bottom: var(--space-3);">
    <% [
         [nil,                 t("finance.daily_reconciliations.index.filter_all")],
         ["waiting_opening",   t("finance.daily_reconciliations.index.filter_waiting_opening")],
         ["outstanding",       t("finance.daily_reconciliations.index.filter_outstanding")],
         ["waiting_verification", t("finance.daily_reconciliations.index.filter_waiting_verification")],
         ["verified",          t("finance.daily_reconciliations.index.filter_verified")]
       ].each do |val, label| %>
      <%= link_to label,
            finance_daily_reconciliations_path(status: val, branch_id: @filter_branch, business_date: @filter_date),
            style: "font-size: var(--text-sm); font-weight: 600; padding: var(--space-2) var(--space-3); border-radius: var(--radius); text-decoration: none; " +
                   (@filter_status == val ? "background: var(--accent); color: #fff;" : "color: var(--text-2); background: none;") %>
    <% end %>

    <%# Optional branch + date narrow-filters %>
    <%= form_with url: finance_daily_reconciliations_path, method: :get, style: "display: flex; align-items: center; gap: var(--space-2); margin-inline-start: auto; flex-wrap: wrap;" do |f| %>
      <%= hidden_field_tag :status, @filter_status %>
      <%= hidden_field_tag :branch_id, @filter_branch %>
      <% if @show_verification %>
        <%= f.select :verification_status,
              [[ t("finance.daily_reconciliations.index.bank_status_filter_all"), "" ]] +
              DailyReconciliation::BANK_RECONCILIATION_STATUSES.map { |s| [ t("finance.daily_reconciliations.index.bank_status.#{s}"), s ] },
              { selected: @filter_bank_status },
              class: "form-control form-control-sm", style: "width: auto; font-size: var(--text-sm);" %>

        <%# Deposited By — options tallied from the scope filtered so far
            (branch/date/status/bank-status), before this filter itself, with
            a per-user deposit count. Searchable via the same progressive-
            enhancement controller used elsewhere in the app. ── %>
        <%= f.select :depositor_id,
              [[ t("finance.daily_reconciliations.index.workspace.depositor_filter_all"), "" ]] +
                @depositor_counts.map { |user, count|
                  [ t("finance.daily_reconciliations.index.workspace.depositor_count", name: user.full_name, count: count), user.id ]
                },
              { selected: @filter_depositor_id },
              data: { controller: "searchable-select",
                      "searchable-select-target": "select",
                      search_placeholder: t("finance.daily_reconciliations.index.workspace.depositor_filter_search_placeholder") },
              class: "form-control form-control-sm", style: "width: auto; font-size: var(--text-sm);" %>

        <label style="display: inline-flex; align-items: center; gap: var(--space-1); font-size: var(--text-sm); color: var(--text-2); white-space: nowrap;">
          <%= check_box_tag :bank_imported, "1", @filter_bank_imported %>
          <%= t("finance.daily_reconciliations.index.workspace.bank_imported_label") %>
        </label>
        <label style="display: inline-flex; align-items: center; gap: var(--space-1); font-size: var(--text-sm); color: var(--text-2); white-space: nowrap;">
          <%= check_box_tag :outstanding_exists, "1", @filter_outstanding_exists %>
          <%= t("finance.daily_reconciliations.index.workspace.outstanding_exists_label") %>
        </label>
      <% end %>
      <%= f.date_field :business_date, value: @filter_date,
            class: "form-control form-control-sm", style: "width: auto; font-size: var(--text-sm);" %>
      <%= f.submit t("finance.daily_reconciliations.index.filter_apply"),
            class: "btn btn-ghost btn-sm" %>
      <% if @filter_branch.present? || @filter_date.present? || @filter_bank_status.present? ||
            @filter_depositor_id.present? || @filter_bank_imported || @filter_outstanding_exists %>
        <%= link_to t("finance.daily_reconciliations.index.filter_clear"),
              finance_daily_reconciliations_path(status: @filter_status),
              class: "btn btn-ghost btn-sm" %>
      <% end %>
    <% end %>
  </div>

  <% if @reconciliations.empty? %>

    <div class="empty-state" style="padding: var(--space-16) var(--space-8);">
      <div class="empty-state__icon">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
          <line x1="1" y1="10" x2="23" y2="10"/>
        </svg>
      </div>
      <p class="empty-state__title">
        <%= @empty_state_key ?
              t("finance.daily_reconciliations.index.workspace.empty_states.#{@empty_state_key}") :
              t("finance.daily_reconciliations.index.empty") %>
      </p>
      <% unless @empty_state_key %>
        <p class="empty-state__text" style="max-width: 360px; margin-inline: auto;">
          <%= t("finance.daily_reconciliations.index.empty_hint") %>
        </p>
      <% end %>
      <% if policy(:daily_reconciliation).create? %>
        <div style="margin-top: var(--space-6);">
          <%= button_to t("finance.daily_reconciliations.index.create_button"),
                finance_daily_reconciliations_path,
                method: :post,
                class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>

  <% else %>

    <%#
      Pre-compute summary figures in Ruby from the already-loaded collection.
      All associations are eager-loaded — no extra queries below.
    %>
    <%
      waiting_count     = @reconciliations.count(&:waiting_for_opening?)
      waiting_review_count = @reconciliations.count { |dr| dr.closed? && !dr.reviewed? }
      open_count        = @reconciliations.count(&:open?)
      # "deposited" state is reached as soon as the first deposit is recorded
      # — a remaining balance is normal and doesn't change readiness to verify.
      deposited_count   = @reconciliations.count(&:deposited?)
      verified_count    = @reconciliations.count(&:verified?)
      # Same definition as DailyReconciliation#total_remaining_balance (open
      # balances only — settled/written-off amounts are correctly excluded,
      # matching the show page's "Settled Later"/"Written Off" lines rather
      # than a raw expected-vs-deposited difference). Filtered on the already
      # preloaded association (not dr.total_remaining_balance) to avoid an
      # N+1 — that method re-queries per record since it chains .open onto
      # the association instead of using the loaded collection.
      total_outstanding = @reconciliations.sum { |dr|
        dr.remaining_deposit_balances.select(&:open?).sum(&:remaining_amount)
      }
      can_bulk_settle   = policy(:daily_reconciliation).bulk_settle?
      has_outstanding   = total_outstanding > 0
      payment_methods   = business_payment_methods
    %>

    <%# ── Workflow Dashboard — the 5 primary workspace stages. Only for users
        with view_deposit_verification. difference_found/waiting_for_matching/
        no_bank_transactions remain selectable via the status <select> above,
        not as top cards (same "curated subset" precedent as before). Each
        card shows count, total expected-cash amount, and % of all
        branch/date/DR-state-filtered DRs (i.e. before the bank-status filter
        itself) — clicking toggles that filter exactly like the select. ── %>
    <% if @show_verification && @bank_status_counts %>
      <div style="margin-bottom: var(--space-2);">
        <h2 class="dashboard-section__title" style="font-size: var(--text-base); margin: 0 0 var(--space-3);">
          <%= t("finance.daily_reconciliations.index.workspace.dashboard_title") %>
        </h2>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: var(--space-3); margin-bottom: var(--space-5); padding-bottom: var(--space-5); border-bottom: 1px solid var(--border);">
        <% %w[waiting_for_deposit waiting_for_bank_statement needs_review partially_matched completed].each do |status| %>
          <%
            active   = @filter_bank_status == status
            count    = @bank_status_counts[status].to_i
            amount   = @bank_status_amounts[status].to_d
            percent  = @bank_status_total_count.positive? ? (count.to_f / @bank_status_total_count * 100).round : 0
            color    = bank_reconciliation_status_color(status)
            link_url = finance_daily_reconciliations_path(
              status: @filter_status, branch_id: @filter_branch, business_date: @filter_date,
              depositor_id: @filter_depositor_id, bank_imported: (@filter_bank_imported ? "1" : nil),
              outstanding_exists: (@filter_outstanding_exists ? "1" : nil),
              verification_status: active ? nil : status
            )
          %>
          <%= link_to link_url,
                style: "text-decoration: none; display: block; border-radius: var(--radius-lg); overflow: hidden; #{active ? 'box-shadow: 0 0 0 2px var(--accent);' : ''}" do %>
            <div class="stat-card" style="margin: 0; cursor: pointer; border-top: 3px solid <%= color %>; #{active ? 'background: rgba(var(--accent-rgb), 0.06);' : ''}">
              <p class="stat-card__label" style="font-size: var(--text-xs);">
                <%= t("finance.daily_reconciliations.index.bank_status.#{status}") %>
              </p>
              <p class="stat-card__value" style="color: <%= color %>;"><%= count %></p>
              <p class="stat-card__sub" style="font-variant-numeric: tabular-nums;"><%= format_currency(amount) %></p>
              <p class="stat-card__sub" style="font-size: 10px;">
                <%= t("finance.daily_reconciliations.index.workspace.dashboard_of_total",
                      percent: percent, total: @bank_status_total_count) %>
              </p>
            </div>
          <% end %>
        <% end %>

        <%# "Open Disputes" — deliberately not part of the bank_reconciliation_status
            filter set (a dispute is orthogonal to matching progress); links to
            the Missing tab where disputed deposits now show their case badge. ── %>
        <%= link_to finance_deposit_verifications_path(tab: "missing"),
              style: "text-decoration: none; display: block; border-radius: var(--radius-lg); overflow: hidden;" do %>
          <div class="stat-card" style="margin: 0; cursor: pointer; border-top: 3px solid <%= bank_dispute_status_color('new') %>;">
            <p class="stat-card__label" style="font-size: var(--text-xs);">
              <%= t("finance.bank_disputes.dashboard_card_title") %>
            </p>
            <p class="stat-card__value" style="color: <%= bank_dispute_status_color('new') %>;"><%= @open_dispute_count %></p>
            <p class="stat-card__sub" style="font-variant-numeric: tabular-nums;"><%= format_currency(@open_dispute_amount) %></p>
          </div>
        <% end %>
      </div>

      <%# ── Amount Summary — totals across the currently filtered set, with a
          simple progress visualization (deposited/expected, matched/expected). ── %>
      <div class="card" style="padding: var(--space-4) var(--space-5); margin-bottom: var(--space-4);">
        <h3 style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); margin: 0 0 var(--space-3);">
          <%= t("finance.daily_reconciliations.index.workspace.summary_title") %>
        </h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-3);">
          <div>
            <p style="font-size: var(--text-xs); color: var(--text-3); margin: 0 0 2px;"><%= t("finance.daily_reconciliations.index.workspace.summary_expected") %></p>
            <p style="font-size: var(--text-lg); font-weight: 700; font-variant-numeric: tabular-nums; margin: 0;"><%= format_currency(@summary_expected) %></p>
          </div>
          <div>
            <p style="font-size: var(--text-xs); color: var(--text-3); margin: 0 0 2px;"><%= t("finance.daily_reconciliations.index.workspace.summary_deposited") %></p>
            <p style="font-size: var(--text-lg); font-weight: 700; font-variant-numeric: tabular-nums; margin: 0; color: var(--success);"><%= format_currency(@summary_deposited) %></p>
          </div>
          <div>
            <p style="font-size: var(--text-xs); color: var(--text-3); margin: 0 0 2px;"><%= t("finance.daily_reconciliations.index.workspace.summary_matched") %></p>
            <p style="font-size: var(--text-lg); font-weight: 700; font-variant-numeric: tabular-nums; margin: 0; color: #3b82f6;"><%= format_currency(@summary_matched) %></p>
          </div>
          <div>
            <p style="font-size: var(--text-xs); color: var(--text-3); margin: 0 0 2px;"><%= t("finance.daily_reconciliations.index.workspace.summary_outstanding") %></p>
            <p style="font-size: var(--text-lg); font-weight: 700; font-variant-numeric: tabular-nums; margin: 0; color: <%= @summary_outstanding.positive? ? 'var(--warning,#ca8a04)' : 'var(--text-3)' %>;"><%= format_currency(@summary_outstanding) %></p>
          </div>
        </div>
        <%
          deposited_pct = @summary_expected.positive? ? [ (@summary_deposited / @summary_expected * 100), 100 ].min : 0
          matched_pct   = @summary_expected.positive? ? [ (@summary_matched / @summary_expected * 100), 100 ].min : 0
        %>
        <div style="display: flex; flex-direction: column; gap: var(--space-2);">
          <div style="height: 6px; border-radius: 999px; background: var(--surface-2); overflow: hidden;">
            <div style="height: 100%; width: <%= deposited_pct %>%; background: var(--success);"></div>
          </div>
          <div style="height: 6px; border-radius: 999px; background: var(--surface-2); overflow: hidden;">
            <div style="height: 100%; width: <%= matched_pct %>%; background: #3b82f6;"></div>
          </div>
        </div>
      </div>

      <%# ── Top Depositors — clicking applies the same Deposited By filter. ── %>
      <% if @top_depositors.present? %>
        <div class="card" style="padding: var(--space-4) var(--space-5); margin-bottom: var(--space-4);">
          <h3 style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); margin: 0 0 var(--space-3);">
            <%= t("finance.daily_reconciliations.index.workspace.top_depositors_title") %>
          </h3>
          <div style="display: flex; flex-wrap: wrap; gap: var(--space-2);">
            <% @top_depositors.each do |user, count| %>
              <%= link_to finance_daily_reconciliations_path(
                    status: @filter_status, branch_id: @filter_branch, business_date: @filter_date,
                    verification_status: @filter_bank_status, depositor_id: (@filter_depositor_id == user.id ? nil : user.id)
                  ),
                  class: "badge #{@filter_depositor_id == user.id ? 'badge-accent' : 'badge-neutral'}",
                  style: "text-decoration: none;" do %>
                <%= t("finance.daily_reconciliations.index.workspace.depositor_count", name: user.full_name, count: count) %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>

    <%# ── Summary stats ─────────────────────────────────────────────────── %>
    <div class="stats-grid" style="margin-bottom: var(--space-5);">

      <div class="stat-card <%= waiting_count > 0 ? 'stat-card--warning' : '' %>">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-2);">
          <p class="stat-card__label"><%= t("finance.daily_reconciliations.index.stat_waiting") %></p>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0; color: <%= waiting_count > 0 ? 'var(--warning)' : 'var(--text-3)' %>; margin-top:1px;"><path d="M10 3H3v7l9 9 7-7-9-9z"/><line x1="6" y1="6" x2="6.01" y2="6"/></svg>
        </div>
        <p class="stat-card__value" style="<%= waiting_count > 0 ? 'color: var(--warning);' : '' %>"><%= waiting_count %></p>
        <p class="stat-card__sub"><%= t("finance.daily_reconciliations.index.stat_waiting_sub") %></p>
      </div>

      <div class="stat-card <%= waiting_review_count > 0 ? 'stat-card--warning' : '' %>">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-2);">
          <p class="stat-card__label"><%= t("finance.daily_reconciliations.index.stat_waiting_review") %></p>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0; color: <%= waiting_review_count > 0 ? 'var(--warning)' : 'var(--text-3)' %>; margin-top:1px;"><path d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
        </div>
        <p class="stat-card__value" style="<%= waiting_review_count > 0 ? 'color: var(--warning);' : '' %>"><%= waiting_review_count %></p>
        <p class="stat-card__sub"><%= t("finance.daily_reconciliations.index.stat_waiting_review_sub") %></p>
      </div>

      <div class="stat-card">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-2);">
          <p class="stat-card__label"><%= t("finance.daily_reconciliations.index.stat_open") %></p>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0; color: var(--accent); margin-top:1px;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <p class="stat-card__value"><%= open_count %></p>
        <p class="stat-card__sub"><%= t("finance.daily_reconciliations.index.stat_open_sub") %></p>
      </div>

      <div class="stat-card <%= total_outstanding > 0 ? 'stat-card--warning' : '' %>">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-2);">
          <p class="stat-card__label"><%= t("finance.daily_reconciliations.index.stat_outstanding") %></p>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0; color: <%= total_outstanding > 0 ? 'var(--warning)' : 'var(--text-3)' %>; margin-top:1px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <p class="stat-card__value" style="font-size: var(--text-lg); font-variant-numeric: tabular-nums; <%= total_outstanding > 0 ? 'color: var(--warning);' : '' %>">
          <%= format_currency(total_outstanding) %>
        </p>
        <p class="stat-card__sub"><%= t("finance.daily_reconciliations.index.stat_outstanding_sub") %></p>
      </div>

      <div class="stat-card <%= deposited_count > 0 ? 'stat-card--accent' : '' %>">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-2);">
          <p class="stat-card__label"><%= t("finance.daily_reconciliations.index.stat_pending_verify") %></p>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0; color: var(--accent); margin-top:1px;"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
        </div>
        <p class="stat-card__value"><%= deposited_count %></p>
        <p class="stat-card__sub"><%= t("finance.daily_reconciliations.index.stat_pending_verify_sub") %></p>
      </div>

    </div>

    <%# ── Bulk action bar — settle outstanding balances ───────────────── %>
    <% if can_bulk_settle && has_outstanding %>
      <div id="bulk-settle-bar" hidden
           data-currency-code="<%= current_user.business.currency %>"
           style="position: sticky; top: 0; z-index: 10; background: var(--surface); border: 1.5px solid rgba(var(--warning-rgb,202,138,4),0.4); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-5); margin-bottom: var(--space-3); box-shadow: var(--shadow-md);">
        <div style="display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; margin-bottom: var(--space-3);">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--warning,#ca8a04)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <div style="display: flex; flex-direction: column; gap: 2px;">
            <span style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1);">
              <span id="bulk-settle-count">0</span>
              <%= t("finance.daily_reconciliations.index.bulk_settle_selected_label") %>
            </span>
            <span style="font-size: var(--text-sm); color: var(--warning,#ca8a04); font-weight: 700; font-variant-numeric: tabular-nums;">
              <%= t("finance.daily_reconciliations.index.bulk_settle_total_label") %>:
              <span id="bulk-settle-total"></span>
            </span>
          </div>
          <button type="button" id="clear-settle-selection"
                  style="background: none; border: none; cursor: pointer; font-size: var(--text-sm); color: var(--text-3); text-decoration: underline; padding: 0; margin-inline-start: auto;">
            <%= t("finance.daily_reconciliations.index.bulk_clear") %>
          </button>
        </div>

        <form id="bulk-settle-form"
              action="<%= bulk_settle_finance_daily_reconciliations_path %>"
              method="post">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          <div style="display: flex; align-items: flex-end; gap: var(--space-3); flex-wrap: wrap;">
            <div class="form-group" style="margin: 0; flex: 0 0 auto;">
              <label class="form-label" style="font-size: var(--text-xs);">
                <%= t("finance.daily_reconciliations.index.bulk_settle_pm_label") %>
              </label>
              <%= select_tag "payment_method_id",
                    options_from_collection_for_select(payment_methods, :id, :display_name),
                    class: "form-control form-control-sm", style: "width: auto; font-size: var(--text-sm);" %>
            </div>
            <div class="form-group" style="margin: 0; flex: 1; min-width: 160px;">
              <label class="form-label" style="font-size: var(--text-xs);">
                <%= t("finance.daily_reconciliations.index.bulk_settle_ref_label") %>
              </label>
              <%= text_field_tag "reference_number", nil,
                    class: "form-control form-control-sm",
                    placeholder: t("finance.daily_reconciliations.index.bulk_settle_ref_placeholder"),
                    style: "font-size: var(--text-sm);" %>
            </div>
            <div class="form-group" style="margin: 0; flex: 1; min-width: 160px;">
              <label class="form-label" style="font-size: var(--text-xs);">
                <%= t("finance.daily_reconciliations.index.bulk_settle_notes_label") %>
              </label>
              <%= text_field_tag "notes", nil,
                    class: "form-control form-control-sm",
                    placeholder: t("finance.daily_reconciliations.index.bulk_settle_notes_placeholder"),
                    style: "font-size: var(--text-sm);" %>
            </div>
            <button type="submit"
                    class="btn btn-warning btn-sm"
                    data-turbo-confirm="<%= t('finance.daily_reconciliations.index.bulk_settle_confirm') %>"
                    style="flex-shrink: 0;">
              <%= t("finance.daily_reconciliations.index.bulk_settle_btn") %>
            </button>
          </div>
        </form>
      </div>
    <% end %>

    <%# ── General bulk action bar — Open Verification / Export / Print /
        Mark Reviewed / Assign. Independent from the settle-checkboxes above
        (different rows qualify for each), driven by .dr-bulk-checkbox. ── %>
    <% if @show_verification %>
      <div id="bulk-actions-bar" hidden
           style="position: sticky; top: 0; z-index: 10; background: var(--surface); border: 1.5px solid rgba(var(--accent-rgb),0.4); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-5); margin-bottom: var(--space-3); box-shadow: var(--shadow-md); display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap;">
        <span style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1);">
          <span id="bulk-actions-count">0</span>
          <%= t("finance.daily_reconciliations.index.workspace.bulk_bar.selected_label") %>
        </span>

        <button type="button" id="bulk-open-verification" class="btn btn-ghost btn-sm">
          <%= t("finance.daily_reconciliations.index.workspace.bulk_bar.open_verification") %>
        </button>
        <button type="button" id="bulk-export" class="btn btn-ghost btn-sm">
          <%= t("finance.daily_reconciliations.index.workspace.bulk_bar.export") %>
        </button>
        <button type="button" id="bulk-print" class="btn btn-ghost btn-sm">
          <%= t("finance.daily_reconciliations.index.workspace.bulk_bar.print") %>
        </button>

        <% if policy(:daily_reconciliation).bulk_mark_reviewed? %>
          <form id="bulk-mark-reviewed-form" action="<%= bulk_mark_reviewed_finance_daily_reconciliations_path %>" method="post">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <button type="submit" class="btn btn-ghost btn-sm"
                    data-turbo-confirm="<%= t('finance.daily_reconciliations.index.workspace.bulk_bar.mark_reviewed_confirm') %>">
              <%= t("finance.daily_reconciliations.index.workspace.bulk_bar.mark_reviewed") %>
            </button>
          </form>
        <% end %>

        <% if policy(:daily_reconciliation).bulk_assign_depositor? %>
          <form id="bulk-assign-form" action="<%= bulk_assign_depositor_finance_daily_reconciliations_path %>" method="post"
                style="display: flex; align-items: center; gap: var(--space-2);">
            <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
            <%= select_tag :depositor_id,
                  options_from_collection_for_select(current_user.business.users.active.order(:first_name, :last_name), :id, :full_name),
                  class: "form-control form-control-sm", style: "width: auto; font-size: var(--text-sm);" %>
            <button type="submit" class="btn btn-ghost btn-sm">
              <%= t("finance.daily_reconciliations.index.workspace.bulk_bar.assign") %>
            </button>
          </form>
        <% end %>

        <button type="button" id="clear-bulk-selection"
                style="background: none; border: none; cursor: pointer; font-size: var(--text-sm); color: var(--text-3); text-decoration: underline; padding: 0; margin-inline-start: auto;">
          <%= t("finance.daily_reconciliations.index.workspace.bulk_bar.clear") %>
        </button>
      </div>
    <% end %>

    <%# ── Reconciliation cards ──────────────────────────────────────────── %>
    <div style="display: flex; flex-direction: column; gap: var(--space-2);" id="dr-card-list">
      <%= render partial: "reconciliation_card", collection: @reconciliations, as: :dr,
            locals: { can_bulk_settle: can_bulk_settle, show_verification: @show_verification } %>
    </div>

  <% end %>

</div>

<%# ── Bulk settle JS ─────────────────────────────────────────────────────── %>
<script>
(function () {
  var settleBar   = document.getElementById('bulk-settle-bar');
  var settleForm  = document.getElementById('bulk-settle-form');
  var settleCount = document.getElementById('bulk-settle-count');
  var settleTotal = document.getElementById('bulk-settle-total');
  var clearSettle = document.getElementById('clear-settle-selection');

  if (!settleForm) return;

  var currencyCode = (settleBar && settleBar.dataset.currencyCode) || 'SAR';
  var locale       = document.documentElement.lang === 'ar' ? 'ar-SA' : 'en-US';
  var fmt          = new Intl.NumberFormat(locale, { style: 'currency', currency: currencyCode, minimumFractionDigits: 2 });

  function syncSettleForm() {
    settleForm.querySelectorAll('input[name="ids[]"]').forEach(function(el) { el.remove(); });
    var checked = document.querySelectorAll('.dr-settle-checkbox:checked');
    var total   = 0;
    checked.forEach(function(cb) {
      var h = document.createElement('input');
      h.type = 'hidden'; h.name = 'ids[]'; h.value = cb.dataset.drId;
      settleForm.appendChild(h);
      total += parseFloat(cb.dataset.amount) || 0;
    });
    if (settleCount) settleCount.textContent = checked.length;
    if (settleTotal) settleTotal.textContent = fmt.format(total);
    if (settleBar)   settleBar.hidden = checked.length === 0;
  }

  document.querySelectorAll('.dr-settle-checkbox').forEach(function(cb) {
    cb.addEventListener('change', syncSettleForm);
  });

  if (clearSettle) {
    clearSettle.addEventListener('click', function() {
      document.querySelectorAll('.dr-settle-checkbox').forEach(function(cb) { cb.checked = false; });
      syncSettleForm();
    });
  }
})();
</script>

<%# ── General bulk actions JS (Open Verification / Export / Print / Mark
    Reviewed / Assign) — independent selection from the settle checkboxes
    above, driven by .dr-bulk-checkbox. ── %>
<script>
(function () {
  var bar          = document.getElementById('bulk-actions-bar');
  var countEl      = document.getElementById('bulk-actions-count');
  var clearBtn     = document.getElementById('clear-bulk-selection');
  var openVerifBtn = document.getElementById('bulk-open-verification');
  var exportBtn    = document.getElementById('bulk-export');
  var printBtn     = document.getElementById('bulk-print');
  var reviewedForm = document.getElementById('bulk-mark-reviewed-form');
  var assignForm   = document.getElementById('bulk-assign-form');

  if (!bar) return;

  function checkedBoxes() {
    return Array.prototype.slice.call(document.querySelectorAll('.dr-bulk-checkbox:checked'));
  }

  function syncIdsOn(form) {
    if (!form) return;
    form.querySelectorAll('input[name="ids[]"]').forEach(function (el) { el.remove(); });
    checkedBoxes().forEach(function (cb) {
      var h = document.createElement('input');
      h.type = 'hidden'; h.name = 'ids[]'; h.value = cb.dataset.drId;
      form.appendChild(h);
    });
  }

  function sync() {
    var checked = checkedBoxes();
    if (countEl) countEl.textContent = checked.length;
    bar.hidden = checked.length === 0;
    syncIdsOn(reviewedForm);
    syncIdsOn(assignForm);
  }

  document.querySelectorAll('.dr-bulk-checkbox').forEach(function (cb) {
    cb.addEventListener('change', sync);
  });

  if (clearBtn) {
    clearBtn.addEventListener('click', function () {
      document.querySelectorAll('.dr-bulk-checkbox').forEach(function (cb) { cb.checked = false; });
      sync();
    });
  }

  if (openVerifBtn) {
    openVerifBtn.addEventListener('click', function () {
      var checked = checkedBoxes();
      if (!checked.length) return;
      var dates  = checked.map(function (cb) { return cb.dataset.businessDate; }).filter(Boolean).sort();
      var branchIds = checked.map(function (cb) { return cb.dataset.branchId; });
      var sameBranch = branchIds.every(function (b) { return b === branchIds[0]; });
      var params = new URLSearchParams();
      if (dates.length) { params.set('from', dates[0]); params.set('to', dates[dates.length - 1]); }
      if (sameBranch) params.set('branch_id', branchIds[0]);
      window.location = '<%= finance_deposit_verifications_path %>?' + params.toString();
    });
  }

  if (exportBtn) {
    exportBtn.addEventListener('click', function () {
      var checked = checkedBoxes();
      var params = new URLSearchParams();
      checked.forEach(function (cb) { params.append('ids[]', cb.dataset.drId); });
      window.location = '<%= export_finance_daily_reconciliations_path %>?' + params.toString();
    });
  }

  if (printBtn) {
    printBtn.addEventListener('click', function () {
      var checkedIds = checkedBoxes().map(function (cb) { return cb.dataset.drId; });
      document.querySelectorAll('#dr-card-list > .dr-card').forEach(function (card, i) {
        var cb = card.querySelector('.dr-bulk-checkbox');
        var include = !checkedIds.length || (cb && checkedIds.indexOf(cb.dataset.drId) !== -1);
        card.classList.toggle('print-hide', !include);
      });
      window.print();
    });
  }
})();
</script>

<style>
  @media print {
    .page-header, .bulk-action-bar-hide-on-print, #bulk-settle-bar, #bulk-actions-bar,
    .btn, select, input[type="checkbox"] { display: none !important; }
    .print-hide { display: none !important; }
  }
</style>
