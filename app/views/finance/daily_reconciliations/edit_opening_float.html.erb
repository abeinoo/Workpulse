<% content_for :title, t("finance.daily_reconciliations.show.edit_opening_float.page_title") %>

<div class="admin-page" style="max-width: 600px;">

  <div class="page-header">
    <div>
      <h1 class="page-title"><%= t("finance.daily_reconciliations.show.edit_opening_float.page_title") %></h1>
      <p class="page-subtitle">
        <%= @reconciliation.branch.name %>
        <% if @reconciliation.business_date %>
          &middot; <%= l(@reconciliation.business_date, format: :long) %>
        <% end %>
      </p>
    </div>
    <%= link_to t("shared.cancel"),
                finance_daily_reconciliation_path(@reconciliation),
                class: "btn btn-ghost" %>
  </div>

  <%# ── Info banner ──────────────────────────────────────────────────────── %>
  <div style="display: flex; gap: var(--space-3); align-items: flex-start; padding: var(--space-4) var(--space-5);
              background: rgba(var(--accent-rgb,99,102,241),0.07); border: 1.5px solid rgba(var(--accent-rgb,99,102,241),0.25);
              border-radius: var(--radius-lg); margin-bottom: var(--space-5);">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
    </svg>
    <p style="font-size: var(--text-sm); color: var(--text-2); margin: 0; line-height: 1.5;">
      <%= t("finance.daily_reconciliations.show.edit_opening_float.info") %>
    </p>
  </div>

  <%= form_with url: update_opening_float_amounts_finance_daily_reconciliation_path(@reconciliation),
                method: :patch do |f| %>

    <% if flash[:alert].present? %>
      <div class="alert alert-danger" style="margin-bottom: var(--space-4);">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <div class="card" style="padding: var(--space-5); margin-bottom: var(--space-5);">

      <%# ── "Left by" context ─────────────────────────────────────────────── %>
      <% if @source_handover&.from_user %>
        <div style="font-size: var(--text-xs); color: var(--text-3); margin-bottom: var(--space-4);
                    padding-bottom: var(--space-4); border-bottom: 1px solid var(--border);">
          <%= t("finance.daily_reconciliations.show.edit_opening_float.left_by",
                name: @source_handover.from_user.full_name,
                date: l(@source_handover.created_at.to_date, format: :long)) %>
        </div>
      <% end %>

      <table style="width: 100%; border-collapse: collapse; font-size: var(--text-sm);">
        <thead>
          <tr>
            <th style="text-align: start; font-weight: 600; color: var(--text-3); font-size: 11px;
                       text-transform: uppercase; letter-spacing: 0.06em; padding-bottom: var(--space-3);">
              <%= t("finance.daily_reconciliations.show.opening_float_col_method") %>
            </th>
            <th style="text-align: end; font-weight: 600; color: var(--text-3); font-size: 11px;
                       text-transform: uppercase; letter-spacing: 0.06em; padding-bottom: var(--space-3);">
              <%= t("finance.daily_reconciliations.show.opening_float_col_collected") %>
            </th>
            <th style="text-align: end; font-weight: 600; color: var(--text-3); font-size: 11px;
                       text-transform: uppercase; letter-spacing: 0.06em; padding-bottom: var(--space-3);">
              <%= t("finance.daily_reconciliations.show.edit_opening_float.col_refund") %>
            </th>
          </tr>
        </thead>
        <tbody>
          <% @edit_rows.each do |row| %>
            <% pm = row[:payment_method] %>
            <tr>
              <td style="padding: var(--space-2) 0; font-weight: 500; color: var(--text-1); vertical-align: middle;">
                <%= pm.display_name %>
                <% if row[:source_amount_id].nil? %>
                  <span style="font-size: 10px; font-weight: 400; color: var(--text-3); margin-inline-start: var(--space-1);">
                    (<%= t("finance.daily_reconciliations.show.edit_opening_float.not_submitted") %>)
                  </span>
                <% end %>
              </td>
              <td style="padding: var(--space-2) 0 var(--space-2) var(--space-3); text-align: end; vertical-align: middle;">
                <input type="number" inputmode="decimal"
                       name="amounts[<%= pm.id %>][collected_amount]"
                       value="<%= row[:collected].to_f %>"
                       step="0.01"
                       min="0"
                       class="form-control form-control-sm"
                       style="width: 130px; text-align: end; font-variant-numeric: tabular-nums; display: inline-block;" />
              </td>
              <td style="padding: var(--space-2) 0 var(--space-2) var(--space-3); text-align: end; vertical-align: middle;">
                <input type="number" inputmode="decimal"
                       name="amounts[<%= pm.id %>][refund_amount]"
                       value="<%= row[:refund].to_f %>"
                       step="0.01"
                       min="0"
                       class="form-control form-control-sm"
                       style="width: 130px; text-align: end; font-variant-numeric: tabular-nums; display: inline-block;" />
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

    </div>

    <div style="display: flex; gap: var(--space-3); justify-content: flex-end; align-items: center;">
      <%= link_to t("shared.cancel"),
                  finance_daily_reconciliation_path(@reconciliation),
                  class: "btn btn-ghost" %>
      <%= f.submit t("finance.daily_reconciliations.show.edit_opening_float.submit_btn"),
                   class: "btn btn-primary" %>
    </div>

  <% end %>

</div>
