<% content_for :title, t("finance.daily_reconciliations.transfer_deposit.title") %>

<turbo-frame id="modal">
<div id="deposit-transfer-modal"
     style="padding: var(--space-5) var(--space-5) var(--space-8); display: flex; flex-direction: column; gap: var(--space-4); min-width: 0;">

  <%# ── Modal header ────────────────────────────────────────────────────── %>
  <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-3);">
    <div style="min-width: 0;">
      <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); margin: 0 0 2px;">
        <%= @reconciliation.branch.name %> · <%= l(@reconciliation.business_date, format: :short) %>
      </p>
      <h2 style="font-size: var(--text-xl); font-weight: 700; color: var(--text-1); margin: 0; line-height: 1.2;">
        <%= t("finance.daily_reconciliations.transfer_deposit.title") %>
      </h2>
    </div>
    <button type="button"
            data-action="click->modal#close"
            style="flex-shrink: 0; border: none; background: none; cursor: pointer; color: var(--text-2); padding: var(--space-2); border-radius: var(--radius-sm);"
            aria-label="<%= t("common.close") %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <%# ── Current depositor ───────────────────────────────────────────────── %>
  <div style="background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-4); display: flex; align-items: center; gap: var(--space-3); min-width: 0;">
    <div style="flex-shrink: 0; width: 40px; height: 40px; border-radius: 50%; background: rgba(var(--warning-rgb, 202,138,4), 0.12); display: flex; align-items: center; justify-content: center; color: var(--warning, #ca8a04);">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="15" rx="2"/><path d="M16 7V5a2 2 0 0 0-4 0v2"/><line x1="12" y1="12" x2="12" y2="17"/><line x1="9.5" y1="14.5" x2="14.5" y2="14.5"/></svg>
    </div>
    <div style="flex: 1; min-width: 0;">
      <p style="font-size: var(--text-xs); color: var(--text-2); margin: 0 0 2px;">
        <%= t("finance.daily_reconciliations.transfer_deposit.current_label") %>
      </p>
      <p id="deposit-transfer-current" style="font-size: var(--text-base); font-weight: 700; color: var(--text-1); margin: 0; overflow-wrap: anywhere;">
        <%= @current_depositor.full_name %>
      </p>
    </div>
  </div>

  <%# ── What this changes ───────────────────────────────────────────────── %>
  <div style="background: rgba(var(--warning-rgb, 202,138,4), 0.06); border: 1px solid rgba(var(--warning-rgb, 202,138,4), 0.25); border-radius: var(--radius-lg); padding: var(--space-3) var(--space-4);">
    <p style="font-size: var(--text-sm); color: var(--text-1); margin: 0; line-height: 1.6;">
      <%= t("finance.daily_reconciliations.transfer_deposit.description") %>
    </p>
  </div>

  <% if @pending_deposit_transfer %>
    <%# Blocking state: DepositorAssigner refuses while an accept-flow transfer is pending. %>
    <div role="alert" style="background: rgba(var(--danger-rgb, 220,38,38), 0.06); border: 1px solid rgba(var(--danger-rgb, 220,38,38), 0.30); border-radius: var(--radius-lg); padding: var(--space-3) var(--space-4);">
      <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); margin: 0 0 2px;">
        <%= t("finance.daily_reconciliations.errors.deposit_transfer_already_pending") %>
      </p>
      <p style="font-size: var(--text-xs); color: var(--text-2); margin: 0;">
        <%= t("finance.daily_reconciliations.transfer_deposit.pending_title",
              name: @pending_deposit_transfer.to_user.full_name) %>
      </p>
    </div>
    <button type="button" data-action="click->modal#close" class="btn btn-ghost" style="width: 100%; justify-content: center;">
      <%= t("common.close") %>
    </button>

  <% elsif @depositor_candidates.empty? %>
    <p style="font-size: var(--text-sm); color: var(--text-2); margin: 0;">
      <%= t("finance.daily_reconciliations.transfer_deposit.no_candidates") %>
    </p>
    <button type="button" data-action="click->modal#close" class="btn btn-ghost" style="width: 100%; justify-content: center;">
      <%= t("common.close") %>
    </button>

  <% else %>
    <%= form_with url: deposit_responsibility_transfers_path,
          method: :post,
          id: "deposit-transfer-form",
          data: { turbo_frame: "_top",
                  controller: "deposit-transfer",
                  deposit_transfer_confirm_template_value:
                    t("finance.daily_reconciliations.transfer_deposit.confirm", name: "%{name}") } do |f| %>
      <%# The depositor this form was opened against — the server rejects the
          transfer if responsibility has moved since (it never uses this as
          the new or previous depositor). %>
      <%= hidden_field_tag :daily_reconciliation_id, @reconciliation.id %>
      <%= hidden_field_tag :expected_depositor_id, @current_depositor.id %>

      <div style="display: flex; flex-direction: column; gap: var(--space-4); min-width: 0;">
        <div class="form-group" style="margin: 0; min-width: 0;">
          <%= label_tag :to_user_id, t("finance.daily_reconciliations.transfer_deposit.to_label"),
                for: "deposit-transfer-depositor", class: "form-label" %>
          <%= select_tag :to_user_id,
                options_for_select(@depositor_candidates.map { |u| [ u.full_name, u.id ] }),
                include_blank: t("finance.daily_reconciliations.transfer_deposit.to_placeholder"),
                id: "deposit-transfer-depositor",
                required: true,
                class: "form-control",
                style: "width: 100%; max-width: 100%; min-width: 0;",
                data: { deposit_transfer_target: "select", action: "change->deposit-transfer#update" } %>
        </div>

        <div class="form-group" style="margin: 0; min-width: 0;">
          <%= label_tag :notes, t("finance.daily_reconciliations.transfer_deposit.notes_label"),
                for: "deposit-transfer-notes", class: "form-label" %>
          <%= text_area_tag :notes, nil,
                id: "deposit-transfer-notes",
                rows: 2, class: "form-control",
                maxlength: Finance::DepositResponsibilityTransferRequester::NOTES_MAX_LENGTH,
                style: "width: 100%; max-width: 100%;",
                placeholder: t("finance.daily_reconciliations.transfer_deposit.notes_placeholder") %>
        </div>

        <p data-deposit-transfer-target="summary" hidden
           style="font-size: var(--text-sm); font-weight: 600; color: var(--text-1); margin: 0; overflow-wrap: anywhere;"></p>

        <div style="display: flex; flex-wrap: wrap-reverse; gap: var(--space-3);">
          <button type="button"
                  data-action="click->modal#close"
                  class="btn btn-ghost"
                  style="flex: 1 1 140px; justify-content: center;">
            <%= t("common.cancel") %>
          </button>
          <%= f.submit t("finance.daily_reconciliations.transfer_deposit.submit"),
                id: "deposit-transfer-submit",
                class: "btn btn-primary",
                disabled: true,
                data: { deposit_transfer_target: "submit" },
                style: "flex: 1 1 140px; justify-content: center;" %>
        </div>
      </div>
    <% end %>
  <% end %>

</div>
</turbo-frame>
