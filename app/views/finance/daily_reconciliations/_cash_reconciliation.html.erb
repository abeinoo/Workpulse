<%# ── Cash Reconciliation ───────────────────────────────────────────────────
    Cash formula (expected vs deposited) plus the remaining-deposit ledger, with
    a collapsible per-employee cash-only breakdown. All figures come from the
    model/controller; this partial only formats and lays them out. %>

<% if @can_view_session_totals || @employee_summaries&.any? %>
  <section id="cash-reconciliation" class="recon-section" data-controller="accordion" data-accordion-key-value="cash-reconciliation">
    <div class="dashboard-section__header recon-accordion__header">
      <div class="recon-accordion__trigger" data-accordion-target="trigger" data-action="click->accordion#toggle keydown.enter->accordion#toggle keydown.space->accordion#toggle" role="button" tabindex="0" aria-expanded="false">
        <span class="recon-accordion__chevron" data-accordion-target="icon" aria-hidden="true">▶</span>
        <div>
          <h2 class="dashboard-section__title"><%= t("finance.daily_reconciliations.show.sections.cash.title") %></h2>
          <p style="font-size: var(--text-xs); color: var(--text-2); margin: var(--space-1) 0 0;">
            <%= t("finance.daily_reconciliations.show.sections.cash.subtitle") %>
          </p>
        </div>
      </div>
      <% if @can_edit_session_totals %>
        <%= link_to t("finance.daily_reconciliations.show.action_edit_session_totals"),
              edit_session_totals_finance_daily_reconciliation_path(@reconciliation),
              class: "btn btn-ghost btn-sm" %>
      <% end %>
    </div>

    <div class="recon-accordion__panel" data-accordion-target="content">
    <div class="recon-accordion__panel-inner">
    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm);">
      <% if @can_view_session_totals %>
        <div style="padding: var(--dr-panel-py) var(--space-5);">
          <%# Gross Cash Sales − Cash Refunds = Expected Cash — refunds are
              always broken out, never folded silently into one figure. %>
          <div class="recon-formula-row">
            <span><%= t("finance.daily_reconciliations.show.sections.cash.gross_cash_sales") %></span>
            <span class="recon-formula-row__value"><%= format_currency(@expected_cash_gross) %></span>
          </div>
          <% if @expected_cash_refunds.to_d.positive? %>
            <div class="recon-formula-row">
              <span><%= t("finance.daily_reconciliations.show.sections.cash.cash_refunds") %></span>
              <span class="recon-formula-row__value" style="color: var(--danger,#dc2626);">− <%= format_currency(@expected_cash_refunds) %></span>
            </div>
          <% end %>
          <div class="recon-formula-row">
            <span><%= t("finance.daily_reconciliations.show.sections.cash.expected_cash") %></span>
            <span class="recon-formula-row__value"><%= format_currency(@expected_cash) %></span>
          </div>
          <% if @bank_dispute_amount.to_d.positive? %>
            <div class="recon-formula-row">
              <span><%= t("finance.daily_reconciliations.show.sections.cash.bank_disputes") %></span>
              <span class="recon-formula-row__value" style="color: var(--warning);"><%= format_currency(@bank_dispute_amount) %></span>
            </div>
          <% end %>
          <div class="recon-formula-row">
            <span><%= t("finance.daily_reconciliations.show.sections.cash.actual_deposited") %></span>
            <span class="recon-formula-row__value" style="color: var(--success);"><%= format_currency(@total_deposited) %></span>
          </div>
          <% tone = @cash_difference.abs < 0.01 ? :ok : :warn %>
          <div class="recon-formula-row recon-formula-row--total">
            <span><%= t("finance.daily_reconciliations.show.sections.cash.difference") %></span>
            <span class="recon-formula-row__value"
                  style="color: <%= tone == :ok ? 'var(--text-3)' : 'var(--warning)' %>;">
              <%= tone == :ok ? "—" : format_currency(@cash_difference) %>
            </span>
          </div>

          <%# Remaining-deposit ledger — preserves the outstanding-balance drill-in. %>
          <% has_outstanding = @total_remaining_balance.to_d.positive? %>
          <% if has_outstanding %>
            <%
              open_balances = @all_remaining_balances.select(&:open?)
              rdb_link = open_balances.size == 1 ?
                finance_remaining_deposit_balance_path(open_balances.first) :
                finance_daily_reconciliation_path(@reconciliation)
            %>
            <%= link_to rdb_link, class: "recon-formula-row", style: "text-decoration: none;" do %>
              <span style="color: var(--warning); font-weight: 600; display: inline-flex; align-items: center; gap: var(--space-1);">
                <%= t("finance.daily_reconciliations.show.outstanding_balance") %>
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
              </span>
              <span class="recon-formula-row__value" style="color: var(--warning);"><%= format_currency(@total_remaining_balance) %></span>
            <% end %>
          <% end %>
          <% if @total_settled_later.to_d.positive? %>
            <div class="recon-formula-row">
              <span style="color: var(--success);"><%= t("finance.daily_reconciliations.show.settled_later") %></span>
              <span class="recon-formula-row__value" style="color: var(--success);"><%= format_currency(@total_settled_later) %></span>
            </div>
          <% end %>
          <% if @total_written_off.to_d.positive? %>
            <div class="recon-formula-row">
              <span style="color: var(--text-3);"><%= t("finance.daily_reconciliations.show.written_off") %></span>
              <span class="recon-formula-row__value" style="color: var(--text-3); text-decoration: line-through;"><%= format_currency(@total_written_off) %></span>
            </div>
          <% end %>
        </div>
      <% end %>

      <%# ── Collapsible: per-employee cash-only breakdown ─────────────────── %>
      <% if @employee_summaries&.any? %>
        <%# Deposits are recorded per reconciliation + payment method (TillDeposit),
            not per employee — the custody chain doesn't track whose physical cash
            ended up in which deposit. Grouping @deposits (already loaded/includes'd
            in the controller) by payment_method_id is the finest existing
            granularity available, so every employee row for that payment method
            shows the same deposit timestamp(s). No new query or calculation. %>
        <%
          cash_ids = Array(@cash_payment_method_ids)
          deposits_by_payment_method = @deposits
                                          .reject(&:voided?)
                                          .sort_by(&:deposited_at)
                                          .group_by(&:payment_method_id)
        %>
        <div data-controller="collapsible" class="recon-disclosure" style="border-top: 1px solid var(--border);">
          <button type="button" data-collapsible-target="trigger" data-action="click->collapsible#toggle"
                  class="recon-disclosure__trigger" aria-expanded="false">
            <span><%= t("finance.daily_reconciliations.show.sections.cash.detail_toggle") %></span>
            <svg class="recon-disclosure__chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
            </svg>
          </button>
          <div data-collapsible-target="content" hidden style="padding: var(--dr-formula-row-py) var(--space-5) var(--dr-panel-py);">
            <% @employee_summaries.each do |summary| %>
              <% cash_amounts = summary.amounts.select { |a| cash_ids.include?(a.payment_method_id) }
                                                .reject { |a| a.collected_amount.zero? && a.refund_amount.zero? } %>
              <% next if cash_amounts.empty? %>
              <div style="margin-top: var(--space-3);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-1);">
                  <span style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1);"><%= summary.user.full_name %></span>
                  <span style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); font-variant-numeric: tabular-nums;">
                    <%= format_currency(cash_amounts.sum(&:net_amount)) %>
                  </span>
                </div>
                <% cash_amounts.each do |amt| %>
                  <div style="padding: 2px 0; border-bottom: 1px dashed var(--border);">
                    <div style="display: flex; justify-content: space-between; align-items: baseline; font-size: var(--text-xs);">
                      <span style="color: var(--text-2);"><%= amt.payment_method_name %></span>
                      <span style="display: flex; gap: var(--space-3); align-items: baseline;">
                        <% if amt.refund_amount.positive? %>
                          <span style="color: var(--danger);">− <%= format_currency(amt.refund_amount) %></span>
                        <% end %>
                        <span style="font-weight: 600; color: var(--text-1); font-variant-numeric: tabular-nums;"><%= format_currency(amt.net_amount) %></span>
                      </span>
                    </div>
                    <%# ── Deposit date/time for this payment method, reusing @deposits ── %>
                    <% pm_deposits = deposits_by_payment_method[amt.payment_method_id] || [] %>
                    <div style="font-size: 11px; color: var(--text-3); margin-top: 1px;">
                      <% if pm_deposits.empty? %>
                        <%= t("finance.daily_reconciliations.show.sections.cash.not_deposited_yet") %>
                      <% else %>
                        <% pm_deposits.each do |dep| %>
                          <% origin_dispute = dep.bank_disputes.find { |bd| bd.kind == "atm_deposit_failure" } %>
                          <div>
                            <%= t("finance.daily_reconciliations.show.sections.cash.deposited_at_prefix") %>
                            <%= l(dep.deposited_at.to_date, format: :long) %> - <%= l(dep.deposited_at, format: :time_only) %>
                            <% if origin_dispute %>
                              <span style="color: var(--warning); font-weight: 600;">
                                — <%= t("finance.daily_reconciliations.show.sections.cash.bank_dispute_origin") %>
                                (<%= link_to "##{origin_dispute.id}", finance_bank_dispute_path(origin_dispute) %>)
                              </span>
                            <% end %>
                          </div>
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    </div>
    </div>
  </section>
<% end %>
