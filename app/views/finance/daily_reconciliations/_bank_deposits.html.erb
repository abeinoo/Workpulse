<%# ── Bank Deposits ─────────────────────────────────────────────────────────
    Recorded deposits (with void actions) plus, when the viewer can see deposit
    verification, a comparison against the imported bank statement. Bank stats
    come from the controller (build_bank_deposit_stats). %>

<section id="bank-deposits" class="recon-section" style="margin-bottom: var(--space-6);">
  <div class="dashboard-section__header" style="margin-bottom: var(--space-4);">
    <div>
      <h2 class="dashboard-section__title"><%= t("finance.daily_reconciliations.show.sections.bank.title") %></h2>
      <p style="font-size: var(--text-xs); color: var(--text-2); margin: var(--space-1) 0 0;">
        <%= t("finance.daily_reconciliations.show.sections.bank.subtitle") %>
      </p>
    </div>
    <% if @can_view_deposit_verification && (@reconciliation.reviewed? || @reconciliation.verified?) %>
      <%# Uses the actual deposit date(s) (@deposit_verification_from/_to,
          derived in the controller from active deposits) rather than the
          DR's own business date, so a deposit recorded on a different day
          than the DR is still visible on arrival. %>
      <%= link_to t("finance.daily_reconciliations.show.sections.bank.view_verification"),
            finance_deposit_verifications_path(branch_id: @reconciliation.branch_id,
                                               from: @deposit_verification_from,
                                               to: @deposit_verification_to),
            class: "btn btn-ghost btn-sm" %>
    <% end %>
  </div>

  <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm);">

    <%# ── Bank statement comparison ─────────────────────────────────────── %>
    <%# The verification workflow only becomes active once the Branch Manager
        has approved the recorded deposit — before that the accountant has
        nothing settled yet to reconcile against an imported bank statement. ── %>
    <% if @can_view_deposit_verification && (@reconciliation.reviewed? || @reconciliation.verified?) %>
      <div style="padding: var(--space-4) var(--space-5); border-bottom: 1px solid var(--border);">
        <div class="recon-formula-row">
          <span><%= t("finance.daily_reconciliations.show.sections.bank.expected") %></span>
          <span class="recon-formula-row__value"><%= format_currency(@total_deposited) %></span>
        </div>
        <div class="recon-formula-row">
          <span><%= t("finance.daily_reconciliations.show.sections.bank.imported") %></span>
          <span class="recon-formula-row__value"><%= format_currency(@bank_imported_sum) %></span>
        </div>
        <div class="recon-formula-row recon-formula-row--total">
          <span><%= t("finance.daily_reconciliations.show.sections.bank.difference") %></span>
          <span class="recon-formula-row__value" style="color: <%= @bank_difference.abs < 0.01 ? 'var(--text-3)' : 'var(--warning)' %>;">
            <%= @bank_difference.abs < 0.01 ? "—" : format_currency(@bank_difference) %>
          </span>
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3);">
          <span class="badge badge-success"><%= t("finance.daily_reconciliations.show.sections.bank.matched", count: @bank_matched_count) %></span>
          <% if @bank_needs_review_count.positive? %>
            <span class="badge badge-warning"><%= t("finance.daily_reconciliations.show.sections.bank.needs_review", count: @bank_needs_review_count) %></span>
          <% end %>
          <% if @bank_missing_count.positive? %>
            <span class="badge badge-danger"><%= t("finance.daily_reconciliations.show.sections.bank.missing", count: @bank_missing_count) %></span>
          <% end %>
          <% if @bank_not_imported_count.positive? %>
            <span class="badge badge-neutral"><%= t("finance.daily_reconciliations.show.sections.bank.not_imported", count: @bank_not_imported_count) %></span>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# ── Direct (no-deposit-yet) disputes ──────────────────────────────
        Always rendered, independent of whether any TillDeposit exists yet —
        an ATM/POS "failed deposit" is reported instead of a deposit, so a DR
        with zero deposits can still have an open dispute here. ── %>
    <% direct_disputes = @reconciliation.bank_disputes.reject(&:resolved?) %>
    <% direct_disputes.each do |dispute| %>
      <div style="padding: var(--space-3) var(--space-5); border-bottom: 1px solid var(--border);">
        <div style="display: flex; justify-content: space-between; align-items: center; gap: var(--space-3);">
          <div>
            <p style="font-size: var(--text-sm); font-weight: 500; color: var(--text-1); margin: 0 0 2px;">
              <%= t("finance.bank_disputes.dr_section.atm_reported_by", name: dispute.opened_by.full_name) %>
            </p>
            <p style="font-size: var(--text-xs); color: var(--text-2); margin: 0;">
              <%= l(dispute.transaction_date, format: :long) %>
            </p>
          </div>
          <div style="display: flex; align-items: center; gap: var(--space-3);">
            <span style="font-size: var(--text-sm); font-weight: 600; font-variant-numeric: tabular-nums;">
              <%= format_currency(dispute.amount) %>
            </span>
            <%= render "finance/bank_disputes/badge", reconciliation: @reconciliation %>
          </div>
        </div>
      </div>
    <% end %>

    <%# ── Recorded deposits list (with void actions) ─────────────────────
        Iterates @all_deposits (includes voided, already eager-loaded with
        payment_method/deposited_by/voided_by in the controller) so a voided
        deposit still shows its original timestamp instead of disappearing.
        @total_deposited below stays scoped to active deposits only. ── %>
    <% if @all_deposits.empty? %>
      <p style="padding: var(--space-5); color: var(--text-2); font-size: var(--text-sm); margin: 0;">
        <%= t("finance.daily_reconciliations.show.no_deposits") %>
      </p>
    <% else %>
      <%
        # "تصحيح الإيداع" (Correct Deposit) is only offered on the most
        # recently voided deposit for a payment method, and only while that
        # method still has no active replacement — once a correction has been
        # recorded, active_pm_ids covers it and the action disappears on its
        # own. Both sets are built from @deposits/@all_deposits, already
        # loaded in the controller — no new query, no new business logic.
        active_pm_ids       = (@deposits || []).map(&:payment_method_id).to_set
        latest_voided_by_pm = @all_deposits.select(&:voided?)
                                            .group_by(&:payment_method_id)
                                            .transform_values { |ds| ds.max_by(&:voided_at) }
        can_create_deposit  = @i_am_depositor &&
                              (@reconciliation.closed? || @reconciliation.deposited?) &&
                              policy(TillDeposit.new(daily_reconciliation: @reconciliation)).create?
      %>
      <% @all_deposits.each do |deposit| %>
        <div style="padding: var(--space-3) var(--space-5); border-bottom: 1px solid var(--border); <%= 'opacity: 0.6;' if deposit.voided? %>">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-4);">
            <div style="min-width: 0;">
              <p style="font-size: var(--text-sm); font-weight: 500; color: var(--text-1); margin: 0 0 2px;">
                <%= deposit.payment_method.display_name %>
                <% if deposit.voided? %>
                  <span class="badge badge-danger" style="margin-inline-start: var(--space-2);"><%= t("finance.daily_reconciliations.show.sections.bank.voided_badge") %></span>
                <% end %>
                <% if deposit.open_bank_dispute %>
                  <span style="margin-inline-start: var(--space-2);"><%= render "finance/bank_disputes/badge", deposit: deposit %></span>
                <% end %>
              </p>
              <p style="font-size: var(--text-xs); color: var(--text-2); margin: 0;">
                <%= t("finance.daily_reconciliations.show.sections.bank.deposited_prefix") %>
                <%= l(deposit.deposited_at.to_date, format: :long) %> - <%= l(deposit.deposited_at, format: :time_only) %>
              </p>
              <% if deposit.deposited_by %>
                <p style="font-size: var(--text-xs); color: var(--text-2); margin: 0;">
                  <%= t("finance.daily_reconciliations.show.sections.bank.by_prefix") %> <%= deposit.deposited_by.full_name %>
                  <% if deposit.reference.present? %>· <%= deposit.reference %><% end %>
                </p>
              <% end %>
            </div>
            <div style="display: flex; align-items: center; gap: var(--space-3); flex-shrink: 0;">
              <span style="font-size: var(--text-sm); font-weight: 600; font-variant-numeric: tabular-nums; <%= 'text-decoration: line-through; color: var(--text-3);' if deposit.voided? %>">
                <%= format_currency(deposit.amount) %>
              </span>
              <% if !deposit.voided? && policy(deposit).void? && !@reconciliation.verified? %>
                <%= button_to void_till_deposit_path(deposit),
                      method: :patch,
                      params: { void_reason: "Voided during reconciliation review" },
                      class: "btn btn-danger btn-sm",
                      data: { turbo_confirm: t("common.are_you_sure") },
                      form_class: "inline" do %>
                  <%= t("common.void") %>
                <% end %>
              <% end %>

              <%# ── "تصحيح الإيداع" (Correct Deposit) — opens the normal Record
                  Deposit form pre-filled from this voided deposit's values.
                  Never touches this (or any) historical deposit; saving the
                  form creates a brand new TillDeposit through the same
                  Finance::TillDepositRecorder path as any other deposit. ── %>
              <% if deposit.voided? && can_create_deposit &&
                    active_pm_ids.exclude?(deposit.payment_method_id) &&
                    latest_voided_by_pm[deposit.payment_method_id] == deposit %>
                <%= link_to new_till_deposit_path(
                      daily_reconciliation_id: @reconciliation.id,
                      payment_method_id:       deposit.payment_method_id,
                      prefill_amount:          deposit.amount,
                      prefill_reference:       deposit.reference
                    ),
                    class: "btn btn-primary btn-sm",
                    data: { turbo_frame: "modal" } do %>
                  <%= t("finance.daily_reconciliations.show.sections.bank.correct_deposit_action") %>
                <% end %>
              <% end %>

              <% if deposit.active? && deposit.bank_statement_transactions.empty? && deposit.open_bank_dispute.blank? &&
                    policy(BankDispute.new(till_deposit: deposit)).create? %>
                <%= link_to t("finance.bank_disputes.report_button"),
                      new_finance_bank_dispute_path(till_deposit_id: deposit.id),
                      class: "btn btn-warning btn-sm",
                      data: { turbo_frame: "modal" } %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
      <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-3) var(--space-5); background: var(--surface-2);">
        <span style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1);">
          <%= t("finance.daily_reconciliations.show.total_deposited") %>
        </span>
        <span style="font-size: var(--text-base); font-weight: 700; color: var(--success); font-variant-numeric: tabular-nums;">
          <%= format_currency(@total_deposited) %>
        </span>
      </div>
    <% end %>
  </div>
</section>
