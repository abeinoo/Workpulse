<%#
  Redesigned per-DR workspace card. Locals: dr, can_bulk_settle, show_verification.
  All figures come from already-loaded associations / DailyReconciliation
  model methods — this partial only formats and lays them out.
%>
<%
  session     = dr.till_session
  holder      = session&.current_holder
  depositor   = session&.depositor
  outstanding = dr.remaining_deposit_balances.select(&:open?).sum(&:remaining_amount)
  has_balance = outstanding > 0

  bank_status = show_verification ? @bank_statuses_by_dr[dr] : nil
  open_disputes = show_verification ?
    dr.open_bank_disputes(preloaded_till_deposits: dr.till_deposits.select(&:active?)) : []

  status_color =
    if dr.verified?           then 'var(--success-rgb)'
    elsif dr.deposited?        then 'var(--accent-rgb)'
    elsif dr.waiting_for_opening? then 'var(--warning-rgb)'
    elsif dr.open?             then 'var(--accent-rgb)'
    elsif outstanding > 0      then 'var(--warning-rgb)'
    else                            'var(--text-3-rgb, 100,116,139)'
    end

  # Unified "Next Step" — single source of truth is
  # DailyReconciliation#workflow_progress, which replaces the old, separate
  # next_action_for + required_actions with ONE strictly sequential 8-step
  # workflow (opening float → close/handover → deposit → deposit review →
  # sales import → bank statement → POS import → documentation). Only ever
  # ONE action button anywhere on the card: the first incomplete step's
  # action, or nil if that step exists but the current user lacks
  # permission for it (never cascades to a lower-priority action — see the
  # model method's own comment) or if every step is already complete.
  workflow = dr.workflow_progress(current_user, bank_status: bank_status, open_disputes: open_disputes,
                                  sales_imported: show_verification && @sales_imported_dr_ids.include?(dr.id),
                                  pos_imported: show_verification && @pos_imported_dr_ids.include?(dr.id))
  workflow_current_key = workflow[:steps].find { |s| !s[:complete] }&.dig(:key)

  # Issue badges — surfaces only ACTIONABLE reconciliation problems directly on
  # the card, so a manager never has to open the DR just to notice one. Cash
  # Difference and the overall Sales Difference are deliberately NOT shown
  # here — both are already visible elsewhere and would only duplicate that
  # figure. Figures come from @employee_sales_issues_by_dr /
  # @pos_unmatched_count_by_dr / @sales_unmatched_count_by_dr /
  # @unmatched_bank_deposits_count_by_dr, precomputed once for the whole page
  # in Finance::DailyReconciliationsController#build_dr_issue_badges /
  # #build_employee_issue_badges — no new matching logic, no query here.
  # POS/Sales/Employee badges stay empty (hidden) unless the current user
  # holds the same permission the DR show page's own sections require.
  employee_sales_issues   = show_verification ? (@employee_sales_issues_by_dr[dr.id] || []) : []
  pos_unmatched_count     = show_verification ? (@pos_unmatched_count_by_dr || {})[dr.id] : nil
  sales_unmatched_count   = show_verification ? (@sales_unmatched_count_by_dr || {})[dr.id] : nil
  unmatched_deposits_count = show_verification ? @unmatched_bank_deposits_count_by_dr[dr] : nil

  issue_badges = []
  employee_sales_issues.each do |issue|
    issue_badges << { type: :employee, user: issue[:user], amount: issue[:amount] }
  end
  if pos_unmatched_count.to_i.positive?
    issue_badges << { type: :simple, label: t("finance.daily_reconciliations.index.issue_badges.pos_unmatched", count: pos_unmatched_count) }
  end
  if sales_unmatched_count.to_i.positive?
    issue_badges << { type: :simple, label: t("finance.daily_reconciliations.index.issue_badges.sales_unmatched", count: sales_unmatched_count) }
  end
  if unmatched_deposits_count.to_i.positive?
    issue_badges << { type: :simple, label: t("finance.daily_reconciliations.index.issue_badges.outstanding_deposit", count: unmatched_deposits_count) }
  end
%>

<div class="dr-card" style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm);">
  <div style="display: flex; align-items: stretch;">

    <%# Status stripe %>
    <div style="width: 4px; background: rgba(<%= status_color %>, 0.5); flex-shrink: 0; border-radius: var(--radius-lg) 0 0 var(--radius-lg);"></div>

    <div style="flex: 1; padding: var(--space-4) var(--space-5); display: flex; flex-direction: column; gap: var(--space-3); min-width: 0;">

      <div style="display: flex; align-items: center; gap: var(--space-4); flex-wrap: wrap;">

        <%# Settle-checkbox — outstanding balances bulk-settle only. ── %>
        <% if has_balance && can_bulk_settle %>
          <div style="flex-shrink: 0; display: flex; align-items: center;">
            <input type="checkbox"
                   class="dr-settle-checkbox"
                   data-dr-id="<%= dr.id %>"
                   data-amount="<%= outstanding %>"
                   style="width: 16px; height: 16px; cursor: pointer; accent-color: var(--warning, #ca8a04);"
                   aria-label="<%= t('finance.daily_reconciliations.index.select_settle_dr', date: dr.business_date ? l(dr.business_date, format: :short) : '—', branch: dr.branch.name) %>">
          </div>
        <% end %>

        <%# Branch + Business Date %>
        <div style="min-width: 140px; flex: 0 0 140px;">
          <span style="font-size: var(--text-base); font-weight: 700; color: var(--text-1);">
            <%= dr.branch.name %>
          </span>
          <p style="font-size: var(--text-xs); color: var(--text-2); margin: var(--space-1) 0 0;">
            <%= dr.business_date ? l(dr.business_date, format: :short) : l(dr.opened_at.to_date, format: :short) %>
          </p>
        </div>

        <%# DR-state status (unchanged) %>
        <div style="flex: 1; min-width: 200px;">
          <% if dr.waiting_for_opening? %>
            <div style="display: flex; align-items: center; gap: var(--space-2);">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--warning,#ca8a04)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span style="font-size: var(--text-sm); font-weight: 600; color: var(--warning,#ca8a04);">
                <%= t("finance.daily_reconciliations.index.status_awaiting_opening") %>
              </span>
            </div>
            <p style="font-size: var(--text-xs); color: var(--text-3); margin: var(--space-1) 0 0;">
              <%= t("finance.daily_reconciliations.index.awaiting_opening_hint") %>
            </p>

          <% elsif dr.open? %>
            <div style="display: flex; align-items: center; gap: var(--space-2);">
              <span class="badge badge-success"><%= t("finance.daily_reconciliations.index.status_open") %></span>
            </div>
            <% if holder %>
              <p style="font-size: var(--text-xs); color: var(--text-2); margin: var(--space-1) 0 0;">
                <%= t("finance.daily_reconciliations.index.held_by", name: holder.full_name) %>
              </p>
            <% end %>

          <% elsif dr.closed? %>
            <span class="badge badge-neutral"><%= t("finance.daily_reconciliations.index.status_awaiting_deposit") %></span>
            <% if depositor %>
              <p style="font-size: var(--text-xs); color: var(--text-2); margin: var(--space-1) 0 0;">
                <%= t("finance.daily_reconciliations.index.depositor_label", name: depositor.full_name) %>
              </p>
            <% end %>

          <% elsif dr.deposited? && !dr.reviewed? %>
            <span class="badge badge-warning"><%= t("finance.daily_reconciliations.index.status_waiting_branch_deposit_review") %></span>

          <% elsif dr.deposited? && dr.reviewed? %>
            <span class="badge badge-accent"><%= t("finance.daily_reconciliations.index.status_waiting_accounting_approval") %></span>

          <% elsif dr.verified? %>
            <span class="badge badge-success" style="display: inline-flex; align-items: center; gap: 4px;">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              <%= t("finance.daily_reconciliations.index.status_verified") %>
            </span>
          <% end %>
        </div>

        <%# Bank Statement workflow — SECONDARY info, deliberately not another
            full-weight badge next to the primary DR-workflow status above.
            A small colored dot + plain text, no pill/border/background, so
            it reads as supporting detail rather than a second competing
            status. See ApplicationHelper#bank_status_summary — collapses
            the 8 granular matching states (still used as-is for the filter
            dropdown / detailed legend elsewhere) into a 4-state summary
            that is PURELY about bank matching progress, with no reference
            to the DR's own approval state — the primary badge above owns
            that wording, so the two can never show the same phrase for
            different reasons again. ── %>
        <% if show_verification %>
          <% summary_status = bank_status_summary(bank_status) %>
          <% color = bank_status_summary_color(summary_status) %>
          <%= link_to finance_daily_reconciliation_path(dr, anchor: "bank-deposits"),
                style: "display: inline-flex; align-items: center; gap: 5px; font-size: var(--text-xs); font-weight: 500; text-decoration: none; white-space: nowrap; color: var(--text-2);" do %>
            <span style="width: 6px; height: 6px; border-radius: 50%; background: <%= color %>; flex-shrink: 0;"></span>
            <%= t("finance.daily_reconciliations.index.bank_status_summary.#{summary_status}") %>
          <% end %>

          <%
            matched_count = dr.bank_reconciliation_deposits_matched_count
            total_count   = dr.bank_reconciliation_deposits_total_count
          %>
          <% if total_count.positive? %>
            <span style="font-size: 10px; color: <%= matched_count == total_count ? 'var(--success,#16a34a)' : 'var(--text-3)' %>; white-space: nowrap;">
              <%= t("finance.daily_reconciliations.index.bank_status_progress.#{matched_count == total_count ? 'complete' : 'pending'}",
                    matched: matched_count, total: total_count) %>
            </span>
          <% end %>

          <% if open_disputes.any? %>
            <span class="badge" style="background: var(--warning,#ca8a04); color: #fff; font-size: 10px;">
              <%= t("finance.bank_disputes.badge_label") %> · <%= open_disputes.size %>
            </span>
          <% end %>
        <% end %>

        <%# View link — the single Next Step action button lives in its own
            section below, not here; this row now only ever offers View. ── %>
        <div style="flex: 0 0 auto; margin-inline-start: auto; display: flex; gap: var(--space-2);">
          <%= link_to finance_daily_reconciliation_path(dr),
                style: "display: inline-flex; align-items: center; gap: var(--space-1); font-size: var(--text-sm); font-weight: 500; color: var(--accent); text-decoration: none; padding: var(--space-2) var(--space-3); border-radius: var(--radius); border: 1px solid rgba(var(--accent-rgb), 0.25); background: rgba(var(--accent-rgb), 0.06);" do %>
            <%= t("finance.daily_reconciliations.index.view") %>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
          <% end %>
        </div>
      </div>

      <%# Issue badges — surfaced right under the Branch/Date information so a
          manager can spot a problematic reconciliation without opening it.
          Wraps onto multiple lines automatically via flex-wrap. Reuses the
          existing .badge component + warning palette already used throughout
          Finance (same badge-warning styling as the Open Disputes badge
          above). ── %>
      <% if issue_badges.any? %>
        <div style="display: flex; flex-wrap: wrap; gap: var(--space-2);">
          <% issue_badges.each do |issue| %>
            <% if issue[:type] == :employee %>
              <span class="badge badge-warning" style="display: inline-flex; flex-direction: column; align-items: flex-start; gap: 2px; padding-block: 6px; line-height: 1.3;">
                <span>👤 <%= issue[:user].full_name %></span>
                <span style="font-variant-numeric: tabular-nums;">
                  <%= t("finance.daily_reconciliations.index.issue_badges.employee_sales_difference_label") %>: <%= format_currency(issue[:amount]) %>
                </span>
              </span>
            <% else %>
              <span class="badge badge-warning" style="white-space: nowrap;">
                <%= issue[:label] %>
              </span>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <%# Amount fields — only for users who can see bank verification. ── %>
      <% if show_verification %>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: var(--space-3); padding: var(--space-3); background: var(--surface-2); border-radius: var(--radius);">
          <div>
            <p style="font-size: 10px; color: var(--text-3); margin: 0;"><%= t("finance.daily_reconciliations.index.workspace.card_expected") %></p>
            <p style="font-size: var(--text-sm); font-weight: 700; font-variant-numeric: tabular-nums; margin: 0;"><%= format_currency(dr.expected_cash_deposit) %></p>
          </div>
          <div>
            <p style="font-size: 10px; color: var(--text-3); margin: 0;"><%= t("finance.daily_reconciliations.index.workspace.card_deposited") %></p>
            <p style="font-size: var(--text-sm); font-weight: 700; font-variant-numeric: tabular-nums; margin: 0; color: var(--success);"><%= format_currency(dr.total_deposited) %></p>
          </div>
          <div>
            <p style="font-size: 10px; color: var(--text-3); margin: 0;"><%= t("finance.daily_reconciliations.index.workspace.card_matched") %></p>
            <p style="font-size: var(--text-sm); font-weight: 700; font-variant-numeric: tabular-nums; margin: 0; color: #3b82f6;"><%= format_currency(dr.total_matched_amount) %></p>
          </div>
          <div>
            <p style="font-size: 10px; color: var(--text-3); margin: 0;"><%= t("finance.daily_reconciliations.index.workspace.card_remaining") %></p>
            <p style="font-size: var(--text-sm); font-weight: 700; font-variant-numeric: tabular-nums; margin: 0; color: <%= dr.pending_deposit_amount.positive? ? 'var(--warning,#ca8a04)' : 'var(--text-3)' %>;"><%= format_currency(dr.pending_deposit_amount) %></p>
          </div>
          <div>
            <p style="font-size: 10px; color: var(--text-3); margin: 0;"><%= t("finance.daily_reconciliations.index.workspace.card_outstanding") %></p>
            <p style="font-size: var(--text-sm); font-weight: 700; font-variant-numeric: tabular-nums; margin: 0; color: <%= outstanding.positive? ? 'var(--warning,#ca8a04)' : 'var(--text-3)' %>;"><%= format_currency(outstanding) %></p>
          </div>
        </div>
      <% end %>

      <%# ── Unified "Next Step" — replaces the old separate Next Action +
          Required Actions widgets with ONE progress indicator and ONE
          action button, driven entirely by DailyReconciliation#workflow_progress.
          Never more than one button on the whole card. ── %>
      <div style="display: flex; flex-direction: column; gap: var(--space-2); padding-top: var(--space-2); border-top: 1px solid var(--border);">
        <div style="display: flex; flex-wrap: wrap; gap: 4px 10px;">
          <% workflow[:steps].each do |step| %>
            <%
              is_current = step[:key] == workflow_current_key
              color = if step[:complete] then 'var(--success,#16a34a)'
                      elsif is_current    then 'var(--warning,#ca8a04)'
                      else                     'var(--text-3)'
                      end
            %>
            <span style="font-size: 10px; font-weight: <%= is_current ? '700' : '500' %>; color: <%= color %>; white-space: nowrap;">
              <%= step[:complete] ? "✓" : "○" %> <%= step[:label] %>
            </span>
          <% end %>
        </div>

        <% if workflow_current_key.nil? %>
          <span style="font-size: var(--text-sm); font-weight: 600; color: var(--success,#16a34a); display: inline-flex; align-items: center; gap: 6px;">
            ✓ <%= t("finance.daily_reconciliations.index.workspace.workflow.completed") %>
          </span>
        <% elsif workflow[:action] %>
          <div>
            <p style="font-size: 10px; color: var(--text-3); margin: 0 0 4px;">
              <%= t("finance.daily_reconciliations.index.workspace.workflow.title") %>
            </p>
            <%= link_to workflow[:action][:label], workflow[:action][:path], class: workflow[:action][:style] %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
