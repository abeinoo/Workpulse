    <%# ── Audit timeline ─────────────────────────────────────────────────── %>
    <%# Architecture:
        - Events are built in Finance::DailyReconciliationsController#build_timeline_events
        - To add a new event type: push a hash there, add it to a stage_def below, add a `when` block
        - Every event hash: { type: Symbol, time: Time, actor: User|nil, data: AR record }
        - Expanded detail panels: each `when` block owns its own detail panel markup;
          future features (expenses, adjustments, comments) add new `when` blocks without
          touching existing ones.
    %>
    <% if @timeline_events.any? %>
      <%
        base_date  = @reconciliation.opened_at.to_date
        # Close time is the moment the day_closed event fired (self-deposit handover).
        close_event = @timeline_events.find { |e| e[:type] == :day_closed }
        close_time  = close_event&.dig(:time)

        # Returns a short relative-to-close label ("12 min before close") or nil.
        close_label = ->(t) {
          next nil unless close_time
          diff_min = ((close_time - t) / 60.0).round
          next nil if diff_min.abs < 2
          if diff_min > 0
            count = diff_min < 60 ? "#{diff_min} min" : "#{(diff_min / 60.0).ceil} hr"
            I18n.t("finance.daily_reconciliations.show.timeline.before_close", count: count)
          else
            count = diff_min.abs < 60 ? "#{diff_min.abs} min" : "#{(diff_min.abs / 60.0).ceil} hr"
            I18n.t("finance.daily_reconciliations.show.timeline.after_close", count: count)
          end
        }

        # Stage definitions — controls visual grouping and connector scope.
        # Order matters: stages render top-to-bottom.
        # Add a new event type to exactly one stage; empty stages are hidden.
        stage_defs = [
          { key: :opening_float, types: %i[opening_float_received opening_float_superseded opening_float_corrected] },
          { key: :during_day,    types: %i[handover_created handover_accepted handover_cancelled handover_rejected
                                           handover_reversed handover_reversal_applied handover_adjusted
                                           till_refund_recorded] },
          { key: :end_of_day,    types: %i[day_closed opening_float_prepared opening_float_left deposit_assigned deposit_cancelled deposit_rejected
                                           review_completed review_cancelled review_auto_cancelled] },
          { key: :deposit,       types: %i[deposit_accepted deposit_responsibility_transferred deposit_recorded deposit_voided deposit_review_overridden
                                            remaining_created remaining_settled remaining_reassigned
                                            remaining_written_off remaining_adjusted bank_dispute_activity] },
          { key: :session_edit,  types: %i[session_totals_edited day_close_edited] },
          { key: :verification,  types: %i[day_verified] },
        ]

        # Per-type visual config. lbl = locale key under timeline.label_*
        tl_cfg = {
          handover_created:  {
            dot: "var(--accent)", lbl: "label_till_handover",
            lc: "var(--accent)", lb: "rgba(var(--accent-rgb,99,102,241),0.10)",
            icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0 4.5-4.5M3 16.5h13.5m0-9L21 3m0 0-4.5 4.5M21 3H7.5"/>',
