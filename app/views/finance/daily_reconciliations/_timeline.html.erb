        # Shared inline style fragments used in detail panels.
        dl_row  = "display: flex; gap: var(--space-4); margin-bottom: var(--space-1); align-items: baseline;"
        dl_lbl  = "font-size: 11px; color: var(--text-3); min-width: 120px; flex-shrink: 0;"
        dl_val  = "font-size: 11px; color: var(--text-1); font-weight: 500;"
        cur_fmt = { unit: "", separator: ".", delimiter: "," }
      %>
      <section id="audit-log" class="recon-section" data-controller="accordion" data-accordion-key-value="audit-log">
        <%# Section header with description %>
        <div class="dashboard-section__header recon-accordion__header">
          <div class="recon-accordion__trigger" data-accordion-target="trigger" data-action="click->accordion#toggle keydown.enter->accordion#toggle keydown.space->accordion#toggle" role="button" tabindex="0" aria-expanded="false">
            <span class="recon-accordion__chevron" data-accordion-target="icon" aria-hidden="true">▶</span>
            <div>
              <h2 class="dashboard-section__title" style="margin-bottom: var(--space-1);">
                <%= t("finance.daily_reconciliations.show.timeline_title") %>
              </h2>
              <p style="font-size: var(--text-xs); color: var(--text-2); margin: 0;">
                <%= t("finance.daily_reconciliations.show.timeline.description") %>
              </p>
            </div>
          </div>
        </div>

        <div class="recon-accordion__panel" data-accordion-target="content">
        <div class="recon-accordion__panel-inner">
        <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-5); box-shadow: var(--shadow-sm);">

          <% stage_groups.each_with_index do |(stage_key, stage_events), si| %>

            <% if si > 0 %>
              <div style="margin: var(--space-5) 0 var(--space-4);">
                <div style="height: 1px; background: var(--border);"></div>
              </div>
            <% end %>

            <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-4);">
              <span style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.10em; color: var(--text-3); white-space: nowrap;">
                <%= t("finance.daily_reconciliations.show.timeline.stage_#{stage_key}") %>
              </span>
              <div style="flex: 1; height: 1px; background: var(--border);"></div>
            </div>

            <% stage_events.each_with_index do |item, ei| %>
              <% cfg             = tl_cfg[item[:type]] %>
              <% next unless cfg %>
              <% is_last         = ei == stage_events.size - 1 %>
              <% on_next_day     = item[:time].to_date != base_date %>
              <% rel_label       = close_label.call(item[:time]) %>

              <div data-controller="timeline-event"
                   style="display: flex; gap: var(--space-3); align-items: flex-start; position: relative; padding-bottom: <%= is_last ? '0' : 'var(--space-5)' %>;">

                <% unless is_last %>
                  <div style="position: absolute; inset-inline-start: calc(60px + var(--space-3) + 15px); top: 28px; bottom: 0; width: 2px; background: var(--border); z-index: 0;"></div>
                <% end %>

                <%# Timestamp column: absolute time + relative context %>
                <div style="flex-shrink: 0; width: 60px; text-align: end; padding-top: 6px; line-height: 1.3;">
                  <span style="font-size: 11px; color: var(--text-2); font-variant-numeric: tabular-nums; font-weight: 500;">
                    <%= l(item[:time], format: :time_only) %>
                  </span>
                  <% if on_next_day %>
                    <span style="display: block; font-size: 10px; color: var(--warning,#ca8a04); font-weight: 600; line-height: 1.2; margin-top: 2px;">
                      <%= t("finance.daily_reconciliations.show.timeline.next_day") %>
                    </span>
                  <% end %>
                  <% if rel_label %>
                    <span style="display: block; font-size: 10px; color: var(--text-3); line-height: 1.2; margin-top: 2px; font-style: italic;">
                      (<%= rel_label %>)
                    </span>
                  <% end %>
                </div>

                <%# Icon dot %>
                <div style="flex-shrink: 0; width: 30px; height: 30px; border-radius: 50%; background: <%= cfg[:dot] %>; display: flex; align-items: center; justify-content: center; z-index: 1;">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <%= cfg[:icon].html_safe %>
                  </svg>
                </div>

                <%# Event content column %>
                <div style="flex: 1; min-width: 0; padding-top: 4px;">

                  <%# Header row: type chip + expand toggle %>
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                    <span style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: <%= cfg[:lc] %>; background: <%= cfg[:lb] %>; border-radius: 4px; padding: 1px 6px;">
                      <%= t("finance.daily_reconciliations.show.timeline.#{cfg[:lbl]}") %>
                      <% if item[:type] == :remaining_settled && item[:payment_method] %>
                        (<%= item[:payment_method].display_name %>)
                      <% end %>
                    </span>
                    <button data-action="click->timeline-event#toggle"
                            style="background: none; border: none; cursor: pointer; padding: 2px; color: var(--text-3); display: flex; align-items: center; border-radius: var(--radius-sm);"
                            title="<%= t("finance.daily_reconciliations.show.timeline.expand_hint") %>">
                      <svg data-timeline-event-target="chevron"
                           style="transition: transform 0.15s ease;"
                           width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                      </svg>
                    </button>
                  </div>

                  <%# ── Story sentence + collapsed preview (per event type) ── %>
                  <% case item[:type]
                  when :handover_created %>
                    <% h = item[:data] %>
                    <% h_adjustments = @adjustments_by_handover_id[h.id] || [] %>
                    <p style="font-size: var(--text-sm); font-weight: 600; color: var(--text-1); margin: 0 0 4px; display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-1);">
                      <%= t("finance.daily_reconciliations.show.timeline.handover_created",
                            from: h.from_user.full_name, to: h.to_user&.full_name || "—") %>
                      <% if h.reversed? %>
                        <span style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--danger,#dc2626); background: rgba(220,38,38,0.10); border-radius: 4px; padding: 1px 6px;">
                          <%= t("finance.daily_reconciliations.show.timeline.detail.label_reversed_badge") %>
                        </span>
                      <% elsif h.cancelled? %>
                        <span style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-3); background: var(--surface-2); border-radius: 4px; padding: 1px 6px;">
                          <%= t("finance.daily_reconciliations.show.cancelled_badge") %>
                        </span>
                      <% elsif !h.accepted? %>
                        <span class="badge badge-neutral" style="font-size: 10px;">
                          <%= t("finance.daily_reconciliations.show.pending_badge") %>
                        </span>
                      <% end %>
                      <% if h_adjustments.any? %>
                        <span style="font-size: 10px; font-weight: 700; color: var(--accent); background: rgba(var(--accent-rgb,99,102,241),0.10); border-radius: 4px; padding: 1px 6px;">
                          <%= t("finance.daily_reconciliations.show.adjusted_badge", count: h_adjustments.size) %>
                        </span>
                      <% end %>
                    </p>
                    <% operational = h.amounts.select { |a| a.kind == "operational" }.reject { |a| a.collected_amount.zero? && a.refund_amount.zero? } %>
                    <% if operational.any? %>
                      <div style="display: flex; flex-wrap: wrap; gap: var(--space-1); margin-bottom: var(--space-1);">
                        <% operational.each do |amt| %>
                          <span style="font-size: 11px; background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 2px 7px; color: var(--text-2);">
                            <%= amt.payment_method_name %>: <strong style="color: var(--text-1);"><%= number_to_currency(amt.net_amount, **cur_fmt) %></strong>
                          </span>
                        <% end %>
                      </div>
                    <% end %>

                    <%# Expanded detail panel %>
                    <div data-timeline-event-target="detail" hidden
                         style="margin-top: var(--space-3); padding: var(--space-3) var(--space-4); background: var(--surface-2); border-radius: var(--radius); border: 1px solid var(--border);">
                      <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-3); border-bottom: 1px solid var(--border); padding-bottom: var(--space-2); margin-bottom: var(--space-3);">
                        <%= t("finance.daily_reconciliations.show.timeline.detail.ref_handover", id: h.id) %>
                      </div>
                      <% if h.from_notes.present? %>
                        <div style="<%= dl_row %>">
                          <span style="<%= dl_lbl %>"><%= t("finance.daily_reconciliations.show.timeline.detail.label_notes") %></span>
                          <span style="<%= dl_val %>; font-style: italic;"><%= h.from_notes %></span>
                        </div>
                      <% end %>
                      <% if h.accepted_notes.present? %>
                        <div style="<%= dl_row %>">
                          <span style="<%= dl_lbl %>"><%= t("finance.daily_reconciliations.show.timeline.detail.label_accepted_notes") %></span>
                          <span style="<%= dl_val %>; font-style: italic;"><%= h.accepted_notes %></span>
                        </div>
                      <% end %>
                      <% all_amounts = h.amounts.reject { |a| a.collected_amount.zero? && a.refund_amount.zero? } %>
                      <% if all_amounts.any? %>
                        <div style="margin-top: var(--space-2); border-top: 1px solid var(--border); padding-top: var(--space-2);">
                          <div style="font-size: 10px; color: var(--text-3); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--space-2);">
                            <%= t("finance.daily_reconciliations.show.timeline.detail.label_amounts") %>
                          </div>
                          <% all_amounts.each do |amt| %>
                            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 11px; padding: 2px 0; border-bottom: 1px dashed var(--border);">
                              <span style="color: var(--text-2);">
                                <%= amt.payment_method_name %>
                                <% if amt.kind != "operational" %>
                                  <span style="font-size: 10px; color: var(--text-3);">(<%= amt.kind %>)</span>
                                <% end %>
                              </span>
                              <div style="display: flex; gap: var(--space-3); align-items: center;">
                                <% if amt.refund_amount > 0 %>
                                  <span style="color: var(--danger,#dc2626); font-size: 10px;">− <%= number_to_currency(amt.refund_amount, **cur_fmt) %></span>
                                <% end %>
                                <span style="font-weight: 600; color: var(--text-1);"><%= number_to_currency(amt.net_amount, **cur_fmt) %></span>
                              </div>
                            </div>
                          <% end %>
                        </div>
                      <% end %>
                      <%# SLOT: photos, documents, manager comments — rendered here by future features %>
                    </div>

                  <% when :handover_accepted %>
                    <% h = item[:data] %>
                    <% h_adjustments = @adjustments_by_handover_id[h.id] || [] %>
                    <p style="font-size: var(--text-sm); font-weight: 600; color: var(--text-1); margin: 0 0 4px; display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-1);">
                      <%= t("finance.daily_reconciliations.show.timeline.handover_accepted",
                            name: h.to_user.full_name, from: h.from_user.full_name) %>
                      <% if h.reversed? %>
                        <span style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--danger,#dc2626); background: rgba(220,38,38,0.10); border-radius: 4px; padding: 1px 6px;">
                          <%= t("finance.daily_reconciliations.show.timeline.detail.label_reversed_badge") %>
                        </span>
                      <% end %>
                      <% if h_adjustments.any? %>
                        <span style="font-size: 10px; font-weight: 700; color: var(--accent); background: rgba(var(--accent-rgb,99,102,241),0.10); border-radius: 4px; padding: 1px 6px;">
                          <%= t("finance.daily_reconciliations.show.adjusted_badge", count: h_adjustments.size) %>
                        </span>
                      <% end %>
                    </p>

                    <%# Manager correction actions — visible in collapsed state, not buried in details %>
                    <% unless h.reversed? || h.reversal? %>
                      <% can_reverse = policy(h).reverse? %>
                      <% can_adjust  = policy(h).adjust? %>
                      <% if can_reverse || can_adjust %>
                        <div style="display: flex; gap: var(--space-2); margin-top: var(--space-2); margin-bottom: var(--space-1);">
                          <% if can_reverse %>
                            <%= link_to reverse_form_till_handover_path(h),
                                  class: "btn btn-ghost btn-sm",
                                  data:  { turbo_frame: "modal" },
                                  style: "display: inline-flex; align-items: center; gap: var(--space-1);" do %>
                              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3"/></svg>
                              <%= t("till_handovers.action_reverse") %>
                            <% end %>
                          <% end %>
                          <% if can_adjust %>
                            <%= link_to new_adjustment_till_handover_path(h),
                                  class: "btn btn-ghost btn-sm",
                                  data:  { turbo_frame: "modal" },
                                  style: "display: inline-flex; align-items: center; gap: var(--space-1);" do %>
                              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z"/></svg>
                              <%= t("till_handovers.action_adjust") %>
                            <% end %>
                          <% end %>
                        </div>
                      <% end %>
                    <% end %>

                    <div data-timeline-event-target="detail" hidden
                         style="margin-top: var(--space-3); padding: var(--space-3) var(--space-4); background: var(--surface-2); border-radius: var(--radius); border: 1px solid var(--border);">
                      <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-3); border-bottom: 1px solid var(--border); padding-bottom: var(--space-2); margin-bottom: var(--space-3);">
                        <%= link_to till_handover_path(h),
                              style: "color: inherit; text-decoration: none; border-bottom: 1px dashed currentColor;" do %>
                          <%= t("finance.daily_reconciliations.show.timeline.detail.ref_handover", id: h.id) %>
                        <% end %>
                      </div>
                      <div style="<%= dl_row %>">
                        <span style="<%= dl_lbl %>"><%= t("finance.daily_reconciliations.show.timeline.detail.label_originally_by") %></span>
                        <span style="<%= dl_val %>"><%= h.from_user.full_name %></span>
                      </div>
                      <div style="<%= dl_row %>">
                        <span style="<%= dl_lbl %>"><%= t("finance.daily_reconciliations.show.timeline.detail.label_accepted_at") %></span>
                        <span style="<%= dl_val %>"><%= l(h.accepted_at, format: :long) %></span>
                      </div>
                      <% if h.accepted_notes.present? %>
                        <div style="<%= dl_row %>">
                          <span style="<%= dl_lbl %>"><%= t("finance.daily_reconciliations.show.timeline.detail.label_notes") %></span>
                          <span style="<%= dl_val %>; font-style: italic;"><%= h.accepted_notes %></span>
                        </div>
                      <% end %>
                      <% if h.reversed? %>
                        <div style="margin-top: var(--space-2); padding: var(--space-2) var(--space-3);
                                    background: rgba(220,38,38,0.07); border-radius: var(--radius-sm);
                                    font-size: var(--text-xs); color: var(--danger,#dc2626); font-weight: 600;">
                          <%= t("finance.daily_reconciliations.show.timeline.detail.label_reversed_badge") %>
                          <span style="font-weight: 400; color: var(--text-2); margin-inline-start: var(--space-1);">
                            <%= h.reversal_reason %>
                          </span>
                        </div>
                      <% end %>
                      <%# Adjustment history for this handover %>
                      <% if h_adjustments.any? %>
                        <div style="margin-top: var(--space-3); border-top: 1px solid var(--border); padding-top: var(--space-3);">
                          <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-3); margin-bottom: var(--space-2);">
                            <%= t("finance.daily_reconciliations.show.timeline.detail.label_adjustment_history") %>
                          </div>
                          <% h_adjustments.each do |adj| %>
                            <div style="border: 1px solid var(--border); border-radius: var(--radius-sm); padding: var(--space-2) var(--space-3); margin-bottom: var(--space-2); background: var(--surface);">
                              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--space-1);">
                                <span style="font-size: 11px; font-weight: 600; color: var(--text-1);">
                                  <%= t("till_handovers.adjustment_reasons.#{adj.reason_code}", default: adj.reason_code) %>
                                </span>
                                <span style="font-size: 10px; color: var(--text-3);">
                                  <%= l(adj.created_at, format: :long) %>
                                </span>
                              </div>
                              <div style="font-size: 11px; color: var(--text-2); margin-bottom: var(--space-1);">
                                <%= adj.actor.full_name %>
                              </div>
                              <div style="font-size: 11px; color: var(--text-2); font-style: italic;"><%= adj.notes %></div>
                              <% if adj.before_data.present? && adj.after_data.present? %>
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); margin-top: var(--space-2); font-size: 10px;">
                                  <div>
                                    <div style="font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-3); margin-bottom: 2px;">
                                      <%= t("finance.daily_reconciliations.show.timeline.detail.label_before") %>
                                    </div>
                                    <% Array(adj.before_data).each do |entry| %>
                                      <div style="color: var(--text-2);">
                                        <%= entry["payment_method_name"] %>:
                                        <strong style="color: var(--text-1);">
                                          <%= number_to_currency(entry["collected_amount"].to_d - entry["refund_amount"].to_d, **cur_fmt) %>
                                        </strong>
                                      </div>
                                    <% end %>
                                  </div>
                                  <div>
                                    <div style="font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent); margin-bottom: 2px;">
                                      <%= t("finance.daily_reconciliations.show.timeline.detail.label_after") %>
                                    </div>
                                    <% Array(adj.after_data).each do |entry| %>
                                      <div style="color: var(--text-2);">
                                        <%= entry["payment_method_name"] || entry["payment_method_id"] %>:
                                        <strong style="color: var(--text-1);">
                                          <%= number_to_currency(entry["collected_amount"].to_d - entry["refund_amount"].to_d, **cur_fmt) %>
                                        </strong>
                                      </div>
                                    <% end %>
                                  </div>
                                </div>
                              <% end %>
                            </div>
                          <% end %>
                        </div>
                      <% end %>
                    </div>

                  <% when :day_closed %>
                    <% h = item[:data] %>
                    <p style="font-size: var(--text-sm); font-weight: 600; color: var(--text-1); margin: 0 0 var(--space-1);">
                      <%= t("finance.daily_reconciliations.show.timeline.day_closed", name: h.from_user.full_name) %>
                    </p>
                    <span style="display: inline-flex; align-items: center; gap: 4px; font-size: 10px; font-weight: 700; color: var(--success,#16a34a); background: rgba(var(--success-rgb,22,163,74),0.10); border: 1px solid rgba(var(--success-rgb,22,163,74),0.25); border-radius: 99px; padding: 2px 9px; margin-bottom: var(--space-1);">
                      <svg width="7" height="7" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><circle cx="5" cy="5" r="5"/></svg>
                      <%= t("finance.daily_reconciliations.show.final_holder_badge") %>
                    </span>
                    <% operational = h.amounts.select { |a| a.kind == "operational" }.reject { |a| a.collected_amount.zero? && a.refund_amount.zero? } %>
                    <% if operational.any? %>
                      <div style="display: flex; flex-wrap: wrap; gap: var(--space-1); margin-top: var(--space-1);">
                        <% operational.each do |amt| %>
                          <span style="font-size: 11px; background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 2px 7px; color: var(--text-2);">
                            <%= amt.payment_method_name %>: <strong style="color: var(--text-1);"><%= number_to_currency(amt.net_amount, **cur_fmt) %></strong>
                          </span>
                        <% end %>
                      </div>
                    <% end %>
                    <% if @can_edit_day_close_amounts %>
                      <%= link_to t("finance.daily_reconciliations.show.timeline.edit_day_close_link"),
                            edit_day_close_amounts_finance_daily_reconciliation_path(@reconciliation),
                            style: "display: inline-block; margin-top: var(--space-2); font-size: 11px; font-weight: 600; color: var(--accent);" %>
                    <% end %>

                    <div data-timeline-event-target="detail" hidden
                         style="margin-top: var(--space-3); padding: var(--space-3) var(--space-4); background: var(--surface-2); border-radius: var(--radius); border: 1px solid var(--border);">
                      <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-3); border-bottom: 1px solid var(--border); padding-bottom: var(--space-2); margin-bottom: var(--space-3);">
                        <%= t("finance.daily_reconciliations.show.timeline.detail.ref_handover", id: h.id) %>
                      </div>
                      <% if h.from_notes.present? %>
                        <div style="<%= dl_row %>">
                          <span style="<%= dl_lbl %>"><%= t("finance.daily_reconciliations.show.timeline.detail.label_notes") %></span>
                          <span style="<%= dl_val %>; font-style: italic;"><%= h.from_notes %></span>
                        </div>
                      <% end %>
                      <% if h.float_amount.present? && h.float_amount > 0 %>
                        <div style="<%= dl_row %>">
                          <span style="<%= dl_lbl %>"><%= t("finance.daily_reconciliations.show.timeline.detail.label_float") %></span>
                          <span style="<%= dl_val %>"><%= number_to_currency(h.float_amount, **cur_fmt) %></span>
                        </div>
                      <% end %>
                      <% all_amounts = h.amounts.reject { |a| a.collected_amount.zero? && a.refund_amount.zero? } %>
                      <% if all_amounts.any? %>
                        <div style="margin-top: var(--space-2); border-top: 1px solid var(--border); padding-top: var(--space-2);">
                          <div style="font-size: 10px; color: var(--text-3); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--space-2);">
                            <%= t("finance.daily_reconciliations.show.timeline.detail.label_amounts") %>
                          </div>
                          <% all_amounts.each do |amt| %>
                            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 11px; padding: 2px 0; border-bottom: 1px dashed var(--border);">
                              <span style="color: var(--text-2);">
                                <%= amt.payment_method_name %>
                                <% if amt.kind != "operational" %>
                                  <span style="font-size: 10px; color: var(--text-3);">(<%= amt.kind %>)</span>
                                <% end %>
                              </span>
                              <div style="display: flex; gap: var(--space-3); align-items: center;">
                                <% if amt.refund_amount > 0 %>
                                  <span style="color: var(--danger,#dc2626); font-size: 10px;">− <%= number_to_currency(amt.refund_amount, **cur_fmt) %></span>
                                <% end %>
                                <span style="font-weight: 600; color: var(--text-1);"><%= number_to_currency(amt.net_amount, **cur_fmt) %></span>
                              </div>
                            </div>
                          <% end %>
                        </div>
                      <% end %>
                      <%# SLOT: photos, documents, manager comments — rendered here by future features %>
                    </div>

                  <% when :deposit_assigned %>
                    <% drt = item[:data] %>
                    <p style="font-size: var(--text-sm); font-weight: 600; color: var(--text-1); margin: 0;">
                      <% if drt.initiated_by %>
                        <%= t("finance.daily_reconciliations.show.timeline.deposit_transfer_requested",
                              from: drt.from_user.full_name, to: drt.to_user.full_name, actor: drt.initiated_by.full_name) %>
                      <% else %>
                        <%= t("finance.daily_reconciliations.show.timeline.deposit_assigned",
                              actor: drt.from_user.full_name, name: drt.to_user.full_name) %>
                      <% end %>
                    </p>
                    <% if drt.notes.present? %>
                      <p style="font-size: var(--text-xs); color: var(--text-2); margin: var(--space-1) 0 0; font-style: italic; overflow-wrap: anywhere;"><%= drt.notes %></p>
                    <% end %>

                    <div data-timeline-event-target="detail" hidden
                         style="margin-top: var(--space-3); padding: var(--space-3) var(--space-4); background: var(--surface-2); border-radius: var(--radius); border: 1px solid var(--border);">
                      <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-3); border-bottom: 1px solid var(--border); padding-bottom: var(--space-2); margin-bottom: var(--space-3);">
                        <%= t("finance.daily_reconciliations.show.timeline.detail.ref_transfer", id: drt.id) %>
                      </div>
                      <div style="<%= dl_row %>">
                        <span style="<%= dl_lbl %>"><%= t("finance.daily_reconciliations.show.timeline.detail.label_assigned_by") %></span>
                        <span style="<%= dl_val %>"><%= drt.requester.full_name %></span>
                      </div>
                      <% if drt.initiated_by %>
                        <div style="<%= dl_row %>">
                          <span style="<%= dl_lbl %>"><%= t("finance.daily_reconciliations.show.timeline.detail.label_previous_depositor") %></span>
                          <span style="<%= dl_val %>"><%= drt.from_user.full_name %></span>
                        </div>
                      <% end %>
                      <div style="<%= dl_row %>">
                        <span style="<%= dl_lbl %>"><%= t("finance.daily_reconciliations.show.timeline.detail.label_assigned_to") %></span>
                        <span style="<%= dl_val %>"><%= drt.to_user.full_name %></span>
                      </div>
                      <div style="<%= dl_row %>">
                        <span style="<%= dl_lbl %>"><%= t("finance.daily_reconciliations.show.timeline.detail.label_status") %></span>
                        <span style="<%= dl_val %>">
                          <% if drt.accepted? %>
                            <span style="color: var(--success,#16a34a);"><%= t("finance.daily_reconciliations.show.timeline.detail.status_accepted") %></span>
                          <% elsif drt.rejected? %>
