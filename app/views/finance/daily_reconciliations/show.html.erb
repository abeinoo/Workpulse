          },
          day_closed:        {
            dot: "var(--success,#16a34a)", lbl: "label_day_closed",
            lc: "var(--success,#16a34a)", lb: "rgba(var(--success-rgb,22,163,74),0.10)",
            icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25z"/>',
          },
          deposit_assigned:  {
            dot: "var(--warning,#ca8a04)", lbl: "label_deposit_responsibility",
            lc: "var(--warning,#ca8a04)", lb: "rgba(var(--warning-rgb,202,138,4),0.10)",
            icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M18 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0ZM3 19.235v-.11a6.375 6.375 0 0 1 12.75 0v.109A12.318 12.318 0 0 1 9.374 21c-2.331 0-4.512-.645-6.374-1.766Z"/>',
          },
          deposit_accepted:  {
            dot: "var(--success,#16a34a)", lbl: "label_deposit_responsibility",
            lc: "var(--success,#16a34a)", lb: "rgba(var(--success-rgb,22,163,74),0.10)",
            icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/>',
          },
          deposit_cancelled: {
