<% content_for :title, t("finance.daily_reconciliations.show.title") %>

<div class="admin-page">

  <%# ── Page header ──────────────────────────────────────────────────────── %>
  <div class="page-header">
    <div>
      <h1 class="page-title">
        <% if @reconciliation.business_date %>
          <%= l(@reconciliation.business_date, format: :long) %>
          <span style="font-weight: 400; color: var(--text-3);">·</span>
        <% end %>
        <%= @reconciliation.branch.name %>
      </h1>
      <p class="page-subtitle"><%= t("finance.daily_reconciliations.show.subtitle") %></p>
    </div>
    <div class="page-header__actions">
      <% if @reconciliation.verified? %>
        <span class="badge badge-success" style="font-size: var(--text-xs); padding: var(--space-2) var(--space-3); display: flex; align-items: center; gap: 4px;">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          <%= t("finance.daily_reconciliations.index.verified") %>
        </span>
      <% elsif @waiting_for_opening_float %>
        <span class="badge" style="font-size: var(--text-xs); padding: var(--space-2) var(--space-3); background: rgba(var(--accent-rgb,99,102,241),0.12); color: var(--accent);">
          <%= t("finance.daily_reconciliations.show.state_waiting_for_opening") %>
        </span>
      <% elsif @reconciliation.open? %>
        <span class="badge badge-warning" style="font-size: var(--text-xs); padding: var(--space-2) var(--space-3);">
          <%= t("finance.daily_reconciliations.show.state_open") %>
        </span>
      <% elsif @reconciliation.deposited? && !@reconciliation.reviewed? %>
        <span class="badge badge-warning" style="font-size: var(--text-xs); padding: var(--space-2) var(--space-3);">
          <%= t("finance.daily_reconciliations.show.state_waiting_for_branch_deposit_review") %>
        </span>
      <% elsif @reconciliation.deposited? && @reconciliation.reviewed? %>
        <span class="badge" style="font-size: var(--text-xs); padding: var(--space-2) var(--space-3); background: rgba(var(--accent-rgb,99,102,241),0.12); color: var(--accent);">
          <%= t("finance.daily_reconciliations.show.state_waiting_for_bank_verification") %>
        </span>
      <% end %>
      <% open_disputes = @reconciliation.open_bank_disputes(preloaded_till_deposits: @all_deposits.select(&:active?)) %>
      <% if open_disputes.any? %>
        <span class="badge" style="font-size: var(--text-xs); padding: var(--space-2) var(--space-3); background: var(--warning,#ca8a04); color: #fff;">
          <%= t("finance.bank_disputes.dr_badge_label", count: open_disputes.size) %>
        </span>
      <% end %>
      <% if policy(@reconciliation).index? %>
        <%= link_to t("finance.daily_reconciliations.index.title"),
              finance_daily_reconciliations_path,
              class: "btn btn-ghost btn-sm" %>
      <% end %>
    </div>
  </div>

  <%# ── Receive Opening Balance card (blocks all till operations) ───────── %>
  <% if @waiting_for_opening_float %>
    <% src_handover = @reconciliation.opening_float_source_handover %>
    <div style="background: rgba(var(--accent-rgb,99,102,241),0.07); border: 2px solid rgba(var(--accent-rgb,99,102,241),0.35); border-radius: var(--radius-lg); overflow: hidden; margin-bottom: var(--space-4);">
      <%# Card header %>
      <div style="padding: var(--space-4) var(--space-5); border-bottom: 1px solid rgba(var(--accent-rgb,99,102,241),0.18); background: rgba(var(--accent-rgb,99,102,241),0.05); display: flex; align-items: center; gap: var(--space-3);">
        <div style="flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%; background: rgba(var(--accent-rgb,99,102,241),0.15); display: flex; align-items: center; justify-content: center; color: var(--accent);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3H3v7l9 9 7-7-9-9z"/><line x1="6" y1="6" x2="6.01" y2="6"/></svg>
        </div>
        <div>
          <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); margin: 0 0 2px;">
            <%= t("finance.daily_reconciliations.show.opening_float_card_title") %>
          </p>
          <p style="font-size: var(--text-xs); color: var(--text-2); margin: 0;">
            <%= t("finance.daily_reconciliations.show.opening_float_card_body") %>
          </p>
        </div>
      </div>

      <%# Float breakdown — shows overridden amounts when edited, else source %>
      <% display_amounts = @opening_float_display_amounts || @opening_float_source_handover %>
      <% if display_amounts&.any? %>
        <div style="padding: var(--space-4) var(--space-5); border-bottom: 1px solid rgba(var(--accent-rgb,99,102,241),0.12);">
          <div style="display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-3);">
            <% if src_handover %>
              <p style="font-size: var(--text-xs); color: var(--text-3); margin: 0; flex: 1;">
                <%= t("finance.daily_reconciliations.show.opening_float_from",
                      name: src_handover.from_user.full_name,
                      date: src_handover.daily_reconciliation.business_date ? l(src_handover.daily_reconciliation.business_date, format: :short) : "—") %>
              </p>
            <% end %>
            <% if @opening_float_amounts_overridden %>
              <span class="badge badge-warning" style="font-size: var(--text-xs); white-space: nowrap;">
                <%= t("finance.daily_reconciliations.show.edit_opening_float.badge_edited") %>
              </span>
            <% end %>
          </div>
          <table style="width: 100%; font-size: var(--text-sm); border-collapse: collapse;">
            <thead>
              <tr>
                <th style="text-align: start; font-weight: 600; color: var(--text-3); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; padding-bottom: var(--space-2);">
                  <%= t("finance.daily_reconciliations.show.opening_float_col_method") %>
                </th>
                <th style="text-align: end; font-weight: 600; color: var(--text-3); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; padding-bottom: var(--space-2);">
                  <%= t("finance.daily_reconciliations.show.opening_float_col_collected") %>
                </th>
                <th style="text-align: end; font-weight: 600; color: var(--text-3); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; padding-bottom: var(--space-2);">
                  <%= t("finance.daily_reconciliations.show.opening_float_col_net") %>
                </th>
              </tr>
            </thead>
            <tbody>
              <% total_net = 0 %>
              <% display_amounts.each do |amt| %>
                <% total_net += amt.net_amount %>
                <tr>
                  <td style="padding: var(--space-1) 0; color: var(--text-1); font-weight: 500;"><%= amt.payment_method_name %></td>
                  <td style="padding: var(--space-1) 0; text-align: end; color: var(--text-2); font-variant-numeric: tabular-nums;"><%= format_currency(amt.collected_amount) %></td>
                  <td style="padding: var(--space-1) 0; text-align: end; color: var(--text-1); font-weight: 600; font-variant-numeric: tabular-nums;"><%= format_currency(amt.net_amount) %></td>
                </tr>
              <% end %>
            </tbody>
            <tfoot>
              <tr style="border-top: 1px solid var(--border);">
                <td colspan="2" style="padding-top: var(--space-2); font-size: var(--text-xs); font-weight: 700; color: var(--text-2); text-transform: uppercase; letter-spacing: 0.06em;">
                  <%= t("finance.daily_reconciliations.show.opening_float_total") %>
                </td>
                <td style="padding-top: var(--space-2); text-align: end; font-weight: 700; color: var(--accent); font-variant-numeric: tabular-nums;">
                  <%= format_currency(total_net) %>
                </td>
              </tr>
            </tfoot>
          </table>
        </div>
      <% end %>

      <%# Actions — Edit is available to anyone with the permission; Confirm requires receivable state %>
      <div style="padding: var(--space-4) var(--space-5); display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center;">
        <% if @can_edit_opening_float %>
          <%= link_to t("finance.daily_reconciliations.show.opening_float_edit_btn"),
                edit_opening_float_finance_daily_reconciliation_path(@reconciliation),
                class: "btn btn-ghost btn-sm" %>
        <% end %>
        <% if @opening_float_receivable && policy(@reconciliation).receive_opening_float? %>
          <%= button_to t("finance.daily_reconciliations.show.opening_float_card_btn"),
                receive_opening_float_finance_daily_reconciliation_path(@reconciliation),
                method: :post,
                data:   { turbo_confirm: t("finance.daily_reconciliations.show.opening_float_card_confirm") },
                class:  "btn btn-primary",
                style:  "display: inline-flex; align-items: center; gap: var(--space-2);" %>
        <% elsif policy(@reconciliation).receive_opening_float? %>
          <div style="display: flex; align-items: center; gap: var(--space-2); color: var(--text-3); font-size: var(--text-sm);">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <%= t("finance.daily_reconciliations.show.opening_float_not_yet") %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# ── Pending till handover banner ───────────────────────────────────── %>
  <% if @pending_handover_for_me && !@waiting_for_opening_float %>
    <div style="background: rgba(var(--warning-rgb, 234,179,8), 0.10); border: 1.5px solid rgba(var(--warning-rgb, 234,179,8), 0.40); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-5); display: flex; align-items: center; gap: var(--space-4); margin-bottom: var(--space-4);">
      <div style="flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%; background: rgba(var(--warning-rgb, 234,179,8), 0.15); display: flex; align-items: center; justify-content: center; color: var(--warning, #ca8a04);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3H3v7l9 9 7-7-9-9z"/><line x1="6" y1="6" x2="6.01" y2="6"/></svg>
      </div>
      <div style="flex: 1; min-width: 0;">
        <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); margin: 0 0 2px;">
          <%= t("finance.daily_reconciliations.show.pending_banner_title",
                name: @pending_handover_for_me.from_user.full_name) %>
        </p>
        <p style="font-size: var(--text-xs); color: var(--text-2); margin: 0;">
          <%= t("finance.daily_reconciliations.show.pending_banner_body") %>
        </p>
      </div>
    </div>
  <% end %>

  <%# ── Pending deposit responsibility transfer banner (target employee) ── %>
  <% if @pending_deposit_transfer_for_me %>
    <div style="background: rgba(var(--warning-rgb, 234,179,8), 0.10); border: 1.5px solid rgba(var(--warning-rgb, 234,179,8), 0.40); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-5); display: flex; align-items: center; gap: var(--space-4); margin-bottom: var(--space-4);">
      <div style="flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%; background: rgba(var(--warning-rgb, 234,179,8), 0.15); display: flex; align-items: center; justify-content: center; color: var(--warning, #ca8a04);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="15" rx="2"/><path d="M16 7V5a2 2 0 0 0-4 0v2"/><line x1="12" y1="12" x2="12" y2="17"/><line x1="9.5" y1="14.5" x2="14.5" y2="14.5"/></svg>
      </div>
      <div style="flex: 1; min-width: 0;">
        <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); margin: 0 0 2px;">
          <%= t("finance.daily_reconciliations.show.deposit_transfer_banner_title",
                name: @pending_deposit_transfer_for_me.from_user.full_name) %>
        </p>
        <p style="font-size: var(--text-xs); color: var(--text-2); margin: 0;">
          <%= t("finance.daily_reconciliations.show.deposit_transfer_banner_body") %>
        </p>
      </div>
    </div>
  <% end %>

  <%# ── Awaiting acceptance banner (original depositor / from_user) ──────── %>
  <% if @pending_deposit_transfer_from_me %>
    <div style="background: rgba(var(--accent-rgb, 99,102,241), 0.07); border: 1.5px solid rgba(var(--accent-rgb, 99,102,241), 0.30); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-5); display: flex; align-items: center; gap: var(--space-4); margin-bottom: var(--space-4);">
      <div style="flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%; background: rgba(var(--accent-rgb, 99,102,241), 0.12); display: flex; align-items: center; justify-content: center; color: var(--accent);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div style="flex: 1; min-width: 0;">
        <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); margin: 0 0 2px;">
          <%= t("finance.daily_reconciliations.show.deposit_transfer_waiting_title",
                name: @pending_deposit_transfer_from_me.to_user.full_name) %>
        </p>
        <p style="font-size: var(--text-xs); color: var(--text-2); margin: 0;">
          <%= t("finance.daily_reconciliations.show.deposit_transfer_waiting_body") %>
        </p>
      </div>
    </div>
  <% end %>

  <%# ── Post-handover correction notice ─────────────────────────────────── %>
  <% if @day_close_edits.any? || @session_amount_edits.any? %>
    <div style="background: rgba(var(--accent-rgb, 99,102,241), 0.07); border: 1.5px solid rgba(var(--accent-rgb, 99,102,241), 0.30); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-5); display: flex; align-items: center; gap: var(--space-4); margin-bottom: var(--space-4);">
      <div style="flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%; background: rgba(var(--accent-rgb, 99,102,241), 0.12); display: flex; align-items: center; justify-content: center; color: var(--accent);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
      </div>
      <div style="flex: 1; min-width: 0;">
        <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); margin: 0 0 2px;">
          <%= t("finance.daily_reconciliations.show.correction_banner_title") %>
        </p>
        <p style="font-size: var(--text-xs); color: var(--text-2); margin: 0;">
          <%= t("finance.daily_reconciliations.show.correction_banner_body") %>
        </p>
      </div>
    </div>
  <% end %>

  <%# ── Action bar (suppressed while waiting for opening float) ───────── %>
  <% show_action_bar = !@waiting_for_opening_float && (
                       @pending_handover_for_me ||
                       @pending_deposit_transfer_for_me ||
                       @pending_deposit_transfer_from_me ||
                       (@reconciliation.open? && policy(TillHandover.new).create?) ||
                       (@i_am_depositor && (@reconciliation.closed? || @reconciliation.deposited?))) %>
  <% if show_action_bar %>
    <div style="display: flex; flex-wrap: wrap; gap: var(--space-3); margin-bottom: var(--space-4);">
      <%# Accept incoming till handover %>
      <% if @pending_handover_for_me %>
        <%= link_to till_handover_path(@pending_handover_for_me),
              class: "btn btn-primary",
              data: { turbo_frame: "modal" },
              style: "display: inline-flex; align-items: center; gap: var(--space-2);" do %>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          <%= t("finance.daily_reconciliations.show.action_accept") %>
        <% end %>
      <% end %>

      <%# Accept deposit responsibility (target employee) %>
      <% if @pending_deposit_transfer_for_me %>
        <%= link_to deposit_responsibility_transfer_path(@pending_deposit_transfer_for_me),
              class: "btn btn-primary",
              data: { turbo_frame: "modal" },
              style: "display: inline-flex; align-items: center; gap: var(--space-2);" do %>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="15" rx="2"/><path d="M16 7V5a2 2 0 0 0-4 0v2"/><line x1="12" y1="12" x2="12" y2="17"/><line x1="9.5" y1="14.5" x2="14.5" y2="14.5"/></svg>
          <%= t("finance.daily_reconciliations.show.action_accept_deposit_transfer") %>
        <% end %>
      <% end %>

      <%# Cancel pending deposit responsibility transfer (from_user or manager) %>
      <% if @pending_deposit_transfer_from_me && policy(@pending_deposit_transfer_from_me).cancel? %>
        <%= button_to cancel_deposit_responsibility_transfer_path(@pending_deposit_transfer_from_me),
              method: :patch,
              class: "btn btn-ghost",
              data: { turbo_confirm: t("finance.daily_reconciliations.show.confirm_cancel_deposit_transfer") },
              style: "display: inline-flex; align-items: center; gap: var(--space-2);" do %>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          <%= t("finance.daily_reconciliations.show.action_cancel_deposit_transfer") %>
        <% end %>
      <% end %>

      <%# Handover / close till %>
      <% if @reconciliation.open? && policy(TillHandover.new).create? %>
        <% if @pending_outgoing_handover %>
          <span style="display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); font-weight: 600; color: var(--warning, #ca8a04); background: rgba(var(--warning-rgb, 202,138,4), 0.10); border: 1.5px solid rgba(var(--warning-rgb, 202,138,4), 0.30); border-radius: var(--radius); padding: var(--space-2) var(--space-4);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <%= t("finance.daily_reconciliations.show.action_pending_outgoing",
                  name: @pending_outgoing_handover.to_user&.full_name || "—") %>
          </span>
          <% if policy(@pending_outgoing_handover).cancel? %>
            <%= button_to cancel_till_handover_path(@pending_outgoing_handover),
                  method: :patch,
                  class: "btn btn-ghost btn-sm",
                  data: { turbo_confirm: t("till_handovers.confirm_cancel") },
                  style: "display: inline-flex; align-items: center; gap: var(--space-2);" do %>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              <%= t("till_handovers.action_cancel") %>
            <% end %>
          <% end %>
        <% else %>
          <%= link_to new_till_handover_path,
                class: "btn btn-primary",
                data: { turbo_frame: "modal" },
                style: "display: inline-flex; align-items: center; gap: var(--space-2);" do %>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            <%= t("finance.daily_reconciliations.show.action_handover") %>
          <% end %>
        <% end %>
      <% end %>

      <%# Record deposit — available as soon as the session is closed; the
          Branch Manager reviews the recorded deposit afterward, at which
          point TillDepositPolicy#create? locks this out (unless override). ── %>
      <% if @i_am_depositor && (@reconciliation.closed? || @reconciliation.deposited?) %>
        <% deposit_dummy = TillDeposit.new(daily_reconciliation: @reconciliation) %>
        <% if policy(deposit_dummy).create? %>
          <%= link_to new_till_deposit_path(daily_reconciliation_id: @reconciliation.id),
                class: "btn btn-primary",
                data: { turbo_frame: "modal" },
                style: "display: inline-flex; align-items: center; gap: var(--space-2);" do %>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="15" rx="2"/><path d="M16 7V5a2 2 0 0 0-4 0v2"/><line x1="12" y1="12" x2="12" y2="17"/><line x1="9.5" y1="14.5" x2="14.5" y2="14.5"/></svg>
            <%= t("finance.daily_reconciliations.show.action_deposit") %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%# ── Leave Opening Float card (shown after day is closed, before float is declared) ── %>
  <% if @opening_float_leavable && policy(@reconciliation).leave_opening_float? %>
    <div style="background: rgba(var(--accent-rgb,99,102,241),0.07); border: 2px solid rgba(var(--accent-rgb,99,102,241),0.35); border-radius: var(--radius-lg); overflow: hidden; margin-bottom: var(--space-4);">
      <div style="padding: var(--space-4) var(--space-5); display: flex; align-items: center; gap: var(--space-4);">
        <div style="flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%; background: rgba(var(--accent-rgb,99,102,241),0.15); display: flex; align-items: center; justify-content: center; color: var(--accent);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="15" rx="2"/><path d="M16 7V5a2 2 0 0 0-4 0v2"/><line x1="12" y1="12" x2="12" y2="16"/><line x1="9.5" y1="14" x2="14.5" y2="14"/></svg>
        </div>
        <div style="flex: 1; min-width: 0;">
          <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); margin: 0 0 2px;">
            <%= t("finance.daily_reconciliations.show.leave_float_card_title") %>
          </p>
          <p style="font-size: var(--text-xs); color: var(--text-2); margin: 0;">
            <%= t("finance.daily_reconciliations.show.leave_float_card_body") %>
          </p>
        </div>
        <%= link_to new_opening_float_path,
              class: "btn btn-primary btn-sm",
              data:  { turbo_frame: "modal" },
              style: "flex-shrink: 0; display: inline-flex; align-items: center; gap: var(--space-2);" do %>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          <%= t("finance.daily_reconciliations.show.leave_float_card_btn") %>
        <% end %>
      </div>
    </div>
  <% end %>


  <%# ── Redesigned reconciliation sections (see build_show_summary_aggregates) ── %>
  <%= render "summary_cards" %>

  <%# ── Two-column body: POS Verification (left, Session Totals + Employee
      Breakdown) | Audit Timeline (right) — restores the pre-redesign
      .dashboard-cols layout. The old standalone "Cashier Custody Summary"
      card is gone; the Employee Breakdown is now owned by, and rendered
      inside, the POS Verification section on the left.

      dr-pos-timeline-grid pins these two columns to a fixed physical
      left/right order in both languages (see the matching CSS rule) — a
      plain grid's first child would otherwise render on the right in RTL,
      silently swapping the columns for Arabic. ── %>
  <div class="dashboard-cols dr-pos-timeline-grid" style="margin-bottom: var(--space-6);">
    <div>
      <% if @can_view_pos_transactions_verification %>
        <%= render "electronic_payments",
                   pos_totals_by_method:       @pos_totals_by_method,
                   pos_difference:             @pos_difference,
                   can_manage_pos_import:      @can_manage_pos_import,
                   session_totals_rows:        @session_totals_rows,
                   session_totals_grand_total: @session_totals_grand_total %>
      <% end %>

      <%= render "cash_reconciliation" %>

      <%= render "bank_deposits" %>
    </div>
    <div>
      <%= render "timeline" %>
    </div>
  </div>

  <%= render "exceptions" %>

  <%= render "notes" %>

  <%= render "approval" %>

</div>
