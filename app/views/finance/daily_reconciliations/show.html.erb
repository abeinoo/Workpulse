                    </p>

                    <div data-timeline-event-target="detail" hidden
                         style="margin-top: var(--space-3); padding: var(--space-3) var(--space-4); background: var(--surface-2); border-radius: var(--radius); border: 1px solid var(--border);">
                      <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-3); border-bottom: 1px solid var(--border); padding-bottom: var(--space-2); margin-bottom: var(--space-3);">
                        <%= t("finance.daily_reconciliations.show.timeline.detail.ref_adjustment", id: adj.id) %>
                        &nbsp;·&nbsp;
                        <%= link_to t("finance.daily_reconciliations.show.timeline.detail.ref_handover", id: adj.adjustable_id),
                              till_handover_path(adj.adjustable_id),
                              style: "color: var(--accent); font-size: 10px; font-weight: 600;" %>
                      </div>
                      <div style="<%= dl_row %>">
                        <span style="<%= dl_lbl %>"><%= t("finance.daily_reconciliations.show.timeline.detail.label_reason_code") %></span>
                        <span style="<%= dl_val %>">
                          <%= t("till_handovers.adjustment_reasons.#{adj.reason_code}", default: adj.reason_code) %>
                        </span>
                      </div>
                      <div style="<%= dl_row %>">
                        <span style="<%= dl_lbl %>"><%= t("finance.daily_reconciliations.show.timeline.detail.label_notes") %></span>
                        <span style="<%= dl_val %>; font-style: italic;"><%= adj.notes %></span>
                      </div>
                      <% if adj.before_data.present? && adj.after_data.present? %>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); margin-top: var(--space-2); border-top: 1px solid var(--border); padding-top: var(--space-2); font-size: 10px;">
                          <div>
                            <div style="font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-3); margin-bottom: 4px;">
                              <%= t("finance.daily_reconciliations.show.timeline.detail.label_before") %>
                            </div>
                            <% Array(adj.before_data).each do |entry| %>
                              <div style="color: var(--text-2); margin-bottom: 2px;">
                                <%= entry["payment_method_name"] %>:
                                <strong style="color: var(--text-1);">
                                  <%= number_to_currency(entry["collected_amount"].to_d - entry["refund_amount"].to_d, **cur_fmt) %>
                                </strong>
                              </div>
                            <% end %>
                          </div>
                          <div>
                            <div style="font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent); margin-bottom: 4px;">
                              <%= t("finance.daily_reconciliations.show.timeline.detail.label_after") %>
                            </div>
                            <% Array(adj.after_data).each do |entry| %>
                              <div style="color: var(--text-2); margin-bottom: 2px;">
                                <%= entry["payment_method_name"] || entry["payment_method_id"] %>:
                                <strong style="color: var(--text-1);">
                                  <%= number_to_currency(entry["collected_amount"].to_d - entry["refund_amount"].to_d, **cur_fmt) %>
                                </strong>
                              </div>
                            <% end %>
                          </div>
                        </div>
                      <% end %>
                    </div>

                  <% when :session_totals_edited %>
                    <% log = item[:data] %>
                    <p style="font-size: var(--text-sm); font-weight: 600; color: var(--text-1); margin: 0 0 var(--space-1);">
                      <%= t("finance.daily_reconciliations.show.timeline.session_totals_edited",
                            actor: item[:actor]&.full_name || "—") %>
                    </p>

                    <div data-timeline-event-target="detail" hidden
                         style="margin-top: var(--space-3); padding: var(--space-3) var(--space-4); background: var(--surface-2); border-radius: var(--radius); border: 1px solid var(--border);">
                      <% if log.metadata&.[]("notes").present? %>
                        <div style="<%= dl_row %>">
                          <span style="<%= dl_lbl %>"><%= t("finance.daily_reconciliations.show.timeline.detail.label_notes") %></span>
                          <span style="<%= dl_val %>; font-style: italic;"><%= log.metadata["notes"] %></span>
                        </div>
                      <% end %>
                      <% if log.changes_json.present? %>
                        <div style="margin-top: var(--space-2); border-top: 1px solid var(--border); padding-top: var(--space-2);">
                          <div style="font-size: 10px; color: var(--text-3); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--space-2);">
                            <%= t("finance.daily_reconciliations.show.timeline.detail.label_changes") %>
                          </div>
                          <% log.changes_json.each do |pm_name, diff| %>
                            <div style="font-size: 11px; padding: var(--space-1) 0; border-bottom: 1px dashed var(--border);">
                              <span style="color: var(--text-2); font-weight: 600;"><%= pm_name %></span>
                              <% collected_change = diff["collected"] || diff[:collected] %>
                              <% refund_change    = diff["refund"]    || diff[:refund] %>
                              <% if collected_change && collected_change[0] != collected_change[1] %>
                                <div style="display: flex; gap: var(--space-2); margin-top: 2px; align-items: center;">
                                  <span style="color: var(--text-3); font-size: 10px; min-width: 70px;"><%= t("finance.daily_reconciliations.show.timeline.detail.label_collected") %></span>
                                  <span style="color: var(--text-3); text-decoration: line-through;"><%= number_to_currency(collected_change[0], **cur_fmt) %></span>
                                  <span style="color: var(--text-3);">→</span>
                                  <span style="font-weight: 600; color: var(--text-1);"><%= number_to_currency(collected_change[1], **cur_fmt) %></span>
                                </div>
                              <% end %>
                              <% if refund_change && refund_change[0] != refund_change[1] %>
                                <div style="display: flex; gap: var(--space-2); margin-top: 2px; align-items: center;">
                                  <span style="color: var(--text-3); font-size: 10px; min-width: 70px;"><%= t("finance.daily_reconciliations.show.timeline.detail.label_refunds") %></span>
                                  <span style="color: var(--text-3); text-decoration: line-through;"><%= number_to_currency(refund_change[0], **cur_fmt) %></span>
                                  <span style="color: var(--text-3);">→</span>
                                  <span style="font-weight: 600; color: var(--text-1);"><%= number_to_currency(refund_change[1], **cur_fmt) %></span>
                                </div>
                              <% end %>
                            </div>
                          <% end %>
                        </div>
                      <% end %>
                    </div>

                  <% when :day_close_edited %>
                    <% log = item[:data] %>
                    <p style="font-size: var(--text-sm); font-weight: 600; color: var(--text-1); margin: 0 0 var(--space-1);">
                      <%= t("finance.daily_reconciliations.show.timeline.day_close_edited",
                            actor: item[:actor]&.full_name || "—") %>
                    </p>

                    <div data-timeline-event-target="detail" hidden
                         style="margin-top: var(--space-3); padding: var(--space-3) var(--space-4); background: var(--surface-2); border-radius: var(--radius); border: 1px solid var(--border);">
                      <% if log.metadata&.[]("reason").present? %>
                        <div style="<%= dl_row %>">
                          <span style="<%= dl_lbl %>"><%= t("finance.daily_reconciliations.show.timeline.detail.label_reason") %></span>
                          <span style="<%= dl_val %>; font-style: italic;"><%= log.metadata["reason"] %></span>
                        </div>
                      <% end %>
                      <% if log.changes_json.present? %>
                        <div style="margin-top: var(--space-2); border-top: 1px solid var(--border); padding-top: var(--space-2);">
                          <div style="font-size: 10px; color: var(--text-3); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: var(--space-2);">
                            <%= t("finance.daily_reconciliations.show.timeline.detail.label_changes") %>
                          </div>
                          <% log.changes_json.each do |pm_name, diff| %>
                            <div style="font-size: 11px; padding: var(--space-1) 0; border-bottom: 1px dashed var(--border);">
                              <span style="color: var(--text-2); font-weight: 600;"><%= pm_name %></span>
                              <% collected_change = diff["collected"] || diff[:collected] %>
                              <% refund_change    = diff["refund"]    || diff[:refund] %>
                              <% if collected_change && collected_change[0] != collected_change[1] %>
                                <div style="display: flex; gap: var(--space-2); margin-top: 2px; align-items: center;">
                                  <span style="color: var(--text-3); font-size: 10px; min-width: 70px;"><%= t("finance.daily_reconciliations.show.timeline.detail.label_collected") %></span>
                                  <span style="color: var(--text-3); text-decoration: line-through;"><%= number_to_currency(collected_change[0], **cur_fmt) %></span>
                                  <span style="color: var(--text-3);">→</span>
                                  <span style="font-weight: 600; color: var(--text-1);"><%= number_to_currency(collected_change[1], **cur_fmt) %></span>
                                </div>
                              <% end %>
                              <% if refund_change && refund_change[0] != refund_change[1] %>
                                <div style="display: flex; gap: var(--space-2); margin-top: 2px; align-items: center;">
                                  <span style="color: var(--text-3); font-size: 10px; min-width: 70px;"><%= t("finance.daily_reconciliations.show.timeline.detail.label_refunds") %></span>
                                  <span style="color: var(--text-3); text-decoration: line-through;"><%= number_to_currency(refund_change[0], **cur_fmt) %></span>
                                  <span style="color: var(--text-3);">→</span>
                                  <span style="font-weight: 600; color: var(--text-1);"><%= number_to_currency(refund_change[1], **cur_fmt) %></span>
                                </div>
                              <% end %>
                            </div>
                          <% end %>
                        </div>
                      <% end %>
                    </div>

                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>

        </div>
      </div>
    <% end %>

    <%# ── Right column: session totals + deposits ────────────────────── %>
    <div style="display: flex; flex-direction: column; gap: var(--space-5);">

      <%# Session amounts (official financial totals) — only visible with view_session_totals permission %>
      <% if @amounts_by_method.any? && @can_view_session_totals %>
        <% show_pos_comparison = @pos_totals_by_method&.any? %>
        <div>
          <div class="dashboard-section__header" style="margin-bottom: var(--space-4);">
            <h2 class="dashboard-section__title"><%= t("finance.daily_reconciliations.show.collected_title") %></h2>
            <% if @can_edit_session_totals %>
              <%= link_to t("finance.daily_reconciliations.show.action_edit_session_totals"),
                    edit_session_totals_finance_daily_reconciliation_path(@reconciliation),
                    class: "btn btn-ghost btn-sm" %>
            <% end %>
          </div>
          <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm);">
            <% if show_pos_comparison %>
              <%# Column headers when POS comparison is available %>
              <div style="display: grid; grid-template-columns: 1fr repeat(3, minmax(90px, 130px)); padding: var(--space-2) var(--space-5); background: var(--surface-2); border-bottom: 1px solid var(--border);">
                <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3);"></span>
                <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); text-align: end;">
                  <%= t("finance.daily_reconciliations.show.collected_entered") %>
                </span>
                <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); text-align: end;">
                  <%= t("finance.daily_reconciliations.show.collected_pos_total") %>
                </span>
                <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); text-align: end;">
                  <%= t("finance.daily_reconciliations.show.collected_difference") %>
                </span>
              </div>
            <% end %>
            <% @amounts_by_method.each do |sa| %>
              <% if show_pos_comparison %>
                <% pos_amount = @pos_totals_by_method[sa.payment_method_id].to_d %>
                <% diff = sa.net_amount - pos_amount %>
                <div style="display: grid; grid-template-columns: 1fr repeat(3, minmax(90px, 130px)); padding: var(--space-3) var(--space-5); border-bottom: 1px solid var(--border); align-items: center;">
                  <span style="font-size: var(--text-sm); color: var(--text-2);">
                    <%= sa.payment_method_name %>
                    <% if sa.refund_amount > 0 %>
                      <span style="font-size: 11px; color: var(--danger); margin-inline-start: 4px;">
                        − <%= number_to_currency(sa.refund_amount, unit: "", separator: ".", delimiter: ",") %>
                      </span>
                    <% end %>
                  </span>
                  <span style="font-size: var(--text-sm); font-weight: 600; color: var(--text-1); text-align: end; font-variant-numeric: tabular-nums;">
                    <%= number_to_currency(sa.net_amount, unit: "", separator: ".", delimiter: ",") %>
                  </span>
                  <span style="font-size: var(--text-sm); font-weight: 600; color: var(--text-1); text-align: end; font-variant-numeric: tabular-nums;">
                    <%= number_to_currency(pos_amount, unit: "", separator: ".", delimiter: ",") %>
                  </span>
                  <span style="font-size: var(--text-sm); font-weight: 600; text-align: end; font-variant-numeric: tabular-nums; color: <%= diff.abs < 0.01 ? 'var(--text-3)' : (diff > 0 ? 'var(--warning)' : 'var(--danger)') %>;">
                    <% if diff.abs < 0.01 %>
                      —
                    <% elsif diff > 0 %>
                      +<%= number_to_currency(diff, unit: "", separator: ".", delimiter: ",") %>
                    <% else %>
                      <%= number_to_currency(diff, unit: "", separator: ".", delimiter: ",") %>
                    <% end %>
                  </span>
                </div>
              <% else %>
                <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-3) var(--space-5); border-bottom: 1px solid var(--border);">
                  <span style="font-size: var(--text-sm); color: var(--text-2);"><%= sa.payment_method_name %></span>
                  <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 1px;">
                    <span style="font-size: var(--text-sm); font-weight: 600; color: var(--text-1);">
                      <%= number_to_currency(sa.net_amount, unit: "", separator: ".", delimiter: ",") %>
                    </span>
                    <% if sa.refund_amount > 0 %>
                      <span style="font-size: 11px; color: var(--danger);">
                        − <%= number_to_currency(sa.refund_amount, unit: "", separator: ".", delimiter: ",") %>
                      </span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% end %>
            <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-3) var(--space-5); background: var(--surface-2);">
              <span style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1);">
                <%= t("finance.daily_reconciliations.show.total_collected") %>
              </span>
              <span style="font-size: var(--text-base); font-weight: 700; color: var(--text-1);">
                <%= number_to_currency(@amounts_by_method.sum(&:net_amount), unit: "", separator: ".", delimiter: ",") %>
              </span>
            </div>
          </div>
        </div>
      <% end %>

      <%# Deposits %>
      <div>
        <div class="dashboard-section__header" style="margin-bottom: var(--space-4);">
          <h2 class="dashboard-section__title"><%= t("finance.daily_reconciliations.show.deposits_title") %></h2>
        </div>
        <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm);">
          <% if @deposits.empty? %>
            <p style="padding: var(--space-5); color: var(--text-2); font-size: var(--text-sm); margin: 0;">
              <%= t("finance.daily_reconciliations.show.no_deposits") %>
            </p>
          <% else %>
            <% @deposits.each do |deposit| %>
              <div style="padding: var(--space-3) var(--space-5); border-bottom: 1px solid var(--border);">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-4);">
                  <div style="min-width: 0;">
                    <p style="font-size: var(--text-sm); font-weight: 500; color: var(--text-1); margin: 0 0 2px;">
                      <%= deposit.payment_method.display_name %>
                    </p>
                    <p style="font-size: var(--text-xs); color: var(--text-2); margin: 0;">
                      <%= deposit.deposited_by.full_name %>
                      · <%= l(deposit.deposited_at, format: :time_only) %>
                      <% if deposit.reference.present? %>
                        · <%= deposit.reference %>
                      <% end %>
                    </p>
                  </div>
                  <div style="display: flex; align-items: center; gap: var(--space-3); flex-shrink: 0;">
                    <span style="font-size: var(--text-sm); font-weight: 600;">
                      <%= number_to_currency(deposit.amount, unit: "", separator: ".", delimiter: ",") %>
                    </span>
                    <% if policy(deposit).void? && !@reconciliation.verified? %>
                      <%= button_to void_till_deposit_path(deposit),
                            method: :patch,
                            params: { void_reason: "Voided during reconciliation review" },
                            class: "btn btn-danger btn-sm",
                            data: { turbo_confirm: t("common.are_you_sure") },
                            form_class: "inline" do %>
                        <%= t("common.void") %>
                      <% end %>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
            <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-3) var(--space-5); background: var(--surface-2);">
              <span style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1);">
                <%= t("finance.daily_reconciliations.show.total_deposited") %>
              </span>
              <span style="font-size: var(--text-base); font-weight: 700; color: var(--success);">
                <%= number_to_currency(@total_deposited, unit: "", separator: ".", delimiter: ",") %>
              </span>
            </div>
          <% end %>
        </div>
      </div>

    </div>
  </div>

  <%# ── Employee Reconciliation Summary ───────────────────────────────────── %>
  <% if @employee_summaries %>
  <div style="margin-bottom: var(--space-6);">
    <div class="dashboard-section__header" style="margin-bottom: var(--space-4);">
      <div>
        <h2 class="dashboard-section__title" style="display: flex; align-items: center; gap: var(--space-2);">
          <%= t("finance.daily_reconciliations.show.employee_summary_title") %>
          <span title="<%= t('finance.daily_reconciliations.show.employee_summary_tooltip') %>"
                style="cursor: help; font-size: 11px; color: var(--text-3); font-style: normal; font-weight: 400; border: 1px solid var(--border); border-radius: 50%; width: 16px; height: 16px; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; line-height: 1;">
            i
          </span>
        </h2>
        <p style="font-size: var(--text-xs); color: var(--text-2); margin: var(--space-1) 0 0;">
          <%= @can_view_all_summary ?
                t("finance.daily_reconciliations.show.employee_summary_subtitle") :
                t("finance.daily_reconciliations.show.employee_summary_subtitle_own") %>
        </p>
      </div>
      <% if @reconciliation.open? && @employee_summaries.any? %>
        <span style="font-size: 11px; font-weight: 600; color: var(--warning); background: rgba(var(--warning-rgb,202,138,4),0.10); border: 1px solid rgba(var(--warning-rgb,202,138,4),0.30); border-radius: var(--radius-sm); padding: 3px 8px; white-space: nowrap;">
          <%= t("finance.daily_reconciliations.show.employee_summary_live_hint") %>
        </span>
      <% end %>
    </div>

    <% if @employee_summaries.empty? %>
      <p style="font-size: var(--text-sm); color: var(--text-2); padding: var(--space-4) 0;">
        <%= t("finance.daily_reconciliations.show.employee_summary_empty") %>
      </p>
    <% else %>
      <div style="display: flex; flex-direction: column; gap: var(--space-4);">
        <% @employee_summaries.each do |summary| %>
          <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm);">

            <%# ── Employee header ──────────────────────────────────────────── %>
            <div style="padding: var(--space-4) var(--space-5); background: var(--surface-2); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; gap: var(--space-4);">
              <div style="display: flex; align-items: center; gap: var(--space-3);">
                <div style="width: 32px; height: 32px; border-radius: 50%; background: rgba(var(--accent-rgb),0.12); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
                <span style="font-size: var(--text-base); font-weight: 700; color: var(--text-1);">
                  <%= summary.user.full_name %>
                </span>
              </div>
              <div style="text-align: end;">
                <p style="font-size: 11px; color: var(--text-3); margin: 0 0 2px; text-transform: uppercase; letter-spacing: 0.06em;">
                  <%= t("finance.daily_reconciliations.show.employee_summary_grand_total") %>
                </p>
                <p style="font-size: var(--text-lg); font-weight: 700; color: var(--text-1); margin: 0;">
                  <%= number_to_currency(summary.grand_total, unit: "", separator: ".", delimiter: ",") %>
                </p>
              </div>
            </div>

            <%# ── Per-payment-method breakdown (table rows) ───────────────── %>
            <% visible_amounts = summary.amounts.reject { |a| a.collected_amount.zero? && a.refund_amount.zero? } %>
            <% cashier_pos = @pos_totals_by_cashier&.each_with_object({}) { |(k, v), h| h[k.downcase.strip] = v }&.fetch(summary.user.full_name.downcase.strip, nil) %>
            <% show_cashier_pos = @pos_totals_by_cashier&.any? %>
            <% col_count = show_cashier_pos ? 5 : 3 %>
            <% if visible_amounts.any? %>
              <%# Column headers %>
              <div style="display: grid; grid-template-columns: 1fr repeat(<%= col_count %>, minmax(80px, 130px)); gap: 0; padding: var(--space-2) var(--space-5); background: var(--surface-2); border-bottom: 1px solid var(--border);">
                <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3);"></span>
                <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); text-align: end;">
                  <%= t("finance.daily_reconciliations.show.employee_summary_collected") %>
                </span>
                <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); text-align: end;">
                  <%= t("finance.daily_reconciliations.show.employee_summary_refunds") %>
                </span>
                <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); text-align: end;">
                  <%= t("finance.daily_reconciliations.show.employee_summary_net") %>
                </span>
                <% if show_cashier_pos %>
                  <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); text-align: end;">
                    <%= t("finance.daily_reconciliations.show.employee_summary_pos_total") %>
                  </span>
                  <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); text-align: end;">
                    <%= t("finance.daily_reconciliations.show.employee_summary_pos_difference") %>
                  </span>
                <% end %>
              </div>

              <%# One row per payment method %>
              <% visible_amounts.each do |amt| %>
                <% pos_method_amt = cashier_pos ? cashier_pos[amt.payment_method_id].to_d : nil %>
                <% pos_diff = pos_method_amt ? (amt.net_amount - pos_method_amt) : nil %>
                <div style="display: grid; grid-template-columns: 1fr repeat(<%= col_count %>, minmax(80px, 130px)); gap: 0; padding: var(--space-3) var(--space-5); border-bottom: 1px solid var(--border); align-items: baseline;">
                  <span style="font-size: var(--text-sm); color: var(--text-2);">
                    <%= amt.payment_method_name %>
                  </span>
                  <span style="font-size: var(--text-sm); font-weight: 600; color: var(--text-1); text-align: end;">
                    <%= number_to_currency(amt.collected_amount, unit: "", separator: ".", delimiter: ",") %>
                  </span>
                  <span style="font-size: var(--text-sm); font-weight: 500; color: <%= amt.refund_amount > 0 ? 'var(--danger)' : 'var(--text-3)' %>; text-align: end;">
                    <%= number_to_currency(amt.refund_amount, unit: "", separator: ".", delimiter: ",") %>
                  </span>
                  <span style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); text-align: end;">
                    <%= number_to_currency(amt.net_amount, unit: "", separator: ".", delimiter: ",") %>
                  </span>
                  <% if show_cashier_pos %>
                    <span style="font-size: var(--text-sm); font-weight: 600; color: var(--text-1); text-align: end; font-variant-numeric: tabular-nums;">
                      <%= pos_method_amt ? number_to_currency(pos_method_amt, unit: "", separator: ".", delimiter: ",") : "—" %>
                    </span>
                    <span style="font-size: var(--text-sm); font-weight: 600; text-align: end; font-variant-numeric: tabular-nums; color: <%= pos_diff.nil? || pos_diff.abs < 0.01 ? 'var(--text-3)' : (pos_diff > 0 ? 'var(--warning)' : 'var(--danger)') %>;">
                      <% if pos_diff.nil? || pos_diff.abs < 0.01 %>
                        —
                      <% elsif pos_diff > 0 %>
                        +<%= number_to_currency(pos_diff, unit: "", separator: ".", delimiter: ",") %>
                      <% else %>
                        <%= number_to_currency(pos_diff, unit: "", separator: ".", delimiter: ",") %>
                      <% end %>
                    </span>
                  <% end %>
                </div>
              <% end %>
            <% end %>

            <%# ── Grand total footer ───────────────────────────────────────── %>
            <div style="display: flex; justify-content: space-between; align-items: center; padding: var(--space-4) var(--space-5); background: rgba(var(--accent-rgb),0.05);">
              <span style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1);">
                <%= t("finance.daily_reconciliations.show.employee_summary_grand_total") %>
              </span>
              <span style="font-size: var(--text-lg); font-weight: 700; color: var(--text-1);">
                <%= number_to_currency(summary.grand_total, unit: "", separator: ".", delimiter: ",") %>
              </span>
            </div>

          </div>
        <% end %>
      </div>
    <% end %>
  </div>
  <% end %>

  <%# ── POS Transactions Verification ─────────────────────────────────── %>
  <% if @can_manage_pos_import || @pos_totals_by_method&.any? %>
    <%= render "finance/pos_imports/verification_section",
               reconciliation:            @reconciliation,
               session_amounts:           @amounts_by_method,
               employee_summaries:        @employee_summaries,
               pos_totals_by_method:      @pos_totals_by_method,
               pos_totals_by_cashier:     @pos_totals_by_cashier,
               pos_transactions:          @pos_transactions,
               pos_payment_methods_by_id: @pos_payment_methods_by_id,
               latest_pos_import:         @latest_pos_import %>
  <% end %>

  <%# ── Verification notes ──────────────────────────────────────────────── %>
  <% if @reconciliation.notes.present? %>
    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-5); margin-bottom: var(--space-5); box-shadow: var(--shadow-sm);">
      <h2 style="font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-3); margin: 0 0 var(--space-3);">
        <%= t("common.notes") %>
      </h2>
      <p style="font-size: var(--text-sm); color: var(--text-1); margin: 0; white-space: pre-line; line-height: 1.6;">
        <%= @reconciliation.notes %>
      </p>
    </div>
  <% end %>

  <%# ── Verify form / verified footer ──────────────────────────────────── %>
  <% if policy(@reconciliation).verify? && !@reconciliation.verified? %>
    <div style="background: var(--surface); border: 2px solid rgba(var(--accent-rgb), 0.35); border-radius: var(--radius-lg); padding: var(--space-6); box-shadow: var(--shadow-sm);">
      <div style="display: flex; align-items: flex-start; gap: var(--space-4);">
        <div style="flex-shrink: 0; width: 40px; height: 40px; border-radius: var(--radius); background: rgba(var(--accent-rgb), 0.10); display: flex; align-items: center; justify-content: center; color: var(--accent);">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        </div>
        <div style="flex: 1; min-width: 0;">
          <h2 style="font-size: var(--text-base); font-weight: 700; color: var(--text-1); margin: 0 0 var(--space-1);">
            <%= t("finance.daily_reconciliations.show.verify_heading") %>
          </h2>
          <p style="font-size: var(--text-sm); color: var(--text-2); margin: 0 0 var(--space-4);">
            <%= t("finance.daily_reconciliations.show.verify_hint") %>
          </p>
          <%= form_with url: verify_finance_daily_reconciliation_path(@reconciliation), method: :patch do |f| %>
            <div class="form-group" style="margin-bottom: var(--space-4);">
              <%= label_tag :notes, t("finance.daily_reconciliations.show.verify_notes_label"), class: "form-label" %>
              <%= text_area_tag :notes, @reconciliation.notes,
                    class: "form-control",
                    rows: 2,
                    placeholder: t("finance.daily_reconciliations.show.verify_notes_placeholder") %>
            </div>
            <div style="display: flex; justify-content: flex-end;">
              <%= f.submit t("finance.daily_reconciliations.show.verify_submit"), class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% elsif @reconciliation.verified? %>
    <div style="display: flex; align-items: center; justify-content: center; gap: var(--space-2); padding: var(--space-4) 0; color: var(--text-2); font-size: var(--text-sm);">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
      <%= t("finance.daily_reconciliations.show.verified_on",
            name: @reconciliation.verified_by.full_name,
            time: l(@reconciliation.verified_at, format: :time_only)) %>
    </div>
  <% end %>

</div>
