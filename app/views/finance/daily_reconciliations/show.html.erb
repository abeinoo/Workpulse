          handover_created:  {
            dot: "var(--accent)", lbl: "label_till_handover",
            lc: "var(--accent)", lb: "rgba(var(--accent-rgb,99,102,241),0.10)",
            icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0 4.5-4.5M3 16.5h13.5m0-9L21 3m0 0-4.5 4.5M21 3H7.5"/>',
          },
          handover_accepted: {
            dot: "var(--accent)", lbl: "label_till_handover",
            lc: "var(--accent)", lb: "rgba(var(--accent-rgb,99,102,241),0.10)",
