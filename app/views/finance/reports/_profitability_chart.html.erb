<%# locals: rows (array of branch_profitability_rows, already period-filtered) %>
<div class="chart-card exec-span-8 chart-card--primary" data-controller="profitability-metric-chart"
     data-profitability-metric-chart-rows-value="<%= rows.map { |r| {
       branch: r[:branch], revenue: r[:revenue].to_f, expenses: r[:expenses].to_f,
       payroll: r[:payroll].to_f, inventory: r[:inventory].to_f, net: r[:net].to_f,
       previous: {
         revenue: r[:previous][:revenue].to_f, expenses: r[:previous][:expenses].to_f,
         payroll: r[:previous][:payroll].to_f, inventory: r[:previous][:inventory].to_f, net: r[:previous][:net].to_f
       },
       url: finance_branch_profitability_report_path(year: @year, month: @month, branch_id: @branch_ids_by_name[r[:branch]])
     } }.to_json %>"
     data-profitability-metric-chart-metric-labels-value="<%= {
       net: t('finance.reports.net_profit'), revenue: t('finance.reports.revenue'),
       expenses: t('finance.reports.branch_expenses'), payroll: t('finance.reports.payroll_cost'),
       inventory: t('finance.reports.inventory_cost')
     }.to_json %>"
     data-profitability-metric-chart-current-label-value="<%= t('finance.reports.profitability_dashboard.current_period') %>"
     data-profitability-metric-chart-previous-label-value="<%= t('finance.reports.profitability_dashboard.previous_period') %>">
  <div class="chart-card__header">
    <h2 class="section-title--exec"><%= t("finance.reports.profitability_dashboard.chart_title") %></h2>
    <% if rows.present? %>
      <div class="chart-card__toggle">
        <button type="button" class="btn btn-ghost btn-xs is-active" data-profitability-metric-chart-target="option" data-action="profitability-metric-chart#switch" data-metric="net"><%= t("finance.reports.net_profit") %></button>
        <button type="button" class="btn btn-ghost btn-xs" data-profitability-metric-chart-target="option" data-action="profitability-metric-chart#switch" data-metric="revenue"><%= t("finance.reports.revenue") %></button>
        <button type="button" class="btn btn-ghost btn-xs" data-profitability-metric-chart-target="option" data-action="profitability-metric-chart#switch" data-metric="expenses"><%= t("finance.reports.branch_expenses") %></button>
        <button type="button" class="btn btn-ghost btn-xs" data-profitability-metric-chart-target="option" data-action="profitability-metric-chart#switch" data-metric="payroll"><%= t("finance.reports.payroll_cost") %></button>
        <button type="button" class="btn btn-ghost btn-xs" data-profitability-metric-chart-target="option" data-action="profitability-metric-chart#switch" data-metric="inventory"><%= t("finance.reports.inventory_cost") %></button>
      </div>
    <% end %>
  </div>
  <% if rows.present? %>
    <div class="chart-card__body chart-card__body--primary">
      <canvas data-profitability-metric-chart-target="canvas"></canvas>
    </div>
  <% else %>
    <div class="empty-state">
      <%= render "finance/shared/empty_icon" %>
      <p class="empty-state__title"><%= t("finance.reports.profitability_dashboard.no_branches") %></p>
    </div>
  <% end %>
</div>
