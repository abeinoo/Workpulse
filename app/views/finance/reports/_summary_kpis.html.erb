<%# locals: total, previous_total, count, previous_label (optional — the comparison period's dates) %>
<div class="kpi-grid">
  <div class="kpi-card">
    <span class="kpi-card__label"><%= t("finance.reports.breakdown.kpi_total") %></span>
    <span class="kpi-card__value"><%= format_currency(total) %></span>
    <%= render "finance/dashboard/kpi_delta", current: total, previous: previous_total, invert: true %>
  </div>
  <div class="kpi-card">
    <span class="kpi-card__label"><%= t("finance.reports.breakdown.kpi_previous") %></span>
    <span class="kpi-card__value"><%= format_currency(previous_total) %></span>
    <% if local_assigns[:previous_label].present? %>
      <span class="form-hint"><%= previous_label %></span>
    <% end %>
  </div>
  <div class="kpi-card">
    <span class="kpi-card__label"><%= t("finance.reports.breakdown.kpi_count") %></span>
    <span class="kpi-card__value"><%= count %></span>
  </div>
</div>
