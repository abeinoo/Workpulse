<% if table.rows.empty? %>
  <div class="empty-state">
    <%= render "finance/shared/empty_icon" %>
    <p class="empty-state__title"><%= t("finance.reports.no_data") %></p>
    <p class="empty-state__text"><%= t("finance.reports.no_data_hint") %></p>
  </div>
<% else %>
  <div class="table-wrap table-wrap--cards">
    <table>
      <thead><tr>
        <% table.columns.each do |col| %>
          <th style="<%= 'text-align: end;' if col.money %>"><%= col.label %></th>
        <% end %>
      </tr></thead>
      <tbody>
        <% table.rows.each do |row| %>
          <tr>
            <% table.columns.each do |col| %>
              <td style="<%= 'text-align: end;' if col.money %>">
                <% if col.money %>
                  <%= content_tag :span, format_currency(row[col.key]), class: (row[col.key].to_d.negative? ? "amount-negative" : "amount-positive") %>
                <% else %>
                  <%= row[col.key] %>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
      <% if table.totals? %>
        <tfoot>
          <tr>
            <% table.columns.each_with_index do |col, i| %>
              <td style="<%= 'text-align: end;' if col.money %>">
                <strong>
                  <% if table.totals.key?(col.key) %>
                    <% if col.money %>
                      <%= content_tag :span, format_currency(table.totals[col.key]), class: (table.totals[col.key].to_d.negative? ? "amount-negative" : "amount-positive") %>
                    <% else %>
                      <%= table.totals[col.key] %>
                    <% end %>
                  <% elsif i.zero? %>
                    <%= t("finance.reports.total") %>
                  <% end %>
                </strong>
              </td>
            <% end %>
          </tr>
        </tfoot>
      <% end %>
    </table>
  </div>
<% end %>
