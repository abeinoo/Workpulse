<%#
  Filter bar for Expenses by Type / by Category. locals:
    filters  — Finance::Reports::ExpenseReportFilters::Result (validated)
    branches — the branches of the viewer's business

  The custom from/to dates show only for the "custom" period (period-filter
  Stimulus controller; without JS they simply stay visible). The server
  re-validates everything — the branch list here is a convenience, not the
  authorization.
%>
<% scope = "finance.reports.expense_filters" %>
<% if filters.error.present? %>
  <div class="alert alert-warning mb-4" role="alert"><%= filters.error %></div>
<% end %>

<%= form_with url: request.path, method: :get, local: true, class: "filter-bar expense-report-filters", data: { controller: "period-filter" } do %>
  <div class="filter-bar__fields">
    <div class="filter-bar__field">
      <%= label_tag :period, t("#{scope}.period"), class: "filter-bar__label" %>
      <%= select_tag :period,
            options_for_select(Finance::Reports::ExpenseReportFilters::PRESETS.map { |p| [ t("#{scope}.presets.#{p}"), p ] },
                               filters.preset),
            class: "form-control form-control--sm",
            data: { period_filter_target: "typeSelect", action: "change->period-filter#toggle" } %>
    </div>
    <div class="filter-bar__field" data-period-filter-target="customFields">
      <%= label_tag :from, t("finance.dashboard.filters.from"), class: "filter-bar__label" %>
      <%= date_field_tag :from, filters.from.iso8601, class: "filter-bar__input" %>
    </div>
    <div class="filter-bar__field" data-period-filter-target="customFields">
      <%= label_tag :to, t("finance.dashboard.filters.to"), class: "filter-bar__label" %>
      <%= date_field_tag :to, filters.to.iso8601, class: "filter-bar__input" %>
    </div>
    <div class="filter-bar__field">
      <%= label_tag :branch_id, t("finance.expenses.branch"), class: "filter-bar__label" %>
      <%= select_tag :branch_id,
            options_for_select(
              [ [ t("#{scope}.all_branches"), "" ] ] +
                branches.map { |b| [ b.active? ? b.name : "#{b.name} (#{t('finance.common.inactive')})", b.id ] },
              filters.branch_id
            ),
            class: "form-control form-control--sm" %>
    </div>
  </div>
  <div class="filter-bar__actions">
    <%= submit_tag t("#{scope}.apply"), name: nil, class: "btn btn-primary btn-sm" %>
    <%= link_to t("#{scope}.reset"), request.path, class: "btn btn-secondary btn-sm" %>
  </div>
<% end %>
<% if filters.branch %>
  <p class="form-hint mb-4"><%= t("#{scope}.shared_note") %></p>
<% end %>
