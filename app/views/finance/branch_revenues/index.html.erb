<% content_for :title, t("finance.branch_revenues.title") %>

<div class="admin-page">
  <div class="page-header">
    <h1 class="page-title"><%= t("finance.branch_revenues.title") %></h1>
    <% if policy(BranchRevenue).new? %>
      <%= link_to t("finance.branch_revenues.add"), new_finance_branch_revenue_path, class: "btn btn-primary btn-sm" %>
    <% end %>
  </div>

  <p class="form-hint mb-4"><%= t("finance.branch_revenues.intro") %></p>

  <% if @revenues.empty? %>
    <div class="empty-state"><p class="empty-state__title"><%= t("finance.branch_revenues.empty") %></p></div>
  <% else %>
    <div class="table-wrap table-wrap--cards">
      <table>
        <thead><tr>
          <th><%= t("finance.branch_revenues.branch") %></th>
          <th><%= t("finance.branch_revenues.month") %></th>
          <th style="text-align: end;"><%= t("finance.branch_revenues.amount") %></th>
          <th></th>
        </tr></thead>
        <tbody>
          <% @revenues.each do |rev| %>
            <tr>
              <td><%= rev.branch.name %></td>
              <td><%= l(rev.period_month, format: "%B %Y") %></td>
              <td style="text-align: end;"><%= format_currency(rev.amount) %></td>
              <td class="td-actions">
                <% if policy(rev).update? %>
                  <%= link_to t("common.edit"), edit_finance_branch_revenue_path(rev), class: "link-muted" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
