<%= form_with model: [ :finance, revenue ], class: "form-card" do |f| %>
  <%= render "shared/error_messages", object: revenue %>
  <div class="form-grid">
    <div class="form-group">
      <%= f.label :branch_id, t("finance.branch_revenues.branch"), class: "form-label" %>
      <%= f.select :branch_id,
            options_from_collection_for_select(@branches, :id, :name, revenue.branch_id),
            { include_blank: "— #{t('finance.branch_revenues.select_branch')}" },
            class: "form-control #{'is-error' if revenue.errors[:branch].any?}" %>
    </div>
    <div class="form-group">
      <%= f.label :period_month, t("finance.branch_revenues.month"), class: "form-label" %>
      <%= f.month_field :period_month, class: "form-control #{'is-error' if revenue.errors[:period_month].any?}" %>
    </div>
    <div class="form-group">
      <%= f.label :amount, t("finance.branch_revenues.amount"), class: "form-label" %>
      <%= f.number_field :amount, step: "0.01", min: 0, class: "form-control #{'is-error' if revenue.errors[:amount].any?}" %>
    </div>
    <div class="form-group" style="grid-column: 1 / -1;">
      <%= f.label :notes, t("finance.common.notes"), class: "form-label" %>
      <%= f.text_area :notes, rows: 2, class: "form-control" %>
    </div>
  </div>
  <div class="form-actions">
    <%= f.submit t("common.save"), class: "btn btn-primary" %>
    <%= link_to t("common.cancel"), finance_branch_revenues_path, class: "btn btn-ghost" %>
  </div>
<% end %>
