<% css = case transaction.status
         when "verified"              then "badge-success"
         when "amount_mismatch"       then "badge-warning"
         when "date_mismatch"         then "badge-warning"
         when "unexpected"            then "badge-danger"
         when "needs_reverification"  then "badge-danger"
         when "needs_manual_review"   then "badge-warning"
         when "ignored"               then "badge-neutral"
         else                              "badge-neutral"
         end %>
<span class="badge <%= css %>"><%= t("finance.bank_statement_transactions.statuses.#{transaction.status}") %></span>
<% if transaction.manual_match? %>
  <span class="badge badge-accent"><%= t("finance.bank_statement_transactions.statuses.matched_manually") %></span>
<% end %>
<% if transaction.date_mismatch? && (days = transaction.date_mismatch_days) %>
  <span style="font-size: var(--text-xs); color: var(--text-3);">
    <%= t("finance.bank_statement_transactions.show.date_diff", count: days) %>
  </span>
<% end %>
