<% content_for :title, t("finance.expenses.title") %>

<div class="admin-page">
  <%
    can_manage_categories = policy(ExpenseCategory).create?
    can_manage_types      = policy(ExpenseType).create?
    can_manage_tags       = policy(ExpenseTag).create?
    any_manage_link       = can_manage_categories || can_manage_types || can_manage_tags
  %>
  <div class="page-header">
    <h1 class="page-title"><%= t("finance.expenses.title") %></h1>
    <%# Primary action first on mobile; setup links grouped in one menu so the
        header never overflows (reuses the .row-actions dropdown pattern). %>
    <div class="page-header__actions expenses-header-actions">
      <% if any_manage_link %>
        <div class="row-actions expenses-header-actions__menu" data-controller="dropdown">
          <button type="button" class="btn btn-secondary btn-sm"
                  data-dropdown-target="button" data-action="click->dropdown#toggle"
                  aria-haspopup="true" aria-expanded="false">
            <%= t("finance.expenses.manage_menu") %>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="row-actions__menu" data-dropdown-target="menu" role="menu" hidden>
            <% if can_manage_categories %>
              <%= link_to t("finance.expenses.manage_categories"), finance_expense_categories_path, class: "row-actions__item", role: "menuitem" %>
            <% end %>
            <% if can_manage_types %>
              <%= link_to t("finance.expenses.manage_types"), finance_expense_types_path, class: "row-actions__item", role: "menuitem" %>
            <% end %>
            <% if can_manage_tags %>
              <%= link_to t("finance.expenses.manage_tags"), finance_expense_tags_path, class: "row-actions__item", role: "menuitem" %>
            <% end %>
          </div>
        </div>
      <% end %>
      <% if current_user.can?(:manage_recurring_expenses) %>
        <%= link_to t("finance.expenses.recurring"), finance_recurring_expenses_path, class: "btn btn-secondary btn-sm" %>
      <% end %>
      <% if policy(Expense).new? %>
        <%= link_to t("finance.expenses.add"), new_finance_expense_path, class: "btn btn-primary btn-sm expenses-header-actions__primary" %>
      <% end %>
    </div>
  </div>

  <%# ── Filter bar ─────────────────────────────────────────────────────────── %>
  <%= form_with url: finance_expenses_path, method: :get, local: true, class: "filter-bar",
        data: {
          controller: "expense-type-select",
          expense_type_select_url_value: options_finance_expense_types_path,
          expense_type_select_placeholder_value: t("finance.expenses.all_types"),
          expense_type_select_initial_type_id_value: params[:expense_type_id],
          expense_type_select_disable_when_empty_value: false
        } do |f| %>
    <div class="filter-bar__fields">

      <div class="filter-bar__field">
        <%= f.label :status, t("finance.common.status"), class: "filter-bar__label" %>
        <%= f.select :status,
              options_for_select(
                [[ t("finance.expenses.all_statuses"), "" ]] +
                  Expense::STATUSES.map { |s| [ t("finance.expenses.statuses.#{s}"), s ] },
                params[:status]),
              {}, class: "filter-bar__select" %>
      </div>

      <% if @filter_branches.any? %>
        <div class="filter-bar__field">
          <%= f.label :branch_id, t("finance.expenses.branch"), class: "filter-bar__label" %>
          <%= f.select :branch_id,
                options_for_select(
                  [[ t("finance.expenses.all_branches"), "" ]] +
                    @filter_branches.map { |b| [ b.name, b.id ] },
                  params[:branch_id]),
                {}, class: "filter-bar__select" %>
        </div>
      <% end %>

      <% if @filter_categories.any? %>
        <div class="filter-bar__field">
          <%= f.label :expense_category_id, t("finance.expenses.category"), class: "filter-bar__label" %>
          <%= f.select :expense_category_id,
                options_for_select(
                  [[ t("finance.expenses.all_categories"), "" ]] +
                    @filter_categories.map { |c| [ c.name, c.id ] },
                  params[:expense_category_id]),
                {},
                class: "filter-bar__select",
                data: { expense_type_select_target: "categorySelect",
                        action: "change->expense-type-select#categoryChanged" } %>
        </div>
      <% end %>

      <% if @filter_types.any? %>
        <div class="filter-bar__field">
          <%= f.label :expense_type_id, t("finance.expenses.type"), class: "filter-bar__label" %>
          <%= f.select :expense_type_id,
                options_for_select(
                  [[ t("finance.expenses.all_types"), "" ]] +
                    @filter_types.map { |t| [ t.name, t.id ] },
                  params[:expense_type_id]),
                {},
                class: "filter-bar__select",
                data: { expense_type_select_target: "typeSelect" } %>
        </div>
      <% end %>

      <% if @filter_creators.any? %>
        <div class="filter-bar__field">
          <%= f.label :created_by_id, t("finance.expenses.created_by"), class: "filter-bar__label" %>
          <%= f.select :created_by_id,
                options_for_select(
                  [[ t("finance.expenses.all_creators"), "" ]] +
                    @filter_creators.map { |u| [ u.full_name, u.id ] },
                  params[:created_by_id]),
                {}, class: "filter-bar__select" %>
        </div>
      <% end %>

      <div class="filter-bar__field">
        <%= f.label :from, t("finance.expenses.date_from"), class: "filter-bar__label" %>
        <%= f.date_field :from, value: params[:from], class: "filter-bar__input" %>
      </div>

      <div class="filter-bar__field">
        <%= f.label :to, t("finance.expenses.date_to"), class: "filter-bar__label" %>
        <%= f.date_field :to, value: params[:to], class: "filter-bar__input" %>
      </div>

    </div>
    <div class="filter-bar__actions">
      <%= f.submit t("finance.common.filter"), class: "btn btn-primary btn-sm" %>
      <% if params[:status].present? || params[:branch_id].present? || params[:expense_category_id].present? || params[:expense_type_id].present? || params[:created_by_id].present? || params[:from].present? || params[:to].present? %>
        <%= link_to t("finance.expenses.clear_filters"), finance_expenses_path, class: "btn btn-ghost btn-sm" %>
      <% end %>
    </div>
  <% end %>

  <% if @expenses.empty? %>
    <div class="empty-state"><p class="empty-state__title"><%= t("finance.expenses.empty") %></p></div>
  <% else %>
    <%# Desktop: an 8-column table (related values stacked in one cell).
        When the LIST itself is narrow (container query, not viewport — the
        finance sidebars leave ~640px at a 1024px screen), each row becomes a
        card laid out in priority order. One markup, so approve/reject and the
        inline reject form behave identically in both layouts. %>
    <div class="expense-list">
      <div class="table-wrap expense-list__table">
        <table>
          <thead>
            <tr>
              <th>
                <%= t("finance.expenses.reference") %>
                <span class="expense-list__th-sub"><%= t("finance.expenses.date") %></span>
              </th>
              <th><%= t("finance.expenses.branch") %></th>
              <th>
                <%= t("finance.expenses.category") %>
                <span class="expense-list__th-sub"><%= t("finance.expenses.type") %></span>
              </th>
              <th class="expense-list__num"><%= t("finance.expenses.amount") %></th>
              <th><%= t("finance.common.status") %></th>
              <th>
                <%= t("finance.expenses.payment_source") %>
                <span class="expense-list__th-sub"><%= t("finance.expenses.payment_status") %></span>
              </th>
              <th><%= t("finance.expenses.created_by") %></th>
              <th><span class="sr-only"><%= t("finance.expenses.actions_column") %></span></th>
            </tr>
          </thead>

          <% @expenses.each do |expense| %>
            <%
              branch_name    = expense.is_shared? ? t("finance.expenses.shared") : (expense.branch&.name || "—")
              category_name  = expense.expense_category.name
              type_name      = expense.expense_type&.name || "—"
              creator_name   = expense.created_by&.full_name || "—"
              paid           = @paid_amounts.fetch(expense.id, 0)
              payment_status = expense_payment_status(paid, expense.amount)
              can_approve    = policy(expense).approve?
              can_reject     = policy(expense).reject?
            %>
            <tbody data-controller="<%= 'collapsible' if can_reject %>">
              <tr class="expense-list__row">
                <td class="expense-list__cell--ref">
                  <%= link_to expense.reference_number, finance_expense_path(expense), class: "link expense-list__ref" %>
                  <span class="expense-list__date"><%= l(expense.expense_date, format: :long) %></span>
                </td>
                <td class="expense-list__field expense-list__branch" data-label="<%= t("finance.expenses.branch") %>">
                  <span class="expense-list__clamp" title="<%= branch_name %>"><%= branch_name %></span>
                </td>
                <td class="expense-list__cell--class">
                  <span class="expense-list__field expense-list__category" data-label="<%= t("finance.expenses.category") %>">
                    <span class="expense-list__clamp" title="<%= category_name %>"><%= category_name %></span>
                  </span>
                  <span class="expense-list__field expense-list__type" data-label="<%= t("finance.expenses.type") %>">
                    <span class="expense-list__clamp" title="<%= type_name %>"><%= type_name %></span>
                  </span>
                </td>
                <td class="expense-list__num expense-list__amount"><%= format_currency(expense.amount) %></td>
                <td class="expense-list__status">
                  <%= render "finance/expenses/status_badge", status: expense.status %>
                </td>
                <td class="expense-list__cell--payment">
                  <span class="expense-list__field expense-list__source" data-label="<%= t("finance.expenses.payment_source") %>">
                    <span><%= render "finance/expenses/payment_source_badge", source: expense.payment_source %></span>
                  </span>
                  <span class="expense-list__field expense-list__paystatus" data-label="<%= t("finance.expenses.payment_status") %>">
                    <span class="expense-list__badges">
                      <span class="badge <%= expense.direct? ? 'badge-accent' : 'badge-neutral' %>">
                        <%= t("finance.expenses.payment_types.#{expense.payment_type}") %>
                      </span>
                      <span class="badge <%= expense_financial_status_badge_class(payment_status) %>">
                        <%= t("finance.expenses.financial_statuses.#{payment_status}") %>
                      </span>
                      <span class="expense-list__paid"><span><%= format_currency(paid) %></span> / <span><%= format_currency(expense.amount) %></span></span>
                    </span>
                  </span>
                </td>
                <td class="expense-list__field expense-list__creator" data-label="<%= t("finance.expenses.created_by") %>">
                  <span class="expense-list__clamp" title="<%= creator_name %>"><%= creator_name %></span>
                </td>
                <td class="expense-list__actions">
                  <div class="expense-list__action-group">
                    <% if can_approve %>
                      <%= button_to t("finance.expenses.actions.approve"),
                            approve_finance_expense_path(expense),
                            method: :patch,
                            params: { from_index: 1 }.merge(index_filter_params),
                            class: "btn btn-success btn-sm",
                            form: { class: "expense-list__action-form" },
                            "aria-label": "#{t('finance.expenses.actions.approve')} #{expense.reference_number}" %>
                    <% end %>
                    <% if can_reject %>
                      <button type="button"
                              class="btn btn-danger btn-sm"
                              data-collapsible-target="trigger"
                              data-action="click->collapsible#toggle"
                              aria-label="<%= t("finance.expenses.actions.reject") %> <%= expense.reference_number %>">
                        <%= t("finance.expenses.actions.reject") %>
                      </button>
                    <% end %>
                    <%= link_to t("finance.expenses.actions.view"),
                          finance_expense_path(expense),
                          class: "btn btn-ghost btn-sm",
                          "aria-label": "#{t('finance.expenses.actions.view')} #{expense.reference_number}" %>
                  </div>
                </td>
              </tr>

              <%# Inline reject form – revealed by collapsible trigger above %>
              <% if can_reject %>
                <tr class="expense-list__reject-row" data-collapsible-target="content" hidden>
                  <td colspan="8">
                    <%= form_with url: reject_finance_expense_path(expense), method: :patch, class: "expense-list__reject-form" do %>
                      <%= hidden_field_tag :from_index, 1 %>
                      <% index_filter_params.each do |key, value| %>
                        <%= hidden_field_tag key, value %>
                      <% end %>
                      <%= label_tag "rejection_reason_#{expense.id}", t("finance.expenses.rejection_placeholder"), class: "sr-only" %>
                      <%= text_field_tag :rejection_reason, nil,
                            id: "rejection_reason_#{expense.id}",
                            placeholder: t("finance.expenses.rejection_placeholder"),
                            class: "form-control form-control--sm",
                            required: true %>
                      <%= submit_tag t("finance.expenses.actions.reject"), class: "btn btn-danger btn-sm" %>
                      <button type="button" class="btn btn-ghost btn-sm"
                              data-action="click->collapsible#toggle">
                        <%= t("common.cancel") %>
                      </button>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          <% end %>

        </table>
      </div>
    </div>
  <% end %>
</div>
