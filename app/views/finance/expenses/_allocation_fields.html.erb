<tr data-line-row>
  <td>
    <%= f.select :branch_id,
          options_from_collection_for_select(branches, :id, :name, f.object.branch_id),
          { include_blank: "— #{t('finance.expenses.select_branch')}" },
          class: "form-control", required: true %>
  </td>
  <td data-allocation-target="pctCell">
    <%= f.number_field :allocation_percentage,
          step: "0.01", min: 0, max: 100,
          value: (f.object.new_record? ? nil : f.object.allocation_percentage),
          class: "form-control",
          placeholder: "%",
          required: true,
          data: { allocation_target: "pctInput", action: "input->allocation#inputChanged" } %>
  </td>
  <td class="td-actions">
    <% if f.object.persisted? %>
      <%= f.hidden_field :_destroy, value: "0", data: { destroy_field: true } %>
    <% end %>
    <button type="button" class="btn btn-ghost btn-sm text-danger" data-action="line-items#remove" aria-label="<%= t('common.delete') %>">&times;</button>
  </td>
</tr>
