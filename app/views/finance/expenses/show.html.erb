<% content_for :title, @expense.reference_number %>

<div class="admin-page">
  <%= link_to finance_expenses_path, class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    <%= t("forms.back") %>
  <% end %>

  <%# ── Summary card ────────────────────────────────────────────────────────── %>
  <div class="card" style="margin-bottom: var(--space-5);"
       <%= "data-controller='collapsible'".html_safe if policy(@expense).reject? %>>

    <div class="card-header">
      <div style="display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap;">
        <h1 class="card-title" style="margin: 0; font-size: var(--text-lg);">
          <%= @expense.reference_number %>
        </h1>
        <%= render "finance/expenses/status_badge", status: @expense.status, size: "md" %>
        <% if @expense.system_generated? %>
          <span class="badge badge-neutral"><%= t("insurance.generated_automatically") %></span>
        <% end %>
      </div>

      <div class="page-header__actions">
        <% if policy(@expense).update? %>
          <%= link_to t("common.edit"), edit_finance_expense_path(@expense), class: "btn btn-secondary btn-sm" %>
        <% end %>
        <% if policy(@expense).submit? %>
          <%= button_to t("finance.expenses.actions.submit"), submit_finance_expense_path(@expense),
                method: :patch, class: "btn btn-primary btn-sm",
                form: { style: "display:inline" } %>
        <% end %>
        <% if policy(@expense).approve? %>
          <%= button_to t("finance.expenses.actions.approve"), approve_finance_expense_path(@expense),
                method: :patch, class: "btn btn-success btn-sm",
                form: { style: "display:inline" } %>
        <% end %>
        <% if policy(@expense).reject? %>
          <button type="button" class="btn btn-danger btn-sm"
                  data-collapsible-target="trigger"
                  data-action="click->collapsible#toggle"
                  aria-expanded="false">
            <%= t("finance.expenses.actions.reject") %>
          </button>
        <% end %>
        <% if policy(@expense).destroy? %>
          <%= button_to t("common.delete"), finance_expense_path(@expense), method: :delete,
                class: "btn btn-ghost btn-sm text-danger",
                form: { style: "display:inline" },
                data: { turbo_confirm: t("finance.expenses.confirm_delete") } %>
        <% end %>
      </div>
    </div>

    <dl class="detail-list" style="margin-bottom: 0;">
      <div class="detail-list__row">
        <dt><%= t("finance.expenses.amount") %></dt>
        <dd><strong><%= format_currency(@expense.amount) %></strong></dd>
      </div>
      <div class="detail-list__row">
        <dt><%= t("finance.expenses.date") %></dt>
        <dd><%= l(@expense.expense_date, format: :long) %></dd>
      </div>
      <div class="detail-list__row">
        <dt><%= t("finance.expenses.branch") %></dt>
        <dd><%= @expense.is_shared? ? t("finance.expenses.shared") : (@expense.branch&.name || "—") %></dd>
      </div>
      <div class="detail-list__row">
        <dt><%= t("finance.expenses.category") %></dt>
        <dd><%= @expense.expense_category.name %></dd>
      </div>
      <div class="detail-list__row">
        <dt><%= t("finance.expenses.type") %></dt>
        <dd><%= @expense.expense_type&.name || "—" %></dd>
      </div>
      <div class="detail-list__row">
        <dt><%= t("finance.expenses.created_by") %></dt>
        <dd><%= @expense.created_by&.full_name || "—" %></dd>
      </div>
      <% if @expense.approved_by %>
        <div class="detail-list__row">
          <dt><%= t("finance.expenses.approved_by") %></dt>
          <dd><%= @expense.approved_by.full_name %></dd>
        </div>
      <% end %>
      <% if @expense.source_payroll_period %>
        <div class="detail-list__row">
          <dt><%= t("insurance.generated_from_payroll") %></dt>
          <dd><%= t("insurance.reference_period", period: "#{@expense.source_payroll_period.period_month}/#{@expense.source_payroll_period.period_year}") %></dd>
        </div>
      <% end %>
      <% if @expense.notes.present? %>
        <div class="detail-list__row">
          <dt><%= t("finance.common.notes") %></dt>
          <dd><%= simple_format(@expense.notes) %></dd>
        </div>
      <% end %>
      <% if @expense.expense_tags.any? %>
        <div class="detail-list__row">
          <dt><%= t("finance.expenses.tags_label") %></dt>
          <dd>
            <% @expense.expense_tags.each do |tag| %>
              <span class="badge"><%= tag.name %></span>
            <% end %>
          </dd>
        </div>
      <% end %>
      <% if @expense.rejected? && @expense.rejection_reason.present? %>
        <div class="detail-list__row">
          <dt><%= t("finance.expenses.rejection_reason") %></dt>
          <dd style="color: var(--danger);"><%= @expense.rejection_reason %></dd>
        </div>
      <% end %>
    </dl>

    <% if policy(@expense).reject? %>
      <div data-collapsible-target="content" hidden
           style="padding: var(--space-4) var(--space-5); border-top: 1px solid var(--border); background: var(--navy-700);">
        <%= form_with url: reject_finance_expense_path(@expense), method: :patch,
              style: "display: flex; gap: var(--space-2); align-items: center; flex-wrap: wrap;" do %>
          <%= text_field_tag :rejection_reason, nil,
                placeholder: t("finance.expenses.rejection_placeholder"),
                class: "form-control form-control--sm",
                style: "flex: 1; min-width: 200px;",
                required: true %>
          <%= submit_tag t("finance.expenses.actions.reject"), class: "btn btn-danger btn-sm" %>
          <button type="button" class="btn btn-ghost btn-sm"
                  data-action="click->collapsible#toggle">
            <%= t("common.cancel") %>
          </button>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# ── Financial Information card ─────────────────────────────────────────── %>
  <div class="card" style="margin-bottom: var(--space-5);">
    <div class="card-header">
      <h2 class="card-title"><%= t("finance.expenses.financial_information") %></h2>
    </div>
    <dl class="detail-list">
      <div class="detail-list__row">
        <dt><%= t("finance.expenses.payment_source") %></dt>
        <dd><%= render "finance/expenses/payment_source_badge", source: @expense.payment_source %></dd>
      </div>
      <div class="detail-list__row">
        <dt><%= t("finance.expenses.financial_status") %></dt>
        <dd>
          <span class="badge <%= { "pending_settlement" => "badge-warning", "partially_settled" => "badge-accent", "settled" => "badge-success" }.fetch(@expense.financial_status) %>">
            <%= t("finance.expenses.financial_statuses.#{@expense.financial_status}") %>
          </span>
        </dd>
      </div>
      <div class="detail-list__row">
        <dt><%= t("finance.expenses.paid_amount") %></dt>
        <dd><%= format_currency(@expense.total_settled_amount) %></dd>
      </div>
      <div class="detail-list__row">
        <dt><%= t("finance.expenses.remaining_amount") %></dt>
        <dd><%= format_currency(@expense.remaining_settlement_amount) %></dd>
      </div>
      <% if @expense.employee_custody_funded? && @settlements.any? %>
        <div class="detail-list__row">
          <dt><%= t("finance.expenses.financial_settlement") %></dt>
          <dd>
            <%= link_to t("finance.expenses.view_custody_account"),
                  finance_custody_account_path(@settlements.first.funding_source),
                  class: "link" %>
          </dd>
        </div>
      <% end %>
    </dl>
  </div>

  <%# ── Allocations card ───────────────────────────────────────────────────── %>
  <% if @allocations.any? %>
    <div class="card" style="margin-bottom: var(--space-5);">
      <div class="card-header">
        <h2 class="card-title"><%= t("finance.expenses.section_allocations") %></h2>
      </div>
      <div class="table-wrap" style="margin-bottom: 0;">
        <table>
          <thead><tr>
            <th><%= t("finance.expenses.branch") %></th>
            <th style="text-align: end;"><%= t("finance.expenses.percentage") %></th>
            <th style="text-align: end;"><%= t("finance.expenses.allocated_amount") %></th>
          </tr></thead>
          <tbody>
            <% @allocations.each do |alloc| %>
              <tr>
                <td><%= alloc.branch.name %></td>
                <td style="text-align: end;"><%= number_with_precision(alloc.allocation_percentage, precision: 2) %>%</td>
                <td style="text-align: end;"><%= format_currency(alloc.allocated_amount) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <%# ── Attachments card ───────────────────────────────────────────────────── %>
  <% if @expense.documents.attached? %>
    <div class="card" style="margin-bottom: var(--space-5);">
      <div class="card-header">
        <h2 class="card-title"><%= t("finance.expenses.documents") %></h2>
      </div>
      <div style="padding: var(--space-4) var(--space-5);">
        <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2);">
          <% @expense.documents.each do |doc| %>
            <li>
              <%= link_to url_for(doc), target: "_blank", rel: "noopener",
                    class: "link",
                    style: "display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm);" do %>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                <%= doc.filename %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <%# ── Activity log card ──────────────────────────────────────────────────── %>
  <% if @audit_logs.any? %>
    <div class="card">
      <div class="card-header">
        <h2 class="card-title"><%= t("finance.expenses.history") %></h2>
      </div>
      <div style="padding: 0 var(--space-5) var(--space-4);">
        <ul class="timeline" style="margin-top: var(--space-3);">
          <% @audit_logs.each do |log| %>
            <li>
              <strong><%= t("finance.expenses.audit.#{log.action}", default: log.action.humanize) %></strong>
              — <%= log.actor.full_name %>
              <span class="td-secondary"><%= l(log.created_at, format: :short) %></span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>
</div>
