<%= form_with model: [ :finance, expense ], class: "form-card",
      data: {
        controller: "line-items allocation expense-type-select expense-scope payment-type",
        expense_type_select_url_value: options_finance_expense_types_path,
        expense_type_select_placeholder_value: "— #{t('finance.expenses.select_type')}",
        expense_type_select_initial_type_id_value: expense.expense_type_id,
        allocation_currency_value: format_currency_parts(0).first,
        allocation_rtl_value: I18n.locale.to_s == "ar",
        allocation_short_message_value: t("activerecord.errors.messages.allocation_amount_short", amount: "%{amount}"),
        allocation_exceeds_message_value: t("activerecord.errors.messages.allocation_amount_exceeds", amount: "%{amount}"),
        allocation_not_positive_message_value: t("activerecord.errors.messages.allocation_amount_not_positive"),
        allocation_precision_message_value: t("activerecord.errors.messages.allocation_amount_precision")
      } do |f| %>
  <%= render "shared/error_messages", object: expense %>

  <h2 class="section-title"><%= t("finance.expenses.section_details") %></h2>
  <div class="form-grid">

    <div class="form-group">
      <%= f.label :expense_category_id, t("finance.expenses.category"), class: "form-label" %>
      <%= f.select :expense_category_id,
            options_from_collection_for_select(@categories, :id, :name, expense.expense_category_id),
            { include_blank: "— #{t('finance.expenses.select_category')}" },
            class: "form-control #{'is-error' if expense.errors[:expense_category].any?}",
            data: { expense_type_select_target: "categorySelect",
                    action: "change->expense-type-select#categoryChanged" } %>
    </div>
    <div class="form-group">
      <%= f.label :expense_type_id, t("finance.expenses.type"), class: "form-label" %>
      <%= f.select :expense_type_id,
            options_from_collection_for_select(@types, :id, :name, expense.expense_type_id),
            { include_blank: "— #{t('finance.expenses.select_type')}" },
            class: "form-control #{'is-error' if expense.errors[:expense_type].any?}",
            data: { expense_type_select_target: "typeSelect" } %>
    </div>
    <div class="form-group">
      <%= f.label :amount, t("finance.expenses.amount"), class: "form-label" %>
      <%= f.number_field :amount, step: "0.01", min: 0, class: "form-control #{'is-error' if expense.errors[:amount].any?}",
            data: { allocation_target: "expenseAmount", action: "input->allocation#inputChanged" } %>
      <p class="form-hint"><%= t("finance.expenses.amount_hint") %></p>
    </div>
    <div class="form-group">
      <%= f.label :expense_date, t("finance.expenses.date"), class: "form-label" %>
      <%= f.date_field :expense_date, class: "form-control #{'is-error' if expense.errors[:expense_date].any?}" %>
    </div>

    <% unless @hide_branch %>
      <div class="form-group">
        <%= f.label :branch_id, t("finance.expenses.branch"), class: "form-label" %>
        <%
          branch_options = @show_shared_section ? [ [ t("finance.expenses.shared_option"), "shared" ] ] : []
          branch_options += @branches.map { |b| [ b.name, b.id ] }
          selected_branch_value = expense.is_shared? ? "shared" : expense.branch_id
        %>
        <%= f.select :branch_id,
              options_for_select(branch_options, selected_branch_value),
              { include_blank: "— #{t('finance.expenses.select_branch_placeholder')}" },
              class: "form-control #{'is-error' if expense.errors[:branch_id].any?}",
              required: true,
              data: { action: "change->expense-scope#branchChanged change->allocation#refresh",
                      "expense-scope-target": "branchSelect" } %>
        <p class="form-hint"><%= t("finance.expenses.branch_hint") %></p>
      </div>
    <% end %>
  </div>

  <div class="form-group" style="margin-top: var(--space-4);">
    <%= f.label :documents, t("finance.expenses.documents"), class: "form-label" %>
    <%= f.file_field :documents, multiple: true, class: "form-control" %>
    <p class="form-hint"><%= t("finance.expenses.documents_hint") %></p>
  </div>

  <div class="form-group">
    <%= f.label :notes, t("finance.common.notes"), class: "form-label" %>
    <%= f.text_area :notes, rows: 2,
          class: "form-control #{'is-error' if expense.errors[:notes].any?}" %>
  </div>

  <% if @tags.any? %>
    <div class="divider"></div>
    <h2 class="section-title"><%= t("finance.tags.title") %></h2>
    <div class="checkbox-grid">
      <%= f.collection_check_boxes :expense_tag_ids, @tags, :id, :name do |b| %>
        <label class="form-check">
          <%= b.check_box(class: "form-check-input") %>
          <span class="form-check-label"><%= b.text %></span>
        </label>
      <% end %>
    </div>
  <% end %>

  <% if @show_shared_section %>
  <div data-expense-scope-target="allocationSection" data-allocation-target="section"
       <%= "hidden" unless expense.is_shared? %>>
    <div class="divider"></div>
    <h2 class="section-title"><%= t("finance.expenses.section_allocations") %></h2>

    <p class="form-hint" data-allocation-target="pctMsg">
      <%= t("finance.expenses.hint_percentage_mode") %>
    </p>
    <p class="form-hint" data-allocation-target="equalMsg" hidden>
      <%= t("finance.expenses.hint_equal_mode") %>
    </p>
    <p class="form-hint" data-allocation-target="amountMsg" hidden>
      <%= t("finance.expenses.hint_amount_mode") %>
    </p>

    <div class="form-group" style="max-width: 280px;">
      <%= f.label :distribution_method, t("finance.expenses.distribution_method"), class: "form-label" %>
      <%= f.select :distribution_method,
            options_for_select(
              [ [ t("finance.expenses.modes.percentage"), "percentage" ],
                [ t("finance.expenses.modes.equal"), "equal" ],
                [ t("finance.expenses.modes.manual"), "manual" ] ],
              expense.distribution_method),
            { include_blank: "— #{t('finance.expenses.select_distribution_method')}" },
            class: "form-control #{'is-error' if expense.errors[:distribution_method].any?}",
            required: true,
            data: { allocation_target: "modeSelect", action: "change->allocation#modeChanged" } %>
    </div>

    <div class="table-wrap table-wrap--form-cards">
      <table class="line-items-table">
        <thead><tr>
          <th style="width: 60%;"><%= t("finance.expenses.branch") %></th>
          <th data-allocation-target="pctHeader"><%= t("finance.expenses.percentage") %></th>
          <th data-allocation-target="amtHeader" hidden><%= t("finance.expenses.branch_amount") %></th>
          <th></th>
        </tr></thead>
        <tbody data-line-items-target="rows">
          <%= f.fields_for :expense_allocations do |alloc_f| %>
            <%= render "allocation_fields", f: alloc_f, branches: @branches %>
          <% end %>
        </tbody>
      </table>
    </div>

    <dl data-allocation-target="amountSummary" class="form-hint" style="margin-top: var(--space-2);" hidden>
      <div><dt style="display: inline;"><%= t("finance.expenses.amount_summary.expense_total") %>:</dt>
           <dd style="display: inline; margin: 0;" data-allocation-target="amountTotal"></dd></div>
      <div><dt style="display: inline;"><%= t("finance.expenses.amount_summary.distributed_total") %>:</dt>
           <dd style="display: inline; margin: 0;" data-allocation-target="amountDistributed"></dd></div>
      <div><dt style="display: inline;"><%= t("finance.expenses.amount_summary.remaining") %>:</dt>
           <dd style="display: inline; margin: 0;" data-allocation-target="amountRemaining"></dd></div>
    </dl>

    <p data-allocation-target="summary" class="form-hint" style="margin-top: var(--space-2);"></p>

    <p data-line-items-target="emptyState" class="td-secondary" <%= "hidden" if expense.expense_allocations.any? %>>
      <%= t("finance.expenses.no_allocations_hint") %>
    </p>

    <button type="button" class="btn btn-ghost btn-sm" data-action="line-items#add" style="margin-top: var(--space-3);">
      + <%= t("finance.expenses.add_allocation") %>
    </button>

    <template data-line-items-target="template">
      <%= f.fields_for :expense_allocations, ExpenseAllocation.new, child_index: "NEW_INDEX" do |alloc_f| %>
        <%= render "allocation_fields", f: alloc_f, branches: @branches %>
      <% end %>
    </template>
  </div>
  <% end %>

  <div class="divider"></div>
  <h2 class="section-title"><%= t("finance.expenses.section_payment") %></h2>
  <p class="form-hint"><%= t("finance.expenses.section_payment_hint") %></p>
  <div class="form-grid">
    <% Expense::PAYMENT_TYPES.each do |type| %>
      <div class="form-group">
        <label class="form-check" style="align-items: flex-start;">
          <%= f.radio_button :payment_type, type,
                checked: expense.payment_type == type,
                class: "form-check-input",
                data: { "payment-type-target": "typeRadio", action: "payment-type#toggle" } %>
          <span>
            <span class="form-check-label" style="font-weight: 600;">
              <%= t("finance.expenses.payment_types.#{type}") %>
            </span>
            <p class="form-hint" style="margin-top: 2px;">
              <%= t("finance.expenses.payment_type_hints.#{type}") %>
            </p>
          </span>
        </label>
      </div>
    <% end %>
  </div>

  <%# ── Payment Source: ONLY meaningful for a Direct expense (an Installment
       expense's payment source is decided per-payment, later, on the Show
       page — never here) — and even then only ever shown to a user who
       actually has an eligible custody account. Hidden by JS the moment
       "Installment" is selected (data-payment-type-target="panel"); Expense
       also forces deduct_from_balance: false server-side whenever
       payment_type is installment, so this can never leak through even if
       JS is bypassed. %>
  <% if @eligible_custody_account %>
    <div data-payment-type-target="panel" class="form-group <%= 'hidden' unless expense.direct? %>"
         style="max-width: 360px;" <%= "hidden" unless expense.direct? %>>
      <label class="form-check">
        <%= f.check_box :deduct_from_balance, class: "form-check-input" %>
        <span class="form-check-label"><%= t("finance.expenses.deduct_from_balance") %></span>
      </label>
      <p class="form-hint"><%= t("finance.expenses.deduct_from_balance_hint") %></p>
      <p class="form-hint">
        <%= t("finance.expenses.paid_from_balance_account_preview",
              name: @eligible_custody_account.name, balance: format_currency(@eligible_custody_account.current_balance)) %>
      </p>
    </div>
  <% else %>
    <%= f.hidden_field :deduct_from_balance, value: "0" %>
  <% end %>

  <div class="form-actions">
    <%= f.submit t("common.save"), class: "btn btn-primary",
          data: { allocation_target: "submitBtn" } %>
    <%= link_to t("common.cancel"), finance_expenses_path, class: "btn btn-ghost" %>
  </div>
<% end %>
