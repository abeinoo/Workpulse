<%= form_with model: [ :finance, tag ], class: "form-card" do |f| %>
  <%= render "shared/error_messages", object: tag %>
  <div class="form-grid">
    <div class="form-group" style="grid-column: 1 / -1;">
      <%= f.label :name, t("finance.tags.name"), class: "form-label" %>
      <%= f.text_field :name, class: "form-control #{'is-error' if tag.errors[:name].any?}", autofocus: true %>
    </div>
    <div class="form-group" style="grid-column: 1 / -1;">
      <div class="form-check">
        <%= f.check_box :active, class: "form-check-input" %>
        <%= f.label :active, t("finance.common.active"), class: "form-check-label" %>
      </div>
    </div>
  </div>
  <div class="form-actions">
    <%= f.submit t("common.save"), class: "btn btn-primary" %>
    <%= link_to t("common.cancel"), finance_expense_tags_path, class: "btn btn-ghost" %>
  </div>
<% end %>
