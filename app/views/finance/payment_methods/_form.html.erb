<%= form_with model: [ :finance, payment_method ], class: "form-card" do |f| %>
  <%= render "shared/error_messages", object: payment_method %>

  <div class="form-grid">
    <div class="form-group">
      <%= f.label :name, t("finance.payment_methods.name"), class: "form-label" %>
      <%= f.text_field :name,
            class: "form-control #{'is-error' if payment_method.errors[:name].any?}",
            autofocus: true,
            placeholder: t("finance.payment_methods.name_placeholder") %>
    </div>

    <div class="form-group">
      <%= f.label :name_ar, t("finance.payment_methods.name_ar"), class: "form-label" %>
      <%= f.text_field :name_ar,
            class: "form-control",
            dir: "rtl",
            placeholder: t("finance.payment_methods.name_ar_placeholder") %>
    </div>

    <div class="form-group">
      <%= f.label :settlement_type, t("finance.payment_methods.settlement_type"), class: "form-label" %>
      <%= f.select :settlement_type,
            PaymentMethod::SETTLEMENT_TYPES.map { |t|
              [ I18n.t("finance.payment_methods.settlement_types.#{t}"), t ]
            },
            {},
            class: "form-control #{'is-error' if payment_method.errors[:settlement_type].any?}" %>
      <span class="form-hint"><%= t("finance.payment_methods.settlement_type_hint") %></span>
    </div>

    <div class="form-group">
      <%= f.label :position, t("finance.payment_methods.position"), class: "form-label" %>
      <%= f.number_field :position, class: "form-control", min: 0 %>
      <span class="form-hint"><%= t("finance.payment_methods.position_hint") %></span>
    </div>

    <div class="form-group" style="grid-column: 1 / -1;">
      <div class="form-check">
        <%= f.check_box :supports_refunds, class: "form-check-input" %>
        <%= f.label :supports_refunds, t("finance.payment_methods.supports_refunds"), class: "form-check-label" %>
      </div>
      <div class="form-check">
        <%= f.check_box :include_in_pos_verification, class: "form-check-input" %>
        <%= f.label :include_in_pos_verification, t("finance.payment_methods.include_in_pos_verification"), class: "form-check-label" %>
      </div>
      <div class="form-check">
        <%= f.check_box :active, class: "form-check-input" %>
        <%= f.label :active, t("finance.common.active"), class: "form-check-label" %>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit t("common.save"), class: "btn btn-primary" %>
    <%= link_to t("common.cancel"), finance_payment_methods_path, class: "btn btn-ghost" %>
  </div>
<% end %>
