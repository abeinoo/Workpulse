<%= form_with model: [ :finance, type ], class: "form-card" do |f| %>
  <%= render "shared/error_messages", object: type %>
  <div class="form-grid">
    <div class="form-group" style="grid-column: 1 / -1;">
      <%= f.label :expense_category_id, t("finance.types.category"), class: "form-label" %>
      <%= f.select :expense_category_id,
            options_from_collection_for_select(@categories, :id, :name, type.expense_category_id),
            { include_blank: "— #{t('finance.types.select_category')}" },
            class: "form-control #{'is-error' if type.errors[:expense_category].any?}" %>
    </div>
    <div class="form-group" style="grid-column: 1 / -1;">
      <%= f.label :name, t("finance.types.name"), class: "form-label" %>
      <%= f.text_field :name, class: "form-control #{'is-error' if type.errors[:name].any?}" %>
    </div>
    <div class="form-group" style="grid-column: 1 / -1;">
      <%= f.label :description, t("finance.types.description"), class: "form-label" %>
      <%= f.text_area :description, rows: 3, class: "form-control" %>
    </div>
    <div class="form-group" style="grid-column: 1 / -1;">
      <div class="form-check">
        <%= f.check_box :active, class: "form-check-input" %>
        <%= f.label :active, t("finance.common.active"), class: "form-check-label" %>
      </div>
    </div>
  </div>
  <div class="form-actions">
    <%= f.submit t("common.save"), class: "btn btn-primary" %>
    <%= link_to t("common.cancel"), finance_expense_types_path, class: "btn btn-ghost" %>
  </div>
<% end %>
