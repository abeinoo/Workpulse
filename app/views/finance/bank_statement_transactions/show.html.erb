<% content_for :title, t("finance.bank_statement_transactions.show.title") %>

<div class="admin-page">

  <div class="page-header">
    <div>
      <h1 class="page-title"><%= t("finance.bank_statement_transactions.show.title") %></h1>
      <p class="page-subtitle">
        <%= l(@transaction.transaction_date, format: :long) %>
        &middot; <%= @statement.file_name %>
      </p>
    </div>
    <div style="display: flex; gap: var(--space-2); align-items: center;">
      <%= render "finance/bank_statements/txn_status_badge", transaction: @transaction %>
      <%= link_to t("shared.back"),
            @statement.deleted? ? finance_bank_statements_path : finance_bank_statement_path(@statement),
            class: "btn btn-ghost" %>
    </div>
  </div>

  <% if @statement.deleted? %>
    <div class="card" role="status" style="padding: var(--space-4) var(--space-5); margin-bottom: var(--space-4); border: 1px solid rgba(var(--warning-rgb), 0.3);">
      <p style="font-size: var(--text-sm); font-weight: 600; color: var(--warning); margin: 0 0 var(--space-1);">
        <%= t("finance.bank_statement_transactions.show.statement_deleted_title", id: @statement.id) %>
      </p>
      <p style="font-size: var(--text-sm); color: var(--text-2); margin: 0;">
        <%= t("finance.bank_statement_transactions.show.statement_deleted_body",
              date: l(@statement.deleted_at, format: :long),
              name: @statement.deleted_by&.full_name || "—") %>
      </p>
    </div>
  <% end %>

  <%# ── Side-by-side comparison ────────────────────────────────────────── %>
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); margin-bottom: var(--space-6);">

    <%# Bank Statement side %>
    <div class="card" style="padding: var(--space-6);">
      <h3 style="font-size: var(--text-base); font-weight: 600; margin: 0 0 var(--space-4); color: var(--text-1);">
        <%= t("finance.bank_statement_transactions.show.bank_side") %>
      </h3>
      <dl style="display: grid; grid-template-columns: auto 1fr; gap: var(--space-1) var(--space-4); font-size: var(--text-sm);">
        <dt style="color: var(--text-3); white-space: nowrap;"><%= t("finance.bank_statements.fields.transaction_date") %></dt>
        <dd><%= l(@transaction.transaction_date, format: :long) %></dd>

        <dt style="color: var(--text-3);"><%= t("finance.bank_statements.fields.amount") %></dt>
        <dd style="font-weight: 600; font-variant-numeric: tabular-nums;"><%= format_currency(@transaction.amount) %></dd>

        <dt style="color: var(--text-3);"><%= t("finance.bank_statements.fields.reference_number") %></dt>
        <dd><code style="font-size: var(--text-xs);"><%= @transaction.reference_number.presence || "—" %></code></dd>

        <dt style="color: var(--text-3);"><%= t("finance.bank_statements.fields.description") %></dt>
        <dd dir="auto"><%= @transaction.description.presence || "—" %></dd>

        <% if @transaction.external_transaction_id.present? %>
          <dt style="color: var(--text-3);"><%= t("finance.bank_statements.fields.external_transaction_id") %></dt>
          <dd><code style="font-size: var(--text-xs);"><%= @transaction.external_transaction_id %></code></dd>
        <% end %>

        <% if @transaction.transaction_type.present? %>
          <dt style="color: var(--text-3);"><%= t("finance.bank_statements.fields.transaction_type") %></dt>
          <dd dir="auto"><%= @transaction.transaction_type %></dd>
        <% end %>

        <dt style="color: var(--text-3);"><%= t("finance.bank_statement_transactions.show.match_method") %></dt>
        <dd>
          <% if @transaction.match_method.present? %>
            <%= t("finance.bank_statement_transactions.match_methods.#{@transaction.match_method}") %>
            <% if @transaction.matched_by %>
              &middot; <%= @transaction.matched_by.full_name %>
            <% end %>
          <% else %>
            <span style="color: var(--text-3);">—</span>
          <% end %>
        </dd>

        <% if @transaction.match_confidence.present? %>
          <dt style="color: var(--text-3);"><%= t("finance.bank_statement_transactions.show.match_confidence") %></dt>
          <dd style="font-weight: 600; font-variant-numeric: tabular-nums;">
            <%= @transaction.match_confidence %>%
          </dd>
        <% end %>

        <% if @transaction.match_reason.present? %>
          <dt style="color: var(--text-3);"><%= t("finance.bank_statement_transactions.show.match_reason") %></dt>
          <dd dir="auto" style="color: var(--text-2);"><%= @transaction.match_reason %></dd>
        <% end %>
      </dl>
    </div>

    <%# WorkPulse Deposit side %>
    <div class="card" style="padding: var(--space-6); border: 2px solid <%= @deposit ? 'var(--success)' : 'var(--border)' %>;">
      <h3 style="font-size: var(--text-base); font-weight: 600; margin: 0 0 var(--space-4); color: var(--text-1);">
        <%= t("finance.bank_statement_transactions.show.workpulse_side") %>
      </h3>

      <% if @deposit %>
        <dl style="display: grid; grid-template-columns: auto 1fr; gap: var(--space-1) var(--space-4); font-size: var(--text-sm);">
          <dt style="color: var(--text-3);"><%= t("finance.bank_statement_transactions.show.deposit_date") %></dt>
          <dd><%= l(@deposit.deposited_at.to_date, format: :long) %></dd>

          <dt style="color: var(--text-3);"><%= t("finance.bank_statement_transactions.show.deposit_amount") %></dt>
          <dd style="font-weight: 600; font-variant-numeric: tabular-nums;"><%= format_currency(@deposit.amount) %></dd>

          <dt style="color: var(--text-3);"><%= t("finance.bank_statement_transactions.show.reference") %></dt>
          <dd><code style="font-size: var(--text-xs);"><%= @deposit.reference.presence || "—" %></code></dd>

          <dt style="color: var(--text-3);"><%= t("finance.bank_statement_transactions.show.deposited_by") %></dt>
          <dd><%= @deposit.deposited_by.full_name %></dd>

          <%# Show the relevant difference — amount vs date — never both, never 0 %>
          <% if @transaction.amount_mismatch? %>
            <dt style="color: var(--text-3);"><%= t("finance.bank_statement_transactions.show.amount_difference") %></dt>
            <dd style="font-weight: 600; color: var(--warning); font-variant-numeric: tabular-nums;">
              <%= format_currency((@transaction.amount - @deposit.amount).abs) %>
            </dd>
          <% elsif @transaction.date_mismatch? %>
            <dt style="color: var(--text-3);"><%= t("finance.bank_statement_transactions.show.date_difference") %></dt>
            <dd style="font-weight: 600; color: var(--warning);">
              <%= t("finance.bank_statement_transactions.show.date_diff",
                    days: (@transaction.transaction_date - @deposit.deposited_at.to_date).to_i.abs) %>
            </dd>
          <% end %>
        </dl>
      <% else %>
        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center;
                    height: 120px; color: var(--text-3); text-align: center;">
          <p style="margin: 0 0 var(--space-1); font-weight: 500;"><%= t("finance.bank_statement_transactions.show.no_match") %></p>
          <p style="font-size: var(--text-sm); margin: 0;"><%= t("finance.bank_statement_transactions.show.no_match_hint") %></p>
        </div>
      <% end %>
    </div>

  </div>

  <%# ── Candidate explanation (needs_manual_review) ──────────────────────── %>
  <% if @review_candidates.present? %>
    <div class="card" style="padding: var(--space-6); margin-bottom: var(--space-4); border: 1px solid rgba(var(--warning-rgb), 0.3);">
      <h3 style="font-size: var(--text-base); font-weight: 600; margin: 0 0 var(--space-2); color: var(--warning);">
        <%= t("finance.bank_statement_transactions.show.candidates_title") %>
      </h3>
      <p style="font-size: var(--text-sm); color: var(--text-2); margin: 0 0 var(--space-4);">
        <%= @transaction.match_reason %>
      </p>
      <div style="overflow-x: auto;">
        <table class="table" style="margin: 0;">
          <thead>
            <tr>
              <th><%= t("finance.bank_statement_transactions.show.candidates_col_deposit") %></th>
              <th><%= t("finance.bank_statement_transactions.show.modal_amount") %></th>
              <th><%= t("finance.bank_statement_transactions.show.modal_date") %></th>
              <th><%= t("finance.bank_statement_transactions.show.modal_reference") %></th>
              <% if @review_candidates.any? { |c| c["linked_transaction_id"] } %>
                <th><%= t("finance.bank_statement_transactions.show.candidates_col_linked_to") %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @review_candidates.each do |c| %>
              <tr>
                <td>#<%= c["till_deposit_id"] %></td>
                <td style="font-variant-numeric: tabular-nums;"><%= format_currency(c["amount"].to_d) %></td>
                <td><%= l(Date.parse(c["date"]), format: :short) %></td>
                <td><code style="font-size: var(--text-xs);"><%= c["reference"].presence || "—" %></code></td>
                <% if @review_candidates.any? { |rc| rc["linked_transaction_id"] } %>
                  <td>
                    <% if c["linked_transaction_id"] %>
                      <%= link_to t("finance.bank_statement_transactions.show.candidates_linked_to",
                                    transaction_id: c["linked_transaction_id"], statement_id: c["linked_statement_id"]),
                                  finance_bank_statement_transaction_path(c["linked_transaction_id"]) %>
                      <% if c["linked_statement_deleted"] %>
                        <span class="badge badge-danger"><%= t("finance.bank_statement_transactions.show.candidates_statement_deleted") %></span>
                      <% end %>
                    <% else %>
                      —
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <%# ── Actions ────────────────────────────────────────────────────────── %>
  <% if policy(@transaction).match? || policy(@transaction).unmatch? %>
    <div class="card" style="padding: var(--space-6);">
      <h3 style="font-size: var(--text-base); font-weight: 600; margin: 0 0 var(--space-4);">
        <%= t("finance.bank_statement_transactions.show.actions_title") %>
      </h3>

      <% if @deposit && policy(@transaction).unmatch? %>
        <%= form_with url: unmatch_finance_bank_statement_transaction_path(@transaction), method: :patch,
              style: "display: flex; gap: var(--space-3); align-items: flex-end;" do |f| %>
          <div class="form-group" style="flex: 1;">
            <%= f.label :unmatch_notes, t("finance.bank_statement_transactions.show.unmatch_notes"),
                  class: "form-label" %>
            <%= f.text_field :unmatch_notes, class: "form-control",
                  placeholder: t("finance.bank_statement_transactions.show.unmatch_notes_placeholder") %>
          </div>
          <%= f.submit t("finance.bank_statement_transactions.show.unmatch_button"),
                class: "btn btn-ghost text-danger",
                data: { turbo_confirm: t("finance.bank_statement_transactions.show.unmatch_confirm") } %>
        <% end %>
      <% end %>

      <% if policy(@transaction).match? %>
        <div style="<%= @deposit ? 'margin-top: var(--space-5); border-top: 1px solid var(--border); padding-top: var(--space-5);' : '' %>">
          <p style="font-size: var(--text-sm); color: var(--text-2); margin-bottom: var(--space-3);">
            <%= t("finance.bank_statement_transactions.show.manual_match_hint") %>
          </p>
          <%# Always available regardless of status — even a matched transaction can be re-pointed
              to a different deposit. Empty-candidate handling happens inside the modal itself. %>
          <%= link_to t("finance.bank_statement_transactions.show.manual_match_button"),
                manual_match_modal_finance_bank_statement_transaction_path(@transaction),
                class: "btn btn-primary",
                data: { turbo_frame: "modal" } %>
        </div>
      <% end %>

      <% if !@transaction.ignored? && policy(@transaction).ignore? %>
        <div style="margin-top: var(--space-5); border-top: 1px solid var(--border); padding-top: var(--space-5);">
          <%= form_with url: ignore_finance_bank_statement_transaction_path(@transaction), method: :patch,
                style: "display: flex; gap: var(--space-3); align-items: flex-end;" do |f| %>
            <div class="form-group" style="flex: 1;">
              <%= f.label :ignored_reason, t("finance.bank_statement_transactions.show.ignore_reason"),
                    class: "form-label" %>
              <%= f.text_field :ignored_reason, class: "form-control",
                    placeholder: t("finance.bank_statement_transactions.show.ignore_reason_placeholder") %>
            </div>
            <%= f.submit t("finance.bank_statement_transactions.show.ignore_button"),
                  class: "btn btn-ghost btn-sm",
                  data: { turbo_confirm: t("finance.bank_statement_transactions.show.ignore_confirm") } %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# ── Verification Timeline ──────────────────────────────────────────── %>
  <% if @audit_logs.any? %>
    <div class="card" style="padding: var(--space-6); margin-top: var(--space-4);">
      <h3 style="font-size: var(--text-base); font-weight: 600; margin: 0 0 var(--space-5); color: var(--text-1);">
        <%= t("finance.bank_statement_transactions.show.timeline_title") %>
      </h3>

      <div style="display: flex; flex-direction: column; gap: 0;">
        <% @audit_logs.each_with_index do |log, i| %>
          <div style="display: flex; gap: var(--space-4); position: relative; padding-bottom: var(--space-5);">
            <%# Timeline connector — inset-inline-start for RTL correctness %>
            <% unless i == @audit_logs.length - 1 %>
              <div style="position: absolute; inset-inline-start: 11px; top: 24px; bottom: 0; width: 2px;
                          background: var(--border); z-index: 0;"></div>
            <% end %>

            <%# Dot %>
            <div style="width: 24px; height: 24px; border-radius: 50%; background: var(--accent);
                        flex-shrink: 0; z-index: 1; margin-top: 2px; display: flex;
                        align-items: center; justify-content: center;">
              <div style="width: 8px; height: 8px; border-radius: 50%; background: #fff;"></div>
            </div>

            <%# Content %>
            <div style="flex: 1; min-width: 0;">
              <div style="display: flex; gap: var(--space-2); align-items: center; flex-wrap: wrap;">
                <span style="font-weight: 600; font-size: var(--text-sm);">
                  <%= t("finance.bank_statement_transactions.timeline.#{log.action}",
                         default: log.action.to_s.humanize) %>
                </span>
                <% if log.actor %>
                  <span style="color: var(--text-3); font-size: var(--text-xs);">
                    <%= t("finance.bank_statement_transactions.show.timeline_by", name: log.actor.full_name) %>
                  </span>
                <% end %>
                <span style="color: var(--text-3); font-size: var(--text-xs); margin-inline-start: auto;">
                  <%= l(log.created_at, format: :short) %>
                </span>
              </div>

              <% meta = log.metadata || {} %>
              <% if meta["reason"].present? %>
                <p dir="auto" style="font-size: var(--text-sm); color: var(--text-2); margin: var(--space-1) 0 0;">
                  <%= meta["reason"] %>
                  <% if meta["confidence"].present? %>
                    <span style="color: var(--text-3);">(<%= meta["confidence"] %>%)</span>
                  <% end %>
                </p>
              <% end %>
              <% if meta["notes"].present? %>
                <p style="font-size: var(--text-sm); color: var(--text-2); margin: var(--space-1) 0 0;">
                  "<%= meta["notes"] %>"
                </p>
              <% end %>
              <% if meta["till_deposit_id"].present? %>
                <p style="font-size: var(--text-xs); color: var(--text-3); margin: var(--space-1) 0 0;">
                  <%= t("finance.bank_statement_transactions.show.timeline_deposit_id",
                         id: meta["till_deposit_id"]) %>
                </p>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

</div>
