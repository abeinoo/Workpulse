<% atm_flow = @dispute.kind == "atm_deposit_failure" %>
<turbo-frame id="modal">
  <div class="emp-dashboard" style="padding: var(--space-5) var(--space-5) var(--space-8); max-width: 640px;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-4);">
      <h2 class="card-title">
        <%= atm_flow ? t("finance.bank_disputes.new.atm_title") : t("finance.bank_disputes.new.title") %>
      </h2>
      <button type="button"
              data-action="click->modal#close"
              style="border: none; background: none; cursor: pointer; color: var(--text-2); padding: var(--space-1); border-radius: var(--radius-sm);"
              aria-label="<%= t("common.close") %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <p style="font-size: var(--text-sm); color: var(--text-2); margin: 0 0 var(--space-4);">
      <%= atm_flow ? t("finance.bank_disputes.new.atm_hint") : t("finance.bank_disputes.new.hint") %>
    </p>

    <% if flash.now[:alert] %>
      <div class="alert alert-danger" style="margin-bottom: var(--space-4);"><%= flash.now[:alert] %></div>
    <% end %>

    <%= form_with model: @dispute, url: finance_bank_disputes_path, method: :post,
          data: { turbo_frame: "_top" }, multipart: true do |f| %>
      <% if atm_flow %>
        <%= hidden_field_tag "bank_dispute[daily_reconciliation_id]", @reconciliation.id %>
      <% else %>
        <%= hidden_field_tag "bank_dispute[till_deposit_id]", @deposit.id %>
      <% end %>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); max-height: 420px; overflow-y: auto; padding: var(--space-1);">
        <div class="form-group">
          <%= f.label :transaction_date, t("finance.bank_disputes.fields.transaction_date"), class: "form-label" %>
          <%= f.date_field :transaction_date, class: "form-control", required: true,
                value: atm_flow ? Date.current : @deposit.deposited_at.to_date %>
        </div>
        <div class="form-group">
          <%= f.label :transaction_time, t("finance.bank_disputes.fields.transaction_time"), class: "form-label" %>
          <%= f.time_field :transaction_time, class: "form-control", value: (Time.current.strftime("%H:%M") if atm_flow) %>
        </div>
        <div class="form-group">
          <%= f.label :amount, t("finance.bank_disputes.fields.amount"), class: "form-label" %>
          <%= f.number_field :amount, step: "0.01", class: "form-control", required: true,
                value: atm_flow ? nil : @deposit.amount %>
        </div>
        <div class="form-group">
          <%= f.label :bank_name, t("finance.bank_disputes.fields.bank_name"), class: "form-label" %>
          <%= f.text_field :bank_name, class: "form-control", required: true %>
        </div>
        <div class="form-group">
          <%= f.label :terminal_id, atm_flow ? t("finance.bank_disputes.fields.atm_terminal_id") : t("finance.bank_disputes.fields.terminal_id"), class: "form-label" %>
          <%= f.text_field :terminal_id, class: "form-control", required: true %>
        </div>
        <div class="form-group">
          <%= f.label :card_last4, t("finance.bank_disputes.fields.card_last4"), class: "form-label" %>
          <%= f.text_field :card_last4, class: "form-control", maxlength: 4, required: atm_flow %>
        </div>

        <% if atm_flow %>
          <div class="form-group">
            <%= f.label :atm_location, t("finance.bank_disputes.fields.atm_location"), class: "form-label" %>
            <%= f.text_field :atm_location, class: "form-control" %>
          </div>
          <div class="form-group">
            <%= f.label :reference_number, t("finance.bank_disputes.fields.deposit_receipt_number"), class: "form-label" %>
            <%= f.text_field :reference_number, class: "form-control" %>
          </div>
        <% else %>
          <div class="form-group">
            <%= f.label :merchant_id, t("finance.bank_disputes.fields.merchant_id"), class: "form-label" %>
            <%= f.text_field :merchant_id, class: "form-control" %>
          </div>
          <div class="form-group">
            <%= f.label :reference_number, t("finance.bank_disputes.fields.reference_number"), class: "form-label" %>
            <%= f.text_field :reference_number, class: "form-control" %>
          </div>
          <div class="form-group">
            <%= f.label :stan, t("finance.bank_disputes.fields.stan"), class: "form-label" %>
            <%= f.text_field :stan, class: "form-control" %>
          </div>
          <div class="form-group">
            <%= f.label :authorization_code, t("finance.bank_disputes.fields.authorization_code"), class: "form-label" %>
            <%= f.text_field :authorization_code, class: "form-control" %>
          </div>
          <div class="form-group" style="grid-column: 1 / -1;">
            <%= f.label :bank_ticket_number, t("finance.bank_disputes.fields.bank_ticket_number"), class: "form-label" %>
            <%= f.text_field :bank_ticket_number, class: "form-control" %>
          </div>
        <% end %>

        <div class="form-group" style="grid-column: 1 / -1;">
          <%= f.label :notes, t("finance.bank_disputes.fields.notes"), class: "form-label" %>
          <%= f.text_area :notes, class: "form-control", rows: 3, dir: "auto" %>
        </div>

        <% if atm_flow %>
          <div class="form-group" style="grid-column: 1 / -1;">
            <%= f.label :photos, t("finance.bank_disputes.fields.photos"), class: "form-label" %>
            <%= file_field_tag "bank_dispute[photos][]", multiple: true, accept: "image/*,application/pdf", class: "form-control" %>
            <p style="font-size: var(--text-xs); color: var(--text-3); margin: var(--space-1) 0 0;">
              <%= t("finance.bank_disputes.fields.photos_hint") %>
            </p>
          </div>
        <% end %>
      </div>

      <div style="display: flex; gap: var(--space-3); justify-content: flex-end; margin-top: var(--space-4);">
        <button type="button" class="btn btn-ghost" data-action="click->modal#close">
          <%= t("shared.cancel") %>
        </button>
        <%= f.submit t("finance.bank_disputes.new.submit"), class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</turbo-frame>
