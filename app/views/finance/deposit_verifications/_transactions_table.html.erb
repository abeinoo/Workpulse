<% if transactions.empty? %>
  <div class="empty-state" style="padding: var(--space-12) var(--space-8);">
    <div class="empty-state__icon">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
      </svg>
    </div>
    <p class="empty-state__title"><%= t(empty_key) %></p>
    <p class="empty-state__text"><%= t("finance.deposit_verifications.empty.hint") %></p>
  </div>
<% else %>
  <%# bulk: true adds the selection column for Deposit Verification's bulk
      ignore — eligibility comes from @bulk_ignore_eligible_ids (one query in
      the controller); the server re-checks every id on submit. %>
  <% bulk = local_assigns[:bulk] %>
  <div class="table-container">
    <table class="table">
      <thead>
        <tr>
          <% if bulk %>
            <th style="width: 1%;">
              <input type="checkbox" class="dv-bulk-check-all"
                     aria-label="<%= t("finance.deposit_verifications.bulk_ignore.select_all_page") %>"
                     data-action="change->deposit-verification-bulk-ignore#toggleAll">
            </th>
          <% end %>
          <th><%= t("finance.deposit_verifications.cols.verification_status") %></th>
          <th><%= t("finance.deposit_verifications.cols.bank_date") %></th>
          <th class="text-end"><%= t("finance.deposit_verifications.cols.bank_amount") %></th>
          <th><%= t("finance.deposit_verifications.cols.reference") %></th>
          <th><%= t("finance.deposit_verifications.cols.description") %></th>
          <th><%= t("finance.deposit_verifications.cols.import_file") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% transactions.each do |txn| %>
          <tr>
            <% if bulk %>
              <td>
                <% if @bulk_ignore_eligible_ids.include?(txn.id) %>
                  <input type="checkbox" class="dv-bulk-check-row" value="<%= txn.id %>"
                         aria-label="<%= t("finance.deposit_verifications.bulk_ignore.select_row", id: txn.id) %>"
                         data-action="change->deposit-verification-bulk-ignore#rowChanged">
                <% else %>
                  <input type="checkbox" class="dv-bulk-check-row" value="<%= txn.id %>" disabled
                         title="<%= t("finance.deposit_verifications.bulk_ignore.ineligible_matched") %>"
                         aria-label="<%= t("finance.deposit_verifications.bulk_ignore.ineligible_matched") %>">
                <% end %>
              </td>
            <% end %>
            <td><%= render "finance/bank_statements/txn_status_badge", transaction: txn %></td>
            <td><%= l(txn.transaction_date, format: :short) %></td>
            <td class="text-end"><%= format_currency(txn.amount) %></td>
            <td><code style="font-size: var(--text-xs);"><%= txn.reference_number.presence || "—" %></code></td>
            <td style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
              <%= txn.description.presence || "—" %>
            </td>
            <td>
              <%= link_to txn.bank_statement.file_name,
                    finance_bank_statement_path(txn.bank_statement),
                    class: "link", style: "font-size: var(--text-sm);" %>
            </td>
            <td>
              <%# Every row always exposes the actions valid for its current
                  state — never conditionally hidden beyond that. %>
              <div style="display: flex; gap: var(--space-2); flex-wrap: wrap; justify-content: flex-end;">
                <%= link_to t("shared.view"),
                      finance_bank_statement_transaction_path(txn),
                      class: "btn btn-ghost btn-sm" %>

                <% if txn.matched? && policy(txn).unmatch? %>
                  <%= link_to t("finance.bank_statement_transactions.show.unmatch_button"),
                        unmatch_finance_bank_statement_transaction_path(txn),
                        class: "btn btn-ghost btn-sm text-danger",
                        data: { turbo_method: :patch,
                                turbo_confirm: t("finance.bank_statement_transactions.show.unmatch_confirm") } %>
                <% end %>

                <% if !txn.matched? && policy(txn).match? %>
                  <%= link_to t("finance.bank_statement_transactions.show.manual_match_button"),
                        manual_match_modal_finance_bank_statement_transaction_path(txn),
                        class: "btn btn-primary btn-sm",
                        data: { turbo_frame: "modal" } %>
                <% end %>

                <% if !txn.ignored? && policy(txn).ignore? %>
                  <%= link_to t("finance.bank_statement_transactions.show.ignore_button"),
                        ignore_finance_bank_statement_transaction_path(txn),
                        class: "btn btn-ghost btn-sm",
                        data: { turbo_method: :patch,
                                turbo_confirm: t("finance.bank_statement_transactions.show.ignore_confirm") } %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
