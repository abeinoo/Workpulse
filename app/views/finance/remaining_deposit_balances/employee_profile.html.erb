<% content_for :title, t("remaining_deposit_balances.employee_profile.title", name: @user.full_name) %>

<div style="max-width: 800px; margin: 0 auto;">

  <%# ── Back link ── %>
  <div style="margin-bottom: var(--space-4);">
    <%= link_to finance_remaining_deposit_balances_path(responsible_user_id: @user.id),
          style: "display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); color: var(--text-2); text-decoration: none;" do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      <%= t("remaining_deposit_balances.employee_profile.back") %>
    <% end %>
  </div>

  <%# ── Header ── %>
  <div style="display: flex; align-items: center; gap: var(--space-4); margin-bottom: var(--space-5);">
    <div style="width: 52px; height: 52px; border-radius: 50%; background: var(--accent); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
      <span style="font-size: var(--text-xl); font-weight: 800; color: white;">
        <%= @user.full_name.chars.first(2).join.upcase %>
      </span>
    </div>
    <div>
      <h1 style="font-size: var(--text-xl); font-weight: 800; color: var(--text-1); margin: 0 0 var(--space-1);">
        <%= @user.full_name %>
      </h1>
      <p style="font-size: var(--text-sm); color: var(--text-2); margin: 0;">
        <%= t("remaining_deposit_balances.employee_profile.subtitle") %>
      </p>
    </div>
    <% if @open_count > 0 %>
      <span style="margin-inline-start: auto; background: rgba(202,138,4,0.12); color: var(--warning,#ca8a04); border-radius: var(--radius); padding: var(--space-2) var(--space-4); font-size: var(--text-sm); font-weight: 700; white-space: nowrap;">
        <%= t("remaining_deposit_balances.employee_profile.open_badge", count: @open_count) %>
      </span>
    <% end %>
  </div>

  <%# ── KPI grid ── %>
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: var(--space-3); margin-bottom: var(--space-5);">
    <%# Total incidents %>
    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-4);">
      <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-3); margin: 0 0 var(--space-1);">
        <%= t("remaining_deposit_balances.employee_profile.kpi_incidents") %>
      </p>
      <p style="font-size: var(--text-2xl); font-weight: 800; color: var(--text-1); margin: 0; font-variant-numeric: tabular-nums;">
        <%= @total_incidents %>
      </p>
    </div>
    <%# Total amount ─ original shortfalls %>
    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-4);">
      <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-3); margin: 0 0 var(--space-1);">
        <%= t("remaining_deposit_balances.employee_profile.kpi_total_shortfall") %>
      </p>
      <p style="font-size: var(--text-2xl); font-weight: 800; color: var(--text-1); margin: 0; font-variant-numeric: tabular-nums;">
        <%= number_to_currency(@total_amount, unit: "", separator: ".", delimiter: ",") %>
      </p>
    </div>
    <%# Currently outstanding %>
    <% if @total_outstanding > 0 %>
      <div style="background: rgba(202,138,4,0.06); border: 1px solid rgba(202,138,4,0.3); border-radius: var(--radius-lg); padding: var(--space-4);">
        <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--warning,#ca8a04); margin: 0 0 var(--space-1);">
          <%= t("remaining_deposit_balances.employee_profile.kpi_outstanding") %>
        </p>
        <p style="font-size: var(--text-2xl); font-weight: 800; color: var(--warning,#ca8a04); margin: 0; font-variant-numeric: tabular-nums;">
          <%= number_to_currency(@total_outstanding, unit: "", separator: ".", delimiter: ",") %>
        </p>
      </div>
    <% end %>
    <%# Settled later %>
    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-4);">
      <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-3); margin: 0 0 var(--space-1);">
        <%= t("remaining_deposit_balances.employee_profile.kpi_settled") %>
      </p>
      <p style="font-size: var(--text-2xl); font-weight: 800; color: var(--success,#16a34a); margin: 0; font-variant-numeric: tabular-nums;">
        <%= number_to_currency(@total_settled, unit: "", separator: ".", delimiter: ",") %>
      </p>
    </div>
    <%# Written off %>
    <% if @total_written_off > 0 %>
      <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-4);">
        <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-3); margin: 0 0 var(--space-1);">
          <%= t("remaining_deposit_balances.employee_profile.kpi_written_off") %>
        </p>
        <p style="font-size: var(--text-2xl); font-weight: 800; color: var(--text-3); margin: 0; font-variant-numeric: tabular-nums;">
          <%= number_to_currency(@total_written_off, unit: "", separator: ".", delimiter: ",") %>
        </p>
      </div>
    <% end %>
    <%# Largest single shortage %>
    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-4);">
      <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-3); margin: 0 0 var(--space-1);">
        <%= t("remaining_deposit_balances.employee_profile.kpi_largest") %>
      </p>
      <p style="font-size: var(--text-2xl); font-weight: 800; color: var(--text-1); margin: 0; font-variant-numeric: tabular-nums;">
        <%= number_to_currency(@largest_shortage, unit: "", separator: ".", delimiter: ",") %>
      </p>
    </div>
    <%# Avg settlement time %>
    <% if @avg_settlement_days %>
      <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-4);">
        <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-3); margin: 0 0 var(--space-1);">
          <%= t("remaining_deposit_balances.employee_profile.kpi_avg_settlement") %>
        </p>
        <p style="font-size: var(--text-2xl); font-weight: 800; color: var(--text-1); margin: 0; font-variant-numeric: tabular-nums;">
          <%= @avg_settlement_days %>
          <span style="font-size: var(--text-sm); font-weight: 500; color: var(--text-2);">d</span>
        </p>
      </div>
    <% end %>
    <%# Last incident %>
    <% if @last_shortage_at %>
      <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-4);">
        <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-3); margin: 0 0 var(--space-1);">
          <%= t("remaining_deposit_balances.employee_profile.kpi_last_shortage") %>
        </p>
        <p style="font-size: var(--text-base); font-weight: 700; color: var(--text-1); margin: 0;">
          <%= l(@last_shortage_at.to_date, format: :medium) %>
        </p>
      </div>
    <% end %>
  </div>

  <%# ── Full incident history ── %>
  <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden;">
    <div style="padding: var(--space-4) var(--space-5); border-bottom: 1px solid var(--border); background: var(--surface-2); display: flex; justify-content: space-between; align-items: center;">
      <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); margin: 0;">
        <%= t("remaining_deposit_balances.employee_profile.history_heading") %>
      </p>
      <%= link_to export_finance_remaining_deposit_balances_path(responsible_user_id: @user.id, status: "all"),
            style: "font-size: var(--text-xs); font-weight: 600; color: var(--accent); text-decoration: none; display: flex; align-items: center; gap: var(--space-1);" do %>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        <%= t("remaining_deposit_balances.index.export") %>
      <% end %>
    </div>

    <% if @balances.empty? %>
      <div style="padding: var(--space-8); text-align: center; color: var(--text-3);">
        <p style="margin: 0;"><%= t("remaining_deposit_balances.employee_profile.no_history") %></p>
      </div>
    <% else %>
      <div style="display: flex; flex-direction: column; gap: 0;">
        <% @balances.each_with_index do |balance, idx| %>
          <% dr       = balance.daily_reconciliation %>
          <% pm       = balance.till_deposit&.payment_method %>
          <% is_open  = balance.open? %>
          <div style="display: flex; align-items: center; gap: var(--space-4); padding: var(--space-3) var(--space-5); border-top: <%= idx > 0 ? '1px solid var(--border)' : 'none' %>; <%= is_open && balance.age_hours >= 72 ? 'background: rgba(220,38,38,0.02);' : '' %>">
            <%# Status dot %>
            <% dot = is_open ? (balance.age_hours >= 72 ? 'var(--danger,#dc2626)' : 'var(--warning,#ca8a04)') : (balance.settled? ? 'var(--success,#16a34a)' : 'var(--text-3)') %>
            <div style="width: 8px; height: 8px; border-radius: 50%; background: <%= dot %>; flex-shrink: 0;"></div>

            <div style="flex: 1; min-width: 0;">
              <p style="font-size: var(--text-sm); font-weight: 600; color: var(--text-1); margin: 0;">
                <%= dr.branch.name %>
                <span style="color: var(--text-3); font-weight: 400;">&middot;</span>
                <%= l(dr.business_date || dr.opened_at.to_date, format: :medium) rescue dr.opened_at.strftime("%d %b %Y") %>
                <% if pm %>
                  <span style="font-size: var(--text-xs); background: var(--surface-2); border: 1px solid var(--border); border-radius: 4px; padding: 1px var(--space-2); font-weight: 600; color: var(--text-2); vertical-align: middle; margin-inline-start: var(--space-1);">
                    <%= pm.display_name %>
                  </span>
                <% end %>
              </p>
            </div>

            <div style="text-align: end; flex-shrink: 0;">
              <p style="font-size: var(--text-sm); font-weight: 800; color: <%= is_open ? 'var(--warning,#ca8a04)' : 'var(--text-2)' %>; margin: 0; font-variant-numeric: tabular-nums;">
                <%= number_to_currency(is_open ? balance.remaining_amount : balance.amount, unit: "", separator: ".", delimiter: ",") %>
              </p>
              <p style="font-size: var(--text-xs); color: var(--text-3); margin: 2px 0 0;">
                <%= t("remaining_deposit_balances.statuses.#{balance.status}") %>
                <% if is_open %>
                  · <span style="color: <%= balance.age_color %>; font-weight: 600;"><%= balance.age_display %></span>
                <% end %>
              </p>
            </div>

            <%= link_to finance_remaining_deposit_balance_path(balance),
                  style: "font-size: var(--text-xs); color: var(--text-3); text-decoration: none; flex-shrink: 0; padding: var(--space-1) var(--space-2); border: 1px solid var(--border); border-radius: var(--radius);" do %>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

</div>
