<% content_for :title, t("remaining_deposit_balances.show.title", id: @balance.id) %>
<%
  deposited_on_day  = @balance.till_deposit&.amount || 0
  original_expected = deposited_on_day + @balance.amount
  settled_since     = @balance.amount - @balance.remaining_amount
  is_open           = @balance.open?
%>

<div style="max-width: 700px; margin: 0 auto;">

  <%# ── Back link + employee profile link ─────────────────────────────── %>
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4);">
    <%= link_to finance_daily_reconciliation_path(@balance.daily_reconciliation),
          style: "display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); color: var(--text-2); text-decoration: none;" do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      <%= t("remaining_deposit_balances.show.back") %>
    <% end %>
  </div>

  <%# ── Settled / Written-off success banner ───────────────────────────── %>
  <% if @balance.settled? %>
    <div style="background: rgba(22,163,74,0.08); border: 1px solid rgba(22,163,74,0.3); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-5); margin-bottom: var(--space-4); display: flex; align-items: center; gap: var(--space-3);">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--success,#16a34a)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      <div>
        <p style="font-size: var(--text-sm); font-weight: 700; color: var(--success,#16a34a); margin: 0 0 2px;">
          <%= t("remaining_deposit_balances.show.fully_settled_title") %>
        </p>
        <p style="font-size: var(--text-xs); color: var(--text-2); margin: 0;">
          <%= t("remaining_deposit_balances.show.fully_settled_desc",
                by: @balance.closed_by&.full_name || "—",
                at: l(@balance.closed_at, format: :long)) %>
        </p>
      </div>
    </div>
  <% elsif @balance.written_off? %>
    <div style="background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-5); margin-bottom: var(--space-4); display: flex; align-items: center; gap: var(--space-3);">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-3)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0;"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
      <div>
        <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-2); margin: 0 0 2px;">
          <%= t("remaining_deposit_balances.show.written_off_title") %>
        </p>
        <p style="font-size: var(--text-xs); color: var(--text-3); margin: 0;">
          <%= t("remaining_deposit_balances.show.fully_settled_desc",
                by: @balance.closed_by&.full_name || "—",
                at: l(@balance.closed_at, format: :long)) %>
        </p>
      </div>
    </div>
  <% end %>

  <%# ── Header ─────────────────────────────────────────────────────────── %>
  <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-4);">
    <div>
      <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); margin: 0 0 var(--space-1);">
        <%= t("remaining_deposit_balances.show.ref", id: @balance.id) %>
      </p>
      <h1 style="font-size: var(--text-xl); font-weight: 800; color: var(--text-1); margin: 0 0 var(--space-1);">
        <%= @balance.responsible_user.full_name %>
      </h1>
      <% if is_open %>
        <p style="font-size: var(--text-sm); color: <%= @balance.age_color %>; font-weight: 600; margin: 0;">
          <%= t("remaining_deposit_balances.show.age_label", age: @balance.age_display) %>
        </p>
      <% end %>
    </div>
    <% badge_color, badge_bg = case @balance.status
       when "open"        then ["var(--warning,#ca8a04)",  "rgba(202,138,4,0.12)"]
       when "settled"     then ["var(--success,#16a34a)",  "rgba(22,163,74,0.12)"]
       when "written_off" then ["var(--text-3,#9ca3af)",   "var(--surface-2)"]
       end %>
    <span style="background: <%= badge_bg %>; color: <%= badge_color %>; border-radius: var(--radius); padding: var(--space-2) var(--space-4); font-size: var(--text-sm); font-weight: 700; white-space: nowrap; flex-shrink: 0;">
      <%= t("remaining_deposit_balances.statuses.#{@balance.status}") %>
    </span>
  </div>

  <%# ── Context strip: DR + Till Deposit ──────────────────────────────── %>
  <div style="background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-5); margin-bottom: var(--space-4); display: flex; flex-direction: column; gap: var(--space-2);">
    <div style="display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap;">
      <span style="font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-3); min-width: 110px; flex-shrink: 0;">
        <%= t("remaining_deposit_balances.show.dr_label") %>
      </span>
      <%= link_to finance_daily_reconciliation_path(@balance.daily_reconciliation),
            style: "font-size: var(--text-sm); font-weight: 600; color: var(--accent); text-decoration: none;" do %>
        <%= @balance.daily_reconciliation.branch.name %>
        &nbsp;—&nbsp;
        <%= l(@balance.daily_reconciliation.business_date || @balance.daily_reconciliation.opened_at.to_date, format: :medium) rescue @balance.daily_reconciliation.opened_at.strftime("%d %b %Y") %>
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="display: inline; vertical-align: middle; opacity: 0.6;" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      <% end %>
    </div>
    <% if @balance.till_deposit %>
      <div style="display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap;">
        <span style="font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-3); min-width: 110px; flex-shrink: 0;">
          <%= t("remaining_deposit_balances.show.deposit_label") %>
        </span>
        <span style="font-size: var(--text-sm); color: var(--text-1);">
          #<%= @balance.till_deposit_id %>
          &nbsp;&middot;&nbsp;
          <strong><%= number_to_currency(@balance.till_deposit.amount, unit: "", separator: ".", delimiter: ",") %></strong>
          <% if @balance.till_deposit.payment_method %>
            &nbsp;&middot;&nbsp;
            <span style="background: var(--surface); border: 1px solid var(--border); border-radius: 4px; padding: 1px var(--space-2); font-size: var(--text-xs); color: var(--text-2);">
              <%= @balance.till_deposit.payment_method.display_name %>
            </span>
          <% end %>
        </span>
      </div>
    <% end %>
    <div style="display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap;">
      <span style="font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-3); min-width: 110px; flex-shrink: 0;">
        <%= t("remaining_deposit_balances.show.created_at_label") %>
      </span>
      <span style="font-size: var(--text-sm); color: var(--text-2);">
        <%= @balance.created_by.full_name %> &middot; <%= l(@balance.created_at, format: :long) %>
      </span>
    </div>
  </div>

  <%# ── Financial Summary ──────────────────────────────────────────────── %>
  <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; margin-bottom: var(--space-4);">
    <% if @balance.till_deposit %>
      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; border-bottom: 1px solid var(--border);">
        <div style="padding: var(--space-4); border-inline-end: 1px solid var(--border);">
          <p style="font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-3); margin: 0 0 var(--space-1);">
            <%= t("remaining_deposit_balances.show.summary_expected") %>
          </p>
          <p style="font-size: var(--text-lg); font-weight: 800; color: var(--text-1); margin: 0; font-variant-numeric: tabular-nums;">
            <%= number_to_currency(original_expected, unit: "", separator: ".", delimiter: ",") %>
          </p>
        </div>
        <div style="padding: var(--space-4); border-inline-end: 1px solid var(--border);">
          <p style="font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-3); margin: 0 0 var(--space-1);">
            <%= t("remaining_deposit_balances.show.summary_deposited") %>
          </p>
          <p style="font-size: var(--text-lg); font-weight: 800; color: var(--success,#16a34a); margin: 0; font-variant-numeric: tabular-nums;">
            <%= number_to_currency(deposited_on_day, unit: "", separator: ".", delimiter: ",") %>
          </p>
        </div>
        <div style="padding: var(--space-4);">
          <p style="font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-3); margin: 0 0 var(--space-1);">
            <%= t("remaining_deposit_balances.show.summary_shortfall") %>
          </p>
          <p style="font-size: var(--text-lg); font-weight: 800; color: var(--warning,#ca8a04); margin: 0; font-variant-numeric: tabular-nums;">
            <%= number_to_currency(@balance.amount, unit: "", separator: ".", delimiter: ",") %>
          </p>
        </div>
      </div>
    <% end %>
    <div style="padding: var(--space-5); display: flex; align-items: center; justify-content: space-between; gap: var(--space-4);">
      <div>
        <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); margin: 0 0 var(--space-1);">
          <%= t("remaining_deposit_balances.show.summary_outstanding") %>
        </p>
        <p style="font-size: var(--text-3xl); font-weight: 900; color: <%= is_open ? 'var(--warning,#ca8a04)' : 'var(--text-2)' %>; margin: 0; font-variant-numeric: tabular-nums; line-height: 1;">
          <%= number_to_currency(@balance.remaining_amount, unit: "", separator: ".", delimiter: ",") %>
        </p>
      </div>
      <% if settled_since > 0 %>
        <div style="text-align: end;">
          <p style="font-size: var(--text-xs); color: var(--text-3); margin: 0 0 var(--space-1);">
            <%= t("remaining_deposit_balances.show.summary_settled_since") %>
          </p>
          <p style="font-size: var(--text-base); font-weight: 700; color: var(--success,#16a34a); margin: 0; font-variant-numeric: tabular-nums;">
            <%= number_to_currency(settled_since, unit: "", separator: ".", delimiter: ",") %>
          </p>
        </div>
      <% end %>
    </div>
  </div>

  <%# ── RECEIVE REMAINING BALANCE — primary action ──────────────────────── %>
  <% if is_open && policy(@balance).settle? %>
    <div style="background: var(--surface); border: 2px solid var(--accent); border-radius: var(--radius-lg); overflow: hidden; margin-bottom: var(--space-4);"
         data-controller="remaining-balance-settle"
         data-remaining-balance-settle-max-value="<%= @balance.remaining_amount.to_f %>">

      <div style="padding: var(--space-4) var(--space-5); background: rgba(var(--accent-rgb,99,102,241),0.06); border-bottom: 1px solid rgba(var(--accent-rgb,99,102,241),0.2);">
        <p style="font-size: var(--text-base); font-weight: 800; color: var(--accent); margin: 0;">
          <%= t("remaining_deposit_balances.show.receive_heading") %>
        </p>
        <p style="font-size: var(--text-xs); color: var(--text-2); margin: var(--space-1) 0 0;">
          <%= t("remaining_deposit_balances.show.receive_hint",
                remaining: number_to_currency(@balance.remaining_amount, unit: "", separator: ".", delimiter: ",")) %>
        </p>
      </div>

      <%= form_with url: settle_finance_remaining_deposit_balance_path(@balance), method: :patch,
            style: "padding: var(--space-5);" do |f| %>

        <%# Amount input %>
        <div style="margin-bottom: var(--space-4);">
          <%= label_tag :amount, t("remaining_deposit_balances.show.receive_amount_label"),
                style: "display: block; font-size: var(--text-sm); font-weight: 600; color: var(--text-1); margin-bottom: var(--space-2);" %>
          <div style="display: flex; align-items: center; gap: var(--space-3);">
            <%= number_field_tag :amount, @balance.remaining_amount,
                  min: 0.01, max: @balance.remaining_amount, step: "0.01",
                  required: true,
                  data: { "remaining_balance_settle_target": "amountInput" },
                  style: "flex: 1; font-size: var(--text-2xl); font-weight: 800; padding: var(--space-3) var(--space-4); border: 2px solid var(--accent); border-radius: var(--radius); color: var(--accent); font-variant-numeric: tabular-nums; background: var(--surface); outline: none;",
                  "data-1p-ignore": true %>
            <div style="text-align: end; flex-shrink: 0;">
              <p style="font-size: var(--text-xs); color: var(--text-3); margin: 0;"><%= t("remaining_deposit_balances.show.receive_max_hint") %></p>
              <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-2); margin: 0; font-variant-numeric: tabular-nums;">
                <%= number_to_currency(@balance.remaining_amount, unit: "", separator: ".", delimiter: ",") %>
              </p>
            </div>
          </div>
        </div>

        <%# Live preview panel (hidden until JS activates it) %>
        <div data-remaining-balance-settle-target="preview"
             style="background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--space-3) var(--space-4); margin-bottom: var(--space-4); display: none;">
          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: var(--space-3);">
            <div>
              <p style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-3); margin: 0 0 2px;">
                <%= t("remaining_deposit_balances.show.preview_current") %>
              </p>
              <p style="font-size: var(--text-sm); font-weight: 700; color: var(--warning,#ca8a04); margin: 0; font-variant-numeric: tabular-nums;"
                 data-remaining-balance-settle-target="previewCurrent">
                <%= number_to_currency(@balance.remaining_amount, unit: "", separator: ".", delimiter: ",") %>
              </p>
            </div>
            <div>
              <p style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-3); margin: 0 0 2px;">
                <%= t("remaining_deposit_balances.show.preview_receiving") %>
              </p>
              <p style="font-size: var(--text-sm); font-weight: 700; color: var(--accent); margin: 0; font-variant-numeric: tabular-nums;"
                 data-remaining-balance-settle-target="previewReceiving">—</p>
            </div>
            <div>
              <p style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-3); margin: 0 0 2px;">
                <%= t("remaining_deposit_balances.show.preview_after") %>
              </p>
              <p style="font-size: var(--text-sm); font-weight: 800; margin: 0; font-variant-numeric: tabular-nums;"
                 data-remaining-balance-settle-target="previewAfter">—</p>
            </div>
          </div>
          <p style="font-size: var(--text-xs); margin: var(--space-2) 0 0; font-weight: 600;"
             data-remaining-balance-settle-target="previewLabel"></p>
        </div>

        <%# Payment method + reference number %>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); margin-bottom: var(--space-4);">
          <div>
            <%= label_tag :payment_method_id, t("remaining_deposit_balances.show.receive_pm_label"),
                  style: "display: block; font-size: var(--text-sm); font-weight: 600; color: var(--text-1); margin-bottom: var(--space-2);" %>
            <%= select_tag :payment_method_id,
                  options_for_select(
                    [[t("remaining_deposit_balances.show.receive_pm_placeholder"), ""]] +
                      @payment_methods.map { |pm| [pm.display_name, pm.id] }
                  ),
                  required: true,
                  class: "form-control" %>
          </div>
          <div>
            <%= label_tag :reference_number, t("remaining_deposit_balances.show.receive_ref_label"),
                  style: "display: block; font-size: var(--text-sm); font-weight: 600; color: var(--text-1); margin-bottom: var(--space-2);" %>
            <%= text_field_tag :reference_number, nil,
                  class: "form-control",
                  placeholder: t("remaining_deposit_balances.show.receive_ref_placeholder") %>
          </div>
        </div>

        <div style="margin-bottom: var(--space-4);">
          <%= label_tag :notes, t("remaining_deposit_balances.show.receive_notes_label"),
                style: "display: block; font-size: var(--text-sm); font-weight: 600; color: var(--text-1); margin-bottom: var(--space-2);" %>
          <%= text_area_tag :notes, nil, rows: 2, class: "form-control",
                placeholder: t("remaining_deposit_balances.show.receive_notes_placeholder") %>
        </div>

        <%= f.submit t("remaining_deposit_balances.show.receive_submit"),
              style: "width: 100%; padding: var(--space-3) var(--space-4); background: var(--accent); color: white; border: none; border-radius: var(--radius); font-size: var(--text-base); font-weight: 700; cursor: pointer;" %>
      <% end %>
    </div>
  <% end %>

  <%# ── Secondary actions: Transfer + Write Off ───────────────────────── %>
  <% if is_open && (policy(@balance).reassign? || policy(@balance).write_off?) %>
    <details style="margin-bottom: var(--space-4);">
      <summary style="cursor: pointer; font-size: var(--text-sm); font-weight: 600; color: var(--text-2); padding: var(--space-3) var(--space-4); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); list-style: none; display: flex; align-items: center; justify-content: space-between;">
        <span><%= t("remaining_deposit_balances.show.secondary_actions_toggle") %></span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </summary>
      <div style="background: var(--surface); border: 1px solid var(--border); border-top: none; border-radius: 0 0 var(--radius-lg) var(--radius-lg); padding: var(--space-5); display: flex; flex-direction: column; gap: var(--space-5);">

        <% if policy(@balance).reassign? && @business_users.present? %>
          <div>
            <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); margin: 0 0 var(--space-1);">
              <%= t("remaining_deposit_balances.show.reassign_heading") %>
            </p>
            <p style="font-size: var(--text-xs); color: var(--text-2); margin: 0 0 var(--space-3);">
              <%= t("remaining_deposit_balances.show.reassign_hint", current: @balance.responsible_user.full_name) %>
            </p>
            <%= form_with url: reassign_finance_remaining_deposit_balance_path(@balance), method: :patch do |f| %>
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); margin-bottom: var(--space-3);">
                <div>
                  <%= label_tag :new_responsible_user_id, t("remaining_deposit_balances.show.reassign_user_label"),
                        style: "display: block; font-size: var(--text-sm); font-weight: 600; color: var(--text-1); margin-bottom: var(--space-2);" %>
                  <%= select_tag :new_responsible_user_id,
                        options_for_select(@business_users.map { |u| [u.full_name, u.id] }, @balance.responsible_user_id),
                        class: "form-control", required: true %>
                </div>
                <div>
                  <%= label_tag :notes, t("remaining_deposit_balances.show.reassign_notes_label"),
                        style: "display: block; font-size: var(--text-sm); font-weight: 600; color: var(--text-1); margin-bottom: var(--space-2);" %>
                  <%= text_area_tag :notes, nil, rows: 2, class: "form-control",
                        placeholder: t("remaining_deposit_balances.show.reassign_notes_placeholder") %>
                </div>
              </div>
              <%= f.submit t("remaining_deposit_balances.show.reassign_submit"), class: "btn btn-secondary", style: "width: 100%; justify-content: center;" %>
            <% end %>
          </div>
        <% end %>

        <% if policy(@balance).write_off? %>
          <div style="<%= policy(@balance).reassign? && @business_users.present? ? 'border-top: 1px solid var(--border); padding-top: var(--space-5);' : '' %>">
            <p style="font-size: var(--text-sm); font-weight: 700; color: var(--danger,#dc2626); margin: 0 0 var(--space-3);">
              <%= t("remaining_deposit_balances.show.write_off_heading") %>
            </p>
            <%= form_with url: write_off_finance_remaining_deposit_balance_path(@balance),
                  method: :patch,
                  data: { turbo_confirm: t("remaining_deposit_balances.show.write_off_confirm") } do |f| %>
              <div style="margin-bottom: var(--space-3);">
                <%= label_tag :notes, t("remaining_deposit_balances.show.write_off_notes_label"),
                      style: "display: block; font-size: var(--text-sm); font-weight: 600; color: var(--text-1); margin-bottom: var(--space-2);" %>
                <%= text_area_tag :notes, nil, rows: 2, class: "form-control",
                      placeholder: t("remaining_deposit_balances.show.write_off_notes_placeholder") %>
              </div>
              <%= f.submit t("remaining_deposit_balances.show.write_off_submit"),
                    class: "btn btn-checkout",
                    style: "width: 100%; justify-content: center; color: var(--danger,#dc2626); border-color: var(--danger,#dc2626);" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </details>
  <% end %>

  <%# ── Transaction History ──────────────────────────────────────────────── %>
  <% if @balance.balance_transactions.any? %>
    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden;">
      <div style="padding: var(--space-4) var(--space-5); border-bottom: 1px solid var(--border); background: var(--surface-2);">
        <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); margin: 0;">
          <%= t("remaining_deposit_balances.show.history_heading") %>
        </p>
      </div>
      <div style="padding: var(--space-5);">
        <% running_remaining = @balance.amount %>
        <% txns = @balance.balance_transactions.ordered.to_a %>
        <% txns.each_with_index do |txn, idx| %>
          <%
            dot_color = case txn.transaction_type
            when "created"      then "var(--warning,#ca8a04)"
            when "settlement"   then "var(--success,#16a34a)"
            when "reassignment" then "var(--accent)"
            when "write_off"    then "var(--danger,#dc2626)"
            else "var(--text-3)"
            end
          %>
          <div style="display: flex; gap: var(--space-3);">
            <div style="display: flex; flex-direction: column; align-items: center; flex-shrink: 0;">
              <div style="width: 10px; height: 10px; border-radius: 50%; background: <%= dot_color %>; margin-top: 4px; flex-shrink: 0;"></div>
              <% if idx < txns.size - 1 || @balance.closed? %>
                <div style="width: 2px; flex: 1; min-height: 16px; background: var(--border); margin: var(--space-1) 0;"></div>
              <% end %>
            </div>
            <div style="flex: 1; padding-bottom: var(--space-4);">
              <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-2);">
                <div>
                  <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); margin: 0;">
                    <%= t("remaining_deposit_balances.show.txn_type.#{txn.transaction_type}") %>
                    <% if txn.payment_method %>
                      <span style="font-size: var(--text-xs); background: var(--surface-2); border: 1px solid var(--border); border-radius: 4px; padding: 1px var(--space-2); font-weight: 600; color: var(--text-2); vertical-align: middle; margin-inline-start: var(--space-1);">
                        <%= txn.payment_method.display_name %>
                      </span>
                    <% end %>
                  </p>
                  <p style="font-size: var(--text-xs); color: var(--text-3); margin: var(--space-1) 0 0;">
                    <%= txn.performed_by.full_name %> &middot; <%= l(txn.created_at, format: :long) %>
                  </p>
                  <% if txn.reference_number.present? %>
                    <p style="font-size: var(--text-xs); color: var(--text-2); margin: 2px 0 0;">
                      <%= t("remaining_deposit_balances.show.txn_ref") %>: <code><%= txn.reference_number %></code>
                    </p>
                  <% end %>
                </div>
                <% if txn.amount %>
                  <%
                    running_remaining -= txn.amount if %w[settlement write_off].include?(txn.transaction_type)
                    amt_color = case txn.transaction_type
                    when "created"    then "var(--warning,#ca8a04)"
                    when "settlement" then "var(--success,#16a34a)"
                    when "write_off"  then "var(--danger,#dc2626)"
                    else "var(--text-1)"
                    end
                  %>
                  <div style="text-align: end; flex-shrink: 0;">
                    <span style="font-size: var(--text-base); font-weight: 800; color: <%= amt_color %>; font-variant-numeric: tabular-nums;">
                      <%= txn.settlement? ? "−" : "" %><%= number_to_currency(txn.amount, unit: "", separator: ".", delimiter: ",") %>
                    </span>
                    <% if %w[settlement write_off].include?(txn.transaction_type) && idx < txns.size - 1 %>
                      <p style="font-size: var(--text-xs); color: var(--text-3); margin: 2px 0 0; font-variant-numeric: tabular-nums;">
                        ↓ <%= number_to_currency([running_remaining, 0].max, unit: "", separator: ".", delimiter: ",") %>
                      </p>
                    <% end %>
                  </div>
                <% end %>
              </div>
              <% if txn.reassignment? %>
                <p style="font-size: var(--text-xs); color: var(--text-2); margin: var(--space-1) 0 0;">
                  <%= txn.previous_responsible_user&.full_name || "?" %> &rarr; <%= txn.new_responsible_user&.full_name || "?" %>
                </p>
              <% end %>
              <% if txn.notes.present? %>
                <p style="font-size: var(--text-xs); color: var(--text-2); margin: var(--space-1) 0 0; font-style: italic;">
                  "<%= txn.notes %>"
                </p>
              <% end %>
            </div>
          </div>
        <% end %>
        <% if @balance.closed? %>
          <div style="display: flex; gap: var(--space-3);">
            <div style="display: flex; flex-direction: column; align-items: center; flex-shrink: 0;">
              <div style="width: 10px; height: 10px; border-radius: 50%; background: <%= @balance.settled? ? 'var(--success,#16a34a)' : 'var(--text-3)' %>; margin-top: 4px;"></div>
            </div>
            <div style="margin-top: 2px;">
              <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-2); margin: 0;">
                <%= t("remaining_deposit_balances.show.closed_marker") %>
              </p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

</div>

<%# ── Stimulus controller for live preview ────────────────────────────────── %>
<%= javascript_tag nonce: true do %>
(function() {
  function initSettlePreview() {
    const el = document.querySelector("[data-controller='remaining-balance-settle']")
    if (!el) return

    const input    = el.querySelector("[data-remaining-balance-settle-target='amountInput']")
    const preview  = el.querySelector("[data-remaining-balance-settle-target='preview']")
    const pCurrent = el.querySelector("[data-remaining-balance-settle-target='previewCurrent']")
    const pRecv    = el.querySelector("[data-remaining-balance-settle-target='previewReceiving']")
    const pAfter   = el.querySelector("[data-remaining-balance-settle-target='previewAfter']")
    const pLabel   = el.querySelector("[data-remaining-balance-settle-target='previewLabel']")
    const max      = parseFloat(el.dataset.remainingBalanceSettleMaxValue) || 0

    const msgFull    = "<%= j t('remaining_deposit_balances.show.preview_will_close') %>"
    const msgPartial = "<%= j t('remaining_deposit_balances.show.preview_will_partial') %>"

    function fmt(n) {
      return n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })
    }

    function update() {
      const raw = parseFloat(input.value) || 0
      if (raw <= 0) { preview.style.display = "none"; return }

      const clamped = Math.min(raw, max)
      const after   = Math.max(max - clamped, 0)
      const isFull  = clamped >= max

      preview.style.display = "block"
      pRecv.textContent     = fmt(clamped)
      pAfter.textContent    = fmt(after)
      pAfter.style.color    = isFull ? "var(--success,#16a34a)" : "var(--warning,#ca8a04)"
      pLabel.textContent    = isFull ? msgFull : msgPartial
      pLabel.style.color    = isFull ? "var(--success,#16a34a)" : "var(--text-2)"
    }

    input.addEventListener("input", update)
    update()
  }

  document.addEventListener("turbo:load",  initSettlePreview)
  document.addEventListener("DOMContentLoaded", initSettlePreview)
})()
<% end %>
