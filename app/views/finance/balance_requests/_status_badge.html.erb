<%
  color_class = {
    "draft"            => "badge badge-neutral",
    "pending_approval" => "badge badge-warning",
    "approved"         => "badge badge-accent",
    "paid"             => "badge badge-success",
    "rejected"         => "badge badge-danger"
  }.fetch(status, "badge badge-neutral")
  size_class = local_assigns[:size] == "md" ? " badge--md" : ""
%>
<span class="<%= color_class %><%= size_class %>"><%= t("finance.balance_requests.statuses.#{status}") %></span>
