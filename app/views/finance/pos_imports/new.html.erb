<% content_for :title, t("finance.pos_imports.new.title") %>

<div class="admin-page" style="max-width: 640px;">

  <div class="page-header">
    <div>
      <h1 class="page-title"><%= t("finance.pos_imports.new.title") %></h1>
      <p class="page-subtitle"><%= t("finance.pos_imports.new.subtitle") %></p>
    </div>
    <div class="page-header__actions">
      <%= link_to t("finance.pos_imports.index.title"),
            finance_pos_imports_path,
            class: "btn btn-ghost btn-sm" %>
    </div>
  </div>

  <% if @pos_import.errors.any? %>
    <div class="alert alert-danger" style="margin-bottom: var(--space-4);">
      <ul style="margin: 0; padding-inline-start: var(--space-5);">
        <% @pos_import.errors.each do |e| %>
          <li><%= e.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with url: finance_pos_imports_path, method: :post, multipart: true do |f| %>

    <div class="card" style="padding: var(--space-6); margin-bottom: var(--space-4);">
      <div class="form-group">
        <%= label_tag "pos_import[file]", t("finance.pos_imports.new.file_label"), class: "form-label" %>
        <p style="font-size: var(--text-xs); color: var(--text-3); margin: 0 0 var(--space-2);">
          <%= t("finance.pos_imports.new.file_hint") %>
        </p>
        <input type="file" name="pos_import[file]" id="pos_import_file"
               class="form-control" accept=".xlsx">
      </div>
    </div>

    <div style="background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--space-4); margin-bottom: var(--space-5);">
      <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); margin: 0 0 var(--space-2);">
        <%= t("finance.pos_imports.new.accepted_format_label") %>
      </p>
      <p style="font-size: var(--text-sm); color: var(--text-2); margin: 0;">
        <%= t("finance.pos_imports.new.accepted_format") %>
      </p>
      <p style="font-size: var(--text-xs); color: var(--text-3); margin: var(--space-2) 0 0;">
        <%= t("finance.pos_imports.new.header_note") %>
      </p>
      <p style="font-size: var(--text-xs); color: var(--text-3); margin: var(--space-2) 0 0;">
        <% if current_user.can?(:manage_branches) %>
          <%= t("finance.pos_imports.new.terminal_note_html", link: link_to(t("admin.branches.index.title"), admin_branches_path)) %>
        <% else %>
          <%= t("finance.pos_imports.new.terminal_note") %>
        <% end %>
      </p>
    </div>

    <div style="display: flex; gap: var(--space-3); justify-content: flex-end;">
      <%= link_to t("shared.cancel"), finance_pos_imports_path, class: "btn btn-ghost" %>
      <%= f.submit t("finance.pos_imports.new.submit"), class: "btn btn-primary" %>
    </div>

  <% end %>

</div>
