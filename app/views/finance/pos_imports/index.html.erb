<% content_for :title, t("finance.pos_imports.index.title") %>

<div class="admin-page">

  <div class="page-header">
    <div>
      <h1 class="page-title"><%= t("finance.pos_imports.index.title") %></h1>
      <p class="page-subtitle"><%= t("finance.pos_imports.index.subtitle") %></p>
    </div>
    <div class="page-header__actions">
      <% if current_user.can?(:manage_branches) %>
        <%= link_to t("admin.branches.index.title"),
              admin_branches_path,
              class: "btn btn-ghost btn-sm" %>
      <% end %>
      <% if policy(:pos_import).create? %>
        <%= link_to t("finance.pos_imports.index.import_button"),
              new_finance_pos_import_path,
              class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>

  <%# ── Last import summary — @imports is already ordered newest-first, so
      the first entry is the latest; no controller change needed. ── %>
  <% if @imports.any? %>
    <% latest = @imports.first %>
    <div class="card" style="padding: var(--space-5); margin-bottom: var(--space-4);">
      <h2 style="font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; color: var(--text-3); margin: 0 0 var(--space-3);">
        <%= t("finance.daily_reconciliations.index.pos_last_import") %>
      </h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: var(--space-4);">
        <div>
          <p style="font-size: 11px; color: var(--text-3); margin: 0;"><%= t("finance.pos_imports.index.col_imported_at") %></p>
          <p style="font-size: var(--text-sm); font-weight: 600; margin: var(--space-1) 0 0;"><%= l(latest.updated_at, format: :short) %></p>
        </div>
        <div>
          <p style="font-size: 11px; color: var(--text-3); margin: 0;"><%= t("finance.pos_imports.index.col_file") %></p>
          <p style="font-size: var(--text-sm); font-weight: 600; margin: var(--space-1) 0 0;"><%= latest.file_name %></p>
        </div>
        <div>
          <p style="font-size: 11px; color: var(--text-3); margin: 0;"><%= t("finance.pos_imports.preview.total_transactions") %></p>
          <p style="font-size: var(--text-sm); font-weight: 600; margin: var(--space-1) 0 0;"><%= latest.imported_rows %></p>
        </div>
        <div>
          <p style="font-size: 11px; color: var(--text-3); margin: 0;"><%= t("finance.pos_imports.preview.total_amount") %></p>
          <p style="font-size: var(--text-sm); font-weight: 600; margin: var(--space-1) 0 0;"><%= format_currency(latest.total_amount) %></p>
        </div>
        <div>
          <p style="font-size: 11px; color: var(--text-3); margin: 0;"><%= t("finance.pos_imports.preview.total_fees") %></p>
          <p style="font-size: var(--text-sm); font-weight: 600; margin: var(--space-1) 0 0;"><%= format_currency(latest.total_fees) %></p>
        </div>
        <div>
          <p style="font-size: 11px; color: var(--text-3); margin: 0;"><%= t("finance.daily_reconciliations.index.pos_status") %></p>
          <p style="margin: var(--space-1) 0 0;">
            <% if latest.imported? %>
              <span class="badge badge-success"><%= t("finance.pos_imports.index.status_imported") %></span>
            <% elsif latest.failed? %>
              <span class="badge badge-danger"><%= t("finance.pos_imports.index.status_failed") %></span>
            <% else %>
              <span class="badge"><%= t("finance.pos_imports.index.status_pending") %></span>
            <% end %>
          </p>
        </div>
      </div>
    </div>
  <% end %>

  <% if @imports.empty? %>
    <div class="empty-state" style="padding: var(--space-16) var(--space-8);">
      <p class="empty-state__title"><%= t("finance.pos_imports.index.empty") %></p>
      <p class="empty-state__text"><%= t("finance.pos_imports.index.empty_hint") %></p>
      <div style="margin-top: var(--space-6);">
        <%= link_to t("finance.pos_imports.index.import_button"),
              new_finance_pos_import_path,
              class: "btn btn-primary" %>
      </div>
    </div>
  <% else %>

    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm);">
      <div style="padding: var(--space-3) var(--space-5); background: var(--surface-2); border-bottom: 1px solid var(--border); display: grid; grid-template-columns: 2fr 80px 100px 120px 120px 100px 1fr;">
        <% [
             t("finance.pos_imports.index.col_file"),
             t("finance.pos_imports.index.col_rows"),
             t("finance.pos_imports.index.col_imported"),
             t("finance.pos_imports.index.col_expenses"),
             t("finance.pos_imports.index.col_imported_by"),
             t("finance.pos_imports.index.col_imported_at"),
             ""
           ].each do |label| %>
          <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3);">
            <%= label %>
          </span>
        <% end %>
      </div>

      <% @imports.each do |import| %>
        <div style="padding: var(--space-3) var(--space-5); border-bottom: 1px solid var(--border); display: grid; grid-template-columns: 2fr 80px 100px 120px 120px 100px 1fr; align-items: center; gap: var(--space-2);">
          <p style="font-size: var(--text-sm); font-weight: 500; color: var(--text-1); margin: 0;">
            <% if policy(import).show? %>
              <%= link_to import.file_name, finance_pos_import_path(import), class: "link" %>
            <% else %>
              <%= import.file_name %>
            <% end %>
          </p>
          <span style="font-size: var(--text-sm); color: var(--text-2);"><%= import.total_rows %></span>
          <span style="font-size: var(--text-sm); color: var(--text-2);"><%= import.imported_rows %></span>
          <span style="font-size: var(--text-sm); color: var(--text-2);"><%= import.expenses_created_count %></span>
          <span style="font-size: var(--text-sm); color: var(--text-2);"><%= import.imported_by.full_name %></span>
          <span style="font-size: var(--text-sm); color: var(--text-3);"><%= l(import.updated_at, format: :short) %></span>
          <div style="display: flex; gap: var(--space-2); justify-content: flex-end;">
            <% if policy(import).show? %>
              <%= link_to t("shared.view"), finance_pos_import_path(import), class: "btn btn-ghost btn-sm" %>
            <% end %>
            <% if import.imported? %>
              <span class="badge badge-success" style="font-size: 11px;"><%= t("finance.pos_imports.index.status_imported") %></span>
            <% elsif import.failed? %>
              <span class="badge badge-danger" style="font-size: 11px;"><%= t("finance.pos_imports.index.status_failed") %></span>
            <% else %>
              <span class="badge" style="font-size: 11px;"><%= t("finance.pos_imports.index.status_pending") %></span>
            <% end %>
            <% if policy(import).destroy? %>
              <%= button_to t("common.delete"),
                    finance_pos_import_path(import),
                    method: :delete,
                    data: { turbo_confirm: t("common.are_you_sure") },
                    class: "btn btn-danger btn-sm",
                    form_class: "inline" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

  <% end %>

</div>
