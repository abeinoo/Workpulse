<% content_for :title, t("finance.pos_imports.preview.title") %>

<div class="admin-page" style="max-width: 880px;">

  <div class="page-header">
    <div>
      <h1 class="page-title"><%= t("finance.pos_imports.preview.title") %></h1>
      <p class="page-subtitle"><%= @pos_import.file_name %></p>
    </div>
    <div class="page-header__actions">
      <%= link_to t("finance.pos_imports.index.title"),
            finance_pos_imports_path,
            class: "btn btn-ghost btn-sm" %>
    </div>
  </div>

  <% has_unknown_terminals = @preview[:unknown_terminals].present? %>

  <% if has_unknown_terminals %>
    <div class="alert alert-danger" style="margin-bottom: var(--space-5);">
      <p style="font-weight: 600; margin: 0 0 var(--space-2);">
        <% if current_user.can?(:manage_branches) %>
          <%= t("finance.pos_imports.preview.unknown_terminal_banner_html",
                link: link_to(t("admin.branches.index.title"), admin_branches_path)) %>
        <% else %>
          <%= t("finance.pos_imports.preview.unknown_terminal_banner") %>
        <% end %>
      </p>
      <div style="background: var(--surface); border-radius: var(--radius); overflow: hidden; margin-top: var(--space-3); overflow-x: auto;">
        <div style="min-width: 760px; padding: var(--space-2) var(--space-4); background: var(--surface-2); display: grid; grid-template-columns: 70px 120px 1fr 100px 90px 140px 120px 1fr; gap: var(--space-2); font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-3);">
          <span><%= t("finance.pos_imports.preview.col_row_number") %></span>
          <span><%= t("finance.pos_imports.preview.col_terminal_id") %></span>
          <span><%= t("finance.pos_imports.preview.col_product_name") %></span>
          <span><%= t("finance.pos_imports.preview.col_amount") %></span>
          <span><%= t("finance.pos_imports.preview.col_status") %></span>
          <span><%= t("finance.pos_imports.preview.col_paid_at") %></span>
          <span><%= t("finance.pos_imports.preview.col_reference_number") %></span>
          <span><%= t("finance.pos_imports.preview.col_actions") %></span>
        </div>
        <% @preview[:unknown_terminals].each do |row| %>
          <div style="min-width: 760px; padding: var(--space-2) var(--space-4); display: grid; grid-template-columns: 70px 120px 1fr 100px 90px 140px 120px 1fr; gap: var(--space-2); border-top: 1px solid var(--border); align-items: start;">
            <span style="color: var(--text-3);"><%= t("finance.pos_imports.preview.row_prefix") %> <%= row[:row_number] %></span>
            <span><%= row[:terminal_id].presence || "—" %></span>
            <span><%= row[:product_name].presence || "—" %></span>
            <span><%= format_currency(row[:amount]) %></span>
            <span><%= row[:status] %></span>
            <span><%= row[:transaction_date] %></span>
            <span><%= row[:reference_number].presence || "—" %></span>
            <span style="display: flex; flex-direction: column; gap: var(--space-1); align-items: flex-start;">
              <% if current_user.can?(:manage_branches) %>
                <%= link_to t("finance.pos_imports.preview.assign_terminal_action"),
                      admin_branches_path,
                      style: "font-size: var(--text-xs); color: var(--accent); text-decoration: underline; text-decoration-style: dotted;" %>
              <% end %>
              <%= render "ignore_row_action", pos_import: @pos_import, row_number: row[:row_number] %>
            </span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-5);">
    <div class="card" style="padding: var(--space-4);">
      <p style="font-size: 11px; text-transform: uppercase; color: var(--text-3); margin: 0;"><%= t("finance.pos_imports.preview.total_transactions") %></p>
      <p style="font-size: var(--text-xl); font-weight: 700; margin: var(--space-1) 0 0;"><%= @preview[:total_transactions] %></p>
    </div>
    <div class="card" style="padding: var(--space-4);">
      <p style="font-size: 11px; text-transform: uppercase; color: var(--text-3); margin: 0;"><%= t("finance.pos_imports.preview.total_amount") %></p>
      <p style="font-size: var(--text-xl); font-weight: 700; margin: var(--space-1) 0 0;"><%= format_currency(@preview[:total_amount]) %></p>
    </div>
    <div class="card" style="padding: var(--space-4);">
      <p style="font-size: 11px; text-transform: uppercase; color: var(--text-3); margin: 0;"><%= t("finance.pos_imports.preview.total_fees") %></p>
      <p style="font-size: var(--text-xl); font-weight: 700; margin: var(--space-1) 0 0;"><%= format_currency(@preview[:total_fees]) %></p>
    </div>
    <div class="card" style="padding: var(--space-4);">
      <p style="font-size: 11px; text-transform: uppercase; color: var(--text-3); margin: 0;"><%= t("finance.pos_imports.preview.invalid_rows") %></p>
      <p style="font-size: var(--text-xl); font-weight: 700; margin: var(--space-1) 0 0;"><%= @preview[:invalid_count] %></p>
    </div>
    <div class="card" style="padding: var(--space-4);">
      <p style="font-size: 11px; text-transform: uppercase; color: var(--text-3); margin: 0;"><%= t("finance.pos_imports.preview.ignored_transactions") %></p>
      <p style="font-size: var(--text-xl); font-weight: 700; margin: var(--space-1) 0 0;"><%= @preview[:ignored_count] %></p>
    </div>
    <div class="card" style="padding: var(--space-4);">
      <p style="font-size: 11px; text-transform: uppercase; color: var(--text-3); margin: 0;"><%= t("finance.pos_imports.preview.ignored_amount") %></p>
      <p style="font-size: var(--text-xl); font-weight: 700; margin: var(--space-1) 0 0;"><%= format_currency(@preview[:ignored_amount]) %></p>
    </div>
  </div>

  <% if @preview[:ignored_count].to_i > 0 %>
    <p style="font-size: var(--text-xs); color: var(--text-3); margin: calc(var(--space-4) * -1) 0 var(--space-5);">
      <%= t("finance.pos_imports.preview.ignored_hint") %>
    </p>
  <% end %>

  <div class="card" style="padding: var(--space-5); margin-bottom: var(--space-4);">
    <h2 style="font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; color: var(--text-3); margin: 0 0 var(--space-3);">
      <%= t("finance.pos_imports.preview.detected_branches") %>
    </h2>
    <% if @preview[:detected_branches].present? %>
      <p style="margin: 0;"><%= @preview[:detected_branches].join(", ") %></p>
    <% else %>
      <p style="color: var(--text-3); margin: 0;"><%= t("finance.pos_imports.preview.none") %></p>
    <% end %>
  </div>

  <div class="card" style="padding: var(--space-5); margin-bottom: var(--space-4);">
    <h2 style="font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; color: var(--text-3); margin: 0 0 var(--space-3);">
      <%= t("finance.pos_imports.preview.detected_terminal_ids") %>
    </h2>
    <% if @preview[:detected_terminal_ids].present? %>
      <p style="margin: 0;"><%= @preview[:detected_terminal_ids].join(", ") %></p>
    <% else %>
      <p style="color: var(--text-3); margin: 0;"><%= t("finance.pos_imports.preview.none") %></p>
    <% end %>
  </div>

  <div class="card" style="padding: var(--space-5); margin-bottom: var(--space-4);">
    <h2 style="font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; color: var(--text-3); margin: 0 0 var(--space-3);">
      <%= t("finance.pos_imports.preview.expenses_to_generate") %>
    </h2>
    <% if @preview[:expenses_to_generate].present? %>
      <div style="display: grid; grid-template-columns: 1fr 160px; gap: var(--space-2);">
        <% @preview[:expenses_to_generate].each do |row| %>
          <span><%= row[:branch_name] %></span>
          <span style="font-weight: 600;"><%= format_currency(row[:total_fees]) %></span>
        <% end %>
      </div>
    <% else %>
      <p style="color: var(--text-3); margin: 0;"><%= t("finance.pos_imports.preview.no_expenses") %></p>
    <% end %>
  </div>

  <% has_invalid_rows = @preview[:invalid_count].to_i > 0 %>

  <% if @preview[:validation_errors].present? %>
    <div class="card" style="padding: var(--space-5); margin-bottom: var(--space-5);">
      <h2 style="font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; color: var(--text-3); margin: 0 0 var(--space-3);">
        <%= t("finance.pos_imports.preview.validation_errors") %>
      </h2>
      <p style="font-size: var(--text-xs); color: var(--text-3); margin: 0 0 var(--space-3);">
        <%= t("finance.pos_imports.preview.validation_errors_hint") %>
      </p>
      <div style="display: grid; grid-template-columns: 90px 1fr 220px; gap: var(--space-2); align-items: start;">
        <% @preview[:validation_errors].each do |row| %>
          <span style="color: var(--text-3); padding-top: 4px;"><%= t("finance.pos_imports.preview.row_prefix") %> <%= row[:row_number] %></span>
          <span>
            <span style="color: var(--danger); display: block;"><%= row[:errors].join(", ") %></span>
            <%= render "row_values", attributes: row[:attributes] %>
          </span>
          <span>
            <%= render "ignore_row_action", pos_import: @pos_import, row_number: row[:row_number] %>
          </span>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @preview[:manually_ignored_rows].present? %>
    <div class="card" style="padding: var(--space-5); margin-bottom: var(--space-5);">
      <h2 style="font-size: var(--text-sm); font-weight: 700; text-transform: uppercase; color: var(--text-3); margin: 0 0 var(--space-3);">
        <%= t("finance.pos_imports.preview.manually_ignored_rows") %>
      </h2>
      <div style="display: grid; grid-template-columns: 90px 1fr 160px 160px; gap: var(--space-2); font-size: var(--text-sm);">
        <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-3);"><%= t("finance.pos_imports.preview.row_prefix") %></span>
        <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-3);"><%= t("finance.pos_imports.preview.ignore_reason_label") %></span>
        <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-3);"><%= t("finance.pos_imports.preview.ignored_by_label") %></span>
        <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-3);"><%= t("finance.pos_imports.preview.ignored_at_label") %></span>
        <% @preview[:manually_ignored_rows].each do |row| %>
          <span><%= row[:row_number] %></span>
          <span style="color: var(--text-2);"><%= row[:reason] %></span>
          <span style="color: var(--text-3);"><%= row[:ignored_by] %></span>
          <span style="color: var(--text-3);"><%= l(Time.zone.parse(row[:ignored_at].to_s), format: :short) %></span>
        <% end %>
      </div>
    </div>
  <% end %>

  <div style="display: flex; gap: var(--space-3); justify-content: flex-end;">
    <%= link_to t("shared.cancel"), finance_pos_imports_path, class: "btn btn-ghost" %>
    <% if policy(@pos_import).confirm_import? %>
      <%= button_to t("finance.pos_imports.preview.confirm_import"),
            confirm_import_finance_pos_import_path(@pos_import),
            method: :post,
            class: "btn btn-primary",
            disabled: has_unknown_terminals || has_invalid_rows,
            form_class: "inline" %>
    <% end %>
  </div>

</div>
