<%
  # Loaded once and reused everywhere a branch is needed on this page (header
  # label + the branch-selector partial below) — a second call to
  # assignable_branches would re-run its query for no reason.
  branches        = assignable_branches.to_a
  selected_branch = params[:branch_id].presence && branches.find { |b| b.id == params[:branch_id].to_i }

  # Loaded once, reused by both the filter-bar's selects and the active-filter
  # chips below (which need the cashier/payment-method *name*, not just the
  # id already sitting in params) — same relations _filter_bar.html.erb used
  # to load itself before this hoist.
  filter_cashiers = (current_user.can?(:view_employee_balances) || current_user.can?(:manage_employee_balances)) ?
                       EmployeeScope.new(current_user).relation.order(:first_name).to_a : []
  filter_payment_methods = Rails.cache.fetch("finance_dashboard/payment_methods/#{current_user.business_id}", expires_in: 5.minutes) do
                              PaymentMethod.for_business(current_user.business).active.ordered.to_a
                            end

  # Single source of truth for the health badge — shared by the compact
  # header badge and the full Financial Health card (see FinanceHelper).
  health_status, health_factors = finance_dashboard_health(
    show_profitability:      @show_profitability,
    net_profit:               @show_profitability ? @kpi_profitability[:net] : nil, # nil without payroll access
    pending_count:            @alert_pending_count,
    overdue_count:            @rdb_overdue_count,
    negative_custody_count:   @alert_negative_custody&.size
  )
%>
<% content_for :title, t("finance.dashboard.title") %>

<div class="admin-page exec-dashboard">
  <div class="page-header exec-header">
    <div>
      <p class="exec-header__eyebrow"><%= t("finance.dashboard.title") %></p>
      <h1 class="page-title">
        <%= current_user.business.name %>
        <% if selected_branch %>
          <span class="exec-header__branch">• <%= selected_branch.name %></span>
        <% end %>
      </h1>
      <p class="exec-header__period"><%= l(@filters.from, format: :long) %> – <%= l(@filters.to, format: :long) %></p>
      <%# Same .financial-health__badge component the full card below uses —
          a compact glance-value in the header, not a new badge style. Same
          wrapper-status/badge-child DOM shape as the full card so the exact
          same CSS rule (`.financial-health--X .financial-health__badge`)
          colors it, nothing new added. ── %>
      <div class="financial-health financial-health--<%= health_status %> financial-health--header">
        <div class="financial-health__badge">
          <span class="financial-health__dot"></span>
          <span class="financial-health__label"><%= t("finance.dashboard.financial_health.status.#{health_status}") %></span>
        </div>
      </div>
    </div>
    <%# Same clustered "selector + primary page actions" toolbar Daily
        Reconciliation uses (branch selector followed by a flex row of
        .btn-ghost navigation links) — the branch selector is no longer an
        isolated control in its own column. ── %>
    <div class="page-header__actions">
      <%= render "finance/shared/branch_selector",
            url: finance_root_path,
            branches: branches,
            selected: params[:branch_id],
            all_label: t("finance.daily_reconciliations.index.filter_all_sales_branches"),
            hidden_params: {
              from: params[:from], to: params[:to],
              cashier_id: params[:cashier_id],
              payment_source: params[:payment_source],
              payment_method_id: params[:payment_method_id]
            } %>
      <% if current_user.can?(:view_expense_reports) %>
        <%= link_to t("finance.dashboard.quick_actions.view_reports"), finance_reports_path, class: "btn btn-ghost" %>
      <% end %>
      <%= link_to t("finance.dashboard.export_pdf"), finance_dashboard_export_pdf_path(request.query_parameters), class: "btn btn-ghost" %>
    </div>
  </div>

  <%= render "filter_bar", branches: branches, filter_cashiers: filter_cashiers, filter_payment_methods: filter_payment_methods %>

  <%= render "kpi_cards" %>

  <div class="exec-grid">
    <%= render "executive_summary" %>
    <%= render "financial_health", health_status: health_status, health_factors: health_factors %>
    <%= render "alerts" %>
    <%= render "insights" %>

    <%= render "action_center" %>

    <%= render "trend_chart" %>

    <%= render "distribution_charts" %>

    <%= render "branch_profitability_chart" %>

    <%= render "top_categories" %>
    <%= render "recent_activity" %>

    <%= render "cash_flow" %>

    <%= render "custody_and_suppliers" %>
  </div>
</div>
