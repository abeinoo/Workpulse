<div class="card">
  <h2 class="section-title"><%= title %></h2>
  <% if rows.blank? %>
    <p class="td-secondary"><%= t("finance.dashboard.no_data") %></p>
  <% else %>
    <% max = rows.map { |_, total| total }.max %>
    <table class="breakdown-table" style="width: 100%;">
      <tbody>
        <% rows.each do |label, total| %>
          <tr>
            <td><%= label %></td>
            <td style="text-align: end; white-space: nowrap;"><%= format_currency(total) %></td>
          </tr>
          <tr>
            <td colspan="2" style="padding-top: 0;">
              <div style="height: 4px; background: var(--color-border); border-radius: 2px; overflow: hidden;">
                <div style="height: 100%; width: <%= max.to_f.positive? ? (total.to_f / max.to_f * 100).round : 0 %>%; background: var(--color-primary);"></div>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
