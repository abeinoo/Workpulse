<% content_for :title, t("finance.recurring.show_title") %>

<div class="admin-page">
  <%= link_to finance_recurring_expenses_path, class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    <%= t("forms.back") %>
  <% end %>

  <%# ── Summary card ────────────────────────────────────────────────────────── %>
  <div class="card" style="margin-bottom: var(--space-5);">
    <div class="card-header">
      <div style="display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap;">
        <h1 class="card-title" style="margin: 0; font-size: var(--text-lg);"><%= @recurring.expense_category.name %></h1>
        <% if @recurring.active? %>
          <span class="badge badge-success badge--md"><%= t("finance.common.active") %></span>
        <% else %>
          <span class="badge badge-neutral badge--md"><%= t("finance.common.inactive") %></span>
        <% end %>
      </div>
      <div class="page-header__actions">
        <% if policy(@recurring).generate? %>
          <%= button_to t("finance.recurring.generate_now"), generate_finance_recurring_expense_path(@recurring),
                method: :post, class: "btn btn-primary btn-sm", form: { style: "display:inline" },
                data: { turbo_confirm: t("finance.recurring.generate_confirm") } %>
        <% end %>
        <% if policy(@recurring).update? %>
          <%= link_to t("common.edit"), edit_finance_recurring_expense_path(@recurring), class: "btn btn-secondary btn-sm" %>
        <% end %>
        <% if policy(@recurring).destroy? %>
          <%= button_to t("common.delete"), finance_recurring_expense_path(@recurring), method: :delete,
                class: "btn btn-ghost btn-sm text-danger", form: { style: "display:inline" },
                data: { turbo_confirm: t("finance.recurring.confirm_delete") } %>
        <% end %>
      </div>
    </div>
    <dl class="detail-list" style="margin-bottom: 0;">
      <div class="detail-list__row">
        <dt><%= t("finance.expenses.amount") %></dt>
        <dd><strong style="font-size: var(--text-lg);"><%= format_currency(@recurring.amount) %></strong></dd>
      </div>
      <div class="detail-list__row">
        <dt><%= t("finance.recurring.frequency") %></dt>
        <dd><%= t("finance.recurring.frequencies.#{@recurring.frequency}") %></dd>
      </div>
      <div class="detail-list__row">
        <dt><%= t("finance.expenses.category") %></dt>
        <dd><%= @recurring.expense_category.name %></dd>
      </div>
      <div class="detail-list__row">
        <dt><%= t("finance.expenses.type") %></dt>
        <dd><%= @recurring.expense_type&.name || "—" %></dd>
      </div>
      <div class="detail-list__row">
        <dt><%= t("finance.expenses.branch") %></dt>
        <dd><%= @allocations.any? ? t("finance.expenses.shared") : (@recurring.branch&.name || "—") %></dd>
      </div>
      <% if @recurring.created_by %>
        <div class="detail-list__row">
          <dt><%= t("finance.expenses.created_by") %></dt>
          <dd><%= @recurring.created_by.full_name %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <%# ── Schedule card ───────────────────────────────────────────────────────── %>
  <div class="card" style="margin-bottom: var(--space-5);">
    <div class="card-header">
      <h2 class="card-title"><%= t("finance.recurring.section_schedule") %></h2>
    </div>
    <dl class="detail-list" style="margin-bottom: 0;">
      <div class="detail-list__row">
        <dt><%= t("finance.recurring.next_run_on") %></dt>
        <dd><strong><%= l(@recurring.next_run_on, format: :long) %></strong></dd>
      </div>
      <div class="detail-list__row">
        <dt><%= t("finance.recurring.start_date") %></dt>
        <dd><%= l(@recurring.start_date, format: :long) %></dd>
      </div>
      <div class="detail-list__row">
        <dt><%= t("finance.recurring.end_date") %></dt>
        <dd><%= @recurring.end_date ? l(@recurring.end_date, format: :long) : "—" %></dd>
      </div>
      <div class="detail-list__row">
        <dt><%= t("finance.recurring.last_generated_on") %></dt>
        <dd><%= @recurring.last_generated_on ? l(@recurring.last_generated_on, format: :long) : "—" %></dd>
      </div>
    </dl>
  </div>

  <%# ── Allocations card ───────────────────────────────────────────────────── %>
  <% if @allocations.any? %>
    <div class="card" style="margin-bottom: var(--space-5);">
      <div class="card-header">
        <h2 class="card-title"><%= t("finance.expenses.section_allocations") %></h2>
      </div>
      <div class="table-wrap" style="margin-bottom: 0;">
        <table>
          <thead><tr>
            <th><%= t("finance.expenses.branch") %></th>
            <th style="text-align: end;"><%= t("finance.expenses.percentage") %></th>
          </tr></thead>
          <tbody>
            <% @allocations.each do |alloc| %>
              <tr>
                <td><%= alloc.branch.name %></td>
                <td style="text-align: end;"><%= number_with_precision(alloc.allocation_percentage, precision: 2) %>%</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <%# ── Notes card ──────────────────────────────────────────────────────────── %>
  <% if @recurring.notes.present? %>
    <div class="card" style="margin-bottom: var(--space-5);">
      <div class="card-header">
        <h2 class="card-title"><%= t("finance.recurring.notes") %></h2>
      </div>
      <div style="overflow-wrap: anywhere;"><%= simple_format(@recurring.notes) %></div>
    </div>
  <% end %>

  <h2 class="section-title"><%= t("finance.recurring.generated_expenses") %></h2>
  <% if @generated.empty? %>
    <div class="empty-state"><p class="empty-state__title"><%= t("finance.recurring.no_generated") %></p></div>
  <% else %>
    <div class="table-wrap table-wrap--cards">
      <table>
        <thead><tr>
          <th><%= t("finance.expenses.reference") %></th>
          <th><%= t("finance.expenses.date") %></th>
          <th style="text-align: end;"><%= t("finance.expenses.amount") %></th>
          <th><%= t("finance.common.status") %></th>
        </tr></thead>
        <tbody>
          <% @generated.each do |expense| %>
            <tr>
              <td><%= link_to expense.reference_number, finance_expense_path(expense), class: "link" %></td>
              <td><%= l(expense.expense_date, format: :long) %></td>
              <td style="text-align: end;"><%= format_currency(expense.amount) %></td>
              <td><%= render "finance/expenses/status_badge", status: expense.status %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
