<%= form_with model: [ :finance, recurring ], class: "form-card",
      data: {
        controller: "line-items expense-type-select",
        expense_type_select_url_value: options_finance_expense_types_path,
        expense_type_select_placeholder_value: "— #{t('finance.expenses.select_type')}",
        expense_type_select_initial_type_id_value: recurring.expense_type_id
      } do |f| %>
  <%= render "shared/error_messages", object: recurring %>

  <h2 class="section-title"><%= t("finance.recurring.section_details") %></h2>
  <div class="form-grid">
    <div class="form-group">
      <%= f.label :expense_category_id, t("finance.expenses.category"), class: "form-label" %>
      <%= f.select :expense_category_id,
            options_from_collection_for_select(@categories, :id, :name, recurring.expense_category_id),
            { include_blank: "— #{t('finance.expenses.select_category')}" },
            class: "form-control #{'is-error' if recurring.errors[:expense_category].any?}",
            data: { expense_type_select_target: "categorySelect",
                    action: "change->expense-type-select#categoryChanged" } %>
    </div>
    <div class="form-group">
      <%= f.label :expense_type_id, t("finance.expenses.type"), class: "form-label" %>
      <%= f.select :expense_type_id,
            options_from_collection_for_select(@types, :id, :name, recurring.expense_type_id),
            { include_blank: "— #{t('finance.expenses.select_type')}" },
            class: "form-control",
            data: { expense_type_select_target: "typeSelect" } %>
    </div>
    <div class="form-group">
      <%= f.label :amount, t("finance.expenses.amount"), class: "form-label" %>
      <%= f.number_field :amount, step: "0.01", min: 0, class: "form-control #{'is-error' if recurring.errors[:amount].any?}" %>
    </div>
    <div class="form-group">
      <%= f.label :frequency, t("finance.recurring.frequency"), class: "form-label" %>
      <%= f.select :frequency,
            options_for_select(RecurringExpense::FREQUENCIES.map { |fr| [ t("finance.recurring.frequencies.#{fr}"), fr ] }, recurring.frequency),
            {}, class: "form-control" %>
    </div>
    <div class="form-group">
      <%= f.label :start_date, t("finance.recurring.start_date"), class: "form-label" %>
      <%= f.date_field :start_date, class: "form-control #{'is-error' if recurring.errors[:start_date].any?}" %>
    </div>
    <div class="form-group">
      <%= f.label :end_date, t("finance.recurring.end_date"), class: "form-label" %>
      <%= f.date_field :end_date, class: "form-control #{'is-error' if recurring.errors[:end_date].any?}" %>
      <p class="form-hint"><%= t("finance.recurring.end_date_hint") %></p>
    </div>
    <div class="form-group">
      <%= f.label :next_run_on, t("finance.recurring.next_run_on"), class: "form-label" %>
      <%= f.date_field :next_run_on, class: "form-control" %>
      <p class="form-hint"><%= t("finance.recurring.next_run_on_hint") %></p>
    </div>
    <div class="form-group">
      <%= f.label :branch_id, t("finance.expenses.branch"), class: "form-label" %>
      <%= f.select :branch_id,
            options_from_collection_for_select(@branches, :id, :name, recurring.branch_id),
            { include_blank: "— #{t('finance.expenses.no_branch')}" },
            class: "form-control" %>
      <p class="form-hint"><%= t("finance.expenses.branch_hint") %></p>
    </div>
    <div class="form-group" style="grid-column: 1 / -1;">
      <div class="form-check">
        <%= f.check_box :active, class: "form-check-input" %>
        <%= f.label :active, t("finance.common.active"), class: "form-check-label" %>
      </div>
    </div>
  </div>

  <div class="divider"></div>
  <h2 class="section-title"><%= t("finance.expenses.section_allocations") %></h2>
  <p class="form-hint"><%= t("finance.expenses.allocations_hint") %></p>
  <div class="table-wrap table-wrap--form-cards">
    <table class="line-items-table">
      <thead><tr>
        <th style="width: 60%;"><%= t("finance.expenses.branch") %></th>
        <th><%= t("finance.expenses.percentage") %></th>
        <th></th>
      </tr></thead>
      <tbody data-line-items-target="rows">
        <%= f.fields_for :recurring_expense_allocations do |alloc_f| %>
          <%= render "allocation_fields", f: alloc_f, branches: @branches %>
        <% end %>
      </tbody>
    </table>
  </div>
  <p data-line-items-target="emptyState" class="td-secondary" <%= "hidden" if recurring.recurring_expense_allocations.any? %>>
    <%= t("finance.expenses.no_allocations_hint") %>
  </p>
  <button type="button" class="btn btn-ghost btn-sm" data-action="line-items#add" style="margin-top: var(--space-3);">
    + <%= t("finance.expenses.add_allocation") %>
  </button>
  <template data-line-items-target="template">
    <%= f.fields_for :recurring_expense_allocations, RecurringExpenseAllocation.new, child_index: "NEW_INDEX" do |alloc_f| %>
      <%= render "allocation_fields", f: alloc_f, branches: @branches %>
    <% end %>
  </template>

  <div class="form-actions">
    <%= f.submit t("common.save"), class: "btn btn-primary" %>
    <%= link_to t("common.cancel"), finance_recurring_expenses_path, class: "btn btn-ghost" %>
  </div>
<% end %>
