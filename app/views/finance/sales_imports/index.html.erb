<% content_for :title, t("finance.sales_imports.index.title") %>

<div class="admin-page">

  <div class="page-header">
    <div>
      <h1 class="page-title"><%= t("finance.sales_imports.index.title") %></h1>
      <p class="page-subtitle"><%= t("finance.sales_imports.index.subtitle") %></p>
    </div>
    <div class="page-header__actions">
      <%= link_to t("finance.daily_reconciliations.index.title"),
            finance_daily_reconciliations_path,
            class: "btn btn-ghost btn-sm" %>
      <% if policy(:sales_import).create? %>
        <%= link_to t("finance.sales_imports.index.import_button"),
              new_finance_sales_import_path,
              class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>

  <%# ── Summary cards — business-wide totals, unaffected by filters below ── %>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: var(--space-3); margin-bottom: var(--space-6);">
    <%= render "finance/sales_imports/stat_card", label: t("finance.sales_imports.index.stat_total_imports"), value: @summary[:total_imports] %>
    <%= render "finance/sales_imports/stat_card", label: t("finance.sales_imports.index.stat_total_rows"), value: @summary[:total_rows] %>
    <%= render "finance/sales_imports/stat_card", label: t("finance.sales_imports.index.stat_imported_rows"), value: @summary[:imported_rows], modifier: (@summary[:imported_rows] > 0 ? "success" : nil) %>
    <%= render "finance/sales_imports/stat_card", label: t("finance.sales_imports.index.stat_duplicate_rows"), value: @summary[:duplicate_rows], modifier: (@summary[:duplicate_rows] > 0 ? "warning" : nil) %>
    <%= render "finance/sales_imports/stat_card", label: t("finance.sales_imports.index.stat_failed_rows"), value: @summary[:failed_rows], modifier: (@summary[:failed_rows] > 0 ? "danger" : nil) %>
  </div>

  <%# ── Filters ─────────────────────────────────────────────────────────── %>
  <%= form_with url: finance_sales_imports_path, method: :get,
        style: "display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; margin-bottom: var(--space-4);" do |f| %>
    <%= f.text_field :file_name, value: params[:file_name],
          placeholder: t("finance.sales_imports.index.filter_file_name"),
          class: "form-control form-control-sm", style: "width: auto;" %>
    <% if @filter_branch_names.any? %>
      <%= f.select :branch_name,
            [[t("finance.sales_imports.index.all_branches"), ""]] + @filter_branch_names.map { |n| [n, n] },
            { selected: params[:branch_name] },
            class: "form-control form-control-sm", style: "width: auto;" %>
    <% end %>
    <% if @filter_uploaders.any? %>
      <%= f.select :imported_by_id,
            [[t("finance.sales_imports.index.all_uploaders"), ""]] + @filter_uploaders.map { |u| [u.full_name, u.id] },
            { selected: params[:imported_by_id] },
            class: "form-control form-control-sm", style: "width: auto;" %>
    <% end %>
    <%= f.select :status,
          [[t("finance.sales_imports.index.all_statuses"), ""]] +
          @filter_statuses.map { |s| [t("finance.sales_imports.index.status_#{s}"), s] },
          { selected: params[:status] },
          class: "form-control form-control-sm", style: "width: auto;" %>
    <%= f.date_field :date_from, value: params[:date_from], class: "form-control form-control-sm", style: "width: auto;" %>
    <%= f.date_field :date_to,   value: params[:date_to],   class: "form-control form-control-sm", style: "width: auto;" %>
    <%= f.submit t("shared.filter"), class: "btn btn-ghost btn-sm" %>
    <% if params.slice(:file_name, :branch_name, :imported_by_id, :status, :date_from, :date_to).values.any?(&:present?) %>
      <%= link_to t("shared.clear_filters"), finance_sales_imports_path, class: "btn btn-ghost btn-sm" %>
    <% end %>
  <% end %>

  <% if @imports.empty? %>
    <div class="empty-state" style="padding: var(--space-16) var(--space-8);">
      <div class="empty-state__icon">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/>
        </svg>
      </div>
      <p class="empty-state__title"><%= t("finance.sales_imports.index.empty") %></p>
      <p class="empty-state__text"><%= t("finance.sales_imports.index.empty_hint") %></p>
      <% if policy(:sales_import).create? %>
        <div style="margin-top: var(--space-6);">
          <%= link_to t("finance.sales_imports.index.import_button"),
                new_finance_sales_import_path, class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  <% else %>

    <div class="table-container">
      <table class="table">
        <thead>
          <tr>
            <th><%= t("finance.sales_imports.index.col_file") %></th>
            <th><%= t("finance.sales_imports.index.col_uploaded_at") %></th>
            <th><%= t("finance.sales_imports.index.col_uploaded_by") %></th>
            <th><%= t("finance.sales_imports.index.col_branches") %></th>
            <th class="text-end"><%= t("finance.sales_imports.index.col_rows") %></th>
            <th class="text-end"><%= t("finance.sales_imports.index.col_imported") %></th>
            <th class="text-end"><%= t("finance.sales_imports.index.col_duplicates") %></th>
            <th class="text-end"><%= t("finance.sales_imports.index.col_failed") %></th>
            <th><%= t("finance.sales_imports.index.col_status") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @imports.each do |import| %>
            <tr>
              <td>
                <% if policy(import).show? %>
                  <%= link_to import.file_name, finance_sales_import_path(import), class: "link" %>
                <% else %>
                  <%= import.file_name %>
                <% end %>
              </td>
              <td><%= l(import.created_at, format: :short) %></td>
              <td><%= import.imported_by.full_name %></td>
              <td dir="auto">
                <% branches = @import_branch_names[import.id] || [] %>
                <%= branches.any? ? branches.join(", ") : "—" %>
              </td>
              <td class="text-end font-tabular"><%= import.total_rows %></td>
              <td class="text-end font-tabular"><%= import.matched_rows %></td>
              <td class="text-end font-tabular"><%= import.duplicate_rows %></td>
              <td class="text-end font-tabular"><%= import.failed_rows %></td>
              <td>
                <% if import.imported? %>
                  <span class="badge badge-success"><%= t("finance.sales_imports.index.status_imported") %></span>
                <% elsif import.failed? %>
                  <span class="badge badge-danger"><%= t("finance.sales_imports.index.status_failed") %></span>
                <% elsif import.column_mapped? %>
                  <span class="badge"><%= t("finance.sales_imports.index.status_column_mapped") %></span>
                <% else %>
                  <span class="badge"><%= t("finance.sales_imports.index.status_pending") %></span>
                <% end %>
              </td>
              <td>
                <div style="display: flex; gap: var(--space-2); justify-content: flex-end; flex-wrap: wrap;">
                  <% if policy(import).show? %>
                    <%= link_to t("shared.view"), finance_sales_import_path(import), class: "btn btn-ghost btn-sm" %>
                  <% end %>
                  <% if import.file.attached? %>
                    <%= link_to t("finance.sales_imports.index.download_file"),
                          rails_blob_path(import.file, disposition: "attachment"),
                          class: "btn btn-ghost btn-sm" %>
                  <% end %>
                  <% if policy(import).destroy? %>
                    <%= button_to t("common.delete"),
                          finance_sales_import_path(import),
                          method: :delete,
                          data: { turbo_confirm: t("common.are_you_sure") },
                          class: "btn btn-danger btn-sm",
                          form_class: "inline" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "shared/pagination",
          page: @page, total_pages: @total_pages,
          path_proc: ->(p) { finance_sales_imports_path(request.query_parameters.merge(page: p)) } %>

  <% end %>

</div>
