<% content_for :title, t("finance.sales_imports.new.title") %>

<div class="admin-page" style="max-width: 640px;">

  <div class="page-header">
    <div>
      <h1 class="page-title"><%= t("finance.sales_imports.new.title") %></h1>
      <p class="page-subtitle"><%= t("finance.sales_imports.new.subtitle") %></p>
    </div>
    <div class="page-header__actions">
      <%= link_to t("finance.daily_reconciliations.index.title"),
            finance_daily_reconciliations_path,
            class: "btn btn-ghost btn-sm" %>
    </div>
  </div>

  <%# Step indicator — always LTR %>
  <div dir="ltr" style="display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-6); font-size: var(--text-sm); color: var(--text-3);">
    <span style="color: var(--text-1); font-weight: 500;"><%= t("finance.sales_imports.steps.upload") %></span>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    <span><%= t("finance.sales_imports.steps.map_columns") %></span>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    <span><%= t("finance.sales_imports.steps.preview") %></span>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    <span><%= t("finance.sales_imports.steps.import") %></span>
  </div>

  <% if @sales_import.errors.any? %>
    <div class="alert alert-danger" style="margin-bottom: var(--space-4);">
      <ul style="margin: 0; padding-inline-start: var(--space-5);">
        <% @sales_import.errors.each do |e| %>
          <li><%= e.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with url: finance_sales_imports_path, method: :post, multipart: true do |f| %>

    <div class="card" style="padding: var(--space-6); margin-bottom: var(--space-4);">
      <div class="form-group">
        <%= label_tag "sales_import[file]", t("finance.sales_imports.new.file_label"), class: "form-label" %>
        <p style="font-size: var(--text-xs); color: var(--text-3); margin: 0 0 var(--space-2);">
          <%= t("finance.sales_imports.new.file_hint") %>
        </p>
        <input type="file" name="sales_import[file]" id="sales_import_file"
               class="form-control" accept=".csv,text/csv">
      </div>
    </div>

    <div style="background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius); padding: var(--space-4); margin-bottom: var(--space-5);">
      <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); margin: 0 0 var(--space-2);">
        <%= t("finance.sales_imports.new.expected_columns_label") %>
      </p>
      <p style="font-size: var(--text-sm); color: var(--text-2); margin: 0;">
        <%= t("finance.sales_imports.new.expected_columns_hint") %>
      </p>
      <p style="font-size: var(--text-xs); color: var(--text-3); margin: var(--space-2) 0 0;">
        <%= t("finance.sales_imports.new.multi_branch_note") %>
      </p>
    </div>

    <div style="display: flex; gap: var(--space-3); justify-content: flex-end;">
      <%= link_to t("shared.cancel"), finance_daily_reconciliations_path, class: "btn btn-ghost" %>
      <%= f.submit t("finance.sales_imports.new.submit"), class: "btn btn-primary" %>
    </div>

  <% end %>

</div>
