<nav class="bottom-nav" aria-label="<%= t('nav.dashboard') %>">

  <%= link_to root_path,
        class: "bottom-nav__item #{current_page?(root_path) ? 'is-active' : ''}" do %>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
    <span><%= t("nav.home") %></span>
  <% end %>

  <%= link_to attendance_records_path,
        class: "bottom-nav__item #{controller_name == 'attendance_records' && !request.path.start_with?('/admin') ? 'is-active' : ''}" do %>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    <span><%= t("nav.attendance") %></span>
  <% end %>

  <%= link_to employee_requests_path,
        class: "bottom-nav__item #{controller_name == 'employee_requests' && !request.path.start_with?('/admin') ? 'is-active' : ''}" do %>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
    <span><%= t("nav.requests") %></span>
  <% end %>

  <% if current_user.can?(:view_payroll) %>
    <%= link_to payroll_periods_path,
          class: "bottom-nav__item #{(controller_name == 'payroll_periods' || controller_name == 'payroll_entries') && !request.path.start_with?('/admin') ? 'is-active' : ''}" do %>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
      <span><%= t("nav.payroll") %></span>
    <% end %>
  <% end %>

  <% if current_user.can?(:manage_settings) || current_user.can?(:manage_roles) || current_user.can?(:manage_devices) || current_user.can?(:manage_obligations) %>
    <%= link_to admin_root_path,
          class: "bottom-nav__item #{request.path.start_with?('/admin') ? 'is-active' : ''}" do %>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/></svg>
      <span><%= t("nav.admin") %></span>
    <% end %>
  <% end %>

</nav>
