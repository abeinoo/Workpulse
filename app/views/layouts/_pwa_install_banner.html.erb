<div data-controller="pwa-install">

  <%# Android / Desktop — triggers the native install prompt %>
  <div data-pwa-install-target="androidBanner"
       hidden
       class="pwa-banner"
       role="complementary"
       aria-label="<%= t('pwa.install_title') %>">
    <img src="/icon-192.png" alt="" class="pwa-banner__icon" width="36" height="36">
    <div class="pwa-banner__text">
      <strong><%= t("pwa.install_title") %></strong>
      <span><%= t("pwa.install_subtitle") %></span>
    </div>
    <div class="pwa-banner__actions">
      <button class="btn btn-sm btn-primary"
              data-action="click->pwa-install#install"><%= t("pwa.install_button") %></button>
      <button class="pwa-banner__close"
              data-action="click->pwa-install#dismiss"
              aria-label="<%= t('pwa.dismiss') %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <%# iOS Safari — share-sheet instructions (no programmatic install API on iOS) %>
  <div data-pwa-install-target="iosBanner"
       hidden
       class="pwa-banner pwa-banner--ios"
       role="complementary"
       aria-label="<%= t('pwa.install_title') %>">
    <svg class="pwa-banner__ios-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
      <polyline points="16 6 12 2 8 6"/>
      <line x1="12" y1="2" x2="12" y2="15"/>
    </svg>
    <span class="pwa-banner__ios-text">
      <%= t("pwa.ios_tap") %>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-label="<%= t('pwa.ios_share') %>" style="vertical-align:middle;margin:0 1px"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
      <strong><%= t("pwa.ios_share") %></strong>, <%= t("pwa.ios_add") %>
    </span>
    <button class="pwa-banner__close"
            data-action="click->pwa-install#dismiss"
            aria-label="<%= t('pwa.dismiss') %>">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

</div>
