<aside class="sidebar" data-sidebar-target="sidebar">

  <div class="sidebar__header">
    <%= link_to root_path, class: "sidebar__brand", data: { action: "click->sidebar#close" } do %>
      <span class="text-white">Work</span><span class="text-accent">Pulse</span>
    <% end %>
  </div>

  <nav class="sidebar__nav" aria-label="<%= t('nav.dashboard') %>">

    <% if current_user.management_sidebar? %>

      <%# ── DASHBOARD ────────────────────────────────────────────────── %>
      <span class="sidebar__section-label"><%= t("nav.section_dashboard") %></span>

      <%= link_to root_path,
            class: "sidebar__nav-item #{current_page?(root_path) ? 'is-active' : ''}",
            data: { action: "click->sidebar#close" } do %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        <%= t("nav.dashboard") %>
      <% end %>

      <% if current_user.can?(:view_reports) %>
        <%= link_to operations_dashboard_path,
              class: "sidebar__nav-item #{controller_name == 'operations_dashboard' ? 'is-active' : ''}",
              data: { action: "click->sidebar#close" } do %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          <%= t("nav.operations") %>
        <% end %>
      <% end %>

      <%# ── WORKFORCE ────────────────────────────────────────────────── %>
      <% show_employees      = current_user.can?(:view_employees) %>
      <% show_branches       = current_user.can?(:manage_branches) %>
      <% show_shift_types    = current_user.can?(:manage_shifts) %>
      <% show_shift_assign   = current_user.can?(:assign_shifts) %>
      <% if show_employees || show_branches || show_shift_types || show_shift_assign %>
        <span class="sidebar__section-label"><%= t("nav.section_workforce") %></span>

        <% if show_employees %>
          <%= link_to admin_users_path,
                class: "sidebar__nav-item #{request.path.start_with?('/admin/users') ? 'is-active' : ''}",
                data: { action: "click->sidebar#close" } do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <%= t("nav.employees") %>
          <% end %>
        <% end %>

        <% if show_branches %>
          <%= link_to admin_branches_path,
                class: "sidebar__nav-item #{request.path.start_with?('/admin/branches') ? 'is-active' : ''}",
                data: { action: "click->sidebar#close" } do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <%= t("nav.branches") %>
          <% end %>
        <% end %>

        <% if show_shift_types %>
          <%= link_to admin_shifts_path,
                class: "sidebar__nav-item #{request.path.start_with?('/admin/shifts') ? 'is-active' : ''}",
                data: { action: "click->sidebar#close" } do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <%= t("nav.shift_types") %>
          <% end %>
        <% end %>

        <% if show_shift_assign %>
          <%= link_to shift_assignments_path,
                class: "sidebar__nav-item #{controller_name == 'shift_assignments' ? 'is-active' : ''}",
                data: { action: "click->sidebar#close" } do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><polyline points="9 16 11 18 15 14"/></svg>
            <%= t("nav.shift_assignments") %>
          <% end %>
        <% end %>

        <% if show_shift_types %>
          <%= link_to admin_shift_rule_profiles_path,
                class: "sidebar__nav-item #{controller_name == 'shift_rule_profiles' ? 'is-active' : ''}",
                data: { action: "click->sidebar#close" } do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5H7a2 2 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/></svg>
            <%= t("nav.shift_rule_profiles") %>
          <% end %>
        <% end %>

      <% end %>

      <%# ── ATTENDANCE ───────────────────────────────────────────────── %>
      <% show_attendance_rec = current_user.can?(:view_attendance) %>
      <% show_punch_logs     = current_user.can?(:manage_devices) %>
      <% if show_attendance_rec || show_punch_logs %>
        <span class="sidebar__section-label"><%= t("nav.section_attendance") %></span>

        <% if show_attendance_rec %>
          <%= link_to attendance_records_path,
                class: "sidebar__nav-item #{controller_name == 'attendance_records' && !request.path.start_with?('/admin') ? 'is-active' : ''}",
                data: { action: "click->sidebar#close" } do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 01-2 2H5a2 2 01-2-2V5a2 2 012-2h11"/></svg>
            <%= t("nav.attendance_logs") %>
          <% end %>
        <% end %>

        <% if show_punch_logs %>
          <%= link_to admin_biometric_punch_logs_path,
                class: "sidebar__nav-item #{request.path.start_with?('/admin/biometric_punch_logs') ? 'is-active' : ''}",
                data: { action: "click->sidebar#close" } do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            <%= t("nav.punch_logs") %>
          <% end %>
        <% end %>
      <% end %>

      <%# ── PAYROLL ──────────────────────────────────────────────────── %>
      <% if current_user.can?(:view_payroll) %>
        <span class="sidebar__section-label"><%= t("nav.section_payroll") %></span>

        <%= link_to payroll_periods_path,
              class: "sidebar__nav-item #{controller_name.in?(%w[payroll_periods payroll_entries payroll_adjustments payroll_line_items]) ? 'is-active' : ''}",
              data: { action: "click->sidebar#close" } do %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
          <%= t("nav.payroll") %>
        <% end %>
      <% end %>

      <%# ── ADJUSTMENTS ──────────────────────────────────────────────── %>
      <% if current_user.can?(:view_adjustments) || current_user.can?(:manage_adjustments) || current_user.can?(:approve_adjustments) %>
        <span class="sidebar__section-label"><%= t("nav.section_adjustments") %></span>

        <%= link_to adjustments_path,
              class: "sidebar__nav-item #{controller_name == 'adjustments' ? 'is-active' : ''}",
              data: { action: "click->sidebar#close" } do %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
          <%= t("nav.adjustments") %>
        <% end %>
      <% end %>

      <%# ── REQUESTS ─────────────────────────────────────────────────── %>
      <% if current_user.can?(:approve_requests) || current_user.can?(:view_requests) %>
        <span class="sidebar__section-label"><%= t("nav.section_requests") %></span>

        <%= link_to employee_requests_path,
              class: "sidebar__nav-item #{controller_name == 'employee_requests' && !request.path.start_with?('/admin') ? 'is-active' : ''}",
              data: { action: "click->sidebar#close" } do %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <%= t("nav.requests") %>
        <% end %>
      <% end %>

      <%# ── INVENTORY ────────────────────────────────────────────────── %>
      <% if current_user.can?(:view_inventory) || current_user.can?(:manage_inventory) || current_user.can?(:view_inventory_reports) %>
        <span class="sidebar__section-label"><%= t("nav.section_inventory") %></span>

        <%= link_to inventory_root_path,
              class: "sidebar__nav-item sidebar__nav-item--sub #{controller_name == 'dashboard' && controller_path.start_with?('inventory') ? 'is-active' : ''}",
              data: { action: "click->sidebar#close" } do %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          <%= t("nav.inventory_dashboard") %>
        <% end %>

        <%= link_to inventory_products_path,
              class: "sidebar__nav-item sidebar__nav-item--sub #{controller_name.in?(%w[products brands product_categories]) && controller_path.start_with?('inventory') ? 'is-active' : ''}",
              data: { action: "click->sidebar#close" } do %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
          <%= t("nav.inventory_products") %>
        <% end %>

        <%= link_to inventory_warehouses_path,
              class: "sidebar__nav-item sidebar__nav-item--sub #{controller_name == 'warehouses' ? 'is-active' : ''}",
              data: { action: "click->sidebar#close" } do %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 8.35V20a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8.35"/><path d="M2 8.35l10-5.5 10 5.5"/><path d="M6 22V12h12v10"/></svg>
          <%= t("nav.inventory_warehouses") %>
        <% end %>

        <%= link_to inventory_suppliers_path,
              class: "sidebar__nav-item sidebar__nav-item--sub #{controller_name == 'suppliers' ? 'is-active' : ''}",
              data: { action: "click->sidebar#close" } do %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <%= t("nav.inventory_suppliers") %>
        <% end %>

        <%= link_to inventory_goods_receipts_path,
              class: "sidebar__nav-item sidebar__nav-item--sub #{controller_name == 'goods_receipts' ? 'is-active' : ''}",
              data: { action: "click->sidebar#close" } do %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="M19 12l-7 7-7-7"/></svg>
          <%= t("nav.inventory_goods_receipts") %>
        <% end %>

        <%= link_to inventory_stock_issues_path,
              class: "sidebar__nav-item sidebar__nav-item--sub #{controller_name == 'stock_issues' ? 'is-active' : ''}",
              data: { action: "click->sidebar#close" } do %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5"/><path d="M5 12l7-7 7 7"/></svg>
          <%= t("nav.inventory_stock_issues") %>
        <% end %>

        <%= link_to inventory_stock_transfers_path,
              class: "sidebar__nav-item sidebar__nav-item--sub #{controller_name == 'stock_transfers' ? 'is-active' : ''}",
              data: { action: "click->sidebar#close" } do %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
          <%= t("nav.inventory_stock_transfers") %>
        <% end %>

        <%= link_to inventory_stock_adjustments_path,
              class: "sidebar__nav-item sidebar__nav-item--sub #{controller_name == 'stock_adjustments' ? 'is-active' : ''}",
              data: { action: "click->sidebar#close" } do %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
          <%= t("nav.inventory_stock_adjustments") %>
        <% end %>

        <%= link_to inventory_stock_counts_path,
              class: "sidebar__nav-item sidebar__nav-item--sub #{controller_name == 'stock_counts' ? 'is-active' : ''}",
              data: { action: "click->sidebar#close" } do %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          <%= t("nav.inventory_stock_counts") %>
        <% end %>

        <% if current_user.can?(:view_inventory_reports) || current_user.can?(:view_inventory) || current_user.can?(:manage_inventory) %>
          <%= link_to inventory_reports_path,
                class: "sidebar__nav-item sidebar__nav-item--sub #{controller_name == 'reports' && controller_path.start_with?('inventory') ? 'is-active' : ''}",
                data: { action: "click->sidebar#close" } do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
            <%= t("nav.inventory_reports") %>
          <% end %>
        <% end %>
      <% end %>

      <%# ── FINANCE ──────────────────────────────────────────────────── %>
      <% finance_perms = %i[view_finance_dashboard
                            view_expenses create_expenses edit_expenses approve_expenses
                            view_employee_balances manage_employee_balances
                            create_balance_requests approve_balance_requests
                            view_expense_reports manage_branch_revenue
                            manage_payment_methods
                            create_till_session view_daily_reconciliation view_session_totals
                            close_till_session accept_till_handover create_till_deposit
                            verify_daily_reconciliation edit_session_totals
                            void_till_handover void_till_deposit
                            settle_remaining_deposit_balance
                            view_deposit_verification import_bank_statement] %>
      <% if finance_perms.any? { |p| current_user.can?(p) } %>
        <span class="sidebar__section-label"><%= t("nav.section_finance") %></span>

        <% if current_user.can?(:view_finance_dashboard) %>
          <%= link_to finance_root_path,
                class: "sidebar__nav-item sidebar__nav-item--sub #{controller_name == 'dashboard' && controller_path.start_with?('finance') ? 'is-active' : ''}",
                data: { action: "click->sidebar#close" } do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
            <%= t("nav.finance_dashboard") %>
          <% end %>
        <% end %>

        <% if current_user.can?(:view_expenses) || current_user.can?(:create_expenses) %>
          <%= link_to finance_expenses_path,
                class: "sidebar__nav-item sidebar__nav-item--sub #{controller_name == 'expenses' ? 'is-active' : ''}",
                data: { action: "click->sidebar#close" } do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
            <%= t("nav.finance_expenses") %>
          <% end %>
        <% end %>

        <% if current_user.can?(:view_employee_balances) || current_user.can?(:manage_employee_balances) ||
              current_user.can?(:create_balance_requests) %>
          <%= link_to finance_custody_accounts_path,
                class: "sidebar__nav-item sidebar__nav-item--sub #{%w[custody_accounts custody_transactions balance_requests].include?(controller_name) ? 'is-active' : ''}",
                data: { action: "click->sidebar#close" } do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
            <%= t("nav.finance_custody") %>
          <% end %>
        <% end %>

        <% if current_user.can?(:view_expense_reports) || current_user.can?(:manage_branch_revenue) %>
          <%= link_to finance_branch_revenues_path,
                class: "sidebar__nav-item sidebar__nav-item--sub #{controller_name == 'branch_revenues' ? 'is-active' : ''}",
                data: { action: "click->sidebar#close" } do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            <%= t("nav.finance_branch_revenue") %>
          <% end %>
        <% end %>

        <% if current_user.can?(:view_expense_reports) %>
          <%= link_to finance_reports_path,
                class: "sidebar__nav-item sidebar__nav-item--sub #{controller_name == 'reports' && controller_path.start_with?('finance') ? 'is-active' : ''}",
                data: { action: "click->sidebar#close" } do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><rect x="7" y="10" width="3" height="7"/><rect x="14" y="6" width="3" height="11"/></svg>
            <%= t("nav.finance_reports") %>
          <% end %>
        <% end %>

        <% if current_user.can?(:manage_payment_methods) %>
          <%= link_to finance_payment_methods_path,
                class: "sidebar__nav-item sidebar__nav-item--sub #{controller_name == 'payment_methods' ? 'is-active' : ''}",
                data: { action: "click->sidebar#close" } do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
            <%= t("nav.finance_payment_methods") %>
          <% end %>
        <% end %>

        <% if current_user.can?(:view_daily_reconciliation) || current_user.can?(:verify_daily_reconciliation) %>
          <%= link_to finance_daily_reconciliations_path,
                class: "sidebar__nav-item sidebar__nav-item--sub #{controller_name == 'daily_reconciliations' ? 'is-active' : ''}",
                data: { action: "click->sidebar#close" } do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 01-2 2H5a2 2 01-2-2V5a2 2 012-2h11"/></svg>
            <%= t("nav.finance_reconciliation") %>
          <% end %>
        <% end %>

        <% if current_user.can?(:view_deposit_verification) %>
          <%= link_to finance_deposit_verifications_path,
                class: "sidebar__nav-item sidebar__nav-item--sub #{controller_name == 'deposit_verifications' ? 'is-active' : ''}",
                data: { action: "click->sidebar#close" } do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <%= t("nav.finance_deposit_verification") %>
          <% end %>
        <% end %>

        <% if current_user.can?(:import_bank_statement) || current_user.can?(:view_deposit_verification) %>
          <%= link_to finance_bank_statements_path,
                class: "sidebar__nav-item sidebar__nav-item--sub #{%w[bank_statements bank_statement_transactions].include?(controller_name) ? 'is-active' : ''}",
                data: { action: "click->sidebar#close" } do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            <%= t("nav.finance_bank_statements") %>
          <% end %>
        <% end %>

      <% end %>

      <%# ── PERFORMANCE ──────────────────────────────────────────────── %>
      <% if current_user.can?(:view_performance_dashboard) || current_user.can?(:view_notes)          ||
            current_user.can?(:view_monthly_reviews)       || current_user.can?(:view_performance_reports) ||
            current_user.can?(:create_observations)        || current_user.can?(:manage_reviews)      ||
            current_user.can?(:finalize_reviews)           || current_user.can?(:manage_evaluation_templates) %>
        <span class="sidebar__section-label"><%= t("nav.section_performance") %></span>

        <% if current_user.can?(:view_performance_dashboard) %>
          <%= link_to performance_root_path,
                class: "sidebar__nav-item sidebar__nav-item--sub #{controller_name == 'dashboard' && controller_path.start_with?('performance') ? 'is-active' : ''}",
                data: { action: "click->sidebar#close" } do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
            <%= t("nav.performance_dashboard") %>
          <% end %>
        <% end %>

        <% if current_user.can?(:view_notes) || current_user.can?(:create_observations) %>
          <%= link_to performance_observations_path,
                class: "sidebar__nav-item sidebar__nav-item--sub #{controller_name == 'observations' ? 'is-active' : ''}",
                data: { action: "click->sidebar#close" } do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            <%= t("nav.performance_observations") %>
          <% end %>
        <% end %>

        <% if current_user.can?(:view_monthly_reviews) || current_user.can?(:manage_reviews) || current_user.can?(:finalize_reviews) %>
          <%= link_to performance_reviews_path,
                class: "sidebar__nav-item sidebar__nav-item--sub #{controller_name == 'reviews' && controller_path.start_with?('performance') ? 'is-active' : ''}",
                data: { action: "click->sidebar#close" } do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.48 3.5l2.6 5.27 5.82.85-4.21 4.1.99 5.8L11.48 17l-5.2 2.73.99-5.8L3.06 9.62l5.82-.85z"/></svg>
            <%= t("nav.performance_reviews") %>
          <% end %>
        <% end %>

        <% if current_user.can?(:view_performance_reports) %>
          <%= link_to performance_reports_path,
                class: "sidebar__nav-item sidebar__nav-item--sub #{controller_name == 'reports' && controller_path.start_with?('performance') ? 'is-active' : ''}",
                data: { action: "click->sidebar#close" } do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><rect x="7" y="10" width="3" height="7"/><rect x="14" y="6" width="3" height="11"/></svg>
            <%= t("nav.performance_reports") %>
          <% end %>
        <% end %>
      <% end %>

      <%# ── ADMINISTRATION (collapsible) ────────────────────────────── %>
      <% show_devices     = current_user.can?(:manage_devices) %>
      <% show_obligations = current_user.can?(:manage_obligations) %>
      <% show_roles       = current_user.can?(:manage_roles) %>
      <% show_settings    = current_user.can?(:manage_settings) %>
      <% show_eval_templates = current_user.can?(:manage_evaluation_templates) %>
      <% if show_devices || show_obligations || show_roles || show_settings || show_eval_templates %>
        <% admin_paths = %w[/admin/biometric_devices /admin/employee_obligations /admin/permission_roles /admin/settings /admin/departments /admin/evaluation_templates] %>
        <% admin_active = admin_paths.any? { |p| request.path.start_with?(p) } %>
          <details class="sidebar__group" <%= 'open' if admin_active %>>
            <summary class="sidebar__section-label sidebar__group-toggle">
              <%= t("nav.section_administration") %>
              <svg class="sidebar__group-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>

            <% if show_devices %>
              <%= link_to admin_biometric_devices_path,
                    class: "sidebar__nav-item sidebar__nav-item--sub #{request.path.start_with?('/admin/biometric_devices') ? 'is-active' : ''}",
                    data: { action: "click->sidebar#close" } do %>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/><circle cx="12" cy="10" r="3"/></svg>
                <%= t("nav.biometric_devices") %>
              <% end %>
            <% end %>

            <% if show_obligations %>
              <%= link_to admin_employee_obligations_path,
                    class: "sidebar__nav-item sidebar__nav-item--sub #{request.path.start_with?('/admin/employee_obligations') ? 'is-active' : ''}",
                    data: { action: "click->sidebar#close" } do %>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5H7a2 2 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 00-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="M9 12h6M9 16h4"/></svg>
                <%= t("nav.employee_obligations") %>
              <% end %>
            <% end %>

            <% if show_roles %>
              <%= link_to admin_permission_roles_path,
                    class: "sidebar__nav-item sidebar__nav-item--sub #{request.path.start_with?('/admin/permission_roles') ? 'is-active' : ''}",
                    data: { action: "click->sidebar#close" } do %>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <%= t("nav.permission_roles") %>
              <% end %>
            <% end %>

            <% if show_settings %>
              <%= link_to admin_settings_path,
                    class: "sidebar__nav-item sidebar__nav-item--sub #{request.path.start_with?('/admin/settings') ? 'is-active' : ''}",
                    data: { action: "click->sidebar#close" } do %>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                <%= t("nav.settings") %>
              <% end %>
            <% end %>

            <% if show_eval_templates %>
              <%= link_to admin_departments_path,
                    class: "sidebar__nav-item sidebar__nav-item--sub #{request.path.start_with?('/admin/departments') ? 'is-active' : ''}",
                    data: { action: "click->sidebar#close" } do %>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                <%= t("nav.departments") %>
              <% end %>

              <%= link_to admin_evaluation_templates_path,
                    class: "sidebar__nav-item sidebar__nav-item--sub #{request.path.start_with?('/admin/evaluation_templates') ? 'is-active' : ''}",
                    data: { action: "click->sidebar#close" } do %>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                <%= t("nav.evaluation_templates") %>
              <% end %>
            <% end %>
          </details>
      <% end %>

    <% else %>

      <%# ── EMPLOYEE VIEW (no management access) ────────────────────── %>

      <%= link_to root_path,
            class: "sidebar__nav-item #{current_page?(root_path) ? 'is-active' : ''}",
            data: { action: "click->sidebar#close" } do %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        <%= t("nav.dashboard") %>
      <% end %>

      <%= link_to attendance_records_path,
            class: "sidebar__nav-item #{controller_name == 'attendance_records' ? 'is-active' : ''}",
            data: { action: "click->sidebar#close" } do %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 01-2 2H5a2 2 01-2-2V5a2 2 012-2h11"/></svg>
        <%= t("nav.my_attendance") %>
      <% end %>

      <%= link_to shift_assignments_path,
            class: "sidebar__nav-item #{controller_name == 'shift_assignments' ? 'is-active' : ''}",
            data: { action: "click->sidebar#close" } do %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <%= t("nav.my_shifts") %>
      <% end %>

      <%= link_to employee_requests_path,
            class: "sidebar__nav-item #{controller_name == 'employee_requests' ? 'is-active' : ''}",
            data: { action: "click->sidebar#close" } do %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <%= t("nav.requests") %>
      <% end %>

      <% if current_user.can?(:view_payroll) %>
        <%= link_to payroll_periods_path,
              class: "sidebar__nav-item #{controller_name.in?(%w[payroll_periods payroll_entries]) ? 'is-active' : ''}",
              data: { action: "click->sidebar#close" } do %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
          <%= t("nav.payroll") %>
        <% end %>
      <% end %>

      <%# Employees see their own approved adjustments (Scope-enforced). %>
      <%= link_to adjustments_path,
            class: "sidebar__nav-item #{controller_name == 'adjustments' ? 'is-active' : ''}",
            data: { action: "click->sidebar#close" } do %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
        <%= t("nav.adjustments") %>
      <% end %>

      <% if current_user.can?(:view_monthly_reviews) %>
        <%= link_to performance_reviews_path,
              class: "sidebar__nav-item #{controller_name == 'reviews' && controller_path.start_with?('performance') ? 'is-active' : ''}",
              data: { action: "click->sidebar#close" } do %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.48 3.5l2.6 5.27 5.82.85-4.21 4.1.99 5.8L11.48 17l-5.2 2.73.99-5.8L3.06 9.62l5.82-.85z"/></svg>
          <%= t("nav.my_reviews") %>
        <% end %>
      <% end %>

    <% end %>

  </nav>

  <div class="sidebar__footer">
    <div class="sidebar__user">
      <%= sidebar_user_avatar_tag(current_user) %>
      <div class="sidebar__user-info">
        <p class="sidebar__user-name"><%= current_user.full_name %></p>
        <p class="sidebar__user-role">
          <%= current_user.permission_role&.name.presence || (current_user.owner? ? "Super Admin" : t("nav.staff")) %>
        </p>
      </div>
    </div>

    <%= render "shared/language_switcher", variant: :sidebar, url: user_locale_path %>

    <%= render "shared/theme_toggle", variant: :sidebar %>

    <%= link_to edit_profile_password_path,
          class: "sidebar__nav-item #{request.path == edit_profile_password_path ? 'is-active' : ''}",
          data: { action: "click->sidebar#close" } do %>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      <%= t("nav.change_password") %>
    <% end %>

    <%= link_to destroy_user_session_path,
          class: "sidebar__nav-item sidebar__nav-item--sign-out",
          data: { turbo_method: :delete } do %>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      <%= t("nav.sign_out") %>
    <% end %>
  </div>

</aside>
