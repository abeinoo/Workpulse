<%#
  Reusable collapsible sidebar section — a <details>/<summary> disclosure
  (same markup/CSS as the original Administration group) enhanced with
  aria-expanded sync and sessionStorage persistence (see
  sidebar_group_controller.js). Used as a layout so callers pass their
  existing nav-item links as the block body, unchanged.

  Locals:
    key    - stable slug for this group (content id + sessionStorage key)
    label  - translated group title (already run through t(...) by the caller)
    active - true when the current page belongs to this group, computed by
             the caller from the same is-active conditions its child links
             already use — never re-derived here.
    default_open - (optional, default false) render expanded even when not
             active. The user's own collapse choice (sessionStorage) still
             wins; an active group is always open.
    items  - (optional) how many links the caller will render, counted from
             the same permission checks that gate them. With fewer than 2,
             collapsing adds nothing, so the section renders as a plain
             heading + link — no chevron, no remembered state. Omitted =
             always collapsible.
%>
<% if local_assigns.key?(:items) && items < 2 %>
<div class="sidebar__section" data-sidebar-section-key="<%= key %>">
  <span class="sidebar__section-label"><span class="sidebar__group-label"><%= label %></span></span>
  <%= yield %>
</div>
<% else %>
<% content_id = "sidebar-group-#{key}" %>
<% expanded = active || local_assigns.fetch(:default_open, false) %>
<details class="sidebar__group" <%= "open" if expanded %>
          data-controller="sidebar-group"
          data-sidebar-group-key-value="<%= key %>"
          data-sidebar-group-active-value="<%= active ? "true" : "false" %>"
          data-action="toggle->sidebar-group#onToggle">
  <summary class="sidebar__section-label sidebar__group-toggle"
           aria-expanded="<%= expanded ? "true" : "false" %>"
           aria-controls="<%= content_id %>"
           data-sidebar-group-target="summary">
    <span class="sidebar__group-label"><%= label %></span>
    <svg class="sidebar__group-chevron" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
  </summary>
  <div id="<%= content_id %>">
    <%= yield %>
  </div>
</details>
<% end %>
