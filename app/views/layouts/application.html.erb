<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= I18n.locale.to_s == 'ar' ? 'rtl' : 'ltr' %>">
  <head>
    <title><%= content_for(:title) || "WorkPulse" %></title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">

    <%# Theme bootstrap — runs before first paint to prevent a flash of the
        wrong theme. Reads the saved preference, falling back to the OS setting
        on first visit. Class strategy: `dark` on <html> = dark, absence = light. %>
    <script>
      (function () {
        try {
          var saved = localStorage.getItem("theme");
          var dark = saved ? saved === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", dark);
        } catch (e) {
          /* default (light) applies with no class */
        }
      })();
    </script>

    <%# PWA / mobile meta %>
    <meta name="theme-color" content="#54C6F9">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="WorkPulse">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="application-name" content="WorkPulse">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="app-locale" content="<%= I18n.locale %>">
    <meta name="app-dir" content="<%= I18n.locale.to_s == 'ar' ? 'rtl' : 'ltr' %>">

    <%= yield :head %>

    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png">
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.json">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= user_signed_in? ? 'is-authenticated' : 'is-guest' %>">

    <% if user_signed_in? %>
      <div class="app-shell" data-controller="sidebar">

        <%# Mobile top bar %>
        <header class="mobile-header">
          <button class="sidebar-toggle"
                  data-action="click->sidebar#toggle"
                  aria-label="Toggle menu">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          </button>
          <a href="<%= root_path %>" class="mobile-header__brand">
            <span class="text-white">Work</span><span class="text-accent">Pulse</span>
          </a>
          <%= render "shared/theme_toggle", variant: :header %>
        </header>

        <%# Sidebar %>
        <%= render "layouts/sidebar" %>

        <%# Overlay (mobile drawer backdrop) %>
        <div class="sidebar-overlay"
             data-sidebar-target="overlay"
             data-action="click->sidebar#close"></div>

        <%# Main content %>
        <main class="app-main">
          <% if notice.present? %>
            <div class="flash flash--notice" data-turbo-temporary>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <%= notice %>
            </div>
          <% end %>

          <% if alert.present? %>
            <div class="flash flash--alert" data-turbo-temporary>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <%= alert %>
            </div>
          <% end %>

          <% if flash[:warning].present? %>
            <div class="flash flash--warning" data-turbo-temporary>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              <%= flash[:warning] %>
            </div>
          <% end %>

          <%= yield %>
        </main>

        <%# Bottom navigation (mobile) %>
        <%= render "layouts/bottom_nav" %>

      </div>
    <% else %>
      <% if notice.present? %>
        <div class="flash flash--notice" data-turbo-temporary>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <%= notice %>
        </div>
      <% end %>

      <% if alert.present? %>
        <div class="flash flash--alert" data-turbo-temporary>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <%= alert %>
        </div>
      <% end %>

      <% if flash[:warning].present? %>
        <div class="flash flash--warning" data-turbo-temporary>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          <%= flash[:warning] %>
        </div>
      <% end %>

      <main class="main-content">
        <%= yield %>
      </main>
    <% end %>

    <%= render "layouts/pwa_install_banner" %>

    <%# ── Global modal overlay (Turbo Frame target) ──────────────────────── %>
    <div id="modal-overlay"
         data-controller="modal"
         data-action="click->modal#backdropClick keydown.esc@window->modal#close"
         style="display:none; position:fixed; inset:0; z-index:200; align-items:flex-end; justify-content:center; background:rgba(0,0,0,0.55); backdrop-filter:blur(2px);">
      <div data-action="click->modal#stopPropagation"
           style="position:relative; width:100%; max-width:680px; max-height:92vh; overflow-y:auto; background:var(--surface); border-radius:var(--radius-xl, 16px) var(--radius-xl, 16px) 0 0; box-shadow:0 -4px 32px rgba(0,0,0,0.18);">
        <turbo-frame id="modal" data-modal-target="frame">
        </turbo-frame>
      </div>
    </div>
  </body>
</html>
