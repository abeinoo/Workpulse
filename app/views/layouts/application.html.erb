<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "WorkPulse" %></title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%# PWA / mobile meta %>
    <meta name="theme-color" content="#54C6F9">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="WorkPulse">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="application-name" content="WorkPulse">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png">
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.json">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= user_signed_in? ? 'is-authenticated' : 'is-guest' %>">

    <% if user_signed_in? %>
      <nav class="navbar">
        <div class="navbar__inner">
          <a href="<%= root_path %>" class="navbar__brand">
            <img src="/icon.svg" alt="" class="navbar__logo">
            <span class="navbar__name">
              <span class="text-white">Work</span><span class="text-accent">Pulse</span>
            </span>
          </a>

          <div class="navbar__actions">
            <% if current_user.admin? %>
              <%= link_to "Employees", admin_employees_path, class: "navbar__link" %>
            <% end %>
            <span class="navbar__user">
              <%= current_user.employee&.full_name&.split&.first || current_user.email&.split("@")&.first %>
            </span>
            <%= link_to "Sign out",
                        destroy_user_session_path,
                        data: { turbo_method: :delete },
                        class: "btn btn-ghost btn-sm" %>
          </div>
        </div>
      </nav>
    <% end %>

    <% if notice.present? %>
      <div class="flash flash--notice" data-turbo-temporary>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <%= notice %>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="flash flash--alert" data-turbo-temporary>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <%= alert %>
      </div>
    <% end %>

    <main class="main-content">
      <%= yield %>
    </main>

  </body>
</html>
