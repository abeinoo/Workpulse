<div class="admin-page">
  <div class="page-header">
    <div>
      <%= link_to t("payroll_adjustments.new.back"), payroll_period_payroll_entry_path(@period, @entry), class: "back-link" %>
      <h1 class="page-title"><%= t("payroll_adjustments.new.title") %></h1>
      <p class="page-subtitle"><%= @entry.user.full_name %> &middot; <%= @period.period_label %></p>
    </div>
  </div>

  <%= form_with model: @adjustment,
        url: payroll_period_payroll_entry_payroll_adjustments_path(@period, @entry),
        method: :post,
        data: { controller: "payroll-adjustment-form" } do |f| %>

    <% if @adjustment.errors.any? %>
      <div class="alert alert-danger" style="margin-bottom: 1rem;">
        <% @adjustment.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <div class="form-card">

      <%# ── Type ──────────────────────────────────────────────────────────── %>
      <div class="form-group">
        <%= f.label :adjustment_type, t("payroll_adjustments.new.type"), class: "form-label" %>
        <%= f.select :adjustment_type,
              [
                [t("payroll_adjustments.types.cash_incentive"),   "cash_incentive"],
                [t("payroll_adjustments.types.commission"),       "commission"],
                [t("payroll_adjustments.types.penalty"),          "penalty"],
                [t("payroll_adjustments.types.manual_deduction"), "manual_deduction"]
              ],
              { selected: params[:adjustment_type] || "cash_incentive" },
              class: "form-control",
              data: { payroll_adjustment_form_target: "type", action: "change->payroll-adjustment-form#onChange" } %>
      </div>

      <%# ── Amount ────────────────────────────────────────────────────────── %>
      <div class="form-group">
        <%= f.label :amount, t("payroll_adjustments.new.amount_label"), class: "form-label" %>
        <%= f.number_field :amount, step: "0.01", min: "0.01",
              placeholder: "0.00", class: "form-control" %>
      </div>

      <%# ── Reason ─────────────────────────────────────────────────────────── %>
      <div class="form-group">
        <%= f.label :reason, t("payroll_adjustments.new.reason_label"), class: "form-label" %>
        <%= f.text_area :reason, rows: 3,
              placeholder: t("payroll_adjustments.new.reason_placeholder"),
              class: "form-control", required: true %>
      </div>

      <%# ── Already Paid section — only visible when type == cash_incentive ── %>
      <% selected_type = @adjustment.adjustment_type.presence ||
                         params[:adjustment_type].presence ||
                         "cash_incentive" %>
      <%= render "shared/adjustment_already_paid_section",
            f: f, adjustment: @adjustment, selected_type: selected_type %>

      <% if !current_user.owner? %>
        <p class="form-hint" data-payroll-adjustment-form-target="reviewHint">
          <%= t("payroll_adjustments.new.hint") %>
        </p>
      <% end %>

      <div class="form-actions">
        <%= f.submit t("payroll_adjustments.new.submit"),
              class: "btn btn-primary" %>
        <%= link_to t("forms.cancel"), payroll_period_payroll_entry_path(@period, @entry),
              class: "btn btn-secondary" %>
      </div>
    </div>
  <% end %>
</div>

