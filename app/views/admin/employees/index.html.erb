<% content_for :title, "Employees — WorkPulse" %>

<div class="admin-page">

  <div class="page-header">
    <h1 class="page-title">Employees</h1>
    <%= link_to new_admin_employee_path, class: "btn btn-primary" do %>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Add Employee
    <% end %>
  </div>

  <% if @employees.any? %>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Employee</th>
            <th>Phone</th>
            <th>Department</th>
            <th>Status</th>
            <th>Account</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @employees.each do |employee| %>
            <tr>
              <td>
                <div class="employee-cell">
                  <div class="avatar">
                    <%= employee.full_name.split.map(&:first).first(2).join.upcase %>
                  </div>
                  <div>
                    <div class="employee-cell__name"><%= employee.full_name %></div>
                    <div class="employee-cell__sub"><%= employee.job_title.presence || employee.email %></div>
                  </div>
                </div>
              </td>
              <td class="td-secondary"><%= employee.phone_number %></td>
              <td class="td-secondary"><%= employee.department.presence || "—" %></td>
              <td>
                <% badge_class = case employee.status
                     when "active"      then "badge-success"
                     when "inactive"    then "badge-neutral"
                     when "terminated"  then "badge-danger"
                     else "badge-neutral"
                   end %>
                <span class="badge <%= badge_class %>"><%= employee.status.humanize %></span>
              </td>
              <td>
                <% if employee.user %>
                  <span class="badge badge-accent">Registered</span>
                <% else %>
                  <span class="badge badge-warning">Pending</span>
                <% end %>
              </td>
              <td>
                <div class="td-actions">
                  <%= link_to "View", admin_employee_path(employee), class: "btn btn-ghost btn-sm" %>
                  <%= link_to "Edit", edit_admin_employee_path(employee), class: "btn btn-secondary btn-sm" %>
                  <%= button_to "Delete",
                        admin_employee_path(employee),
                        method: :delete,
                        data: { turbo_confirm: "Delete #{employee.full_name}? This cannot be undone." },
                        class: "btn btn-danger btn-sm" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="empty-state__icon">👥</div>
      <p class="empty-state__title">No employees yet</p>
      <p class="empty-state__text">Add your first employee to get started.</p>
    </div>
  <% end %>

</div>
