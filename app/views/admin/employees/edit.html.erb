<% content_for :title, "Edit #{@employee.full_name} — WorkPulse" %>

<div class="form-page">
  <%= link_to admin_employee_path(@employee), class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    Back to <%= @employee.full_name %>
  <% end %>

  <h1 class="page-title mb-6">Edit Employee</h1>

  <%= render "form", employee: @employee %>
</div>
