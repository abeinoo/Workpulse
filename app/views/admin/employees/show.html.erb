<% content_for :title, "#{@employee.full_name} — WorkPulse" %>

<div class="form-page">
  <%= link_to admin_employees_path, class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    Back to Employees
  <% end %>

  <div class="card">
    <%# Header %>
    <div class="card-header">
      <div class="employee-cell">
        <div class="avatar" style="width:48px;height:48px;font-size:1rem;">
          <%= @employee.full_name.split.map(&:first).first(2).join.upcase %>
        </div>
        <div>
          <h1 style="font-size:var(--text-xl);margin-bottom:2px;"><%= @employee.full_name %></h1>
          <p style="font-size:var(--text-sm);color:var(--text-2);margin:0;">
            <%= @employee.job_title.presence || "No title" %>
            <% if @employee.department.present? %>&nbsp;·&nbsp;<%= @employee.department %><% end %>
          </p>
        </div>
      </div>
      <% badge_class = case @employee.status
           when "active"      then "badge-success"
           when "inactive"    then "badge-neutral"
           when "terminated"  then "badge-danger"
           else "badge-neutral"
         end %>
      <span class="badge <%= badge_class %>"><%= @employee.status.humanize %></span>
    </div>

    <%# Details grid %>
    <dl class="data-list">
      <div class="data-list__item">
        <dt class="data-list__label">Phone</dt>
        <dd class="data-list__value"><%= @employee.phone_number.presence || "—" %></dd>
      </div>
      <div class="data-list__item">
        <dt class="data-list__label">Email</dt>
        <dd class="data-list__value"><%= @employee.email.presence || "—" %></dd>
      </div>
      <div class="data-list__item">
        <dt class="data-list__label">Employee #</dt>
        <dd class="data-list__value"><%= @employee.employee_number.presence || "—" %></dd>
      </div>
      <div class="data-list__item">
        <dt class="data-list__label">Hire Date</dt>
        <dd class="data-list__value">
          <%= @employee.hire_date&.strftime("%B %-d, %Y") || "—" %>
        </dd>
      </div>
      <div class="data-list__item">
        <dt class="data-list__label">Manager</dt>
        <dd class="data-list__value"><%= @employee.manager&.full_name || "None" %></dd>
      </div>
      <div class="data-list__item">
        <dt class="data-list__label">Account</dt>
        <dd class="data-list__value">
          <% if @employee.user %>
            <span class="badge badge-accent">Registered</span>
          <% else %>
            <span class="badge badge-warning">Pending registration</span>
          <% end %>
        </dd>
      </div>
    </dl>

    <div class="form-actions">
      <%= link_to "Edit Employee", edit_admin_employee_path(@employee), class: "btn btn-primary" %>
      <%= button_to "Delete",
            admin_employee_path(@employee),
            method: :delete,
            data: { turbo_confirm: "Delete #{@employee.full_name}? This cannot be undone." },
            class: "btn btn-danger" %>
    </div>
  </div>
</div>
