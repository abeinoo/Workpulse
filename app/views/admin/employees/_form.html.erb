<%= form_with model: [:admin, employee], class: "form-card" do |f| %>

  <%= render "users/shared/error_messages", resource: employee %>

  <div class="form-grid">
    <div class="form-group">
      <%= f.label :full_name, class: "form-label" %>
      <%= f.text_field :full_name,
            class: "form-control #{'is-error' if employee.errors[:full_name].any?}",
            placeholder: "Jane Smith" %>
    </div>

    <div class="form-group">
      <%= f.label :employee_number, "Employee #", class: "form-label" %>
      <%= f.text_field :employee_number,
            class: "form-control",
            placeholder: "EMP-001" %>
    </div>

    <div class="form-group">
      <%= f.label :phone_number, class: "form-label" %>
      <%= f.text_field :phone_number,
            class: "form-control #{'is-error' if employee.errors[:phone_number].any?}",
            placeholder: "+966500000000" %>
    </div>

    <div class="form-group">
      <%= f.label :email, class: "form-label" %>
      <%= f.email_field :email,
            class: "form-control #{'is-error' if employee.errors[:email].any?}",
            placeholder: "jane@example.com" %>
    </div>

    <div class="form-group">
      <%= f.label :department, class: "form-label" %>
      <%= f.text_field :department,
            class: "form-control",
            placeholder: "e.g. Operations" %>
    </div>

    <div class="form-group">
      <%= f.label :job_title, class: "form-label" %>
      <%= f.text_field :job_title,
            class: "form-control",
            placeholder: "e.g. Senior Stylist" %>
    </div>

    <div class="form-group">
      <%= f.label :hire_date, class: "form-label" %>
      <%= f.date_field :hire_date, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :status, class: "form-label" %>
      <%= f.select :status,
            Employee.statuses.keys.map { |s| [s.humanize, s] },
            {},
            class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :manager_id, "Manager", class: "form-label" %>
      <%= f.collection_select :manager_id,
            Employee.order(:full_name),
            :id,
            :full_name,
            { include_blank: "None" },
            class: "form-control" %>
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_employees_path, class: "btn btn-ghost" %>
  </div>

<% end %>
