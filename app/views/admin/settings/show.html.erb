<% content_for :title, t("admin.settings.page_title") %>

<div class="admin-page">

  <div class="page-header">
    <div>
      <h1 class="page-title"><%= t("admin.settings.title") %></h1>
      <p class="page-subtitle"><%= @business.name %></p>
    </div>
  </div>

  <%= form_with model: @business, url: admin_settings_path, method: :patch, class: "form-card" do |f| %>

    <%= render "shared/error_messages", object: @business %>

    <%# ── Language ─────────────────────────────────────────────────── %>
    <h2 class="section-title"><%= t("admin.settings.sections.language") %></h2>

    <div class="form-grid">
      <div class="form-group">
        <%= f.label :default_locale, t("admin.settings.default_locale_label"), class: "form-label" %>
        <%= f.select :default_locale,
              I18n.available_locales.map { |l| [t("locale.#{l}"), l] },
              {},
              class: "form-control #{'is-error' if @business.errors[:default_locale].any?}" %>
        <p class="form-hint"><%= t("admin.settings.default_locale_hint") %></p>
      </div>
    </div>

    <div class="divider"></div>

    <%# ── Localization ──────────────────────────────────────────────── %>
    <h2 class="section-title"><%= t("admin.settings.sections.localization") %></h2>

    <div class="form-grid">
      <div class="form-group" style="grid-column: 1 / -1;">
        <%= f.label :timezone, t("admin.settings.timezone_label"), class: "form-label" %>
        <%= f.select :timezone,
              timezone_select_options(@business.timezone),
              {},
              class: "form-control #{'is-error' if @business.errors[:timezone].any?}" %>
        <p class="form-hint"><%= t("admin.settings.timezone_hint") %></p>
      </div>
    </div>

    <div class="divider"></div>

    <%# ── Attendance ────────────────────────────────────────────────── %>
    <h2 class="section-title"><%= t("admin.settings.sections.attendance") %></h2>

    <div class="form-grid">
      <div class="form-group">
        <%= f.label :business_day_start_hour, t("admin.settings.business_day_label"), class: "form-label" %>
        <%= f.select :business_day_start_hour,
              (0..23).map { |h| [format("%02d:00 %s", h % 12 == 0 ? 12 : h % 12, h < 12 ? "AM" : "PM"), h] },
              {},
              class: "form-control #{'is-error' if @business.errors[:business_day_start_hour].any?}" %>
        <p class="form-hint"><%= t("admin.settings.business_day_hint") %></p>
      </div>
    </div>

    <div class="divider"></div>

    <%# ── Payroll ────────────────────────────────────────────────────── %>
    <h2 class="section-title"><%= t("admin.settings.sections.payroll") %></h2>

    <div class="form-grid">
      <div class="form-group">
        <%= f.label :currency, t("admin.settings.currency_label"), class: "form-label" %>
        <%= f.select :currency,
              Business::CURRENCIES.map { |code, info| ["#{info[:name]} (#{code})", code] },
              {},
              class: "form-control #{'is-error' if @business.errors[:currency].any?}" %>
        <p class="form-hint"><%= t("admin.settings.currency_hint") %></p>
      </div>
      <div class="form-group">
        <%= f.label :working_days_per_month, t("admin.settings.working_days_label"), class: "form-label" %>
        <%= f.number_field :working_days_per_month,
              class: "form-control #{'is-error' if @business.errors[:working_days_per_month].any?}",
              min: 1,
              max: 31,
              placeholder: "22" %>
        <p class="form-hint"><%= t("admin.settings.working_days_hint") %></p>
      </div>
      <div class="form-group">
        <%= f.label :max_salary_advance_percentage, t("admin.settings.max_advance_percentage_label"), class: "form-label" %>
        <%= f.number_field :max_salary_advance_percentage,
              class: "form-control #{'is-error' if @business.errors[:max_salary_advance_percentage].any?}",
              min: 1,
              max: 100,
              step: "0.01",
              placeholder: t("admin.settings.max_advance_percentage_placeholder") %>
        <p class="form-hint"><%= t("admin.settings.max_advance_percentage_hint") %></p>
      </div>
    </div>

    <div class="form-actions">
      <%= f.submit t("admin.settings.save"), class: "btn btn-primary" %>
    </div>

  <% end %>

</div>
