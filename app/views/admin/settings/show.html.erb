<% content_for :title, t("admin.settings.page_title") %>

<div class="admin-page">

  <div class="page-header">
    <div>
      <h1 class="page-title"><%= t("admin.settings.title") %></h1>
      <p class="page-subtitle"><%= @business.name %></p>
    </div>
  </div>

  <%= form_with model: @business, url: admin_settings_path, method: :patch,
                multipart: true, class: "form-card" do |f| %>

    <%= render "shared/error_messages", object: @business %>

    <%# ── Language ─────────────────────────────────────────────────── %>
    <h2 class="section-title"><%= t("admin.settings.sections.language") %></h2>

    <div class="form-grid">
      <div class="form-group">
        <%= f.label :default_locale, t("admin.settings.default_locale_label"), class: "form-label" %>
        <%= f.select :default_locale,
              I18n.available_locales.map { |l| [t("locale.#{l}"), l] },
              {},
              class: "form-control #{'is-error' if @business.errors[:default_locale].any?}" %>
        <p class="form-hint"><%= t("admin.settings.default_locale_hint") %></p>
      </div>
    </div>

    <div class="divider"></div>

    <%# ── Localization ──────────────────────────────────────────────── %>
    <h2 class="section-title"><%= t("admin.settings.sections.localization") %></h2>

    <div class="form-grid">
      <div class="form-group" style="grid-column: 1 / -1;">
        <%= f.label :timezone, t("admin.settings.timezone_label"), class: "form-label" %>
        <%= f.select :timezone,
              timezone_select_options(@business.timezone),
              {},
              class: "form-control #{'is-error' if @business.errors[:timezone].any?}" %>
        <p class="form-hint"><%= t("admin.settings.timezone_hint") %></p>
      </div>
    </div>

    <div class="divider"></div>

    <%# ── Attendance ────────────────────────────────────────────────── %>
    <h2 class="section-title"><%= t("admin.settings.sections.attendance") %></h2>

    <div class="form-grid">
      <div class="form-group">
        <%= f.label :business_day_start_hour, t("admin.settings.business_day_label"), class: "form-label" %>
        <%= f.select :business_day_start_hour,
              (0..23).map { |h| [format("%02d:00 %s", h % 12 == 0 ? 12 : h % 12, h < 12 ? "AM" : "PM"), h] },
              {},
              class: "form-control #{'is-error' if @business.errors[:business_day_start_hour].any?}" %>
        <p class="form-hint"><%= t("admin.settings.business_day_hint") %></p>
      </div>

      <div class="form-group">
        <%= f.label :overtime_grace_minutes, t("admin.settings.overtime_grace_label"), class: "form-label" %>
        <div class="input-with-suffix">
          <%= f.number_field :overtime_grace_minutes,
                class: "form-control #{'is-error' if @business.errors[:overtime_grace_minutes].any?}",
                min: 0,
                max: 480,
                step: 1,
                placeholder: "0" %>
          <span class="input-suffix"><%= t("admin.settings.overtime_grace_suffix") %></span>
        </div>
        <p class="form-hint"><%= t("admin.settings.overtime_grace_hint") %></p>
        <% if @business.errors[:overtime_grace_minutes].any? %>
          <p class="form-error"><%= @business.errors[:overtime_grace_minutes].first %></p>
        <% end %>
      </div>
    </div>

    <div class="divider"></div>

    <%# ── Payroll ────────────────────────────────────────────────────── %>
    <h2 class="section-title"><%= t("admin.settings.sections.payroll") %></h2>

    <div class="form-grid">
      <div class="form-group">
        <%= f.label :currency, t("admin.settings.currency_label"), class: "form-label" %>
        <%= f.select :currency,
              Business::CURRENCIES.map { |code, info| ["#{info[:name]} (#{code})", code] },
              {},
              class: "form-control #{'is-error' if @business.errors[:currency].any?}" %>
        <p class="form-hint"><%= t("admin.settings.currency_hint") %></p>
      </div>
      <div class="form-group">
        <%= f.label :working_days_per_month, t("admin.settings.working_days_label"), class: "form-label" %>
        <%= f.number_field :working_days_per_month,
              class: "form-control #{'is-error' if @business.errors[:working_days_per_month].any?}",
              min: 1,
              max: 31,
              placeholder: "22" %>
        <p class="form-hint"><%= t("admin.settings.working_days_hint") %></p>
      </div>
      <div class="form-group">
        <%= f.label :max_salary_advance_percentage, t("admin.settings.max_advance_percentage_label"), class: "form-label" %>
        <%= f.number_field :max_salary_advance_percentage,
              class: "form-control #{'is-error' if @business.errors[:max_salary_advance_percentage].any?}",
              min: 1,
              max: 100,
              step: "0.01",
              placeholder: t("admin.settings.max_advance_percentage_placeholder") %>
        <p class="form-hint"><%= t("admin.settings.max_advance_percentage_hint") %></p>
      </div>
    </div>

    <div class="divider"></div>

    <%# ── Automation ─────────────────────────────────────────────────────── %>
    <h2 class="section-title"><%= t("admin.settings.sections.automation") %></h2>

    <div class="settings-info-box">
      <p class="form-hint"><%= t("admin.settings.auto_payroll_info") %></p>
    </div>

    <div class="form-grid">
      <div class="form-group">
        <%= f.label :payroll_auto_generate_day, t("admin.settings.auto_generate_day_label"), class: "form-label" %>
        <%= f.select :payroll_auto_generate_day,
              [[t("admin.settings.auto_generate_disabled"), nil]] +
              (1..28).map { |d| [t("admin.settings.auto_generate_day_option", day: d), d] },
              {},
              class: "form-control #{'is-error' if @business.errors[:payroll_auto_generate_day].any?}" %>
        <p class="form-hint"><%= t("admin.settings.auto_generate_day_hint") %></p>
        <% if @business.errors[:payroll_auto_generate_day].any? %>
          <p class="form-error"><%= @business.errors[:payroll_auto_generate_day].first %></p>
        <% end %>
      </div>

      <div class="form-group">
        <%= f.label :payroll_cutoff_day, t("admin.settings.payroll_cutoff_day_label"), class: "form-label" %>
        <%= f.select :payroll_cutoff_day,
              [[t("admin.settings.cutoff_end_of_month"), 0]] +
              (1..28).map { |d| [t("admin.settings.cutoff_day_option", day: d), d] },
              {},
              class: "form-control #{'is-error' if @business.errors[:payroll_cutoff_day].any?}" %>
        <p class="form-hint"><%= t("admin.settings.payroll_cutoff_day_hint") %></p>
      </div>
    </div>

    <div class="divider"></div>

    <%# ── Employee Numbering ────────────────────────────────────────────── %>
    <h2 class="section-title"><%= t("admin.settings.sections.employee_numbering") %></h2>

    <div class="settings-info-box">
      <p class="form-hint"><%= t("admin.settings.employee_code_start_info") %></p>
    </div>

    <div class="form-grid">
      <div class="form-group">
        <%= f.label :employee_code_start, t("admin.settings.employee_code_start_label"), class: "form-label" %>
        <%= f.number_field :employee_code_start,
              class: "form-control #{'is-error' if @business.errors[:employee_code_start].any?}",
              min: 1,
              step: 1,
              placeholder: "1" %>
        <p class="form-hint"><%= t("admin.settings.employee_code_start_hint") %></p>
        <% if @business.errors[:employee_code_start].any? %>
          <p class="form-error"><%= @business.errors[:employee_code_start].first %></p>
        <% end %>
      </div>
    </div>

    <div class="divider"></div>

    <%# ── Branding ────────────────────────────────────────────────────── %>
    <h2 class="section-title"><%= t("admin.settings.sections.branding") %></h2>

    <div class="form-grid">
      <%# Logo upload %>
      <div class="form-group">
        <%= f.label :logo, t("admin.settings.logo_label"), class: "form-label" %>

        <div class="upload-field" data-controller="image-upload">
          <div class="upload-field__preview">
            <% logo_src = @business.logo.attached? ? logo_url(@business, size: :thumb) : nil %>
            <img src="<%= logo_src %>"
                 class="logo-img logo-img--thumb"
                 alt=""
                 data-image-upload-target="img"
                 <%= "hidden" unless logo_src %>>
            <div class="avatar avatar-placeholder"
                 data-image-upload-target="placeholder"
                 <%= "hidden" if logo_src %>>
              <%= @business.name.first(2).upcase %>
            </div>

            <div class="upload-field__controls">
              <label class="btn btn-ghost btn-sm upload-field__choose">
                <%= t("forms.choose_image") %>
                <%= f.file_field :logo,
                      accept: "image/png,image/jpeg,image/webp,image/svg+xml",
                      class: "upload-field__input",
                      data: { "image-upload-target": "input", action: "change->image-upload#change" } %>
              </label>
              <button type="button"
                      class="btn btn-ghost btn-sm text-danger"
                      data-image-upload-target="removeBtn"
                      data-action="image-upload#remove"
                      <%= "hidden" unless @business.logo.attached? %>>
                <%= t("forms.remove_image") %>
              </button>
              <%= f.hidden_field :remove_logo, value: "0",
                    data: { "image-upload-target": "removeFlag" } %>
            </div>
          </div>
          <p class="upload-field__hint"><%= t("admin.settings.logo_hint") %></p>
        </div>
      </div>

      <%# Stamp image upload %>
      <div class="form-group">
        <%= f.label :stamp_image, t("admin.settings.stamp_label"), class: "form-label" %>

        <div class="upload-field" data-controller="image-upload">
          <div class="upload-field__preview">
            <% stamp_src = @business.stamp_image.attached? ? stamp_image_url(@business, size: :thumb) : nil %>
            <img src="<%= stamp_src %>"
                 class="logo-img logo-img--thumb"
                 alt=""
                 data-image-upload-target="img"
                 <%= "hidden" unless stamp_src %>>
            <div class="upload-field__doc-placeholder"
                 data-image-upload-target="placeholder"
                 <%= "hidden" if stamp_src %>>
              &#9993;
            </div>

            <div class="upload-field__controls">
              <label class="btn btn-ghost btn-sm upload-field__choose">
                <%= t("forms.choose_image") %>
                <%= f.file_field :stamp_image,
                      accept: "image/png,image/jpeg,image/webp",
                      class: "upload-field__input",
                      data: { "image-upload-target": "input", action: "change->image-upload#change" } %>
              </label>
              <button type="button"
                      class="btn btn-ghost btn-sm text-danger"
                      data-image-upload-target="removeBtn"
                      data-action="image-upload#remove"
                      <%= "hidden" unless @business.stamp_image.attached? %>>
                <%= t("forms.remove_image") %>
              </button>
              <%= f.hidden_field :remove_stamp_image, value: "0",
                    data: { "image-upload-target": "removeFlag" } %>
            </div>
          </div>
          <p class="upload-field__hint"><%= t("admin.settings.stamp_hint") %></p>
        </div>
      </div>
    </div>

    <div class="form-actions">
      <%= f.submit t("admin.settings.save"), class: "btn btn-primary" %>
    </div>

  <% end %>

</div>
