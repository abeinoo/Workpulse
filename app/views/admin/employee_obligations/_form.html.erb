<%= form_with model: [:admin, @obligation], class: "form-card",
      data: { controller: "obligation-form" } do |f| %>

  <%= render "users/shared/error_messages", resource: @obligation %>

  <div class="form-grid">
    <div class="form-group">
      <%= f.label :user_id, t("admin.employee_obligations.employee"), class: "form-label" %>
      <%= f.select :user_id,
            @employees.map { |u| [u.full_name, u.id] },
            { prompt: t("forms.select") },
            class: "form-control #{'is-error' if @obligation.errors[:user_id].any?}" %>
    </div>

    <div class="form-group">
      <%= f.label :obligation_type, t("admin.employee_obligations.type"), class: "form-label" %>
      <%= f.select :obligation_type,
            EmployeeObligation::OBLIGATION_TYPES.map { |t_| [t("admin.employee_obligations.obligation_types.#{t_}"), t_] },
            {},
            class: "form-control #{'is-error' if @obligation.errors[:obligation_type].any?}" %>
    </div>

    <div class="form-group form-group--wide">
      <%= f.label :title, t("admin.employee_obligations.title_label"), class: "form-label" %>
      <%= f.text_field :title,
            class: "form-control #{'is-error' if @obligation.errors[:title].any?}",
            placeholder: t("admin.employee_obligations.title_placeholder") %>
    </div>

    <div class="form-group">
      <%= f.label :total_amount, t("admin.employee_obligations.total"), class: "form-label" %>
      <%= f.number_field :total_amount,
            class: "form-control #{'is-error' if @obligation.errors[:total_amount].any?}",
            min: 0.01, step: "0.01", placeholder: "5000.00",
            data: { obligation_form_target: "total", action: "input->obligation-form#calculate" } %>
    </div>

    <div class="form-group">
      <%= f.label :installment_amount, t("admin.employee_obligations.installment"), class: "form-label" %>
      <%= f.number_field :installment_amount,
            class: "form-control #{'is-error' if @obligation.errors[:installment_amount].any?}",
            min: 0.01, step: "0.01", placeholder: "500.00",
            data: { obligation_form_target: "installment", action: "input->obligation-form#calculate" } %>
      <p class="form-hint">
        <%= t("admin.employee_obligations.installment_hint") %> &mdash;
        <span data-obligation-form-target="preview" class="text-muted">
          <% if @obligation.installments_count.to_i > 0 %>
            <% if @obligation.even_installments? %>
              <%= @obligation.installments_count %> <%= t("admin.employee_obligations.installments_count_unit") %>
            <% else %>
              <%= @obligation.full_installments_count %> &times; <%= number_with_precision(@obligation.installment_amount, precision: 2) %> + <%= t("admin.employee_obligations.final_installment") %>: <%= number_with_precision(@obligation.final_installment_amount, precision: 2) %>
            <% end %>
          <% else %>
            —
          <% end %>
        </span>
      </p>
      <% if @obligation.errors[:installments_count].any? %>
        <p class="form-error-message"><%= @obligation.errors[:installments_count].first %></p>
      <% end %>
    </div>

    <div class="form-group">
      <%= f.label :start_month, t("admin.employee_obligations.start_period"), class: "form-label" %>
      <div style="display:flex;gap:var(--space-2);">
        <%= f.select :start_month,
              (1..12).map { |m| [I18n.t("date.month_names")[m], m] },
              { selected: @obligation.start_month },
              class: "form-control",
              data: { obligation_form_target: "startMonth", action: "change->obligation-form#calculate" } %>
        <%= f.number_field :start_year,
              class: "form-control",
              min: 2020, max: 2099, placeholder: Date.current.year,
              data: { obligation_form_target: "startYear", action: "input->obligation-form#calculate" } %>
      </div>
    </div>

    <div class="form-group">
      <%= f.label :end_month, class: "form-label" do %>
        <%= t("admin.employee_obligations.end_period") %>
        <span class="form-label__optional"><%= t("forms.optional") %></span>
      <% end %>
      <div style="display:flex;gap:var(--space-2);">
        <%= f.select :end_month,
              [["—", ""]] + (1..12).map { |m| [I18n.t("date.month_names")[m], m] },
              { selected: @obligation.end_month },
              class: "form-control" %>
        <%= f.number_field :end_year,
              class: "form-control",
              min: 2020, max: 2099, placeholder: "—",
              value: @obligation.end_year %>
      </div>
      <p class="form-hint"><%= t("admin.employee_obligations.end_period_hint") %></p>
    </div>

    <div class="form-group form-group--wide">
      <%= f.label :description, class: "form-label" do %>
        <%= t("admin.employee_obligations.description") %>
        <span class="form-label__optional"><%= t("forms.optional") %></span>
      <% end %>
      <%= f.text_area :description,
            class: "form-control #{'is-error' if @obligation.errors[:description].any?}",
            rows: 3 %>
    </div>

    <div class="form-group form-group--wide">
      <%= f.label :notes, class: "form-label" do %>
        <%= t("admin.employee_obligations.notes") %>
        <span class="form-label__optional"><%= t("forms.optional") %></span>
      <% end %>
      <%= f.text_area :notes,
            class: "form-control",
            rows: 2 %>
    </div>

    <div class="form-group">
      <div class="form-check">
        <%= f.check_box :auto_deduct, class: "form-check__input" %>
        <%= f.label :auto_deduct, t("admin.employee_obligations.auto_deduct_label"), class: "form-check__label" %>
      </div>
      <p class="form-hint"><%= t("admin.employee_obligations.auto_deduct_hint") %></p>
    </div>
  </div>

  <div data-obligation-form-target="scheduleSection"
       style="display:none;margin-top:var(--space-5);border-top:1px solid var(--border);padding-top:var(--space-4);">
    <h4 style="font-size:var(--text-sm);font-weight:600;color:var(--text-2);text-transform:uppercase;letter-spacing:.05em;margin-bottom:var(--space-3);">
      <%= t("admin.employee_obligations.payment_schedule") %>
    </h4>
    <div class="table-wrap" style="max-height:240px;overflow-y:auto;">
      <table>
        <thead>
          <tr>
            <th><%= t("admin.employee_obligations.schedule_month") %></th>
            <th><%= t("admin.employee_obligations.schedule_amount") %></th>
          </tr>
        </thead>
        <tbody data-obligation-form-target="schedule"
               data-final-label="<%= t('admin.employee_obligations.final_installment') %>"></tbody>
      </table>
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit f.object.persisted? ? t("admin.employee_obligations.edit.submit") : t("admin.employee_obligations.new.submit"), class: "btn btn-primary" %>
    <%= link_to t("forms.cancel"), admin_employee_obligations_path, class: "btn btn-ghost" %>
  </div>

<% end %>
