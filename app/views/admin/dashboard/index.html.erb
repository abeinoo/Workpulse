<div class="admin-page">

  <div class="page-header">
    <h1 class="page-title"><%= t("admin.dashboard.title") %></h1>
    <p class="page-subtitle"><%= current_user.business.name %></p>
  </div>

  <div class="stats-grid">
    <div class="stat-card">
      <p class="stat-card__label"><%= t("dashboard.stats.employees") %></p>
      <p class="stat-card__value"><%= @stats[:employees] %></p>
    </div>
    <div class="stat-card">
      <p class="stat-card__label"><%= t("dashboard.stats.active_branches") %></p>
      <p class="stat-card__value"><%= @stats[:branches] %></p>
    </div>
    <div class="stat-card">
      <p class="stat-card__label"><%= t("dashboard.stats.pending_requests") %></p>
      <p class="stat-card__value <%= @stats[:pending_requests] > 0 ? 'stat-card__value--warning' : '' %>">
        <%= @stats[:pending_requests] %>
      </p>
    </div>
    <div class="stat-card">
      <p class="stat-card__label"><%= t("admin.dashboard.active_shifts") %></p>
      <p class="stat-card__value"><%= @stats[:active_shifts] %></p>
    </div>
  </div>

  <div class="dashboard-cols">

    <% if @recent_payroll_periods.any? %>
      <div class="dashboard-section">
        <div class="dashboard-section__header">
          <h2 class="dashboard-section__title"><%= t("admin.dashboard.recent_payroll") %></h2>
          <%= link_to t("admin.dashboard.view_all"), admin_payroll_periods_path, class: "link-muted" %>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th><%= t("payroll.period") %></th>
                <th><%= t("payroll.branch") %></th>
                <th><%= t("payroll.status") %></th>
              </tr>
            </thead>
            <tbody>
              <% @recent_payroll_periods.each do |period| %>
                <tr>
                  <td><%= link_to period.period_label, admin_payroll_period_path(period), class: "link" %></td>
                  <td class="td-secondary"><%= period.branch&.name || t("payroll.all_branches") %></td>
                  <td>
                    <span class="badge <%= period.paid? ? 'badge-success' : period.finalized? ? 'badge-accent' : 'badge-neutral' %>">
                      <%= period.status.humanize.gsub("_", " ") %>
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <div class="dashboard-section">
      <div class="dashboard-section__header">
        <h2 class="dashboard-section__title"><%= t("admin.dashboard.recent_employees") %></h2>
        <%= link_to t("admin.dashboard.view_all"), admin_users_path, class: "link-muted" %>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th><%= t("admin.users.name") %></th>
              <th><%= t("admin.users.role") %></th>
              <th><%= t("admin.users.status") %></th>
            </tr>
          </thead>
          <tbody>
            <% @recent_employees.each do |user| %>
              <tr>
                <td><%= link_to user.full_name, admin_user_path(user), class: "link" %></td>
                <td class="td-secondary"><%= user.role.humanize %></td>
                <td>
                  <span class="badge <%= user.active? ? 'badge-success' : 'badge-neutral' %>">
                    <%= user.active? ? t("admin.users.active") : t("admin.users.inactive") %>
                  </span>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <div class="quick-links">
    <%= link_to admin_users_path, class: "admin-quick-link" do %>
      <div>
        <p class="admin-quick-link__label"><%= t("admin.dashboard.manage_employees") %></p>
        <p class="admin-quick-link__sub"><%= t("admin.dashboard.manage_employees_sub") %></p>
      </div>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    <% end %>

    <%= link_to admin_branches_path, class: "admin-quick-link" do %>
      <div>
        <p class="admin-quick-link__label"><%= t("admin.dashboard.branches_link") %></p>
        <p class="admin-quick-link__sub"><%= t("admin.dashboard.branches_sub") %></p>
      </div>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    <% end %>

    <%= link_to admin_shifts_path, class: "admin-quick-link" do %>
      <div>
        <p class="admin-quick-link__label"><%= t("admin.dashboard.shifts_schedules") %></p>
        <p class="admin-quick-link__sub"><%= t("admin.dashboard.shifts_schedules_sub") %></p>
      </div>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    <% end %>

    <%= link_to admin_attendance_records_path, class: "admin-quick-link" do %>
      <div>
        <p class="admin-quick-link__label"><%= t("admin.dashboard.attendance_records") %></p>
        <p class="admin-quick-link__sub"><%= t("admin.dashboard.attendance_records_sub") %></p>
      </div>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    <% end %>
  </div>

</div>
