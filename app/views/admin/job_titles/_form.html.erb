<%= form_with model: [:admin, job_title], class: "form-card" do |f| %>
  <%= render "shared/error_messages", object: job_title %>

  <div class="form-grid">
    <div class="form-group" style="grid-column: 1 / -1;">
      <%= f.label :name, t("admin.job_titles.name"), class: "form-label" %>
      <%= f.text_field :name, class: "form-control #{'is-error' if job_title.errors[:name].any?}",
            placeholder: t("admin.job_titles.name_placeholder") %>
      <% if job_title.persisted? %>
        <p class="form-hint"><%= t("admin.job_titles.rename_hint") %></p>
      <% end %>
    </div>

    <div class="form-group" style="grid-column: 1 / -1;">
      <label class="form-check">
        <%= f.check_box :active %>
        <span><%= t("admin.job_titles.active_label") %></span>
      </label>
      <p class="form-hint"><%= t("admin.job_titles.active_hint") %></p>
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit t("common.save"), class: "btn btn-primary" %>
    <%= link_to t("common.cancel"), admin_job_titles_path, class: "btn btn-ghost" %>
  </div>
<% end %>
