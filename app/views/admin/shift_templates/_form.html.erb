<%= form_with model: [:admin, template],
             class: "form-card",
             data: { controller: "template-entry-form" } do |f| %>

  <%= render "shared/error_messages", resource: template %>

  <%# ── Template meta ── %>
  <div class="form-grid">
    <div class="form-group">
      <%= f.label :name, t("shift_templates.form.name"), class: "form-label form-label--required" %>
      <%= f.text_field :name,
            class: "form-control #{'is-error' if template.errors[:name].any?}",
            placeholder: t("shift_templates.form.name_placeholder") %>
    </div>

    <div class="form-group">
      <%= f.label :description, t("shift_templates.form.description"), class: "form-label" %>
      <%= f.text_area :description,
            class: "form-control",
            rows: 2,
            placeholder: t("shift_templates.form.description_placeholder") %>
    </div>
  </div>

  <div class="divider"></div>

  <%# ── Entries ── %>
  <div class="entries-section">
    <div class="entries-header">
      <div>
        <h3 class="section-title"><%= t("shift_templates.form.entries_section") %></h3>
        <p class="form-hint"><%= t("shift_templates.form.entries_hint") %></p>
        <p class="form-hint" style="margin-top:var(--space-1);">
          <%= t("shift_templates.form.entries_concept_note") %>
        </p>
      </div>
      <button type="button"
              class="btn btn-ghost btn-sm"
              data-action="click->template-entry-form#addEntry">
        <%= t("shift_templates.form.add_entry") %>
      </button>
    </div>

    <%# Column headers %>
    <div class="entry-row-headers" aria-hidden="true">
      <span><%= t("shift_templates.form.starts_on") %></span>
      <span><%= t("shift_templates.form.ends_on") %></span>
      <span><%= t("shift_templates.form.shift") %></span>
      <span><%= t("shift_templates.form.rule_profile") %></span>
      <span></span>
    </div>

    <%# Existing entries %>
    <div data-template-entry-form-target="entriesContainer">
      <% template.entries.each do |entry| %>
        <%= f.fields_for :entries, entry do |ef| %>
          <div class="entry-row" data-entry-row>
            <%= ef.hidden_field :id %>
            <%= ef.hidden_field :_destroy, value: "0", data: { destroy_field: true } %>

            <div class="form-group mb-0">
              <label class="form-label form-label--mobile-only form-label--required"><%= t("shift_templates.form.starts_on") %></label>
              <%= ef.date_field :starts_on,
                    class: "form-control #{'is-error' if entry.errors[:starts_on].any?}",
                    required: true %>
            </div>

            <div class="form-group mb-0">
              <label class="form-label form-label--mobile-only"><%= t("shift_templates.form.ends_on") %></label>
              <%= ef.date_field :ends_on,
                    class: "form-control" %>
            </div>

            <div class="form-group mb-0">
              <label class="form-label form-label--mobile-only"><%= t("shift_templates.form.shift") %></label>
              <%= ef.select :shift_id,
                    @shifts.map { |s| [s.name, s.id] },
                    { include_blank: t("forms.select") },
                    class: "form-control #{'is-error' if entry.errors[:shift_id].any?}" %>
            </div>

            <div class="form-group mb-0">
              <label class="form-label form-label--mobile-only"><%= t("shift_templates.form.rule_profile") %></label>
              <%= ef.select :shift_rule_profile_id,
                    @rule_profiles.map { |p| [p.name, p.id] },
                    { include_blank: t("shift_templates.form.no_rule_profile") },
                    class: "form-control" %>
            </div>

            <button type="button"
                    class="btn-rule-remove"
                    data-action="click->template-entry-form#removeEntry"
                    aria-label="<%= t('shift_templates.form.remove_entry') %>">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          </div>
        <% end %>
      <% end %>
    </div>

    <p class="penalty-rules-empty text-muted"
       data-template-entry-form-target="emptyState"
       <%= template.entries.any? ? 'hidden' : '' %>>
      <%= t("shift_templates.form.no_entries") %>
    </p>

    <%# Template for new rows (injected via Stimulus) %>
    <template data-template-entry-form-target="template">
      <div class="entry-row" data-entry-row>
        <div class="form-group mb-0">
          <label class="form-label form-label--mobile-only form-label--required"><%= t("shift_templates.form.starts_on") %></label>
          <input type="date"
                 name="shift_template[entries_attributes][NEW_INDEX][starts_on]"
                 class="form-control"
                 required>
        </div>

        <div class="form-group mb-0">
          <label class="form-label form-label--mobile-only"><%= t("shift_templates.form.ends_on") %></label>
          <input type="date"
                 name="shift_template[entries_attributes][NEW_INDEX][ends_on]"
                 class="form-control">
        </div>

        <div class="form-group mb-0">
          <label class="form-label form-label--mobile-only"><%= t("shift_templates.form.shift") %></label>
          <select name="shift_template[entries_attributes][NEW_INDEX][shift_id]" class="form-control">
            <option value=""><%= t("forms.select") %></option>
            <% @shifts.each do |s| %>
              <option value="<%= s.id %>"><%= s.name %></option>
            <% end %>
          </select>
        </div>

        <div class="form-group mb-0">
          <label class="form-label form-label--mobile-only"><%= t("shift_templates.form.rule_profile") %></label>
          <select name="shift_template[entries_attributes][NEW_INDEX][shift_rule_profile_id]" class="form-control">
            <option value=""><%= t("shift_templates.form.no_rule_profile") %></option>
            <% @rule_profiles.each do |p| %>
              <option value="<%= p.id %>"><%= p.name %></option>
            <% end %>
          </select>
        </div>

        <button type="button"
                class="btn-rule-remove"
                data-action="click->template-entry-form#removeEntry"
                aria-label="<%= t('shift_templates.form.remove_entry') %>">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </template>
  </div>

  <div class="form-actions">
    <%= f.submit(template.persisted? ? t("shift_templates.form.submit_update") : t("shift_templates.form.submit_create"),
                 class: "btn btn-primary") %>
    <%= link_to t("forms.cancel"), admin_shift_templates_path, class: "btn btn-ghost" %>
  </div>

<% end %>
