<div class="admin-page">

  <div class="page-header">
    <div>
      <%= link_to @period.period_label, admin_payroll_period_path(@period), class: "back-link" %>
      <h1 class="page-title"><%= @entry.user.full_name %></h1>
      <p class="page-subtitle"><%= @period.period_label %> &middot; <%= @period.branch&.name || t("payroll.all_branches") %></p>
    </div>
    <span class="badge <%= period_status_badge_class(@period) %>">
      <%= @period.status.humanize %>
    </span>
  </div>

  <%# Salary Summary %>
  <div class="card" style="margin-bottom: 1.5rem;">
    <div class="info-card__row">
      <span class="info-card__label"><%= t("admin.payroll_entries.show.base_salary") %></span>
      <span><%= number_to_currency(@entry.base_salary, unit: "SAR ") %></span>
    </div>
    <% if @entry.total_overtime > 0 %>
      <div class="info-card__row">
        <span class="info-card__label"><%= t("admin.payroll_entries.show.overtime") %></span>
        <span style="color: var(--success);">+ <%= number_to_currency(@entry.total_overtime, unit: "SAR ") %></span>
      </div>
    <% end %>
    <% if @entry.total_bonuses > 0 %>
      <div class="info-card__row">
        <span class="info-card__label"><%= t("admin.payroll_entries.show.bonuses") %></span>
        <span style="color: var(--success);">+ <%= number_to_currency(@entry.total_bonuses, unit: "SAR ") %></span>
      </div>
    <% end %>
    <% if @entry.total_deductions > 0 %>
      <div class="info-card__row">
        <span class="info-card__label"><%= t("admin.payroll_entries.show.deductions") %></span>
        <span style="color: var(--danger);">- <%= number_to_currency(@entry.total_deductions, unit: "SAR ") %></span>
      </div>
    <% end %>
    <% if @entry.advances_deducted > 0 %>
      <div class="info-card__row">
        <span class="info-card__label"><%= t("admin.payroll_entries.show.advance_repayments") %></span>
        <span style="color: var(--danger);">- <%= number_to_currency(@entry.advances_deducted, unit: "SAR ") %></span>
      </div>
    <% end %>
    <div class="info-card__row" style="border-top: 2px solid var(--border); font-weight: 600;">
      <span class="info-card__label"><%= t("admin.payroll_entries.show.net_salary") %></span>
      <span><%= number_to_currency(@entry.net_salary, unit: "SAR ") %></span>
    </div>
  </div>

  <%# Line Items %>
  <% line_items = @entry.payroll_line_items %>
  <% if line_items.any? %>
    <div class="table-wrap table-wrap--cards">
      <table>
        <thead>
          <tr>
            <th><%= t("payroll.entry.type_col") %></th>
            <th><%= t("payroll.entry.description_col") %></th>
            <th><%= t("requests.amount") %></th>
            <th><%= t("payroll.entry.review_status") %></th>
          </tr>
        </thead>
        <tbody>
          <% line_items.each do |item| %>
            <tr>
              <td><%= item.item_type.humanize %></td>
              <td class="td-secondary"><%= item.description.presence || "—" %></td>
              <td style="color: <%= item.deduction? ? 'var(--danger)' : 'var(--success)' %>;">
                <%= item.deduction? ? "- " : "+ " %><%= number_to_currency(item.amount.abs, unit: "SAR ") %>
              </td>
              <td>
                <span class="badge <%= line_item_review_badge_class(item) %>">
                  <%= item.review_status.humanize %>
                </span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="td-secondary" style="text-align: center; padding: 2rem 0;"><%= t("admin.payroll_entries.show.no_line_items") %></p>
  <% end %>

</div>
