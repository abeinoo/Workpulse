<% content_for :title, "Attendance Record — WorkPulse" %>

<% if @record.check_in_latitude.present? %>
  <% content_for :head do %>
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="">
  <% end %>
<% end %>

<div class="form-page">
  <%= link_to admin_attendance_records_path, class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    <%= t("admin.attendance_records.show.back") %>
  <% end %>

  <div class="page-header">
    <div>
      <h1 class="page-title"><%= @record.date.strftime("%B %-d, %Y") %></h1>
      <p class="page-subtitle"><%= @record.user.full_name %> &mdash; <%= @record.branch.name %></p>
    </div>
    <span class="badge <%= @record.present? ? 'badge-success' : @record.late? ? 'badge-warning' : 'badge-neutral' %>">
      <%= t("attendance.statuses.#{@record.status}", default: @record.status.humanize) %>
    </span>
  </div>

  <div class="info-card">
    <div class="info-card__row">
      <span class="info-card__label"><%= t("attendance.check_in_at") %></span>
      <span><%= @record.check_in_at&.strftime("%H:%M") || "—" %></span>
    </div>
    <div class="info-card__row">
      <span class="info-card__label"><%= t("attendance.check_out_at") %></span>
      <span><%= @record.check_out_at&.strftime("%H:%M") || "—" %></span>
    </div>
    <% if @record.worked_minutes %>
      <div class="info-card__row">
        <span class="info-card__label"><%= t("attendance.records.worked") %></span>
        <span><%= @record.worked_minutes / 60 %>h <%= @record.worked_minutes % 60 %>m</span>
      </div>
    <% end %>
    <% if @record.late_minutes > 0 %>
      <div class="info-card__row">
        <span class="info-card__label"><%= t("attendance.records.late_by") %></span>
        <span class="text-warning"><%= @record.late_minutes %> min</span>
      </div>
    <% end %>
    <% if @record.early_leave_minutes > 0 %>
      <div class="info-card__row">
        <span class="info-card__label"><%= t("attendance.records.left_early_by") %></span>
        <span class="text-warning"><%= @record.early_leave_minutes %> min</span>
      </div>
    <% end %>
    <div class="info-card__row">
      <span class="info-card__label"><%= t("attendance.branch") %></span>
      <span><%= @record.branch.name %></span>
    </div>
    <% if @record.check_in_latitude.present? %>
      <div class="info-card__row">
        <span class="info-card__label"><%= t("admin.attendance_records.show.check_in_coords") %></span>
        <span class="td-secondary"><%= @record.check_in_latitude %>, <%= @record.check_in_longitude %></span>
      </div>
    <% end %>
    <% if @record.check_out_latitude.present? %>
      <div class="info-card__row">
        <span class="info-card__label"><%= t("admin.attendance_records.show.check_out_coords") %></span>
        <span class="td-secondary"><%= @record.check_out_latitude %>, <%= @record.check_out_longitude %></span>
      </div>
    <% end %>
  </div>

  <% if @record.check_in_latitude.present? %>
    <% branch = @record.branch %>
    <h2 class="section-title mt-8"><%= t("admin.attendance_records.show.check_in_location") %></h2>
    <div data-controller="location-map"
         data-location-map-has-check-in-value="true"
         data-location-map-check-in-lat-value="<%= @record.check_in_latitude %>"
         data-location-map-check-in-lng-value="<%= @record.check_in_longitude %>"
         <%= @record.check_out_latitude.present? ? 'data-location-map-has-check-out-value="true"' : "" %>
         <%= @record.check_out_latitude.present? ? "data-location-map-check-out-lat-value=\"#{@record.check_out_latitude}\"" : "" %>
         <%= @record.check_out_latitude.present? ? "data-location-map-check-out-lng-value=\"#{@record.check_out_longitude}\"" : "" %>
         <%= branch.latitude.present? ? 'data-location-map-has-branch-value="true"' : "" %>
         <%= branch.latitude.present? ? "data-location-map-branch-lat-value=\"#{branch.latitude}\"" : "" %>
         <%= branch.latitude.present? ? "data-location-map-branch-lng-value=\"#{branch.longitude}\"" : "" %>
         data-location-map-branch-radius-value="<%= branch.radius_meters || 100 %>">
      <div data-location-map-target="container" class="branch-map"></div>
    </div>
    <div class="location-map-legend">
      <span class="loc-legend-item"><span class="loc-marker loc-marker--branch loc-marker--sm">B</span> <%= t("attendance.records.legend_branch") %></span>
      <span class="loc-legend-item"><span class="loc-dot loc-dot--checkin"></span> <%= t("attendance.records.legend_check_in") %></span>
      <% if @record.check_out_latitude.present? %>
        <span class="loc-legend-item"><span class="loc-dot loc-dot--checkout"></span> <%= t("attendance.records.legend_check_out") %></span>
      <% end %>
    </div>
  <% end %>

  <h2 class="section-title mt-8"><%= t("admin.attendance_records.show.edit_record") %></h2>
  <%= form_with model: [:admin, @record], method: :patch, class: "form-card" do |f| %>
    <div class="form-grid">
      <div class="form-group">
        <%= f.label :check_in_at, t("attendance.records.check_in_time"), class: "form-label" %>
        <%= f.datetime_local_field :check_in_at,
              value: @record.check_in_at&.strftime("%Y-%m-%dT%H:%M"),
              class: "form-control" %>
      </div>
      <div class="form-group">
        <%= f.label :check_out_at, t("attendance.records.check_out_time"), class: "form-label" %>
        <%= f.datetime_local_field :check_out_at,
              value: @record.check_out_at&.strftime("%Y-%m-%dT%H:%M"),
              class: "form-control" %>
      </div>
      <div class="form-group">
        <%= f.label :status, t("attendance.status"), class: "form-label" %>
        <%= f.select :status,
              AttendanceRecord.statuses.keys.map { |s| [s.humanize, s] },
              { selected: @record.status },
              class: "form-control" %>
      </div>
    </div>
    <div class="form-actions">
      <%= f.submit t("attendance.records.save_changes"), class: "btn btn-primary" %>
    </div>
  <% end %>

</div>
