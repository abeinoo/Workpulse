<%= form_with model: [:admin, branch], class: "form-card" do |f| %>

  <%= render "shared/error_messages", resource: branch %>

  <%# ── Basic Information ─────────────────────────────────── %>
  <h2 class="section-title"><%= t("admin.branches.form.basic_info") %></h2>

  <div class="form-grid">
    <div class="form-group">
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name,
            class: "form-control #{'is-error' if branch.errors[:name].any?}",
            placeholder: t("admin.branches.form.name_placeholder") %>
    </div>

    <div class="form-group">
      <%= f.label :branch_type, t("admin.branches.form.branch_type"), class: "form-label" %>
      <%= f.select :branch_type,
            Branch.branch_types.keys.map { |type| [ t("admin.branches.branch_types.#{type}"), type ] },
            {},
            class: "form-control #{'is-error' if branch.errors[:branch_type].any?}", required: true %>
      <p class="form-hint"><%= t("admin.branches.form.branch_type_hint") %></p>
    </div>

    <div class="form-group">
      <%= f.label :phone_number, t("admin.branches.form.phone"), class: "form-label" %>
      <%= f.telephone_field :phone_number,
            class: "form-control",
            placeholder: t("admin.branches.form.phone_number_placeholder") %>
    </div>

    <div class="form-group" style="grid-column: 1 / -1;">
      <%= f.label :address, class: "form-label" %>
      <%= f.text_field :address,
            class: "form-control",
            placeholder: t("admin.branches.form.address_placeholder") %>
    </div>
  </div>

  <div class="divider"></div>

  <%# ── Management ─────────────────────────────────────────── %>
  <h2 class="section-title"><%= t("admin.branches.form.management") %></h2>

  <div class="form-grid">
    <div class="form-group">
      <%= f.label :area_manager_id, t("admin.branches.form.area_manager"), class: "form-label" %>
      <%= f.select :area_manager_id,
            options_from_collection_for_select(@area_managers, :id, :full_name, branch.area_manager_id),
            { include_blank: "— #{t('admin.branches.form.unassigned')}" },
            class: "form-control" %>
      <p class="form-hint"><%= t("admin.branches.form.area_manager_hint") %></p>
    </div>

    <div class="form-group">
      <%= f.label :branch_manager_id, t("admin.branches.form.branch_manager"), class: "form-label" %>
      <%= f.select :branch_manager_id,
            options_from_collection_for_select(@managers, :id, :full_name, branch.branch_manager_id),
            { include_blank: "— #{t('admin.branches.form.unassigned')}" },
            class: "form-control" %>
      <p class="form-hint"><%= t("admin.branches.form.branch_manager_hint") %></p>
    </div>
  </div>

  <div class="divider"></div>

  <%# ── Settings ──────────────────────────────────────────── %>
  <h2 class="section-title"><%= t("admin.branches.form.settings") %></h2>

  <%# Status is read-only here: deactivate / reactivate from the branch page (BUG-026). %>
  <div class="form-group">
    <span class="form-label"><%= t("admin.branches.form.active_label") %></span>
    <span class="badge <%= f.object.active? ? 'badge-success' : 'badge-neutral' %>">
      <%= f.object.active? ? t("admin.branches.active") : t("admin.branches.inactive") %>
    </span>
    <p class="form-hint"><%= t("admin.branches.form.active_hint") %></p>
  </div>

  <div class="divider"></div>

  <%# ── Terminal IDs — the single place Terminal ID → Branch mappings are
      managed (no standalone Terminal configuration page). Uniqueness across
      the business is enforced by PosTerminal's own validation; errors surface
      per-row via the nested fields' own error state. ── %>
  <div data-controller="line-items">
    <h2 class="section-title"><%= t("admin.branches.form.terminal_ids_title") %></h2>
    <p class="form-hint"><%= t("admin.branches.form.terminal_ids_hint") %></p>

    <%# The rows are written as one output tag so the markup stays byte-identical to the
        nested-attributes form it replaced (Pilot 12 M4; pinned by
        spec/characterization/finance_sales/pos_terminal_branch_form_markup_spec.rb). %>
    <div data-line-items-target="rows">
      <%= safe_join(branch.pos_terminals.each_with_index.map do |terminal, index|
            f.fields_for :pos_terminals_attributes, terminal, index: index do |pt_f| %>
        <%= render "pos_terminal_fields", f: pt_f %>
      <% end
          end) %>
    </div>

    <p data-line-items-target="emptyState" class="td-secondary" <%= "hidden" if branch.pos_terminals.any? %>>
      <%= t("admin.branches.form.no_terminal_ids") %>
    </p>

    <button type="button" class="btn btn-ghost btn-sm" data-action="line-items#add">
      + <%= t("admin.branches.form.add_terminal_id") %>
    </button>

    <template data-line-items-target="template">
      <%= f.fields_for :pos_terminals_attributes, PosTerminal.new, index: "NEW_INDEX" do |pt_f| %>
        <%= render "pos_terminal_fields", f: pt_f %>
      <% end %>
    </template>
  </div>

  <div class="divider"></div>

  <%# ── Geolocation ───────────────────────────────────────── %>
  <div data-controller="geo-fields">

    <div class="flex items-center justify-between" style="margin-bottom: var(--space-5);">
      <div>
        <h2 class="section-title" style="margin: 0 0 var(--space-1);"><%= t("admin.branches.form.geo_title") %></h2>
        <p class="form-hint" style="margin: 0;">
          <%= t("admin.branches.form.geo_hint") %>
        </p>
      </div>
      <label class="form-check">
        <%= f.check_box :geolocation_enabled,
              data: { geo_fields_target: "toggle", action: "geo-fields#update" } %>
        <span class="form-check-label"><%= t("admin.branches.form.geo_enabled") %></span>
      </label>
    </div>

    <div data-geo-fields-target="fields" <%= "hidden" unless branch.geolocation_enabled? %>>

      <%# Map picker wraps both the map canvas and the coordinate inputs so they stay in sync %>
      <div data-controller="map-picker"
           data-map-picker-default-lat-value="24.7136"
           data-map-picker-default-lng-value="46.6753">

        <%# Search bar %>
        <div class="map-search-bar">
          <input type="text"
                 class="form-control map-search-bar__input"
                 placeholder="<%= t('admin.branches.form.search_placeholder') %>"
                 data-map-picker-target="search"
                 data-action="keydown.enter->map-picker#onSearch">
          <button type="button"
                  class="btn btn-secondary map-search-bar__btn"
                  data-action="click->map-picker#onSearch"><%= t("admin.branches.form.search_button") %></button>
          <button type="button"
                  class="btn btn-ghost map-search-bar__btn map-search-bar__locate"
                  data-action="click->map-picker#onUseLocation"
                  title="<%= t('admin.branches.form.my_location') %>">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/><circle cx="12" cy="12" r="10" stroke-dasharray="2 4"/></svg>
            <span class="map-search-bar__locate-label"><%= t("admin.branches.form.my_location") %></span>
          </button>
        </div>
        <p class="map-search-status" data-map-picker-target="searchStatus" hidden></p>

        <%# Interactive map canvas %>
        <div data-map-picker-target="container" class="branch-map"></div>

        <p class="form-hint" style="margin: var(--space-2) 0 var(--space-4);">
          <%= t("admin.branches.form.map_hint") %>
        </p>

        <%# Coordinate + radius inputs — two-way synced with the map %>
        <div class="form-grid">
          <div class="form-group">
            <%= f.label :latitude, class: "form-label" %>
            <%= f.number_field :latitude,
                  class: "form-control #{'is-error' if branch.errors[:latitude].any?}",
                  placeholder: "24.7136",
                  step: "any",
                  data: {
                    map_picker_target: "lat",
                    action: "input->map-picker#onCoordsInput"
                  } %>
          </div>

          <div class="form-group">
            <%= f.label :longitude, class: "form-label" %>
            <%= f.number_field :longitude,
                  class: "form-control #{'is-error' if branch.errors[:longitude].any?}",
                  placeholder: "46.6753",
                  step: "any",
                  data: {
                    map_picker_target: "lng",
                    action: "input->map-picker#onCoordsInput"
                  } %>
          </div>

          <div class="form-group">
            <%= f.label :radius_meters, t("admin.branches.form.radius_label"), class: "form-label" %>
            <%= f.number_field :radius_meters,
                  class: "form-control #{'is-error' if branch.errors[:radius_meters].any?}",
                  placeholder: "100",
                  min: "1",
                  data: {
                    map_picker_target: "radius",
                    action: "input->map-picker#onRadiusChange"
                  } %>
          </div>
        </div>

      </div><%# /map-picker %>

    </div><%# /geo-fields:fields %>

  </div><%# /geo-fields %>

  <div class="form-actions">
    <%= f.submit branch.persisted? ? t("admin.branches.edit.submit") : t("admin.branches.new.submit"), class: "btn btn-primary" %>
    <% cancel_path = branch.persisted? ? admin_branch_path(branch) : admin_branches_path %>
    <%= link_to t("forms.cancel"), cancel_path, class: "btn btn-ghost" %>
  </div>

<% end %>
