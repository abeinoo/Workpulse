<div class="dashboard-section__header">
  <h2 class="dashboard-section__title"><%= t("admin.branches.employees_section") %></h2>
  <%= link_to t("admin.branches.manage_employees"), admin_users_path, class: "link-muted" %>
</div>

<% if @employees.any? %>
  <div class="table-wrap table-wrap--cards">
    <table>
      <thead>
        <tr>
          <th><%= t("admin.branches.employees_section") %></th>
          <th><%= t("admin.branches.role") %></th>
          <th><%= t("admin.branches.todays_status") %></th>
          <th><%= t("requests.actions") %></th>
        </tr>
      </thead>
      <tbody>
        <% @employees.each do |employee| %>
          <% today_record = @today_records_by_user[employee.id] %>
          <tr>
            <td>
              <div class="employee-cell">
                <div class="avatar"><%= employee.full_name.split.map(&:first).first(2).join.upcase %></div>
                <div>
                  <p class="employee-cell__name">
                    <%= link_to employee.full_name, admin_user_path(employee), class: "link" %>
                  </p>
                  <% if employee.employee_code.present? %>
                    <p class="employee-cell__sub"><%= employee.employee_code %></p>
                  <% end %>
                </div>
              </div>
            </td>
            <td>
              <span class="badge <%= employee.branch_manager? ? 'badge-accent' : 'badge-neutral' %>">
                <%= employee.role.humanize %>
              </span>
            </td>
            <td>
              <% if today_record %>
                <% status_class = case today_record.status
                   when "present"     then "badge-success"
                   when "late"        then "badge-warning"
                   when "early_leave" then "badge-warning"
                   when "absent"      then "badge-danger"
                   else "badge-neutral"
                   end %>
                <span class="badge <%= status_class %>"><%= t("attendance.statuses.#{today_record.status}", default: today_record.status.humanize) %></span>
              <% else %>
                <span class="badge badge-neutral"><%= t("admin.branches.no_record") %></span>
              <% end %>
            </td>
            <td>
              <div class="td-actions">
                <%= link_to t("admin.users.view"), admin_user_path(employee), class: "btn btn-ghost btn-sm" %>
                <% if today_record %>
                  <%= link_to t("admin.branches.attendance"), admin_attendance_record_path(today_record), class: "btn btn-ghost btn-sm" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="empty-state">
    <p class="empty-state__title"><%= t("admin.branches.no_employees") %></p>
    <p class="empty-state__text"><%= t("admin.branches.no_employees_hint") %></p>
  </div>
<% end %>
