<div class="dashboard-section__header">
  <h2 class="dashboard-section__title"><%= t("admin.branches.requests_section") %></h2>
</div>

<%# Pending requests %>
<div class="flex items-center gap-3" style="margin-bottom: var(--space-3);">
  <h3 style="font-size: var(--text-base); font-weight: 600; color: var(--text-1); margin: 0;"><%= t("admin.branches.pending_requests") %></h3>
  <% if @pending_requests.any? %>
    <span class="badge badge-warning"><%= @pending_requests.size %></span>
  <% end %>
</div>

<% if @pending_requests.any? %>
  <div class="table-wrap table-wrap--cards" style="margin-bottom: var(--space-6);">
    <table>
      <thead>
        <tr>
          <th><%= t("requests.employee") %></th>
          <th><%= t("requests.type") %></th>
          <th><%= t("admin.branches.for_date") %></th>
          <th><%= t("requests.reason") %></th>
          <th><%= t("admin.branches.submitted") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @pending_requests.each do |request| %>
          <tr>
            <td>
              <div class="employee-cell">
                <%= user_avatar_tag(request.user, size: :thumb) %>
                <span><%= link_to request.user.full_name, admin_user_path(request.user), class: "link" %></span>
              </div>
            </td>
            <td>
              <span class="badge badge-warning"><%= t("requests.types.#{request.request_type}") %></span>
            </td>
            <td class="td-secondary"><%= local_date(request.requested_for_date) %></td>
            <td class="td-secondary" style="max-width: 220px; white-space: normal;">
              <%= truncate(request.reason, length: 80) %>
            </td>
            <td class="td-secondary"><%= local_short_date(request.created_at) %></td>
            <td class="td-actions">
              <% if policy(request).approve? %>
                <%= button_to t("requests.approve"),
                      approve_employee_request_path(request),
                      method: :patch,
                      class: "btn btn-sm btn-success",
                      data: { turbo_confirm: t("requests.confirm_approve") } %>
                <%= button_to t("requests.reject"),
                      reject_employee_request_path(request),
                      method: :patch,
                      class: "btn btn-sm btn-danger",
                      data: { turbo_confirm: t("requests.confirm_reject") } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="empty-state" style="padding: var(--space-8) var(--space-4); margin-bottom: var(--space-4);">
    <p class="empty-state__title"><%= t("admin.branches.no_pending_requests") %></p>
  </div>
<% end %>

<%# Recent decisions %>
<% if @recent_requests.any? %>
  <div class="flex items-center gap-3" style="margin-bottom: var(--space-3);">
    <h3 style="font-size: var(--text-base); font-weight: 600; color: var(--text-1); margin: 0;"><%= t("admin.branches.recent_decisions") %></h3>
  </div>
  <div class="table-wrap table-wrap--cards">
    <table>
      <thead>
        <tr>
          <th><%= t("requests.employee") %></th>
          <th><%= t("requests.type") %></th>
          <th><%= t("admin.branches.for_date") %></th>
          <th><%= t("requests.status") %></th>
          <th><%= t("admin.branches.reviewed_by") %></th>
        </tr>
      </thead>
      <tbody>
        <% @recent_requests.each do |request| %>
          <tr>
            <td>
              <div class="employee-cell">
                <%= user_avatar_tag(request.user, size: :thumb) %>
                <span><%= link_to request.user.full_name, admin_user_path(request.user), class: "link" %></span>
              </div>
            </td>
            <td class="td-secondary"><%= t("requests.types.#{request.request_type}") %></td>
            <td class="td-secondary"><%= local_date(request.requested_for_date) %></td>
            <td>
              <span class="badge <%= request.approved? ? 'badge-success' : 'badge-danger' %>">
                <%= t("requests.statuses.#{request.status}") %>
              </span>
            </td>
            <td class="td-secondary"><%= request.reviewed_by&.full_name || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
