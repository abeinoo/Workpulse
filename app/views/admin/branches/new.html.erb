<% content_for :title, t("admin.branches.new.page_title") %>

<%# Leaflet CSS — only loaded on pages that have the map picker %>
<% content_for :head do %>
  <link rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
        crossorigin="">
<% end %>

<div class="form-page">
  <%= link_to admin_branches_path, class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    <%= t("forms.back") %>
  <% end %>

  <h1 class="page-title mb-6"><%= t("admin.branches.new.title") %></h1>

  <%= render "form", branch: @branch %>
</div>
