<div class="admin-page">

  <div class="page-header">
    <h1 class="page-title"><%= t("admin.payroll_periods.index.title") %></h1>
  </div>

  <div class="table-wrap table-wrap--cards">
    <table>
      <thead>
        <tr>
          <th><%= t("payroll.period") %></th>
          <th><%= t("payroll.branch") %></th>
          <th><%= t("payroll.status") %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @periods.each do |period| %>
          <tr>
            <td><%= link_to period.period_label, admin_payroll_period_path(period), class: "link" %></td>
            <td class="td-secondary"><%= period.branch&.name || t("payroll.all_branches") %></td>
            <td>
              <span class="badge <%= period_status_badge_class(period) %>">
                <%= t("payroll.statuses.#{period.status}") %>
              </span>
            </td>
            <td class="td-actions">
              <%= link_to t("payroll.view"), admin_payroll_period_path(period), class: "link-muted" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

</div>
