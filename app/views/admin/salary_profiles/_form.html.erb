<%= form_with model: [:admin, @employee, profile], class: "form-card" do |f| %>

  <%= render "users/shared/error_messages", resource: profile %>

  <div class="form-grid">
    <div class="form-group">
      <%= f.label :salary_type, t("salary_profiles.type"), class: "form-label" %>
      <%= f.select :salary_type,
            SalaryProfile::SALARY_TYPES.map { |type| [t("salary_profiles.salary_types.#{type}"), type] },
            {},
            class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :base_amount, class: "form-label" %>
      <%= f.number_field :base_amount,
            class: "form-control #{'is-error' if profile.errors[:base_amount].any?}",
            min: 0, step: "0.01",
            placeholder: "5000.00" %>
    </div>

    <div class="form-group">
      <%= f.label :overtime_multiplier, class: "form-label" do %>
        <%= t("salary_profiles.overtime_multiplier") %>
        <span class="form-label__optional"><%= t("forms.optional") %></span>
      <% end %>
      <%= f.number_field :overtime_multiplier,
            class: "form-control #{'is-error' if profile.errors[:overtime_multiplier].any?}",
            min: "0.01", max: "5", step: "0.01",
            placeholder: t("salary_profiles.overtime_multiplier_placeholder") %>
      <p class="form-hint"><%= t("salary_profiles.overtime_hint") %></p>
    </div>

    <div class="form-group">
      <%= f.label :effective_from, t("salary_profiles.effective_from"), class: "form-label" %>
      <%= f.date_field :effective_from,
            class: "form-control #{'is-error' if profile.errors[:effective_from].any?}" %>
    </div>
  </div>

  <p class="form-hint" style="margin-bottom: 0;">
    <%= t("salary_profiles.currency_note",
          currency: @employee.business.currency_info[:name],
          code: @employee.business.currency) %>
  </p>

  <div class="form-actions">
    <%= f.submit f.object.persisted? ? t("salary_profiles.edit.submit") : t("salary_profiles.new.submit"), class: "btn btn-primary" %>
    <%= link_to t("forms.cancel"), admin_user_path(@employee), class: "btn btn-ghost" %>
  </div>

<% end %>
