<% content_for :title, t("admin.departments.title") %>

<div class="admin-page">
  <div class="page-header">
    <h1 class="page-title"><%= t("admin.departments.title") %></h1>
    <%= link_to t("admin.departments.add"), new_admin_department_path, class: "btn btn-primary btn-sm" %>
  </div>

  <p class="form-hint"><%= t("admin.departments.intro") %></p>

  <% if @departments.empty? %>
    <div class="empty-state"><p class="empty-state__title"><%= t("admin.departments.empty") %></p></div>
  <% else %>
    <div class="table-wrap table-wrap--cards">
      <table>
        <thead>
          <tr>
            <th><%= t("admin.departments.name") %></th>
            <th><%= t("admin.departments.employees") %></th>
            <th><%= t("admin.departments.status") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @departments.each do |department| %>
            <tr>
              <td><%= department.name %></td>
              <td class="td-secondary"><%= department.users.count %></td>
              <td>
                <% if department.active? %>
                  <span class="badge badge-success"><%= t("admin.departments.statuses.active") %></span>
                <% else %>
                  <span class="badge badge-neutral"><%= t("admin.departments.statuses.inactive") %></span>
                <% end %>
              </td>
              <td class="td-actions">
                <%= link_to t("common.edit"), edit_admin_department_path(department), class: "link-muted" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
