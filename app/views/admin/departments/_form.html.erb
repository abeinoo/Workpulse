<%= form_with model: [:admin, department], class: "form-card" do |f| %>
  <%= render "shared/error_messages", object: department %>

  <div class="form-grid">
    <div class="form-group" style="grid-column: 1 / -1;">
      <%= f.label :name, t("admin.departments.name"), class: "form-label" %>
      <%= f.text_field :name, class: "form-control #{'is-error' if department.errors[:name].any?}",
            placeholder: t("admin.departments.name_placeholder") %>
    </div>

    <div class="form-group" style="grid-column: 1 / -1;">
      <label class="form-check">
        <%= f.check_box :active %>
        <span><%= t("admin.departments.active_label") %></span>
      </label>
      <p class="form-hint"><%= t("admin.departments.active_hint") %></p>
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit t("common.save"), class: "btn btn-primary" %>
    <%= link_to t("common.cancel"), admin_departments_path, class: "btn btn-ghost" %>
  </div>
<% end %>
