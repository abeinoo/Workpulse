<% content_for :title, t("admin.departments.edit_title") %>

<div class="form-page">
  <%= link_to admin_departments_path, class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    <%= t("forms.back") %>
  <% end %>

  <div class="page-header">
    <h1 class="page-title"><%= t("admin.departments.edit_title") %></h1>
    <% if @department.users.none? && @department.evaluation_templates.none? && @department.performance_reviews.none? %>
      <%= button_to t("common.delete"), admin_department_path(@department), method: :delete,
            class: "btn btn-danger btn-sm",
            form: { data: { turbo_confirm: t("admin.departments.delete_confirm") } } %>
    <% end %>
  </div>

  <%= render "form", department: @department %>
</div>
