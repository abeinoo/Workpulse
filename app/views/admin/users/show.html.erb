<% content_for :title, t("admin.users.show.page_title", name: @user.full_name) %>

<div class="form-page">
  <%= link_to admin_users_path, class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    <%= t("admin.users.back") %>
  <% end %>

  <div class="card">
    <div class="card-header">
      <div class="employee-cell">
        <%= user_avatar_tag(@user, size: :default) %>
        <div>
          <h1 style="font-size:var(--text-xl);margin-bottom:2px;"><%= @user.full_name %></h1>
          <p style="font-size:var(--text-sm);color:var(--text-2);margin:0;">
            <% if @user.job_title.present? %>
              <%= @user.job_title %>
              <% if @user.department.present? %>
                &middot; <%= @user.department %>
              <% end %>
            <% else %>
              <%= @user.permission_role&.name || (@user.owner? ? t("admin.users.super_admin_role") : "—") %>
            <% end %>
          </p>
        </div>
      </div>
      <% if @user.active? %>
        <span class="badge badge-success"><%= t("admin.users.active") %></span>
      <% else %>
        <span class="badge badge-neutral"><%= t("admin.users.inactive") %></span>
      <% end %>
    </div>

    <%# Profile completion bar %>
    <% pct = @user.profile_completion_percentage %>
    <% grade = @user.profile_completion_grade %>
    <div class="profile-completion" title="<%= t("admin.users.profile_completion.title") %>">
      <div class="profile-completion__header">
        <span class="profile-completion__label"><%= t("admin.users.profile_completion.label") %></span>
        <span class="profile-completion__pct profile-completion__pct--<%= grade %>"><%= pct %>%</span>
      </div>
      <div class="profile-completion__bar">
        <div class="profile-completion__fill profile-completion__fill--<%= grade %>"
             style="width:<%= pct %>%;"></div>
      </div>
    </div>

    <dl class="data-list">
      <div class="data-list__item">
        <dt class="data-list__label"><%= t("admin.users.phone") %></dt>
        <dd class="data-list__value"><%= @user.phone_number.presence || "—" %></dd>
      </div>
      <div class="data-list__item">
        <dt class="data-list__label"><%= t("admin.users.email") %></dt>
        <dd class="data-list__value"><%= @user.email.presence || "—" %></dd>
      </div>
      <div class="data-list__item">
        <dt class="data-list__label"><%= t("admin.users.employee_code") %></dt>
        <dd class="data-list__value"><%= @user.employee_code.presence || "—" %></dd>
      </div>
      <% if @user.job_title.present? || @user.department.present? || @user.hire_date.present? || @user.employment_type.present? %>
        <div class="data-list__item data-list__item--section-header">
          <dt class="data-list__label data-list__label--section"><%= t("admin.users.employment_info") %></dt>
        </div>
        <% if @user.job_title.present? %>
          <div class="data-list__item">
            <dt class="data-list__label"><%= t("admin.users.job_title") %></dt>
            <dd class="data-list__value"><%= @user.job_title %></dd>
          </div>
        <% end %>
        <% if @user.department.present? %>
          <div class="data-list__item">
            <dt class="data-list__label"><%= t("admin.users.department") %></dt>
            <dd class="data-list__value"><%= @user.department %></dd>
          </div>
        <% end %>
        <% if @user.hire_date.present? %>
          <div class="data-list__item">
            <dt class="data-list__label"><%= t("admin.users.hire_date") %></dt>
            <dd class="data-list__value"><%= local_date(@user.hire_date) %></dd>
          </div>
        <% end %>
        <% if @user.employment_type.present? %>
          <div class="data-list__item">
            <dt class="data-list__label"><%= t("admin.users.employment_type") %></dt>
            <dd class="data-list__value"><%= t("admin.users.employment_types.#{@user.employment_type}") %></dd>
          </div>
        <% end %>
      <% end %>
      <div class="data-list__item">
        <dt class="data-list__label"><%= t("admin.users.direct_manager") %></dt>
        <dd class="data-list__value">
          <% if @user.manager %>
            <%= link_to @user.manager.full_name, admin_user_path(@user.manager), class: "link" %>
          <% else %>
            <span class="td-secondary">— <%= t("admin.users.not_assigned") %></span>
          <% end %>
        </dd>
      </div>
      <% if @user.manages_branch? && @user.managed_employees.any? %>
        <div class="data-list__item">
          <dt class="data-list__label"><%= t("admin.users.managed_employees") %></dt>
          <dd class="data-list__value">
            <%= @user.managed_employees.order(:first_name).map(&:full_name).join(", ") %>
          </dd>
        </div>
      <% end %>
      <div class="data-list__item">
        <dt class="data-list__label"><%= t("admin.users.status") %></dt>
        <dd class="data-list__value">
          <% if @user.encrypted_password.present? %>
            <span class="badge badge-accent"><%= t("admin.users.registered") %></span>
          <% else %>
            <span class="badge badge-warning"><%= t("admin.users.pending_registration") %></span>
          <% end %>
        </dd>
      </div>
      <div class="data-list__item">
        <dt class="data-list__label"><%= t("admin.users.identity_card") %></dt>
        <dd class="data-list__value"><%= @user.identity_card_number.presence || "—" %></dd>
      </div>
      <% if @user.identity_card_expiry_date.present? %>
        <div class="data-list__item">
          <dt class="data-list__label"><%= t("admin.users.id_expiry") %></dt>
          <dd class="data-list__value"><%= local_date(@user.identity_card_expiry_date) %></dd>
        </div>
      <% end %>
      <% if @user.emergency_contact_name.present? || @user.emergency_contact_phone.present? %>
        <div class="data-list__item data-list__item--section-header">
          <dt class="data-list__label data-list__label--section">
            <%= t("admin.users.emergency_contact") %>
          </dt>
        </div>
        <% if @user.emergency_contact_name.present? %>
          <div class="data-list__item">
            <dt class="data-list__label"><%= t("admin.users.emergency_contact_name") %></dt>
            <dd class="data-list__value">
              <%= @user.emergency_contact_name %>
              <% if @user.emergency_contact_relationship.present? %>
                <span class="text-muted text-sm">&nbsp;(<%=  @user.emergency_contact_relationship %>)</span>
              <% end %>
            </dd>
          </div>
        <% end %>
        <% if @user.emergency_contact_phone.present? %>
          <div class="data-list__item">
            <dt class="data-list__label"><%= t("admin.users.emergency_contact_phone") %></dt>
            <dd class="data-list__value">
              <a href="tel:<%= @user.emergency_contact_phone %>" class="link">
                <%= @user.emergency_contact_phone %>
              </a>
            </dd>
          </div>
        <% end %>
      <% end %>
    </dl>

    <div class="form-actions">
      <%= link_to t("admin.users.edit_action"), edit_admin_user_path(@user), class: "btn btn-primary" %>
      <%= link_to t("admin.users.password.reset_action"), edit_admin_user_password_path(@user), class: "btn btn-secondary" %>
      <%= button_to t("admin.users.delete"),
            admin_user_path(@user),
            method: :delete,
            data: { turbo_confirm: t("forms.confirm_delete") },
            class: "btn btn-danger" %>
    </div>
  </div>

  <%# Documents — national ID front & back %>
  <% if @user.national_id_front.attached? || @user.national_id_back.attached? %>
    <div class="card" style="margin-top: var(--space-6);">
      <div class="card-header">
        <h2 class="card-title" style="font-size: var(--text-lg);">
          <%= t("admin.users.show.documents") %>
        </h2>
      </div>
      <div class="attachment-grid">
        <% if @user.national_id_front.attached? %>
          <div class="attachment-item">
            <p class="attachment-item__label"><%= t("admin.users.form.national_id_front") %></p>
            <%= national_id_viewer_tag(@user, :national_id_front) %>
          </div>
        <% end %>
        <% if @user.national_id_back.attached? %>
          <div class="attachment-item">
            <p class="attachment-item__label"><%= t("admin.users.form.national_id_back") %></p>
            <%= national_id_viewer_tag(@user, :national_id_back) %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Ownership Transfer — only the current owner sees this, and only for other users %>
  <% if policy(@user).transfer_ownership? %>
    <div class="card" style="margin-top: var(--space-6); border-color: var(--color-warning, #f59e0b);">
      <div class="card-header">
        <h2 class="card-title" style="font-size: var(--text-lg); color: var(--color-warning, #b45309);">
          <%= t("admin.users.transfer_ownership") %>
        </h2>
      </div>
      <div style="padding: var(--space-4);">
        <p class="form-hint" style="margin-bottom: var(--space-4);">
          <%= t("admin.users.transfer_ownership_hint", name: @user.full_name) %>
        </p>
        <%= button_to t("admin.users.transfer_ownership"),
              transfer_ownership_admin_user_path(@user),
              method: :patch,
              data: { turbo_confirm: t("admin.users.transfer_ownership_confirm", name: @user.full_name) },
              class: "btn btn-warning" %>
      </div>
    </div>
  <% end %>

  <%# Salary Profiles %>
  <div class="card" style="margin-top: var(--space-6);">
    <div class="card-header">
      <h2 class="card-title" style="font-size: var(--text-lg);"><%= t("admin.users.salary_profile") %></h2>
      <% if policy(SalaryProfile.new(user: @user)).create? %>
        <%= link_to t("admin.users.new_profile"), new_admin_user_salary_profile_path(@user), class: "btn btn-sm btn-primary" %>
      <% end %>
    </div>

    <% if @active_salary_profile %>
      <dl class="data-list">
        <div class="data-list__item">
          <dt class="data-list__label"><%= t("salary_profiles.type") %></dt>
          <dd class="data-list__value"><%= t("salary_profiles.salary_types.#{@active_salary_profile.salary_type}") %></dd>
        </div>
        <div class="data-list__item">
          <dt class="data-list__label"><%= t("salary_profiles.base_salary") %></dt>
          <dd class="data-list__value"><%= format_currency(@active_salary_profile.base_amount) %></dd>
        </div>
        <div class="data-list__item">
          <dt class="data-list__label"><%= t("salary_profiles.overtime_multiplier") %></dt>
          <dd class="data-list__value">
            <% if @active_salary_profile.overtime_multiplier %>
              <%= @active_salary_profile.overtime_multiplier %>x
            <% else %>
              <span class="text-muted">—</span>
            <% end %>
          </dd>
        </div>
        <div class="data-list__item">
          <dt class="data-list__label"><%= t("salary_profiles.effective_from") %></dt>
          <dd class="data-list__value"><%= local_date(@active_salary_profile.effective_from) %></dd>
        </div>
      </dl>
      <% if policy(@active_salary_profile).update? %>
        <div class="form-actions">
          <%= link_to t("admin.users.edit_active_profile"),
                edit_admin_user_salary_profile_path(@user, @active_salary_profile),
                class: "btn btn-sm btn-secondary" %>
        </div>
      <% end %>
    <% else %>
      <p style="padding: var(--space-4); color: var(--text-2);"><%= t("salary_profiles.no_active") %></p>
    <% end %>

    <% if @salary_profiles.size > 1 %>
      <div style="padding: 0 var(--space-4) var(--space-4);">
        <h3 style="font-size: var(--text-sm); font-weight: 600; color: var(--text-2); margin-bottom: var(--space-2);"><%= t("salary_profiles.history") %></h3>
        <div class="table-wrap table-wrap--cards">
          <table>
            <thead>
              <tr>
                <th><%= t("salary_profiles.type") %></th>
                <th><%= t("salary_profiles.base_salary") %></th>
                <th><%= t("salary_profiles.ot_multiplier") %></th>
                <th><%= t("salary_profiles.effective_from") %></th>
                <th><%= t("admin.users.status") %></th>
              </tr>
            </thead>
            <tbody>
              <% @salary_profiles.each do |profile| %>
                <tr>
                  <td data-label="<%= t('salary_profiles.type') %>"><%= t("salary_profiles.salary_types.#{profile.salary_type}") %></td>
                  <td data-label="<%= t('salary_profiles.base_salary') %>"><%= format_currency(profile.base_amount) %></td>
                  <td data-label="<%= t('salary_profiles.ot_multiplier') %>"><%= profile.overtime_multiplier ? "#{profile.overtime_multiplier}x" : "—" %></td>
                  <td data-label="<%= t('salary_profiles.effective_from') %>"><%= local_date(profile.effective_from) %></td>
                  <td data-label="<%= t('admin.users.status') %>">
                    <% if profile.active? %>
                      <span class="badge badge-success"><%= t("salary_profiles.active") %></span>
                    <% else %>
                      <span class="badge badge-neutral"><%= t("salary_profiles.historical") %></span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </div>

  <%# Active Obligations %>
  <% active_obligations = @user.employee_obligations.where(status: %w[active paused]).order(created_at: :desc) %>
  <% if active_obligations.any? %>
    <div class="card" style="margin-top: var(--space-6);">
      <div class="card-header">
        <h2 class="card-title" style="font-size: var(--text-lg);"><%= t("admin.employee_obligations.user_section_title") %></h2>
        <%= link_to t("admin.employee_obligations.index.add"),
              new_admin_employee_obligation_path(user_id: @user.id),
              class: "btn btn-sm btn-primary" %>
      </div>
      <div class="table-wrap table-wrap--cards">
        <table>
          <thead>
            <tr>
              <th><%= t("admin.employee_obligations.title_col") %></th>
              <th><%= t("admin.employee_obligations.remaining") %></th>
              <th><%= t("admin.employee_obligations.installment") %></th>
              <th><%= t("admin.employee_obligations.status_col") %></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% active_obligations.each do |obligation| %>
              <tr>
                <td><%= obligation.title %></td>
                <td><%= number_with_precision(obligation.remaining_amount, precision: 2, delimiter: ",") %></td>
                <td class="td-secondary"><%= number_with_precision(obligation.installment_amount, precision: 2, delimiter: ",") %></td>
                <td>
                  <span class="badge <%= obligation_status_badge(obligation.status) %>">
                    <%= t("admin.employee_obligations.statuses.#{obligation.status}") %>
                  </span>
                </td>
                <td>
                  <%= link_to t("forms.view"), admin_employee_obligation_path(obligation), class: "btn btn-ghost btn-sm" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
