<%= form_with model: [:admin, user], class: "form-card" do |f| %>

  <%= render "users/shared/error_messages", resource: user %>

  <div class="form-grid">
    <div class="form-group">
      <%= f.label :first_name, class: "form-label" %>
      <%= f.text_field :first_name,
            class: "form-control #{'is-error' if user.errors[:first_name].any?}",
            placeholder: "Jane" %>
    </div>

    <div class="form-group">
      <%= f.label :last_name, class: "form-label" %>
      <%= f.text_field :last_name,
            class: "form-control #{'is-error' if user.errors[:last_name].any?}",
            placeholder: "Smith" %>
    </div>

    <div class="form-group">
      <%= f.label :phone_number, class: "form-label" %>
      <%= f.text_field :phone_number,
            class: "form-control #{'is-error' if user.errors[:phone_number].any?}",
            placeholder: "+966500000000" %>
    </div>

    <div class="form-group">
      <%= f.label :email, class: "form-label" %>
      <%= f.email_field :email,
            class: "form-control #{'is-error' if user.errors[:email].any?}",
            placeholder: "jane@example.com" %>
    </div>

    <div class="form-group">
      <%= f.label :employee_code, t("admin.users.form.employee_code"), class: "form-label" %>
      <%= f.text_field :employee_code,
            class: "form-control",
            placeholder: "EMP-001" %>
    </div>

    <div class="form-group">
      <%= f.label :role, class: "form-label" %>
      <%= f.select :role,
            User::ROLES.map { |r| [r.humanize, r] },
            {},
            class: "form-control" %>
    </div>

    <% if defined?(@managers) && @managers.any? %>
      <div class="form-group">
        <%= f.label :manager_id, t("admin.users.form.direct_manager"), class: "form-label" %>
        <%= f.select :manager_id,
              @managers.map { |m| ["#{m.full_name} (#{m.role.humanize})", m.id] },
              { include_blank: "— #{t("admin.users.form.no_manager")} —" },
              class: "form-control" %>
        <p class="form-hint">
          <%= t("admin.users.form.hierarchy_hint") %>
        </p>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :identity_card_number, t("admin.users.form.identity_card"), class: "form-label" %>
      <%= f.text_field :identity_card_number,
            class: "form-control #{'is-error' if user.errors[:identity_card_number].any?}",
            placeholder: "A1234567" %>
    </div>

    <div class="form-group">
      <%= f.label :identity_card_expiry_date, t("admin.users.form.id_expiry"), class: "form-label" %>
      <%= f.date_field :identity_card_expiry_date,
            class: "form-control" %>
    </div>

    <div class="form-group">
      <label class="form-check">
        <%= f.check_box :active %>
        <span class="form-check-label"><%= t("admin.users.form.active") %></span>
      </label>
    </div>

    <%# ── Emergency Contact ──────────────────────────────────────────── %>
    <div class="form-group form-group--full">
      <p class="form-label" style="margin-bottom: var(--space-2);">
        <%= t("admin.users.form.emergency_contact") %>
      </p>
      <p class="form-hint" style="margin-bottom: var(--space-3);">
        <%= t("admin.users.form.emergency_contact_hint") %>
      </p>
    </div>

    <div class="form-group">
      <%= f.label :emergency_contact_name, t("admin.users.form.emergency_contact_name"), class: "form-label" %>
      <%= f.text_field :emergency_contact_name,
            class: "form-control",
            placeholder: t("admin.users.form.emergency_contact_name_placeholder") %>
    </div>

    <div class="form-group">
      <%= f.label :emergency_contact_phone, t("admin.users.form.emergency_contact_phone"), class: "form-label" %>
      <%= f.text_field :emergency_contact_phone,
            class: "form-control #{'is-error' if user.errors[:emergency_contact_phone].any?}",
            placeholder: "+966500000000",
            inputmode: "tel" %>
      <% if user.errors[:emergency_contact_phone].any? %>
        <p class="form-error"><%= user.errors[:emergency_contact_phone].first %></p>
      <% end %>
    </div>

    <div class="form-group">
      <%= f.label :emergency_contact_relationship, t("admin.users.form.emergency_contact_relationship"), class: "form-label" %>
      <%= f.text_field :emergency_contact_relationship,
            class: "form-control",
            placeholder: t("admin.users.form.relationship_placeholder"),
            list: "relationship-suggestions",
            autocomplete: "off" %>
      <datalist id="relationship-suggestions">
        <% t("admin.users.form.relationship_options").each do |opt| %>
          <option value="<%= opt %>">
        <% end %>
      </datalist>
    </div>

    <%# ── Attendance Sources ─────────────────────────────────────────── %>
    <div class="form-group form-group--full">
      <p class="form-label" style="margin-bottom: var(--space-2);">
        <%= t("admin.users.form.attendance_sources") %>
      </p>
      <p class="form-hint" style="margin-bottom: var(--space-3);">
        <%= t("admin.users.form.attendance_sources_hint") %>
      </p>
      <div style="display: flex; flex-direction: column; gap: var(--space-2);">
        <label class="form-check">
          <%= f.check_box :allow_mobile_attendance %>
          <span class="form-check-label"><%= t("admin.users.form.allow_mobile_attendance") %></span>
        </label>
        <label class="form-check">
          <%= f.check_box :allow_biometric_attendance %>
          <span class="form-check-label"><%= t("admin.users.form.allow_biometric_attendance") %></span>
        </label>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to t("forms.cancel"), admin_users_path, class: "btn btn-ghost" %>
  </div>

<% end %>
