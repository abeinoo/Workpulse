<%= form_with model: [:admin, user], multipart: true, class: "form-card" do |f| %>
  <%# Fields are shown only when UserPolicy#permitted_attributes allows the
      current user to change them; the controller enforces the same list. %>
  <% permitted = policy(user).permitted_attributes %>

  <%= render "users/shared/error_messages", resource: user %>

  <%# ── Profile Photo ───────────────────────────────────────────────── %>
  <div class="form-group form-group--full">
    <%= f.label :profile_photo, t("admin.users.form.profile_photo"), class: "form-label" %>

    <div class="upload-field" data-controller="image-upload">
      <div class="upload-field__preview">
        <% photo_url = user.profile_photo.attached? ? profile_photo_url(user, size: :thumb) : nil %>
        <img src="<%= photo_url %>"
             class="avatar-img"
             style="width: 64px; height: 64px;"
             alt=""
             data-image-upload-target="img"
             <%= "hidden" unless photo_url %>>
        <div class="avatar avatar-placeholder"
             data-image-upload-target="placeholder"
             <%= "hidden" if photo_url %>>
          <%= user.persisted? ? (user.first_name.to_s.first.upcase.presence || "?") : "?" %>
        </div>

        <div class="upload-field__controls">
          <label class="btn btn-ghost btn-sm upload-field__choose">
            <%= t("forms.choose_image") %>
            <%= f.file_field :profile_photo,
                  accept: "image/png,image/jpeg,image/webp",
                  class: "upload-field__input",
                  data: { "image-upload-target": "input", action: "change->image-upload#change" } %>
          </label>
          <button type="button"
                  class="btn btn-ghost btn-sm text-danger"
                  data-image-upload-target="removeBtn"
                  data-action="image-upload#remove"
                  <%= "hidden" unless user.profile_photo.attached? %>>
            <%= t("forms.remove_image") %>
          </button>
          <%= f.hidden_field :remove_profile_photo, value: "0",
                data: { "image-upload-target": "removeFlag" } %>
        </div>
      </div>
      <p class="upload-field__hint"><%= t("admin.users.form.profile_photo_hint") %></p>
    </div>
  </div>

  <div class="form-grid">
    <div class="form-group">
      <%= f.label :first_name, class: "form-label" %>
      <%= f.text_field :first_name,
            class: "form-control #{'is-error' if user.errors[:first_name].any?}",
            placeholder: t("admin.users.form.first_name_placeholder") %>
    </div>

    <div class="form-group">
      <%= f.label :last_name, class: "form-label" %>
      <%= f.text_field :last_name,
            class: "form-control #{'is-error' if user.errors[:last_name].any?}",
            placeholder: t("admin.users.form.last_name_placeholder") %>
    </div>

    <div class="form-group">
      <%= f.label :phone_number, class: "form-label" %>
      <%= f.text_field :phone_number,
            class: "form-control #{'is-error' if user.errors[:phone_number].any?}",
            placeholder: t("admin.users.form.phone_placeholder") %>
    </div>

    <div class="form-group">
      <%= f.label :email, class: "form-label" %>
      <%= f.email_field :email,
            class: "form-control #{'is-error' if user.errors[:email].any?}",
            placeholder: t("admin.users.form.email_placeholder") %>
    </div>

    <% if permitted.include?(:employee_code) %>
    <div class="form-group">
      <%= f.label :employee_code, t("admin.users.form.employee_code"), class: "form-label" %>
      <%= f.text_field :employee_code,
            class: "form-control",
            placeholder: t("admin.users.form.employee_code_placeholder") %>
      <% if f.object.new_record? %>
        <p class="form-hint"><%= t("admin.users.form.employee_code_hint") %></p>
      <% end %>
    </div>
    <% end %>

    <%# ── Employment Info ──────────────────────────────────────────────── %>
    <div class="form-group form-group--full">
      <p class="form-label" style="margin-bottom: var(--space-2);">
        <%= t("admin.users.form.employment_info") %>
      </p>
    </div>

    <div class="form-group">
      <%= f.label :job_title, t("admin.users.form.job_title"), class: "form-label" %>
      <%= render "shared/job_title_select", f: f %>
    </div>

    <div class="form-group">
      <%= f.label :department_id, t("admin.users.form.department"), class: "form-label" %>
      <%# Active departments only; keep the currently-assigned one in the list
          even if it was since deactivated, so editing never drops the link. %>
      <% departments = current_user.business.departments.active.ordered.to_a %>
      <% if user.department_id.present? && departments.none? { |d| d.id == user.department_id } %>
        <% departments.unshift(user.department) %>
      <% end %>
      <%= f.select :department_id,
            options_from_collection_for_select(departments, :id, :name, user.department_id),
            { include_blank: "— #{t("admin.users.form.no_department")} —" },
            class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :hire_date, t("admin.users.form.hire_date"), class: "form-label" %>
      <%= f.date_field :hire_date, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :date_of_birth, t("admin.users.form.date_of_birth"), class: "form-label" %>
      <%= f.date_field :date_of_birth, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= f.label :address, t("activerecord.attributes.user.address"), class: "form-label" %>
      <%= f.text_area :address, class: "form-control", rows: 2, maxlength: 500 %>
    </div>

    <div class="form-group">
      <%= f.label :employment_type, t("admin.users.form.employment_type"), class: "form-label" %>
      <%= f.select :employment_type,
            User::EMPLOYMENT_TYPES.map { |t_val| [t("admin.users.employment_types.#{t_val}"), t_val] },
            { include_blank: "— #{t("admin.users.form.select_employment_type")} —" },
            class: "form-control" %>
    </div>

    <% if permitted.include?(:permission_role_id) %>
    <%# Only roles the current user may grant (plus the current value). %>
    <% assignable_roles = current_user.business.permission_roles.ordered.select { |r|
         r.id == user.permission_role_id || OrganizationAccess::PermissionGrants.manageable_role?(current_user, r) } %>
    <div class="form-group">
      <%= f.label :permission_role_id, t("admin.users.form.permission_role"), class: "form-label" %>
      <%= f.select :permission_role_id,
            assignable_roles.map { |r| [r.name, r.id] },
            { include_blank: "— #{t("admin.users.form.no_permission_role")} —" },
            class: "form-control" %>
      <p class="form-hint"><%= t("admin.users.form.permission_role_hint") %></p>
    </div>
    <% end %>

    <% warehouses = current_user.business.warehouses.ordered %>
    <% if warehouses.any? && permitted.include?(assigned_warehouse_ids: []) %>
      <div class="form-group" style="grid-column: 1 / -1;">
        <%= f.label :assigned_warehouse_ids, t("admin.users.form.warehouses"), class: "form-label" %>
        <div class="check-grid" style="display: flex; flex-wrap: wrap; gap: var(--space-3);">
          <%= f.collection_check_boxes :assigned_warehouse_ids, warehouses, :id, :name do |b| %>
            <label class="form-check">
              <%= b.check_box %>
              <span class="form-check-label"><%= b.text %></span>
            </label>
          <% end %>
        </div>
        <p class="form-hint"><%= t("admin.users.form.warehouses_hint") %></p>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :identity_card_number, t("admin.users.form.identity_card"), class: "form-label" %>
      <%= f.text_field :identity_card_number,
            class: "form-control #{'is-error' if user.errors[:identity_card_number].any?}",
            placeholder: t("admin.users.form.identity_card_placeholder") %>
    </div>

    <div class="form-group">
      <%= f.label :identity_card_expiry_date, t("admin.users.form.id_expiry"), class: "form-label" %>
      <%= f.date_field :identity_card_expiry_date,
            class: "form-control" %>
    </div>

    <% if permitted.include?(:active) %>
    <div class="form-group">
      <label class="form-check">
        <%= f.check_box :active %>
        <span class="form-check-label"><%= t("admin.users.form.active") %></span>
      </label>
    </div>
    <% end %>

    <%# ── Emergency Contact ──────────────────────────────────────────── %>
    <div class="form-group form-group--full">
      <p class="form-label" style="margin-bottom: var(--space-2);">
        <%= t("admin.users.form.emergency_contact") %>
      </p>
      <p class="form-hint" style="margin-bottom: var(--space-3);">
        <%= t("admin.users.form.emergency_contact_hint") %>
      </p>
    </div>

    <div class="form-group">
      <%= f.label :emergency_contact_name, t("admin.users.form.emergency_contact_name"), class: "form-label" %>
      <%= f.text_field :emergency_contact_name,
            class: "form-control",
            placeholder: t("admin.users.form.emergency_contact_name_placeholder") %>
    </div>

    <div class="form-group">
      <%= f.label :emergency_contact_phone, t("admin.users.form.emergency_contact_phone"), class: "form-label" %>
      <%= f.text_field :emergency_contact_phone,
            class: "form-control #{'is-error' if user.errors[:emergency_contact_phone].any?}",
            placeholder: t("admin.users.form.emergency_contact_phone_placeholder"),
            inputmode: "tel" %>
      <% if user.errors[:emergency_contact_phone].any? %>
        <p class="form-error"><%= user.errors[:emergency_contact_phone].first %></p>
      <% end %>
    </div>

    <div class="form-group">
      <%= f.label :emergency_contact_relationship, t("admin.users.form.emergency_contact_relationship"), class: "form-label" %>
      <%= f.text_field :emergency_contact_relationship,
            class: "form-control",
            placeholder: t("admin.users.form.relationship_placeholder"),
            list: "relationship-suggestions",
            autocomplete: "off" %>
      <datalist id="relationship-suggestions">
        <% Array(t("admin.users.form.relationship_options")).each do |opt| %>
          <option value="<%= opt %>">
        <% end %>
      </datalist>
    </div>

    <%# ── Attendance Sources ─────────────────────────────────────────── %>
    <% if permitted.include?(:allow_mobile_attendance) %>
    <div class="form-group form-group--full">
      <p class="form-label" style="margin-bottom: var(--space-2);">
        <%= t("admin.users.form.attendance_sources") %>
      </p>
      <p class="form-hint" style="margin-bottom: var(--space-3);">
        <%= t("admin.users.form.attendance_sources_hint") %>
      </p>
      <div style="display: flex; flex-direction: column; gap: var(--space-2);">
        <label class="form-check">
          <%= f.check_box :allow_mobile_attendance %>
          <span class="form-check-label"><%= t("admin.users.form.allow_mobile_attendance") %></span>
        </label>
        <label class="form-check">
          <%= f.check_box :allow_biometric_attendance %>
          <span class="form-check-label"><%= t("admin.users.form.allow_biometric_attendance") %></span>
        </label>
        <label class="form-check">
          <%= f.check_box :requires_shift_assignment %>
          <span class="form-check-label"><%= t("admin.users.form.requires_shift_assignment") %></span>
        </label>
      </div>
      <p class="form-hint"><%= t("admin.users.form.requires_shift_assignment_hint") %></p>
    </div>
    <% end %>
  </div>

  <%# ── ID Documents ────────────────────────────────────────────────── %>
  <div class="divider"></div>
  <h2 class="section-title"><%= t("admin.users.form.documents_section") %></h2>

  <div class="form-grid">
    <%# National ID front %>
    <div class="form-group">
      <%= f.label :national_id_front, t("admin.users.form.national_id_front"), class: "form-label" %>

      <div class="upload-field" data-controller="image-upload">
        <div class="upload-field__preview">
          <% front_url = user.national_id_front.attached? ? national_id_url(user, :national_id_front, size: :thumb) : nil %>
          <img src="<%= front_url %>"
               class="upload-field__doc-thumb"
               alt=""
               data-image-upload-target="img"
               <%= "hidden" unless front_url %>>
          <div class="upload-field__doc-placeholder"
               data-image-upload-target="placeholder"
               <%= "hidden" if front_url %>>
            <% if user.national_id_front.attached? && user.national_id_front.blob.content_type == "application/pdf" %>
              PDF
            <% else %>
              &#128196;
            <% end %>
          </div>
          <% if user.national_id_front.attached? && !front_url %>
            <span class="upload-field__filename" data-image-upload-target="filename">
              <%= user.national_id_front.blob.filename %>
            </span>
          <% else %>
            <span class="upload-field__filename" data-image-upload-target="filename" hidden></span>
          <% end %>

          <div class="upload-field__controls">
            <label class="btn btn-ghost btn-sm upload-field__choose">
              <%= t("forms.choose_file") %>
              <%= f.file_field :national_id_front,
                    accept: "image/png,image/jpeg,image/webp,application/pdf",
                    class: "upload-field__input",
                    data: { "image-upload-target": "input", action: "change->image-upload#change" } %>
            </label>
            <button type="button"
                    class="btn btn-ghost btn-sm text-danger"
                    data-image-upload-target="removeBtn"
                    data-action="image-upload#remove"
                    <%= "hidden" unless user.national_id_front.attached? %>>
              <%= t("forms.remove_image") %>
            </button>
            <%= f.hidden_field :remove_national_id_front, value: "0",
                  data: { "image-upload-target": "removeFlag" } %>
          </div>
        </div>
        <p class="upload-field__hint"><%= t("admin.users.form.national_id_hint") %></p>
      </div>
    </div>

    <%# National ID back %>
    <div class="form-group">
      <%= f.label :national_id_back, t("admin.users.form.national_id_back"), class: "form-label" %>

      <div class="upload-field" data-controller="image-upload">
        <div class="upload-field__preview">
          <% back_url = user.national_id_back.attached? ? national_id_url(user, :national_id_back, size: :thumb) : nil %>
          <img src="<%= back_url %>"
               class="upload-field__doc-thumb"
               alt=""
               data-image-upload-target="img"
               <%= "hidden" unless back_url %>>
          <div class="upload-field__doc-placeholder"
               data-image-upload-target="placeholder"
               <%= "hidden" if back_url %>>
            <% if user.national_id_back.attached? && user.national_id_back.blob.content_type == "application/pdf" %>
              PDF
            <% else %>
              &#128196;
            <% end %>
          </div>
          <% if user.national_id_back.attached? && !back_url %>
            <span class="upload-field__filename" data-image-upload-target="filename">
              <%= user.national_id_back.blob.filename %>
            </span>
          <% else %>
            <span class="upload-field__filename" data-image-upload-target="filename" hidden></span>
          <% end %>

          <div class="upload-field__controls">
            <label class="btn btn-ghost btn-sm upload-field__choose">
              <%= t("forms.choose_file") %>
              <%= f.file_field :national_id_back,
                    accept: "image/png,image/jpeg,image/webp,application/pdf",
                    class: "upload-field__input",
                    data: { "image-upload-target": "input", action: "change->image-upload#change" } %>
            </label>
            <button type="button"
                    class="btn btn-ghost btn-sm text-danger"
                    data-image-upload-target="removeBtn"
                    data-action="image-upload#remove"
                    <%= "hidden" unless user.national_id_back.attached? %>>
              <%= t("forms.remove_image") %>
            </button>
            <%= f.hidden_field :remove_national_id_back, value: "0",
                  data: { "image-upload-target": "removeFlag" } %>
          </div>
        </div>
        <p class="upload-field__hint"><%= t("admin.users.form.national_id_hint") %></p>
      </div>
    </div>
  </div>

  <%# ── Internal Administrative Notes ─────────────────────────────── %>
  <% if permitted.include?(:admin_notes) %>
  <div class="form-group form-group--full">
    <%= f.label :admin_notes, t("admin.users.form.admin_notes"), class: "form-label" %>
    <%= f.text_area :admin_notes, rows: 4,
          class: "form-control",
          placeholder: t("admin.users.form.admin_notes_placeholder") %>
    <p class="form-hint"><%= t("admin.users.form.admin_notes_hint") %></p>
  </div>
  <% end %>

  <div class="form-actions">
    <%= f.submit f.object.persisted? ? t("admin.users.edit.submit") : t("admin.users.new.submit"), class: "btn btn-primary" %>
    <%= link_to t("forms.cancel"), admin_users_path, class: "btn btn-ghost" %>
  </div>

<% end %>
