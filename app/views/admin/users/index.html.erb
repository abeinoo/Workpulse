<% content_for :title, t("admin.users.index.page_title") %>

<div class="admin-page">

  <div class="page-header">
    <h1 class="page-title"><%= t("admin.users.index.title") %></h1>
    <%= link_to new_admin_user_path, class: "btn btn-primary" do %>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      <%= t("admin.users.index.add") %>
    <% end %>
  </div>

  <div class="filter-tabs">
    <%= link_to t("admin.users.filter_active"),
          admin_users_path(status: "active"),
          class: "filter-tab #{"filter-tab--active" if @status_filter == "active"}" %>
    <%= link_to t("admin.users.filter_inactive"),
          admin_users_path(status: "inactive"),
          class: "filter-tab #{"filter-tab--active" if @status_filter == "inactive"}" %>
  </div>

  <% if @users.any? %>
    <div class="table-wrap table-wrap--cards">
      <table>
        <thead>
          <tr>
            <th><%= t("admin.users.name") %></th>
            <th><%= t("admin.users.direct_manager") %></th>
            <th><%= t("admin.users.registration_status") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr class="<%= "user-row--inactive" unless user.active? %>">
              <td>
                <div class="employee-cell">
                  <%= user_avatar_tag(user, size: :thumb) %>
                  <div>
                    <div class="employee-cell__name">
                      <%= user.full_name %>
                      <% unless user.active? %>
                        <span class="inactive-badge"><%= t("admin.users.inactive") %></span>
                      <% end %>
                    </div>
                    <div class="employee-cell__sub"><%= user.email.presence || user.phone_number %></div>
                  </div>
                </div>
              </td>
              <td class="td-secondary">
                <% if user.manager %>
                  <%= link_to user.manager.full_name, admin_user_path(user.manager), class: "link-muted" %>
                <% else %>
                  <span class="td-unassigned"><%= t("admin.users.not_assigned") %></span>
                <% end %>
              </td>
              <td>
                <%= registration_status_badge(user) %>
              </td>
              <td>
                <div class="td-actions">
                  <%= quick_call_button(user) %>
                  <% if policy(user).toggle_active? %>
                    <%= button_to toggle_active_admin_user_path(user),
                          method: :patch,
                          form: { class: "d-inline" },
                          data: user.active? ? { turbo_confirm: t("admin.users.confirm_deactivate") } : {},
                          class: "btn btn-sm #{user.active? ? 'btn-success' : 'btn-neutral'}" do %>
                      <%= user.active? ? t("admin.users.deactivate") : t("admin.users.activate") %>
                    <% end %>
                  <% end %>
                  <%= link_to t("admin.users.view"), admin_user_path(user), class: "btn btn-ghost btn-sm" %>
                  <%= link_to t("admin.users.edit_action"), edit_admin_user_path(user), class: "btn btn-secondary btn-sm" %>
                  <% unless user == current_user %>
                    <%= button_to t("admin.users.delete"),
                          admin_user_path(user),
                          method: :delete,
                          data: { turbo_confirm: t("forms.confirm_delete") },
                          class: "btn btn-danger btn-sm" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="empty-state__icon">👥</div>
      <p class="empty-state__title"><%= t("admin.users.no_users") %></p>
      <p class="empty-state__text"><%= t("admin.users.no_users_hint") %></p>
    </div>
  <% end %>

</div>
