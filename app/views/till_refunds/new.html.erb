<% content_for :title, t("till_refunds.new.title") %>

<turbo-frame id="modal">
<div class="emp-dashboard" style="padding: var(--space-5);">

  <%# ── Modal header row ──────────────────────────────────────────────── %>
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-4);">
    <div>
      <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); margin: 0 0 2px;">
        <%= t("till_refunds.new.step_label") %>
      </p>
      <h1 style="font-size: var(--text-xl); font-weight: 700; color: var(--text-1); margin: 0 0 var(--space-1); line-height: 1.2;">
        <%= t("till_refunds.new.title") %>
      </h1>
      <p style="font-size: var(--text-sm); color: var(--text-2); margin: 0;">
        <% if @reconciliation.business_date %>
          <%= t("till_refunds.new.context",
                branch: @reconciliation.branch.name,
                date: l(@reconciliation.business_date, format: :short)) %>
        <% else %>
          <%= @reconciliation.branch.name %>
        <% end %>
      </p>
      <p style="font-size: var(--text-xs); color: var(--text-3); margin: var(--space-1) 0 0;">
        <%= t("till_refunds.new.subtitle") %>
      </p>
    </div>
    <button type="button"
            data-action="click->modal#close"
            style="border: none; background: none; cursor: pointer; color: var(--text-2); padding: var(--space-2); border-radius: var(--radius-sm); flex-shrink: 0;"
            aria-label="<%= t("common.close") %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <%= form_with url: till_refunds_path, data: { turbo_frame: "_top" } do |f| %>
    <%= hidden_field_tag "till_refund[daily_reconciliation_id]", @reconciliation.id %>
    <%= hidden_field_tag "till_refund[idempotency_key]", @idempotency_key %>

    <div style="margin-bottom: var(--space-4);">
      <label for="till_refund_payment_method_id" style="display: block; font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); margin-bottom: var(--space-2);">
        <%= t("till_refunds.new.method_label") %>
      </label>
      <%= select_tag "till_refund[payment_method_id]",
            options_from_collection_for_select(@payment_methods, :id, :display_name),
            class: "form-control", required: true %>
    </div>

    <div style="margin-bottom: var(--space-4);">
      <label for="till_refund_amount" style="display: block; font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); margin-bottom: var(--space-2);">
        <%= t("till_refunds.new.amount_label") %>
      </label>
      <%= number_field_tag "till_refund[amount]", nil, class: "form-control", step: "0.01", min: "0.01", required: true %>
    </div>

    <div style="margin-bottom: var(--space-5);">
      <label for="till_refund_notes" style="display: block; font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); margin-bottom: var(--space-2);">
        <%= t("till_refunds.new.notes_label") %>
      </label>
      <%= text_area_tag "till_refund[notes]", nil, class: "form-control", rows: 2,
            placeholder: t("till_refunds.new.notes_placeholder") %>
    </div>

    <button type="submit" class="btn btn-primary" style="width: 100%;">
      <%= t("till_refunds.new.submit") %>
    </button>
  <% end %>
</div>
</turbo-frame>
