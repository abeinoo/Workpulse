<%
  show_employee = current_user.can?(:view_requests) || current_user.can?(:approve_requests)
  can_bulk      = current_user.can?(:pay_advances)
  if can_bulk
    cur_info   = Business::CURRENCIES[current_user.business.currency] || Business::CURRENCIES["SAR"]
    cur_prefix = I18n.locale.to_s == "ar" ? "" : "#{cur_info[:symbol_en]} "
    cur_suffix = I18n.locale.to_s == "ar" ? " #{cur_info[:symbol]}" : ""
  end
  col_count = 5 + (show_employee ? 1 : 0) + (can_bulk ? 1 : 0)

  # Sort-link helper: preserves all current query params, flips dir if same column
  sort_link = ->(col, label) {
    next_dir = (@filters[:sort] == col && @filters[:dir] == "asc") ? "desc" : "asc"
    arrow    = @filters[:sort] == col ? (@filters[:dir] == "asc" ? " ↑" : " ↓") : ""
    link_to "#{label}#{arrow}".html_safe,
            employee_requests_path(request.query_parameters.merge(sort: col, dir: next_dir, page: 1)),
            class: "th-sort-link"
  }
%>

<%# data-controller wraps the whole page so checkboxes, action bar and modal
    share one Stimulus scope. %>
<% bulk_data = can_bulk ? {
     controller: "request-bulk-pay",
     "request-bulk-pay-currency-prefix-value": cur_prefix,
     "request-bulk-pay-currency-suffix-value": cur_suffix
   } : {} %>
<div class="admin-page"<%= " ".html_safe + tag.attributes(data: bulk_data) if can_bulk %>>

  <div class="page-header">
    <h1 class="page-title"><%= t("requests.index.title") %></h1>
    <% unless can_bulk %>
      <%= link_to t("requests.new.title"), new_employee_request_path, class: "btn btn-primary btn-sm" %>
    <% end %>
  </div>

  <%# ── Status summary cards ────────────────────────────────────────────────── %>
  <div class="stats-grid" style="margin-bottom: var(--space-6);">
    <div class="stat-card stat-card--warning">
      <p class="stat-card__label"><%= t("requests.index.summary.pending") %></p>
      <p class="stat-card__value"><%= @status_counts["pending"] || 0 %></p>
    </div>
    <div class="stat-card stat-card--success">
      <p class="stat-card__label"><%= t("requests.index.summary.approved") %></p>
      <p class="stat-card__value"><%= @status_counts["approved"] || 0 %></p>
    </div>
    <div class="stat-card stat-card--danger">
      <p class="stat-card__label"><%= t("requests.index.summary.rejected") %></p>
      <p class="stat-card__value"><%= @status_counts["rejected"] || 0 %></p>
    </div>
    <div class="stat-card stat-card--accent">
      <p class="stat-card__label"><%= t("requests.index.summary.paid") %></p>
      <p class="stat-card__value"><%= @status_counts["paid"] || 0 %></p>
    </div>
  </div>

  <%# ── Accountant/Admin: salary advance management panel ─────────────────── %>
  <% if can_bulk %>
    <% advances_pending = @requests.select { |r| r.salary_advance? && r.approved? && r.advance.nil? } %>
    <% if advances_pending.any? %>
      <div class="alert-banner alert-banner--warning" style="margin-bottom: 1.5rem;">
        <%= t("requests.pending_disbursement", count: advances_pending.count) %>
      </div>
    <% end %>

    <%# ── Sticky bulk-action bar (hidden until a row is selected) ─────────── %>
    <div class="bulk-action-bar"
         data-request-bulk-pay-target="actionBar"
         style="display:none"
         role="toolbar"
         aria-label="<%= t("requests.bulk.toolbar_label") %>">
      <span class="bulk-action-bar__badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
        <span data-request-bulk-pay-target="countBadge">0</span>
        <%= t("requests.bulk.selected") %>
      </span>
      <span class="bulk-action-bar__sep"></span>
      <button type="button"
              class="btn btn-primary btn-sm"
              data-request-bulk-pay-target="markPaidBtn"
              data-action="click->request-bulk-pay#openModal"
              aria-disabled="true">
        <%= t("requests.bulk.mark_paid") %>
      </button>
    </div>
  <% end %>

  <%# ── Filter bar (GET form → filters live in the URL query string) ────────── %>
  <%= form_with url: employee_requests_path, method: :get, local: true, class: "filter-bar" do |f| %>
    <%# Preserve sort/dir so filtering doesn't reset the column sort %>
    <%= f.hidden_field :sort, value: @filters[:sort] if @filters[:sort].present? %>
    <%= f.hidden_field :dir,  value: @filters[:dir]  if @filters[:dir].present? %>

    <div class="filter-bar__fields">

      <%# Request Type %>
      <div class="filter-bar__field">
        <%= f.label :request_type, t("requests.filters.type"), class: "filter-bar__label" %>
        <%= f.select :request_type,
              options_for_select(
                [[ t("requests.filters.all_types"), "" ]] +
                  EmployeeRequest::REQUEST_TYPES.map { |rt| [ t("requests.types.#{rt}"), rt ] },
                @filters[:request_type]),
              {}, class: "filter-bar__select" %>
      </div>

      <%# Status %>
      <div class="filter-bar__field">
        <%= f.label :status, t("requests.filters.status"), class: "filter-bar__label" %>
        <%= f.select :status,
              options_for_select(
                [[ t("requests.filters.all_statuses"), "" ]] +
                  EmployeeRequest::STATUSES.map { |s| [ t("requests.statuses.#{s}"), s ] },
                @filters[:status]),
              {}, class: "filter-bar__select" %>
      </div>

      <%# Employee — searchable dropdown, only employees in the viewer's scope %>
      <% if show_employee && @filter_employees.any? %>
        <div class="filter-bar__field" data-controller="searchable-select">
          <%= f.label :user_id, t("requests.filters.employee"), class: "filter-bar__label" %>
          <%= f.select :user_id,
                options_for_select(
                  [[ t("requests.filters.all_employees"), "" ]] +
                    @filter_employees.map { |u| [ u.full_name, u.id ] },
                  @filters[:user_id]),
                {}, class: "filter-bar__select",
                data: { searchable_select_target: "select", search_placeholder: t("requests.filters.search_employee") } %>
        </div>
      <% end %>

      <%# Branch %>
      <% if show_employee && @filter_branches.any? %>
        <div class="filter-bar__field">
          <%= f.label :branch_id, t("requests.filters.branch"), class: "filter-bar__label" %>
          <%= f.select :branch_id,
                options_for_select(
                  [[ t("requests.filters.all_branches"), "" ]] +
                    @filter_branches.map { |b| [ b.name, b.id ] },
                  @filters[:branch_id]),
                {}, class: "filter-bar__select" %>
        </div>
      <% end %>

      <%# Date range %>
      <div class="filter-bar__field">
        <%= f.label :date_from, t("requests.filters.date_from"), class: "filter-bar__label" %>
        <%= f.date_field :date_from, value: @filters[:date_from], class: "filter-bar__input" %>
      </div>
      <div class="filter-bar__field">
        <%= f.label :date_to, t("requests.filters.date_to"), class: "filter-bar__label" %>
        <%= f.date_field :date_to, value: @filters[:date_to], class: "filter-bar__input" %>
      </div>

      <%# Per-page selector %>
      <div class="filter-bar__field">
        <%= f.label :per_page, t("requests.filters.per_page"), class: "filter-bar__label" %>
        <%= f.select :per_page,
              options_for_select(
                EmployeeRequestsController::PER_PAGE_OPTIONS.map { |n| [ n.to_s, n ] },
                @per_page),
              {}, class: "filter-bar__select" %>
      </div>

    </div>

    <div class="filter-bar__actions">
      <%= f.submit t("requests.filters.apply"), class: "btn btn-sm btn-primary" %>
      <% if @active_filters %>
        <%= link_to t("requests.filters.clear"), employee_requests_path, class: "btn btn-sm btn-ghost" %>
      <% end %>
    </div>
  <% end %>

  <%# ── Active filter chips ────────────────────────────────────────────────── %>
  <% if @active_filters %>
    <%
      chips = []
      if @filters[:request_type].present?
        chips << [ :request_type, "#{t('requests.filters.type')}: #{t("requests.types.#{@filters[:request_type]}", default: @filters[:request_type])}" ]
      end
      if @filters[:status].present?
        chips << [ :status, "#{t('requests.filters.status')}: #{t("requests.statuses.#{@filters[:status]}", default: @filters[:status])}" ]
      end
      if @filters[:user_id].present?
        emp = @filter_employees.find { |u| u.id.to_s == @filters[:user_id].to_s }
        chips << [ :user_id, "#{t('requests.filters.employee')}: #{emp&.full_name || @filters[:user_id]}" ]
      end
      if @filters[:branch_id].present?
        br = @filter_branches.find { |b| b.id.to_s == @filters[:branch_id].to_s }
        chips << [ :branch_id, "#{t('requests.filters.branch')}: #{br&.name || @filters[:branch_id]}" ]
      end
      chips << [ :date_from, "#{t('requests.filters.date_from')}: #{@filters[:date_from]}" ] if @filters[:date_from].present?
      chips << [ :date_to,   "#{t('requests.filters.date_to')}: #{@filters[:date_to]}" ]   if @filters[:date_to].present?
    %>
    <div class="filter-chips" aria-label="<%= t('requests.filters.active') %>">
      <% chips.each do |key, text| %>
        <span class="filter-chip">
          <%= text %>
          <%= link_to "×", employee_requests_path(@filters.except(key).to_h),
                class: "filter-chip__remove",
                "aria-label": t("requests.filters.remove", filter: text) %>
        </span>
      <% end %>
      <%= link_to t("requests.filters.clear"), employee_requests_path, class: "filter-chip filter-chip--clear" %>
    </div>
  <% end %>

  <%# ── Results meta ─────────────────────────────────────────────────────────── %>
  <% if @total_count > 0 %>
    <p class="table-meta">
      <%= t("requests.index.page_info",
            from:  [(@page - 1) * @per_page + 1, @total_count].min,
            to:    [@page * @per_page, @total_count].min,
            total: @total_count,
            page:  @page,
            pages: @total_pages) %>
    </p>
  <% end %>

  <div class="table-wrap table-wrap--cards">
    <table>
      <thead>
        <tr>
          <% if can_bulk %>
            <th class="td-check">
              <input type="checkbox"
                     class="bulk-check-all"
                     data-action="change->request-bulk-pay#toggleAll"
                     aria-label="<%= t("requests.bulk.select_all") %>">
            </th>
          <% end %>
          <% if show_employee %>
            <th><%= sort_link.call("employee_name", t("requests.employee")) %></th>
          <% end %>
          <th><%= sort_link.call("request_type", t("requests.type")) %></th>
          <th><%= sort_link.call("created_at", t("requests.date")) %></th>
          <th><%= t("requests.amount") %></th>
          <th><%= sort_link.call("status", t("requests.status")) %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @requests.each do |req| %>
          <% payable = req.salary_advance? && req.approved? && req.advance.nil? && policy(req).pay? %>
          <tr>
            <% if can_bulk %>
              <td class="td-check">
                <% if payable %>
                  <input type="checkbox"
                         class="bulk-check-row"
                         value="<%= req.id %>"
                         data-amount="<%= req.amount %>"
                         data-action="change->request-bulk-pay#rowChanged"
                         aria-label="<%= req.user.full_name %>">
                <% end %>
              </td>
            <% end %>
            <% if show_employee %>
              <td data-label="<%= t("requests.employee") %>"><%= req.user.full_name %></td>
            <% end %>
            <td data-label="<%= t("requests.type") %>"><span class="badge badge-neutral"><%= t("requests.types.#{req.request_type}") %></span></td>
            <td class="td-secondary" data-label="<%= t("requests.date") %>"><%= local_date(req.requested_for_date) %></td>
            <td class="td-secondary" data-label="<%= t("requests.amount") %>">
              <% if req.salary_advance? && req.amount.present? %>
                <%= format_currency(req.amount, precision: 0) %>
              <% elsif (req.late_permission? || req.early_leave?) && req.duration_minutes.present? %>
                <%= t("requests.show.minutes_value", count: req.duration_minutes) %>
              <% else %>
                —
              <% end %>
            </td>
            <td data-label="<%= t("requests.status") %>">
              <span class="badge <%= request_status_badge_class(req) %>">
                <%= request_status_label(req) %>
              </span>
            </td>
            <td class="td-actions">
              <% if req.pending? && policy(req).approve? %>
                <% unless req.punch_correction? %>
                  <%= button_to t("requests.approve"),
                        approve_employee_request_path(req),
                        method: :patch,
                        class: "btn btn-sm btn-success",
                        data: { turbo_confirm: t("requests.confirm_approve") } %>
                <% end %>
                <%# Reject requires a reason — handled on the detail page %>
                <%= link_to t("requests.reject"),
                      employee_request_path(req),
                      class: "btn btn-sm btn-danger" %>
              <% end %>
              <% if req.salary_advance? && req.approved? && policy(req).pay? %>
                <%= button_to t("requests.pay"),
                      pay_employee_request_path(req),
                      method: :patch,
                      class: "btn btn-sm btn-primary",
                      data: { turbo_confirm: t("requests.confirm_pay", name: req.user.full_name) } %>
              <% end %>
              <%= link_to t("payroll.view"), employee_request_path(req), class: "link-muted" %>
            </td>
          </tr>
        <% end %>
        <% if @requests.empty? %>
          <tr><td colspan="<%= col_count %>" class="td-empty"><%= t("requests.no_requests") %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# ── Pagination ─────────────────────────────────────────────────────────── %>
  <% if @total_pages > 1 %>
    <nav class="pagination" aria-label="<%= t("pagination.label") %>">
      <% if @page > 1 %>
        <%= link_to t("pagination.prev"),
              employee_requests_path(request.query_parameters.merge(page: @page - 1)),
              class: "pagination__btn pagination__btn--prev" %>
      <% end %>

      <% start_page = [[@page - 2, 1].max, [@total_pages - 4, 1].max].min
         end_page   = [start_page + 4, @total_pages].min %>

      <% if start_page > 1 %>
        <%= link_to "1",
              employee_requests_path(request.query_parameters.merge(page: 1)),
              class: "pagination__btn" %>
        <span class="pagination__ellipsis">…</span>
      <% end %>

      <% (start_page..end_page).each do |p| %>
        <%= link_to p.to_s,
              employee_requests_path(request.query_parameters.merge(page: p)),
              class: "pagination__btn #{'pagination__btn--active' if p == @page}" %>
      <% end %>

      <% if end_page < @total_pages %>
        <span class="pagination__ellipsis">…</span>
        <%= link_to @total_pages.to_s,
              employee_requests_path(request.query_parameters.merge(page: @total_pages)),
              class: "pagination__btn" %>
      <% end %>

      <% if @page < @total_pages %>
        <%= link_to t("pagination.next"),
              employee_requests_path(request.query_parameters.merge(page: @page + 1)),
              class: "pagination__btn pagination__btn--next" %>
      <% end %>
    </nav>
  <% end %>

  <%# ── CSV export for accountants ─────────────────────────────────────────── %>
  <% if can_bulk %>
    <div style="margin-top: 1rem; text-align: end;">
      <%= link_to t("requests.export_csv"), employee_requests_path(@filters.to_h.merge(format: :csv)), class: "btn btn-secondary btn-sm" %>
    </div>

    <%# ── Mark Selected as Paid confirmation modal ─────────────────────────── %>
    <div class="modal-overlay"
         style="display:none"
         data-request-bulk-pay-target="modal"
         data-action="click->request-bulk-pay#overlayClick">
      <div class="modal-card" role="dialog"
           aria-labelledby="bulk-pay-title" aria-modal="true">
        <h3 class="modal-card__title" id="bulk-pay-title">
          <%= t("requests.bulk.modal_title") %>
        </h3>

        <%= form_with url: bulk_pay_employee_requests_path, method: :patch, local: true do |f| %>
          <%# request_ids[] injected by JS on open %>
          <div data-request-bulk-pay-target="ids"></div>

          <div class="bulk-pay-summary">
            <div class="bulk-pay-summary__item">
              <span class="bulk-pay-summary__label"><%= t("requests.bulk.summary_count") %></span>
              <span class="bulk-pay-summary__value" data-request-bulk-pay-target="modalCount">0</span>
            </div>
            <div class="bulk-pay-summary__item">
              <span class="bulk-pay-summary__label"><%= t("requests.bulk.summary_total") %></span>
              <span class="bulk-pay-summary__value" data-request-bulk-pay-target="modalTotal">—</span>
            </div>
          </div>

          <div class="form-group">
            <%= f.label :paid_at, t("requests.bulk.payment_date"),
                  class: "form-label form-label--required" %>
            <%= f.date_field :paid_at,
                  value: Date.current,
                  required: true,
                  class: "form-control",
                  data: { controller: "datepicker" } %>
          </div>

          <div class="form-group">
            <%= f.label :notes, t("requests.bulk.notes"), class: "form-label" %>
            <%= f.text_area :notes, rows: 3, class: "form-control",
                  placeholder: t("requests.bulk.notes_placeholder") %>
          </div>

          <p class="form-hint"><%= t("requests.bulk.modal_hint") %></p>

          <div class="form-actions">
            <%= f.submit t("requests.bulk.confirm"), class: "btn btn-primary" %>
            <button type="button" class="btn btn-ghost"
                    data-action="click->request-bulk-pay#closeModal">
              <%= t("forms.cancel") %>
            </button>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

</div>
