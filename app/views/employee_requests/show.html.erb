<div class="form-page">

  <div class="page-header">
    <div>
      <%= link_to t("requests.show.back"), employee_requests_path, class: "back-link" %>
      <h1 class="page-title"><%= t("requests.types.#{@request.request_type}") %></h1>
      <p class="page-subtitle"><%= local_date(@request.requested_for_date) %></p>
    </div>
    <span class="badge <%= request_status_badge_class(@request) %>">
      <%= request_status_label(@request) %>
    </span>
  </div>

  <%# Outside-window warning for punch corrections. The resulting-duration
      warning is shown separately in its own card (_resulting_duration). ── %>
  <%# Reviewer-only sections are gated on @reviewer_view (EmployeeRequestPolicy#review_details?);
      for requesters the validation data is never computed or rendered. %>
  <% if @reviewer_view && (@request.pending? || @request.approved?) && !@assessment.inside_window? %>
    <div class="alert alert-warning window-alert" role="alert" data-testid="window-alert">
      <p class="window-alert__title">⚠️ <%= t("requests.show.window.alert_outside_title") %></p>
      <p><%= t("requests.show.window.alert_outside") %></p>
      <dl class="window-alert__facts">
        <div><dt><%= t("requests.show.window.work_date") %>:</dt> <dd><%= local_date(@request.requested_for_date) %></dd></div>
        <%= render "punch_facts", assessment: @assessment %>
      </dl>
    </div>
  <% end %>
  <% if @reviewer_view && (severity = @attendance_record&.duration_severity) %>
    <div class="alert <%= severity == :critical ? 'alert-danger' : 'alert-warning' %> window-alert"
         role="alert" data-testid="duration-alert">
      <p class="window-alert__title">⚠️ <%= t("attendance.abnormal_duration", duration: format_duration_hm(@attendance_record.worked_minutes)) %></p>
      <p><%= t("attendance.abnormal_duration_hint", hours: Attendance::DurationCheck.threshold_hours(severity, business: current_user.business)) %></p>
    </div>
  <% end %>

  <div class="info-card">
    <% if current_user.can?(:view_requests) || current_user.can?(:approve_requests) %>
      <div class="info-card__row">
        <span class="info-card__label"><%= t("requests.employee") %></span>
        <span><%= @request.user.full_name %></span>
      </div>
    <% end %>
    <% if @request.salary_advance? && @request.amount.present? %>
      <div class="info-card__row">
        <span class="info-card__label"><%= t("requests.amount") %></span>
        <span><%= format_currency(@request.amount) %></span>
      </div>
    <% end %>
    <% if @request.punch_correction? %>
      <div class="info-card__row">
        <span class="info-card__label"><%= t("requests.show.correction_type") %></span>
        <span><%= t("requests.correction_types.#{@request.correction_type}") %></span>
      </div>
      <div class="info-card__row">
        <span class="info-card__label"><%= t("requests.show.proposed_punch") %></span>
        <span><%= local_date_clock_12h(@request.proposed_date, @request.proposed_time) %></span>
      </div>
      <% if @request.approved_time.present? || @request.approved_punch_at.present? %>
        <div class="info-card__row">
          <span class="info-card__label"><%= t("requests.show.approved_time") %></span>
          <span><%= local_date_clock_12h(@request.final_punch_date, @request.final_punch_time) %></span>
        </div>
      <% end %>
    <% end %>
    <% if @request.late_permission? || @request.early_leave? %>
      <% summary = requested_permission_summary(@request) %>
      <div class="info-card__row">
        <span class="info-card__label"><%= t("requests.show.minutes_requested") %></span>
        <span><%= t("requests.show.minutes_value", count: summary[:minutes]) %></span>
      </div>
      <% if summary[:time].present? %>
        <div class="info-card__row">
          <span class="info-card__label">
            <%= @request.early_leave? ? t("requests.show.requested_departure") : t("requests.show.requested_arrival") %>
          </span>
          <span><%= clock_12h(summary[:time]) %></span>
        </div>
      <% end %>
    <% end %>
    <% if @request.reason.present? %>
      <div class="info-card__row">
        <span class="info-card__label"><%= t("requests.reason") %></span>
        <span><%= @request.reason %></span>
      </div>
    <% end %>
    <% if @request.reviewed_at %>
      <div class="info-card__row">
        <span class="info-card__label">
          <% if @request.paid? %>
            <%= t("requests.disbursed") %>
          <% elsif @request.rejected? %>
            <%= t("requests.rejected_by") %>
          <% else %>
            <%= t("requests.reviewed") %>
          <% end %>
        </span>
        <span>
          <%= local_datetime_12h(@request.reviewed_at) %>
          <% if @request.reviewed_by %>
            <%= t("requests.by_actor", name: @request.reviewed_by.full_name) %>
          <% end %>
        </span>
      </div>
    <% end %>
    <% if @request.response_note.present? %>
      <div class="info-card__row">
        <span class="info-card__label">
          <%= @request.rejected? ? t("requests.rejection_reason") : t("requests.note") %>
        </span>
        <span><%= @request.response_note %></span>
      </div>
    <% end %>
  </div>

  <%# Punch correction: original attendance data + audit trail ── %>
  <% if @request.punch_correction? %>
    <div class="info-card" style="margin-top: 1rem;">
      <p class="info-card__section-title"><%= t("requests.show.original_attendance") %></p>
      <% if @attendance_record %>
        <div class="info-card__row">
          <span class="info-card__label"><%= t("requests.show.original_check_in") %></span>
          <span><%= @attendance_record.check_in_at ? local_datetime_12h(@attendance_record.check_in_at, separator: " — ") : "—" %></span>
        </div>
        <div class="info-card__row">
          <span class="info-card__label"><%= t("requests.show.original_check_out") %></span>
          <span><%= @attendance_record.check_out_at ? local_datetime_12h(@attendance_record.check_out_at, separator: " — ") : t("requests.show.missing") %></span>
        </div>
        <div class="info-card__row">
          <span class="info-card__label"><%= t("attendance.status") %></span>
          <span><%= t("attendance.statuses.#{@attendance_record.status}", default: @attendance_record.status.humanize) %></span>
        </div>
      <% else %>
        <p class="info-card__empty"><%= t("requests.show.no_attendance_record") %></p>
      <% end %>
    </div>

    <% if @reviewer_view %>
      <%= render "attendance_window", assessment: @assessment %>
      <%= render "resulting_duration", assessment: @assessment %>
    <% end %>

    <%# Audit trail once approved ── %>
    <% if @request.approved? && @request.original_check_in_at.present? %>
      <div class="info-card" style="margin-top: 1rem;">
        <p class="info-card__section-title"><%= t("requests.show.audit_trail") %></p>
        <div class="info-card__row">
          <span class="info-card__label"><%= t("requests.show.original_check_in") %></span>
          <span><%= local_datetime_12h(@request.original_check_in_at, separator: " — ") %></span>
        </div>
        <% if @request.original_check_out_at.present? %>
          <div class="info-card__row">
            <span class="info-card__label"><%= t("requests.show.original_check_out") %></span>
            <span><%= local_datetime_12h(@request.original_check_out_at, separator: " — ") %></span>
          </div>
        <% end %>
        <div class="info-card__row">
          <span class="info-card__label"><%= t("requests.show.approved_time") %></span>
          <span>
            <%= @assessment ? local_datetime_12h(@assessment.effective_at, separator: " — ")
                            : local_date_clock_12h(@request.final_punch_date, @request.final_punch_time) %>
          </span>
        </div>
      </div>
    <% end %>

    <%# Reviewer changes: original proposed value → value applied at review ── %>
    <% if @request.reviewed_at && !@request.rejected? %>
      <% reviewer_changes = @request.reviewer_time_changes %>
      <div class="info-card review-changes" style="margin-top: 1rem;" data-testid="reviewer-changes">
        <p class="info-card__section-title"><%= t("requests.show.reviewer_changes") %></p>
        <% if reviewer_changes.any? %>
          <% reviewer_changes.each do |change| %>
            <div class="info-card__row" data-testid="reviewer-change-<%= change.field %>">
              <span class="info-card__label"><%= t("requests.show.reviewer_field_#{change.field}") %></span>
              <span class="review-change">
                <span class="review-change__visual" aria-hidden="true">
                  <span class="review-change__old"><%= local_date_clock_12h(change.proposed_date, change.proposed) %></span>
                  <span class="review-change__arrow">→</span>
                  <strong class="review-change__new"><%= local_date_clock_12h(change.approved_date, change.approved) %></strong>
                </span>
                <span class="sr-only">
                  <%= t("requests.show.reviewer_change_sr", from: local_date_clock_12h(change.proposed_date, change.proposed), to: local_date_clock_12h(change.approved_date, change.approved)) %>
                </span>
              </span>
            </div>
          <% end %>
        <% else %>
          <div class="info-card__row" data-testid="reviewer-approved-as-proposed">
            <span class="info-card__label"><%= t("requests.show.approved_as_proposed") %></span>
            <span><%= local_date_clock_12h(@request.proposed_date, @request.proposed_time) %></span>
          </div>
        <% end %>
        <div class="info-card__row">
          <span class="info-card__label">
            <%= reviewer_changes.any? ? t("requests.show.reviewer_changed_by") : t("requests.show.reviewer_approved_by") %>
          </span>
          <span><%= @request.reviewed_by&.full_name || "—" %></span>
        </div>
        <div class="info-card__row">
          <span class="info-card__label"><%= t("requests.show.review_date") %></span>
          <span><%= local_datetime_12h(@request.reviewed_at) %></span>
        </div>
      </div>
    <% end %>
  <% end %>

  <%# Manager approves/rejects pending requests %>
  <% if @request.pending? && policy(@request).approve? %>
    <div class="form-card" style="margin-top: 1rem;">
      <% if @request.punch_correction? %>
        <%# Punch correction: approval form with an editable final date AND time.
            Prefilled with the employee's proposal (or the reviewer's last attempt). %>
        <p class="form-card__title"><%= t("requests.show.review_correction") %></p>
        <p class="review-correction-type" data-testid="review-correction-type">
          <span class="info-card__label"><%= t("requests.show.correction_type") %>:</span>
          <strong><%= t("requests.correction_types.#{@request.correction_type}") %></strong>
        </p>
        <%= form_with url: approve_employee_request_path(@request), method: :patch, local: true do |f| %>
          <div class="form-grid">
            <%# ONE datetime input (date + time together). The value is the
                datetime-local form "YYYY-MM-DDTHH:MM"; the picker shows
                "DD/MM/YYYY, hh:mm AM/PM". %>
            <div class="form-group form-group--full">
              <%= label_tag :approved_at, t("requests.show.approved_at_label"), class: "form-label" %>
              <%= datetime_local_field_tag :approved_at,
                    "#{(@review_date || @request.proposed_punch_date).iso8601}T#{EmployeeRequest.normalized_clock(@review_time || @request.proposed_time)}",
                    class: "form-control",
                    data: { controller: "datepicker",
                            datepicker_mode_value: "datetime",
                            datepicker_date_format_value: "Y-m-d\TH:i",
                            datepicker_alt_format_value: "d/m/Y, h:i K",
                            datepicker_time24hr_value: false } %>
              <p class="form-hint"><%= t("requests.show.approved_punch_hint") %></p>
            </div>
            <div class="form-group form-group--full">
              <%= label_tag :response_note, t("requests.show.response_note_label"), class: "form-label" %>
              <%= text_area_tag :response_note, nil, rows: 2, class: "form-control",
                    placeholder: t("requests.show.response_note_placeholder") %>
            </div>
          </div>
          <%# Out-of-window / abnormal-duration corrections need an explicit
              confirmation; Requests::Approver enforces it server-side too. %>
          <% if @reviewer_view && @assessment.requires_confirmation? %>
            <div class="alert alert-warning window-confirm" data-testid="window-confirm">
              <% unless @assessment.inside_window? %>
                <p class="window-alert__title">⚠️ <%= t("requests.show.window.alert_outside") %></p>
              <% end %>
              <% if @assessment.duration_severity %>
                <p class="window-alert__title">⚠️ <%= t("requests.show.window.alert_duration", duration: format_duration_hm(@assessment.projected_worked_minutes)) %></p>
              <% end %>
              <dl class="window-alert__facts">
                <div><dt><%= t("requests.show.window.work_date") %>:</dt> <dd><%= local_date(@request.requested_for_date) %></dd></div>
                <%= render "punch_facts", assessment: @assessment %>
              </dl>
              <p><strong><%= t("requests.show.window.confirm_question") %></strong></p>
              <label class="window-confirm__check">
                <%= check_box_tag :confirm_out_of_window, "1", false, required: true %>
                <span><%= t("requests.show.window.confirm_label") %></span>
              </label>
            </div>
          <% end %>
          <div class="form-actions">
            <%= f.submit t("requests.approve"), class: "btn btn-primary" %>
          </div>
        <% end %>
      <% else %>
        <div class="form-actions">
          <%= button_to t("requests.approve"), approve_employee_request_path(@request),
                method: :patch, class: "btn btn-primary" %>
        </div>
      <% end %>

      <%# Reject (all request types) — captures a rejection reason the employee can see %>
      <div data-controller="collapsible" style="margin-top: 0.75rem;">
        <button type="button" class="btn btn-danger"
                data-action="click->collapsible#toggle"
                data-collapsible-target="trigger"
                aria-expanded="false">
          <%= t("requests.reject") %>
        </button>
        <div data-collapsible-target="content" hidden style="margin-top: 0.75rem;">
          <%= form_with url: reject_employee_request_path(@request), method: :patch, local: true do |f| %>
            <div class="form-group form-group--full">
              <%= label_tag :response_note, t("requests.show.rejection_reason_label"), class: "form-label form-label--required" %>
              <%= text_area_tag :response_note, nil, rows: 2, class: "form-control", required: true,
                    placeholder: t("requests.show.rejection_reason_placeholder") %>
              <p class="form-hint"><%= t("requests.show.rejection_reason_hint") %></p>
            </div>
            <div class="form-actions">
              <%= f.submit t("requests.show.confirm_reject_btn"), class: "btn btn-danger" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%# Accountant/admin marks approved salary advance as paid %>
  <% if @request.salary_advance? && @request.approved? && policy(@request).pay? %>
    <div class="info-card" style="margin-top: 1rem; background: var(--surface-2, #f8f9fa);">
      <p style="font-size: var(--text-sm); color: var(--text-2); margin: 0 0 0.75rem;">
        <%= t("requests.mark_paid_note") %>
        <%= t("requests.advance_note") %>
      </p>
      <%= button_to t("requests.mark_paid_confirm"),
            pay_employee_request_path(@request),
            method: :patch, class: "btn btn-primary",
            data: { turbo_confirm: t("requests.confirm_pay", name: @request.user.full_name) } %>
    </div>
  <% end %>

  <%# Cancellation ── shown to employee (own pending) and authorized reviewers (pending/approved) %>
  <% if policy(@request).cancel? %>
    <div class="form-card" style="margin-top: 1rem;" data-controller="collapsible">
      <button type="button" class="btn btn-danger"
              data-action="click->collapsible#toggle"
              data-collapsible-target="trigger"
              aria-expanded="false">
        <%= t("requests.cancel") %>
      </button>
      <div data-collapsible-target="content" hidden style="margin-top: 0.75rem;">
        <%= form_with url: cancel_employee_request_path(@request), method: :patch, local: true do |f| %>
          <div class="form-group form-group--full">
            <%= label_tag :cancellation_reason,
                  t("requests.show.cancellation_reason_label"),
                  class: "form-label form-label--required" %>
            <%= text_area_tag :cancellation_reason, nil, rows: 2, class: "form-control",
                  required: true,
                  placeholder: t("requests.show.cancellation_reason_placeholder") %>
          </div>
          <div class="form-actions">
            <%= f.submit t("requests.show.confirm_cancel_btn"), class: "btn btn-danger" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Cancellation audit trail %>
  <% if @request.cancelled? %>
    <div class="info-card" style="margin-top: 1rem;">
      <div class="info-card__row">
        <span class="info-card__label"><%= t("requests.cancelled_at") %></span>
        <span>
          <%= local_datetime_12h(@request.cancelled_at) %>
          <% if @request.cancelled_by %>
            <%= t("requests.by_actor", name: @request.cancelled_by.full_name) %>
          <% end %>
        </span>
      </div>
      <% if @request.cancellation_reason.present? %>
        <div class="info-card__row">
          <span class="info-card__label"><%= t("requests.cancellation_reason") %></span>
          <span><%= @request.cancellation_reason %></span>
        </div>
      <% end %>
    </div>
  <% end %>

</div>
