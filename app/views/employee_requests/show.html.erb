<div class="form-page">

  <div class="page-header">
    <div>
      <%= link_to t("requests.show.back"), employee_requests_path, class: "back-link" %>
      <h1 class="page-title"><%= t("requests.types.#{@request.request_type}") %></h1>
      <p class="page-subtitle"><%= local_date(@request.requested_for_date) %></p>
    </div>
    <span class="badge <%= request_status_badge_class(@request) %>">
      <%= t("requests.statuses.#{@request.status}") %>
    </span>
  </div>

  <div class="info-card">
    <% if current_user.can?(:view_requests) || current_user.can?(:approve_requests) %>
      <div class="info-card__row">
        <span class="info-card__label"><%= t("requests.employee") %></span>
        <span><%= @request.user.full_name %></span>
      </div>
    <% end %>
    <% if @request.salary_advance? && @request.amount.present? %>
      <div class="info-card__row">
        <span class="info-card__label"><%= t("requests.amount") %></span>
        <span><%= format_currency(@request.amount) %></span>
      </div>
    <% end %>
    <% if @request.punch_correction? %>
      <div class="info-card__row">
        <span class="info-card__label"><%= t("requests.show.correction_type") %></span>
        <span><%= t("requests.correction_types.#{@request.correction_type}") %></span>
      </div>
      <div class="info-card__row">
        <span class="info-card__label"><%= t("requests.show.proposed_punch") %></span>
        <span>
          <%= local_date(@request.proposed_date) if @request.proposed_date %>
          <%= @request.proposed_time %>
        </span>
      </div>
      <% if @request.approved_time.present? %>
        <div class="info-card__row">
          <span class="info-card__label"><%= t("requests.show.approved_time") %></span>
          <span><%= @request.approved_time %></span>
        </div>
      <% end %>
    <% end %>
    <% if @request.late_permission? || @request.early_leave? %>
      <% summary = requested_permission_summary(@request) %>
      <div class="info-card__row">
        <span class="info-card__label"><%= t("requests.show.minutes_requested") %></span>
        <span><%= t("requests.show.minutes_value", count: summary[:minutes]) %></span>
      </div>
      <% if summary[:time].present? %>
        <div class="info-card__row">
          <span class="info-card__label">
            <%= @request.early_leave? ? t("requests.show.requested_departure") : t("requests.show.requested_arrival") %>
          </span>
          <span><%= summary[:time] %></span>
        </div>
      <% end %>
    <% end %>
    <% if @request.reason.present? %>
      <div class="info-card__row">
        <span class="info-card__label"><%= t("requests.reason") %></span>
        <span><%= @request.reason %></span>
      </div>
    <% end %>
    <% if @request.reviewed_at %>
      <div class="info-card__row">
        <span class="info-card__label">
          <% if @request.paid? %>
            <%= t("requests.disbursed") %>
          <% elsif @request.rejected? %>
            <%= t("requests.rejected_by") %>
          <% else %>
            <%= t("requests.reviewed") %>
          <% end %>
        </span>
        <span>
          <%= local_datetime(@request.reviewed_at) %>
          <% if @request.reviewed_by %>
            <%= t("requests.by_actor", name: @request.reviewed_by.full_name) %>
          <% end %>
        </span>
      </div>
    <% end %>
    <% if @request.response_note.present? %>
      <div class="info-card__row">
        <span class="info-card__label">
          <%= @request.rejected? ? t("requests.rejection_reason") : t("requests.note") %>
        </span>
        <span><%= @request.response_note %></span>
      </div>
    <% end %>
  </div>

  <%# Punch correction: original attendance data + audit trail ── %>
  <% if @request.punch_correction? %>
    <div class="info-card" style="margin-top: 1rem;">
      <p class="info-card__section-title"><%= t("requests.show.original_attendance") %></p>
      <% if @attendance_record %>
        <div class="info-card__row">
          <span class="info-card__label"><%= t("requests.show.original_check_in") %></span>
          <span><%= @attendance_record.check_in_at ? local_time(@attendance_record.check_in_at) : "—" %></span>
        </div>
        <div class="info-card__row">
          <span class="info-card__label"><%= t("requests.show.original_check_out") %></span>
          <span><%= @attendance_record.check_out_at ? local_time(@attendance_record.check_out_at) : t("requests.show.missing") %></span>
        </div>
        <div class="info-card__row">
          <span class="info-card__label"><%= t("attendance.status") %></span>
          <span><%= t("attendance.statuses.#{@attendance_record.status}", default: @attendance_record.status.humanize) %></span>
        </div>
      <% else %>
        <p class="info-card__empty"><%= t("requests.show.no_attendance_record") %></p>
      <% end %>
    </div>

    <%# Audit trail once approved ── %>
    <% if @request.approved? && @request.original_check_in_at.present? %>
      <div class="info-card" style="margin-top: 1rem;">
        <p class="info-card__section-title"><%= t("requests.show.audit_trail") %></p>
        <div class="info-card__row">
          <span class="info-card__label"><%= t("requests.show.original_check_in") %></span>
          <span><%= local_time(@request.original_check_in_at) %></span>
        </div>
        <% if @request.original_check_out_at.present? %>
          <div class="info-card__row">
            <span class="info-card__label"><%= t("requests.show.original_check_out") %></span>
            <span><%= local_time(@request.original_check_out_at) %></span>
          </div>
        <% end %>
        <div class="info-card__row">
          <span class="info-card__label"><%= t("requests.show.approved_time") %></span>
          <span><%= @request.approved_time.presence || @request.proposed_time %></span>
        </div>
      </div>
    <% end %>
  <% end %>

  <%# Manager approves/rejects pending requests %>
  <% if @request.pending? && policy(@request).approve? %>
    <div class="form-card" style="margin-top: 1rem;">
      <% if @request.punch_correction? %>
        <%# Punch correction: full approval form with editable approved_time %>
        <p class="form-card__title"><%= t("requests.show.review_correction") %></p>
        <%= form_with url: approve_employee_request_path(@request), method: :patch, local: true do |f| %>
          <div class="form-grid">
            <div class="form-group">
              <%= label_tag :approved_time, t("requests.show.approved_time_label"), class: "form-label" %>
              <%= time_field_tag :approved_time,
                    @request.proposed_time,
                    class: "form-control",
                    data: { controller: "datepicker", datepicker_mode_value: "time" } %>
              <p class="form-hint"><%= t("requests.show.approved_time_hint") %></p>
            </div>
            <div class="form-group form-group--full">
              <%= label_tag :response_note, t("requests.show.response_note_label"), class: "form-label" %>
              <%= text_area_tag :response_note, nil, rows: 2, class: "form-control",
                    placeholder: t("requests.show.response_note_placeholder") %>
            </div>
          </div>
          <div class="form-actions">
            <%= f.submit t("requests.approve"), class: "btn btn-primary" %>
          </div>
        <% end %>
      <% else %>
        <div class="form-actions">
          <%= button_to t("requests.approve"), approve_employee_request_path(@request),
                method: :patch, class: "btn btn-primary" %>
        </div>
      <% end %>

      <%# Reject (all request types) — captures a rejection reason the employee can see %>
      <div data-controller="collapsible" style="margin-top: 0.75rem;">
        <button type="button" class="btn btn-danger"
                data-action="click->collapsible#toggle"
                data-collapsible-target="trigger"
                aria-expanded="false">
          <%= t("requests.reject") %>
        </button>
        <div data-collapsible-target="content" hidden style="margin-top: 0.75rem;">
          <%= form_with url: reject_employee_request_path(@request), method: :patch, local: true do |f| %>
            <div class="form-group form-group--full">
              <%= label_tag :response_note, t("requests.show.rejection_reason_label"), class: "form-label form-label--required" %>
              <%= text_area_tag :response_note, nil, rows: 2, class: "form-control", required: true,
                    placeholder: t("requests.show.rejection_reason_placeholder") %>
              <p class="form-hint"><%= t("requests.show.rejection_reason_hint") %></p>
            </div>
            <div class="form-actions">
              <%= f.submit t("requests.show.confirm_reject_btn"), class: "btn btn-danger" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%# Accountant/admin marks approved salary advance as paid %>
  <% if @request.salary_advance? && @request.approved? && policy(@request).pay? %>
    <div class="info-card" style="margin-top: 1rem; background: var(--surface-2, #f8f9fa);">
      <p style="font-size: var(--text-sm); color: var(--text-2); margin: 0 0 0.75rem;">
        <%= t("requests.mark_paid_note") %>
        <%= t("requests.advance_note") %>
      </p>
      <%= button_to t("requests.mark_paid_confirm"),
            pay_employee_request_path(@request),
            method: :patch, class: "btn btn-primary",
            data: { turbo_confirm: t("requests.confirm_pay", name: @request.user.full_name) } %>
    </div>
  <% end %>

</div>
