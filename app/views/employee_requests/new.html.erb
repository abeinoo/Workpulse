<% content_for :title, "#{t('requests.new.title')} — WorkPulse" %>

<div class="form-page">
  <%= link_to employee_requests_path, class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    <%= t("requests.new.back") %>
  <% end %>

  <h1 class="page-title">
    <% if @for_user %>
      <%= t("requests.new.title") %> <%= @for_user.full_name %>
    <% else %>
      <%= t("requests.new.title") %>
    <% end %>
  </h1>

  <%# Manager: "for whom" selector shown when no pre-selected employee %>
  <% if current_user.can?(:approve_requests) && @for_user.nil? && @managed_employees.any? %>
    <div class="for-whom-bar">
      <span class="for-whom-bar__label"><%= t("requests.new.creating_for") %></span>
      <div class="for-whom-bar__options">
        <span class="for-whom-chip for-whom-chip--active"><%= t("requests.new.yourself") %></span>
        <% @managed_employees.each do |emp| %>
          <%= link_to new_employee_request_path(for_user_id: emp.id),
                class: "for-whom-chip" do %>
            <%= emp.full_name %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% elsif @for_user %>
    <div class="for-whom-bar for-whom-bar--selected">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      <%= t("requests.new.behalf_of", name: @for_user.full_name) %>
      &ensp;
      <%= link_to t("requests.new.change"), new_employee_request_path, class: "for-whom-bar__change" %>
    </div>
  <% end %>

  <%= form_with model: @request, url: employee_requests_path, local: true, class: "form-card" do |f| %>
    <% if @for_user %>
      <%= hidden_field_tag "employee_request[for_user_id]", @for_user.id %>
    <% end %>

    <%= render "shared/error_messages", object: @request %>

    <div class="form-grid">
      <div class="form-group form-group--full">
        <%= f.label :request_type, t("requests.new.type_label"), class: "form-label form-label--required" %>
        <%= f.select :request_type,
              @allowed_request_types.map { |rt| [t("requests.types.#{rt}"), rt] },
              { include_blank: t("forms.select") },
              class: "form-control",
              id: "request_type_select" %>
        <% if @allowed_request_types.exclude?("late_permission") %>
          <p class="form-hint form-hint--info"><%= t("requests.new.late_permission_unavailable") %></p>
        <% end %>
      </div>

      <%# Amount — shown only for salary advance (JS progressively enhances; baseline always visible) %>
      <div class="form-group form-group--full" id="amount-field">
        <%= f.label :amount, t("requests.new.amount_label"), class: "form-label form-label--required" %>
        <%= f.number_field :amount,
              class: "form-control",
              min: 1,
              step: "0.01",
              placeholder: t("requests.new.amount_placeholder") %>
        <p class="form-hint"><%= t("requests.new.amount_hint") %></p>
        <%# Advance eligibility hint — rendered server-side so it's visible on first load %>
        <% if @advance_limit %>
          <% adv_user    = @for_user || current_user %>
          <% adv_biz     = adv_user.business %>
          <% adv_pct     = adv_biz.max_salary_advance_percentage.to_f.round(2) %>
          <% adv_cur     = adv_biz.currency %>
          <p class="form-hint form-hint--advance" id="advance-limit-hint">
            <%= t("requests.new.advance_limit_#{@advance_limit.description_key}",
                  percentage: adv_pct,
                  max:        number_with_precision(@advance_limit.max_amount, precision: 2, delimiter: ","),
                  currency:   adv_cur) %>
            <% if @advance_limit.outstanding > 0 %>
              &nbsp;
              <%= t("requests.new.advance_outstanding",
                    amount:   number_with_precision(@advance_limit.outstanding, precision: 2, delimiter: ","),
                    currency: adv_cur) %>
            <% end %>
            <br>
            <strong>
              <%= t("requests.new.advance_available",
                    amount:   number_with_precision(@advance_limit.available, precision: 2, delimiter: ","),
                    currency: adv_cur) %>
            </strong>
          </p>
        <% end %>
      </div>

      <%# Correction type + proposed time — shown only for punch_correction requests %>
      <div class="form-group form-group--full" id="correction-type-field">
        <%= f.label :correction_type, t("requests.new.correction_type_label"), class: "form-label form-label--required" %>
        <%= f.select :correction_type,
              EmployeeRequest::CORRECTION_TYPES.map { |ct| [t("requests.correction_types.#{ct}"), ct] },
              { include_blank: t("forms.select") },
              class: "form-control" %>
      </div>

      <div class="form-group" id="proposed-time-field">
        <%= f.label :proposed_time, t("requests.new.proposed_time_label"), class: "form-label form-label--required" %>
        <%= f.time_field :proposed_time, class: "form-control" %>
        <p class="form-hint"><%= t("requests.new.proposed_time_hint") %></p>
      </div>

      <%# Duration — shown for late_permission and early_leave requests %>
      <div class="form-group form-group--full" id="duration-field">
        <%= f.label :duration_minutes, t("requests.new.duration_label"), class: "form-label form-label--required" %>
        <%= f.number_field :duration_minutes,
              class: "form-control",
              min: 1,
              step: 1,
              placeholder: t("requests.new.duration_placeholder") %>
        <p class="form-hint" id="duration-hint-generic"><%= t("requests.new.duration_hint") %></p>
        <% if @permission_limits&.key?("late_permission") %>
          <p class="form-hint" id="duration-hint-late" style="display:none;">
            <%= t("requests.new.remaining_allowance",
                  remaining: @permission_limits["late_permission"][:remaining],
                  limit:     @permission_limits["late_permission"][:limit]) %>
          </p>
        <% end %>
        <% if @permission_limits&.key?("early_leave") %>
          <p class="form-hint" id="duration-hint-early" style="display:none;">
            <%= t("requests.new.remaining_allowance",
                  remaining: @permission_limits["early_leave"][:remaining],
                  limit:     @permission_limits["early_leave"][:limit]) %>
          </p>
        <% end %>
      </div>

      <div class="form-group">
        <%= f.label :requested_for_date, t("requests.new.date_label"), class: "form-label form-label--required" %>
        <%= f.date_field :requested_for_date,
              class: "form-control",
              value: @request.requested_for_date || Date.current %>
      </div>

      <div class="form-group form-group--full">
        <%= f.label :reason, t("requests.new.reason_label"), class: "form-label form-label--required" %>
        <%= f.text_area :reason,
              rows: 3,
              class: "form-control",
              placeholder: t("requests.new.reason_placeholder") %>
      </div>
    </div>

    <div class="form-actions">
      <%= f.submit t("requests.new.submit"), class: "btn btn-primary" %>
      <%= link_to t("forms.cancel"), employee_requests_path, class: "btn btn-ghost" %>
    </div>
  <% end %>
</div>

<script>
  (function () {
    var select = document.getElementById("request_type_select");
    var amountField         = document.getElementById("amount-field");
    var durationField       = document.getElementById("duration-field");
    var correctionTypeField = document.getElementById("correction-type-field");
    var proposedTimeField   = document.getElementById("proposed-time-field");
    var hintGeneric = document.getElementById("duration-hint-generic");
    var hintLate    = document.getElementById("duration-hint-late");
    var hintEarly   = document.getElementById("duration-hint-early");

    function toggle() {
      var t  = select.value;
      var isAdvance         = t === "salary_advance";
      var isPermission      = t === "late_permission" || t === "early_leave";
      var isPunchCorrection = t === "punch_correction";
      if (amountField)         amountField.style.display         = isAdvance         ? "" : "none";
      if (durationField)       durationField.style.display       = isPermission      ? "" : "none";
      if (correctionTypeField) correctionTypeField.style.display = isPunchCorrection ? "" : "none";
      if (proposedTimeField)   proposedTimeField.style.display   = isPunchCorrection ? "" : "none";
      if (hintGeneric)   hintGeneric.style.display   = isPermission && !hintLate && !hintEarly ? "" : "none";
      if (hintLate)      hintLate.style.display      = t === "late_permission" ? "" : "none";
      if (hintEarly)     hintEarly.style.display     = t === "early_leave"     ? "" : "none";
    }
    if (select) {
      toggle();
      select.addEventListener("change", toggle);
    }
  })();
</script>
