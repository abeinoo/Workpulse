<%# ── Schedule section ──────────────────────────────────────────────
    Driven purely by shift-assignment existence — never by role. Any user
    with an active/upcoming ShiftAssignment sees their schedule here
    (employees, branch managers, area managers, accountants, …). %>

<%# Upcoming Shifts %>
<% if @upcoming_shifts.any? %>
  <div class="emp-dashboard__section">
    <div class="emp-dashboard__section-header">
      <h2 class="emp-dashboard__section-title"><%= t("dashboard.upcoming_shifts.title") %></h2>
      <%= link_to t("dashboard.view_all"), shift_assignments_path, class: "emp-dashboard__section-link" %>
    </div>
    <div class="emp-upcoming-list">
      <% @upcoming_shifts.each do |assignment| %>
        <div class="emp-upcoming-item <%= "emp-upcoming-item--temp" if assignment.temporary? %>">
          <div class="emp-upcoming-item__main">
            <span class="emp-upcoming-item__shift"><%= assignment.shift_name %></span>
            <% if assignment.temporary? %>
              <span class="badge badge-type-temporary badge--xs">
                <%= assignment.source_template.present? ? assignment.source_template.name : t("shift_assignments.type.temporary") %>
              </span>
            <% end %>
          </div>
          <div class="emp-upcoming-item__meta">
            <% if assignment.branch %>
              <span class="emp-upcoming-item__branch"><%= assignment.branch_name %></span>
              <span class="emp-upcoming-item__sep">&middot;</span>
            <% end %>
            <span class="emp-upcoming-item__date"><%= local_short_date(assignment.effective_from) %></span>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
