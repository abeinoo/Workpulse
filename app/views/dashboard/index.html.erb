<% content_for :title, t("dashboard.page_title") %>

<% if current_user.owner? %>
  <%= render "super_admin" %>
<% elsif current_user.manages_area? %>
  <%= render "area_manager" %>
<% elsif current_user.manages_branch? %>
  <%= render "branch_manager" %>
<% elsif current_user.can?(:view_payroll) %>
  <%= render "accountant" %>
<% else %>
  <%= render "employee" %>
<% end %>
