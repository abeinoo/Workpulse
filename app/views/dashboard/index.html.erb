<% content_for :title, "Home — WorkPulse" %>

<% if current_user.super_admin? %>
  <%= render "super_admin" %>
<% elsif current_user.area_manager? %>
  <%= render "area_manager" %>
<% elsif current_user.branch_manager? %>
  <%= render "branch_manager" %>
<% elsif current_user.accountant? %>
  <%= render "accountant" %>
<% else %>
  <%= render "employee" %>
<% end %>
