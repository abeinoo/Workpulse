<% content_for :title, t("dashboard.page_title") %>

<%# Composable dashboard: each section renders independently based on the
    permission/scope gates resolved in DashboardController. A multi-role user
    sees every section they qualify for. Personal widgets are universal. %>

<div class="dashboard-compose">
  <%= render "dashboard/personal_section" %>
  <%= render "dashboard/branch_management_section" if show_branch_management_section? %>
  <%= render "dashboard/area_management_section"   if show_area_management_section? %>
  <%= render "dashboard/payroll_section"           if show_payroll_section? %>
  <%= render "dashboard/analytics_section"         if show_analytics_section? %>
</div>

<%= render "shared/greeting_script" %>
