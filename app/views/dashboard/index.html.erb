<% content_for :title, t("dashboard.page_title") %>

<%# Composable, widget-based dashboard. A single content container
    (.dashboard-compose) gives every part one shared alignment and width. Each
    widget/section still decides for itself whether it renders, based on
    permissions, shift-assignment existence, and actual data availability —
    empty cards are never shown. Personal widgets tile in a responsive grid;
    management sections render additively and expand to the full width. %>

<div class="dashboard-compose">

  <header class="dashboard-header">
    <%= render "dashboard/greeting" %>
    <%= render "dashboard/quick_actions" %>
  </header>

  <%# ── Today's birthdays (team, permission + scope gated) ── %>
  <%= render "dashboard/team_birthdays" if show_team_birthdays? %>

  <%# ── Personal widgets (self-owned, data-gated, responsive grid) ── %>
  <% if @has_personal_widgets %>
    <div class="dashboard-personal">
      <% if @missing_checkout %>
        <div class="dash-widget dash-widget--full"><%= render "dashboard/widget_missing_checkout" %></div>
      <% end %>
      <% if @today_record || @today_branches.any? %>
        <div class="dash-widget"><%= render "dashboard/widget_my_attendance" %></div>
      <% end %>
      <% if @current_shift || @upcoming_shifts.any? %>
        <div class="dash-widget"><%= render "dashboard/widget_my_schedule" %></div>
      <% end %>
      <% if @has_attendance_context %>
        <div class="dash-widget"><%= render "dashboard/widget_month_stats" %></div>
      <% end %>
      <% if @recent_requests.any? %>
        <div class="dash-widget"><%= render "dashboard/widget_my_requests" %></div>
      <% end %>
      <% if @latest_payroll %>
        <div class="dash-widget"><%= render "dashboard/widget_latest_payroll" %></div>
      <% end %>
    </div>
  <% end %>

  <%# ── Management sections (permission-gated, scope-driven) ───────── %>
  <%= render "dashboard/branch_management_section" if show_branch_management_section? %>
  <%= render "dashboard/area_management_section"   if show_area_management_section? %>
  <%= render "dashboard/payroll_section"           if show_payroll_section? %>
  <%= render "dashboard/analytics_section"         if show_analytics_section? %>
  <%= render "dashboard/inventory_section"         if show_inventory_section? %>

</div>

<%= render "dashboard/birthday_celebration" if @show_birthday_celebration %>

<%= render "shared/greeting_script" %>
