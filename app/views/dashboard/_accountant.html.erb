<div class="admin-page">

  <div class="dashboard__greeting">
    <p class="dashboard__greeting-time" id="js-greeting-time"><%= t("greeting.morning") %></p>
    <h1 class="dashboard__greeting-name"><%= t("greeting.hello", name: current_user.first_name) %></h1>
  </div>

  <div class="stats-grid">
    <div class="stat-card <%= @draft_periods.any? ? 'stat-card--alert' : '' %>">
      <p class="stat-card__label"><%= t("dashboard.stats.draft_periods") %></p>
      <p class="stat-card__value"><%= @draft_periods.count %></p>
    </div>
    <div class="stat-card <%= @approved_periods.any? ? 'stat-card--alert' : '' %>">
      <p class="stat-card__label"><%= t("dashboard.stats.awaiting_payment") %></p>
      <p class="stat-card__value"><%= @approved_periods.count %></p>
    </div>
  </div>

  <div class="quick-links">
    <%= link_to new_payroll_period_path, class: "admin-quick-link" do %>
      <div>
        <p class="admin-quick-link__label"><%= t("dashboard.accountant.generate_payroll_label") %></p>
        <p class="admin-quick-link__sub"><%= t("dashboard.accountant.generate_payroll_sub") %></p>
      </div>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
    <% end %>

    <%= link_to payroll_periods_path, class: "admin-quick-link" do %>
      <div>
        <p class="admin-quick-link__label"><%= t("dashboard.accountant.all_payroll_label") %></p>
        <p class="admin-quick-link__sub"><%= t("dashboard.accountant.all_payroll_sub") %></p>
      </div>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
    <% end %>

    <%= link_to attendance_records_path, class: "admin-quick-link" do %>
      <div>
        <p class="admin-quick-link__label"><%= t("dashboard.accountant.attendance_label") %></p>
        <p class="admin-quick-link__sub"><%= t("dashboard.accountant.attendance_records_sub") %></p>
      </div>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    <% end %>
  </div>

  <% actionable = (@draft_periods + @approved_periods).uniq.sort_by { |p| [-p.period_year, -p.period_month] } %>
  <% if actionable.any? %>
    <div class="dashboard-section">
      <div class="mgr-dashboard__section-header">
        <h2 class="dashboard-section__title"><%= t("dashboard.sections.needs_action") %></h2>
        <%= link_to t("dashboard.view_all"), payroll_periods_path, class: "mgr-dashboard__section-link" %>
      </div>
      <div class="table-wrap table-wrap--cards">
        <table>
          <thead>
            <tr>
              <th><%= t("payroll.period") %></th>
              <th><%= t("payroll.branch") %></th>
              <th><%= t("payroll.status") %></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% actionable.first(6).each do |period| %>
              <tr>
                <td><%= link_to period.period_label, payroll_period_path(period), class: "link" %></td>
                <td class="td-secondary"><%= period.branch&.name || t("payroll.all_branches") %></td>
                <td>
                  <span class="badge <%= period.finalized? ? 'badge-accent' : 'badge-neutral' %>">
                    <%= t("payroll.statuses.#{period.status}") %>
                  </span>
                </td>
                <td class="td-actions">
                  <% if policy(period).finalize? && period.draft? %>
                    <%= button_to t("payroll.finalize"),
                          finalize_payroll_period_path(period),
                          method: :patch,
                          class: "btn btn-sm btn-primary",
                          data: { turbo_confirm: t("payroll.finalize_confirm") } %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

</div>

<%= render "shared/greeting_script" %>
