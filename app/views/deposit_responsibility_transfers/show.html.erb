<% content_for :title, t("deposit_responsibility_transfers.show.title") %>

<turbo-frame id="modal">
<div style="padding: var(--space-5) var(--space-5) var(--space-8); display: flex; flex-direction: column; gap: var(--space-4);">

  <%# ── Modal header ────────────────────────────────────────────────────── %>
  <div style="display: flex; align-items: center; justify-content: space-between;">
    <div>
      <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); margin: 0 0 2px;">
        <%= t("deposit_responsibility_transfers.show.modal_label") %>
      </p>
      <h2 style="font-size: var(--text-xl); font-weight: 700; color: var(--text-1); margin: 0; line-height: 1.2;">
        <%= t("deposit_responsibility_transfers.show.title") %>
      </h2>
    </div>
    <button type="button"
            data-action="click->modal#close"
            style="border: none; background: none; cursor: pointer; color: var(--text-2); padding: var(--space-2); border-radius: var(--radius-sm);"
            aria-label="<%= t("common.close") %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <%# ── Transfer origin card ────────────────────────────────────────────── %>
  <div style="background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--space-4);">
    <div style="display: flex; align-items: center; gap: var(--space-3);">
      <div style="flex-shrink: 0; width: 40px; height: 40px; border-radius: 50%; background: rgba(var(--warning-rgb), 0.12); display: flex; align-items: center; justify-content: center; color: var(--warning);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="15" rx="2"/><path d="M16 7V5a2 2 0 0 0-4 0v2"/><line x1="12" y1="12" x2="12" y2="17"/><line x1="9.5" y1="14.5" x2="14.5" y2="14.5"/></svg>
      </div>
      <div style="flex: 1; min-width: 0;">
        <p style="font-size: var(--text-xs); color: var(--text-2); margin: 0 0 2px;">
          <%= t("deposit_responsibility_transfers.show.from_label") %>
        </p>
        <p style="font-size: var(--text-base); font-weight: 700; color: var(--text-1); margin: 0; overflow-wrap: anywhere;">
          <%= @transfer.from_user.full_name %>
        </p>
        <% if @transfer.initiated_by %>
          <p style="font-size: var(--text-xs); color: var(--text-2); margin: 2px 0 0; overflow-wrap: anywhere;">
            <%= t("deposit_responsibility_transfers.show.requested_by", name: @transfer.initiated_by.full_name) %>
          </p>
        <% end %>
        <p style="font-size: var(--text-xs); color: var(--text-3); margin: 2px 0 0;">
          <%= @transfer.branch.name %>
          <% if @transfer.daily_reconciliation.business_date %>
            · <%= l(@transfer.daily_reconciliation.business_date, format: :short) %>
          <% end %>
        </p>
      </div>
      <% if @transfer.accepted? %>
        <span class="badge badge-success" style="flex-shrink: 0;">
          <%= t("deposit_responsibility_transfers.show.accepted_badge") %>
        </span>
      <% end %>
    </div>
  </div>

  <%# ── Financial summary ──────────────────────────────────────────────── %>
  <% if @session_summary.any? %>
    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden;">
      <div style="padding: var(--space-4) var(--space-5); border-bottom: 1px solid var(--border); background: var(--surface-2);">
        <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); margin: 0;">
          <%= t("deposit_responsibility_transfers.show.summary_heading") %>
        </p>
      </div>

      <%# Session context row %>
      <div style="padding: var(--space-3) var(--space-5); border-bottom: 1px solid var(--border); display: flex; flex-wrap: wrap; gap: var(--space-5);">
        <div>
          <p style="font-size: var(--text-xs); color: var(--text-3); margin: 0 0 2px; text-transform: uppercase; letter-spacing: 0.06em;">
            <%= t("deposit_responsibility_transfers.show.cashier_label") %>
          </p>
          <p style="font-size: var(--text-sm); font-weight: 600; color: var(--text-1); margin: 0;">
            <%= @transfer.from_user.full_name %>
          </p>
        </div>
        <div>
          <p style="font-size: var(--text-xs); color: var(--text-3); margin: 0 0 2px; text-transform: uppercase; letter-spacing: 0.06em;">
            <%= t("deposit_responsibility_transfers.show.branch_label") %>
          </p>
          <p style="font-size: var(--text-sm); font-weight: 600; color: var(--text-1); margin: 0;">
            <%= @transfer.branch.name %>
          </p>
        </div>
        <% if @transfer.daily_reconciliation.business_date %>
          <div>
            <p style="font-size: var(--text-xs); color: var(--text-3); margin: 0 0 2px; text-transform: uppercase; letter-spacing: 0.06em;">
              <%= t("deposit_responsibility_transfers.show.date_label") %>
            </p>
            <p style="font-size: var(--text-sm); font-weight: 600; color: var(--text-1); margin: 0;">
              <%= l(@transfer.daily_reconciliation.business_date, format: :long) %>
            </p>
          </div>
        <% end %>
        <% if @transfer.daily_reconciliation.closed_at %>
          <div>
            <p style="font-size: var(--text-xs); color: var(--text-3); margin: 0 0 2px; text-transform: uppercase; letter-spacing: 0.06em;">
              <%= t("deposit_responsibility_transfers.show.closed_at_label") %>
            </p>
            <p style="font-size: var(--text-sm); font-weight: 600; color: var(--text-1); margin: 0;">
              <%= l(@transfer.daily_reconciliation.closed_at, format: :time_only) %>
            </p>
          </div>
        <% end %>
      </div>

      <%# Per-payment-method rows %>
      <% @session_summary.each do |row| %>
        <div style="padding: var(--space-3) var(--space-5); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap;">
          <span style="font-size: var(--text-sm); font-weight: 600; color: var(--text-1);">
            <%= row[:name] %>
          </span>
          <div style="display: flex; gap: var(--space-5); font-variant-numeric: tabular-nums;">
            <span style="font-size: var(--text-xs); color: var(--text-3);">
              <%= t("deposit_responsibility_transfers.show.expected_label") %>
              <strong style="color: var(--text-1); margin-inline-start: 4px; font-size: var(--text-sm);">
                <%= format_currency(row[:expected]) %>
              </strong>
            </span>
            <span style="font-size: var(--text-xs); color: var(--text-3);">
              <%= t("deposit_responsibility_transfers.show.deposited_label") %>
              <strong style="color: var(--text-1); margin-inline-start: 4px; font-size: var(--text-sm);">
                <%= format_currency(row[:deposited]) %>
              </strong>
            </span>
            <% if row[:remaining] > 0 %>
              <span style="font-size: var(--text-xs); color: var(--warning);">
                <%= t("deposit_responsibility_transfers.show.remaining_label") %>
                <strong style="margin-inline-start: 4px; font-size: var(--text-sm);">
                  <%= format_currency(row[:remaining]) %>
                </strong>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Totals row %>
      <div style="padding: var(--space-4) var(--space-5); background: var(--surface-2); display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap;">
        <span style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1);">
          <%= t("deposit_responsibility_transfers.show.total_label") %>
        </span>
        <div style="display: flex; gap: var(--space-5); font-variant-numeric: tabular-nums;">
          <span style="font-size: var(--text-xs); color: var(--text-3);">
            <%= t("deposit_responsibility_transfers.show.expected_label") %>
            <strong style="color: var(--text-1); margin-inline-start: 4px; font-size: var(--text-base);">
              <%= format_currency(@total_expected) %>
            </strong>
          </span>
          <span style="font-size: var(--text-xs); color: var(--text-3);">
            <%= t("deposit_responsibility_transfers.show.deposited_label") %>
            <strong style="color: var(--text-1); margin-inline-start: 4px; font-size: var(--text-base);">
              <%= format_currency(@total_deposited) %>
            </strong>
          </span>
          <% if @total_remaining > 0 %>
            <span style="font-size: var(--text-xs); font-weight: 700; color: var(--warning);">
              <%= t("deposit_responsibility_transfers.show.remaining_label") %>
              <strong style="margin-inline-start: 4px; font-size: var(--text-base);">
                <%= format_currency(@total_remaining) %>
              </strong>
            </span>
          <% end %>
        </div>
      </div>

      <%# Notes %>
      <% if @transfer.daily_reconciliation.notes.present? %>
        <div style="padding: var(--space-3) var(--space-5); border-top: 1px solid var(--border);">
          <p style="font-size: var(--text-xs); color: var(--text-3); margin: 0 0 4px; text-transform: uppercase; letter-spacing: 0.06em;">
            <%= t("deposit_responsibility_transfers.show.notes_label") %>
          </p>
          <p style="font-size: var(--text-sm); color: var(--text-2); margin: 0; line-height: 1.5;">
            <%= @transfer.daily_reconciliation.notes %>
          </p>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# ── What this means ────────────────────────────────────────────────── %>
  <div style="background: rgba(var(--warning-rgb), 0.06); border: 1px solid rgba(var(--warning-rgb), 0.25); border-radius: var(--radius-lg); padding: var(--space-3) var(--space-4);">
    <p style="font-size: var(--text-sm); color: var(--text-1); margin: 0; line-height: 1.6;">
      <%= t("deposit_responsibility_transfers.show.description") %>
    </p>
  </div>

  <%# ── Accept / already accepted / pending for another user ───────────── %>
  <% if @transfer.notes.present? %>
    <p style="font-size: var(--text-sm); color: var(--text-2); margin: 0; font-style: italic; overflow-wrap: anywhere;">
      <%= t("deposit_responsibility_transfers.show.notes_label") %>: <%= @transfer.notes %>
    </p>
  <% end %>

  <% if @transfer.pending? && policy(@transfer).accept? %>
    <%= form_with url: accept_deposit_responsibility_transfer_path(@transfer), method: :patch,
          id: "deposit-accept-form", data: { turbo_frame: "_top" } do |f| %>
      <div style="display: flex; flex-direction: column; gap: var(--space-3);">
        <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); margin: 0;">
          <%= t("deposit_responsibility_transfers.show.confirm_accept") %>
        </p>
        <div style="display: flex; flex-wrap: wrap-reverse; gap: var(--space-3);">
          <button type="button"
                  data-action="click->modal#close"
                  class="btn btn-ghost"
                  style="flex: 1 1 140px; justify-content: center;">
            <%= t("common.cancel") %>
          </button>
          <%= f.submit t("deposit_responsibility_transfers.show.accept_submit"),
                id: "deposit-accept-submit",
                class: "btn btn-checkin",
                style: "flex: 1 1 140px; justify-content: center;" %>
        </div>
      </div>
    <% end %>

  <% elsif @transfer.pending? && policy(@transfer).reject? %>
    <%# Recipient, but the day can no longer change hands (verified / fully deposited). %>
    <p role="alert" style="font-size: var(--text-sm); color: var(--danger, #dc2626); margin: 0;">
      <%= t("deposit_responsibility_transfers.errors.locked") %>
    </p>
    <div style="text-align: center; padding-bottom: var(--space-2);">
      <button type="button" data-action="click->modal#close" class="btn btn-ghost btn-sm">
        <%= t("common.close") %>
      </button>
    </div>

  <% elsif @transfer.rejected? %>
    <div style="display: flex; flex-direction: column; align-items: center; gap: var(--space-1); padding: var(--space-3) 0; color: var(--text-2); font-size: var(--text-sm); text-align: center;">
      <span><%= t("deposit_responsibility_transfers.show.rejected_note", name: @transfer.to_user.full_name) %></span>
      <% if @transfer.rejection_reason.present? %>
        <span style="font-style: italic; overflow-wrap: anywhere;"><%= @transfer.rejection_reason %></span>
      <% end %>
    </div>
    <div style="text-align: center; padding-bottom: var(--space-2);">
      <button type="button" data-action="click->modal#close" class="btn btn-ghost btn-sm">
        <%= t("common.close") %>
      </button>
    </div>

  <% elsif @transfer.accepted? %>
    <div style="display: flex; align-items: center; justify-content: center; gap: var(--space-2); padding: var(--space-3) 0; color: var(--success); font-size: var(--text-sm);">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
      <%= t("deposit_responsibility_transfers.show.accepted_by", name: @transfer.acceptor.full_name) %>
    </div>
    <div style="text-align: center; padding-bottom: var(--space-2);">
      <button type="button" data-action="click->modal#close" class="btn btn-ghost btn-sm">
        <%= t("common.close") %>
      </button>
    </div>

  <% elsif @transfer.cancelled? %>
    <div style="display: flex; align-items: center; justify-content: center; gap: var(--space-2); padding: var(--space-3) 0; color: var(--text-2); font-size: var(--text-sm);">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      <%= t("deposit_responsibility_transfers.show.cancelled_note") %>
    </div>
    <div style="text-align: center; padding-bottom: var(--space-2);">
      <button type="button" data-action="click->modal#close" class="btn btn-ghost btn-sm">
        <%= t("common.close") %>
      </button>
    </div>

  <% else %>
    <%# Pending: show cancel button for from_user / manager, or waiting notice for others %>
    <% if policy(@transfer).cancel? %>
      <div style="display: flex; flex-direction: column; gap: var(--space-3);">
        <div style="font-size: var(--text-xs); color: var(--warning); text-align: center; padding: var(--space-2) 0;">
          <%= t("deposit_responsibility_transfers.show.pending_for", name: @transfer.to_user.full_name) %>
        </div>
        <%= button_to cancel_deposit_responsibility_transfer_path(@transfer),
              method: :patch,
              data: { turbo_confirm: t("deposit_responsibility_transfers.show.confirm_cancel"),
                      turbo_frame: "_top" },
              class: "btn btn-ghost",
              style: "width: 100%; justify-content: center;" do %>
          <%= t("deposit_responsibility_transfers.show.cancel_submit") %>
        <% end %>
        <button type="button"
                data-action="click->modal#close"
                class="btn btn-ghost btn-sm"
                style="width: 100%; justify-content: center;">
          <%= t("common.close") %>
        </button>
      </div>
    <% else %>
      <div style="display: flex; align-items: center; justify-content: center; gap: var(--space-2); padding: var(--space-3) 0; color: var(--warning); font-size: var(--text-sm);">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <%= t("deposit_responsibility_transfers.show.pending_for", name: @transfer.to_user.full_name) %>
      </div>
      <div style="text-align: center; padding-bottom: var(--space-2);">
        <button type="button" data-action="click->modal#close" class="btn btn-ghost btn-sm">
          <%= t("common.close") %>
        </button>
      </div>
    <% end %>
  <% end %>

</div>
</turbo-frame>
