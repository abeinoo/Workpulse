<% content_for :title, t("deposit_responsibility_transfers.reject.title") %>

<turbo-frame id="modal">
<div id="deposit-reject-modal"
     style="padding: var(--space-5) var(--space-5) var(--space-8); display: flex; flex-direction: column; gap: var(--space-4); min-width: 0;">

  <%# ── Modal header ────────────────────────────────────────────────────── %>
  <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-3);">
    <div style="min-width: 0;">
      <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); margin: 0 0 2px; overflow-wrap: anywhere;">
        <%= @transfer.branch.name %> · <%= l(@transfer.daily_reconciliation.business_date, format: :short) %>
      </p>
      <h2 style="font-size: var(--text-xl); font-weight: 700; color: var(--text-1); margin: 0; line-height: 1.2;">
        <%= t("deposit_responsibility_transfers.reject.title") %>
      </h2>
    </div>
    <button type="button"
            data-action="click->modal#close"
            style="flex-shrink: 0; border: none; background: none; cursor: pointer; color: var(--text-2); padding: var(--space-2); border-radius: var(--radius-sm);"
            aria-label="<%= t("common.close") %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <div style="background: rgba(var(--warning-rgb, 202,138,4), 0.06); border: 1px solid rgba(var(--warning-rgb, 202,138,4), 0.25); border-radius: var(--radius-lg); padding: var(--space-3) var(--space-4);">
    <p style="font-size: var(--text-sm); color: var(--text-1); margin: 0; line-height: 1.6; overflow-wrap: anywhere;">
      <%= t("deposit_responsibility_transfers.reject.description", name: @transfer.from_user.full_name) %>
    </p>
  </div>

  <%= form_with url: reject_deposit_responsibility_transfer_path(@transfer), method: :patch,
        id: "deposit-reject-form", data: { turbo_frame: "_top" } do |f| %>
    <div style="display: flex; flex-direction: column; gap: var(--space-4); min-width: 0;">
      <div class="form-group" style="margin: 0; min-width: 0;">
        <%= label_tag :rejection_reason, t("deposit_responsibility_transfers.reject.reason_label"),
              for: "deposit-reject-reason", class: "form-label" %>
        <%= text_area_tag :rejection_reason, nil,
              id: "deposit-reject-reason",
              rows: 3, class: "form-control", required: true,
              maxlength: DepositResponsibilityTransfer::REJECTION_REASON_MAX_LENGTH,
              style: "width: 100%; max-width: 100%;",
              placeholder: t("deposit_responsibility_transfers.reject.reason_placeholder") %>
      </div>

      <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); margin: 0;">
        <%= t("deposit_responsibility_transfers.reject.confirm") %>
      </p>

      <div style="display: flex; flex-wrap: wrap-reverse; gap: var(--space-3);">
        <button type="button"
                data-action="click->modal#close"
                class="btn btn-ghost"
                style="flex: 1 1 140px; justify-content: center;">
          <%= t("common.cancel") %>
        </button>
        <%= f.submit t("deposit_responsibility_transfers.reject.submit"),
              id: "deposit-reject-submit",
              class: "btn btn-danger",
              style: "flex: 1 1 140px; justify-content: center;" %>
      </div>
    </div>
  <% end %>

</div>
</turbo-frame>
