<% content_for :title, t("notifications.preferences.title") %>

<div class="admin-page">
  <div class="page-header">
    <div>
      <h1 class="page-title"><%= t("notifications.preferences.title") %></h1>
      <p class="page-subtitle"><%= t("notifications.preferences.subtitle") %></p>
    </div>
  </div>

  <%= form_with url: notification_preferences_path, method: :patch, local: true, class: "form-card" do %>
    <div class="notif-pref-list">
      <% Notification::CATEGORIES.each do |cat| %>
        <label class="notif-pref-row">
          <span class="notif-pref-row__info">
            <span class="notif-pref-row__name"><%= t("notifications.categories.#{cat}") %></span>
            <span class="notif-pref-row__desc"><%= t("notifications.preferences.descriptions.#{cat}") %></span>
          </span>
          <span class="notif-pref-row__toggle">
            <input type="hidden" name="categories[<%= cat %>]" value="0">
            <input type="checkbox"
                   name="categories[<%= cat %>]"
                   value="1"
                   class="form-switch"
                   <%= "checked" if @preferences[cat] %>>
          </span>
        </label>
      <% end %>
    </div>

    <div class="form-actions">
      <%= submit_tag t("notifications.preferences.save"), class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
