<% content_for :title, t("inventory.product_categories.title") %>

<div class="admin-page">
  <div class="page-header">
    <h1 class="page-title"><%= t("inventory.product_categories.title") %></h1>
    <% if current_user.can?(:manage_inventory) || current_user.can?(:manage_products) %>
      <%= link_to t("inventory.product_categories.add"), new_inventory_product_category_path, class: "btn btn-primary btn-sm" %>
    <% end %>
  </div>

  <% if @categories.empty? %>
    <div class="empty-state"><p class="empty-state__title"><%= t("inventory.product_categories.empty") %></p></div>
  <% else %>
    <div class="table-wrap table-wrap--cards">
      <table>
        <thead><tr>
          <th><%= t("inventory.product_categories.name") %></th>
          <th><%= t("inventory.product_categories.description") %></th>
          <th><%= t("inventory.product_categories.status") %></th>
          <th style="text-align: end;"><%= t("inventory.product_categories.products_count") %></th>
          <th></th>
        </tr></thead>
        <tbody>
          <% @categories.each do |category| %>
            <tr>
              <td><%= category.name %></td>
              <td class="td-secondary"><%= truncate(category.description.to_s, length: 60).presence || "—" %></td>
              <td>
                <% if category.active? %>
                  <span class="badge badge-success"><%= t("inventory.product_categories.statuses.active") %></span>
                <% else %>
                  <span class="badge"><%= t("inventory.product_categories.statuses.inactive") %></span>
                <% end %>
              </td>
              <td style="text-align: end;"><%= category.products_count %></td>
              <td class="td-actions">
                <% if current_user.can?(:manage_inventory) || current_user.can?(:manage_products) %>
                  <%= link_to t("common.edit"), edit_inventory_product_category_path(category), class: "link-muted" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
