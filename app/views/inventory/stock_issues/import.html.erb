<% content_for :title, t("inventory.imports.stock_issues.title") %>

<div class="form-page">
  <%= link_to inventory_stock_issues_path, class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    <%= t("forms.back") %>
  <% end %>
  <h1 class="page-title mb-6"><%= t("inventory.imports.stock_issues.title") %></h1>

  <%= form_with url: run_import_inventory_stock_issues_path, method: :post, class: "form-card" do |f| %>
    <div class="flex items-center" style="justify-content: space-between; gap: var(--space-3); margin-bottom: var(--space-4); flex-wrap: wrap;">
      <p class="form-hint" style="margin: 0;"><%= t("inventory.imports.stock_issues.columns") %></p>
      <%= link_to t("inventory.imports.download_sample"), import_template_inventory_stock_issues_path,
            class: "btn btn-secondary btn-sm" %>
    </div>

    <%= render "inventory/shared/import_columns", columns: Inventory::Imports::StockIssueImporter::COLUMNS %>

    <div class="form-grid">
      <div class="form-group">
        <%= label_tag :warehouse_id, t("inventory.imports.warehouse"), class: "form-label" %>
        <%= select_tag :warehouse_id,
              options_from_collection_for_select(@warehouses, :id, :name),
              include_blank: "— #{t('inventory.stock_issues.select_warehouse')}", class: "form-control", required: true %>
      </div>
      <div class="form-group">
        <%= label_tag :branch_id, t("inventory.stock_issues.branch"), class: "form-label" %>
        <%= select_tag :branch_id,
              options_from_collection_for_select(@branches, :id, :name),
              include_blank: "— #{t('inventory.stock_issues.select_branch')}", class: "form-control", required: true %>
      </div>
      <div class="form-group" style="grid-column: 1 / -1;">
        <%= label_tag :file, t("inventory.imports.file"), class: "form-label" %>
        <%= file_field_tag :file, accept: ".csv", class: "form-control", required: true %>
      </div>
    </div>
    <div class="form-actions">
      <%= f.submit t("inventory.imports.upload"), class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
