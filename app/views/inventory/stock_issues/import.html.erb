<% content_for :title, t("inventory.imports.stock_issues.title") %>

<div class="form-page">
  <%= link_to inventory_stock_issues_path, class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    <%= t("forms.back") %>
  <% end %>
  <h1 class="page-title mb-6"><%= t("inventory.imports.stock_issues.title") %></h1>

  <div id="import-approval-notice" class="form-hint form-hint--info" role="note" style="margin-bottom: var(--space-4);">
    <%= t("inventory.imports.stock_issues.approval_required") %>
  </div>

  <%= form_with url: preview_import_inventory_stock_issues_path, method: :post,
                multipart: true, class: "form-card", data: { turbo: false } do |f| %>
    <div class="flex items-center" style="justify-content: space-between; gap: var(--space-3); margin-bottom: var(--space-4); flex-wrap: wrap;">
      <p class="form-hint" style="margin: 0;"><%= t("inventory.imports.stock_issues.columns") %></p>
      <div class="flex" style="gap: var(--space-2); flex-wrap: wrap;">
        <%= link_to t("inventory.imports.mapping.download_sample_csv"), import_template_inventory_stock_issues_path,
              class: "btn btn-secondary btn-sm", id: "download-sample-csv" %>
        <%= link_to t("inventory.imports.mapping.download_sample_xlsx"), import_template_inventory_stock_issues_path(kind: "xlsx"),
              class: "btn btn-secondary btn-sm", id: "download-sample-xlsx" %>
      </div>
    </div>

    <%= render "inventory/shared/import_columns", columns: Inventory::Imports::StockIssueImporter::COLUMNS %>
    <p class="form-hint" style="margin: 0 0 var(--space-4);"><%= t("inventory.imports.mapping.any_columns_hint") %></p>

    <div class="form-grid">
      <div class="form-group">
        <%= label_tag :warehouse_id, t("inventory.imports.warehouse"), class: "form-label" %>
        <%= select_tag :warehouse_id,
              options_from_collection_for_select(@warehouses, :id, :name),
              include_blank: "— #{t('inventory.stock_issues.select_warehouse')}", class: "form-control", required: true %>
      </div>
      <div class="form-group">
        <%= label_tag :branch_id, t("inventory.stock_issues.branch"), class: "form-label" %>
        <%= select_tag :branch_id,
              options_from_collection_for_select(@branches, :id, :name),
              include_blank: "— #{t('inventory.stock_issues.select_branch')}", class: "form-control", required: true %>
      </div>
      <%# Document-level note for the ONE stock issue this import creates —
          saved on StockIssue#notes, shared by every imported line. Not a
          file column. %>
      <div class="form-group" style="grid-column: 1 / -1;">
        <%= label_tag :notes, t("inventory.imports.stock_issues.issue_notes_label"), class: "form-label" %>
        <%= text_area_tag :notes, params[:notes], rows: 2, class: "form-control", id: "notes",
              placeholder: t("inventory.imports.stock_issues.issue_notes_placeholder"),
              "aria-describedby": "issue-notes-hint" %>
        <p id="issue-notes-hint" class="form-hint" style="margin: var(--space-1) 0 0;">
          <%= t("inventory.imports.stock_issues.issue_notes_hint") %>
        </p>
      </div>
      <div class="form-group" style="grid-column: 1 / -1;">
        <%= label_tag :file, t("inventory.imports.mapping.file_label"), class: "form-label" %>
        <%= file_field_tag :file, class: "form-control", required: true, "aria-describedby": "import-file-hint",
              accept: ".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" %>
        <p id="import-file-hint" class="form-hint" style="margin: var(--space-1) 0 0;">
          <%= t("inventory.imports.mapping.file_formats_hint") %> <bdi dir="ltr">.csv, .xlsx</bdi>
        </p>
      </div>
    </div>
    <div class="form-actions">
      <%= f.submit t("inventory.imports.mapping.continue_to_mapping"), class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
