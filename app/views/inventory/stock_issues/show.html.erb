<% content_for :title, @stock_issue.issue_number %>

<div class="admin-page">
  <%= link_to inventory_stock_issues_path, class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    <%= t("forms.back") %>
  <% end %>

  <div class="page-header">
    <h1 class="page-title">
      <%= @stock_issue.issue_number %>
      <span class="badge <%= @stock_issue.voided? ? 'badge-danger' : stock_issue_status_class(@stock_issue.status) %>">
        <%= @stock_issue.voided? ? t("inventory.void.status_voided") : t("inventory.stock_issues.statuses.#{@stock_issue.status}") %>
      </span>
    </h1>
    <div class="flex" style="gap: var(--space-2);">
      <% if policy(@stock_issue).update? %>
        <%= link_to t(StockIssue::REOPENED_BY_EDIT_STATUSES.include?(@stock_issue.status) ? "inventory.stock_issues.edit_request" : "inventory.stock_issues.edit_action"),
              edit_inventory_stock_issue_path(@stock_issue), id: "edit-stock-issue", class: "btn btn-ghost btn-sm" %>
      <% end %>
      <% if policy(@stock_issue).submit? %>
        <%= button_to t(@awaiting_resubmission ? "inventory.stock_issues.resubmit_for_approval" : "inventory.stock_issues.submit_for_approval"),
              submit_inventory_stock_issue_path(@stock_issue),
              method: :post, class: "btn btn-primary btn-sm",
              data: { turbo_confirm: t("inventory.stock_issues.submit_confirm") } %>
      <% end %>
    </div>
  </div>

  <%# Stock only moves at "Confirm Issue" on an approved issue — say so plainly
      for every state before that, so nobody reads a pending issue as issued. %>
  <% if !@stock_issue.voided? && (@stock_issue.draft? || @stock_issue.pending_approval? || @stock_issue.approved?) %>
    <div id="stock-not-deducted-notice" class="form-hint form-hint--info" role="status" style="margin-bottom: var(--space-5);">
      <%= t("inventory.stock_issues.stock_not_deducted_#{@stock_issue.status}") %>
    </div>
  <% end %>

  <% if @awaiting_resubmission && !@stock_issue.voided? %>
    <div id="resubmission-required-notice" class="alert alert-warning" role="status" style="margin-bottom: var(--space-5);">
      <%= t("inventory.stock_issues.resubmission_required") %>
    </div>
  <% end %>

  <%# Blocking state: approval/confirmation would be refused by the service
      (same StockAvailability figures, re-checked there under lock). %>
  <% if @availability_shortages.present? && (@stock_issue.pending_approval? || @stock_issue.approved?) %>
    <div id="stock-shortage-alert" class="alert alert-warning" role="alert" style="margin-bottom: var(--space-5);">
      <p style="margin: 0 0 var(--space-2); font-weight: 600;">
        <%= t(@stock_issue.approved? ? "inventory.stock_issues.availability.cannot_confirm" : "inventory.stock_issues.availability.cannot_approve") %>
      </p>
      <ul style="margin: 0 0 var(--space-2); padding-inline-start: var(--space-5);">
        <% @availability_shortages.each do |line| %>
          <li>
            <%= t("inventory.stock_issues.availability.shortage_line",
                  product: line.product.name, available: stock_quantity(line.available), requested: stock_quantity(line.requested)) %>
            <% if line.reserved.positive? %>
              <%= t("inventory.stock_issues.availability.shortage_reserved") %>
            <% end %>
          </li>
        <% end %>
      </ul>
      <p style="margin: 0;"><%= t("inventory.stock_issues.availability.resolve_hint") %></p>
    </div>
  <% end %>

  <% if @stock_issue.pending_approval? && policy(@stock_issue).approve? %>
    <div class="card" style="padding: var(--space-4); margin-bottom: var(--space-5); display: flex; gap: var(--space-3); align-items: center; flex-wrap: wrap;">
      <%= button_to t("inventory.stock_issues.approve"), approve_inventory_stock_issue_path(@stock_issue),
            method: :post, class: "btn btn-primary btn-sm", disabled: @availability_shortages.present?,
            data: { turbo_confirm: t("inventory.stock_issues.approve_hint") } %>
      <details style="flex: 1;">
        <summary class="btn btn-ghost btn-sm text-danger" style="cursor: pointer; display: inline-flex;">
          <%= t("inventory.stock_issues.reject") %>
        </summary>
        <%= form_with url: reject_inventory_stock_issue_path(@stock_issue), method: :post, class: "mt-4" do %>
          <div class="form-group">
            <label class="form-label" for="rejection_reason"><%= t("inventory.stock_issues.rejection_reason") %></label>
            <textarea id="rejection_reason" name="rejection_reason" rows="2" class="form-control" required
                      placeholder="<%= t('inventory.stock_issues.rejection_reason_placeholder') %>"></textarea>
          </div>
          <button type="submit" class="btn btn-danger btn-sm"
                  data-turbo-confirm="<%= t('inventory.stock_issues.reject_confirm') %>">
            <%= t("inventory.stock_issues.reject_submit") %>
          </button>
        <% end %>
      </details>
    </div>
  <% end %>

  <% if @stock_issue.rejected? && @stock_issue.rejection_reason.present? %>
    <div class="card" style="padding: var(--space-5); margin-bottom: var(--space-5); border-inline-start: 3px solid var(--color-danger, #dc2626);">
      <p class="td-secondary" style="margin: 0 0 var(--space-1);"><%= t("inventory.stock_issues.rejection_reason") %></p>
      <p style="margin: 0;"><%= @stock_issue.rejection_reason %></p>
      <p class="td-secondary" style="margin-top: var(--space-2); font-size: var(--text-xs);">
        <%= @stock_issue.rejected_by&.full_name || t("inventory.stock_issues.timeline.unknown_actor") %>
        · <%= @stock_issue.rejected_at ? l(@stock_issue.rejected_at, format: :short) : "—" %>
      </p>
    </div>
  <% end %>

  <% if @stock_issue.approved? && policy(@stock_issue).confirm? %>
    <details id="confirm-issue-panel" class="card" style="padding: var(--space-5); margin-bottom: var(--space-5); border-inline-start: 3px solid var(--success, #16a34a);">
      <summary class="btn btn-primary" style="cursor: pointer; display: inline-flex;">
        <%= t("inventory.stock_issues.confirm_issue") %>
      </summary>
      <div style="margin-top: var(--space-4);">
        <p style="margin: 0 0 var(--space-4);"><%= t("inventory.stock_issues.confirm_issue_question") %></p>
        <dl class="detail-list">
          <div class="detail-list__row"><dt><%= t("inventory.stock_issues.number") %></dt><dd><%= @stock_issue.issue_number %></dd></div>
          <div class="detail-list__row"><dt><%= t("inventory.stock_issues.branch") %></dt><dd><%= @stock_issue.branch&.name || "—" %></dd></div>
          <div class="detail-list__row"><dt><%= t("inventory.stock_issues.warehouse") %></dt><dd><%= @stock_issue.warehouse.name %></dd></div>
          <div class="detail-list__row"><dt><%= t("inventory.stock_issues.items_count") %></dt><dd><%= @items.size %></dd></div>
          <div class="detail-list__row"><dt><%= t("inventory.stock_issues.total_quantity") %></dt><dd><%= @items.sum { |i| i.quantity.to_i } %></dd></div>
          <div class="detail-list__row"><dt><%= t("inventory.stock_issues.total") %></dt><dd><%= format_currency(@stock_issue.total_value) %></dd></div>
        </dl>
        <%= button_to t("inventory.stock_issues.confirm_issue"), confirm_inventory_stock_issue_path(@stock_issue),
              method: :post, class: "btn btn-primary", style: "margin-top: var(--space-4);",
              disabled: @availability_shortages.present?,
              data: { turbo_confirm: t("inventory.stock_issues.confirm_issue_warning") } %>
      </div>
    </details>
  <% end %>

  <% if @stock_issue.issued? %>
    <p id="issued-not-editable-hint" class="form-hint" style="margin-bottom: var(--space-3);">
      <%= t("inventory.stock_issues.issued_not_editable") %>
    </p>
    <%= render "inventory/shared/void_panel",
          document: @stock_issue,
          void_path: void_inventory_stock_issue_path(@stock_issue),
          can_void: policy(@stock_issue).void? %>
  <% elsif @stock_issue.cancelled? %>
    <div class="card" style="padding: var(--space-5); margin-bottom: var(--space-5); border-inline-start: 3px solid var(--text-2);">
      <p class="td-secondary" style="margin: 0 0 var(--space-1);"><%= t("inventory.stock_issues.cancellation_reason") %></p>
      <p style="margin: 0;"><%= @stock_issue.cancellation_reason %></p>
      <p class="td-secondary" style="margin-top: var(--space-2); font-size: var(--text-xs);">
        <%= @stock_issue.cancelled_by&.full_name || t("inventory.stock_issues.timeline.unknown_actor") %>
        · <%= @stock_issue.cancelled_at ? l(@stock_issue.cancelled_at, format: :short) : "—" %>
      </p>
    </div>
  <% elsif policy(@stock_issue).cancel? %>
    <details id="cancel-panel" class="card" style="padding: var(--space-4); margin-bottom: var(--space-5);">
      <summary class="btn btn-ghost btn-sm text-danger" style="cursor: pointer;">
        <%= t("inventory.stock_issues.cancel_action") %>
      </summary>
      <%= form_with url: cancel_inventory_stock_issue_path(@stock_issue), method: :patch, class: "mt-4" do %>
        <div class="form-group">
          <label class="form-label" for="cancellation_reason"><%= t("inventory.stock_issues.cancellation_reason") %></label>
          <textarea id="cancellation_reason" name="cancellation_reason" rows="2" class="form-control" required
                    placeholder="<%= t('inventory.stock_issues.cancellation_placeholder') %>"></textarea>
        </div>
        <button type="submit" class="btn btn-danger btn-sm"
                data-turbo-confirm="<%= t('inventory.stock_issues.cancel_confirm_dialog') %>">
          <%= t("inventory.stock_issues.cancel_action") %>
        </button>
      <% end %>
    </details>
  <% end %>

  <div class="card" style="padding: var(--space-5); margin-bottom: var(--space-5);">
    <dl class="detail-list">
      <div class="detail-list__row"><dt><%= t("inventory.stock_issues.date") %></dt><dd><%= local_date(@stock_issue.issued_on) %></dd></div>
      <div class="detail-list__row"><dt><%= t("inventory.stock_issues.branch") %></dt><dd><%= @stock_issue.branch&.name || "—" %></dd></div>
      <div class="detail-list__row"><dt><%= t("inventory.stock_issues.warehouse") %></dt><dd><%= @stock_issue.warehouse.name %></dd></div>
      <% if @stock_issue.notes.present? %>
        <div class="detail-list__row"><dt><%= t("inventory.stock_issues.notes") %></dt><dd><%= simple_format(@stock_issue.notes) %></dd></div>
      <% end %>
    </dl>
  </div>

  <% if @availability_lines.present? %>
    <div id="stock-availability" class="card" style="margin-bottom: var(--space-5);">
      <div class="card-header">
        <h2 class="card-title" style="font-size: var(--text-lg);"><%= t("inventory.stock_issues.availability.title") %></h2>
      </div>
      <p class="td-secondary" style="margin: 0; padding: 0 var(--space-5) var(--space-3); font-size: var(--text-xs);">
        <%= t(@stock_issue.approved? ? "inventory.stock_issues.availability.hint_reserved" : "inventory.stock_issues.availability.hint_unreserved") %>
      </p>
      <div class="table-wrap table-wrap--cards">
        <table>
          <thead><tr>
            <th><%= t("inventory.stock_issues.product") %></th>
            <th style="text-align: end;"><%= t("inventory.stock_issues.availability.on_hand") %></th>
            <th style="text-align: end;"><%= t("inventory.stock_issues.availability.reserved") %></th>
            <th style="text-align: end;"><%= t("inventory.stock_issues.availability.available") %></th>
            <th style="text-align: end;"><%= t("inventory.stock_issues.availability.requested") %></th>
            <th><%= t("inventory.stock_issues.availability.status") %></th>
          </tr></thead>
          <tbody>
            <% @availability_lines.each do |line| %>
              <tr data-product-id="<%= line.product.id %>">
                <td data-label="<%= t('inventory.stock_issues.product') %>"><%= line.product.name %></td>
                <td data-label="<%= t('inventory.stock_issues.availability.on_hand') %>" style="text-align: end;"><%= stock_quantity(line.on_hand) %></td>
                <td data-label="<%= t('inventory.stock_issues.availability.reserved') %>" style="text-align: end;"><%= stock_quantity(line.reserved) %></td>
                <td data-label="<%= t('inventory.stock_issues.availability.available') %>" style="text-align: end; font-weight: 600;"><%= stock_quantity(line.available) %></td>
                <td data-label="<%= t('inventory.stock_issues.availability.requested') %>" style="text-align: end;"><%= stock_quantity(line.requested) %></td>
                <td data-label="<%= t('inventory.stock_issues.availability.status') %>">
                  <% if line.shortfall? %>
                    <span class="badge badge-danger"><%= t("inventory.stock_issues.availability.insufficient") %></span>
                  <% else %>
                    <span class="badge badge-success"><%= t("inventory.stock_issues.availability.sufficient") %></span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <div id="items" class="table-wrap table-wrap--cards">
    <table>
      <thead><tr>
        <th><%= t("inventory.stock_issues.product") %></th>
        <th><%= t("inventory.products.sku") %></th>
        <th style="text-align: end;"><%= t("inventory.stock_issues.quantity") %></th>
        <th style="text-align: end;"><%= t("inventory.stock_issues.unit_cost") %></th>
        <th style="text-align: end;"><%= t("inventory.stock_issues.total") %></th>
      </tr></thead>
      <tbody>
        <% @items.each do |item| %>
          <tr>
            <td><%= link_to item.product.name, inventory_product_path(item.product), class: "link" %></td>
            <td class="td-secondary"><%= item.product.sku %></td>
            <td style="text-align: end;"><%= item.quantity.to_i %></td>
            <% if item.cost_unavailable? %>
              <td colspan="2" style="text-align: end;"><span class="badge badge-warning"><%= t("inventory.stock_issues.cost_unavailable") %></span></td>
            <% else %>
              <td style="text-align: end;"><%= format_currency(item.effective_unit_cost) %></td>
              <td style="text-align: end;"><%= format_currency(item.effective_total_cost) %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="4" style="text-align: end; font-weight: 600;"><%= t("inventory.stock_issues.total") %></td>
          <td style="text-align: end; font-weight: 600;"><%= format_currency(@stock_issue.total_value) %></td>
        </tr>
        <% if @stock_issue.cost_estimated? %>
          <tr><td colspan="5" class="td-secondary" style="text-align: start; font-size: var(--text-xs);"><%= t("inventory.stock_issues.cost_estimated_hint") %></td></tr>
        <% end %>
        <% if @stock_issue.cost_unavailable? %>
          <tr><td colspan="5" class="td-secondary" style="text-align: start; font-size: var(--text-xs);"><%= t("inventory.stock_issues.cost_unavailable_hint") %></td></tr>
        <% end %>
      </tfoot>
    </table>
  </div>

  <div class="card" style="margin-top: var(--space-5);">
    <div class="card-header">
      <h2 class="card-title" style="font-size: var(--text-lg);"><%= t("inventory.stock_issues.activity_timeline") %></h2>
    </div>
    <% if @timeline_events.any? %>
      <ul class="activity-timeline" style="padding: var(--space-5);">
        <% @timeline_events.each do |event| %>
          <li class="activity-timeline__item">
            <div class="activity-timeline__marker-col">
              <span class="activity-timeline__marker <%= stock_issue_timeline_marker_class(event[:type]) %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="<%= stock_issue_timeline_icon(event[:type]) %>" />
                </svg>
              </span>
              <span class="activity-timeline__line"></span>
            </div>
            <div class="activity-timeline__content">
              <p class="activity-timeline__title"><%= t("inventory.stock_issues.timeline.#{event[:type]}") %></p>
              <p class="activity-timeline__meta">
                <%= event[:actor]&.full_name || t("inventory.stock_issues.timeline.unknown_actor") %>
                · <%= event[:time] ? l(event[:time], format: :short) : "—" %>
              </p>
              <% if event[:data].present? %>
                <p class="activity-timeline__meta"><%= t("inventory.stock_issues.timeline.reason", reason: event[:data]) %></p>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="td-secondary" style="padding: var(--space-4);"><%= t("inventory.stock_issues.no_history") %></p>
    <% end %>
  </div>
</div>

<% if params[:print] == "1" %>
  <script>
    window.addEventListener("load", () => window.print(), { once: true })
  </script>
<% end %>
