<% content_for :title, t("inventory.imports.summary_title") %>

<div class="admin-page">
  <%= link_to inventory_stock_issues_path, class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    <%= t("inventory.stock_issues.title") %>
  <% end %>

  <div class="page-header"><h1 class="page-title"><%= t("inventory.imports.summary_title") %></h1></div>

  <div class="stats-grid" style="margin-bottom: var(--space-5);">
    <% if @result.issue %>
      <%= link_to inventory_stock_issue_path(@result.issue), class: "stat-card stat-card--success" do %>
        <span class="stat-card__label"><%= t("inventory.imports.created_issue") %></span>
        <span class="stat-card__value"><%= @result.issue.issue_number %></span>
      <% end %>
    <% end %>
    <div class="stat-card">
      <span class="stat-card__label"><%= t("inventory.imports.issued_lines") %></span>
      <span class="stat-card__value"><%= @result.issued_count %></span>
    </div>
    <div class="stat-card <%= 'stat-card--warning' if @result.skipped_count.positive? %>">
      <span class="stat-card__label"><%= t("inventory.imports.skipped") %></span>
      <span class="stat-card__value"><%= @result.skipped_count %></span>
    </div>
  </div>

  <% if @result.skipped.any? %>
    <h2 class="section-title"><%= t("inventory.imports.skipped_rows") %></h2>
    <div class="table-wrap table-wrap--cards">
      <table>
        <thead><tr>
          <th><%= t("inventory.imports.row") %></th>
          <th><%= t("inventory.products.sku") %></th>
          <th><%= t("inventory.imports.reason") %></th>
        </tr></thead>
        <tbody>
          <% @result.skipped.each do |skip| %>
            <tr>
              <td class="td-secondary"><%= skip.row_number || "—" %></td>
              <td class="td-secondary"><%= skip.sku.presence || "—" %></td>
              <td><%= t("inventory.imports.reasons.#{skip.reason}", default: skip.reason.to_s) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
