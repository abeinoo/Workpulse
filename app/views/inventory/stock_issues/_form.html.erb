<% product_options = inventory_product_options_html(@products, barcodes: @product_barcodes) %>
<%= form_with model: [:inventory, stock_issue], class: "form-card", data: { controller: "line-items" } do |f| %>
  <%= render "shared/error_messages", object: stock_issue %>
  <% if stock_issue.persisted? %>
    <%= hidden_field_tag :lock_token, stock_issue.lock_token %>
  <% end %>

  <h2 class="section-title"><%= t("inventory.stock_issues.section_header") %></h2>
  <div class="form-grid">
    <div class="form-group">
      <%= f.label :warehouse_id, t("inventory.stock_issues.warehouse"), class: "form-label" %>
      <%= f.select :warehouse_id,
            options_from_collection_for_select(@warehouses, :id, :name, stock_issue.warehouse_id),
            { include_blank: "— #{t('inventory.stock_issues.select_warehouse')}" },
            class: "form-control #{'is-error' if stock_issue.errors[:warehouse].any?}" %>
    </div>
    <div class="form-group">
      <%= f.label :branch_id, t("inventory.stock_issues.branch"), class: "form-label" %>
      <%= f.select :branch_id,
            options_from_collection_for_select(@branches, :id, :name, stock_issue.branch_id),
            { include_blank: "— #{t('inventory.stock_issues.select_branch')}" },
            class: "form-control #{'is-error' if stock_issue.errors[:branch].any? || stock_issue.errors[:branch_id].any?}" %>
      <p class="form-hint"><%= t("inventory.stock_issues.branch_hint") %></p>
    </div>
    <div class="form-group">
      <%= f.label :issued_on, t("inventory.stock_issues.date"), class: "form-label" %>
      <%= f.date_field :issued_on, class: "form-control" %>
    </div>
    <div class="form-group" style="grid-column: 1 / -1;">
      <%= f.label :notes, t("inventory.stock_issues.notes"), class: "form-label" %>
      <%= f.text_area :notes, rows: 2, class: "form-control" %>
    </div>
  </div>

  <div class="divider"></div>

  <h2 class="section-title"><%= t("inventory.stock_issues.section_items") %></h2>
  <p class="form-hint"><%= t("inventory.stock_issues.cost_note") %></p>
  <p class="form-hint form-hint--info"><%= t("inventory.stock_issues.availability_form_hint") %></p>
  <%= render "inventory/shared/barcode_scanner" %>
  <div class="table-wrap table-wrap--form-cards">
    <table class="line-items-table">
      <thead><tr>
        <th style="width: 60%;"><%= t("inventory.stock_issues.product") %></th>
        <th><%= t("inventory.stock_issues.quantity") %></th>
        <th></th>
      </tr></thead>
      <tbody data-line-items-target="rows">
        <%= f.fields_for :items do |item_f| %>
          <%= render "item_fields", f: item_f, product_options: product_options %>
        <% end %>
      </tbody>
    </table>
  </div>

  <p data-line-items-target="emptyState" class="td-secondary" <%= "hidden" if stock_issue.items.any? %>>
    <%= t("inventory.stock_issues.no_items_hint") %>
  </p>

  <button type="button" class="btn btn-ghost btn-sm" data-action="line-items#add" style="margin-top: var(--space-3);">
    + <%= t("inventory.stock_issues.add_item") %>
  </button>

  <template data-line-items-target="template">
    <%= f.fields_for :items, StockIssueItem.new, child_index: "NEW_INDEX" do |item_f| %>
      <%= render "item_fields", f: item_f, product_options: product_options %>
    <% end %>
  </template>

  <div class="form-actions">
    <% reopening = StockIssue::REOPENED_BY_EDIT_STATUSES.include?(stock_issue.status) %>
    <%= f.submit t(reopening ? "inventory.stock_issues.save_and_return_to_draft" : "inventory.stock_issues.save_draft"),
          class: "btn btn-primary",
          data: (reopening ? { turbo_confirm: t(stock_issue_edit_warning_key(stock_issue)) } : {}) %>
    <%= link_to t("common.cancel"),
          stock_issue.persisted? ? inventory_stock_issue_path(stock_issue) : inventory_stock_issues_path,
          class: "btn btn-ghost" %>
  </div>
<% end %>
