<% content_for :title, t("inventory.stock_issues.title") %>

<div class="admin-page">
  <div class="page-header">
    <h1 class="page-title"><%= t("inventory.stock_issues.title") %></h1>
    <% if current_user.can?(:manage_inventory) || current_user.can?(:manage_stock_issues) %>
      <div class="flex items-center" style="gap: var(--space-2);">
        <%= link_to t("inventory.imports.import_csv"), import_inventory_stock_issues_path, class: "btn btn-secondary btn-sm" %>
        <%= link_to t("inventory.stock_issues.new_action"), new_inventory_stock_issue_path, class: "btn btn-primary btn-sm" %>
      </div>
    <% end %>
  </div>

  <% if @stock_issues.empty? %>
    <div class="empty-state"><p class="empty-state__title"><%= t("inventory.stock_issues.empty") %></p></div>
  <% else %>
    <div class="table-wrap table-wrap--cards">
      <table>
        <thead><tr>
          <th><%= t("inventory.stock_issues.number") %></th>
          <th><%= t("inventory.stock_issues.date") %></th>
          <th><%= t("inventory.stock_issues.warehouse") %></th>
          <th><%= t("inventory.void.status") %></th>
          <th style="text-align: end;"><%= t("inventory.stock_issues.total") %></th>
        </tr></thead>
        <tbody>
          <% @stock_issues.each do |issue| %>
            <tr>
              <td><%= link_to issue.issue_number, inventory_stock_issue_path(issue), class: "link" %></td>
              <td class="td-secondary"><%= local_date(issue.issued_on) %></td>
              <td class="td-secondary"><%= issue.warehouse.name %></td>
              <td>
                <span class="badge <%= issue.voided? ? 'badge-danger' : 'badge-success' %>">
                  <%= issue.voided? ? t("inventory.void.status_voided") : t("inventory.void.status_active") %>
                </span>
              </td>
              <td style="text-align: end;"><%= format_currency(issue.total_value) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
