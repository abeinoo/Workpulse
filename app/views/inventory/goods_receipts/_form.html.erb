<%= form_with model: [:inventory, goods_receipt], class: "form-card", data: { controller: "line-items receipt-supplier funding-source" } do |f| %>
  <%= render "shared/error_messages", object: goods_receipt %>

  <% from_purchase_request = defined?(@purchase_request) && @purchase_request.present? %>
  <% if from_purchase_request %>
    <div class="alert alert-info" style="margin-bottom: var(--space-4);">
      <%= t("inventory.goods_receipts.from_purchase_request") %>:
      <%= link_to @purchase_request.request_number, inventory_purchase_request_path(@purchase_request), class: "link", target: "_blank", rel: "noopener" %>
      — <%= purchase_request_supplier_name(@purchase_request) %>
    </div>
    <%= f.hidden_field :purchase_request_id %>
    <% if @purchase_request.advances_total.positive? %>
      <%= render "inventory/goods_receipts/purchase_request_advances_summary", purchase_request: @purchase_request %>
    <% end %>
  <% end %>

  <h2 class="section-title"><%= t("inventory.goods_receipts.section_header") %></h2>
  <div class="form-grid">
    <div class="form-group">
      <%= f.label :warehouse_id, t("inventory.goods_receipts.warehouse"), class: "form-label" %>
      <%= f.select :warehouse_id,
            options_from_collection_for_select(@warehouses, :id, :name, goods_receipt.warehouse_id),
            { include_blank: "— #{t('inventory.goods_receipts.select_warehouse')}" },
            class: "form-control #{'is-error' if goods_receipt.errors[:warehouse].any?}" %>
      <% if from_purchase_request && goods_receipt.warehouse_id.blank? %>
        <p class="form-hint"><%= t("inventory.goods_receipts.select_warehouse") %></p>
      <% end %>
    </div>
    <div class="form-group">
      <%= f.label :supplier_id, t("inventory.goods_receipts.supplier"), class: "form-label" %>
      <% if from_purchase_request && @purchase_request.supplier_id.present? %>
        <%= f.select :supplier_id,
              options_from_collection_for_select(@suppliers, :id, :name, goods_receipt.supplier_id),
              {}, class: "form-control", disabled: true %>
        <%= f.hidden_field :supplier_id %>
        <p class="form-hint"><%= t("inventory.goods_receipts.supplier_locked_hint") %></p>
      <% else %>
        <%= f.select :supplier_id,
              options_from_collection_for_select(@suppliers, :id, :name, goods_receipt.supplier_id),
              { include_blank: "— #{t('inventory.goods_receipts.no_supplier')}" },
              class: "form-control", data: { "receipt-supplier-target": "supplier" } %>
        <% if from_purchase_request %>
          <p class="form-hint"><%= t("inventory.goods_receipts.supplier_from_open_request_hint") %></p>
        <% end %>
      <% end %>
    </div>
    <div class="form-group">
      <%= f.label :received_on, t("inventory.goods_receipts.date"), class: "form-label" %>
      <%= f.date_field :received_on, class: "form-control" %>
    </div>
    <div class="form-group" style="grid-column: 1 / -1;">
      <%= f.label :notes, t("inventory.goods_receipts.notes"), class: "form-label" %>
      <%= f.text_area :notes, rows: 2, class: "form-control" %>
    </div>
    <div class="form-group" style="grid-column: 1 / -1;">
      <%= f.label :invoices, t("inventory.goods_receipts.invoices"), class: "form-label" %>
      <%= f.file_field :invoices, multiple: true, accept: "image/jpeg,image/png,application/pdf",
            class: "form-control #{'is-error' if goods_receipt.errors[:invoices].any?}" %>
      <p class="form-hint"><%= t("inventory.goods_receipts.invoices_hint") %></p>
    </div>
  </div>

  <div class="divider"></div>

  <% employee_custody_selected = goods_receipt.funding_source_kind == "employee_custody" %>
  <h2 class="section-title"><%= t("inventory.goods_receipts.section_funding_source") %></h2>
  <div class="form-grid">
    <%# Employee Custody is always the current user's own account (resolved
        server-side by Inventory::GoodsReceiptDraftService) — never a
        selectable employee. Without an account it's unavailable, with the reason. %>
    <% GoodsReceipt::FUNDING_SOURCE_KINDS.each do |kind| %>
      <% unavailable = kind == "employee_custody" && @custody_account.nil? %>
      <div class="form-group">
        <label class="form-label" style="<%= 'opacity: 0.55; cursor: not-allowed;' if unavailable %>">
          <%= f.radio_button :funding_source_kind, kind,
                checked:  goods_receipt.funding_source_kind == kind,
                disabled: unavailable,
                required: true,
                "aria-describedby": ("employee-custody-unavailable" if unavailable),
                data: { "funding-source-target": "kindRadio", action: "funding-source#toggle" } %>
          <%= t("inventory.goods_receipts.funding_source_kinds.#{kind}") %>
        </label>
        <% if unavailable %>
          <p id="employee-custody-unavailable" class="form-hint text-warning" style="margin: 0;">
            <%= t("activerecord.errors.models.goods_receipt.attributes.base.no_custody_account") %>
          </p>
        <% end %>
      </div>
    <% end %>

    <div data-funding-source-target="panel" class="form-group <%= 'hidden' unless employee_custody_selected %>"
         style="grid-column: 1 / -1;" <%= "hidden" unless employee_custody_selected %>>
      <p class="form-label"><%= t("inventory.goods_receipts.my_balance") %></p>
      <% if @custody_account %>
        <p id="employee-custody-balance" style="font-weight: 600;"><%= format_currency(@custody_balance) %></p>
      <% else %>
        <p class="form-hint"><%= t("activerecord.errors.models.goods_receipt.attributes.base.no_custody_account") %></p>
      <% end %>
    </div>
  </div>

  <h2 class="section-title"><%= t("inventory.goods_receipts.section_items") %></h2>
  <%= render "inventory/shared/barcode_scanner" %>
  <div class="table-wrap table-wrap--form-cards">
    <table class="line-items-table">
      <thead><tr>
        <th style="width: 45%;"><%= t("inventory.goods_receipts.product") %></th>
        <th><%= t("inventory.goods_receipts.quantity") %></th>
        <th><%= t("inventory.goods_receipts.unit_cost") %></th>
        <th></th>
      </tr></thead>
      <tbody data-line-items-target="rows">
        <%= f.fields_for :items do |item_f| %>
          <%= render "item_fields", f: item_f, products: @products %>
        <% end %>
      </tbody>
    </table>
  </div>

  <p data-line-items-target="emptyState" class="td-secondary" <%= "hidden" if goods_receipt.items.any? %>>
    <%= t("inventory.goods_receipts.no_items_hint") %>
  </p>

  <button type="button" class="btn btn-ghost btn-sm" data-action="line-items#add" style="margin-top: var(--space-3);">
    + <%= t("inventory.goods_receipts.add_item") %>
  </button>

  <%# Template for new rows (index replaced by JS) %>
  <template data-line-items-target="template">
    <%= f.fields_for :items, GoodsReceiptItem.new, child_index: "NEW_INDEX" do |item_f| %>
      <%= render "item_fields", f: item_f, products: @products %>
    <% end %>
  </template>

  <div class="form-actions">
    <%= f.submit t("inventory.goods_receipts.save_draft"), class: "btn btn-primary" %>
    <%= link_to t("common.cancel"), inventory_goods_receipts_path, class: "btn btn-ghost" %>
  </div>
<% end %>
