<% content_for :title, @goods_receipt.receipt_number %>

<div class="admin-page">
  <%# 1–2. Header: number + status, and the single action group (ends with رجوع) %>
  <header class="record-header">
    <div class="record-header__title">
      <h1 class="page-title"><%= @goods_receipt.receipt_number %></h1>
      <div class="record-header__badges">
        <span class="badge <%= goods_receipt_approval_status_class(@goods_receipt.approval_status) %>" data-testid="gr-header-approval">
          <%= t("inventory.goods_receipts.approval_statuses.#{@goods_receipt.approval_status}") %>
        </span>
        <span class="badge <%= goods_receipt_receipt_status_class(@goods_receipt) %>" data-testid="gr-header-receiving">
          <%= t("inventory.goods_receipts.receipt_statuses.#{goods_receipt_receipt_status(@goods_receipt)}") %>
        </span>
      </div>
    </div>
    <%= render "actions_bar", receipt: @goods_receipt %>
  </header>

  <%# What approving will pay from custody — shown right under the Approve action %>
  <% if policy(@goods_receipt).approve? && (preview = @custody_payment_preview) %>
    <section class="card" style="padding: var(--space-4); margin-bottom: var(--space-3);" id="custody-payment-preview">
      <h2 class="card-title" style="font-size: var(--text-lg); margin-bottom: var(--space-3);"><%= t("inventory.goods_receipts.custody_payment_preview.title") %></h2>
      <%= render "custody_payment_preview", preview: preview %>
    </section>
  <% end %>

  <%# 3. Current status summary %>
  <div class="card" style="padding: var(--space-5); margin-bottom: var(--space-5);">
    <h2 class="card-title" style="font-size: var(--text-lg); margin-bottom: var(--space-4);"><%= t("inventory.goods_receipts.current_status") %></h2>
    <div class="flex" style="gap: var(--space-6); flex-wrap: wrap;">
      <div>
        <p class="td-secondary" style="margin: 0 0 var(--space-1);"><%= t("inventory.goods_receipts.approval_status_label") %></p>
        <span class="badge badge--md <%= goods_receipt_approval_status_class(@goods_receipt.approval_status) %>">
          <%= t("inventory.goods_receipts.approval_statuses.#{@goods_receipt.approval_status}") %>
        </span>
      </div>
      <div>
        <p class="td-secondary" style="margin: 0 0 var(--space-1);"><%= t("inventory.goods_receipts.receipt_status_label") %></p>
        <span class="badge badge--md <%= goods_receipt_receipt_status_class(@goods_receipt) %>">
          <%= t("inventory.goods_receipts.receipt_statuses.#{goods_receipt_receipt_status(@goods_receipt)}") %>
        </span>
      </div>
      <div>
        <p class="td-secondary" style="margin: 0 0 var(--space-1);"><%= t("inventory.goods_receipts.financial_status_label") %></p>
        <span class="badge badge--md <%= goods_receipt_financial_status_class(@goods_receipt.financial_status) %>">
          <%= t("inventory.goods_receipts.financial_statuses.#{@goods_receipt.financial_status}") %>
        </span>
        <% if @goods_receipt.approval_approved? && !@goods_receipt.voided? %>
          <p class="td-secondary" style="margin: var(--space-2) 0 0;">
            <%= t("inventory.goods_receipts.total_amount") %>: <strong><%= format_currency(@settlement_total) %></strong>
            · <%= t("inventory.goods_receipts.paid_amount") %>: <strong><%= format_currency(@settled_amount) %></strong>
            · <%= t("inventory.goods_receipts.remaining_amount") %>: <strong><%= format_currency(@remaining_amount) %></strong>
          </p>
        <% end %>
        <% if policy(@goods_receipt).settle? %>
          <%= link_to new_inventory_goods_receipt_settlement_path(@goods_receipt), class: "btn btn-primary btn-sm",
                style: "margin-top: var(--space-3); display: inline-flex; gap: var(--space-2); align-items: center;" do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="<%= goods_receipt_timeline_icon(:settled) %>"/></svg>
            <%= t("inventory.goods_receipts.settlements.action") %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <% if @goods_receipt.voided? %>
    <%= render "inventory/shared/void_panel", document: @goods_receipt, void_path: nil, can_void: false %>
  <% end %>

  <%# 4. Source purchase request %>
  <% if @goods_receipt.purchase_request.present? %>
    <div class="card" style="padding: var(--space-4); margin-bottom: var(--space-5);">
      <p class="td-secondary" style="margin: 0 0 var(--space-1);"><%= t("inventory.goods_receipts.original_purchase_request") %></p>
      <%= link_to @goods_receipt.purchase_request.request_number, inventory_purchase_request_path(@goods_receipt.purchase_request), class: "link" %>
      <span class="td-secondary">— <%= purchase_request_supplier_name(@goods_receipt.purchase_request) %></span>
    </div>
  <% end %>

  <%# 5. Payment / custody %>
  <div class="card" style="padding: var(--space-5); margin-bottom: var(--space-5);">
    <h2 class="card-title" style="font-size: var(--text-lg); margin-bottom: var(--space-3);"><%= t("inventory.goods_receipts.payment_information") %></h2>
    <dl class="detail-list">
      <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.payment_source") %></dt>
        <dd><%= t("inventory.goods_receipts.funding_source_kinds.#{@goods_receipt.funding_source_kind}") %></dd>
      </div>
      <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.financial_status") %></dt>
        <dd>
          <span class="badge <%= goods_receipt_financial_status_class(@goods_receipt.financial_status) %>">
            <%= t("inventory.goods_receipts.financial_statuses.#{@goods_receipt.financial_status}") %>
          </span>
        </dd>
      </div>
      <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.total_amount") %></dt><dd><%= format_currency(@goods_receipt.total_value) %></dd></div>
      <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.paid_amount") %></dt><dd><%= format_currency(@goods_receipt.total_settled_amount) %></dd></div>
      <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.remaining_amount") %></dt><dd><%= format_currency(@goods_receipt.remaining_settlement_amount) %></dd></div>
      <% if @goods_receipt.employee_custody_funded? %>
        <% original_settlement = @settlements.find { |s| s.amount.positive? } %>
        <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.custody_account") %></dt>
          <dd>
            <% if @goods_receipt.funding_source.present? %>
              <%= link_to @goods_receipt.funding_source.name, finance_custody_account_path(@goods_receipt.funding_source), class: "link" %>
            <% else %>
              —
            <% end %>
          </dd>
        </div>
        <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.custody_transaction_reference") %></dt>
          <dd>
            <% custody_txn = @goods_receipt.custody_transactions.of_type("inventory_purchase").first %>
            <%= custody_txn ? "##{custody_txn.id}" : "—" %>
          </dd>
        </div>
        <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.financial_settlement_reference") %></dt>
          <dd><%= original_settlement ? "##{original_settlement.id}" : "—" %></dd>
        </div>
      <% end %>
    </dl>

  </div>

  <% if @advance_allocator && (@goods_receipt.purchase_request.advances_total.positive? || @advance_allocator.receipt_applied_amount.positive?) %>
    <%= render "purchase_request_advances_summary", purchase_request: @goods_receipt.purchase_request, allocator: @advance_allocator %>
  <% end %>

  <%# 6–7. Receipt details: date, supplier, warehouse, notes %>
  <div class="card" style="padding: var(--space-5); margin-bottom: var(--space-5);">
    <dl class="detail-list">
      <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.date") %></dt><dd><%= local_date(@goods_receipt.received_on) %></dd></div>
      <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.supplier") %></dt><dd><%= @goods_receipt.supplier&.name || "—" %></dd></div>
      <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.warehouse") %></dt><dd><%= @goods_receipt.warehouse.name %></dd></div>
      <% if @goods_receipt.notes.present? %>
        <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.notes") %></dt><dd><%= simple_format(@goods_receipt.notes) %></dd></div>
      <% end %>
    </dl>
  </div>

  <%# 8. Items %>
  <div class="table-wrap table-wrap--cards" style="margin-bottom: var(--space-5);">
    <table>
      <thead><tr>
        <th><%= t("inventory.goods_receipts.product") %></th>
        <th><%= t("inventory.products.sku") %></th>
        <th style="text-align: end;"><%= t("inventory.goods_receipts.quantity") %></th>
        <th style="text-align: end;"><%= t("inventory.goods_receipts.unit_cost") %></th>
        <th style="text-align: end;"><%= t("inventory.goods_receipts.total") %></th>
      </tr></thead>
      <tbody>
        <% @items.each do |item| %>
          <tr>
            <td><%= link_to item.product.name, inventory_product_path(item.product), class: "link" %></td>
            <td class="td-secondary"><%= item.product.sku %></td>
            <td style="text-align: end;"><%= item.quantity.to_i %></td>
            <td style="text-align: end;"><%= format_currency(item.unit_cost) %></td>
            <td style="text-align: end;"><%= format_currency(item.total_cost) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="4" style="text-align: end; font-weight: 600;"><%= t("inventory.goods_receipts.total") %></td>
          <td style="text-align: end; font-weight: 600;"><%= format_currency(@goods_receipt.total_value) %></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <%# 9. Financial details: settlements and supplier invoices %>
  <div class="card" style="padding: var(--space-5); margin-bottom: var(--space-5);">
    <div class="flex" style="justify-content: space-between; align-items: center; gap: var(--space-3); flex-wrap: wrap; margin-bottom: var(--space-3);">
      <h2 class="card-title" style="font-size: var(--text-lg); margin: 0;"><%= t("inventory.goods_receipts.settlements.history_title") %></h2>
      <% if policy(@goods_receipt).settle? %>
        <%= link_to t("inventory.goods_receipts.settlements.action"), new_inventory_goods_receipt_settlement_path(@goods_receipt),
              class: "btn btn-ghost btn-sm" %>
      <% end %>
    </div>

    <% if @settlements.any? %>
      <% can_reverse = policy(@goods_receipt).reverse_settlement? %>
      <%# Each cell's content sits in ONE wrapper so the mobile card layout
          (td = label/value flex row) keeps multi-line values together. %>
      <div class="table-wrap table-wrap--cards">
        <table>
          <thead><tr>
            <th><%= t("inventory.goods_receipts.settlement_date") %></th>
            <th style="text-align: end;"><%= t("inventory.goods_receipts.settlement_amount") %></th>
            <th><%= t("inventory.goods_receipts.settlements.source") %></th>
            <th><%= t("inventory.goods_receipts.settlements.reference") %></th>
            <th><%= t("inventory.goods_receipts.settlements.recorded_by") %></th>
            <th style="min-width: 180px;"><%= t("inventory.goods_receipts.settlements.status") %></th>
          </tr></thead>
          <tbody>
            <% @settlements.each do |settlement| %>
              <tr id="settlement-<%= settlement.id %>">
                <td><%= local_date(settlement.settled_at.to_date) %></td>
                <td style="text-align: end; white-space: nowrap; color: <%= settlement.amount.negative? ? 'var(--danger)' : 'var(--success)' %>;">
                  <%= format_currency(settlement.amount) %>
                </td>
                <td>
                  <div>
                    <%= financial_settlement_source_label(settlement) %>
                    <% if settlement.advance_application? && @goods_receipt.purchase_request %>
                      <div>
                        <%= link_to t("inventory.purchase_request_advances.advance_ref", id: settlement.funding_source_id),
                              inventory_purchase_request_path(@goods_receipt.purchase_request, anchor: "advance-#{settlement.funding_source_id}"),
                              class: "link" %>
                      </div>
                    <% end %>
                    <% if settlement.funding_source.is_a?(CustodyAccount) %>
                      <div>
                        <%= link_to settlement.funding_source.user&.full_name || settlement.funding_source.name,
                              finance_custody_account_path(settlement.funding_source), class: "link" %>
                      </div>
                      <% if settlement.custody_transaction %>
                        <div class="td-secondary">
                          <%= t("inventory.goods_receipts.settlements.custody_transaction_ref", id: settlement.custody_transaction.id) %>
                        </div>
                      <% end %>
                    <% end %>
                  </div>
                </td>
                <td class="td-secondary">
                  <div>
                    <%= settlement.reference.presence || "—" %>
                    <div><%= t("inventory.goods_receipts.settlements.settlement_ref", id: settlement.id) %></div>
                  </div>
                </td>
                <td><%= settlement.created_by&.full_name || t("inventory.goods_receipts.timeline.unknown_actor") %></td>
                <td>
                  <div style="flex: 1 1 auto; min-width: 0;">
                    <% if settlement.reversal? %>
                      <span class="badge badge-neutral"><%= t("inventory.goods_receipts.settlements.statuses.reversal") %></span>
                      <p class="td-secondary" style="margin: var(--space-1) 0 0;">
                        <%= t("inventory.goods_receipts.settlements.reversal_of", id: settlement.reverses_settlement_id) %>
                      </p>
                    <% elsif settlement.reversed? %>
                      <span class="badge badge-danger"><%= t("inventory.goods_receipts.settlements.statuses.reversed") %></span>
                      <p class="td-secondary" style="margin: var(--space-1) 0 0;">
                        <%= t("inventory.goods_receipts.settlements.reversed_meta",
                              actor: settlement.reversal.created_by&.full_name || t("inventory.goods_receipts.timeline.unknown_actor"),
                              date: l(settlement.reversal.created_at, format: :short)) %>
                      </p>
                      <% if settlement.reversal.notes.present? %>
                        <p class="td-secondary" style="margin: var(--space-1) 0 0;">
                          <%= t("inventory.goods_receipts.timeline.reason", reason: settlement.reversal.notes) %>
                        </p>
                      <% end %>
                    <% else %>
                      <span class="badge badge-success"><%= t("inventory.goods_receipts.settlements.statuses.active") %></span>
                    <% end %>
                    <% if settlement.notes.present? && !settlement.reversal? %>
                      <p class="td-secondary" style="margin: var(--space-1) 0 0;"><%= settlement.notes %></p>
                    <% end %>

                    <% if can_reverse && !settlement.reversal? && !settlement.reversed? && !settlement.advance_application? %>
                      <details style="margin-top: var(--space-2);">
                        <summary class="btn btn-ghost btn-sm text-danger" style="cursor: pointer; display: inline-flex;">
                          <%= t("inventory.goods_receipts.settlements.reverse_action") %>
                        </summary>
                        <%= form_with url: reverse_inventory_goods_receipt_settlement_path(@goods_receipt, settlement), method: :patch,
                                      style: "margin-top: var(--space-3); max-width: 360px;" do %>
                          <div class="form-group">
                            <label class="form-label" for="reversal_reason_<%= settlement.id %>"><%= t("inventory.goods_receipts.settlements.reversal_reason") %></label>
                            <textarea id="reversal_reason_<%= settlement.id %>" name="reversal_reason" rows="2" class="form-control" required
                                      placeholder="<%= t('inventory.goods_receipts.settlements.reversal_reason_placeholder') %>"></textarea>
                          </div>
                          <button type="submit" class="btn btn-danger btn-sm"
                                  data-turbo-confirm="<%= t('inventory.goods_receipts.settlements.reverse_confirm', amount: format_currency(settlement.amount)) %>">
                            <%= t("inventory.goods_receipts.settlements.reverse_submit") %>
                          </button>
                        <% end %>
                      </details>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="td-secondary"><%= t("inventory.goods_receipts.no_settlements") %></p>
    <% end %>

    <dl class="detail-list" style="margin-top: var(--space-4); margin-bottom: 0;">
      <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.total_amount") %></dt><dd><%= format_currency(@settlement_total) %></dd></div>
      <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.settlements.total_paid") %></dt><dd><strong><%= format_currency(@settled_amount) %></strong></dd></div>
      <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.remaining_amount") %></dt><dd><strong><%= format_currency(@remaining_amount) %></strong></dd></div>
      <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.financial_status_label") %></dt>
        <dd><span class="badge <%= goods_receipt_financial_status_class(@goods_receipt.financial_status) %>"><%= t("inventory.goods_receipts.financial_statuses.#{@goods_receipt.financial_status}") %></span></dd>
      </div>
    </dl>
  </div>

  <div class="card" style="margin-bottom: var(--space-5);">
    <div class="card-header">
      <h2 class="card-title" style="font-size: var(--text-lg);"><%= t("inventory.goods_receipts.invoices") %></h2>
    </div>
    <% if @goods_receipt.invoices.attached? %>
      <div class="attachment-grid">
        <% @goods_receipt.invoices.each do |invoice| %>
          <div class="attachment-item">
            <p class="attachment-item__label"><%= invoice.filename.to_s %></p>
            <%= document_viewer_tag(invoice) %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="td-secondary" style="padding: var(--space-4);"><%= t("inventory.goods_receipts.no_invoices") %></p>
    <% end %>
  </div>

  <%# 10. History %>
  <div class="card" style="margin-top: var(--space-5);">
    <div class="card-header">
      <h2 class="card-title" style="font-size: var(--text-lg);"><%= t("inventory.goods_receipts.activity_timeline") %></h2>
    </div>
    <% if @timeline_events.any? %>
      <ul class="activity-timeline" style="padding: var(--space-5);">
        <% @timeline_events.each do |event| %>
          <li class="activity-timeline__item">
            <div class="activity-timeline__marker-col">
              <span class="activity-timeline__marker <%= goods_receipt_timeline_marker_class(event[:type]) %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="<%= goods_receipt_timeline_icon(event[:type]) %>" />
                </svg>
              </span>
              <span class="activity-timeline__line"></span>
            </div>
            <div class="activity-timeline__content">
              <p class="activity-timeline__title"><%= t("inventory.goods_receipts.timeline.#{event[:type]}") %></p>
              <% if event[:type] == :settled %>
                <p class="activity-timeline__meta">
                  <%= t("inventory.goods_receipts.timeline.settled_meta", source: financial_settlement_source_label(event[:data])) %>
                  · <%= event[:actor]&.full_name || t("inventory.goods_receipts.timeline.unknown_actor") %>
                  · <%= l(event[:time], format: :short) %>
                </p>
                <p class="activity-timeline__amount"><%= format_currency(event[:data].amount) %></p>
              <% else %>
                <p class="activity-timeline__meta">
                  <%= event[:actor]&.full_name || t("inventory.goods_receipts.timeline.unknown_actor") %>
                  · <%= l(event[:time], format: :short) %>
                </p>
                <% if event[:data].present? %>
                  <p class="activity-timeline__meta"><%= t("inventory.goods_receipts.timeline.reason", reason: event[:data]) %></p>
                <% end %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="td-secondary" style="padding: var(--space-4);"><%= t("inventory.goods_receipts.no_history") %></p>
    <% end %>
  </div>
</div>
