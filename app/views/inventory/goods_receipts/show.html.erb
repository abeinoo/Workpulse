<% content_for :title, @goods_receipt.receipt_number %>

<div class="admin-page">
  <%= link_to inventory_goods_receipts_path, class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    <%= t("forms.back") %>
  <% end %>

  <div class="page-header">
    <h1 class="page-title"><%= @goods_receipt.receipt_number %></h1>
    <div class="flex" style="gap: var(--space-2);">
      <% if policy(@goods_receipt).update? %>
        <%= link_to t("inventory.goods_receipts.edit_action"), edit_inventory_goods_receipt_path(@goods_receipt), class: "btn btn-ghost btn-sm" %>
      <% end %>
      <% if policy(@goods_receipt).submit_for_approval? %>
        <%= button_to t("inventory.goods_receipts.submit_for_approval"), submit_inventory_goods_receipt_path(@goods_receipt),
              method: :post, class: "btn btn-primary btn-sm" %>
      <% end %>
      <% if @goods_receipt.approval_approved? && @goods_receipt.draft? && policy(@goods_receipt).confirm? %>
        <%= button_to t("inventory.goods_receipts.confirm"), confirm_inventory_goods_receipt_path(@goods_receipt),
              method: :post, class: "btn btn-primary",
              data: { turbo_confirm: t("inventory.goods_receipts.confirm_hint") } %>
      <% end %>
    </div>
  </div>

  <div class="card" style="padding: var(--space-5); margin-bottom: var(--space-5);">
    <h2 class="card-title" style="font-size: var(--text-lg); margin-bottom: var(--space-4);"><%= t("inventory.goods_receipts.current_status") %></h2>
    <div class="flex" style="gap: var(--space-6); flex-wrap: wrap;">
      <div>
        <p class="td-secondary" style="margin: 0 0 var(--space-1);"><%= t("inventory.goods_receipts.approval_status_label") %></p>
        <span class="badge badge--md <%= goods_receipt_approval_status_class(@goods_receipt.approval_status) %>">
          <%= t("inventory.goods_receipts.approval_statuses.#{@goods_receipt.approval_status}") %>
        </span>
      </div>
      <div>
        <p class="td-secondary" style="margin: 0 0 var(--space-1);"><%= t("inventory.goods_receipts.receipt_status_label") %></p>
        <span class="badge badge--md <%= goods_receipt_receipt_status_class(@goods_receipt) %>">
          <%= t("inventory.goods_receipts.receipt_statuses.#{goods_receipt_receipt_status(@goods_receipt)}") %>
        </span>
      </div>
      <div>
        <p class="td-secondary" style="margin: 0 0 var(--space-1);"><%= t("inventory.goods_receipts.financial_status_label") %></p>
        <span class="badge badge--md <%= goods_receipt_financial_status_class(@goods_receipt.financial_status) %>">
          <%= t("inventory.goods_receipts.financial_statuses.#{@goods_receipt.financial_status}") %>
        </span>
      </div>
    </div>
  </div>

  <% if @goods_receipt.approval_pending_approval? && policy(@goods_receipt).approve? %>
    <div class="card" style="padding: var(--space-4); margin-bottom: var(--space-5); display: flex; gap: var(--space-3); align-items: center; flex-wrap: wrap;">
      <%= button_to t("inventory.goods_receipts.approve"), approve_inventory_goods_receipt_path(@goods_receipt),
            method: :post, class: "btn btn-primary btn-sm",
            data: { turbo_confirm: t("inventory.goods_receipts.approve_hint") } %>
      <details style="flex: 1;">
        <summary class="btn btn-ghost btn-sm text-danger" style="cursor: pointer; display: inline-flex;">
          <%= t("inventory.goods_receipts.reject") %>
        </summary>
        <%= form_with url: reject_inventory_goods_receipt_path(@goods_receipt), method: :post, class: "mt-4" do %>
          <div class="form-group">
            <label class="form-label" for="rejection_reason"><%= t("inventory.goods_receipts.rejection_reason") %></label>
            <textarea id="rejection_reason" name="rejection_reason" rows="2" class="form-control" required
                      placeholder="<%= t('inventory.goods_receipts.rejection_reason_placeholder') %>"></textarea>
          </div>
          <button type="submit" class="btn btn-danger btn-sm"
                  data-turbo-confirm="<%= t('inventory.goods_receipts.reject_confirm') %>">
            <%= t("inventory.goods_receipts.reject_submit") %>
          </button>
        <% end %>
      </details>
    </div>
  <% end %>

  <% if @goods_receipt.confirmed? || @goods_receipt.approval_approved? %>
    <%= render "inventory/shared/void_panel",
          document: @goods_receipt,
          void_path: void_inventory_goods_receipt_path(@goods_receipt),
          can_void: policy(@goods_receipt).void? %>
  <% elsif policy(@goods_receipt).cancel? %>
    <%= render "inventory/shared/void_panel",
          document: @goods_receipt,
          void_path: cancel_inventory_goods_receipt_path(@goods_receipt),
          can_void: true,
          panel_id: "cancel-panel",
          action_label: t("inventory.goods_receipts.cancel_action"),
          confirm_dialog: t("inventory.goods_receipts.cancel_confirm_dialog"),
          reason_label: t("inventory.goods_receipts.cancellation_reason"),
          reason_placeholder: t("inventory.goods_receipts.cancellation_placeholder"),
          param_name: :cancellation_reason %>
  <% end %>

  <div class="card" style="padding: var(--space-5); margin-bottom: var(--space-5);">
    <dl class="detail-list">
      <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.date") %></dt><dd><%= local_date(@goods_receipt.received_on) %></dd></div>
      <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.supplier") %></dt><dd><%= @goods_receipt.supplier&.name || "—" %></dd></div>
      <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.warehouse") %></dt><dd><%= @goods_receipt.warehouse.name %></dd></div>
      <% if @goods_receipt.notes.present? %>
        <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.notes") %></dt><dd><%= simple_format(@goods_receipt.notes) %></dd></div>
      <% end %>
    </dl>
  </div>

  <div class="card" style="padding: var(--space-5); margin-bottom: var(--space-5);">
    <h2 class="card-title" style="font-size: var(--text-lg); margin-bottom: var(--space-3);"><%= t("inventory.goods_receipts.payment_information") %></h2>
    <dl class="detail-list">
      <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.payment_source") %></dt>
        <dd><%= t("inventory.goods_receipts.funding_source_kinds.#{@goods_receipt.funding_source_kind}") %></dd>
      </div>
      <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.financial_status") %></dt>
        <dd>
          <span class="badge <%= goods_receipt_financial_status_class(@goods_receipt.financial_status) %>">
            <%= t("inventory.goods_receipts.financial_statuses.#{@goods_receipt.financial_status}") %>
          </span>
        </dd>
      </div>
      <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.total_amount") %></dt><dd><%= format_currency(@goods_receipt.total_value) %></dd></div>
      <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.paid_amount") %></dt><dd><%= format_currency(@goods_receipt.total_settled_amount) %></dd></div>
      <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.remaining_amount") %></dt><dd><%= format_currency(@goods_receipt.remaining_settlement_amount) %></dd></div>
      <% if @goods_receipt.employee_custody_funded? %>
        <% original_settlement = @settlements.find { |s| s.amount.positive? } %>
        <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.custody_account") %></dt>
          <dd>
            <% if @goods_receipt.funding_source.present? %>
              <%= link_to @goods_receipt.funding_source.name, finance_custody_account_path(@goods_receipt.funding_source), class: "link" %>
            <% else %>
              —
            <% end %>
          </dd>
        </div>
        <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.custody_transaction_reference") %></dt>
          <dd>
            <% custody_txn = @goods_receipt.custody_transactions.of_type("inventory_purchase").first %>
            <%= custody_txn ? "##{custody_txn.id}" : "—" %>
          </dd>
        </div>
        <div class="detail-list__row"><dt><%= t("inventory.goods_receipts.financial_settlement_reference") %></dt>
          <dd><%= original_settlement ? "##{original_settlement.id}" : "—" %></dd>
        </div>
      <% end %>
    </dl>

    <% if @settlements.any? %>
      <div class="table-wrap" style="margin-top: var(--space-4);">
        <table>
          <thead><tr>
            <th><%= t("inventory.goods_receipts.settlement_date") %></th>
            <th><%= t("inventory.goods_receipts.settlement_source") %></th>
            <th style="text-align: end;"><%= t("inventory.goods_receipts.settlement_amount") %></th>
            <th><%= t("finance.common.notes") %></th>
          </tr></thead>
          <tbody>
            <% @settlements.each do |settlement| %>
              <tr>
                <td><%= l(settlement.settled_at.to_date, format: :long) %></td>
                <td>
                  <% if settlement.funding_source.is_a?(CustodyAccount) %>
                    <%= link_to settlement.funding_source.name, finance_custody_account_path(settlement.funding_source), class: "link" %>
                  <% else %>
                    <%= settlement.funding_source_type %>
                  <% end %>
                </td>
                <td style="text-align: end; color: <%= settlement.amount.negative? ? 'var(--danger)' : 'var(--success)' %>;">
                  <%= format_currency(settlement.amount) %>
                </td>
                <td class="td-secondary"><%= settlement.notes.presence || "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="td-secondary" style="margin-top: var(--space-3);"><%= t("inventory.goods_receipts.no_settlements") %></p>
    <% end %>
  </div>

  <div class="card" style="margin-bottom: var(--space-5);">
    <div class="card-header">
      <h2 class="card-title" style="font-size: var(--text-lg);"><%= t("inventory.goods_receipts.invoices") %></h2>
    </div>
    <% if @goods_receipt.invoices.attached? %>
      <div class="attachment-grid">
        <% @goods_receipt.invoices.each do |invoice| %>
          <div class="attachment-item">
            <p class="attachment-item__label"><%= invoice.filename.to_s %></p>
            <%= document_viewer_tag(invoice) %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="td-secondary" style="padding: var(--space-4);"><%= t("inventory.goods_receipts.no_invoices") %></p>
    <% end %>
  </div>

  <div class="table-wrap table-wrap--cards">
    <table>
      <thead><tr>
        <th><%= t("inventory.goods_receipts.product") %></th>
        <th><%= t("inventory.products.sku") %></th>
        <th style="text-align: end;"><%= t("inventory.goods_receipts.quantity") %></th>
        <th style="text-align: end;"><%= t("inventory.goods_receipts.unit_cost") %></th>
        <th style="text-align: end;"><%= t("inventory.goods_receipts.total") %></th>
      </tr></thead>
      <tbody>
        <% @items.each do |item| %>
          <tr>
            <td><%= link_to item.product.name, inventory_product_path(item.product), class: "link" %></td>
            <td class="td-secondary"><%= item.product.sku %></td>
            <td style="text-align: end;"><%= item.quantity.to_i %></td>
            <td style="text-align: end;"><%= format_currency(item.unit_cost) %></td>
            <td style="text-align: end;"><%= format_currency(item.total_cost) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="4" style="text-align: end; font-weight: 600;"><%= t("inventory.goods_receipts.total") %></td>
          <td style="text-align: end; font-weight: 600;"><%= format_currency(@goods_receipt.total_value) %></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="card" style="margin-top: var(--space-5);">
    <div class="card-header">
      <h2 class="card-title" style="font-size: var(--text-lg);"><%= t("inventory.goods_receipts.activity_timeline") %></h2>
    </div>
    <% if @timeline_events.any? %>
      <ul class="activity-timeline" style="padding: var(--space-5);">
        <% @timeline_events.each do |event| %>
          <li class="activity-timeline__item">
            <div class="activity-timeline__marker-col">
              <span class="activity-timeline__marker <%= goods_receipt_timeline_marker_class(event[:type]) %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="<%= goods_receipt_timeline_icon(event[:type]) %>" />
                </svg>
              </span>
              <span class="activity-timeline__line"></span>
            </div>
            <div class="activity-timeline__content">
              <p class="activity-timeline__title"><%= t("inventory.goods_receipts.timeline.#{event[:type]}") %></p>
              <% if event[:type] == :settled %>
                <p class="activity-timeline__meta">
                  <%= t("inventory.goods_receipts.timeline.settled_meta",
                        source: t("inventory.goods_receipts.funding_source_kinds.#{@goods_receipt.funding_source_kind}")) %>
                  · <%= l(event[:time], format: :short) %>
                </p>
                <p class="activity-timeline__amount"><%= format_currency(event[:data].amount) %></p>
              <% else %>
                <p class="activity-timeline__meta">
                  <%= event[:actor]&.full_name || t("inventory.goods_receipts.timeline.unknown_actor") %>
                  · <%= l(event[:time], format: :short) %>
                </p>
                <% if event[:data].present? %>
                  <p class="activity-timeline__meta"><%= t("inventory.goods_receipts.timeline.reason", reason: event[:data]) %></p>
                <% end %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="td-secondary" style="padding: var(--space-4);"><%= t("inventory.goods_receipts.no_history") %></p>
    <% end %>
  </div>
</div>
