<tr data-line-row>
  <td>
    <%= product_combobox(f, :product_id, selected: f.object.product,
                         select_data: { product_field: true, action: "change->receipt-supplier#productChanged" }) %>
    <% if local_assigns[:extra] %>
      <span class="badge badge-neutral line-items-extra-badge"><%= t("inventory.goods_receipts.outside_request_badge") %></span>
    <% end %>
  </td>
  <% if local_assigns[:request_columns] %>
    <%# Outside the request: no ordered / received / remaining figures. %>
    <td class="gr-num td-secondary">—</td>
    <td class="gr-num td-secondary">—</td>
    <td class="gr-num td-secondary">—</td>
  <% end %>
  <td>
    <% pri = f.object.purchase_request_item %>
    <%= f.hidden_field :purchase_request_item_id if pri %>
    <%= render "inventory/shared/line_quantity", f: f, max: pri&.remaining_quantity, default_level_id: pri&.packaging_level_id %>
    <% if pri %>
      <p class="form-hint"><%= t("inventory.goods_receipts.quantity_hint_remaining", remaining: pri.remaining_quantity) %></p>
    <% end %>
  </td>
  <td>
    <%# The cost per the line's unit (per carton for a carton line); stored per base unit. %>
    <%= f.number_field :entered_unit_cost, value: f.object.unit_cost_per_entered_unit, step: "any", min: 0,
          class: "form-control", placeholder: "0.00", data: { cost_field: true } %>
  </td>
  <td class="line-items-table__total" data-line-total aria-live="off">—</td>
  <td class="td-actions">
    <% if f.object.persisted? %>
      <%= f.hidden_field :_destroy, value: "0", data: { destroy_field: true } %>
    <% end %>
    <button type="button" class="btn btn-ghost btn-sm text-danger" data-action="line-items#remove" aria-label="<%= t('common.delete') %>">×</button>
  </td>
</tr>
