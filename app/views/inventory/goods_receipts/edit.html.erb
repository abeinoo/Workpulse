<% content_for :title, t("inventory.goods_receipts.edit_title") %>

<div class="form-page form-page--wide">
  <%= link_to inventory_goods_receipt_path(@goods_receipt), class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    <%= t("forms.back") %>
  <% end %>
  <h1 class="page-title mb-6"><%= t("inventory.goods_receipts.edit_title") %></h1>
  <%= render "form", goods_receipt: @goods_receipt %>
</div>
