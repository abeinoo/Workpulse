<tr data-line-row>
  <td>
    <%= f.select :product_id,
          options_from_collection_for_select(products, :id, ->(p) { "#{p.name} (#{p.sku})" }, f.object.product_id),
          { include_blank: "— #{t('inventory.stock_adjustments.select_product')}" }, class: "form-control" %>
  </td>
  <td>
    <%= f.number_field :quantity_difference, step: "0.001", class: "form-control", placeholder: "+/- 0" %>
  </td>
  <td>
    <%= f.number_field :unit_cost, step: "0.0001", min: 0, class: "form-control",
          placeholder: t("inventory.stock_adjustments.unit_cost_placeholder") %>
  </td>
  <td class="td-actions">
    <% if f.object.persisted? %>
      <%= f.hidden_field :_destroy, value: "0", data: { destroy_field: true } %>
    <% end %>
    <button type="button" class="btn btn-ghost btn-sm text-danger" data-action="line-items#remove" aria-label="<%= t('common.delete') %>">×</button>
  </td>
</tr>
