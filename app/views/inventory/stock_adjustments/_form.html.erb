<%= form_with model: [:inventory, stock_adjustment], class: "form-card", data: { controller: "line-items" } do |f| %>
  <%= render "shared/error_messages", object: stock_adjustment %>

  <h2 class="section-title"><%= t("inventory.stock_adjustments.section_header") %></h2>
  <div class="form-grid">
    <div class="form-group">
      <%= f.label :warehouse_id, t("inventory.stock_adjustments.warehouse"), class: "form-label" %>
      <%= f.select :warehouse_id,
            options_from_collection_for_select(@warehouses, :id, :name, stock_adjustment.warehouse_id),
            { include_blank: "— #{t('inventory.stock_adjustments.select_warehouse')}" },
            class: "form-control #{'is-error' if stock_adjustment.errors[:warehouse].any?}" %>
    </div>
    <div class="form-group">
      <%= f.label :reason, t("inventory.stock_adjustments.reason"), class: "form-label" %>
      <%= f.select :reason,
            StockAdjustment::REASONS.map { |r| [t("inventory.stock_adjustments.reasons.#{r}"), r] },
            {}, class: "form-control" %>
    </div>
    <div class="form-group">
      <%= f.label :adjusted_on, t("inventory.stock_adjustments.date"), class: "form-label" %>
      <%= f.date_field :adjusted_on, class: "form-control" %>
    </div>
    <div class="form-group" style="grid-column: 1 / -1;">
      <%= f.label :notes, t("inventory.stock_adjustments.notes"), class: "form-label" %>
      <%= f.text_area :notes, rows: 2, class: "form-control" %>
    </div>
  </div>

  <div class="divider"></div>

  <h2 class="section-title"><%= t("inventory.stock_adjustments.section_items") %></h2>
  <p class="form-hint"><%= t("inventory.stock_adjustments.qty_hint") %></p>
  <div class="table-wrap">
    <table class="line-items-table">
      <thead><tr>
        <th style="width: 50%;"><%= t("inventory.stock_adjustments.product") %></th>
        <th><%= t("inventory.stock_adjustments.quantity_difference") %></th>
        <th><%= t("inventory.stock_adjustments.unit_cost") %></th>
        <th></th>
      </tr></thead>
      <tbody data-line-items-target="rows">
        <%= f.fields_for :items do |item_f| %>
          <%= render "item_fields", f: item_f, products: @products %>
        <% end %>
      </tbody>
    </table>
  </div>

  <p data-line-items-target="emptyState" class="td-secondary" <%= "hidden" if stock_adjustment.items.any? %>>
    <%= t("inventory.stock_adjustments.no_items_hint") %>
  </p>

  <button type="button" class="btn btn-ghost btn-sm" data-action="line-items#add" style="margin-top: var(--space-3);">
    + <%= t("inventory.stock_adjustments.add_item") %>
  </button>

  <template data-line-items-target="template">
    <%= f.fields_for :items, StockAdjustmentItem.new, child_index: "NEW_INDEX" do |item_f| %>
      <%= render "item_fields", f: item_f, products: @products %>
    <% end %>
  </template>

  <div class="form-actions">
    <%= f.submit t("inventory.stock_adjustments.post"), class: "btn btn-primary" %>
    <%= link_to t("common.cancel"), inventory_stock_adjustments_path, class: "btn btn-ghost" %>
  </div>
<% end %>
