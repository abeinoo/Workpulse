<% content_for :title, t("inventory.suppliers.title") %>

<div class="admin-page">
  <div class="page-header">
    <h1 class="page-title"><%= t("inventory.suppliers.title") %></h1>
    <% if current_user.can?(:manage_inventory) || current_user.can?(:manage_suppliers) %>
      <%= link_to t("inventory.suppliers.add"), new_inventory_supplier_path, class: "btn btn-primary btn-sm" %>
    <% end %>
  </div>

  <% if @suppliers.empty? %>
    <div class="empty-state"><p class="empty-state__title"><%= t("inventory.suppliers.empty") %></p></div>
  <% else %>
    <div class="table-wrap table-wrap--cards">
      <table>
        <thead>
          <tr>
            <th><%= t("inventory.suppliers.name") %></th>
            <th><%= t("inventory.suppliers.primary_mobile") %></th>
            <th><%= t("inventory.suppliers.address") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @suppliers.each do |supplier| %>
            <tr>
              <td><%= link_to supplier.name, inventory_supplier_path(supplier), class: "link" %></td>
              <td class="td-secondary"><%= supplier.primary_mobile.presence || "—" %></td>
              <td class="td-secondary"><%= supplier.address.presence || "—" %></td>
              <td class="td-actions">
                <% if current_user.can?(:manage_inventory) || current_user.can?(:manage_suppliers) %>
                  <%= link_to t("common.edit"), edit_inventory_supplier_path(supplier), class: "link-muted" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
