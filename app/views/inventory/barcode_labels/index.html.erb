<% content_for :title, t("inventory.barcode_labels.bulk_title", count: @products.size) %>
<% if @products.empty? %>
  <div class="empty-label"><%= t("inventory.barcode_labels.no_products_selected") %></div>
<% else %>
  <div class="label-grid">
    <% @products.each do |product| %>
      <% barcodes = product.product_barcodes.loaded? ? product.product_barcodes.sort_by { |pb| [pb.is_primary? ? 0 : 1, pb.created_at.to_i] } : product.product_barcodes.includes(:product_variant).ordered.to_a %>
      <% if barcodes.none? %>
        <%# Skip products without barcodes in bulk print %>
      <% else %>
        <% barcodes.each do |bc| %>
          <% @quantity.times do %>
            <div class="label">
              <div class="label__name"><%= product.name %></div>
              <% if bc.product_variant.present? %>
                <div class="label__variant"><%= bc.product_variant.name %></div>
              <% end %>
              <% if product.sku.present? %>
                <div class="label__sku"><%= product.sku %></div>
              <% end %>
              <div class="label__barcode">
                <svg class="barcode-svg" data-value="<%= bc.barcode %>"></svg>
              </div>
              <div class="label__code"><%= bc.barcode %></div>
              <% if @show_price && product.selling_price.to_d > 0 %>
                <div class="label__price"><%= format_currency(product.selling_price) %></div>
              <% end %>
              <div class="label__type"><%= t("inventory.products.barcode_types.#{bc.barcode_type}", default: bc.barcode_type) %></div>
            </div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
