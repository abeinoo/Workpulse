<% content_for :title, t("inventory.reports.supplier_purchases.title") %>

<div class="admin-page">
  <%= render "page_header", key: "supplier_purchases" %>

  <%= render "filters", url: inventory_supplier_purchases_report_path, fields: %i[supplier warehouse from to] %>

  <% if @rows.empty? %>
    <div class="empty-state"><p class="empty-state__title"><%= t("inventory.reports.supplier_purchases.empty") %></p></div>
  <% else %>
    <div class="table-wrap table-wrap--cards">
      <table class="report-table">
        <thead><tr>
          <th><%= t("inventory.reports.fields.supplier") %></th>
          <th style="text-align: end;"><%= t("inventory.reports.fields.receipts") %></th>
          <th style="text-align: end;"><%= t("inventory.reports.fields.products") %></th>
          <th style="text-align: end;"><%= t("inventory.reports.fields.quantity") %></th>
          <th style="text-align: end;"><%= t("inventory.reports.fields.purchase_value") %></th>
          <th><%= t("inventory.reports.fields.last_purchase") %></th>
          <th style="text-align: end;"><%= t("inventory.reports.fields.outstanding") %></th>
          <th><%= t("inventory.reports.fields.top_products") %></th>
        </tr></thead>
        <tbody>
          <% @rows.each do |row| %>
            <tr>
              <td class="td-wrap"><%= link_to row.supplier.name, inventory_supplier_path(row.supplier), class: "link" %></td>
              <td style="text-align: end;"><%= row.receipt_count %></td>
              <td style="text-align: end;"><%= row.product_count %></td>
              <td style="text-align: end;"><%= row.total_quantity.to_i %></td>
              <td style="text-align: end;"><%= format_currency(row.total_value) %></td>
              <td class="td-secondary"><%= local_date(row.last_purchase_on) %></td>
              <td style="text-align: end;">
                <% if row.outstanding_amount.positive? %>
                  <span class="badge badge-warning"><%= format_currency(row.outstanding_amount) %></span>
                <% else %>
                  <%= format_currency(0) %>
                <% end %>
              </td>
              <td class="td-secondary td-wrap"><%= row.top_products.map { |product, _| product.name }.join("، ") %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="4" style="text-align: end; font-weight: 600;"><%= t("inventory.reports.fields.total_value") %></td>
            <td style="text-align: end; font-weight: 600;"><%= format_currency(@report.grand_total) %></td>
            <td></td>
            <td style="text-align: end; font-weight: 600;"><%= format_currency(@report.total_outstanding) %></td>
            <td></td>
          </tr>
        </tfoot>
      </table>
    </div>
  <% end %>
</div>
