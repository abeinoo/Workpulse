<% content_for :title, t("inventory.products.new_title") %>

<div class="form-page product-editor-page">
  <%= link_to inventory_products_path, class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    <%= t("forms.back") %>
  <% end %>
  <h1 class="page-title mb-6"><%= t("inventory.products.new_title") %></h1>
  <div class="product-editor">
    <aside class="product-editor__aside"><%= render "gallery", product: @product %></aside>
    <div class="product-editor__main"><%= render "form", product: @product %></div>
  </div>
</div>
