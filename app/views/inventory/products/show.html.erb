<% content_for :title, @product.name %>
<%#
  Product Show page. Header (identity, status, actions); then the photo gallery
  beside the key figures and product details; then inventory (warehouse
  availability), purchasing & consumption, and inventory activity. Read-only:
  every figure is computed in Inventory::ProductsController#show. Layout
  breakpoints follow the page's own width (container queries), so the app
  sidebar and the workspace rail are already accounted for; logical properties
  only, so the same rules hold in RTL.
%>
<% sl = "inventory.products.show_layout" %>
<% lk = "inventory.products.layout" %>
<% can_manage = current_user.can?(:manage_inventory) || current_user.can?(:manage_products) %>
<% all_barcodes = @product.product_barcodes.loaded? ? @product.product_barcodes.to_a : @product.product_barcodes.ordered.to_a %>
<% header_barcode = all_barcodes.find(&:is_primary?) || all_barcodes.first %>

<div class="admin-page product-show-page" data-testid="product-show">
  <header class="pe-header pshow-header">
    <nav class="pe-crumbs" aria-label="<%= t("workspace.breadcrumb") %>">
      <ol>
        <li><%= link_to t("#{lk}.products"), inventory_products_path %></li>
        <li aria-current="page"><bdi><%= @product.name %></bdi></li>
      </ol>
    </nav>

    <div class="pshow-header__row">
      <div class="pe-header__row pshow-header__identity">
        <%= link_to inventory_products_path, class: "pe-header__back", title: t("#{lk}.back_to_products"),
              aria: { label: t("#{lk}.back_to_products") } do %>
          <svg class="pe-header__back-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
        <% end %>
        <div class="pe-header__text">
          <h1 class="page-title pe-header__title pshow-header__title">
            <%= product_thumbnail(@product, size: :md) %>
            <bdi><%= @product.name %></bdi>
            <% if @product.archived? %>
              <span class="badge badge-neutral"><%= t("inventory.products.archived_badge") %></span>
            <% elsif @low_stock_warehouse %>
              <span class="badge badge-warning"><%= t("inventory.products.low_stock_badge") %></span>
            <% end %>
          </h1>
          <div class="pe-header__meta" data-testid="product-show-meta">
            <span><%= t("inventory.products.sku") %>: <bdi><%= @product.sku %></bdi></span>
            <% if header_barcode %>
              <span><%= t("inventory.products.barcode_types.#{header_barcode.barcode_type}") %>: <bdi><%= header_barcode.barcode %></bdi></span>
            <% end %>
            <% if @product.product_category %>
              <span><%= t("inventory.products.category") %>: <bdi><%= @product.product_category.name %></bdi></span>
            <% end %>
            <% if @product.brand %>
              <span><%= t("inventory.products.brand") %>: <bdi><%= @product.brand.name %></bdi></span>
            <% end %>
            <%# Archived shows as the badge beside the name. %>
            <% if @product.active? %>
              <span class="badge badge-success"><%= t("inventory.products.status_active") %></span>
            <% end %>
          </div>
        </div>
      </div>

      <div class="pshow-header__actions">
        <% unless @product.archived? %>
          <% if all_barcodes.any? %>
            <%= link_to inventory_barcode_label_path(@product), target: "_blank", rel: "noopener",
                  class: "btn btn-ghost btn-sm" do %>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
              <%= t("inventory.barcode_labels.print_all") %>
            <% end %>
          <% end %>
        <% end %>
        <% if @product.active? && policy(StockIssue).quick_issue? %>
          <%= link_to t("inventory.quick_issue.action"), new_inventory_quick_issue_path(product_id: @product.id),
                class: "btn btn-secondary btn-sm", data: { turbo_frame: "modal", testid: "product-quick-issue" } %>
        <% end %>
        <% if can_manage %>
          <% if @product.archived? %>
            <%= button_to t("inventory.products.restore"), restore_inventory_product_path(@product),
                  method: :patch, class: "btn btn-secondary btn-sm" %>
            <%= button_to t("inventory.products.delete"), inventory_product_path(@product),
                  method: :delete,
                  form: { data: { turbo_confirm: t("inventory.products.delete_confirm") } },
                  class: "btn btn-danger btn-sm" %>
          <% else %>
            <%= link_to t("common.edit"), edit_inventory_product_path(@product), class: "btn btn-secondary btn-sm" %>
            <%= button_to t("inventory.products.archive"), archive_inventory_product_path(@product),
                  method: :patch,
                  form: { data: { turbo_confirm: t("inventory.products.archive_confirm") } },
                  class: "btn btn-ghost btn-sm" %>
          <% end %>
        <% end %>
      </div>
    </div>
  </header>

  <% if @product.archived? %>
    <div class="alert alert-warning pshow-alert">
      <%= t("inventory.products.archived_notice", date: local_date(@product.archived_at)) %>
    </div>
  <% end %>

  <%# ── Gallery | key figures and details ───────────────────── %>
  <div class="pshow-top">
    <div class="pshow-col pshow-col--media">
      <%= render "inventory/products/show_gallery", product: @product, items: product_show_gallery_items(@product),
            edit_path: (edit_inventory_product_path(@product) if can_manage && !@product.archived?) %>

      <% if @product.notes.present? %>
        <section class="pe-card pshow-card" aria-labelledby="pshow-notes-title">
          <h2 class="section-title" id="pshow-notes-title"><%= t("inventory.products.notes") %></h2>
          <div class="pshow-notes" dir="auto"><%= simple_format(@product.notes) %></div>
        </section>
      <% end %>
    </div>

    <div class="pshow-col pshow-col--summary">
      <%# Key inventory figures (the same four as before). %>
      <div class="pshow-stats" data-testid="product-show-stats">
        <div class="stat-card <%= 'stat-card--warning' if @low_stock_warehouse %>">
          <span class="stat-card__label"><%= t("inventory.products.current_stock") %></span>
          <span class="stat-card__value"><%= inventory_quantity(@display_stock) %></span>
          <% if @stock_in_transit.positive? %>
            <span class="td-secondary" data-testid="product-stock-in-transit"><%= t("inventory.products.in_transit_share", quantity: inventory_quantity(@stock_in_transit)) %></span>
          <% end %>
        </div>
        <div class="stat-card">
          <span class="stat-card__label"><%= t("inventory.products.avg_cost") %></span>
          <span class="stat-card__value" data-testid="product-average-cost"><%= format_unit_cost_currency(@product.average_cost_price) %></span>
        </div>
        <div class="stat-card">
          <span class="stat-card__label"><%= t("inventory.products.last_purchase_price") %></span>
          <span class="stat-card__value"><%= format_currency(@last_purchase_price) %></span>
        </div>
        <div class="stat-card">
          <span class="stat-card__label"><%= t("inventory.products.stock_value") %></span>
          <span class="stat-card__value"><%= format_currency(@display_stock_value) %></span>
        </div>
      </div>

      <section class="pe-card pshow-card" aria-labelledby="pshow-details-title" data-testid="product-show-details">
        <h2 class="section-title" id="pshow-details-title"><%= t("#{sl}.section_details") %></h2>
        <dl class="detail-list">
          <div class="detail-list__row"><dt><%= t("inventory.products.sku") %></dt><dd><bdi><%= @product.sku %></bdi></dd></div>
          <div class="detail-list__row" data-testid="product-measure"><dt><%= t("inventory.measures.field") %></dt><dd><%= product_measurement(@product) || measure_name(@product.unit_of_measure) %></dd></div>
          <% if all_barcodes.any? %>
            <% all_barcodes.group_by(&:barcode_type).each do |type, type_barcodes| %>
              <div class="detail-list__row">
                <dt><%= t("inventory.products.barcode_types.#{type}") %></dt>
                <dd>
                  <ul class="barcode-tag-list">
                    <% type_barcodes.each do |pb| %>
                      <li class="barcode-tag<%= " barcode-tag--primary" if pb.is_primary? %>">
                        <span class="barcode-tag__value"><%= pb.barcode %></span>
                        <% if pb.is_primary? %><span class="badge badge-neutral barcode-tag__badge"><%= t("inventory.products.barcode_primary") %></span><% end %>
                        <%= link_to inventory_barcode_label_path(@product, barcode_id: pb.id),
                              target: "_blank", rel: "noopener",
                              class: "barcode-tag__print",
                              title: t("inventory.barcode_labels.print_barcode"),
                              aria: { label: t("inventory.barcode_labels.print_barcode") } do %>
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                </dd>
              </div>
            <% end %>
          <% else %>
            <div class="detail-list__row">
              <dt><%= t("inventory.products.barcodes") %></dt>
              <dd>—</dd>
            </div>
          <% end %>
          <div class="detail-list__row"><dt><%= t("inventory.products.brand") %></dt><dd><%= @product.brand&.name || "—" %></dd></div>
          <div class="detail-list__row"><dt><%= t("inventory.products.category") %></dt><dd><%= @product.product_category&.name || "—" %></dd></div>
          <div class="detail-list__row"><dt><%= t("inventory.products.default_supplier") %></dt><dd><%= @product.default_supplier&.name || "—" %></dd></div>
          <div class="detail-list__row">
            <dt><%= t("inventory.products.track_inventory") %></dt>
            <dd>
              <% if @product.track_inventory? %>
                <span class="badge badge-success"><%= t("common.yes") %></span>
              <% else %>
                <span class="badge badge-neutral"><%= t("common.no") %></span>
              <% end %>
            </dd>
          </div>
        </dl>
      </section>

      <section class="pe-card pshow-card" aria-labelledby="pshow-pricing-title" data-testid="product-show-pricing">
        <h2 class="section-title" id="pshow-pricing-title"><%= t("#{lk}.section_pricing") %></h2>
        <dl class="detail-list">
          <div class="detail-list__row"><dt><%= t("inventory.products.initial_cost_price") %></dt><dd><%= format_currency(@product.initial_cost_price) %></dd></div>
          <div class="detail-list__row"><dt><%= t("inventory.products.selling_markup_percentage") %></dt><dd><%= number_to_percentage(@product.selling_markup_percentage, precision: 1) %></dd></div>
          <div class="detail-list__row"><dt><%= t("inventory.products.selling_price") %></dt><dd><%= format_currency(@product.selling_price) %></dd></div>
        </dl>
      </section>
    </div>
  </div>

  <%# ── Inventory ───────────────────────────────────────────── %>
  <section class="pshow-group" aria-labelledby="pshow-group-inventory">
    <p class="pshow-group__label" id="pshow-group-inventory"><%= t("#{sl}.group_inventory") %></p>
    <div class="pe-card pshow-card">
      <%# No "Manage availability" action on this page (owner decision): availability
          is still managed from the Edit page and the standalone availability page. %>
      <%= render "inventory/products/warehouse_availability", product: @product, pairs: @availability_pairs,
            manage_path: nil %>
    </div>
  </section>

  <%# ── Purchasing & consumption ────────────────────────────── %>
  <section class="pshow-group" aria-labelledby="pshow-group-purchasing">
    <p class="pshow-group__label" id="pshow-group-purchasing"><%= t("#{sl}.group_purchasing") %></p>
    <% if @last_gr_item %>
      <div class="pshow-pair">
        <div class="pe-card pshow-card">
          <h2 class="section-title"><%= t("inventory.products.purchase_information") %></h2>
          <dl class="detail-list">
            <div class="detail-list__row">
              <dt><%= t("inventory.products.last_supplier") %></dt>
              <dd>
                <% if @last_gr_item.goods_receipt.supplier %>
                  <%= link_to @last_gr_item.goods_receipt.supplier.name,
                        inventory_supplier_path(@last_gr_item.goods_receipt.supplier), class: "link" %>
                <% else %>
                  —
                <% end %>
              </dd>
            </div>
            <div class="detail-list__row">
              <dt><%= t("inventory.products.last_purchase_date") %></dt>
              <dd><%= local_date(@last_gr_item.goods_receipt.received_on) %></dd>
            </div>
            <div class="detail-list__row">
              <dt><%= t("inventory.products.last_purchase_unit_price") %></dt>
              <dd><%= format_currency(@last_gr_item.unit_cost) %></dd>
            </div>
            <div class="detail-list__row">
              <dt><%= t("inventory.products.last_purchase_quantity") %></dt>
              <dd><%= @last_gr_item.quantity.to_i %></dd>
            </div>
            <div class="detail-list__row">
              <dt><%= t("inventory.products.last_gr_reference") %></dt>
              <dd>
                <%= link_to @last_gr_item.goods_receipt.receipt_number,
                      inventory_goods_receipt_path(@last_gr_item.goods_receipt), class: "link" %>
              </dd>
            </div>
          </dl>
        </div>

        <div class="pe-card pshow-card">
          <h2 class="section-title"><%= t("inventory.products.consumption_stats") %></h2>
          <dl class="detail-list">
            <div class="detail-list__row">
              <dt><%= t("inventory.products.last_used_in_service") %></dt>
              <dd><%= @last_consumed_on ? local_date(@last_consumed_on) : "—" %></dd>
            </div>
            <div class="detail-list__row">
              <dt><%= t("inventory.products.consumed_this_month") %></dt>
              <dd><%= @consumed_this_month.to_i %></dd>
            </div>
            <div class="detail-list__row">
              <dt><%= t("inventory.products.avg_monthly_consumption") %></dt>
              <dd><%= @avg_monthly_consumption %></dd>
            </div>
            <div class="detail-list__row">
              <dt><%= t("inventory.products.estimated_days_remaining") %></dt>
              <dd>
                <% if @estimated_days_remaining %>
                  <%= t("inventory.products.days_remaining_value", count: @estimated_days_remaining) %>
                <% else %>
                  —
                <% end %>
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <%# Supplier Purchase History %>
      <div class="pe-card pshow-card">
        <h2 class="section-title"><%= t("inventory.products.supplier_purchase_history") %></h2>
        <% if @supplier_purchase_rows.any? %>
          <div class="table-wrap table-wrap--cards">
            <table>
              <thead><tr>
                <th><%= t("inventory.products.supplier") %></th>
                <th><%= t("inventory.products.last_purchase_date") %></th>
                <th style="text-align: end;"><%= t("inventory.products.last_purchase_unit_price") %></th>
                <th style="text-align: end;"><%= t("inventory.products.total_purchased_quantity") %></th>
                <th style="text-align: end;"><%= t("inventory.products.purchase_count") %></th>
              </tr></thead>
              <tbody>
                <% @supplier_purchase_rows.each do |row| %>
                  <tr>
                    <td>
                      <% if row[:supplier] %>
                        <%= link_to row[:supplier].name,
                              inventory_supplier_path(row[:supplier]), class: "link" %>
                      <% else %>
                        <span class="td-secondary">—</span>
                      <% end %>
                    </td>
                    <td class="td-secondary"><%= local_date(row[:last_purchase_date]) %></td>
                    <td style="text-align: end;"><%= format_currency(row[:last_purchase_price]) %></td>
                    <td style="text-align: end;"><%= row[:total_quantity].to_i %></td>
                    <td style="text-align: end;"><%= row[:purchase_count] %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="pe-card pshow-card">
        <h2 class="section-title"><%= t("inventory.products.purchase_information") %></h2>
        <div class="empty-state empty-state--compact">
          <p class="empty-state__text"><%= t("inventory.products.no_purchase_history") %></p>
        </div>
      </div>
    <% end %>
  </section>

  <%# ── Branch transfers (only for users who may list stock transfers) ── %>
  <% unless @recent_stock_transfers.nil? %>
    <div class="pshow-group">
      <div class="pe-card pshow-card">
        <%= render "inventory/products/recent_stock_transfers", rows: @recent_stock_transfers, summary: @stock_transfer_summary %>
      </div>
    </div>
  <% end %>

  <%# ── Inventory activity ──────────────────────────────────── %>
  <section class="pshow-group" aria-labelledby="pshow-group-activity">
    <p class="pshow-group__label" id="pshow-group-activity"><%= t("#{sl}.group_activity") %></p>

    <% unless @recent_goods_receipts.nil? %>
      <div class="pe-card pshow-card">
        <%= render "inventory/products/recent_goods_receipts", rows: @recent_goods_receipts %>
      </div>
    <% end %>
    <% unless @recent_stock_issues.nil? %>
      <div class="pe-card pshow-card">
        <%= render "inventory/products/recent_stock_issues", rows: @recent_stock_issues, product: @product %>
      </div>
    <% end %>

    <div class="pe-card pshow-card">
      <h2 class="section-title"><%= t("inventory.products.recent_movements") %></h2>
      <% if @recent_movements.empty? %>
        <div class="empty-state empty-state--compact"><p class="empty-state__text"><%= t("inventory.dashboard.none_yet") %></p></div>
      <% else %>
        <div class="table-wrap table-wrap--cards">
          <table>
            <thead><tr>
              <th><%= t("inventory.movements.date") %></th>
              <th><%= t("inventory.movements.warehouse") %></th>
              <th><%= t("inventory.movements.type") %></th>
              <th style="text-align: end;"><%= t("inventory.movements.quantity") %></th>
              <th><%= t("inventory.reports.fields.document_number") %></th>
            </tr></thead>
            <tbody>
              <% @recent_movements.each do |m| %>
                <tr>
                  <td class="td-secondary"><%= local_date(m.occurred_on) %></td>
                  <td class="td-secondary"><%= m.warehouse.display_name %></td>
                  <td>
                    <span class="badge <%= m.direction_in? ? 'badge-success' : 'badge-neutral' %>">
                      <%= t("inventory.movements.directions.#{m.direction}") %>
                    </span>
                    <span class="td-secondary"><%= inventory_movement_reason_label(m.reason, source: m.source) %></span>
                  </td>
                  <td style="text-align: end;" data-testid="recent-movement-quantity"><%= m.direction_in? ? "+" : "−" %><%= m.quantity.to_i %></td>
                  <td><%= inventory_source_document_link(m.source, Inventory::Reports::Movements.document_number_for(m.source)) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </section>
</div>
