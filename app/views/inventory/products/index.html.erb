<% content_for :title, t("inventory.products.title") %>
<% scope           = "inventory.products.index" %>
<% can_manage      = policy(Product).update? %>
<% can_quick_issue = policy(StockIssue).quick_issue? %>

<div class="admin-page products-index" data-controller="product-select"
     data-product-select-selected-template-value="<%= t("#{scope}.selected_count") %>"
     data-product-select-hint-value="<%= t("#{scope}.select_hint") %>">
  <%# ── Header: title + count, one primary action, quieter configuration ── %>
  <div class="page-header products-index__header">
    <div class="products-index__heading">
      <h1 class="page-title"><%= t("inventory.products.title") %></h1>
      <span class="badge badge-neutral products-index__count" data-testid="products-count">
        <%= t("#{scope}.count", count: @products.size) %>
      </span>
    </div>
    <% if can_manage %>
      <div class="products-index__actions">
        <div class="row-actions" data-controller="dropdown">
          <button type="button" class="btn btn-ghost btn-sm" data-action="click->dropdown#toggle"
                  data-dropdown-target="button" aria-haspopup="menu" aria-expanded="false" data-testid="products-settings"
                  aria-label="<%= t("#{scope}.catalogue_settings") %>" title="<%= t("#{scope}.catalogue_settings") %>">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
            <span><%= t("#{scope}.catalogue_settings") %></span>
          </button>
          <div class="row-actions__menu" data-dropdown-target="menu" role="menu" hidden>
            <%= link_to t("inventory.products.manage_categories"), inventory_product_categories_path, class: "row-actions__item", role: "menuitem" %>
            <%= link_to t("inventory.products.manage_brands"), inventory_brands_path, class: "row-actions__item", role: "menuitem" %>
          </div>
        </div>
        <%= link_to import_inventory_products_path, class: "btn btn-secondary btn-sm",
              aria: { label: t("inventory.imports.import_csv") }, title: t("inventory.imports.import_csv") do %>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          <span><%= t("inventory.imports.import_csv") %></span>
        <% end %>
        <%= link_to new_inventory_product_path, class: "btn btn-primary btn-sm" do %>
          <span aria-hidden="true">+</span><span><%= t("inventory.products.add") %></span>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# ── Warehouse context: every figure below (summary, value, stock
       column, low / out-of-stock, filters, count) is for this warehouse —
       or, for All warehouses, for every warehouse the viewer can reach.
       Changing it keeps the tab, search and filters. %>
  <%= form_with url: inventory_products_path, method: :get, class: "products-context",
        data: { controller: "auto-submit", testid: "warehouse-context" } do |f| %>
    <% products_index_query(warehouse_id: nil).each do |key, value| %>
      <%= hidden_field_tag key, value, id: nil %>
    <% end %>
    <%= f.label :warehouse_id, t("#{scope}.warehouse_context.label"), class: "products-context__label" %>
    <%= f.select :warehouse_id,
          options_for_select([ [ t("#{scope}.warehouse_context.all"), "" ] ] + @warehouse_options.map { |w| [ w.name, w.id ] },
                             @warehouse&.id),
          {}, class: "form-control products-context__select",
          data: { action: "change->auto-submit#submit", testid: "warehouse-select" } %>
    <span class="products-context__hint" data-testid="warehouse-context-hint" dir="auto">
      <%= @warehouse ? t("#{scope}.warehouse_context.showing_one", warehouse: @warehouse.name) : t("#{scope}.warehouse_context.showing_all") %>
    </span>
    <noscript><%= f.submit t("common.search"), class: "btn btn-secondary btn-sm", name: nil %></noscript>
  <% end %>

  <%# ── Summary (tab's whole catalogue, before search/filters) — each card
       is a shortcut to its stock-status filter. %>
  <div class="products-summary" data-testid="products-summary">
    <%= link_to inventory_products_path(products_index_query(stock_status: nil)),
          class: "products-summary__card #{"is-active" if @stock_status.nil?}", data: { testid: "summary-total" } do %>
      <span class="products-summary__label"><%= t("#{scope}.summary.total") %></span>
      <span class="products-summary__value" dir="ltr"><%= @summary[:total] %></span>
    <% end %>
    <%= link_to inventory_products_path(products_index_query(stock_status: "low_stock")),
          class: "products-summary__card products-summary__card--warning #{"is-active" if @stock_status == "low_stock"}",
          data: { testid: "summary-low-stock" } do %>
      <span class="products-summary__label"><%= t("#{scope}.summary.low_stock") %></span>
      <span class="products-summary__value" dir="ltr"><%= @summary[:low_stock] %></span>
    <% end %>
    <%= link_to inventory_products_path(products_index_query(stock_status: "out_of_stock")),
          class: "products-summary__card products-summary__card--danger #{"is-active" if @stock_status == "out_of_stock"}",
          data: { testid: "summary-out-of-stock" } do %>
      <span class="products-summary__label"><%= t("#{scope}.summary.out_of_stock") %></span>
      <span class="products-summary__value" dir="ltr"><%= @summary[:out_of_stock] %></span>
    <% end %>
    <div class="products-summary__card products-summary__card--static" data-testid="summary-stock-value">
      <span class="products-summary__label"><%= t("#{scope}.summary.stock_value") %></span>
      <span class="products-summary__value" dir="ltr"><%= format_currency(@summary[:stock_value]) %></span>
    </div>
  </div>

  <%# ── Status tabs ──────────────────────────────────────────────────────── %>
  <%# The app's shared segmented filter-tabs (Users, Shift Assignments) —
       the former .tab-bar classes had no styles anywhere. %>
  <nav class="filter-tabs products-index__tabs" aria-label="<%= t("#{scope}.status_tabs") %>">
    <% %w[active archived all].each do |status| %>
      <% current = @status_filter.to_s == status %>
      <%= link_to t("inventory.products.status_#{status}"), inventory_products_path(products_index_query(status: status)),
            class: "filter-tab #{"filter-tab--active" if current}", aria: { current: (current ? "page" : nil) } %>
    <% end %>
  </nav>

  <%# ── Search + filters (one compact row; selects apply on change) ──────── %>
  <div data-controller="camera-scanner"
       data-camera-scanner-mode-value="lookup"
       data-camera-scanner-lookup-url-value="<%= inventory_barcode_lookup_path %>"
       data-camera-scanner-product-base-url-value="<%= inventory_products_path %>"
       data-camera-scanner-new-product-url-value="<%= new_inventory_product_path %>"
       data-camera-scanner-i18n-title="<%= t('inventory.camera_scanner.title') %>"
       data-camera-scanner-i18n-close="<%= t('inventory.camera_scanner.close') %>"
       data-camera-scanner-i18n-hint="<%= t('inventory.camera_scanner.hint') %>"
       data-camera-scanner-i18n-starting="<%= t('inventory.camera_scanner.starting') %>"
       data-camera-scanner-i18n-permission-denied="<%= t('inventory.camera_scanner.permission_denied') %>"
       data-camera-scanner-i18n-no-camera="<%= t('inventory.camera_scanner.no_camera') %>"
       data-camera-scanner-i18n-start-error="<%= t('inventory.camera_scanner.start_error') %>"
       data-camera-scanner-i18n-switch-camera="<%= t('inventory.camera_scanner.switch_camera') %>"
       data-camera-scanner-i18n-not-found="<%= t('inventory.camera_scanner.not_found') %>"
       data-camera-scanner-i18n-create-product="<%= t('inventory.camera_scanner.create_product') %>"
       data-camera-scanner-i18n-dismiss="<%= t('inventory.camera_scanner.dismiss') %>">
    <%= form_with url: inventory_products_path, method: :get, class: "products-filters", role: "search",
          data: { testid: "products-filters" } do |f| %>
      <%= f.hidden_field :status, value: @status_filter %>
      <%= f.hidden_field :warehouse_id, value: @warehouse&.id if @warehouse %>
      <div class="barcode-input-group products-filters__search">
        <%= f.label :q, t("#{scope}.search_label"), class: "visually-hidden" %>
        <%= f.search_field :q, value: params[:q], placeholder: t("inventory.products.search_placeholder"),
              class: "form-control", autocomplete: "off", dir: "auto" %>
        <button type="button" class="btn btn-secondary barcode-camera-btn"
                data-action="camera-scanner#open"
                aria-label="<%= t('inventory.camera_scanner.open_camera') %>">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
            <circle cx="12" cy="13" r="4"/>
          </svg>
          <span class="barcode-camera-btn__label"><%= t("inventory.camera_scanner.scan_button") %></span>
        </button>
      </div>
      <div class="products-filters__selects" data-controller="auto-submit">
        <%= f.select :category_id, options_from_collection_for_select(@categories, :id, :name, params[:category_id]),
              { include_blank: t("inventory.products.all_categories") }, class: "form-control",
              aria: { label: t("inventory.products.category") }, data: { action: "change->auto-submit#submit" } %>
        <%= f.select :brand_id, options_from_collection_for_select(@brands, :id, :name, params[:brand_id]),
              { include_blank: t("inventory.products.all_brands") }, class: "form-control",
              aria: { label: t("inventory.products.brand") }, data: { action: "change->auto-submit#submit" } %>
        <%= f.select :stock_status,
              options_for_select(Inventory::ProductsController::STOCK_STATUSES.map { |s| [ t("#{scope}.stock_status.#{s}"), s ] }, @stock_status),
              { include_blank: t("#{scope}.stock_status.all") }, class: "form-control",
              aria: { label: t("#{scope}.stock_status.label") }, data: { action: "change->auto-submit#submit", testid: "stock-status-filter" } %>
      </div>
      <div class="products-filters__buttons">
        <%= f.submit t("common.search"), class: "btn btn-secondary btn-sm", name: nil %>
        <% if products_index_filtered? %>
          <%= link_to t("#{scope}.clear_filters"), inventory_products_path(products_index_unfiltered_query),
                class: "btn btn-ghost btn-sm", data: { testid: "clear-filters" } %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% chips = products_index_filter_chips(categories: @categories, brands: @brands) %>
  <% if chips.any? %>
    <div class="filter-chips products-index__chips" data-testid="filter-chips" aria-label="<%= t("#{scope}.active_filters") %>">
      <% chips.each do |label, url| %>
        <span class="filter-chip">
          <span dir="auto"><%= label %></span>
          <%= link_to "×", url, class: "filter-chip__remove", aria: { label: t("#{scope}.remove_filter", filter: label) } %>
        </span>
      <% end %>
    </div>
  <% end %>

  <% if @products.empty? %>
    <div class="empty-state products-index__empty" data-testid="products-empty">
      <p class="empty-state__title"><%= products_index_filtered? ? t("#{scope}.empty_filtered") : t("inventory.products.empty") %></p>
      <% if products_index_filtered? %>
        <%= link_to t("#{scope}.clear_filters"), inventory_products_path(products_index_unfiltered_query), class: "btn btn-secondary btn-sm" %>
      <% elsif can_manage %>
        <%= link_to t("inventory.products.add"), new_inventory_product_path, class: "btn btn-primary btn-sm" %>
      <% end %>
    </div>
  <% else %>
    <%# ── Bulk bar: the selection and its (existing) bulk operation ──────── %>
    <div class="products-bulk" data-product-select-target="bulkBar" data-testid="products-bulk" aria-live="polite">
      <span class="products-bulk__count" data-product-select-target="selectedCount">
        <%= t("#{scope}.select_hint") %>
      </span>
      <div class="products-bulk__actions">
        <button type="button" class="btn btn-secondary btn-sm" disabled
                data-product-select-target="printBtn"
                data-print-url="<%= inventory_barcode_labels_path %>"
                data-action="product-select#printSelected">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          <%= t("inventory.barcode_labels.print_selected") %> <span data-product-select-target="printCount"></span>
        </button>
        <button type="button" class="btn btn-ghost btn-sm" hidden
                data-product-select-target="clearBtn" data-action="product-select#clear">
          <%= t("#{scope}.clear_selection") %>
        </button>
      </div>
    </div>

    <div class="table-wrap table-wrap--cards products-table-wrap">
      <table class="products-table">
        <thead><tr>
          <th class="products-table__select">
            <input type="checkbox"
                   data-product-select-target="selectAll"
                   data-action="product-select#toggleAll"
                   aria-label="<%= t('inventory.barcode_labels.select_all') %>">
          </th>
          <th><%= t("inventory.products.name") %></th>
          <th class="products-table__num"><%= t("#{scope}.stock_on_hand") %></th>
          <th class="products-table__num products-table__cost"><%= t("inventory.products.avg_cost") %></th>
          <th class="products-table__actions"><span class="visually-hidden"><%= t("inventory.quick_issue.row_actions") %></span></th>
        </tr></thead>
        <tbody>
          <% @products.each do |product| %>
            <% display_stock = @stock_totals[product.id] || 0 %>
            <tr class="<%= "products-table__row--archived" if product.archived? %>">
              <td class="products-table__select">
                <input type="checkbox"
                       data-product-select-target="checkbox"
                       data-product-id="<%= product.id %>"
                       data-action="product-select#toggle"
                       aria-label="<%= product.name %>">
              </td>
              <%# Identity: name, then brand, then category, then SKU — empty
                   values render no line at all. The :lg thumbnail is the
                   un-cropped "large" variant (fits 96px), sized by CSS. %>
              <td class="products-table__product">
                <div class="product-cell">
                  <%= link_to inventory_product_path(product), class: "product-cell__thumb", tabindex: -1, aria: { hidden: true } do %>
                    <%= product_thumbnail(product, size: :lg) %>
                  <% end %>
                  <div class="product-cell__text">
                    <%= link_to product.name, inventory_product_path(product), class: "product-cell__name",
                          title: product.name, dir: "auto" %>
                    <% if product.brand %>
                      <span class="product-cell__brand" dir="auto" data-testid="product-brand"><%= product.brand.name %></span>
                    <% end %>
                    <% if product.product_category %>
                      <span class="product-cell__category" dir="auto" data-testid="product-category"><%= product.product_category.name %></span>
                    <% end %>
                    <span class="product-cell__meta">
                      <% if product.sku.present? %>
                        <span class="product-cell__sku" data-testid="product-sku"><%= t("inventory.products.sku") %>: <bdi dir="ltr"><%= product.sku %></bdi></span>
                      <% end %>
                      <% if (measurement = product_measurement(product)) %>
                        <span class="td-secondary" data-testid="product-measurement" dir="auto">· <%= measurement %></span>
                      <% end %>
                      <% if product.archived? %>
                        <span class="badge badge-neutral"><%= t("inventory.products.archived_badge") %></span>
                      <% end %>
                    </span>
                  </div>
                </div>
              </td>
              <%= render "inventory/products/stock_cell", product: product, stock: display_stock,
                                                          low_stock: @low_stock_product_ids.include?(product.id) %>
              <td class="products-table__num products-table__cost" dir="ltr"><%= format_currency(product.average_cost_price) %></td>
              <td class="td-actions products-table__actions">
                <%= render "inventory/products/row_actions", product: product, can_manage: can_manage,
                                                             can_quick_issue: can_quick_issue %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
