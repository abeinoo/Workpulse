<%#
  The product's packaging (Inventory::Packaging): the chain ("1 carton = 12 boxes
  = 120 pcs") and, per warehouse holding stock, its sealed packages and loose
  content. locals: product, structure, balances ({ [warehouse_id, product_id] => Balance }),
  stock_by_warehouse, warehouses
%>
<section class="card" style="padding: var(--space-5); margin-bottom: var(--space-5);" data-testid="product-packaging">
  <div class="flex items-center" style="justify-content: space-between; gap: var(--space-3); flex-wrap: wrap;">
    <h2 class="section-title" style="margin: 0;"><%= t("inventory.packaging.title") %></h2>
    <% if policy(product).configure_packaging? %>
      <%= link_to t("inventory.packaging.edit"), packaging_inventory_product_path(product), class: "btn btn-secondary btn-sm", data: { testid: "edit-packaging" } %>
    <% end %>
  </div>
  <% if structure.packaged? %>
    <ul class="packaging-chain" data-testid="packaging-chain">
      <% structure.levels.reverse.each do |level| %>
        <% below = level.position == 1 ? measure_short(product) : t("inventory.packaging.units.#{structure.at(level.position - 1).package_unit}.other", count: "").strip %>
        <li>
          <strong><%= Inventory::Packaging::Format.packages(level.package_unit, 1) %></strong>
          = <%= inventory_quantity(level.contains) %> <%= below %>
          <% if level.position > 1 %><span class="td-secondary">(<%= inventory_quantity(level.base_quantity) %> <%= measure_short(product) %>)</span><% end %>
        </li>
      <% end %>
    </ul>
    <% rows = stock_by_warehouse.select { |_, qty| qty.to_d.nonzero? } %>
    <% if rows.any? %>
      <div class="table-wrap table-wrap--cards">
        <table class="table" data-testid="packaging-on-hand">
          <thead><tr>
            <th><%= t("inventory.products.warehouse") %></th>
            <th><%= t("inventory.packaging.on_hand_packaging") %></th>
          </tr></thead>
          <tbody>
            <% rows.each do |warehouse_id, _qty| %>
              <tr>
                <td><%= warehouses[warehouse_id]&.name %></td>
                <td><%= packaging_balance_text(product, balances[[ warehouse_id, product.id ]]) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% else %>
    <p class="form-hint" style="margin: var(--space-2) 0 0;"><%= t("inventory.packaging.none") %></p>
  <% end %>
</section>
