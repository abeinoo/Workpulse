<div data-line-row class="variant-row">
  <%= f.hidden_field :id if f.object.persisted? %>
  <%= f.hidden_field :_destroy, value: "0", data: { destroy_field: true } if f.object.persisted? %>

  <div class="form-group variant-row__name">
    <%= f.label :name, t("inventory.products.variant_name"), class: "form-label" %>
    <%= f.text_field :name, class: "form-control", autocomplete: "off" %>
  </div>

  <div class="form-group variant-row__sku">
    <%= f.label :sku, t("inventory.products.variant_sku"), class: "form-label" %>
    <%= f.text_field :sku, class: "form-control", autocomplete: "off" %>
  </div>

  <div class="form-group variant-row__active">
    <label class="form-label">&nbsp;</label>
    <div class="form-check">
      <%= f.check_box :active, class: "form-check-input", checked: f.object.active.nil? ? true : f.object.active %>
      <%= f.label :active, t("inventory.products.variant_active"), class: "form-check-label" %>
    </div>
  </div>

  <div class="variant-row__actions">
    <button type="button" class="btn btn-ghost btn-sm text-danger"
            data-action="line-items#remove"
            aria-label="<%= t('common.delete') %>">×</button>
  </div>
</div>
