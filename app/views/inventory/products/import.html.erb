<% content_for :title, t("inventory.imports.products.title") %>

<div class="form-page">
  <%= link_to inventory_products_path, class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    <%= t("forms.back") %>
  <% end %>
  <h1 class="page-title mb-6"><%= t("inventory.imports.products.title") %></h1>

  <%# multipart: required so Turbo keeps the file part (urlencoded forms drop File entries).
      turbo: false — run_import renders import_result (a 200, not a redirect), which Turbo
      Drive ignores for form POSTs, so use a classic submit. %>
  <%= form_with url: run_import_inventory_products_path, method: :post,
                multipart: true, class: "form-card", data: { turbo: false } do |f| %>
    <div class="flex items-center" style="justify-content: space-between; gap: var(--space-3); margin-bottom: var(--space-4); flex-wrap: wrap;">
      <p class="form-hint" style="margin: 0;"><%= t("inventory.imports.products.columns") %></p>
      <%= link_to t("inventory.imports.download_sample"), import_template_inventory_products_path,
            class: "btn btn-secondary btn-sm" %>
    </div>

    <%= render "inventory/shared/import_columns", columns: Inventory::Imports::ProductImporter::COLUMNS %>

    <div class="form-grid">
      <div class="form-group" style="grid-column: 1 / -1;">
        <%= label_tag :file, t("inventory.imports.file"), class: "form-label" %>
        <%= file_field_tag :file, accept: ".csv", class: "form-control", required: true %>
      </div>
      <div class="form-group">
        <%= label_tag :warehouse_id, t("inventory.imports.opening_warehouse"), class: "form-label" %>
        <%= select_tag :warehouse_id,
              options_from_collection_for_select(@warehouses, :id, :name),
              include_blank: t("inventory.imports.no_opening_stock"), class: "form-control" %>
        <p class="form-hint"><%= t("inventory.imports.opening_warehouse_hint") %></p>
      </div>
    </div>
    <div class="form-actions">
      <%= f.submit t("inventory.imports.upload"), class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
