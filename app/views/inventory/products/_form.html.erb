<%= form_with model: [:inventory, product], class: "form-card" do |f| %>
  <%= render "shared/error_messages", object: product %>

  <%# ── Image ─────────────────────────────────────────────── %>
  <div class="form-group">
    <%= f.label :image, t("inventory.products.image"), class: "form-label" %>
    <div class="upload-field" data-controller="image-upload">
      <div class="upload-field__preview">
        <% img_src = product.image.attached? ? url_for(product.image.variant(resize_to_limit: [120, 120])) : nil %>
        <img src="<%= img_src %>" class="logo-img logo-img--thumb" alt=""
             data-image-upload-target="img" <%= "hidden" unless img_src %>>
        <div class="avatar avatar-placeholder" data-image-upload-target="placeholder" <%= "hidden" if img_src %>>
          <%= (product.name.presence || "?").first(2).upcase %>
        </div>
        <div class="upload-field__controls">
          <label class="btn btn-ghost btn-sm upload-field__choose">
            <%= t("forms.choose_image") %>
            <%= f.file_field :image, accept: "image/png,image/jpeg,image/webp",
                  class: "upload-field__input",
                  data: { "image-upload-target": "input", action: "change->image-upload#change" } %>
          </label>
        </div>
      </div>
    </div>
  </div>

  <div class="divider"></div>

  <%# ── Identity ──────────────────────────────────────────── %>
  <h2 class="section-title"><%= t("inventory.products.section_identity") %></h2>
  <div class="form-grid">
    <div class="form-group" style="grid-column: 1 / -1;">
      <%= f.label :name, t("inventory.products.name"), class: "form-label" %>
      <%= f.text_field :name, class: "form-control #{'is-error' if product.errors[:name].any?}" %>
    </div>
    <div class="form-group">
      <%= f.label :sku, t("inventory.products.sku"), class: "form-label" %>
      <%= f.text_field :sku, class: "form-control #{'is-error' if product.errors[:sku].any?}" %>
    </div>
    <div class="form-group">
      <%= f.label :barcode, t("inventory.products.barcode"), class: "form-label" %>
      <%= f.text_field :barcode, class: "form-control #{'is-error' if product.errors[:barcode].any?}" %>
    </div>
    <div class="form-group">
      <%= f.label :brand_id, t("inventory.products.brand"), class: "form-label" %>
      <%= f.select :brand_id,
            options_from_collection_for_select(@brands, :id, :name, product.brand_id),
            { include_blank: "— #{t('inventory.products.no_brand')}" }, class: "form-control" %>
    </div>
    <div class="form-group">
      <%= f.label :product_category_id, t("inventory.products.category"), class: "form-label" %>
      <%= f.select :product_category_id,
            options_from_collection_for_select(@categories, :id, :name, product.product_category_id),
            { include_blank: "— #{t('inventory.products.no_category')}" }, class: "form-control" %>
    </div>
    <div class="form-group">
      <%= f.label :default_supplier_id, t("inventory.products.default_supplier"), class: "form-label" %>
      <%= f.select :default_supplier_id,
            options_from_collection_for_select(@suppliers, :id, :name, product.default_supplier_id),
            { include_blank: "— #{t('inventory.products.no_default_supplier')}" }, class: "form-control" %>
      <p class="form-hint"><%= t("inventory.products.default_supplier_hint") %></p>
    </div>
  </div>

  <div class="divider"></div>

  <%# ── Pricing & stock ───────────────────────────────────── %>
  <h2 class="section-title"><%= t("inventory.products.section_pricing") %></h2>
  <div class="form-grid">
    <div class="form-group">
      <%= f.label :initial_cost_price, t("inventory.products.initial_cost_price"), class: "form-label" %>
      <%= f.number_field :initial_cost_price, step: "0.0001", min: 0, class: "form-control" %>
      <p class="form-hint"><%= t("inventory.products.initial_cost_hint") %></p>
    </div>
    <div class="form-group">
      <%= f.label :selling_markup_percentage, t("inventory.products.selling_markup_percentage"), class: "form-label" %>
      <%= f.number_field :selling_markup_percentage, step: "0.01", min: 0, class: "form-control" %>
    </div>
    <div class="form-group">
      <%= f.label :low_stock_level, t("inventory.products.low_stock_level"), class: "form-label" %>
      <%= f.number_field :low_stock_level, step: "0.001", min: 0, class: "form-control" %>
    </div>
    <div class="form-group">
      <%= f.label :reorder_quantity, t("inventory.products.reorder_quantity"), class: "form-label" %>
      <%= f.number_field :reorder_quantity, step: "0.001", min: 0, class: "form-control" %>
    </div>
  </div>

  <div class="divider"></div>

  <%# ── Per-warehouse thresholds (override the defaults above) ─ %>
  <div data-controller="line-items">
    <h2 class="section-title"><%= t("inventory.products.section_warehouse_thresholds") %></h2>
    <p class="form-hint"><%= t("inventory.products.warehouse_thresholds_hint") %></p>

    <% if @warehouses.blank? %>
      <p class="td-secondary"><%= t("inventory.products.no_warehouses") %></p>
    <% else %>
      <div class="table-wrap">
        <table class="line-items-table">
          <thead><tr>
            <th style="width: 45%;"><%= t("inventory.products.warehouse") %></th>
            <th><%= t("inventory.products.low_stock_level") %></th>
            <th><%= t("inventory.products.reorder_quantity") %></th>
            <th></th>
          </tr></thead>
          <tbody data-line-items-target="rows">
            <%= f.fields_for :product_warehouse_settings do |setting_f| %>
              <%= render "warehouse_setting_fields", f: setting_f, warehouses: @warehouses %>
            <% end %>
          </tbody>
        </table>
      </div>

      <p data-line-items-target="emptyState" class="td-secondary" <%= "hidden" if product.product_warehouse_settings.any? %>>
        <%= t("inventory.products.no_warehouse_thresholds") %>
      </p>

      <button type="button" class="btn btn-ghost btn-sm" data-action="line-items#add" style="margin-top: var(--space-3);">
        + <%= t("inventory.products.add_warehouse_threshold") %>
      </button>

      <template data-line-items-target="template">
        <%= f.fields_for :product_warehouse_settings, ProductWarehouseSetting.new, child_index: "NEW_INDEX" do |setting_f| %>
          <%= render "warehouse_setting_fields", f: setting_f, warehouses: @warehouses %>
        <% end %>
      </template>
    <% end %>
  </div>

  <div class="divider"></div>

  <div class="form-group">
    <%= f.label :notes, t("inventory.products.notes"), class: "form-label" %>
    <%= f.text_area :notes, rows: 3, class: "form-control" %>
  </div>

  <div class="form-actions">
    <%= f.submit t("common.save"), class: "btn btn-primary" %>
    <%= link_to t("common.cancel"), inventory_products_path, class: "btn btn-ghost" %>
  </div>
<% end %>
