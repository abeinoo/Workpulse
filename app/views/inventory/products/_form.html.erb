<%# Product details, in section cards: Basic Information, Barcodes, Pricing.
    Edit page only: availability_section (the product's warehouse cards). The
    <form> element closes after Pricing; the "Inventory Tracking,
    Notifications & Warehouse Availability" section follows it, and its
    fields, the notes and the page's ONE Save (the action bar) still belong to
    the form through the HTML form attribute — everything is saved together
    (Inventory::ProductEditor). On New (and in the import modal) everything,
    the action bar included, is inside the form. %>
<% availability_section = local_assigns[:availability_section] %>
<% lk = "inventory.products.layout" %>
<%= form_with model: [:inventory, product], class: "product-form #{'product-form--split' if availability_section}", id: "product-form" do |f| %>
  <%= render "shared/error_messages", object: product %>
  <% if local_assigns[:return_to_import_row_id].present? %>
    <%= hidden_field_tag :return_to_import_row_id, return_to_import_row_id %>
  <% end %>

  <%# ── Basic information ─────────────────────────────────── %>
  <section class="pe-card" aria-labelledby="pe-basic-title">
    <header class="pe-card__head">
      <h2 class="section-title" id="pe-basic-title"><%= t("#{lk}.section_basic") %></h2>
      <p class="form-hint"><%= t("#{lk}.section_basic_hint") %></p>
    </header>
    <div class="pe-grid">
      <div class="form-group pe-span-4">
        <%= f.label :name, t("inventory.products.name"), class: "form-label form-label--required" %>
        <%= f.text_field :name, class: "form-control #{'is-error' if product.errors[:name].any?}",
              aria: { required: true, invalid: product.errors[:name].any? } %>
      </div>
      <div class="form-group pe-span-2">
        <%= f.label :sku, t("inventory.products.sku"), class: "form-label form-label--required" %>
        <%= f.text_field :sku, class: "form-control #{'is-error' if product.errors[:sku].any?}",
              aria: { required: true, invalid: product.errors[:sku].any? } %>
      </div>

      <div class="form-group pe-span-2">
        <%= f.label :product_category_id, t("inventory.products.category"), class: "form-label" %>
        <%= f.select :product_category_id,
              options_from_collection_for_select(@categories, :id, :name, product.product_category_id),
              { include_blank: "— #{t('inventory.products.no_category')}" }, class: "form-control" %>
      </div>
      <div class="form-group pe-span-2">
        <%= f.label :brand_id, t("inventory.products.brand"), class: "form-label" %>
        <%= f.select :brand_id,
              options_from_collection_for_select(@brands, :id, :name, product.brand_id),
              { include_blank: "— #{t('inventory.products.no_brand')}" }, class: "form-control" %>
      </div>
      <div class="form-group pe-span-2">
        <%= f.label :default_supplier_id, t("inventory.products.default_supplier"), class: "form-label" %>
        <%= f.select :default_supplier_id,
              options_from_collection_for_select(@suppliers, :id, :name, product.default_supplier_id),
              { include_blank: "— #{t('inventory.products.no_default_supplier')}" }, class: "form-control" %>
        <p class="form-hint"><%= t("inventory.products.default_supplier_hint") %></p>
      </div>

      <%# Unit of Measure + Amount, side by side: the product's size ("355 ml",
          "500 g") — informational only, never a unit of stock. Both editable at
          any time. The Amount follows the unit (product_measure_controller.js):
          a whole product (pieces) has none — the field is hidden and a blank is
          sent, so no stale amount is kept; any other unit shows the Amount with
          that unit as its suffix. %>
      <% measure = product.unit_of_measure.presence || Product::DEFAULT_UNIT_OF_MEASURE
         pieces  = measure == "pieces" %>
      <div class="form-group measure-group pe-span-3" data-testid="product-measurement" data-controller="product-measure">
        <div class="measure-pair">
          <div class="measure-pair__unit">
            <%= f.label :unit_of_measure, t("inventory.measures.field"), class: "form-label" %>
            <%= f.select :unit_of_measure, measure_options, { selected: measure },
                  class: "form-control #{'is-error' if product.errors[:unit_of_measure].any?}",
                  data: { testid: "product-measure", product_measure_target: "select", action: "product-measure#change" } %>
          </div>
          <div class="measure-pair__amount" data-product-measure-target="amountGroup" data-testid="product-measure-amount-group" <%= "hidden" if pieces %>>
            <%= f.label :measure_amount, t("inventory.measures.amount"), class: "form-label" %>
            <div class="input-with-suffix">
              <%= f.number_field :measure_amount, step: "any", min: 0, inputmode: "decimal",
                    value: (product.measure_amount && !pieces ? inventory_quantity(product.measure_amount) : nil),
                    class: "form-control #{'is-error' if product.errors[:measure_amount].any?}",
                    disabled: pieces, data: { testid: "product-measure-amount", product_measure_target: "amount" } %>
              <span class="input-suffix" data-product-measure-target="suffix" data-testid="product-measure-amount-suffix"><%= measure_short(measure) %></span>
            </div>
            <%# Pieces: this blank is sent instead of the hidden Amount. %>
            <%= hidden_field_tag "product[measure_amount]", "", id: nil, disabled: !pieces, data: { product_measure_target: "amountBlank" } %>
          </div>
        </div>
        <p class="form-hint"><%= t("#{lk}.measure_hint") %></p>
        <% %i[unit_of_measure measure_amount].each do |attribute| %>
          <% if product.errors[attribute].any? %>
            <p class="form-hint text-danger"><%= product.errors.full_messages_for(attribute).to_sentence %></p>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>

  <%# ── Barcodes ──────────────────────────────────────────── %>
  <section class="pe-card" aria-labelledby="pe-barcodes-title"
           data-controller="line-items barcode-list"
           data-barcode-list-generate-url-value="<%= next_barcode_code_inventory_products_path(format: :json) %>">
    <header class="pe-card__head pe-card__head--actions">
      <div>
        <h2 class="section-title" id="pe-barcodes-title"><%= t("inventory.products.barcodes") %></h2>
        <p class="form-hint"><%= t("inventory.products.barcodes_hint") %></p>
      </div>
      <div class="pe-card__tools">
        <button type="button" class="btn btn-ghost btn-sm" data-action="line-items#add">
          + <%= t("inventory.products.add_barcode") %>
        </button>
        <button type="button" class="btn btn-secondary btn-sm" data-action="barcode-list#generate">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="4" height="18"/><rect x="9" y="3" width="2" height="18"/><rect x="13" y="3" width="4" height="18"/><rect x="19" y="3" width="2" height="9"/>
          </svg>
          <%= t("inventory.products.generate_barcode") %>
        </button>
      </div>
    </header>

    <div data-line-items-target="rows" class="barcode-list">
      <%= f.fields_for :product_barcodes do |bc_f| %>
        <%= render "barcode_fields", f: bc_f %>
      <% end %>
    </div>

    <p data-line-items-target="emptyState" class="td-secondary pe-empty" <%= "hidden" if product.product_barcodes.any? %>>
      <%= t("inventory.products.no_barcodes") %>
    </p>

    <template data-line-items-target="template">
      <%= f.fields_for :product_barcodes, ProductBarcode.new, child_index: "NEW_INDEX" do |bc_f| %>
        <%= render "barcode_fields", f: bc_f %>
      <% end %>
    </template>
  </section>

  <%# ── Pricing ───────────────────────────────────────────── %>
  <section class="pe-card" aria-labelledby="pe-pricing-title">
    <header class="pe-card__head">
      <h2 class="section-title" id="pe-pricing-title"><%= t("#{lk}.section_pricing") %></h2>
    </header>
    <div class="pe-grid">
      <div class="form-group pe-span-2">
        <%= f.label :initial_cost_price, t("inventory.products.initial_cost_price"), class: "form-label" %>
        <%= f.number_field :initial_cost_price, step: "0.0001", min: 0, class: "form-control" %>
        <p class="form-hint"><%= t("inventory.products.initial_cost_hint") %></p>
      </div>
      <div class="form-group pe-span-2">
        <%= f.label :selling_markup_percentage, t("inventory.products.selling_markup_percentage"), class: "form-label" %>
        <%= f.number_field :selling_markup_percentage, step: "0.01", min: 0, class: "form-control" %>
      </div>
      <%# Read-only figures of the saved product (Product#average_cost_price and
          Product#selling_price, as on the product page) — not editable here. %>
      <% if product.persisted? && product.selling_markup_percentage.present? %>
        <div class="form-group pe-span-2">
          <span class="form-label"><%= t("inventory.products.selling_price") %></span>
          <div class="pe-figure" data-testid="product-edit-selling-price">
            <strong><%= format_currency(product.selling_price) %></strong>
            <span class="td-secondary"><%= t("#{lk}.average_cost") %>: <%= format_unit_cost_currency(product.average_cost_price) %></span>
          </div>
          <p class="form-hint"><%= t("#{lk}.suggested_price_hint") %></p>
        </div>
      <% end %>
    </div>
  </section>

  <% unless availability_section %>
    <%# ── Inventory tracking, notifications & warehouse availability ── %>
    <section class="pe-card" aria-labelledby="inventory-tracking-title">
      <%= render "inventory/products/inventory_tracking_section", product: product %>
    </section>

    <section class="pe-card" aria-labelledby="pe-additional-title">
      <h2 class="section-title" id="pe-additional-title"><%= t("#{lk}.section_additional") %></h2>
      <div class="form-group pe-notes">
        <%= f.label :notes, t("inventory.products.notes"), class: "form-label" %>
        <%= f.text_area :notes, rows: 4, class: "form-control" %>
      </div>
    </section>

    <%= render "inventory/products/editor_actions", label: t("common.save"), cancel_path: inventory_products_path %>
  <% end %>
<% end %>

<% if availability_section %>
  <%# One section, outside the product form (the warehouse cards have their own forms). %>
  <section class="pe-card form-card--split-mid" aria-labelledby="inventory-tracking-title">
    <%= render "inventory/products/inventory_tracking_section", product: product, availability_section: availability_section %>
  </section>

  <section class="pe-card" aria-labelledby="pe-additional-title">
    <h2 class="section-title" id="pe-additional-title"><%= t("#{lk}.section_additional") %></h2>
    <div class="form-group pe-notes">
      <%= label_tag "product_notes", t("inventory.products.notes"), class: "form-label" %>
      <%= text_area_tag "product[notes]", product.notes, rows: 4, class: "form-control", id: "product_notes", form: "product-form" %>
    </div>
  </section>
<% end %>
