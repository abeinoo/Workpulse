<%#
  Products index — the row's ONE actions menu (⋮). locals: product, can_manage, can_quick_issue
  Every item goes to an existing route whose controller authorizes it again;
  the flags are the same policy answers (ProductPolicy / StockIssuePolicy#quick_issue?),
  computed once per page. Archive / delete follow the product page's rules:
  an active product can be archived; only an archived one can be deleted.
%>
<% scope = "inventory.products.index.actions" %>
<div class="row-actions products-row-actions" data-controller="dropdown">
  <button type="button" class="row-actions__btn" data-action="click->dropdown#toggle"
          data-dropdown-target="button" aria-haspopup="menu" aria-expanded="false"
          aria-label="<%= t("inventory.quick_issue.row_actions") %> — <%= product.name %>"
          title="<%= t("inventory.quick_issue.row_actions") %>"
          data-testid="product-row-actions">&#8942;</button>
  <div class="row-actions__menu" data-dropdown-target="menu" role="menu" hidden>
    <%= link_to inventory_product_path(product), class: "row-actions__item", role: "menuitem", data: { testid: "product-view" } do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
      <span><%= t("#{scope}.view") %></span>
    <% end %>

    <% if can_quick_issue && product.active? %>
      <%= link_to new_inventory_quick_issue_path(product_id: product.id), class: "row-actions__item", role: "menuitem",
            data: { turbo_frame: "modal", testid: "product-quick-issue", action: "dropdown#close" } do %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8v13H3V8"/><path d="M1 3h22v5H1z"/><path d="M12 12v6"/><path d="m9 15 3 3 3-3"/></svg>
        <span><%= t("inventory.quick_issue.action") %></span>
      <% end %>
    <% end %>

    <% if can_manage && product.active? %>
      <%= link_to edit_inventory_product_path(product), class: "row-actions__item", role: "menuitem", data: { testid: "product-edit" } do %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        <span><%= t("common.edit") %></span>
      <% end %>
    <% end %>

    <%= link_to inventory_barcode_label_path(product), target: "_blank", rel: "noopener", class: "row-actions__item",
          role: "menuitem", data: { testid: "product-print-barcode" } do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
      <span><%= t("inventory.barcode_labels.print_barcode") %></span>
    <% end %>

    <%= link_to inventory_movements_report_path(product_id: product.id), class: "row-actions__item", role: "menuitem",
          data: { testid: "product-movements" } do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
      <span><%= t("#{scope}.movements") %></span>
    <% end %>

    <% if can_manage %>
      <div class="products-row-actions__divider" role="separator"></div>
      <% if product.active? %>
        <%= button_to archive_inventory_product_path(product), method: :patch, class: "row-actions__item", role: "menuitem",
              form: { data: { turbo_confirm: t("inventory.products.archive_confirm") } }, data: { testid: "product-archive" } do %>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5"/><line x1="10" y1="12" x2="14" y2="12"/></svg>
          <span><%= t("inventory.products.archive") %></span>
        <% end %>
      <% else %>
        <%= button_to restore_inventory_product_path(product), method: :patch, class: "row-actions__item", role: "menuitem",
              data: { testid: "product-restore" } do %>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
          <span><%= t("inventory.products.restore") %></span>
        <% end %>
        <%= button_to inventory_product_path(product), method: :delete, class: "row-actions__item row-actions__item--danger", role: "menuitem",
              form: { data: { turbo_confirm: t("inventory.products.delete_confirm") } }, data: { testid: "product-delete" } do %>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
          <span><%= t("#{scope}.delete") %></span>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
