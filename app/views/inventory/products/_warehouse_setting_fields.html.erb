<tr data-line-row>
  <td>
    <%= f.select :warehouse_id,
          options_from_collection_for_select(warehouses, :id, :name, f.object.warehouse_id),
          { include_blank: "— #{t('inventory.products.select_warehouse')}" }, class: "form-control" %>
  </td>
  <td>
    <%= f.number_field :low_stock_level, step: "0.001", min: 0, class: "form-control", placeholder: "0" %>
  </td>
  <td>
    <%= f.number_field :reorder_quantity, step: "0.001", min: 0, class: "form-control", placeholder: "0" %>
  </td>
  <td class="td-actions">
    <% if f.object.persisted? %>
      <%= f.hidden_field :_destroy, value: "0", data: { destroy_field: true } %>
    <% end %>
    <button type="button" class="btn btn-ghost btn-sm text-danger" data-action="line-items#remove" aria-label="<%= t('common.delete') %>">×</button>
  </td>
</tr>
