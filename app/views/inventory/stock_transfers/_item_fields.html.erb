<tr data-line-row>
  <td>
    <%= f.select :product_id,
          inventory_product_options(products, f.object.product_id),
          { include_blank: "— #{t('inventory.stock_transfers.select_product')}" }, class: "form-control" %>
  </td>
  <td>
    <%= f.number_field :quantity, step: "0.001", min: 0, class: "form-control", placeholder: "0", data: { quantity_field: true } %>
  </td>
  <td class="td-actions">
    <% if f.object.persisted? %>
      <%= f.hidden_field :_destroy, value: "0", data: { destroy_field: true } %>
    <% end %>
    <button type="button" class="btn btn-ghost btn-sm text-danger" data-action="line-items#remove" aria-label="<%= t('common.delete') %>">×</button>
  </td>
</tr>
