<% content_for :title, @stock_transfer.transfer_number %>

<div class="form-page form-page--wide stf-page">
  <%= link_to inventory_stock_transfer_path(@stock_transfer), class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    <%= t("forms.back") %>
  <% end %>
  <h1 class="page-title mb-6">
    <%= @stock_transfer.pending_approval? ? t("inventory.stock_transfers.edit_pending_title") : t("inventory.stock_transfers.edit_title") %>
    — <%= @stock_transfer.transfer_number %>
  </h1>
  <%= render "form", stock_transfer: @stock_transfer %>
</div>
