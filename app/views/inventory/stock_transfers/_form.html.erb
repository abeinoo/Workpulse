<%= form_with model: [:inventory, stock_transfer], class: "form-card", data: { controller: "line-items" } do |f| %>
  <%= render "shared/error_messages", object: stock_transfer %>

  <h2 class="section-title"><%= t("inventory.stock_transfers.section_header") %></h2>
  <div class="form-grid">
    <div class="form-group">
      <%= f.label :source_warehouse_id, t("inventory.stock_transfers.source_warehouse"), class: "form-label" %>
      <%= f.select :source_warehouse_id,
            options_from_collection_for_select(@warehouses, :id, :name, stock_transfer.source_warehouse_id),
            { include_blank: "— #{t('inventory.stock_transfers.select_warehouse')}" },
            class: "form-control #{'is-error' if stock_transfer.errors[:source_warehouse_id].any?}" %>
    </div>
    <div class="form-group">
      <%= f.label :destination_warehouse_id, t("inventory.stock_transfers.destination_warehouse"), class: "form-label" %>
      <%= f.select :destination_warehouse_id,
            options_from_collection_for_select(@warehouses, :id, :name, stock_transfer.destination_warehouse_id),
            { include_blank: "— #{t('inventory.stock_transfers.select_warehouse')}" },
            class: "form-control #{'is-error' if stock_transfer.errors[:destination_warehouse_id].any?}" %>
    </div>
    <div class="form-group">
      <%= f.label :transferred_on, t("inventory.stock_transfers.date"), class: "form-label" %>
      <%= f.date_field :transferred_on, class: "form-control" %>
    </div>
    <div class="form-group" style="grid-column: 1 / -1;">
      <%= f.label :notes, t("inventory.stock_transfers.notes"), class: "form-label" %>
      <%= f.text_area :notes, rows: 2, class: "form-control" %>
    </div>
  </div>

  <div class="divider"></div>

  <h2 class="section-title"><%= t("inventory.stock_transfers.section_items") %></h2>
  <p class="form-hint"><%= t("inventory.stock_transfers.availability_note") %></p>
  <div class="table-wrap">
    <table class="line-items-table">
      <thead><tr>
        <th style="width: 60%;"><%= t("inventory.stock_transfers.product") %></th>
        <th><%= t("inventory.stock_transfers.quantity") %></th>
        <th></th>
      </tr></thead>
      <tbody data-line-items-target="rows">
        <%= f.fields_for :items do |item_f| %>
          <%= render "item_fields", f: item_f, products: @products %>
        <% end %>
      </tbody>
    </table>
  </div>

  <p data-line-items-target="emptyState" class="td-secondary" <%= "hidden" if stock_transfer.items.any? %>>
    <%= t("inventory.stock_transfers.no_items_hint") %>
  </p>

  <button type="button" class="btn btn-ghost btn-sm" data-action="line-items#add" style="margin-top: var(--space-3);">
    + <%= t("inventory.stock_transfers.add_item") %>
  </button>

  <template data-line-items-target="template">
    <%= f.fields_for :items, StockTransferItem.new, child_index: "NEW_INDEX" do |item_f| %>
      <%= render "item_fields", f: item_f, products: @products %>
    <% end %>
  </template>

  <div class="form-actions">
    <%= f.submit t("inventory.stock_transfers.post"), class: "btn btn-primary" %>
    <%= link_to t("common.cancel"), inventory_stock_transfers_path, class: "btn btn-ghost" %>
  </div>
<% end %>
