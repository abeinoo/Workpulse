<%# Quick Issue popup header — title, one-line explanation, close (modal only). %>
<div class="qi__header">
  <div>
    <h2 class="qi__title" id="quick-issue-title"><%= t("inventory.quick_issue.title") %></h2>
    <p class="qi__subtitle"><%= t("inventory.quick_issue.workflow_note") %></p>
  </div>
  <% if in_modal %>
    <button type="button" class="qi__close" data-action="click->modal#close" aria-label="<%= t("common.close") %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  <% end %>
</div>
