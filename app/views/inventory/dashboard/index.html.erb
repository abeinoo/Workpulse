<% content_for :title, t("inventory.dashboard.title") %>
<% ov = "inventory.dashboard.overview" %>
<% qty = ->(v) { number_with_delimiter(v.to_d.round(2).to_s("F").sub(/\.0\z/, "")) } %>
<% keep = ->(extra) { request.query_parameters.slice("period", "from", "to", "active_period", "product_id").merge(extra.stringify_keys).compact_blank } %>

<div class="admin-page inv-dash">
  <%# ── Header + quick actions (each gated by its own policy) ──────────── %>
  <div class="page-header">
    <h1 class="page-title"><%= t("nav.inventory_dashboard") %></h1>
    <div class="inv-dash__actions">
      <% if policy(GoodsReceipt).create? %>
        <%= link_to t("inventory.goods_receipts.new_action"), new_inventory_goods_receipt_path, class: "btn btn-primary btn-sm" %>
      <% end %>
      <% if policy(StockIssue).create? %>
        <%= link_to t("inventory.stock_issues.new_action"), new_inventory_stock_issue_path, class: "btn btn-secondary btn-sm" %>
      <% end %>
      <% if policy(PurchaseRequest).create? %>
        <%= link_to t("#{ov}.quick.purchase_request"), new_inventory_purchase_request_path, class: "btn btn-ghost btn-sm" %>
      <% end %>
      <% if policy(StockAdjustment).create? %>
        <%= link_to t("#{ov}.quick.adjustment"), new_inventory_stock_adjustment_path, class: "btn btn-ghost btn-sm" %>
      <% end %>
      <% if policy(StockTransfer).create? %>
        <%= link_to t("#{ov}.quick.transfer"), new_inventory_stock_transfer_path, class: "btn btn-ghost btn-sm" %>
      <% end %>
      <% if policy(StockCount).create? %>
        <%= link_to t("#{ov}.quick.stock_count"), new_inventory_stock_count_path, class: "btn btn-ghost btn-sm" %>
      <% end %>
    </div>
  </div>

  <%# ── Product search → quick actions ─────────────────────────────────── %>
  <section class="card inv-dash__search">
    <%= form_with url: inventory_root_path, method: :get, local: true, class: "inv-dash__search-form" do |f| %>
      <% keep.({}).except("product_id").each do |k, v| %><%= hidden_field_tag k, v %><% end %>
      <div class="inv-dash__search-field" data-controller="searchable-select">
        <%= f.label :product_id, t("#{ov}.search_label"), class: "filter-bar__label" %>
        <%= f.select :product_id, options_from_collection_for_select(@search_products, :id, ->(p) { "#{p.name} — #{p.sku}" }, @quick_product&.id),
              { prompt: t("#{ov}.search_placeholder") }, class: "filter-bar__select",
              data: { searchable_select_target: "select", search_placeholder: t("#{ov}.search_placeholder"),
                      controller: "auto-submit", action: "change->auto-submit#submit" } %>
      </div>
    <% end %>
    <% if @quick_product %>
      <div class="inv-dash__quick">
        <strong><%= @quick_product.name %></strong>
        <span class="td-secondary"><%= @quick_product.sku %> · <%= t("#{ov}.on_hand") %>: <%= qty.(@quick_product.current_stock) %></span>
        <div class="inv-dash__quick-links">
          <% if policy(@quick_product).show? %>
            <%= link_to t("#{ov}.quick.view_product"), inventory_product_path(@quick_product), class: "btn btn-secondary btn-sm" %>
          <% end %>
          <%= link_to t("#{ov}.quick.product_movements"), inventory_movements_report_path(product_id: @quick_product.id), class: "btn btn-secondary btn-sm" %>
          <% if policy(StockIssue).create? %>
            <%= link_to t("inventory.stock_issues.new_action"), new_inventory_stock_issue_path, class: "btn btn-ghost btn-sm" %>
          <% end %>
          <% if policy(GoodsReceipt).create? %>
            <%= link_to t("inventory.goods_receipts.new_action"), new_inventory_goods_receipt_path, class: "btn btn-ghost btn-sm" %>
          <% end %>
          <% if policy(PurchaseRequest).create? %>
            <%= link_to t("#{ov}.quick.purchase_request"), new_inventory_purchase_request_path, class: "btn btn-ghost btn-sm" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </section>

  <%# ── KPIs ────────────────────────────────────────────────────────────── %>
  <div class="kpi-grid kpi-grid--compact inv-dash__kpis">
    <%= link_to inventory_current_stock_report_path, class: "kpi-card" do %>
      <span class="kpi-card__label"><%= t("#{ov}.kpis.stock_value") %></span>
      <span class="kpi-card__value"><%= format_currency(@overview.total_value) %></span>
    <% end %>
    <%= link_to (policy(Product).index? ? inventory_products_path : inventory_current_stock_report_path), class: "kpi-card" do %>
      <span class="kpi-card__label"><%= t("#{ov}.kpis.products") %></span>
      <span class="kpi-card__value"><%= @overview.product_count %></span>
    <% end %>
    <%= link_to inventory_low_stock_report_path, class: "kpi-card #{'kpi-card--danger' if @overview.low_stock_count.positive?}" do %>
      <span class="kpi-card__label"><%= t("#{ov}.kpis.low_stock") %></span>
      <span class="kpi-card__value"><%= @overview.low_stock_count %></span>
    <% end %>
    <%= link_to inventory_current_stock_report_path(stock_status: "out_of_stock"), class: "kpi-card #{'kpi-card--danger' if @overview.out_of_stock_count.positive?}" do %>
      <span class="kpi-card__label"><%= t("#{ov}.kpis.out_of_stock") %></span>
      <span class="kpi-card__value"><%= @overview.out_of_stock_count %></span>
    <% end %>
    <% unless @open_purchase_requests.nil? %>
      <%= link_to inventory_purchase_requests_path(needs_action: "1"), class: "kpi-card" do %>
        <span class="kpi-card__label"><%= t("#{ov}.kpis.open_purchase_requests") %></span>
        <span class="kpi-card__value"><%= @open_purchase_requests %></span>
      <% end %>
    <% end %>
    <% unless @receipts_pending_approval.nil? %>
      <%= link_to inventory_goods_receipts_path(approval_status: "pending_approval"), class: "kpi-card" do %>
        <span class="kpi-card__label"><%= t("#{ov}.kpis.pending_receipts") %></span>
        <span class="kpi-card__value"><%= @receipts_pending_approval %></span>
      <% end %>
    <% end %>
    <% unless @issues_pending_approval.nil? %>
      <%= link_to inventory_stock_issues_path(workflow_status: "pending_approval"), class: "kpi-card" do %>
        <span class="kpi-card__label"><%= t("#{ov}.kpis.pending_issues") %></span>
        <span class="kpi-card__value"><%= @issues_pending_approval %></span>
      <% end %>
    <% end %>
    <% unless @counts_awaiting_approval.nil? %>
      <%= link_to inventory_stock_counts_path(status: "completed"), class: "kpi-card" do %>
        <span class="kpi-card__label"><%= t("#{ov}.kpis.pending_counts") %></span>
        <span class="kpi-card__value"><%= @counts_awaiting_approval %></span>
      <% end %>
    <% end %>
  </div>

  <%# ── Movement overview + Action Center ─────────────────────────────── %>
  <div class="inv-dash__split">
    <section class="card inv-dash__panel" id="movement-overview">
      <div class="inv-dash__panel-head">
        <h2 class="section-title--exec"><%= t("#{ov}.movements_title") %></h2>
        <div class="exec-card__toggle" role="group" aria-label="<%= t("#{ov}.period") %>">
          <% Inventory::DashboardController::PERIOD_KEYS.each do |key| %>
            <%= link_to t("#{ov}.periods.#{key}"), inventory_root_path(keep.("period" => key, "from" => nil, "to" => nil).merge(anchor: "movement-overview")),
                  class: "btn btn-sm #{'is-active' if @period.key == key}", aria: { current: (@period.key == key ? "true" : nil) } %>
          <% end %>
        </div>
      </div>
      <details class="inv-dash__custom" <%= "open" if @period.key == "custom" %>>
        <summary class="td-secondary"><%= t("#{ov}.periods.custom") %></summary>
        <%= form_with url: inventory_root_path(anchor: "movement-overview"), method: :get, local: true, class: "inv-dash__custom-form" do |f| %>
          <% keep.({}).except("period", "from", "to").each do |k, v| %><%= hidden_field_tag k, v %><% end %>
          <%= hidden_field_tag :period, "custom" %>
          <%= f.date_field :from, value: @period.from.iso8601, class: "filter-bar__input", "aria-label": t("inventory.reports.fields.from") %>
          <%= f.date_field :to,   value: @period.to.iso8601,   class: "filter-bar__input", "aria-label": t("inventory.reports.fields.to") %>
          <%= f.submit t("shared.filter"), class: "btn btn-secondary btn-sm" %>
        <% end %>
      </details>
      <% if @period.invalid? %>
        <p class="form-error" role="alert"><%= t("inventory.reports.period.invalid_range_fallback") %></p>
      <% end %>
      <p class="td-secondary inv-dash__period"><%= local_date(@period.from) %> – <%= local_date(@period.to) %></p>

      <% totals = @movements.totals %>
      <div class="inv-dash__flows">
        <% %i[receipts issues transfers_in transfers_out adjustments].each do |bucket| %>
          <div class="inv-dash__flow">
            <span class="inv-dash__flow-label"><%= t("#{ov}.flows.#{bucket}") %></span>
            <span class="inv-dash__flow-value"><%= format_currency(totals[bucket].value) %></span>
            <span class="td-secondary"><%= t("#{ov}.units", count: qty.(totals[bucket].quantity)) %></span>
          </div>
        <% end %>
        <div class="inv-dash__flow inv-dash__flow--net">
          <span class="inv-dash__flow-label"><%= t("#{ov}.flows.net") %></span>
          <span class="inv-dash__flow-value"><%= format_currency(@movements.net.value) %></span>
          <span class="td-secondary"><%= t("#{ov}.units", count: qty.(@movements.net.quantity)) %></span>
        </div>
      </div>

      <% trend = @movements.daily_trend %>
      <% if @period.days > 1 && trend.any? { |_, i, o| i.nonzero? || o.nonzero? } %>
        <%# .chart-card is what reveals the canvas once Chart.js has drawn it (is-loaded). %>
        <div class="chart-card inv-dash__chart-card">
        <div class="chart-card__body inv-dash__chart">
          <canvas data-controller="chart" data-chart-type-value="line" role="img" aria-label="<%= t("#{ov}.trend_chart") %>"
                  data-chart-data-value="<%= { labels: trend.map { |d, _, _| l(d, format: "%-d/%-m") },
                                               datasets: [ { label: t("#{ov}.flows.receipts"), data: trend.map { |_, i, _| i.to_f.round(2) } },
                                                           { label: t("#{ov}.flows.issues"),   data: trend.map { |_, _, o| o.to_f.round(2) } } ] }.to_json %>"></canvas>
        </div>
        </div>
        <p class="td-secondary inv-dash__note"><%= t("#{ov}.trend_note") %></p>
      <% elsif @movements.movement_count.zero? %>
        <p class="td-secondary"><%= t("#{ov}.no_movements") %></p>
      <% end %>
    </section>

    <section class="card inv-dash__panel" id="action-center">
      <div class="inv-dash__panel-head">
        <h2 class="section-title--exec"><%= t("#{ov}.action_center") %></h2>
      </div>
      <% if @action_items.empty? %>
        <div class="inv-dash__all-good">
          <span class="badge badge-success"><%= t("#{ov}.all_good") %></span>
          <p class="td-secondary"><%= t("#{ov}.all_good_hint") %></p>
        </div>
      <% else %>
        <ul class="inv-dash__actions-list">
          <% @action_items.each do |item| %>
            <li class="inv-dash__action inv-dash__action--<%= item.level %>">
              <span class="inv-dash__action-dot" aria-hidden="true"></span>
              <div class="inv-dash__action-body">
                <span class="inv-dash__action-title"><%= t("#{ov}.actions.#{item.key}.title") %> — <strong><%= item.count %></strong></span>
                <span class="td-secondary"><%= t("#{ov}.actions.#{item.key}.desc") %></span>
              </div>
              <%= link_to t("#{ov}.actions.#{item.key}.cta"), item.path, class: "btn btn-secondary btn-sm" %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  </div>

  <%# ── Purchase recommendations (existing low-stock purchasing flow) ──── %>
  <%= render "inventory/shared/low_stock_purchasing", rows: @low_stock_rows.first(Inventory::DashboardController::PURCHASE_ROWS),
             total: @low_stock_rows.size, suppliers: @suppliers, show_min_level: true, title: t("#{ov}.needs_purchase") %>
  <% if @low_stock_rows.size > Inventory::DashboardController::PURCHASE_ROWS %>
    <p class="inv-dash__more">
      <%= link_to t("#{ov}.view_all_low_stock", count: @low_stock_rows.size), inventory_low_stock_report_path, class: "link" %>
    </p>
  <% end %>

  <% if @family_low_stock.any? %>
    <section class="card inv-dash__section">
      <div class="card__header flex items-center justify-between">
        <h2 class="card__title" style="margin: 0;">
          <%= t("inventory.dashboard.family_low_stock_title") %>
          <span class="badge badge-warning"><%= @family_low_stock.values.sum(&:size) %></span>
        </h2>
      </div>
      <div class="table-wrap table-wrap--cards">
        <table>
          <thead><tr>
            <th><%= t("inventory.products.parent_product") %></th>
            <th style="text-align: end;"><%= t("inventory.dashboard.low_children_count") %></th>
          </tr></thead>
          <tbody>
            <% @family_low_stock.each do |parent, alerts| %>
              <tr>
                <td><%= link_to parent.name, inventory_product_path(parent), class: "link" %></td>
                <td style="text-align: end;"><span class="badge badge-warning"><%= alerts.size %></span></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <%# ── Most active products ──────────────────────────────────────────── %>
  <section class="card inv-dash__section" id="active-products">
    <div class="inv-dash__panel-head">
      <h2 class="section-title--exec"><%= t("#{ov}.active_products") %></h2>
      <div class="exec-card__toggle" role="group" aria-label="<%= t("#{ov}.period") %>">
        <% Inventory::DashboardController::ACTIVE_PERIOD_KEYS.each do |key| %>
          <%= link_to t("#{ov}.periods.#{key}"), inventory_root_path(keep.("active_period" => key).merge(anchor: "active-products")),
                class: "btn btn-sm #{'is-active' if @active_period.key == key}" %>
        <% end %>
      </div>
    </div>
    <% if @active_products.empty? %>
      <p class="td-secondary"><%= t("#{ov}.no_consumption") %></p>
    <% else %>
      <div class="table-wrap table-wrap--cards">
        <table class="report-table">
          <thead><tr>
            <th><%= t("inventory.reports.fields.product") %></th>
            <th style="text-align: end;"><%= t("#{ov}.issued_quantity") %></th>
            <th style="text-align: end;"><%= t("#{ov}.issue_count") %></th>
            <th><%= t("#{ov}.top_branch") %></th>
          </tr></thead>
          <tbody>
            <% @active_products.each do |row| %>
              <tr>
                <td class="td-wrap"><%= link_to row.product.name, inventory_product_path(row.product), class: "link" %> <span class="td-secondary"><%= row.product.sku %></span></td>
                <td style="text-align: end; font-weight: 600;"><%= qty.(row.quantity) %></td>
                <td style="text-align: end;"><%= row.issue_count %></td>
                <td class="td-secondary"><%= row.top_branch ? "#{row.top_branch.name} (#{qty.(row.top_branch_quantity)})" : "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>

  <%# ── Warehouse summary ─────────────────────────────────────────────── %>
  <% if @warehouses.size > 1 %>
    <section class="card inv-dash__section">
      <div class="inv-dash__panel-head"><h2 class="section-title--exec"><%= t("#{ov}.warehouse_summary") %></h2></div>
      <div class="table-wrap table-wrap--cards">
        <table class="report-table">
          <thead><tr>
            <th><%= t("inventory.reports.fields.warehouse") %></th>
            <th style="text-align: end;"><%= t("inventory.reports.fields.stock_value") %></th>
            <th style="text-align: end;"><%= t("#{ov}.products_in_stock") %></th>
            <th style="text-align: end;"><%= t("#{ov}.kpis.low_stock") %></th>
            <th style="text-align: end;"><%= t("#{ov}.kpis.out_of_stock") %></th>
            <th style="text-align: end;"><%= t("#{ov}.period_movements") %></th>
          </tr></thead>
          <tbody>
            <% @warehouse_summary.rows.each do |row| %>
              <tr>
                <td class="td-wrap"><%= policy(row.warehouse).show? ? link_to(row.warehouse.name, inventory_warehouse_path(row.warehouse), class: "link") : row.warehouse.name %></td>
                <td style="text-align: end;"><%= format_currency(row.stock_value) %></td>
                <td style="text-align: end;"><%= row.products_in_stock %></td>
                <td style="text-align: end;"><%= row.low_stock.positive? ? content_tag(:span, row.low_stock, class: "badge badge-warning") : 0 %></td>
                <td style="text-align: end;"><%= row.out_of_stock.positive? ? content_tag(:span, row.out_of_stock, class: "badge badge-danger") : 0 %></td>
                <td style="text-align: end;"><%= row.movements %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% elsif (only = @warehouse_summary.rows.first) %>
    <p class="card inv-dash__single-warehouse">
      <strong><%= policy(only.warehouse).show? ? link_to(only.warehouse.name, inventory_warehouse_path(only.warehouse), class: "link") : only.warehouse.name %></strong>
      <span class="td-secondary">
        <%= t("#{ov}.single_warehouse", products: only.products_in_stock, movements: only.movements) %>
      </span>
    </p>
  <% end %>

  <%# ── Recent movements (Stock Movement report query) ───────────────── %>
  <section class="card inv-dash__section">
    <div class="inv-dash__panel-head">
      <h2 class="section-title--exec"><%= t("inventory.dashboard.recent_movements") %></h2>
      <%= link_to t("inventory.dashboard.view_all"), inventory_movements_report_path, class: "link" %>
    </div>
    <% if @recent_movements.empty? %>
      <p class="td-secondary"><%= t("inventory.dashboard.none_yet") %></p>
    <% else %>
      <div class="table-wrap table-wrap--cards">
        <table class="report-table">
          <thead><tr>
            <th><%= t("#{ov}.date_time") %></th>
            <th><%= t("inventory.reports.fields.product") %></th>
            <th><%= t("inventory.reports.fields.type") %></th>
            <th style="text-align: end;"><%= t("inventory.reports.fields.quantity") %></th>
            <th><%= t("inventory.reports.fields.warehouse") %></th>
            <th><%= t("inventory.reports.fields.branch") %></th>
            <th><%= t("inventory.reports.fields.document_number") %></th>
          </tr></thead>
          <tbody>
            <% @recent_movements.each do |row| %>
              <% branch_id = row.movement.branch_id || (row.source.branch_id if row.source.respond_to?(:branch_id)) %>
              <tr>
                <td class="td-secondary"><%= local_date(row.movement.occurred_on) %> <span style="font-size: var(--text-xs);"><%= local_time_12h(row.movement.created_at) %></span></td>
                <td class="td-wrap"><%= link_to row.product.name, inventory_product_path(row.product), class: "link" %></td>
                <td><%= inventory_movement_badge(row.reason) %></td>
                <td style="text-align: end; font-weight: 600;"><%= row.signed_quantity.positive? ? "+" : "−" %><%= qty.(row.quantity) %></td>
                <td class="td-secondary"><%= row.warehouse.name %></td>
                <td class="td-secondary"><%= @recent_branches[branch_id]&.name || "—" %></td>
                <td><%= inventory_source_document_link(row.source, row.document_number) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
</div>
