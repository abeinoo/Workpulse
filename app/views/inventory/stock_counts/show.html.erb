<% content_for :title, @stock_count.count_number %>

<div class="admin-page">
  <%= link_to inventory_stock_counts_path, class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    <%= t("forms.back") %>
  <% end %>

  <div class="page-header">
    <h1 class="page-title">
      <%= @stock_count.count_number %>
      <span class="badge <%= stock_count_status_class(@stock_count.status) %>">
        <%= t("inventory.stock_counts.statuses.#{@stock_count.status}") %>
      </span>
    </h1>
    <div class="flex items-center" style="gap: var(--space-2);">
      <%= link_to t("inventory.stock_counts.export_action"), export_inventory_stock_count_path(@stock_count, format: :csv), class: "btn btn-ghost btn-sm" %>
      <% if @stock_count.editable_counts? && policy(@stock_count).update? %>
        <%= link_to t("inventory.stock_counts.continue_counting"), edit_inventory_stock_count_path(@stock_count), class: "btn btn-secondary btn-sm" %>
      <% end %>
      <% if policy(@stock_count).complete? %>
        <%= button_to t("inventory.stock_counts.complete_action"), complete_inventory_stock_count_path(@stock_count),
              method: :patch, class: "btn btn-primary btn-sm",
              data: { turbo_confirm: t("inventory.stock_counts.complete_confirm") } %>
      <% end %>
      <% if policy(@stock_count).approve? %>
        <% if policy(@stock_count).owner_self_approval? %>
          <span class="badge badge-warning"><%= t("inventory.stock_counts.owner_self_approval_badge") %></span>
        <% end %>
        <% if @stock_count.uncounted_count.positive? %>
          <span class="badge badge-neutral"><%= t("inventory.stock_counts.uncounted_skipped", count: @stock_count.uncounted_count) %></span>
        <% end %>
        <%= button_to t("inventory.stock_counts.approve_action"), approve_inventory_stock_count_path(@stock_count),
              method: :patch, class: "btn btn-primary btn-sm",
              data: { turbo_confirm: @stock_count.fully_counted? ? t("inventory.stock_counts.approve_confirm") : t("inventory.stock_counts.approve_confirm_partial", count: @stock_count.uncounted_count) } %>
      <% end %>
      <% if @stock_count.completed? && policy(@stock_count).reopen? %>
        <%= button_to t("inventory.stock_counts.reopen_action"), reopen_inventory_stock_count_path(@stock_count),
              method: :patch, class: "btn btn-ghost btn-sm",
              data: { turbo_confirm: t("inventory.stock_counts.reopen_confirm") } %>
      <% end %>
    </div>
  </div>

  <%# ── Lifecycle guidance: inventory changes only on approval ─────── %>
  <% case @stock_count.status %>
  <% when "draft", "in_progress" %>
    <div class="alert alert-info" style="margin-bottom: var(--space-4);"><%= t("inventory.stock_counts.guidance.counting") %></div>
  <% when "completed" %>
    <div class="alert alert-info" style="margin-bottom: var(--space-4);">
      <%= t("inventory.stock_counts.guidance.awaiting_approval") %>
      <% if policy(@stock_count).owner_self_approval? %>
        <%= t("inventory.stock_counts.guidance.owner_self_approval") %>
      <% elsif !policy(@stock_count).approve? && [ @stock_count.created_by_id, @stock_count.completed_by_id ].include?(current_user.id) %>
        <%= t("inventory.stock_counts.guidance.self_approval_blocked") %>
      <% end %>
    </div>
  <% when "approved" %>
    <div class="alert alert-info" style="margin-bottom: var(--space-4);"><%= t("inventory.stock_counts.guidance.approved") %></div>
  <% when "cancelled" %>
    <div class="alert alert-warning" style="margin-bottom: var(--space-4);">
      <%= t("inventory.stock_counts.guidance.cancelled", by: @stock_count.cancelled_by&.full_name || "—",
            at: l(@stock_count.cancelled_at, format: :long), reason: @stock_count.cancel_reason) %>
    </div>
  <% end %>
  <% if @legacy_count.positive? && (@stock_count.editable_counts? || @stock_count.completed?) %>
    <div class="alert alert-warning" style="margin-bottom: var(--space-4);">
      <%= t(@stock_count.completed? ? "inventory.stock_counts.guidance.legacy_completed" : "inventory.stock_counts.guidance.legacy_editable",
            count: @legacy_count) %>
    </div>
  <% end %>

  <% if @stock_count.approved? && policy(@stock_count).reopen? %>
    <%= render "reason_action", panel_id: "reopen-panel", path: reopen_inventory_stock_count_path(@stock_count), method: :patch,
          action_label: t("inventory.stock_counts.reopen_approved_action"),
          hint: t("inventory.stock_counts.reopen_approved_hint"),
          confirm_dialog: t("inventory.stock_counts.reopen_approved_confirm"),
          reason_label: t("inventory.stock_counts.reason_label") %>
  <% end %>
  <% if policy(@stock_count).cancel? %>
    <%= render "reason_action", panel_id: "cancel-panel", path: cancel_inventory_stock_count_path(@stock_count), method: :patch,
          action_label: t("inventory.stock_counts.cancel_action"),
          hint: t("inventory.stock_counts.cancel_hint"),
          confirm_dialog: t("inventory.stock_counts.cancel_confirm"),
          reason_label: t("inventory.stock_counts.reason_label") %>
  <% end %>
  <% if policy(@stock_count).destroy? %>
    <%= render "reason_action", panel_id: "delete-panel", path: inventory_stock_count_path(@stock_count), method: :delete,
          action_label: t("inventory.stock_counts.delete_action"),
          hint: t("inventory.stock_counts.delete_hint"),
          confirm_dialog: t("inventory.stock_counts.delete_confirm"),
          reason_label: t("inventory.stock_counts.reason_label") %>
  <% end %>

  <%# ── Report summary ──────────────────────────────────────── %>
  <div class="stats-grid" style="margin-bottom: var(--space-5);">
    <div class="stat-card"><div class="stat-card__label"><%= t("inventory.stock_counts.report.total_counted") %></div><div class="stat-card__value"><%= @stock_count.counted_products %> / <%= @stock_count.total_products %> <span class="stat-card__sub"><%= @stock_count.completion_percentage %>%</span></div></div>
    <div class="stat-card"><div class="stat-card__label"><%= t("inventory.stock_counts.report.remaining") %></div><div class="stat-card__value <%= 'text-warning' if @stock_count.remaining_products.positive? %>"><%= @stock_count.remaining_products %></div></div>
    <div class="stat-card"><div class="stat-card__label"><%= t("inventory.stock_counts.report.matched") %></div><div class="stat-card__value"><%= @stock_count.matched_count %></div></div>
    <div class="stat-card"><div class="stat-card__label"><%= t("inventory.stock_counts.report.shortages") %></div><div class="stat-card__value text-danger"><%= @stock_count.shortage_count %></div></div>
    <div class="stat-card"><div class="stat-card__label"><%= t("inventory.stock_counts.report.overages") %></div><div class="stat-card__value text-warning"><%= @stock_count.overage_count %></div></div>
    <div class="stat-card"><div class="stat-card__label"><%= t("inventory.stock_counts.report.adjustment_value") %></div><div class="stat-card__value"><%= number_to_currency(@stock_count.adjustment_value, unit: "") %></div></div>
  </div>

  <%# ── Inventory value impact (approved counts, from the generated adjustment) ── %>
  <% if @stock_count.approved? %>
    <% adj = @active_adjustment %>
    <h2 class="section-title"><%= t("inventory.stock_counts.impact.title") %></h2>
    <div class="stats-grid" style="margin-bottom: var(--space-5);">
      <div class="stat-card stat-card--danger"><div class="stat-card__label"><%= t("inventory.stock_counts.impact.total_shortages") %></div><div class="stat-card__value text-danger"><%= format_currency(adj ? adj.shortage_value : 0) %></div></div>
      <div class="stat-card stat-card--success"><div class="stat-card__label"><%= t("inventory.stock_counts.impact.total_overages") %></div><div class="stat-card__value"><%= format_currency(adj ? adj.overage_value : 0) %></div></div>
      <div class="stat-card stat-card--accent"><div class="stat-card__label"><%= t("inventory.stock_counts.impact.net_value") %></div><div class="stat-card__value"><%= format_currency(adj ? adj.net_value : 0) %></div></div>
    </div>
  <% end %>

  <div class="card" style="padding: var(--space-5); margin-bottom: var(--space-5);">
    <dl class="detail-list">
      <div class="detail-list__row"><dt><%= t("inventory.stock_counts.date") %></dt><dd><%= local_date(@stock_count.counted_on) %></dd></div>
      <div class="detail-list__row"><dt><%= t("inventory.stock_counts.warehouse") %></dt><dd><%= @stock_count.warehouse.name %></dd></div>
      <div class="detail-list__row"><dt><%= t("inventory.stock_counts.counted_by") %></dt><dd><%= @stock_count.created_by&.full_name || "—" %></dd></div>
      <% if @stock_count.completed_at %>
        <div class="detail-list__row"><dt><%= t("inventory.stock_counts.completed_by") %></dt><dd><%= @stock_count.completed_by&.full_name || "—" %> · <%= l(@stock_count.completed_at, format: :long) %></dd></div>
      <% end %>
      <% if @stock_count.approved? %>
        <div class="detail-list__row"><dt><%= t("inventory.stock_counts.approved_by") %></dt><dd><%= @stock_count.approved_by&.full_name || "—" %> · <%= l(@stock_count.approved_at, format: :long) %></dd></div>
        <% if @active_adjustment %>
          <div class="detail-list__row">
            <dt><%= t("inventory.stock_counts.adjustment") %></dt>
            <dd><%= link_to @active_adjustment.adjustment_number, inventory_stock_adjustment_path(@active_adjustment), class: "link" %></dd>
          </div>
        <% end %>
      <% end %>
      <% if @stock_count.notes.present? %>
        <div class="detail-list__row"><dt><%= t("inventory.stock_counts.notes") %></dt><dd><%= simple_format(@stock_count.notes) %></dd></div>
      <% end %>
    </dl>
  </div>

  <%# ── Worksheet / variance ──────────────────────────────── %>
  <h2 class="section-title"><%= t("inventory.stock_counts.variance_title") %></h2>
  <div class="table-wrap table-wrap--cards">
    <table>
      <thead><tr>
        <th><%= t("inventory.stock_counts.product") %></th>
        <th><%= t("inventory.stock_counts.barcode") %></th>
        <th style="text-align: end;"><%= t("inventory.stock_counts.system_quantity") %></th>
        <th style="text-align: end;"><%= t("inventory.stock_counts.counted_quantity") %></th>
        <th style="text-align: end;"><%= t("inventory.stock_counts.difference") %></th>
        <th><%= t("inventory.stock_counts.quantity_source") %></th>
      </tr></thead>
      <tbody>
        <% @items.each do |item| %>
          <% diff = item.difference.to_d
             diff_class = !item.counted? ? "badge-neutral" : (diff.zero? ? "badge-success" : (diff.positive? ? "badge-warning" : "badge-danger")) %>
          <tr>
            <td><%= link_to item.product.name, inventory_product_path(item.product), class: "link" %> <span class="td-secondary">(<%= item.product.sku %>)</span></td>
            <td class="td-secondary"><%= @product_barcodes[item.product_id].presence || "—" %></td>
            <td style="text-align: end;"><%= inventory_quantity(item.system_quantity) %></td>
            <td style="text-align: end;"><%= item.counted? ? inventory_quantity(item.counted_quantity) : "—" %></td>
            <td style="text-align: end;">
              <span class="badge <%= diff_class %>">
                <%= item.counted? ? inventory_signed_quantity(diff) : "—" %>
              </span>
            </td>
            <td><%= render "quantity_source", item: item %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%# ── History: every posted adjustment (active or reversed) and the audit trail ── %>
  <% if @adjustments.any? %>
    <h2 class="section-title" style="margin-top: var(--space-6);"><%= t("inventory.stock_counts.history.adjustments_title") %></h2>
    <div class="table-wrap table-wrap--cards">
      <table>
        <thead><tr>
          <th><%= t("inventory.stock_counts.adjustment") %></th>
          <th><%= t("inventory.stock_counts.history.posted") %></th>
          <th><%= t("inventory.stock_counts.status") %></th>
          <th><%= t("inventory.stock_counts.history.reversal") %></th>
        </tr></thead>
        <tbody>
          <% @adjustments.each do |adjustment| %>
            <tr>
              <td><%= link_to adjustment.adjustment_number, inventory_stock_adjustment_path(adjustment), class: "link" %></td>
              <td class="td-secondary"><%= adjustment.created_by&.full_name || "—" %> · <%= l(adjustment.created_at, format: :long) %></td>
              <td>
                <span class="badge <%= adjustment.voided? ? 'badge-danger' : 'badge-success' %>">
                  <%= adjustment.voided? ? t("inventory.stock_counts.history.reversed") : t("inventory.stock_counts.history.active") %>
                </span>
              </td>
              <td class="td-secondary td-wrap">
                <% if adjustment.voided? %>
                  <%= adjustment.voided_by&.full_name || "—" %> · <%= l(adjustment.voided_at, format: :long) %> — <%= adjustment.void_reason %>
                <% else %>—<% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% if @history.any? %>
    <h2 class="section-title" style="margin-top: var(--space-6);"><%= t("inventory.stock_counts.history.title") %></h2>
    <div class="table-wrap table-wrap--cards">
      <table>
        <thead><tr>
          <th><%= t("inventory.stock_counts.history.when") %></th>
          <th><%= t("inventory.stock_counts.history.who") %></th>
          <th><%= t("inventory.stock_counts.history.what") %></th>
        </tr></thead>
        <tbody>
          <% @history.each do |entry| %>
            <tr>
              <td class="td-secondary"><%= l(entry.created_at, format: :long) %></td>
              <td><%= entry.actor&.full_name || "—" %></td>
              <td class="td-wrap">
                <%= t("inventory.stock_counts.history.actions.#{entry.action}", default: entry.action.humanize) %>
                <% if entry.metadata["owner_self_approval"] %>
                  <span class="badge badge-warning"><%= t("inventory.stock_counts.owner_self_approval_badge") %></span>
                <% end %>
                <% if entry.metadata["reason"].present? %>
                  <span class="td-secondary">— <%= entry.metadata["reason"] %></span>
                <% end %>
                <% if entry.metadata["reversed_adjustment_number"].present? %>
                  <span class="td-secondary">(<%= t("inventory.stock_counts.history.reversed_adjustment", number: entry.metadata["reversed_adjustment_number"]) %>)</span>
                <% elsif entry.metadata["adjustment_number"].present? %>
                  <span class="td-secondary">(<%= entry.metadata["adjustment_number"] %>)</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
