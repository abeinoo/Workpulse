<%# Creates a session. On save the controller preloads a row per product. %>
<%= form_with model: [:inventory, stock_count], class: "form-card" do |f| %>
  <%= render "shared/error_messages", object: stock_count %>

  <h2 class="section-title"><%= t("inventory.stock_counts.section_header") %></h2>
  <div class="form-grid">
    <div class="form-group">
      <%= f.label :warehouse_id, t("inventory.stock_counts.warehouse"), class: "form-label" %>
      <%= f.select :warehouse_id,
            options_from_collection_for_select(@warehouses, :id, :name, stock_count.warehouse_id),
            { include_blank: "— #{t('inventory.stock_counts.select_warehouse')}" },
            class: "form-control #{'is-error' if stock_count.errors[:warehouse].any?}" %>
      <p class="form-hint"><%= t("inventory.stock_counts.preload_hint") %></p>
    </div>
    <div class="form-group">
      <%= f.label :counted_on, t("inventory.stock_counts.date"), class: "form-label" %>
      <%= f.date_field :counted_on, class: "form-control" %>
    </div>
    <div class="form-group" style="grid-column: 1 / -1;">
      <%= f.label :notes, t("inventory.stock_counts.notes"), class: "form-label" %>
      <%= f.text_area :notes, rows: 2, class: "form-control" %>
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit t("inventory.stock_counts.start_action"), class: "btn btn-primary" %>
    <%= link_to t("common.cancel"), inventory_stock_counts_path, class: "btn btn-ghost" %>
  </div>
<% end %>
