<%#
  Drop-in barcode-scanner input for any line-items document form. Lives inside the
  form (so it can reach the rows/template markers) above the items table. Reusable
  by stock count / purchase orders / adjustments with no changes.
%>
<% scanner_mode = local_assigns.fetch(:scanner_mode, "select") %>
<div class="form-group" data-controller="barcode-scanner"
     data-barcode-scanner-mode-value="<%= scanner_mode %>"
     data-barcode-scanner-lookup-url-value="<%= inventory_barcode_lookup_path %>">
  <%= label_tag :barcode_scan, t("inventory.barcode.scan_label"), class: "form-label" %>
  <%= text_field_tag :barcode_scan, nil,
        class: "form-control",
        autocomplete: "off",
        placeholder: t("inventory.barcode.scan_placeholder"),
        data: {
          "barcode-scanner-target": "input",
          action: "keydown.enter->barcode-scanner#scan input->barcode-scanner#debouncedScan"
        } %>
  <p class="td-secondary text-danger" hidden
     data-barcode-scanner-target="feedback"
     data-not-found="<%= t('inventory.barcode.not_found', code: '%{code}') %>"></p>
</div>
