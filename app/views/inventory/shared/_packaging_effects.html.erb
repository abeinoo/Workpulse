<%#
  The packaging entries a posted document recorded (inventory_packaging_entries):
  which sealed packages it moved or opened, per warehouse. Nothing for
  documents of products without packaging. locals: entries
%>
<% rows = packaging_effect_rows(entries) %>
<% if rows.any? %>
  <h2 class="section-title" style="margin-top: var(--space-5);"><%= t("inventory.packaging.effects_title") %></h2>
  <p class="form-hint"><%= t("inventory.packaging.effects_hint") %></p>
  <div class="table-wrap table-wrap--cards" style="margin-bottom: var(--space-5);">
    <table class="table" data-testid="packaging-effects">
      <thead><tr>
        <th><%= t("inventory.products.warehouse") %></th>
        <th><%= t("inventory.stock_counts.product") %></th>
        <th><%= t("inventory.packaging.title") %></th>
      </tr></thead>
      <tbody>
        <% rows.each do |warehouse, product, text| %>
          <tr><td><%= warehouse.name %></td><td><%= product.name %></td><td><%= text %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
