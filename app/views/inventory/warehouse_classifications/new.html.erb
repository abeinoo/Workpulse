<% content_for :title, t("inventory.warehouses.classification.title") %>

<div class="form-page">
  <%= link_to inventory_warehouses_path, class: "back-link" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    <%= t("forms.back") %>
  <% end %>

  <h1 class="page-title mb-6"><%= t("inventory.warehouses.classification.title") %></h1>

  <%= form_with url: inventory_warehouse_classification_path(@warehouse), scope: :classification, method: :post,
                class: "form-card", id: "warehouse-classification-form",
                data: { turbo_confirm: t("inventory.warehouses.classification.confirm", name: @warehouse.name) } do |f| %>
    <% if @error %>
      <div class="form-error" data-turbo-temporary role="alert">
        <p class="form-error__title"><%= @error %></p>
      </div>
    <% end %>

    <p class="form-hint">
      <%= t("inventory.warehouses.classification.intro", name: @warehouse.name) %>
    </p>
    <p class="form-hint"><strong><%= t("inventory.warehouses.classification.permanent") %></strong></p>

    <% selected_kind = params.dig(:classification, :kind) %>
    <div class="form-grid">
      <div class="form-group" style="grid-column: 1 / -1;" role="radiogroup" aria-labelledby="warehouse-classification-kind-label">
        <span class="form-label" id="warehouse-classification-kind-label"><%= t("inventory.warehouses.kind") %></span>
        <% %w[central branch].each do |kind| %>
          <div class="form-group">
            <label class="form-label">
              <%= f.radio_button :kind, kind, checked: selected_kind == kind, required: true %>
              <%= t("inventory.warehouses.classification.kinds.#{kind}") %>
            </label>
          </div>
        <% end %>
      </div>

      <div class="form-group" style="grid-column: 1 / -1;">
        <%= f.label :branch_id, t("inventory.warehouses.branch"), class: "form-label" %>
        <% if @branches.any? %>
          <%= f.select :branch_id,
                options_for_select(@branches.map { |b| [ b.name, b.id ] }, params.dig(:classification, :branch_id)),
                { include_blank: t("inventory.warehouses.classification.branch_prompt") },
                class: "form-control", id: "warehouse-classification-branch" %>
          <p class="form-hint"><%= t("inventory.warehouses.classification.branch_hint") %></p>
        <% else %>
          <p class="form-hint" id="warehouse-classification-no-branches">
            <%= t("inventory.warehouses.classification.no_branches") %>
          </p>
        <% end %>
      </div>

      <div class="form-group" style="grid-column: 1 / -1;">
        <%= f.label :reason, t("inventory.warehouses.classification.reason"), class: "form-label" %>
        <%= f.text_area :reason, rows: 3, required: true,
              maxlength: Inventory::WarehouseManager::CLASSIFICATION_REASON_MAX_LENGTH,
              value: params.dig(:classification, :reason),
              placeholder: t("inventory.warehouses.classification.reason_placeholder"),
              class: "form-control", id: "warehouse-classification-reason" %>
        <p class="form-hint">
          <%= t("inventory.warehouses.classification.reason_hint",
                count: Inventory::WarehouseManager::CLASSIFICATION_REASON_MAX_LENGTH) %>
        </p>
      </div>
    </div>

    <div class="form-actions">
      <%= f.submit t("inventory.warehouses.classification.submit"), class: "btn btn-primary" %>
      <%= link_to t("common.cancel"), inventory_warehouses_path, class: "btn btn-ghost" %>
    </div>
  <% end %>
</div>
