<%
  cur_info   = Business::CURRENCIES[current_user.business.currency] || Business::CURRENCIES["SAR"]
  cur_prefix = I18n.locale.to_s == "ar" ? "" : "#{cur_info[:symbol_en]} "
  cur_suffix = I18n.locale.to_s == "ar" ? " #{cur_info[:symbol]}" : ""
%>
<% creating = purchase_request.new_record? %>
<%= form_with model: purchase_request,
              url: creating ? inventory_purchase_requests_path : inventory_purchase_request_path(purchase_request),
              method: creating ? :post : :patch,
              class: "form-card",
              data: {
                controller: "line-items purchase-request-form",
                "purchase-request-form-currency-prefix-value": cur_prefix,
                "purchase-request-form-currency-suffix-value": cur_suffix,
                "purchase-request-form-duplicate-message-value": t("inventory.purchase_requests.form.duplicate_line")
              } do |f| %>
  <%= render "shared/error_messages", object: purchase_request %>
  <%= hidden_field_tag :idempotency_key, @idempotency_key if creating %>

  <h2 class="section-title"><%= t("inventory.purchase_requests.form.section_details") %></h2>
  <div class="form-grid">
    <div class="form-group">
      <%= f.label :supplier_id, class: "form-label",
            title: t("inventory.purchase_requests.form.supplier_hint") do %>
        <%= t("inventory.purchase_requests.form.supplier_label") %>
        <span class="td-secondary"><%= t("inventory.purchase_requests.form.optional") %></span>
      <% end %>
      <%= f.select :supplier_id,
            options_from_collection_for_select(@suppliers, :id, :name, purchase_request.supplier_id),
            { include_blank: "— #{t('inventory.purchase_requests.no_supplier')}" },
            class: "form-control #{'is-error' if purchase_request.errors[:supplier].any?}",
            data: { purchase_request_form_target: "supplier" } %>
    </div>
    <div class="form-group" style="grid-column: 1 / -1;">
      <%= f.label :notes, t("inventory.purchase_requests.form.notes_label"), class: "form-label" %>
      <%= f.text_area :notes, rows: 2, class: "form-control" %>
    </div>
  </div>

  <div class="divider"></div>

  <h2 class="section-title"><%= t("inventory.purchase_requests.form.section_items") %></h2>
  <% if creating && @warehouses.empty? %>
    <p class="td-secondary" role="alert" style="color: var(--color-danger, #c62828);">
      <%= t("inventory.purchase_requests.form.no_accessible_warehouses") %>
    </p>
  <% end %>
  <div class="table-wrap table-wrap--form-cards">
    <table class="line-items-table">
      <thead><tr>
        <th style="width: 30%;"><%= t("inventory.purchase_requests.form.product_label") %></th>
        <th><%= t("inventory.purchase_requests.form.warehouse_label") %></th>
        <th><%= t("inventory.purchase_requests.form.quantity_label") %></th>
        <th><%= t("inventory.purchase_requests.form.unit_price_label") %></th>
        <th style="text-align: end;"><%= t("inventory.purchase_requests.form.line_total_label") %></th>
        <th></th>
      </tr></thead>
      <tbody data-line-items-target="rows">
        <%= f.fields_for :items do |item_f| %>
          <%= render "item_fields", f: item_f, products: @products, warehouses: @warehouses, require_warehouse: creating %>
        <% end %>
      </tbody>
    </table>
  </div>

  <p data-line-items-target="emptyState" class="td-secondary" <%= "hidden" if purchase_request.items.any? %>>
    <%= t("inventory.purchase_requests.form.no_items_hint") %>
  </p>

  <p class="td-secondary" role="alert" data-purchase-request-form-target="duplicateNotice" hidden
     style="color: var(--color-danger, #c62828); margin-top: var(--space-2);"></p>

  <div class="flex items-center" style="gap: var(--space-2); margin-top: var(--space-3); flex-wrap: wrap;">
    <button type="button" class="btn btn-ghost btn-sm" data-action="click->line-items#add click->purchase-request-form#recalculate">
      + <%= t("inventory.purchase_requests.form.add_item") %>
    </button>
    <% if creating %>
      <button type="button" class="btn btn-secondary btn-sm" data-action="click->purchase-request-form#openLowStock">
        <%= t("inventory.purchase_requests.form.add_from_low_stock") %>
        <% if @low_stock_rows.any? %><span class="badge badge-warning"><%= @low_stock_rows.size %></span><% end %>
      </button>
    <% end %>
  </div>

  <%# Template for new rows (index replaced by JS) %>
  <template data-line-items-target="template">
    <%= f.fields_for :items, PurchaseRequestItem.new, child_index: "NEW_INDEX" do |item_f| %>
      <%= render "item_fields", f: item_f, products: @products, warehouses: @warehouses, require_warehouse: creating %>
    <% end %>
  </template>

  <div class="flex items-center justify-between" style="margin-top: var(--space-4); padding: var(--space-3); border-top: 1px solid var(--border-color, #e0e0e0);">
    <strong><%= t("inventory.purchase_requests.form.grand_total_label") %></strong>
    <strong data-purchase-request-form-target="grandTotal">—</strong>
  </div>

  <div class="form-actions">
    <%= f.submit creating ? t("inventory.purchase_requests.form.create_submit") : t("common.save"), class: "btn btn-primary" %>
    <%= link_to t("common.cancel"),
                creating ? inventory_purchase_requests_path : inventory_purchase_request_path(purchase_request),
                class: "btn btn-ghost" %>
  </div>

  <%= render "low_stock_picker", rows: @low_stock_rows if creating %>
<% end %>
