<%#
  require_warehouse - (optional) true on the new-request form: the destination
                      warehouse is mandatory there (no "No warehouse" option).
                      The draft edit form keeps the existing optional choice,
                      since Low Stock total-stock alerts create lines without one.
%>
<% require_warehouse = local_assigns.fetch(:require_warehouse, false) %>
<tr data-line-row data-purchase-request-form-target="row">
  <td>
    <div data-controller="searchable-select" data-searchable-select-floating-value="true">
      <%= f.select :product_id,
            inventory_product_options(products, f.object.product_id),
            { include_blank: "— #{t('inventory.purchase_requests.form.select_product')}" },
            class: "form-control",
            data: { product_field: true, searchable_select_target: "select",
                    search_placeholder: t("inventory.purchase_requests.form.search_product"),
                    action: "change->purchase-request-form#lineKeyChanged" } %>
    </div>
  </td>
  <td>
    <%= f.select :source_warehouse_id,
          options_from_collection_for_select(warehouses, :id, :name,
            f.object.source_warehouse_id || (warehouses.first.id if require_warehouse && warehouses.size == 1)),
          { include_blank: require_warehouse ? "— #{t('inventory.purchase_requests.form.select_warehouse')}" : t("inventory.purchase_requests.form.no_warehouse") },
          class: "form-control",
          required: require_warehouse,
          data: { warehouse_field: true, action: "change->purchase-request-form#lineKeyChanged" } %>
  </td>
  <td>
    <%= f.number_field :quantity, step: "0.001", min: 0.001, class: "form-control", placeholder: "0",
          data: { quantity_field: true, action: "input->purchase-request-form#recalculate" } %>
  </td>
  <td>
    <%= f.number_field :unit_price, step: "0.0001", min: 0.0001, class: "form-control", placeholder: "0.00",
          data: { price_field: true, action: "input->purchase-request-form#recalculate" } %>
  </td>
  <td style="text-align: end;" data-purchase-request-form-target="lineTotal">—</td>
  <td class="td-actions">
    <% if f.object.persisted? %>
      <%= f.hidden_field :_destroy, value: "0", data: { destroy_field: true } %>
    <% end %>
    <button type="button" class="btn btn-ghost btn-sm text-danger"
            data-action="click->line-items#remove click->purchase-request-form#recalculate" aria-label="<%= t('common.delete') %>">×</button>
  </td>
</tr>
