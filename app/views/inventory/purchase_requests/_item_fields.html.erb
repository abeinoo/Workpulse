<%#
  suppliers - the business's suppliers. The line's supplier is optional and
              is pre-filled from the product's default supplier when a product
              is picked — unless the user deliberately chose another supplier,
              which is kept (purchase_request_form_controller); changing it here
              never touches the product.
  removable - false in the single-line item editor (no × button). Default true.
%>
<tr data-line-row data-purchase-request-form-target="row">
  <td>
    <%= product_combobox(f, :product_id, selected: f.object.product,
                         select_data: { product_field: true, action: "change->purchase-request-form#lineKeyChanged" }) %>
  </td>
  <td>
    <%= f.select :supplier_id,
          options_from_collection_for_select(suppliers, :id, :name, f.object.supplier_id),
          { include_blank: "— #{t('inventory.purchase_requests.no_supplier')}" },
          class: "form-control #{'is-error' if f.object.errors[:supplier_id].any?}",
          aria: { label: t("inventory.purchase_requests.form.supplier_label") },
          data: { supplier_field: true } %>
    <p class="form-hint" data-supplier-kept-note hidden><%= t("inventory.purchase_requests.form.supplier_kept_note") %></p>
  </td>
  <td>
    <%= f.number_field :quantity, step: "0.001", min: 0.001, class: "form-control", placeholder: "0",
          data: { quantity_field: true, action: "input->purchase-request-form#recalculate" } %>
  </td>
  <td>
    <%= f.number_field :unit_price, step: "0.0001", min: 0.0001, class: "form-control", placeholder: "0.00",
          data: { price_field: true, action: "input->purchase-request-form#recalculate" } %>
  </td>
  <td style="text-align: end;" data-purchase-request-form-target="lineTotal">—</td>
  <% if local_assigns.fetch(:removable, true) %>
    <td class="td-actions">
      <% if f.object.persisted? %>
        <%= f.hidden_field :_destroy, value: "0", data: { destroy_field: true } %>
      <% end %>
      <button type="button" class="btn btn-ghost btn-sm text-danger"
              data-action="click->line-items#remove click->purchase-request-form#recalculate" aria-label="<%= t('common.delete') %>">×</button>
    </td>
  <% end %>
</tr>
