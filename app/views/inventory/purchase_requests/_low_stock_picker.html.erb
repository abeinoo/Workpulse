<%#
  "اختيار منتجات من المخزون المنخفض" picker on the new Purchase Request form.
  A convenience source of lines only — nothing here creates anything. Rows are
  Inventory::Reports::LowStock rows (already scoped to the user's warehouses
  by the controller); suggested quantity = the configured reorder quantity.
  Inputs carry no `name`, so they are never submitted with the form — the
  purchase-request-form controller copies the checked rows into real lines.

  Each time it opens, rows that can't be added are left out of the list
  (counted in one note): a product already on the request (one line per
  product) and a warehouse-specific row of another warehouse than the
  request's (one warehouse per request). The controller re-applies both rules
  when adding, and the server rejects either anyway.

  Layout: header (title, subtitle) · scrollable table with a sticky header
  (select all) · sticky footer (selection summary, Cancel, Add). No warehouse
  column — the request's warehouse is chosen on the form; each row still
  carries data-warehouse-id for the one-warehouse rule.

  Locals:
    rows - Inventory::Reports::LowStock rows
%>
<% scope = "inventory.purchase_requests.form" %>
<div class="modal-overlay lsp-overlay" style="display:none" data-purchase-request-form-target="lowStockModal"
     data-summary-none="<%= t("#{scope}.low_stock_none_selected") %>"
     data-summary-some="<%= t("#{scope}.low_stock_selected_count", count: "__COUNT__") %>"
     data-add-label="<%= t("#{scope}.add_selected_count", count: "__COUNT__") %>"
     data-hidden-note="<%= t("#{scope}.low_stock_hidden_rows", count: "__COUNT__") %>">
  <div class="modal-card lsp" role="dialog" aria-modal="true" aria-labelledby="low-stock-picker-title"
       aria-describedby="low-stock-picker-intro">
    <header class="lsp__header">
      <h3 class="modal-card__title lsp__title" id="low-stock-picker-title"><%= t("#{scope}.low_stock_picker_title") %></h3>
      <p class="lsp__subtitle" id="low-stock-picker-intro"><%= t("#{scope}.low_stock_picker_intro") %></p>
    </header>

    <% if rows.empty? %>
      <p class="lsp__empty" data-testid="low-stock-picker-empty"><%= t("inventory.dashboard.low_stock_empty") %></p>
    <% else %>
      <p class="lsp__note" data-low-stock-hidden-note hidden></p>
      <p class="lsp__note lsp__note--error" data-low-stock-invalid role="alert" hidden><%= t("#{scope}.low_stock_invalid_quantity") %></p>

      <div class="lsp__scroll">
        <table class="lsp__table">
          <thead>
            <tr>
              <th class="td-check" scope="col">
                <input type="checkbox" data-low-stock-select-all
                       data-action="change->purchase-request-form#lowStockToggleAll"
                       aria-label="<%= t("#{scope}.low_stock_select_all") %>" title="<%= t("#{scope}.low_stock_select_all") %>">
              </th>
              <th scope="col" class="lsp__col-product"><%= t("inventory.products.name") %></th>
              <th scope="col" class="lsp__num"><%= t("inventory.products.current_stock") %></th>
              <th scope="col" class="lsp__num"><%= t("inventory.reports.fields.min_level") %></th>
              <th scope="col" class="lsp__num"><%= t("#{scope}.suggested_quantity") %></th>
            </tr>
          </thead>
          <tbody>
            <% rows.each_with_index do |row, index| %>
              <% check_id = "low-stock-pick-#{index}" %>
              <% out_of_stock = !row.on_hand.positive? %>
              <% suggested = row.suggested_quantity.to_d.positive? ? row.suggested_quantity.to_d : 1.to_d %>
              <tr class="lsp__row" data-low-stock-row
                  data-product-id="<%= row.product.id %>"
                  data-product-name="<%= row.product.name %>"
                  data-sku="<%= row.product.sku %>"
                  data-thumb="<%= product_thumbnail_url(row.product, preloaded_only: true) %>"
                  data-warehouse-id="<%= row.warehouse_id %>"
                  data-unit-price="<%= row.priced? ? row.unit_cost.to_d : "" %>"
                  data-supplier-id="<%= row.supplier&.id %>"
                  data-out-of-stock="<%= out_of_stock %>">
                <td class="td-check">
                  <input type="checkbox" id="<%= check_id %>" data-low-stock-check
                         data-action="change->purchase-request-form#lowStockSelectionChanged">
                </td>
                <td class="lsp__col-product">
                  <label for="<%= check_id %>" class="lsp__product">
                    <%= product_identity(row.product, sku: true) %>
                  </label>
                </td>
                <td class="lsp__num">
                  <span class="lsp__stock<%= ' lsp__stock--out' if out_of_stock %>" data-testid="low-stock-on-hand"><%= row.on_hand.to_i %></span>
                  <% if out_of_stock %><span class="sr-only"><%= t("#{scope}.low_stock_out_of_stock") %></span><% end %>
                </td>
                <td class="lsp__num"><%= row.low_stock_level.to_i %></td>
                <td class="lsp__num">
                  <input type="number" inputmode="decimal" min="0.001" step="0.001"
                         value="<%= suggested.frac.zero? ? suggested.to_i : suggested %>"
                         class="form-control form-control--sm lsp__qty" data-low-stock-quantity
                         data-action="input->purchase-request-form#lowStockSelectionChanged"
                         aria-label="<%= t("#{scope}.quantity_for", product: row.product.name) %>">
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <footer class="lsp__footer">
      <p class="lsp__summary" data-low-stock-summary aria-live="polite"><%= t("#{scope}.low_stock_none_selected") %></p>
      <div class="lsp__actions">
        <button type="button" class="btn btn-ghost" data-action="click->purchase-request-form#closeLowStock">
          <%= t("common.cancel") %>
        </button>
        <% if rows.any? %>
          <button type="button" class="btn btn-primary" data-low-stock-add disabled
                  data-action="click->purchase-request-form#addFromLowStock">
            <%= t("#{scope}.add_selected_count", count: 0) %>
          </button>
        <% end %>
      </div>
    </footer>
  </div>
</div>
