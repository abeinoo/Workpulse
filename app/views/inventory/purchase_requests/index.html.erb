<% content_for :title, t("inventory.purchase_requests.title") %>

<div class="admin-page">
  <div class="back-link">
    <%= link_to inventory_root_path do %>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      <%= t("inventory.dashboard.title") %>
    <% end %>
    <span aria-hidden="true">/</span>
    <span><%= t("inventory.purchase_requests.title") %></span>
  </div>

  <div class="page-header">
    <h1 class="page-title"><%= t("inventory.purchase_requests.title") %></h1>
    <div class="flex" style="gap: var(--space-2);">
      <%= link_to t("inventory.purchase_requests.filters.needs_action"), inventory_purchase_requests_path(needs_action: "1"),
            class: "btn btn-sm #{@filters[:needs_action] == '1' ? 'btn-primary' : 'btn-secondary'}" %>
      <% if current_user.can?(:manage_inventory) || current_user.can?(:create_purchase_requests) %>
        <%= link_to t("inventory.purchase_requests.new_action"), new_inventory_purchase_request_path, class: "btn btn-primary btn-sm" %>
      <% end %>
    </div>
  </div>

  <%# ── Summary cards — business-wide scope, independent of the filters below.
      Each card filters the list to that state (existing status filter). ── %>
  <% summary_cards = [
       [ "active", nil, @active_count ],
       [ "pending_approval", "pending_approval", @status_counts["pending_approval"] ],
       [ "approved", "approved", @status_counts["approved"] ],
       [ "partially_received", "partially_received", @status_counts["partially_received"] ],
       [ "fully_received", "fully_received", @status_counts["fully_received"] ]
     ] %>
  <nav class="pr-summary" aria-label="<%= t("inventory.purchase_requests.title") %>">
    <% summary_cards.each do |key, status, count| %>
      <% current = status ? @filters[:status] == status : (@filters[:status].blank? && !@active_filters) %>
      <%= link_to inventory_purchase_requests_path(status ? { status: status } : {}),
            class: "stat-card pr-summary__card#{' pr-summary__card--current' if current}",
            aria: { current: (current ? "true" : nil) }, data: { testid: "pr-summary-#{key}" } do %>
        <span class="stat-card__label"><%= t("inventory.purchase_requests.summary.#{key}") %></span>
        <span class="stat-card__value"><%= count %></span>
      <% end %>
    <% end %>
  </nav>

  <% if @just_created.present? %>
    <section class="card" style="margin-bottom: var(--space-6); border-color: var(--color-success, #2e7d32);">
      <div class="card__header">
        <h2 class="card__title" style="margin: 0;">
          <%= t("inventory.purchase_requests.just_created_title") %>
        </h2>
      </div>
      <div class="table-wrap table-wrap--cards">
        <table>
          <thead>
            <tr>
              <th><%= t("inventory.purchase_requests.request_number") %></th>
              <th><%= t("inventory.purchase_requests.supplier") %></th>
              <th style="text-align: end;"><%= t("inventory.purchase_requests.items_count") %></th>
              <th style="text-align: end;"><%= t("inventory.purchase_requests.total") %></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @just_created.each do |pr| %>
              <tr>
                <td><strong><%= pr.request_number %></strong></td>
                <td><%= purchase_request_supplier_name(pr) %></td>
                <td style="text-align: end;"><%= pr.items.size %></td>
                <td style="text-align: end;"><%= format_currency(pr.total_amount) %></td>
                <td><%= link_to t("inventory.purchase_requests.view"), inventory_purchase_request_path(pr), class: "link" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <%# ── Filter bar (GET form → filters live in the URL query string) ────────── %>
  <%= form_with url: inventory_purchase_requests_path, method: :get, local: true, class: "filter-bar pr-filter-bar" do |f| %>
    <div class="filter-bar__fields pr-filters">
      <div class="filter-bar__field">
        <%= f.label :status, t("inventory.purchase_requests.filters.status_label"), class: "filter-bar__label" %>
        <%= f.select :status,
              options_for_select(
                [[ t("inventory.purchase_requests.filters.all_statuses"), "" ]] +
                  PurchaseRequest.statuses.keys.map { |s| [ t("inventory.purchase_requests.statuses.#{s}"), s ] },
                @filters[:status]),
              {}, class: "filter-bar__select" %>
      </div>

      <div class="filter-bar__field">
        <%= f.label :receiving_status, t("inventory.purchase_requests.filters.receiving_status_label"), class: "filter-bar__label" %>
        <%= f.select :receiving_status,
              options_for_select(
                [[ t("inventory.purchase_requests.receiving_statuses.all"), "" ]] +
                  %w[not_started partial closed full].map { |s| [ t("inventory.purchase_requests.receiving_statuses.#{s}"), s ] },
                @filters[:receiving_status]),
              {}, class: "filter-bar__select" %>
      </div>

      <div class="filter-bar__field" data-controller="searchable-select">
        <%= f.label :supplier_id, t("inventory.purchase_requests.filters.supplier_label"), class: "filter-bar__label" %>
        <%= f.select :supplier_id,
              options_for_select([ [ t("inventory.purchase_requests.filters.no_supplier"), PurchaseRequest::NO_SUPPLIER_FILTER ] ] +
                                 @filter_suppliers.map { |s| [ s.name, s.id ] }, @filters[:supplier_id]),
              { include_blank: t("inventory.purchase_requests.filters.all_suppliers") }, class: "filter-bar__select",
              data: { searchable_select_target: "select" } %>
      </div>

      <div class="filter-bar__field">
        <%= f.label :q, t("inventory.purchase_requests.filters.search_placeholder"), class: "filter-bar__label" %>
        <%= f.text_field :q, value: @filters[:q], class: "filter-bar__input",
              placeholder: t("inventory.purchase_requests.filters.search_placeholder") %>
      </div>

      <div class="filter-bar__field">
        <%= f.label :date_from, t("inventory.purchase_requests.filters.date_from"), class: "filter-bar__label" %>
        <%= f.date_field :date_from, value: @filters[:date_from], class: "filter-bar__input" %>
      </div>

      <div class="filter-bar__field">
        <%= f.label :date_to, t("inventory.purchase_requests.filters.date_to"), class: "filter-bar__label" %>
        <%= f.date_field :date_to, value: @filters[:date_to], class: "filter-bar__input" %>
      </div>

      <div class="filter-bar__field">
        <%= f.label :created_by_id, t("inventory.purchase_requests.filters.created_by_label"), class: "filter-bar__label" %>
        <%= f.select :created_by_id,
              options_from_collection_for_select(@filter_creators, :id, :full_name, @filters[:created_by_id]),
              { include_blank: t("inventory.purchase_requests.filters.all_creators") }, class: "filter-bar__select" %>
      </div>
    </div>

    <div class="filter-bar__actions">
      <%= f.submit t("common.search"), class: "btn btn-sm btn-primary" %>
      <% if @active_filters %>
        <%= link_to t("inventory.purchase_requests.filters.clear"), inventory_purchase_requests_path, class: "btn btn-sm btn-ghost" %>
      <% end %>
    </div>
  <% end %>

  <%
    can_bulk_approve = policy(PurchaseRequest).bulk_approve?
    cur_info = Business::CURRENCIES[current_user.business.currency] || Business::CURRENCIES["SAR"]
    ar       = I18n.locale.to_s == "ar"
  %>
  <section class="card" style="margin-top: var(--space-5);"
           <% if can_bulk_approve %>
             data-controller="purchase-request-bulk-approve"
             data-purchase-request-bulk-approve-currency-symbol-value="<%= ar ? cur_info[:symbol] : cur_info[:symbol_en] %>"
             data-purchase-request-bulk-approve-symbol-after-value="<%= ar %>"
             data-purchase-request-bulk-approve-modal-body-value="<%= t("inventory.purchase_requests.bulk.modal_body", count: "%{count}", total: "%{total}") %>"
           <% end %>>
    <% if can_bulk_approve && @purchase_requests.any? %>
      <%# ── Bulk bar (hidden until an eligible row is selected) ─────────────── %>
      <div class="bulk-action-bar"
           data-purchase-request-bulk-approve-target="actionBar"
           style="display:none"
           role="toolbar"
           aria-label="<%= t("inventory.purchase_requests.bulk.toolbar_label") %>">
        <span class="bulk-action-bar__badge" aria-live="polite">
          <%= t("inventory.purchase_requests.bulk.selected_count") %>
          <strong data-purchase-request-bulk-approve-target="countBadge">0</strong>
        </span>
        <span class="bulk-action-bar__sep"></span>
        <span>
          <%= t("inventory.purchase_requests.bulk.selected_total") %>:
          <strong data-purchase-request-bulk-approve-target="totalBadge"><%= format_currency(0) %></strong>
        </span>
        <span class="bulk-action-bar__sep"></span>
        <button type="button" class="btn btn-primary btn-sm"
                data-purchase-request-bulk-approve-target="approveBtn"
                data-action="click->purchase-request-bulk-approve#openModal" disabled>
          <%= t("inventory.purchase_requests.bulk.approve") %>
        </button>
        <button type="button" class="btn btn-ghost btn-sm" data-action="click->purchase-request-bulk-approve#clear">
          <%= t("inventory.purchase_requests.bulk.clear") %>
        </button>
        <span class="bulk-action-bar__hint" data-testid="pr-bulk-hint"><%= t("inventory.purchase_requests.bulk.only_pending_hint") %></span>
      </div>
    <% end %>
    <% if @purchase_requests.empty? %>
      <div class="empty-state" style="padding: var(--space-6); text-align: center;">
        <% if @filters[:needs_action] == "1" %>
          <p class="empty-state__title"><%= t("inventory.purchase_requests.empty_state_needs_action") %></p>
        <% else %>
          <p class="empty-state__title"><%= t("inventory.purchase_requests.empty_state_title") %></p>
          <p class="td-secondary"><%= t("inventory.purchase_requests.empty_state_hint") %></p>
        <% end %>
        <% if !@active_filters && (current_user.can?(:manage_inventory) || current_user.can?(:create_purchase_requests)) %>
          <%= link_to t("inventory.purchase_requests.new_action"), new_inventory_purchase_request_path, class: "btn btn-primary btn-sm", style: "margin-top: var(--space-3);" %>
        <% end %>
      </div>
    <% else %>
      <%# One row per request: number (+ date · creator), supplier, items, total,
          approval status, receiving (badge + received/requested + bar), and ONE
          actions area. Narrow lists (container query, not viewport — the
          inventory sidebar leaves ~815px at a 1280px screen) render each row
          as a card. %>
      <div class="pr-list">
      <% if can_bulk_approve %>
        <%# Select-all lives above the list so it stays reachable in the card layout too. %>
        <label class="pr-list__select-all">
          <input type="checkbox" class="pr-bulk-check-all"
                 data-action="change->purchase-request-bulk-approve#toggleAll">
          <span><%= t("inventory.purchase_requests.bulk.select_all") %></span>
        </label>
      <% end %>
      <div class="table-wrap pr-list__table">
        <table>
          <thead>
            <tr>
              <% if can_bulk_approve %>
                <th class="td-check"><span class="sr-only"><%= t("inventory.purchase_requests.bulk.select_row", number: "") %></span></th>
              <% end %>
              <th><%= t("inventory.purchase_requests.request_number") %></th>
              <th><%= t("inventory.purchase_requests.supplier") %></th>
              <th class="pr-list__num"><%= t("inventory.purchase_requests.items_count") %></th>
              <th class="pr-list__num"><%= t("inventory.purchase_requests.total") %></th>
              <th><%= t("inventory.purchase_requests.status") %></th>
              <th><%= t("inventory.purchase_requests.receiving_progress") %></th>
              <th class="pr-list__actions-th"><%= t("inventory.purchase_requests.table_actions") %></th>
            </tr>
          </thead>
          <tbody>
            <% @purchase_requests.each do |pr| %>
              <% requested = pr.total_requested_quantity; received = pr.total_received_quantity %>
              <% receiving_key = purchase_request_receiving_status(pr) %>
              <% approval_key = purchase_request_approval_status(pr) %>
              <tr class="pr-list__row">
                <% if can_bulk_approve %>
                  <%
                    blocked_reason =
                      if !pr.pending_approval? || !policy(pr).approve?
                        t("inventory.purchase_requests.bulk.not_selectable_status")
                      elsif Inventory::PurchaseRequestApproval.self_approval?(pr, current_user)
                        t("inventory.purchase_requests.bulk.not_selectable_self")
                      end
                  %>
                  <td class="td-check pr-list__check">
                    <input type="checkbox" class="pr-bulk-check-row"
                           value="<%= pr.id %>"
                           data-amount="<%= pr.total_amount.to_d.to_s("F") %>"
                           data-action="change->purchase-request-bulk-approve#rowChanged"
                           aria-label="<%= t("inventory.purchase_requests.bulk.select_row", number: pr.request_number) %>"
                           <% if blocked_reason %>disabled title="<%= blocked_reason %>"<% end %>>
                  </td>
                <% end %>
                <td class="pr-list__ref-cell">
                  <%= link_to pr.request_number, inventory_purchase_request_path(pr), class: "link pr-list__ref" %>
                  <span class="pr-list__meta"><%= l pr.created_at, format: :short %></span>
                  <span class="pr-list__meta pr-list__creator" title="<%= pr.created_by&.full_name %>"><%= pr.created_by&.full_name || "—" %></span>
                </td>
                <td class="pr-list__supplier"><span class="pr-list__clamp" title="<%= purchase_request_supplier_name(pr) %>"><%= purchase_request_supplier_name(pr) %></span></td>
                <td class="pr-list__num pr-list__items" data-label="<%= t("inventory.purchase_requests.items_count") %>"><%= pr.items.size %></td>
                <td class="pr-list__num pr-list__total" data-label="<%= t("inventory.purchase_requests.total") %>"><%= format_currency(pr.total_amount) %></td>
                <td class="pr-list__status">
                  <span class="badge <%= purchase_request_status_class(approval_key) %>">
                    <%= t("inventory.purchase_requests.statuses.#{approval_key}") %>
                  </span>
                </td>
                <td class="pr-list__receiving" data-label="<%= t("inventory.purchase_requests.receiving_progress") %>">
                  <% if receiving_key %>
                    <% percent = purchase_request_received_percent(requested, received) %>
                    <div class="pr-progress">
                      <span class="badge <%= purchase_request_receiving_status_class(pr) %>">
                        <%= t("inventory.purchase_requests.receiving_statuses.#{receiving_key}") %>
                      </span>
                      <span class="pr-progress__numbers" aria-label="<%= t("inventory.purchase_requests.received_progress_label", received: received.to_i, requested: requested.to_i) %>">
                        <%= received.to_i %> / <%= requested.to_i %>
                      </span>
                      <span class="pr-progress__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= percent %>"
                            aria-label="<%= t("inventory.purchase_requests.received_progress_label", received: received.to_i, requested: requested.to_i) %>">
                        <span class="pr-progress__fill pr-progress__fill--<%= receiving_key %>" style="width: <%= percent %>%;"></span>
                      </span>
                    </div>
                  <% else %>
                    <span class="td-secondary">—</span>
                  <% end %>
                </td>
                <td class="pr-list__actions"><%= render "row_actions", pr: pr %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      </div>

      <% if can_bulk_approve %>
        <%# ── Bulk approval confirmation ───────────────────────────────────────── %>
        <div class="modal-overlay" style="display:none"
             data-purchase-request-bulk-approve-target="modal"
             data-action="click->purchase-request-bulk-approve#overlayClick">
          <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="pr-bulk-approve-title">
            <h3 class="modal-card__title" id="pr-bulk-approve-title"><%= t("inventory.purchase_requests.bulk.modal_title") %></h3>
            <p data-purchase-request-bulk-approve-target="modalBody"></p>
            <p><%= t("inventory.purchase_requests.bulk.modal_question") %></p>
            <%= form_with url: bulk_approve_inventory_purchase_requests_path, method: :post, local: true,
                          data: { action: "submit->purchase-request-bulk-approve#submit" } do %>
              <div data-purchase-request-bulk-approve-target="ids"></div>
              <div class="form-actions">
                <button type="submit" class="btn btn-primary" data-purchase-request-bulk-approve-target="confirmBtn">
                  <%= t("inventory.purchase_requests.bulk.confirm") %>
                </button>
                <button type="button" class="btn btn-ghost" data-action="click->purchase-request-bulk-approve#closeModal">
                  <%= t("common.cancel") %>
                </button>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# ── Pagination ──────────────────────────────────────────────────────── %>
      <% if @total_pages > 1 %>
        <div class="flex items-center justify-between" style="padding: var(--space-4);">
          <span class="td-secondary">
            <%= t("inventory.purchase_requests.showing_count",
                  from: (@page - 1) * Inventory::PurchaseRequestsController::PER_PAGE + 1,
                  to: [ @page * Inventory::PurchaseRequestsController::PER_PAGE, @total_filtered ].min,
                  total: @total_filtered) %>
          </span>
          <div class="flex" style="gap: var(--space-2);">
            <% if @page > 1 %>
              <%= link_to t("common.prev"), inventory_purchase_requests_path(@filters.to_h.merge(page: @page - 1)), class: "btn btn-sm btn-ghost" %>
            <% end %>
            <span class="td-secondary"><%= t("common.page_of", page: @page, total: @total_pages) %></span>
            <% if @page < @total_pages %>
              <%= link_to t("common.next"), inventory_purchase_requests_path(@filters.to_h.merge(page: @page + 1)), class: "btn btn-sm btn-ghost" %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </section>
</div>
