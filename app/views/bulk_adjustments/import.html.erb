<% content_for :title, t("bulk_adjustments.import.page_title") %>

<div class="admin-page">

  <div class="page-header">
    <div>
      <%= link_to adjustments_path, class: "back-link" do %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
        <%= t("bulk_adjustments.back") %>
      <% end %>
      <h1 class="page-title"><%= t("bulk_adjustments.import.title") %></h1>
      <p class="page-subtitle"><%= t("bulk_adjustments.import.subtitle") %></p>
    </div>
    <div class="page-header__actions">
      <%= link_to template_bulk_adjustments_path, class: "btn btn-ghost btn-sm" do %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        <%= t("bulk_adjustments.import.download_template") %>
      <% end %>
      <%= link_to bulk_adjustments_path, class: "btn btn-ghost btn-sm" do %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/>
          <line x1="9" y1="21" x2="9" y2="9"/>
        </svg>
        <%= t("bulk_adjustments.switch_to_manual") %>
      <% end %>
    </div>
  </div>

  <%# Upload card %>
  <div class="form-card">
    <p class="import-description"><%= t("bulk_adjustments.import.description") %></p>

    <%= form_with url: preview_import_bulk_adjustments_path, method: :post,
          multipart: true, data: { controller: "file-upload" } do |f| %>

      <%# Default period — applied to CSV rows that omit period_month / period_year. %>
      <div class="bulk-adj-period-row" style="margin-bottom: var(--space-5);">
        <div class="form-group">
          <%= label_tag :period_key, t("adjustments.new.period_label"), class: "form-label form-label--required" %>
          <%= select_tag :period_key,
                options_for_select(@selectable_periods, @selected_period_key),
                include_blank: t("forms.select"),
                class: "form-control form-control--sm",
                disabled: @selectable_periods.empty? %>
          <% if @selectable_periods.empty? %>
            <p class="form-hint text-warning"><%= t("adjustments.new.no_periods") %></p>
          <% end %>
        </div>
      </div>

      <div class="file-upload-area"
           data-file-upload-target="dropzone"
           data-action="dragover->file-upload#dragover dragleave->file-upload#dragleave drop->file-upload#drop">

        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true" class="import-upload-icon">
          <polyline points="16 16 12 12 8 16"/><line x1="12" y1="12" x2="12" y2="21"/>
          <path d="M20.39 18.39A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.3"/>
        </svg>

        <p class="file-upload-area__hint"><%= t("bulk_adjustments.import.drag_hint") %></p>
        <p class="file-upload-area__filename" data-file-upload-target="label">
          <%= t("bulk_adjustments.import.no_file") %>
        </p>

        <label class="btn btn-ghost btn-sm import-browse-label">
          <%= t("bulk_adjustments.import.browse") %>
          <%= f.file_field :csv_file, accept: ".csv,text/csv",
                class: "visually-hidden",
                data: { file_upload_target: "input", action: "change->file-upload#pick" } %>
        </label>
      </div>

      <div class="info-card import-info-card">
        <div class="info-card__row">
          <span class="info-card__label"><%= t("bulk_adjustments.import.required_columns") %></span>
          <code>employee_code, amount, reason</code>
        </div>
        <div class="info-card__row">
          <span class="info-card__label"><%= t("bulk_adjustments.import.optional_columns") %></span>
          <code>adjustment_type, period_month, period_year</code>
        </div>
        <div class="info-card__row">
          <span class="info-card__label"><%= t("bulk_adjustments.import.type_values") %></span>
          <span class="td-secondary"><%= PayrollAdjustment::ADJUSTMENT_TYPES.join(" · ") %></span>
        </div>
        <div class="info-card__row">
          <span class="info-card__label"><%= t("bulk_adjustments.import.default_type") %></span>
          <span class="td-secondary"><%= t("adjustments.types.cash_incentive") %></span>
        </div>
      </div>

      <div class="form-actions">
        <%= f.submit t("bulk_adjustments.import.preview_btn"), class: "btn btn-primary" %>
      </div>

    <% end %>
  </div>

</div>
