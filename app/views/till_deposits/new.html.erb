<% content_for :title, t("till_deposits.new.title") %>

<% amounts_json = @expected_amounts_by_pm.transform_keys(&:to_s).to_json %>
<%
  default_expected =
    if @preselected_payment_method_id && @expected_amounts_by_pm.key?(@preselected_payment_method_id)
      @expected_amounts_by_pm[@preselected_payment_method_id]
    elsif @payment_methods.one?
      @expected_amounts_by_pm[@payment_methods.first.id] || 0
    else
      0
    end
%>

<turbo-frame id="modal">
<div class="emp-dashboard"
     style="padding: var(--space-5);"
     data-controller="till-deposit"
     data-till-deposit-amounts-value="<%= amounts_json %>"
     data-till-deposit-expected-value="<%= default_expected %>">

  <%# ── Modal header row ──────────────────────────────────────────────── %>
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-4);">
    <div>
      <p style="font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); margin: 0 0 2px;">
        <%= t("till_deposits.new.step_label") %>
      </p>
      <h1 style="font-size: var(--text-xl); font-weight: 700; color: var(--text-1); margin: 0 0 var(--space-1); line-height: 1.2;">
        <%= t("till_deposits.new.title") %>
      </h1>
      <p style="font-size: var(--text-sm); color: var(--text-2); margin: 0;">
        <% if @reconciliation.business_date %>
          <%= t("till_deposits.new.context",
                branch: @reconciliation.branch.name,
                date: l(@reconciliation.business_date, format: :short)) %>
        <% else %>
          <%= @reconciliation.branch.name %>
        <% end %>
      </p>
    </div>
    <button type="button"
            data-action="click->modal#close"
            style="border: none; background: none; cursor: pointer; color: var(--text-2); padding: var(--space-2); border-radius: var(--radius-sm); flex-shrink: 0;"
            aria-label="<%= t("common.close") %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <%= form_with url: till_deposits_path, data: { turbo_frame: "_top" } do |f| %>
    <%= hidden_field_tag "till_deposit[daily_reconciliation_id]", @reconciliation.id %>
    <%= hidden_field_tag "till_deposit[idempotency_key]", @idempotency_key %>

    <%# ── Correction context banner — only shown when arriving via a voided
         deposit's "تصحيح الإيداع" (Correct Deposit) action. Purely informational:
         the voided deposit itself is never read or modified here, only its
         values were copied into this request's query params by the caller. ── %>
    <% if @prefill_amount.present? %>
      <div style="background: rgba(var(--accent-rgb,99,102,241), 0.07); border: 1.5px solid rgba(var(--accent-rgb,99,102,241), 0.30); border-radius: var(--radius-lg); padding: var(--space-4); margin-bottom: var(--space-4); display: flex; gap: var(--space-3); align-items: flex-start;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0; margin-top: 2px;"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        <p style="font-size: var(--text-xs); color: var(--text-2); margin: 0;">
          <%= t("till_deposits.new.correction_notice") %>
        </p>
      </div>
    <% end %>

    <%# ── Deposit-lock override (only reachable at all when the actor holds
         override_review_requirement — TillDepositPolicy#create? blocks anyone
         else from opening this form once the Branch Manager has already
         approved the deposit) ──────────────────────────────────────────── %>
    <% if @reconciliation.reviewed? %>
      <div style="background: rgba(var(--danger-rgb,220,38,38), 0.07); border: 1.5px solid rgba(var(--danger-rgb,220,38,38), 0.30); border-radius: var(--radius-lg); padding: var(--space-4); margin-bottom: var(--space-4);">
        <p style="font-size: var(--text-sm); font-weight: 700; color: var(--danger,#dc2626); margin: 0 0 var(--space-1);">
          <%= t("till_deposits.new.deposit_locked_title") %>
        </p>
        <p style="font-size: var(--text-xs); color: var(--text-2); margin: 0 0 var(--space-3);">
          <%= t("till_deposits.errors.deposit_locked") %>
        </p>
        <label style="display: block; font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); margin-bottom: var(--space-2);">
          <%= t("till_deposits.new.override_reason_label") %>
        </label>
        <%= text_area_tag "till_deposit[override_review_reason]", nil, class: "form-control", rows: 2, required: true,
              placeholder: t("till_deposits.new.override_reason_placeholder") %>
      </div>
    <% end %>

    <%# ── Payment method ─────────────────────────────────────────────── %>
    <% if @payment_methods.one? %>
      <%= hidden_field_tag "till_deposit[payment_method_id]", @payment_methods.first.id %>
      <div style="background: rgba(var(--success-rgb), 0.06); border: 1px solid rgba(var(--success-rgb), 0.25); border-radius: var(--radius); padding: var(--space-3) var(--space-4); display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-4);">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        <span style="font-size: var(--text-sm); font-weight: 600; color: var(--text-1);">
          <%= @payment_methods.first.display_name %>
        </span>
      </div>
    <% else %>
      <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; margin-bottom: var(--space-4);">
        <div style="padding: var(--space-4) var(--space-5); border-bottom: 1px solid var(--border); background: var(--surface-2);">
          <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); margin: 0;">
            <%= t("till_deposits.new.method_question") %>
          </p>
        </div>
        <div style="padding: var(--space-4) var(--space-5); display: flex; flex-direction: column; gap: var(--space-2);">
          <% @payment_methods.each_with_index do |pm, i| %>
            <% checked = @preselected_payment_method_id ? pm.id == @preselected_payment_method_id : i == 0 %>
            <label style="display: flex; align-items: center; gap: var(--space-4); padding: var(--space-3) var(--space-4); background: var(--surface-2); border: 1.5px solid var(--border); border-radius: var(--radius); cursor: pointer;">
              <%= radio_button_tag "till_deposit[payment_method_id]", pm.id, checked,
                    style: "flex-shrink: 0; accent-color: var(--accent); width: 18px; height: 18px;",
                    data: { action: "change->till-deposit#pmSelected", "till-deposit-target": "pmRadio" } %>
              <div style="flex: 1; display: flex; justify-content: space-between; align-items: center; gap: var(--space-2);">
                <span style="font-size: var(--text-base); font-weight: 600; color: var(--text-1);">
                  <%= pm.display_name %>
                </span>
                <span style="font-size: var(--text-sm); color: var(--text-2);">
                  <%= t("till_deposits.new.expected_label") %>
                  <strong style="color: var(--text-1); margin-inline-start: var(--space-1);">
                    <%= number_to_currency(@expected_amounts_by_pm[pm.id] || 0, unit: "", separator: ".", delimiter: ",") %>
                  </strong>
                </span>
              </div>
            </label>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# ── Deposit amounts: Expected / Actual / Remaining ─────────────── %>
    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; margin-bottom: var(--space-4);">
      <div style="padding: var(--space-4) var(--space-5); border-bottom: 1px solid var(--border); background: var(--surface-2);">
        <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); margin: 0;">
          <%= t("till_deposits.new.amount_question") %>
        </p>
      </div>

      <%# Expected amount row (read-only) %>
      <div style="padding: var(--space-4) var(--space-5); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; gap: var(--space-4);">
        <span style="font-size: var(--text-sm); color: var(--text-2); font-weight: 500;">
          <%= t("till_deposits.new.expected_label") %>
        </span>
        <span style="font-size: var(--text-xl); font-weight: 700; color: var(--text-1); font-variant-numeric: tabular-nums;"
              data-till-deposit-target="expectedLabel">
          <%= number_to_currency(default_expected, unit: "", separator: ".", delimiter: ",") %>
        </span>
      </div>

      <%# Actual deposited amount (editable) %>
      <div style="padding: var(--space-4) var(--space-5); border-bottom: 1px solid var(--border);">
        <label style="display: block; font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-3); margin-bottom: var(--space-2);">
          <%= t("till_deposits.new.actual_label") %>
        </label>
        <%= number_field_tag "till_deposit[amount]",
              @prefill_amount,
              step: 0.01, min: 0.01,
              class: "form-control",
              placeholder: "0.00",
              autofocus: true,
              data: {
                action: "input->till-deposit#recalculate",
                "till-deposit-target": "actualInput"
              },
              style: "font-size: var(--text-3xl); font-weight: 700; text-align: center; letter-spacing: 0.02em; border: none; background: transparent; padding: var(--space-2) 0;" %>
      </div>

      <%# Remaining balance row — hidden by Stimulus when remaining == 0 %>
      <div data-till-deposit-target="remainingRow"
           hidden
           style="padding: var(--space-4) var(--space-5); display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); background: rgba(var(--warning-rgb,202,138,4), 0.06);">
        <span style="font-size: var(--text-sm); color: var(--warning,#ca8a04); font-weight: 600;">
          <%= t("till_deposits.new.remaining_label") %>
        </span>
        <span style="font-size: var(--text-xl); font-weight: 700; color: var(--warning,#ca8a04); font-variant-numeric: tabular-nums;"
              data-till-deposit-target="remainingLabel">
          0.00
        </span>
      </div>
    </div>

    <%# ── Remaining balance warning ───────────────────────────────────── %>
    <div data-till-deposit-target="warningBox"
         hidden
         style="background: rgba(var(--warning-rgb,202,138,4), 0.08); border: 1.5px solid rgba(var(--warning-rgb,202,138,4), 0.35); border-radius: var(--radius); padding: var(--space-4); margin-bottom: var(--space-4); display: flex; gap: var(--space-3); align-items: flex-start;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--warning,#ca8a04)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0; margin-top: 2px;"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      <div>
        <p style="font-size: var(--text-sm); font-weight: 700; color: var(--warning,#ca8a04); margin: 0 0 var(--space-1);">
          <span data-till-deposit-target="warningAmount">0.00</span>
          <%= t("till_deposits.new.remaining_warning_suffix") %>
        </p>
        <p style="font-size: var(--text-xs); color: var(--text-2); margin: 0;">
          <%= t("till_deposits.new.remaining_warning_detail") %>
        </p>
      </div>
    </div>

    <%# ── Reference and time ──────────────────────────────────────────── %>
    <div style="background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; margin-bottom: var(--space-4);">
      <div style="padding: var(--space-4) var(--space-5); border-bottom: 1px solid var(--border); background: var(--surface-2);">
        <p style="font-size: var(--text-sm); font-weight: 700; color: var(--text-1); margin: 0;">
          <%= t("till_deposits.new.details_heading") %>
        </p>
      </div>
      <div style="padding: var(--space-4) var(--space-5); display: flex; flex-direction: column; gap: var(--space-4);">
        <div class="form-group" style="margin: 0;">
          <%= label_tag "till_deposit[deposited_at]", t("till_deposits.new.deposited_at_label"), class: "form-label" %>
          <%= datetime_local_field_tag "till_deposit[deposited_at]",
                Time.current.strftime("%Y-%m-%dT%H:%M"), class: "form-control" %>
        </div>
        <div class="form-group" style="margin: 0;">
          <%= label_tag "till_deposit[reference]", t("till_deposits.new.reference_label"), class: "form-label" %>
          <%= text_field_tag "till_deposit[reference]", @prefill_reference, class: "form-control",
                placeholder: t("till_deposits.new.reference_placeholder") %>
        </div>
        <div class="form-group" style="margin: 0;">
          <%= label_tag "till_deposit[notes]", t("till_deposits.new.notes_label"), class: "form-label" %>
          <%= text_area_tag "till_deposit[notes]", nil, class: "form-control", rows: 2,
                placeholder: t("till_deposits.new.notes_placeholder") %>
        </div>
      </div>
    </div>

    <%# ── Submit ─────────────────────────────────────────────────────── %>
    <div class="emp-dashboard__cta">
      <%= f.submit t("till_deposits.new.submit"),
            class: "btn btn-checkin",
            data: { turbo_submits_with: t("till_deposits.new.submitting") },
            style: "width: 100%; justify-content: center; font-size: var(--text-base); padding: var(--space-4);" %>
      <button type="button"
              data-action="click->modal#close"
              class="btn btn-checkout"
              style="width: 100%; justify-content: center;">
        <%= t("common.cancel") %>
      </button>
    </div>
  <% end %>

  <%# ── Secondary action: the cash never reached the bank ──────────────
      Reported directly from this same dialog, opens a BankDispute case
      instead of saving a deposit — never creates a TillDeposit. Swaps this
      modal's content to the ATM-report form rather than leaving the page. ── %>
  <% if policy(BankDispute.new(daily_reconciliation: @reconciliation)).create? %>
    <div style="margin-top: var(--space-3); padding-top: var(--space-3); border-top: 1px solid var(--border);">
      <%= link_to new_finance_bank_dispute_path(daily_reconciliation_id: @reconciliation.id),
            class: "btn btn-warning",
            data: { turbo_frame: "modal" },
            style: "width: 100%; justify-content: center;" do %>
        ⚠ <%= t("till_deposits.new.report_atm_problem") %>
      <% end %>
    </div>
  <% end %>

</div>
</turbo-frame>
