<turbo-frame id="modal">
  <div class="emp-dashboard" style="padding: var(--space-5) var(--space-5) var(--space-8); max-width: 560px;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-4);">
      <h2 class="card-title"><%= t("till_deposits.show.ignore_modal_title") %></h2>
      <button type="button"
              data-action="click->modal#close"
              style="border: none; background: none; cursor: pointer; color: var(--text-2); padding: var(--space-1); border-radius: var(--radius-sm);"
              aria-label="<%= t("common.close") %>">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <p style="font-size: var(--text-sm); color: var(--text-2); margin: 0 0 var(--space-1);">
      <%= t("till_deposits.show.ignore_confirm_line1") %>
    </p>
    <p style="font-size: var(--text-sm); color: var(--text-2); margin: 0 0 var(--space-4);">
      <%= t("till_deposits.show.ignore_confirm_line2") %>
    </p>

    <div style="display: grid; grid-template-columns: auto 1fr; gap: var(--space-2) var(--space-3); font-size: var(--text-sm); background: var(--surface-2); border-radius: var(--radius); padding: var(--space-4); margin-bottom: var(--space-4);">
      <span style="color: var(--text-3);"><%= t("finance.deposit_verifications.cols.recorded_amount") %></span>
      <span style="font-weight: 600; font-variant-numeric: tabular-nums;"><%= format_currency(@deposit.amount) %></span>

      <span style="color: var(--text-3);"><%= t("finance.deposit_verifications.cols.deposit_date") %></span>
      <span><%= l(@deposit.deposited_at, format: :long) %></span>

      <span style="color: var(--text-3);"><%= t("finance.deposit_verifications.cols.branch") %></span>
      <span><%= @deposit.daily_reconciliation.branch&.name || "—" %></span>

      <span style="color: var(--text-3);"><%= t("finance.deposit_verifications.cols.reconciliation") %></span>
      <span>
        <%= link_to l(@deposit.daily_reconciliation.business_date, format: :long),
              finance_daily_reconciliation_path(@deposit.daily_reconciliation), class: "link" %>
      </span>

      <% if @deposit.reference.present? %>
        <span style="color: var(--text-3);"><%= t("finance.deposit_verifications.cols.reference") %></span>
        <span><code style="font-size: var(--text-xs);"><%= @deposit.reference %></code></span>
      <% end %>
    </div>

    <%= form_with url: ignore_till_deposit_path(@deposit), method: :patch,
          data: { turbo_frame: "_top" } do |f| %>
      <div class="form-group">
        <%= f.label :ignore_reason, t("till_deposits.show.ignore_reason_label"), class: "form-label" %>
        <%= f.text_area :ignore_reason, class: "form-control", rows: 2, dir: "auto",
              placeholder: t("till_deposits.show.ignore_reason_placeholder") %>
      </div>

      <div style="display: flex; gap: var(--space-3); justify-content: flex-end; margin-top: var(--space-4);">
        <button type="button" class="btn btn-ghost" data-action="click->modal#close">
          <%= t("shared.cancel") %>
        </button>
        <%= f.submit t("till_deposits.show.ignore_confirm_button"), class: "btn btn-danger" %>
      </div>
    <% end %>
  </div>
</turbo-frame>
