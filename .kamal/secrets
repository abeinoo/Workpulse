# ─────────────────────────────────────────────────────────────────────────────
# Kamal secrets — sourced at deploy time on your LOCAL machine.
# Values are injected into the container as environment variables.
#
# IMPORTANT:
#   • Never hard-code secret values in this file — it is committed to git.
#   • Pull all values from environment variables or a password manager.
#   • Set the variables below in your shell before running `kamal deploy`:
#
#       export KAMAL_REGISTRY_PASSWORD="ghp_..."
#       export R2_ACCESS_KEY_ID="..."
#       export R2_SECRET_ACCESS_KEY="..."
#       export R2_BUCKET="workpulse-storage"
#       export R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
#       export DATABASE_URL="postgres://user:pass@host:5432/workpulse_production"
#
#   Or source them from a local .env file (never commit that file):
#       source .env.production
# ─────────────────────────────────────────────────────────────────────────────

# ── GHCR registry authentication ─────────────────────────────────────────────
# Create a GitHub Personal Access Token at:
#   https://github.com/settings/tokens → "Generate new token (classic)"
#   Required scopes: write:packages, read:packages, delete:packages
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# ── Rails master key ──────────────────────────────────────────────────────────
# Read from the local file (never commit config/master.key to git).
# On your CI/CD server, set RAILS_MASTER_KEY as an env var instead.
RAILS_MASTER_KEY=$(cat config/master.key)

# ── Cloudflare R2 credentials ─────────────────────────────────────────────────
# Found in the Cloudflare dashboard → R2 → Manage API tokens.
R2_ACCESS_KEY_ID=$R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=$R2_SECRET_ACCESS_KEY
R2_BUCKET=$R2_BUCKET
R2_ENDPOINT=$R2_ENDPOINT

# ── PostgreSQL connection ──────────────────────────────────────────────────────
# Full connection URL: postgres://user:password@host:5432/workpulse_production
# If the database runs on the same server inside a Docker network, use the
# container/service name as the host instead of an IP address.
DATABASE_URL=$DATABASE_URL
